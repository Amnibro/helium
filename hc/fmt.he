fmods(fl int):
	if fl & F_LUT != 0 { fw("lut ") } if fl & F_CHECKFREE != 0 { fw("checkfree ") } if fl & F_SIMD != 0 { fw("simd ") } if fl & F_INLINE != 0 { fw("inline ") } if fl & F_REC != 0 { fw("recursive ") } if fl & F_THREAD != 0: fw("thread_fn ");
recursive fsig(n int):
	x := ND[n]
	if ND[n].fl & F_NESTED == 0: fnsp(x.a, TK[x.t].f)
	qn(x.s)
	if x.d >= 0: fw("<"); for i ND[x.d].n { if i > 0 { fw(", ") } g := kid(x.d, i); qn(ND[g].s); if ND[g].a >= 0 { fw(" "); fty(ND[g].a) } } fw(">")
	fw("("); for i x.n { if i > 0 { fw(", ") } p := kid(n, i); if ND[p].fl & 1 != 0 { fw("var ") } qn(ND[p].s); if ND[p].a >= 0 { fw(" "); fty(ND[p].a) } if ND[p].b >= 0 { fw(" = "); fx(ND[p].b, 0, true) } } fw(")")
	if x.b >= 0:
		r := x.b; fw(" "); for i ND[r].n: if i > 0 { fw(", ") } fty(kid(r, i))
recursive ffn(n int, d int): sa := AOWN; sn := CURN; AOWN = inst_of(n); CURN = ND[n].s; ffn1(n, d); AOWN = sa; CURN = sn
recursive ffn1(n int, d int):
	x := ND[n]; fl := x.fl
	if fl & F_EXTERN != 0: e := x.e; fw("extern "); fmods(fl); fsig(n); if ND[e].a >= 0 { fw(" = "); fw(tok_text(ND[e].a)) } if d >= 0 { fw("\n") } return
	if fl & F_EXPORT != 0:
		e := x.e; fw("export "); if ND[e].a >= 0: fw(tok_text(ND[e].a)); fw(" ")
	fmods(fl)
	if d < 0: fw("fn "); fsig(n); fw(" "); fbrace(x.c); return
	sv := SEMB; SEMB = if x.b < 0 { x.c as int } else { -1 }; fsig(n); fob(x.c, d); SEMB = sv
recursive ffields(n int):
	for i ND[n].n:
		if i > 0 { fw(", ") } f := kid(n, i); fl := ND[f].fl; if fl == 4 { fw("pad"); if ND[f].c > 0 { format(FO, " ", ND[f].c) } continue } if fl == 3 { fw("const ") } if fl == 1 { fw("let ") } qn(ND[f].s); fw(" "); fty(ND[f].a); if ND[f].b >= 0: fw(" = "); fx(ND[f].b, 0, true)
fgens(g int):
	if g >= 0: fw("<"); for i ND[g].n { if i > 0 { fw(", ") } q := kid(g, i); qn(ND[q].s); if ND[q].a >= 0 { fw(" "); fty(ND[q].a) } } fw(">");
fnsq(n int): fnsp(ND[n].a, TK[ND[n].t].f);
recursive ftop(n int, cl bool):
	x := ND[n]; k := x.k
	if k == N_FN: if x.fl & F_EXTERN != 0 && x.e >= 0 && ND[x.e].b >= 0 { fw("extern "); fw(tok_text(ND[x.e].b)); fw(" { "); fmods(x.fl); fw("fn "); fsig(n); if ND[x.e].a >= 0 { fw(" = "); fw(tok_text(ND[x.e].a)) } fw("; }"); if !cl { fw("\n") } return } ffn(n, if cl { -1 } else { 0 }); return
	if k == N_STRUCT: fw("struct "); fnsq(n); qn(x.s); fgens(x.d); fw(" { "); ffields(n); fw(" }"); if !cl { fw("\n") } return
	if k == N_ENUM: fw("enum "); fnsq(n); qn(x.s); fgens(x.d); fw(" { "); for i x.n { if i > 0 { fw(", ") } v := kid(n, i); qn(ND[v].s); if ND[v].fl & 1 != 0 { fw(" { "); ffields(v); fw(" }") } } fw(" }"); if !cl { fw("\n") } return
	if k == N_ALIAS: fw("type "); fnsq(n); qn(x.s); fw(" = "); fty(x.b); if !cl { fw("\n") } return
	if k == N_IMPORT: fw("use "); if x.fl & 1 != 0 { fw(".") } for c nm(x.s) { FO.push(if c == '/' { '.' } else { c }) } if x.a >= 0 { fw(" from "); fw(tok_text(x.a)) } if !cl { fw("\n") } return
	if k == N_VDECL: fvdecl(n); if !cl { fw("\n") } return
	fw("?top?\n");
emit(f int, out const byte[:]) bool:
	FO.clear(); mark_else()
	src := SRC[(FILES[f].s as int)..FILES[f].s + FILES[f].n]
	i ~= 0
	while i < src.len && (src[i] == '#' || src[i] == '/' && i + 1 < src.len && src[i + 1] == '/'):
		e ~= i; while e < src.len && src[e] != '\n' { e++ } fw("#"); fw(src[if src[i] == '#' { i + 1 } else { i + 2 }..e]); fw("\n"); i = e + 1; while i < src.len && (src[i] == '\n' || src[i] == ' ' || src[i] == '\t' || src[i] == '\r'): i++
	if FILENS[f] >= 0: fw("namespace "); qn(FILENS[f]); fw("\n")
	it i32[>..] ~= []; for c TOP: if TK[ND[c].t].f == f: it.push(c)
	for j it.len:
		c := it[j]; jn := j + 1 < it.len && TK[ND[it[j + 1]].t].line == TK[ND[c].t].line; CURF = if ND[c].k as int == N_FN { ND[c].s as int } else { -1 }; sa := AOWN; if CURF >= 0 { AOWN = inst_of(c) } ftop(c, jn); AOWN = sa; if jn: fw("; ")
	write_file(out, FO[..])
to_he(path const byte[:], out const byte[:]) bool:
	f := FILES.len; KEEPEND = true
	if !parse_file(path): print(PERR); return false
	emit(f, out)
slim(prog const byte[:], path const byte[:], out const byte[:], keep const byte[:]) bool:
	KEEPEND = true; DROPAS = true
	if !load_program(prog): print(DERR); return false
	kb byte[>..] ~= []; if keep.len > 0 && read_file(keep, kb): s ~= 0; for c, i kb: if c == '\n': if i > s { KEEPN.push(intern(kb[s..i])) } s = i + 1
	if !check_program(): print(CERR); return false
	b ~= path.len; while b > 0 && path[b - 1] != '/': b--
	for x, f FILES:
		n := nm(x.name); e ~= n.len; while e > 0 && n[e - 1] != '/': e--
		if n[e..] == path[b..]: return emit(f, out)
	print("not in the program: ", path); false
