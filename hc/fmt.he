use gen
var FO byte[>..]; FOL ~= 0; NSLP ~= false
DROPAS ~= false; ASOK ~= false; var KEEPN i32[>..]; CURF ~= -1; CURN ~= -1
inst_of(n int) int:
	if !DROPAS: return AOWN
	for x, i FI_ { if x.node as int == n && !DEFE.contains(i as i32) { return i } } AOWN
binok(c int, y int, o int) bool:
	if !DROPAS || ND[c].k as int != N_AS || o == T_SHL || o == T_SHR || o == T_ANDAND || o == T_OROR: return false
	t := at(c); u := at(y); f := fin(ND[c].a); v, w, cy := cval(y); t >= 0 && t == u && f >= 0 && TY[t].k == TY_INT && widens(f, t) && !cy && !is_lp(y)
dropas(n int) bool:
	x := ND[n]; if !DROPAS || x.fl & 1 != 0 || KEEPN.contains(CURF as i32) || KEEPN.contains(CURN as i32) { return false } f := fin(x.a as int); t := at(n); f >= 0 && t >= 0 && f != t && TY[f].k == TY_INT && TY[t].k == TY_INT
fw(s const byte[:]): FO.append(s);
ft(n int): fw(tok_text(ND[n].t));
tabs(d int):
	for i d: FO.push('\t')
qn(id int): fw(nm(id));
recursive tconst(n int) bool:
	k := ND[n].k; if k == N_TCONST { return true } if (k == N_TSLICE || k == N_TREF) && ND[n].fl & 1 != 0 { return true } if k == N_TARR || k == N_TSLICE || k == N_TREF || k == N_TVAR { return tconst(ND[n].a) } false
recursive ftyw(n int):
	if tconst(n): fw("("); fty(n); fw(")"); else: fty(n);
recursive fty(n int):
	x := ND[n]; k := x.k
	if k == N_TPRIM: ft(n); return
	if k == N_TNAME: qn(x.s); if x.n > 0 { fw("<"); for i x.n { if i > 0 { fw(", ") } fty(kid(n, i)) } fw(">") } if x.fl & 1 != 0 { fw("..") } return
	if k == N_TCONST: fw("const "); fty(x.a); return
	if k == N_TSLICE: if x.fl & 1 != 0 { fw("const "); ftyw(x.a); } else { fty(x.a); } fw("[:]"); return
	if k == N_TREF: if x.fl & 1 != 0 { fw("const "); ftyw(x.a); } else { fty(x.a); } if x.fl & 2 == 0 || x.c > 0 { fw("&") } if x.c > 0 { fw("<"); fw(nm(x.c as int - T_KW)); if x.s >= 0 { fw(" in "); qn(x.s) } fw(">") } if x.fl & 2 != 0 { fw("?") } return
	if k == N_TARR:
		fty(x.a); o := x.op
		if o == A_FIXED: fw("["); fx(x.b, 0, true); fw("]"); return
		if o == A_LIM: fw("[.."); if x.b >= 0 { fx(x.b, 0, true) } fw("]"); return
		if o == A_GROW: fw("[>..]"); return
		if o == A_GS: fw("[>..<]"); return
		if x.c >= 0: fw("["); fw(nm(x.c as int - T_KW)); fw("]"); return
		fw("[]"); return
	if k == N_TVAR: fty(x.a); fw("."); qn(x.s); return
	if k == N_TIDX: ft(n); fw(if x.fl & 1 != 0 { " upto " } else { " in " }); qn(x.s); return
	if k == N_TFN: fw("fn"); if x.fl & 1 != 0 { fw("("); for i x.n { if i > 0 { fw(", ") } fty(kid(n, i)) } fw(")"); if x.b >= 0 { r := x.b; fw(" -> "); if ND[r].n != 1 { fw("(") } for i ND[r].n { if i > 0 { fw(", ") } fty(kid(r, i)) } if ND[r].n != 1 { fw(")") } } } return
	fw("?type?");
bprec(n int) int:
	k := ND[n].k; if k == N_INT || k == N_FLT { return 11 } if k == N_BIN { return binprec(TK[ND[n].t].k) } if k == N_UN || k == N_AS { return 11 } if k == N_BLOCK || k == N_IF || k == N_MATCH || k == N_EBLOCK || k == N_LOOP || k == N_WHILE || k == N_FOR || k == N_FUNVAL || k == N_RET || k == N_BREAK { return -1 } 12
recursive fxp(n int, p int, inb bool):
	if bprec(n) < p: sf := FOL; sn := NSLP; FOL = 0; NSLP = false; fw("("); fx(n, 0, true); fw(")"); FOL = sf; NSLP = sn else: fx(n, p, inb);
recursive flist(n int): flist2(n, false)
recursive flist2(n int, ok bool): sf := FOL; sn := NSLP; FOL = 0; NSLP = false; for i ND[n].n { if i > 0 { fw(", ") } ASOK = ok; fx(kid(n, i), 0, true) } FOL = sf; NSLP = sn
fsub(n int): sf := FOL; sn := NSLP; FOL = 0; NSLP = false; ASOK = true; fx(n, 0, true); FOL = sf; NSLP = sn
fscr(n int): sf := FOL; sn := NSLP; FOL = 0; NSLP = true; fx(n, 0, true); FOL = sf; NSLP = sn
sep(c int) const byte[:]: if blockish(c) && ND[c].k as int != N_FN: " " else: "; "
recursive fbitems(b int, fv bool):
	r i32[>..] ~= []; tl := bitems(b, r)
	for i r.len:
		c := r[i]; last := i == r.len - 1; if last { semprop(b, c) } fw(" "); fstmt1(c, true)
		if !last && !(blockish(c) && ND[c].k as int != N_FN) || last && !tl && (fv || needsemi(b, c, false)): fw(";")
recursive fbrace(b int): fw("{"); fbitems(b, false); fw(" }");
recursive fx(n int, p int, inb bool):
	x := ND[n]; k := x.k; ok := ASOK; ASOK = false
	if k == N_AS && ok && dropas(n): fxp(x.a, p, inb); return
	if k == N_INT || k == N_FLT || k == N_STR || k == N_TRUE || k == N_FALSE || k == N_NULL || k == N_SELF: ft(n); return
	if k == N_ID: qn(x.s); return
	if k == N_BIN: q := bprec(n); o := TK[x.t].k; sf := FOL; FOL = o; ASOK = binok(x.a, x.b, o); fxp(x.a, q, true); FOL = sf; fw(" "); ft(n); fw(" "); ASOK = binok(x.b, x.a, o); fxp(x.b, q + 1, true); return
	if k == N_UN: ft(n); a := x.a; if ND[a].k as int == N_UN && tok_text(ND[a].t)[0] == tok_text(x.t)[0] { fw("("); fsub(a); fw(")"); } else { fxp(a, 11, true); } return
	if k == N_CALL: fxp(x.a, 12, true); if x.c >= 0 { fw("<"); for i ND[x.c].n { if i > 0 { fw(", ") } fty(kid(x.c, i)) } fw(">") } fw("("); flist2(n, true); fw(")"); if x.b >= 0 { fw(" "); ffv(x.b) } return
	if k == N_IDX: fxp(x.a, 12, true); fw("["); fsub(x.b); fw("]"); return
	if k == N_SLICE: fxp(x.a, 12, true); fw("["); if x.fl & 1 != 0 { fw("^") } if x.b >= 0 { sn := NSLP; NSLP = false; sf := FOL; FOL = T_DOTDOT; fx(x.b, 0, true); FOL = sf; NSLP = sn } fw(".."); if x.fl & 2 != 0 { fw("^") } if x.c >= 0 { fsub(x.c) } fw("]"); return
	if k == N_DOT: fxp(x.a, 12, true); fw("."); qn(x.s); return
	if k == N_AS: w := FOL == T_AND || FOL == T_LT || FOL == T_SHL || FOL == T_LTEQ || FOL == T_DOTDOT || FOL == T_QUEST || FOL == T_ANDEQ || FOL == T_ANDAND; if w { fw("(") } sf := FOL; FOL = 0; fxp(x.a, 12, true); FOL = sf; fw(if x.fl & 1 != 0 { " as! " } else { " as " }); fty(x.b); if w { fw(")") } return
	if k == N_ARR: fw("["); if x.c >= 0 { fw(".."); fsub(x.c); } else { if x.a >= 0 { fsub(x.a); fw("; "); fsub(x.b); } else { flist(n); } } fw("]"); return
	if k == N_SLIT: if NSLP { fw("("); NSLP = false; fslit(n); NSLP = true; fw(")"); } else { fslit(n); } return
	if k == N_FUNVAL: ffv(n); return
	if k == N_IF: fw("if "); fscr(x.a); fw(" "); fbrace(x.b); if x.c >= 0 { fw(" else "); if ND[x.c].k as int == N_IF { fx(x.c, 0, true); } else { fbrace(x.c); } } return
	if k == N_MATCH: fw("match "); fscr(x.a); fw(" { "); for i x.n { if i > 0 { fw(", ") } farm(kid(n, i), -1) } fw(" }"); return
	if k == N_EBLOCK: fw("block "); fbrace(x.a); return
	if k == N_BLOCK: fbrace(n); return
	if k == N_LOOP: fw("loop "); fbrace(x.a); return
	if k == N_WHILE: fw("while "); fscr(x.a); fw(" "); fbrace(x.b); return
	if k == N_FOR: fforh(n); fw(" "); fbrace(x.d); return
	if k == N_RET: fret(n); return
	if k == N_BREAK: fw("break"); if x.a >= 0 { fw(" "); fx(x.a, 0, true) } return
	if k == N_CONT: fw("continue"); return
	if k == N_CFOR: fcfor(n, -1); return
	fw("?expr?");
recursive fret(n int):
	x := ND[n]; fw("return"); if x.n > 0 { fw(" "); flist2(n, true) } if x.s >= 0: fw(" from "); qn(x.s);
recursive fforh(n int): x := ND[n]; fw("for "); if x.fl & 1 != 0 { fw("&") } qn(x.s); typed ~= false; if x.l >= 0 { fw(" "); fty(x.l); typed = true } if x.c >= 0 { fw(", "); qn(x.c); if x.n >= 0 { fw(" "); fty(x.n); typed = true } } fw(if typed { " in " } else { " " }); sn := NSLP; NSLP = true; sf := FOL; FOL = if x.b >= 0 { T_DOTDOT } else { 0 }; fx(x.a, 0, true); FOL = 0; if x.b >= 0 { fw(".."); fx(x.b, 0, true) } FOL = sf; NSLP = sn
recursive fslit(n int): x := ND[n]; fty(x.a); fw("{"); for i x.n { if i > 0 { fw(", ") } fi := kid(n, i); if ND[fi].k as int == N_CFOR { fcfor(fi, -1); continue } if ND[fi].s >= 0 { qn(ND[fi].s); fw(": ") } ASOK = true; fx(ND[fi].a, 0, true) } if x.fl & 1 != 0 { if x.n > 0 { fw(", ") } fw("..") } fw("}");
recursive ffv(n int): x := ND[n]; fw("{"); if x.fl & 1 != 0 { fw(" "); for i x.n { if i > 0 { fw(", ") } p := kid(n, i); if ND[p].fl & 1 != 0 { fw("var ") } qn(ND[p].s); if ND[p].a >= 0 { fw(": "); fty(ND[p].a) } } fw(" =>") } fbitems(x.a, true); fw(" }");
recursive fpat(it int):
	lo := ND[it].a; fx(lo, 0, true); if ND[it].b >= 0: fw(".."); fx(ND[it].b, 0, true);
recursive farm(a int, d int):
	x := ND[a]
	if x.k as int == N_CFOR: fcfor(a, -1); return
	if x.fl & 1 != 0: fw("_")
	else:
		for i x.n { if i > 0 { fw(", ") } fpat(kid(a, i)) } if x.s >= 0: fw(if x.fl & 2 != 0 { " &" } else { " " }); qn(x.s)
	fw(" => "); fx(x.b, 0, true);
recursive fcfor(n int, d int):
	x := ND[n]; nb := x.a; src := x.b; m := x.fl
	fw("const for <"); for i ND[nb].n { if i > 0 { fw(", ") } qn(kid(nb, i)) } fw("> in ")
	o := x.op
	if o == 1: fw("["); flist(src); fw("]") else: fw(if o == 2 { "fields" } else { if o == 3 { "variants" } else { "types" } }); fw("<"); for i ND[src].n { if i > 0 { fw(", ") } fty(kid(src, i)) } fw(">")
	c := x.c
	if m == 1: fw(" {"); for i ND[c].n { if i > 0 { fw(",") } fw(" "); fi := kid(c, i); if ND[fi].k as int == N_CFOR { fcfor(fi, -1); continue } if ND[fi].s >= 0 { qn(ND[fi].s); fw(": ") } fx(ND[fi].a, 0, true) } fw(", }"); return
	if m == 2: fw(" { "); for i ND[c].n { if i > 0 { fw(", ") } farm(kid(c, i), -1) } fw(", }"); return
	if d < 0: fw(" "); fbrace(c); return
fnsp(a int, f int):
	fns := FILENS[f]; if a != fns: if a >= 0 { qn(a) } fw("::");
vflags(fl int) const byte[:]:
	if fl & V_REUSE != 0 { return if fl & V_REUSE_SL != 0 { "reusable[] " } else { "reusable " } } ""
recursive fvdecl(n int):
	x := ND[n]; fl := x.fl; kw := fl & V_CONST != 0 || fl & V_BYREF != 0 || fl & V_REUSE != 0 || x.b < 0
	fw(vflags(fl))
	if kw: fw(if fl & V_CONST != 0 { "const " } else { if fl & V_VAR != 0 { "var " } else { "let " } })
	for i x.n: if i > 0 { fw(", ") } if fl & V_GLOBAL != 0 { fnsp(x.c, TK[x.t].f) } qn(kid(n, i))
	iv := if DROPAS && x.a < 0 && x.n == 1 && x.b >= 0 && fl & (V_BYREF | V_GLOBAL) == 0 && ND[x.b].n == 1 { kid(x.b, 0) } else { -1 }
	if iv >= 0 && fin(iv) >= 0 && ND[iv].k as int != N_AS && TY[fin(iv)].k == TY_INT && fin(iv) != T_I64 && widens(fin(iv), T_I64): fw(" "); fw(tn(fin(iv)))
	if iv >= 0 && ND[iv].k as int == N_AS && at(iv) == T_I64 && fin(ND[iv].a) >= 0 && widens(fin(ND[iv].a), T_I64): ASOK = true
	if x.a >= 0: fw(" "); fty(x.a)
	if x.b >= 0: fw(if fl & V_BYREF != 0 { " .= " } else { if kw { " = " } else { if fl & V_VAR != 0 { " ~= " } else { " := " } } }); flist2(x.b, x.a >= 0 || ASOK);
is_stmtk(k int) bool:
	k == N_VDECL || k == N_ASSIGN || k == N_INCDEC || k == N_FN
recursive fstmt1(n int, inb bool):
	x := ND[n]; k := x.k
	if k == N_VDECL: fvdecl(n); return
	if k == N_ASSIGN: if x.op as int == T_COMMA { flist(x.a); fw(" = "); } else { fx(x.a, 0, true); fw(" "); ft(n); fw(" "); } ASOK = true; fx(x.b, 0, true); return
	if k == N_INCDEC: fx(x.a, 12, true); ft(n); return
	if k == N_FN: ffn(n, -1); return
	if k == N_IF && x.fl == 1: fw("guard "); fx(x.a, 0, true); if x.c >= 0 { fw(" else "); fbrace(x.c) } return
	fx(n, 0, inb);
blockish(n int) bool:
	k := ND[n].k; k == N_IF && ND[n].fl != 1 || k == N_WHILE || k == N_FOR || k == N_LOOP || k == N_MATCH || k == N_EBLOCK || k == N_CFOR && ND[n].fl == 0 || k == N_FN
isguard(n int) bool:
	ND[n].k as int == N_IF && ND[n].fl == 1
recursive sline(n int) int:
	x := ND[n]; k := x.k; if k == N_ASSIGN && x.op as int == T_COMMA && ND[x.a].n > 0 { return sline(kid(x.a, 0)) } if (k == N_ASSIGN || k == N_INCDEC || k == N_BIN || k == N_CALL || k == N_IDX || k == N_DOT || k == N_AS || k == N_SLICE) && x.a >= 0 { return min(sline(x.a), TK[x.t].line) } TK[x.t].line as int
oneline(b int) bool:
	b < BEND.len && BEND[b] >= 0 && TK[BEND[b]].line == TK[ND[b].t].line
recursive bitems(b int, r i32[>..]&) bool:
	x := ND[b]; for i x.n: r.push(kid(b, i))
	if x.a < 0: return x.n > 0 && isguard(kid(b, x.n - 1)) && bitems(ND[kid(b, x.n - 1)].b, r)
	t := x.a; r.push(t); if isguard(t) { return bitems(ND[t].b, r) } true
SEMB ~= -1; var SEMS i32[>..]; var ELSB bool[>..]
mark_else():
	ELSB.resize(ND.len, false)
	for x ND: if x.k as int == N_IF && x.fl != 1 && x.c >= 0: ELSB[x.b] = true; e ~= x.c; while e >= 0: if ND[e].k as int == N_IF && ND[e].fl != 1: ELSB[ND[e].b] = true; e = ND[e].c else: ELSB[e] = true; e = -1
semprop(b int, c int):
	if b != SEMB && !SEMS.contains(b as i32) { return } k := ND[c].k as int; if k == N_EBLOCK { SEMS.push(ND[c].a) } if k != N_IF || ND[c].fl == 1 { return } SEMS.push(ND[c].b); e ~= ND[c].c as int; while e >= 0:
		if ND[e].k as int == N_IF && ND[e].fl != 1: SEMS.push(ND[e].b); e = ND[e].c as int else: SEMS.push(e as i32); e = -1
needsemi(b int, c int, tail bool) bool:
	k := ND[c].k as int; (b == SEMB || SEMS.contains(b as i32) || b < ELSB.len && ELSB[b]) && !tail && !is_stmtk(k) && !isguard(c) && k != N_RET && k != N_BREAK && k != N_CONT
recursive fob(b int, d int):
	if oneline(b): fw(": "); finl(b, false); fw("\n"); else: fw(":\n"); fblk(b, d + 1);
recursive finl(b int, cl bool):
	r i32[>..] ~= []; tl := bitems(b, r)
	if r.len == 0: fw(";"); return
	for i r.len:
		c := r[i]; last := i == r.len - 1; ns := last && needsemi(b, c, tl); if last: semprop(b, c)
		if !last || cl || ns && blockish(c): fstmt1(c, true); fw(if last { if ns { ";" } else { "" } } else { sep(c) })
		else:
			fopen(c, -1); if ns: fw(";")
chain1(n int) bool:
	if !oneline(ND[n].b) { return false } l i32 := TK[ND[n].t].line; e ~= ND[n].c; while e >= 0 { if ND[e].k as int == N_IF && ND[e].fl != 1 { if !oneline(ND[e].b) || TK[ND[e].t].line != l { return false } e = ND[e].c } else { return oneline(e) && TK[ND[e].t].line == l } } true
recursive finlif(n int):
	fw("if "); fscr(ND[n].a); fw(": "); finl(ND[n].b, ND[n].c >= 0); e ~= ND[n].c
	while e >= 0:
		if ND[e].k as int == N_IF && ND[e].fl != 1: fw(" else if "); fscr(ND[e].a); fw(": "); finl(ND[e].b, ND[e].c >= 0); e = ND[e].c else: fw(" else: "); finl(e, false); e = -1
recursive fopen(n int, d int):
	x := ND[n]; k := x.k; il := d < 0
	if k == N_IF && x.fl != 1:
		if il || chain1(n): finlif(n); if !il { fw("\n") } return
		fw("if "); fscr(x.a); fob(x.b, d); e ~= x.c
		while e >= 0:
			tabs(d); if ND[e].k as int == N_IF && ND[e].fl != 1: fw("else if "); fscr(ND[e].a); fob(ND[e].b, d); e = ND[e].c else: fw("else"); fob(e, d); e = -1
		return
	bb := if k == N_WHILE { x.b as int } else { if k == N_FOR { x.d as int } else { if k == N_LOOP || k == N_EBLOCK { x.a as int } else { if k == N_FN { x.c as int } else { if k == N_CFOR && x.fl == 0 { x.c as int } else { -1 } } } } }
	if k == N_WHILE: fw("while "); fscr(x.a)
	if k == N_FOR: fforh(n)
	if k == N_LOOP: fw("loop")
	if k == N_EBLOCK: fw("block")
	if k == N_CFOR && x.fl == 0: fcfor(n, 0)
	if k == N_FN: fl := x.fl; if fl & F_EXTERN != 0 { ffn(n, -1); if !il { fw("\n") } return } if fl & F_EXPORT != 0 { e := x.e; fw("export "); if ND[e].a >= 0 { fw(tok_text(ND[e].a)); fw(" ") } } fmods(fl); fsig(n)
	sv := SEMB; sa := AOWN; sn := CURN; if k == N_FN: SEMB = if x.b < 0 { bb } else { -1 }; AOWN = inst_of(n); CURN = x.s
	if bb >= 0: if il { fw(": "); finl(bb, false); } else { fob(bb, d); } SEMB = sv; AOWN = sa; CURN = sn; return
	if k == N_MATCH: fw("match "); fscr(x.a); if il || x.n == 0 { fw(": "); for i x.n { if i > 0 { fw(", ") } farm(kid(n, i), -1) } if x.n == 0 { fw(";") } if !il { fw("\n") } return } fw(":\n"); for i x.n { tabs(d + 1); farm(kid(n, i), d + 1); fw("\n") } return
	fstmt1(n, false); if !il: fw("\n");
recursive fblk(b int, d int):
	r i32[>..] ~= []; tl := bitems(b, r)
	if r.len == 0: tabs(d); fw(";\n"); return
	i ~= 0
	while i < r.len:
		tabs(d); ln := sline(r[i])
		loop:
			c := r[i]; last := i == r.len - 1; jn := !last && sline(r[i + 1]) == ln; ns := last && needsemi(b, c, tl); if last: semprop(b, c)
			i++
			if jn: fstmt1(c, true); fw(sep(c)); continue
			if ns && blockish(c): fstmt1(c, true); fw(";\n"); break
			if ns: fstmt1(c, false); fw(";\n"); break
