live(i0 int, i1 int, nv int, st i32[>..<]&, en i32[>..<]&):
	cfg(i0, i1); n := i1 - i0; nb := CBS.len
	sbk i32[>..<] ~= []; sbk.resize(nv, -1); dbk i32[>..<] ~= []; dbk.resize(nv, -1); uv i32[>..<] ~= []; ub i32[>..<] ~= []; dv i32[>..<] ~= []; db i32[>..<] ~= []
	for p n:
