	vis i32[>..<] ~= []; vis.resize(nb, -1); dm i32[>..<] ~= []; dm.resize(nb, -1); fdp i32[>..<] ~= []; fdp.resize(nb, 0); wk i32[>..<] ~= []
	for v nv:
