		op := IR[i0 + p].op as int; po := if p > 0 { IR[i0 + p - 1].op as int } else { -1 }
		if p == 0 || op == I_LBL || po == I_JMP || po == I_BZ || po == I_BNZ || po == I_RET: CBS.push(p as i32); CBE.push(p as i32); nr.push(0)
