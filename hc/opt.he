		bm := if v < bad.len { bad[v] as int } else { 0 }
		h := hn[v]; if h >= 0 && rof[h] >= 0 && en[h] == st[v] && rgrp(rof[h]) & bm == 0:
			hk ~= -1; for a, q act { if a == h { hk = q } } if hk >= 0: rof[v] = rof[h]; act[hk] = v; continue
		fi ~= -1; pc := bm & 8 != 0; for r, q free:
			g := rgrp(r); if g & bm == 0 && (fi < 0 || (if pc { g == 0 && rgrp(free[fi]) != 0 } else { g != 0 && rgrp(free[fi]) == 0 })): fi = q
		if fi >= 0: rof[v] = free[fi]; free[fi] = free[free.len - 1]; free.pop(); act.push(v); continue
		wi ~= -1; bn ~= wt[v] as int; bd ~= (en[v] - st[v] + 1) as int; for a, k2 act:
			an := wt[a] as int; ad := (en[a] - st[a] + 1) as int; if an * bd < bn * ad && rgrp(rof[a]) & bm == 0: bn = an; bd = ad; wi = k2
		if wi >= 0: a := act[wi]; rof[v] = rof[a]; rof[a] = -1; act[wi] = v
var CBS i32[>..<]; var CBE i32[>..<]; var CBID i32[>..<]; var CPS i32[>..<]; var CPL i32[>..<]; var CSS i32[>..<]; var CSL i32[>..<]
var NRT i8[>..<]
nret(c i64) bool:
	if NRT.len != NFS.len: NRT.clear(); NRT.resize(NFS.len, 0); for k NFS.len { if NFS[k].inst >= 0 { q := nm(FI_[NFS[k].inst].name); if q == "rt_fail" || q == "rt_die" || q == "rt_oob" { NRT[k] = 1 } } }
