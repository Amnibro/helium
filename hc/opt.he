			v := IR[k].d as int; for q (us[v] as int)..us[v + 1] as int:
				p := ul[q] as int; if p > i:
					if IR[p].a as int == v { IR[p].a = a as i32 } if IR[p].b as int == v && usesb(IR[p].op as int): IR[p].b = a as i32
