		if op == I_CALL || op == I_CALLR || op == I_SYS: b.append(" ["); for j x.b { if j > 0 { b.push(' ') } format(b, ARGL[x.a as int + j]) } b.push(']')
		print(b)
var OU i32[>..<]; var OD i32[>..<]
usesb(op int) bool:
	op == I_BIN || op == I_CMP || op == I_FBIN || op == I_FCMP || op == I_FUN || op == I_BCHK
opnds(i int):
	OU.clear(); OD.clear(); x := IR[i]; op := x.op; d := x.d; a := x.a; b := x.b
