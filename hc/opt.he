var SLV i32[>..<]
mem2reg(fi int):
	f := NFS[fi]; i0 := f.i0; i1 := f.i1; nv0 ~= f.nv
	so i32[>..<] ~= []; so.resize(nv0, -1)
	sw i32[>..<] ~= []; sw.resize(f.sb as int + 8, -2)
