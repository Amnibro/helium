		x := IR[i]; if x.op as int == I_SLOT: so[x.d] = x.c
	for i i0..i1:
		op := IR[i].op; if op == I_DSS || op == I_DSR:
			m := MSLOT[IR[i].a]; if m >= 0 && m < sw.len: sw[m] = -1
	for i i0..i1:
		x := IR[i]; op := x.op; opnds(i)
		for u, k OU:
			s := so[u]; if s < 0 || sw[s] == -1: continue
			ok := (op == I_LD || op == I_ST) && x.a == u && x.c == 0 && !(op == I_ST && x.b == u) && OU.len <= 2
			if !ok: sw[s] = -1
			else:
				if sw[s] == -2: sw[s] = x.w
				else:
					if sw[s] != x.w: sw[s] = -1
	SLV.clear(); SLV.resize(sw.len, -1)
	for i i0..i1:
		x := IR[i]; op := x.op
