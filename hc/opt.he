use ir
ONAMES := ["", "imm", "mov", "bin", "cmp", "un", "lbl", "jmp", "bz", "bnz", "call", "ret", "ld", "st", "slot", "gaddr", "raddr", "param", "sys", "ext", "chk", "copy", "faddr", "callr", "ret2", "res2", "fbin", "fcmp", "cvt", "fun", "zero", "dss", "dsr", "nop", "bchk", "vloop", "sel", "adc", "sbb"]
ir_dump(fi int):
	f := NFS[fi]
	for i (f.i0 as int)..f.i1 as int:
		x := IR[i]; op := x.op
		b byte[>..] ~= []; format(b, i, ": ", ONAMES[op], " w", x.w, " d", x.d, " a", x.a, " b", x.b, " c", x.c)
		if x.l >= 0: format(b, " l", x.l)
		if op == I_CALL || op == I_CALLR || op == I_SYS || op == I_VLOOP: b.append(" ["); for j x.b { if j > 0 { b.push(' ') } format(b, ARGL[x.a as int + j]) } b.push(']')
		print(b)
var OU i32[>..<]; var OD i32[>..<]
usesb(op int) bool:
	op == I_BIN || op == I_CMP || op == I_FBIN || op == I_FCMP || op == I_FUN || op == I_BCHK || op == I_SEL || op == I_ADC || op == I_SBB
opnds(i int):
	OU.clear(); OD.clear(); x := IR[i]; op := x.op; d := x.d; a := x.a; b := x.b
	if op == I_CALL || op == I_CALLR || op == I_SYS || op == I_VLOOP: for j b { OU.push(ARGL[a + j]) } if op == I_CALLR { OU.push(x.c) } if d >= 0 { OD.push(d) } if op == I_CALL && x.l >= 0 { OD.push(x.l) } return
	if op == I_ZERO || op == I_COPY || op == I_ST || op == I_RET || op == I_BZ || op == I_BNZ: if op == I_ZERO || op == I_COPY { OU.push(d) } if a >= 0 && op != I_ZERO { OU.push(a) } if b >= 0 { OU.push(b) } return
	if op == I_LBL || op == I_JMP || op == I_DSS || op == I_DSR || op == I_NOP: return
	if a >= 0 && op != I_IMM && op != I_SLOT && op != I_GADDR && op != I_RADDR && op != I_FADDR && op != I_PARAM: OU.push(a)
	if b >= 0 && usesb(op): OU.push(b)
	if op == I_FUN && x.c == 6 && x.l >= 0: OU.push(x.l)
	if op == I_SEL: OU.push(x.c as i32)
	if (op == I_ADC || op == I_SBB) && x.c >= 0: OU.push(x.c as i32)
	if d >= 0: OD.push(d);
	if (op == I_ADC || op == I_SBB) && x.l >= 0: OD.push(x.l)
var SLV i32[>..<]
mem2reg(fi int):
	f := NFS[fi]; i0 := f.i0; i1 := f.i1; nv0 ~= f.nv
	so i32[>..<] ~= []; so.resize(nv0, -1)
	sw i32[>..<] ~= []; sw.resize(f.sb as int + 8, -2)
