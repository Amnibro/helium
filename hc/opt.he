	CPS.clear(); CPS.resize(nb + 1, 0); CSS.clear(); CSS.resize(nb + 1, 0); for k ef.len { CPS[et[k] + 1] += 1; CSS[ef[k] + 1] += 1 } for b nb: CPS[b + 1] += CPS[b]; CSS[b + 1] += CSS[b]
	CPL.clear(); CPL.resize(ef.len, 0); CSL.clear(); CSL.resize(ef.len, 0); pc i32[>..<] ~= []; pc.resize(nb, 0); sc i32[>..<] ~= []; sc.resize(nb, 0)
