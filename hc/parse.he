		if at_word(NAME_UNDER): perr("_ cannot be listed with other patterns")
	setl(a, m)
	a
pbound() int:
	st := P
	neg := is(T_MINUS)
	if tk() == T_IDENT || tk() == T_CC: n := mk(N_ID, P); { q_ := qname("match pattern"); ND[n].s = q_ as i32; }; if neg { u := mk(N_UN, st); ND[u].op = T_MINUS as u8; ND[u].a = n as i32; return u; }; return n
	if tk() != T_INT: m byte[>..] ~= []; format(m, "integer constant expected in match pattern, found '", cur_text(), "'"); perr(m); return mk(N_INT, st)
	n := mk(N_INT, P); nx()
