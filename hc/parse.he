	k := tk()
	if prim_tok(k):
		nx()
		up := at_word(NAME_UPTO)
		if (k >= K_I8 && k <= K_U64 || k == K_BYTE || k == K_UINT || k == K_INT) && !FORBIND && (tk() == K_IN || up):
			nx(); n := mk(N_TIDX, st); ND[n].op = k; ND[n].fl = if up { 1 } else { 0 }; { q_ := qname("index type"); ND[n].s = q_ }; return n
		n := mk(N_TPRIM, st); ND[n].op = k; return n
	if k == T_IDENT || k == T_CC:
		n := mk(N_TNAME, st); { q_ := qname("type"); ND[n].s = q_ }
		if is(T_LT): m := wbeg(); loop { WS.push(ptype()); if !is(T_COMMA) { break } if tk() == T_GT || tk() == T_SHR { break } } close_angle("type argument list"); setl(n, m)
		return n
	if is(K_FN):
