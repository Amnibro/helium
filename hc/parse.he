use lex
N_INT := 1; N_FLT := 2; N_STR := 3; N_TRUE := 4; N_FALSE := 5; N_NULL := 6; N_SELF := 7; N_ID := 8
N_BIN := 9; N_UN := 10; N_CALL := 11; N_IDX := 12; N_SLICE := 13; N_DOT := 14; N_AS := 15; N_ARR := 16; N_SLIT := 17; N_FI := 18
N_IF := 19; N_MATCH := 20; N_ARM := 21; N_PITEM := 22; N_BLOCK := 23; N_EBLOCK := 24; N_WHILE := 25; N_LOOP := 26; N_FOR := 27
N_RET := 28; N_BREAK := 29; N_CONT := 30; N_FUNVAL := 31; N_PARAM := 32; N_VDECL := 33; N_ASSIGN := 34; N_INCDEC := 35; N_LIST := 36; N_CFOR := 37
N_TPRIM := 40; N_TNAME := 41; N_TARR := 42; N_TSLICE := 43; N_TREF := 44; N_TFN := 45; N_TVAR := 46; N_TIDX := 47; N_TCONST := 48
N_FN := 50; N_STRUCT := 51; N_ENUM := 52; N_ALIAS := 53; N_IMPORT := 54; N_FIELD := 55; N_VARIANT := 56; N_GEN := 57; N_EXT := 58
A_FIXED := 1; A_VAR := 2; A_LIM := 3; A_GROW := 4; A_GS := 5
F_EXTERN := 1; F_EXPORT := 2; F_SIMD := 4; F_INLINE := 8; F_REC := 16; F_THREAD := 32; F_CHECKFREE := 64; F_NESTED := 128; F_LUT := 256; F_RETS := 512
V_VAR := 1; V_CONST := 2; V_BYREF := 4; V_GLOBAL := 8; V_REUSE := 16; V_REUSE_SL := 32; V_RESULTS := 64
struct Node { k u8, op u8, fl u16, t i32, a i32, b i32, c i32, d i32, e i32, s i32, l i32, n i32 }
var ND Node[>..]
var LS i32[>..]
var WS i32[>..<]
var TOP i32[>..]
var FILENS i32[>..]
var P int
var PERR byte[>..]
var TENT int
var TFAIL bool
var NOSL bool
var STMTL bool
var STMTE bool
CURNS int ~= -1
FILENS0 int ~= -1
var SPLITS int[>..]
var NEND i32[>..]
set_end(n int): while NEND.len < ND.len { NEND.push(-1); }; NEND[n] = ND.len as i32
NAME_FROM int ~= -1; NAME_INLINE int ~= -1; NAME_CHECKFREE int ~= -1; NAME_LUT int ~= -1; NAME_UNDER int ~= -1; NAME_UPTO int ~= -1
NAME_FIELDS int ~= -1; NAME_TYPES int ~= -1; NAME_VARIANTS int ~= -1; NAME_STD int ~= -1
mk(k int, t int) int:
	ND.push(Node{k: k as u8, t: t as i32, a: -1, b: -1, c: -1, d: -1, e: -1, s: -1, l: 0, n: 0, ..}); ND.len - 1
tk() int:
	TK[P].k as int
tkat(i int) int:
	TK[min(i, TK.len - 1)].k as int
nx():
	if TK[P].k != T_EOF: P++
is(k int) bool:
	if tk() == k { nx(); return true; }; false
tname(k int) const byte[:]:
	pu := ["(", ")", "[", "]", "{", "}", ",", ";", ":", "?", "::", ".", "..", ".=", ".==", ".!=", "+", "-", "*", "/", "%", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "++", "--", "=", "==", "!=", "<", ">", "<=", ">=", "<<", ">>", "<<=", ">>=", "!", "~", "&", "|", "^", "&&", "||", "->", "=>"]
	if k == T_EOF { return "end of file"; }; if k == T_IDENT { return "identifier"; }; if k == T_INT { return "integer literal"; }; if k == T_FLT { return "float literal"; }; if k == T_STR: return "string literal"
	if k >= T_KW: return nm(k - T_KW)
	pu[k - T_LP]
perr(m const byte[:]):
	if TENT > 0: TFAIL = true; P = TK.len - 1; return
	if PERR.len > 0: return
	t := TK[P]
	PERR.append(nm(FILES[t.f].name)); format(PERR, ":", t.line, ": error: ", m)
	P = TK.len - 1
cur_text() const byte[:]:
	k := tk(); if k == T_IDENT || k == T_INT || k == T_FLT:
		tok_text(P)
	else:
		tname(k)
ex(k int, ctx const byte[:]): if tk() != k { m byte[>..] ~= []; format(m, "expected '", tname(k), "' in ", ctx, ", found '", cur_text(), "'"); perr(m); return; }; nx();
ident(ctx const byte[:]) int:
	if tk() != T_IDENT { m byte[>..] ~= []; format(m, "expected identifier in ", ctx, ", found '", cur_text(), "'"); perr(m); return -1; }; v := TK[P].v as int; nx(); v
close_angle(ctx const byte[:]): if tk() == T_SHR { SPLITS.push(P); TK[P].k = T_GT as u8; return; }; ex(T_GT, ctx);
wbeg() int:
	WS.len
wend(m int) int:
	l := LS.len; for i m..WS.len { LS.push(WS[i]); }; WS.pop_n(WS.len - m); l
setl(n int, m int): c := WS.len - m; { q_ := wend(m); ND[n].l = q_ as i32; }; ND[n].n = c as i32
kid(n int, i int) int:
	LS[ND[n].l as int + i] as int
qcat(a int, b int) int:
	s byte[>..] ~= []; if a >= 0 { s.append(nm(a)); }; s.append("::"); s.append(nm(b)); intern(s)
qname(ctx const byte[:]) int:
	if is(T_CC): return qcat(-1, ident(ctx))
	a := ident(ctx)
	if !is(T_CC): return a
	qcat(a, ident(ctx))
declname(ctx const byte[:]) int:
	a := if tk() == T_CC { -1 } else { ident(ctx) }
	if is(T_CC): CURNS = a; return ident(ctx)
	a
var BEND i32[>..]; KEEPEND ~= false
he() bool:
	FILES[TK[P].f].he
semi(ctx const byte[:]): if TK[P].lay && (tk() == T_RC || tk() == T_EOF) { return; }; ex(T_SEMI, ctx);
he_decl() bool:
	if !he() || tk() != T_IDENT && tk() != T_CC: return false
	j ~= P; while tkat(j) == T_IDENT || tkat(j) == T_CC: j++
	if tkat(j) == T_LT:
		d ~= 0; loop:
			k := tkat(j); if k == T_LT { d++; }; if k == T_GT { d--; }; if k == T_SHR { d -= 2; }; if k == T_EOF || k == T_SEMI || k == T_LC { return false; }; j++; if d <= 0: break
	if tkat(j) != T_LP: return false
	d ~= 0; loop:
		k := tkat(j); if k == T_LP { d++; }; if k == T_RP { d--; }; if k == T_EOF { return false; }; j++; if d == 0: break
	loop: k := tkat(j); if k == T_LC { return TK[j].lay; }; if k == T_SEMI || k == T_RC || k == T_EOF || k == T_FAT || k == T_ASSIGN { return false; }; j++
	false
in_ahead() bool:
	j ~= P; d ~= 0; loop { k := tkat(j); if k == T_LP || k == T_LB { d++; }; if k == T_RP || k == T_RB { d--; }; if d == 0 && k == K_IN { return true; }; if k == T_LC || k == T_SEMI || k == T_EOF || k == T_RC { return false; }; j++; }; false
at_word(w int) bool:
	tk() == T_IDENT && TK[P].v == w
he_fn_at(j int) bool:
	FILES[TK[P].f].he && tkat(j) == T_IDENT && (tkat(j + 1) == T_LP || tkat(j + 1) == T_LT)
at_inline() bool:
	at_word(NAME_INLINE) && (tkat(P + 1) == K_FN || tkat(P + 1) == K_RECURSIVE || tkat(P + 1) == K_THREADFN || he_fn_at(P + 1))
at_checkfree() bool:
	n := tkat(P + 1); at_word(NAME_CHECKFREE) && (n == K_FN || n == K_RECURSIVE || n == K_THREADFN || n == K_SIMD || n == K_EXTERN || n == T_IDENT)
at_lut() bool:
	at_word(NAME_LUT) && (tkat(P + 1) == K_FN || he_fn_at(P + 1))
prim_tok(k int) bool:
	k >= K_BOOL && k <= K_REAL
amni_type() bool:
	k := tk(); FILES[TK[P].f].amni && (prim_tok(k) || k == T_IDENT || k == T_CC || k == K_FN || k == T_LP || k == K_CONST)
lenstore() int:
	k := tk(); if k == K_U8 || k == K_U16 || k == K_U32 || k == K_U64 || k == K_VARINT || k == K_BYTE || k == K_UINT { nx(); return k; }; perr("unsigned integer storage type or varint expected"); 0
var FORBIND bool
recursive ptype() int:
	cq := is(K_CONST)
	t ~= ptype_prim()
	q ~= cq
	loop:
		st := P
		if is(T_LB):
			if is(T_COLON): ex(T_RB, "slice type"); n := mk(N_TSLICE, st); ND[n].a = t as i32; if q { ND[n].fl = 1; q = false; }; t = n; continue
			n := mk(N_TARR, st); ND[n].a = t as i32
			if is(T_RB): ND[n].op = A_VAR as u8; t = n; continue
			if is(T_DOTDOT):
				ND[n].op = A_LIM as u8; if tk() != T_RB:
					{ q_ := pexpr(); ND[n].b = q_ as i32; }
			else:
				if is(T_GT): ex(T_DOTDOT, "resizable array type"); ND[n].op = if is(T_LT) { A_GS as u8 } else { A_GROW as u8 }
				else:
					if prim_tok(tk()):
						ND[n].op = A_VAR as u8; { q_ := lenstore(); ND[n].c = q_ as i32; }
					else:
						ND[n].op = A_FIXED as u8; { q_ := pexpr(); ND[n].b = q_ as i32; }
			ex(T_RB, "array type")
			t = n; continue
		if is(T_AND):
			n := mk(N_TREF, st); ND[n].a = t as i32; if q: ND[n].fl = 1; q = false
			if is(T_LT): { q_ := lenstore(); ND[n].c = q_ as i32; }; if is(K_IN) { { q_ := qname("relative reference pool"); ND[n].s = q_ as i32; } }; close_angle("relative reference width")
			t = n; continue
		if is(T_QUEST):
			if ND[t].k == N_TREF: ND[t].fl |= 2 else: n := mk(N_TREF, st); ND[n].a = t as i32; ND[n].fl = 2; if q { ND[n].fl |= 1; q = false; }; t = n
			continue
		if tk() == T_DOTDOT: nx(); if ND[t].k == N_TNAME { ND[t].fl |= 1; } else { perr("variable mode (..) applies only to ADT type names"); }; continue
		if is(T_DOT): n := mk(N_TVAR, st); ND[n].a = t as i32; { q_ := ident("variant type"); ND[n].s = q_ as i32; }; t = n; continue
		if q: n := mk(N_TCONST, st); ND[n].a = t as i32; t = n
		return t
ptype_prim() int:
	st := P
	k := tk()
	if prim_tok(k):
		nx()
		up := at_word(NAME_UPTO)
		if (k >= K_I8 && k <= K_U64 || k == K_BYTE || k == K_UINT || k == K_INT) && !FORBIND && (tk() == K_IN || up):
			nx(); n := mk(N_TIDX, st); ND[n].op = k as u8; ND[n].fl = if up { 1 } else { 0 }; { q_ := qname("index type"); ND[n].s = q_ as i32; }; return n
		n := mk(N_TPRIM, st); ND[n].op = k as u8; return n
	if k == T_IDENT || k == T_CC:
		n := mk(N_TNAME, st); { q_ := qname("type"); ND[n].s = q_ as i32; }
		if is(T_LT): m := wbeg(); loop { WS.push(ptype() as i32); if !is(T_COMMA) { break; }; if tk() == T_GT || tk() == T_SHR { break; } }; close_angle("type argument list"); setl(n, m)
		return n
	if is(K_FN):
		n := mk(N_TFN, st)
		if is(T_LP):
			ND[n].fl = 1
			m := wbeg(); while tk() != T_RP && tk() != T_EOF { WS.push(ptype() as i32); if !is(T_COMMA) { break; } }; ex(T_RP, "function type"); setl(n, m)
			if is(T_ARROW):
				r := mk(N_LIST, P); m2 := wbeg()
				if is(T_LP): while tk() != T_RP && tk() != T_EOF { WS.push(ptype() as i32); if !is(T_COMMA) { break; } }; ex(T_RP, "function type return list") else: WS.push(ptype() as i32)
				setl(r, m2); ND[n].b = r as i32
		return n
	if is(T_LP): fb := FORBIND; FORBIND = false; t := ptype(); FORBIND = fb; ex(T_RP, "parenthesized type"); return t
	m byte[>..] ~= []; format(m, "type expected, found '", cur_text(), "'"); perr(m)
	mk(N_TPRIM, st)
recursive pexpr() int:
	st := P
	k := tk()
	if k == K_IF: e := pif(); if STMTL { STMTE = true; }; return e
	if k == K_MATCH: e := pmatch(); if STMTL { STMTE = true; }; return e
	if k == K_BLOCK: nx(); e := mk(N_EBLOCK, st); { q_ := pblock("block expression"); ND[e].a = q_ as i32; }; if STMTL { STMTE = true; }; return e
	if k == T_LC: e := pblock("block"); if STMTL { STMTE = true; }; return e
	if k == K_WHILE: nx(); e := mk(N_WHILE, st); { q_ := pscrut(); ND[e].a = q_ as i32; }; { q_ := pblock("while body"); ND[e].b = q_ as i32; }; if STMTL { STMTE = true; }; return e
	if k == K_LOOP: nx(); e := mk(N_LOOP, st); { q_ := pblock("loop body"); ND[e].a = q_ as i32; }; if STMTL { STMTE = true; }; return e
	if k == K_FOR: e := pfor(); if STMTL { STMTE = true; }; return e
	if k == K_GUARD: perr("guard is a statement: it guards the rest of the block it is in"); return mk(N_NULL, st)
	if k == K_RETURN:
		nx()
		sl := STMTL; se := STMTE; STMTL = false; STMTE = false
		r := mk(N_RET, st)
		if tk() != T_SEMI && tk() != T_RC && !at_from(): m := wbeg(); loop { WS.push(pexpr() as i32); if !is(T_COMMA) { break; } }; setl(r, m)
		if at_from():
			nx(); { q_ := qname("return from"); ND[r].s = q_ as i32; }
		STMTL = sl; STMTE = se
		return r
	if k == K_BREAK:
		nx()
		sl := STMTL; se := STMTE; STMTL = false; STMTE = false
		r := mk(N_BREAK, st)
		if tk() != T_SEMI && tk() != T_RC:
			{ q_ := pexpr(); ND[r].a = q_ as i32; }
		STMTL = sl; STMTE = se
		return r
	if k == K_CONTINUE: nx(); return mk(N_CONT, st)
	pbin(1)
at_from() bool:
	at_word(NAME_FROM) && (tkat(P + 1) == T_IDENT || tkat(P + 1) == T_CC)
sub_begin(nosl bool) int:
	s := (if NOSL { 1 } else { 0 }) | (if STMTL { 2 } else { 0 }) | (if STMTE { 4 } else { 0 }); NOSL = nosl; STMTL = false; STMTE = false; s
sub_end(s int): NOSL = s & 1 != 0; STMTL = s & 2 != 0; STMTE = s & 4 != 0
pscrut() int:
	s := sub_begin(true); e := pexpr(); sub_end(s); e
recursive pif() int:
	st := P; nx()
	n := mk(N_IF, st)
	{ q_ := pscrut(); ND[n].a = q_ as i32; }
	{ q_ := pblock("if body"); ND[n].b = q_ as i32; }
	if is(K_ELSE):
		{ q_ := if tk() == K_IF { pif() } else { pblock("else body") }; ND[n].c = q_ as i32; }
	n
pfor() int:
	st := P; nx()
	n := mk(N_FOR, st)
	if is(T_AND): ND[n].fl = 1
	{ q_ := ident("for binding"); ND[n].s = q_ as i32; }
	fb := FORBIND; FORBIND = true
	ND[n].l = -1; ND[n].n = -1
	ty_he := he() && in_ahead()
	if is(T_COLON) || ty_he && tk() != T_COMMA && tk() != K_IN:
		{ q_ := ptype(); ND[n].l = q_ as i32; }
	if is(T_COMMA):
		{ q_ := ident("for index binding"); ND[n].c = q_ as i32; }; if is(T_COLON) || ty_he && tk() != K_IN:
			{ q_ := ptype(); ND[n].n = q_ as i32; }
	FORBIND = fb
	if !he() || tk() == K_IN: ex(K_IN, "for statement")
	s := sub_begin(true)
	{ q_ := pexpr(); ND[n].a = q_ as i32; }
	if is(T_DOTDOT):
		{ q_ := pexpr(); ND[n].b = q_ as i32; }
	sub_end(s)
	{ q_ := pblock("for body"); ND[n].d = q_ as i32; }
	n
pmatch() int:
	st := P; nx()
	n := mk(N_MATCH, st)
	{ q_ := pscrut(); ND[n].a = q_ as i32; }
	ex(T_LC, "match expression")
	parms(n)
	ex(T_RC, "match expression")
	if ND[n].n == 0 && PERR.len == 0: perr("match must have at least one arm")
	n
parms(n int):
	s := sub_begin(NOSL)
	m := wbeg()
	while tk() != T_RC && tk() != T_EOF:
		if tk() == K_CONST && tkat(P + 1) == K_FOR: WS.push(pcfor(2) as i32)
		else: a := ppattern(); ex(T_FAT, "match arm"); { q_ := pexpr(); ND[a].b = q_ as i32; }; WS.push(a as i32)
		if !is(T_COMMA) && !(TK[P].lay && is(T_SEMI)): break
	setl(n, m)
	sub_end(s);
ppattern() int:
	a := mk(N_ARM, P)
	if at_word(NAME_UNDER): nx(); ND[a].fl = 1; if tk() == T_COMMA { perr("_ cannot be listed with other patterns"); }; return a
	m := wbeg()
	loop:
		it := mk(N_PITEM, P)
		{ q_ := pbound(); ND[it].a = q_ as i32; }
		if is(T_DOTDOT):
			{ q_ := pbound(); ND[it].b = q_ as i32; }
		WS.push(it as i32)
		lo := ND[it].a as int
		if ND[lo].k == N_ID && ND[it].b < 0 && (tk() == T_AND || tk() == T_IDENT):
			hasq ~= false; for c nm(ND[lo].s as int):
				if c == ':': hasq = true
			if !hasq:
				if WS.len - m > 1: perr("a list of patterns binds no payload: give the variant an arm of its own")
				if is(T_AND): ND[a].fl |= 2
