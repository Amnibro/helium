					else:
						ND[n].op = A_FIXED as u8; { q_ := pexpr(); ND[n].b = q_ }
			ex(T_RB, "array type")
			t = n; continue
		if is(T_AND):
			n := mk(N_TREF, st); ND[n].a = t; if q: ND[n].fl = 1; q = false
			if is(T_LT): { q_ := lenstore(); ND[n].c = q_ }; if is(K_IN) { { q_ := qname("relative reference pool"); ND[n].s = q_ } } close_angle("relative reference width")
			t = n; continue
		if is(T_QUEST):
			if ND[t].k == N_TREF: ND[t].fl |= 2 else: n := mk(N_TREF, st); ND[n].a = t; ND[n].fl = 2; if q { ND[n].fl |= 1; q = false } t = n
			continue
		if tk() == T_DOTDOT: nx(); if ND[t].k == N_TNAME { ND[t].fl |= 1 } else { perr("variable mode (..) applies only to ADT type names"); } continue
		if is(T_DOT): n := mk(N_TVAR, st); ND[n].a = t; { q_ := ident("variant type"); ND[n].s = q_ }; t = n; continue
		if q: n := mk(N_TCONST, st); ND[n].a = t; t = n
		return t
ptype_prim() int:
