		while i < ND[e].n: kk := kid(e, i); v := if pr { kid(e, i + 1) } else { mk(N_TRUE, st) }; ix := mk(N_IDX, st); ND[ix].a = mkid(tv, st); ND[ix].b = kk; ND[ix].c = mkcall(NAME_DICTAT, st, ND[ix].a, kk); a := mk(N_ASSIGN, st); ND[a].op = T_ASSIGN as u8; ND[a].a = ix; ND[a].b = pyval(v); ss.push(a as i32); i += if pr { 2 } else { 1 }
