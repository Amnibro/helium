parse_file(path const byte[:]) bool:
	parse_init()
	t0 := TK.len
	if !lex_file(path): PERR.append(LERR); return false
	P = t0
	FILENS0 = -1
	if FILES[TK[t0].f].py:
		for m in ["dictionary", "math"]: n := mk(N_IMPORT, t0); ND[n].s = intern(m); TOP.push(n)
		for j t0..TK.len - 1: if TK[j].k as int == T_IDENT && TK[j].v == NAME_CLASS && TK[j + 1].k as int == T_IDENT { PYC.push(TK[j + 1].v as i32) }
		PYS.clear(); PYG.clear(); PYF.clear(); PYSM = true; j ~= t0; tn i32[>..] ~= []; ti (i32[>..])[>..] ~= []
		while j < TK.len - 1:
			if TK[j].k as int == T_IDENT && TK[j].v == NAME_DEF && (j == t0 || tkat(j - 1) == T_SEMI || tkat(j - 1) == T_RC):
				if TK[j + 1].k as int == T_IDENT && nm(TK[j + 1].v as int) == "main" { PYSM = false }
				j = pyfree(j)
			else if TK[j].k as int == T_IDENT && TK[j].v == NAME_CLASS && (j == t0 || tkat(j - 1) == T_SEMI || tkat(j - 1) == T_RC):
				b ~= j; while b < TK.len - 1 && tkat(b) != T_LC { b++ } j = pyend(b)
			else if TK[j].k as int == T_IDENT && (j == t0 || tkat(j - 1) == T_SEMI || tkat(j - 1) == T_RC) && (tkat(j + 1) == T_ASSIGN || tkat(j + 1) == T_COLON):
				tn.push(TK[j].v as i32); iv i32[>..] ~= []; d ~= 0; q ~= j + 2; while q < TK.len - 1 && !(d == 0 && tkat(q) == T_SEMI) { k := tkat(q); if k == T_LP || k == T_LB || k == T_LC { d++ } if k == T_RP || k == T_RB || k == T_RC { d-- } if k == T_IDENT && tkat(q - 1) != T_DOT { iv.push(TK[q].v as i32) } q++ } ti.push(iv); j = q
			j++
		ch ~= true; while ch { ch = false; for w, wi tn { if pyf(w as int) { for x ti[wi] { if tn.contains(x) && !pyf(x as int) { PYF.push(x); ch = true } } } } }
	while tk() != T_EOF && PERR.len == 0: ptop()
	if FILES[TK[t0].f].py && PYSM && PYS.len > 0 && PERR.len == 0: pymain(t0)
	FILENS.push(FILENS0)
	PERR.len == 0
