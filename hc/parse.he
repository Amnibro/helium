binprec(k int) int:
	if k == T_MUL || k == T_DIV || k == T_MOD: return 10
	if k == T_PLUS || k == T_MINUS: return 9
	if k == T_SHL || k == T_SHR: return 8
	if k == T_AND { return 7; }; if k == T_XOR { return 6; }; if k == T_OR: return 5
	if k == T_LT || k == T_GT || k == T_LTEQ || k == T_GTEQ: return 4
	if k == T_EQ || k == T_NEQ || k == T_DOTEQ || k == T_DOTNEQ: return 3
