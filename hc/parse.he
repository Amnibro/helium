use lex
N_INT := 1; N_FLT := 2; N_STR := 3; N_TRUE := 4; N_FALSE := 5; N_NULL := 6; N_SELF := 7; N_ID := 8
N_BIN := 9; N_UN := 10; N_CALL := 11; N_IDX := 12; N_SLICE := 13; N_DOT := 14; N_AS := 15; N_ARR := 16; N_SLIT := 17; N_FI := 18
N_IF := 19; N_MATCH := 20; N_ARM := 21; N_PITEM := 22; N_BLOCK := 23; N_EBLOCK := 24; N_WHILE := 25; N_LOOP := 26; N_FOR := 27
N_RET := 28; N_BREAK := 29; N_CONT := 30; N_FUNVAL := 31; N_PARAM := 32; N_VDECL := 33; N_ASSIGN := 34; N_INCDEC := 35; N_LIST := 36; N_CFOR := 37
N_TPRIM := 40; N_TNAME := 41; N_TARR := 42; N_TSLICE := 43; N_TREF := 44; N_TFN := 45; N_TVAR := 46; N_TIDX := 47; N_TCONST := 48
N_FN := 50; N_STRUCT := 51; N_ENUM := 52; N_ALIAS := 53; N_IMPORT := 54; N_FIELD := 55; N_VARIANT := 56; N_GEN := 57; N_EXT := 58
A_FIXED := 1; A_VAR := 2; A_LIM := 3; A_GROW := 4; A_GS := 5
