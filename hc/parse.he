mkbin(op int, a int, b int, t int) int: n := mk(N_BIN, t); ND[n].op = op as u8; ND[n].a = a; ND[n].b = b; n
mktw(k int, e int, t int, op int) int: n := mk(k, t); ND[n].a = e; ND[n].op = op as u8; n
pystr(s const byte[:], st int) int: o := STRS.len; STRS.append(s); t := TK[st]; TK.push(Tok{k: T_STR, f: t.f, line: t.line, s: t.s, n: 0, v: o, w: s.len, ..}); mk(N_STR, TK.len - 1)
