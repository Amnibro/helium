	if k == N_CALL && ND[ND[e].a].k as int == N_ID && ND[e].n == 1 && nm(ND[ND[e].a].s) == "defaultdict": lit := mk(N_SLIT, st); ND[lit].a = ty; setl(lit, wbeg()); return lit
