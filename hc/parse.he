				setl(r, m2); ND[n].b = r
		return n
	if is(T_LP): fb := FORBIND; FORBIND = false; t := ptype(); FORBIND = fb; ex(T_RP, "parenthesized type"); return t
	m byte[>..] ~= []; format(m, "type expected, found '", cur_text(), "'"); perr(m)
	mk(N_TPRIM, st)
recursive pexpr() int:
	st := P
	k := tk()
	if k == K_IF: e := pif(); if STMTL { STMTE = true } return e
	if k == K_MATCH: e := pmatch(); if STMTL { STMTE = true } return e
	if k == K_BLOCK: nx(); e := mk(N_EBLOCK, st); { q_ := pblock("block expression"); ND[e].a = q_ }; if STMTL { STMTE = true } return e
	if k == T_LC && !PY: e := pblock("block"); if STMTL { STMTE = true } return e
	if k == K_WHILE: nx(); e := mk(N_WHILE, st); { q_ := pscrut(); ND[e].a = q_ }; { q_ := pblock("while body"); ND[e].b = q_ }; if STMTL { STMTE = true } return e
	if k == K_LOOP: nx(); e := mk(N_LOOP, st); { q_ := pblock("loop body"); ND[e].a = q_ }; if STMTL { STMTE = true } return e
	if k == K_FOR: e := pfor(); if STMTL { STMTE = true } return e
