ex(k int, ctx const byte[:]): if tk() != k { m byte[>..] ~= []; format(m, "expected '", tname(k), "' in ", ctx, ", found '", cur_text(), "'"); perr(m); return } nx();
ident(ctx const byte[:]) int:
