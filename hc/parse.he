	a
var BEND i32[>..]; KEEPEND ~= false
he() bool:
	FILES[TK[P].f].he
semi(ctx const byte[:]): if (TK[P].lay || he()) && (tk() == T_RC || tk() == T_EOF) { return } ex(T_SEMI, ctx);
he_decl() bool:
	if !he() || tk() != T_IDENT && tk() != T_CC: return false
	j ~= P; while tkat(j) == T_IDENT || tkat(j) == T_CC: j++
	if tkat(j) == T_LT:
		d ~= 0; loop:
			k := tkat(j); if k == T_LT { d++ } if k == T_GT { d-- } if k == T_SHR { d -= 2 } if k == T_EOF || k == T_SEMI || k == T_LC { return false } j++; if d <= 0: break
	if tkat(j) != T_LP: return false
	d ~= 0; loop:
		k := tkat(j); if k == T_LP { d++ } if k == T_RP { d-- } if k == T_EOF { return false } j++; if d == 0: break
	loop: k := tkat(j); if k == T_LC { return TK[j].lay } if k == T_SEMI || k == T_RC || k == T_EOF || k == T_FAT || k == T_ASSIGN { return false } j++
	false
in_ahead() bool:
	j ~= P; d ~= 0; loop { k := tkat(j); if k == T_LP || k == T_LB { d++ } if k == T_RP || k == T_RB { d-- } if d == 0 && k == K_IN { return true } if k == T_LC || k == T_SEMI || k == T_EOF || k == T_RC { return false } j++ } false
at_word(w int) bool:
	tk() == T_IDENT && TK[P].v == w
he_fn_at(j int) bool:
	FILES[TK[P].f].he && tkat(j) == T_IDENT && (tkat(j + 1) == T_LP || tkat(j + 1) == T_LT)
at_inline() bool:
	at_word(NAME_INLINE) && (tkat(P + 1) == K_FN || tkat(P + 1) == K_RECURSIVE || tkat(P + 1) == K_THREADFN || he_fn_at(P + 1))
at_checkfree() bool:
	n := tkat(P + 1); at_word(NAME_CHECKFREE) && (n == K_FN || n == K_RECURSIVE || n == K_THREADFN || n == K_SIMD || n == K_EXTERN || n == T_IDENT)
at_lut() bool:
	at_word(NAME_LUT) && (tkat(P + 1) == K_FN || he_fn_at(P + 1))
prim_tok(k int) bool:
	k >= K_BOOL && k <= K_REAL
amni_type() bool:
	k := tk(); FILES[TK[P].f].amni && (prim_tok(k) || k == T_IDENT || k == T_CC || k == K_FN || k == T_LP || k == K_CONST)
lenstore() int:
	k := tk(); if k == K_U8 || k == K_U16 || k == K_U32 || k == K_U64 || k == K_VARINT || k == K_BYTE || k == K_UINT { nx(); return k } perr("unsigned integer storage type or varint expected"); 0
var FORBIND bool
recursive ptype() int:
	cq := is(K_CONST)
	t ~= ptype_prim()
	q ~= cq
	loop:
		st := P
		if is(T_LB):
			if is(T_COLON): ex(T_RB, "slice type"); n := mk(N_TSLICE, st); ND[n].a = t; if q { ND[n].fl = 1; q = false } t = n; continue
			n := mk(N_TARR, st); ND[n].a = t
