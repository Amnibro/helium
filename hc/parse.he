NAME_VAL int ~= -1; NAME_PUSH int ~= -1; NAME_SORTED int ~= -1; NAME_DICTAT int ~= -1; NAME_STR int ~= -1; NAME_EXTEND int ~= -1
mk(k int, t int) int:
	ND.push(Node{k: k, t: t, a: -1, b: -1, c: -1, d: -1, e: -1, s: -1, l: 0, n: 0, ..}); ND.len - 1
tk() int:
	TK[P].k as int
tkat(i int) int:
	if i < 0 { T_SEMI } else { TK[min(i, TK.len - 1)].k as int }
nx():
	if TK[P].k != T_EOF: P++
is(k int) bool:
	if tk() == k { nx(); return true } false
tname(k int) const byte[:]:
	pu := ["(", ")", "[", "]", "{", "}", ",", ";", ":", "?", "::", ".", "..", ".=", ".==", ".!=", "+", "-", "*", "/", "%", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "++", "--", "=", "==", "!=", "<", ">", "<=", ">=", "<<", ">>", "<<=", ">>=", "!", "~", "&", "|", "^", "&&", "||", "->", "=>"]
