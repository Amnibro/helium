		r := mk(N_BREAK, st)
		if tk() != T_SEMI && tk() != T_RC:
			{ q_ := pexpr(); ND[r].a = q_ }
		STMTL = sl; STMTE = se
		return r
	if k == K_CONTINUE: nx(); return mk(N_CONT, st)
	e := pbin(1)
	if PY && !NOTERN && tk() == K_IF: nx(); c := pyc(pbin(1)); ex(K_ELSE, "conditional expression"); al := pexpr(); n := mk(N_IF, st); ND[n].a = c; ND[n].b = mkblock(st, [], e); ND[n].c = mkblock(st, [], al); return n
	e
at_from() bool:
	at_word(NAME_FROM) && (tkat(P + 1) == T_IDENT || tkat(P + 1) == T_CC)
sub_begin(nosl bool) int:
	s := (if NOSL { 1 } else { 0 }) | (if STMTL { 2 } else { 0 }) | (if STMTE { 4 } else { 0 }); NOSL = nosl; STMTL = false; STMTE = false; s
sub_end(s int): NOSL = s & 1 != 0; STMTL = s & 2 != 0; STMTE = s & 4 != 0
pscrut() int:
