		if is(T_LP):
			ND[n].fl = 1
			m := wbeg(); while tk() != T_RP && tk() != T_EOF { WS.push(ptype()); if !is(T_COMMA) { break } } ex(T_RP, "function type"); setl(n, m)
			if is(T_ARROW):
				r := mk(N_LIST, P); m2 := wbeg()
