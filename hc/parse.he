	tl i32[>..] ~= [first as i32]; while is(T_COMMA) { tl.push(pexpr() as i32) }
	ex(T_ASSIGN, "assignment"); vs i32[>..] ~= [pexpr() as i32]; while is(T_COMMA) { vs.push(pexpr() as i32) } semi("assignment statement")
