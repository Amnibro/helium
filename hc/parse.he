			if is(T_DOTDOT):
				ND[n].op = A_LIM as u8; if tk() != T_RB:
					{ q_ := pexpr(); ND[n].b = q_ }
			else:
				if is(T_GT): ex(T_DOTDOT, "resizable array type"); ND[n].op = if is(T_LT) { A_GS as u8 } else { A_GROW as u8 }
				else:
					if prim_tok(tk()):
