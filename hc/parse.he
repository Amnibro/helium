pyskip(): d ~= 0; loop { k := tk(); if k == T_EOF || d == 0 && (k == T_COMMA || k == T_RP) { return } if k == T_LP || k == T_LB || k == T_LC { d++ } if k == T_RP || k == T_RB || k == T_RC { d-- } nx() }
