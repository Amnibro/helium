		if is(T_LP): e = pcall(e, -1, st); continue
		if tk() == T_LB: e = pindex(e); continue
		if is(T_DOT):
			nmid := ident("field access")
			if tk() == T_LC && !NOSL && !TK[P].lay && ND[e].k == N_ID:
				b := mk(N_TNAME, ND[e].t as int); ND[b].s = ND[e].s
