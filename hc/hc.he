use os
use lower
use pkg
use fmt
use lsp
use wasm
use prov
USAGE := "usage: hc <command> file [options] [-- program args...]\n       hc file [options] [-- program args...]\n\ncommands:\n  run        compile natively into the cache and run the program (hc file does too)\n  build      build an executable: -o out (native), or -o out.c for C\n  check      parse and typecheck only\n  fetch      clone the git packages the program declares (--update re-fetches tags and branches)\n  version    print the version\n  help       print this\n\noptions:\n  -o path    output for build (default: the file's name without its extension)\n  --debug    overflow, range and tag checks naming the source line\n  -DNAME=V   a runtime define\n  --offline  fetch no packages: one not in the cache is an error\n  --include file.h   C the program's extern functions come from, built with cc into a shared library\n  --c        build C instead of a native executable\n  --v3       target x86-64-v3 (Haswell and later): AVX2 vector code only, three-operand scalar floats\n\nenvironment: HC_LIB (library directory; default: lib beside hc, then hc/lib)"
VERSION := "hc 0.7 (Helium)"
setlib():
	lib byte[>..] ~= []; if env("HC_LIB", lib): LIBDIR.append(lib); return
	d byte[>..] ~= []; if resource_dir(d): for sub ["/lib", "/../hc/lib", "/../lib"] { p byte[>..] ~= []; p.append(d[..]); p.append(sub); p.append("/std.he"); if file_exists(p[..]) { LIBDIR.append(p[..p.len - 7]); return } }
	LIBDIR.append("hc/lib")
compile(a const byte[:], o const byte[:], native bool, chk bool) bool:
	LG_ON = !WEB
	if !load_program(a): print(DERR); return false
	if native:
		rf := load_import(intern("rt"), 0, -1); if rf < 0 { print(DERR); return false } for d, i DC:
			if d.k as int == D_FN && d.file == rf: XROOTS.push(i as i32)
	if !check_program() || !prov_program(): print(CERR); return false
	if DERR.len > 0: print(DERR); return false
	if chk: return true
	if !build_packages(): print(PERRS); return false
	c byte[>..] ~= []
	if WEB: if !wasm_program(c) { print(LERR); return false } if !write_file(o, c) { print("cannot write ", o); return false } return web_host(o)
	if native: if !lower_program(c) { print(LERR); return false } if !write_file(o, c) || !make_exec(o) { print("cannot write ", o); return false } return true
	if !gen_program(c): print(GERR); return false
	if !write_file(o, c): print("cannot write ", o); return false
	true
web_host(o const byte[:]) bool:
	h byte[>..] ~= []; format(h, LIBDIR, "/../web/web.js"); js byte[>..] ~= []; if !read_file(h[..], js): return true
	d ~= o.len; while d > 0 && o[d - 1] != '/' { d-- } p byte[>..] ~= []; p.append(o[..d]); p.append("helium.js"); old byte[>..] ~= []; if read_file(p[..], old) && old[..] == js[..]: return true
	if !write_file(p[..], js[..]): print("cannot write ", p[..]); return false
	true
argv0() byte[>..]: z byte[>..] ~= []; arg(0, z); z
stem(f const byte[:]) byte[>..]: d ~= 0; e ~= f.len; for c, i f { if c == '/' { d = i + 1 } } for c, i f { if c == '.' && i > d { e = i } } o byte[>..] ~= []; o.append(f[d..e]); o
main():
	a byte[>..] ~= []
	o byte[>..] ~= []
	if arg_count() < 2: print(USAGE); exit(2)
	arg(1, a)
	ol byte[>..] ~= []; OLDLOC = env("HC_OLDLOC", ol) && ol.len > 0 && ol[0] == '1'
	if a[..] == "help" || a[..] == "--help" || a[..] == "-h": print(USAGE); exit(0)
	if a[..] == "version" || a[..] == "--version": print(VERSION); exit(0)
	if arg_count() > 2: arg(2, o)
	if a[..] == "--slim": f byte[>..] ~= []; t byte[>..] ~= []; k byte[>..] ~= []; arg(3, f); arg(4, t); if arg_count() > 5 { arg(5, k) } setlib(); exit(if slim(o[..], f[..], t[..], k[..]) { 0 } else { 1 })
	if a[..] == "--to-he": t byte[>..] ~= []; arg(3, t); parse_init(); exit(if to_he(o[..], t[..]) { 0 } else { 1 })
	if a[..] == "lsp": if o[..] == "--probe" { print("hc lsp 0.7"); exit(0) } setlib(); exit(lsp_main(argv0()[..]))
	if a[..] == "--query": t byte[>..] ~= []; arg(3, t); setlib(); exit(qmain(o[..], t[..]))
	if a[..] == "--tokens": parse_init(); exit(if dump_tokens(o[..]) { 0 } else { 1 })
	if a[..] == "--spv": src byte[>..] ~= []; read_file(o[..], src); w u32[>..] ~= []; if !shc::cspv(src[..], 2, w) { print(shc::ERRM); exit(1) } b byte[>..] ~= []; for x w { for k 4 { b.push(((x >> (k * 8) as u32) & 255) as! byte) } } q byte[>..] ~= []; arg(3, q); write_file(q[..], b[..]); exit(0)
	cmd ~= 0; src byte[>..] ~= []; out byte[>..] ~= []; native ~= true; pa byte[>..] ~= []; i0 ~= 2
	if a[..] == "build" || a[..] == "run" || a[..] == "check" || a[..] == "fetch": cmd = if a[..] == "build" { 1 } else { if a[..] == "run" { 2 } else { if a[..] == "check" { 3 } else { 5 } } }
	else:
		if o.len > 0 && o[0] != '-': src.append(a[..]); out.append(o[..]); native = false; i0 = 3; cmd = 4 else: src.append(a[..]); cmd = 2
	rest ~= false; i ~= i0
	while i < arg_count():
		m byte[>..] ~= []; arg(i, m); i += 1
		if rest: shq(pa, m[..]); continue
		if m[..] == "--": rest = true; continue
		if m[..] == "--native": native = true; continue
		if m[..] == "--c": native = false; continue
		if m[..] == "--v3": V3 = true; continue
		if m[..] == "--static": STC = true; continue
		if m[..] == "--v4": V3 = true; V4 = true; continue
		if m[..] == "--debug": DBG = true; continue
		if m[..] == "--update" && cmd == 5: PKF = 2; continue
		if m[..] == "--offline": PKF = -1; continue
		if m[..] == "--web": WEB = true; native = true; continue
		if m[..] == "-o" && i < arg_count(): out.clear(); arg(i, out); i += 1; continue
		if m[..] == "--include" && i < arg_count(): h byte[>..] ~= []; arg(i, h); HINC.append(h[..]); HINC.push('\n'); i += 1; continue
		if m.len > 2 && m[0] == '-' && m[1] == 'D': HDEF.append(m[2..]); HDEF.push('\n'); continue
		if m.len > 2 && m[0] == '-' && m[1] == 'O': continue
		if src.len == 0 && (m.len == 0 || m[0] != '-'): src.append(m[..]); continue
		if cmd == 2: shq(pa, m[..]); continue
		print("hc: unknown option ", m[..]); exit(2)
	if src.len == 0: print(USAGE); exit(2)
	setlib()
	if WEB && hdef("GS_STACK_RESERVE") < 0: HDEF.append("GS_STACK_RESERVE=33554432\n")
	PKF = if PKF < 0 { 0 } else { max(PKF, 1) }
	if cmd == 5: exit(if load_program(src[..]) { 0 } else { print(DERR); 1 })
	if cmd == 3: exit(if compile(src[..], "", true, true) { 0 } else { 1 })
	if cmd == 1 && out.len == 0: out.append(stem(src[..]))
	if cmd == 1 && out.len > 2 && out[^2..] == ".c": native = false
	if cmd == 2:
		cd byte[>..] ~= []; if !env("XDG_CACHE_HOME", cd) || cd.len == 0 { cd.clear(); env("HOME", cd); cd.append("/.cache") } cd.append("/hc"); mk byte[>..] ~= []; mk.append("mkdir -p"); shq(mk, cd[..]); run_command(mk[..])
		format(out, cd[..], "/", stem(src[..]), "-", hash(src[..]), if DBG { "-debug" } else { "" })
	if !compile(src[..], out[..], native, false): exit(1)
	if cmd == 2: c byte[>..] ~= []; shq(c, out[..]); c.append(pa[..]); exit(run_command(c[..]))
extern tok_f64(b uint) real = "hr_f64_from_bits"
dump_tokens(path const byte[:]) bool:
	if !lex_file(path): print(LERR[..]); return false
	o byte[>..] ~= []
	for i TK.len:
		t := TK[i]; k := t.k as int
		if k == T_EOF: break
		if k == T_IDENT { format(o, "identifier ", tok_text(i)) } else if k == T_INT { format(o, "integer literal ", t.v, " (", tok_text(i), ")") } else if k == T_FLT { format(o, "float literal ", tok_f64(flt_bits(tok_text(i)))) } else if k == T_STR { o.append("string literal \""); for c tok_str(i) { if c == '\n' { o.append("\\n") } else if c == '\t' { o.append("\\t") } else if c == '\r' { o.append("\\r") } else if c == 0 { o.append("\\0") } else if c == '\\' || c == '"' || c == '\'' { o.push('\\'); o.push(c) } else if c < 32 || c >= 127 { format(o, "\\x", "0123456789abcdef"[(c >> 4) as int], "0123456789abcdef"[(c & 15) as int]) } else { o.push(c) } } o.push('"') } else { o.append(tname(if k == K_INT { K_I64 } else if k == K_UINT { K_U64 } else if k == K_BYTE { K_U8 } else if k == K_REAL { K_F64 } else { k })) }
		o.push('\n')
	if o.len > 0 { o.pop() } print(o[..]); true

