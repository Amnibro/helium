		nv = nid(); emitw(SBODY, SOP_COMPOSITEINSERT, [bt, nv, src, old, swi(d, 0)])
	else:
		bc := TY[d.bt].cols; nv = nid(); w int[>..] ~= [bt, nv, old, src]
		for i bc: sel ~= i; for j d.swn { if sel == i && swi(d, j) == i { sel = bc + j } } w.push(sel)
		emitw(SBODY, SOP_VECTORSHUFFLE, w[..])
	emit2(SBODY, SOP_STORE, d.id, nv)
skey(d int, n int) u64: (d as u64) << 32 | n as u64
pushsc(): SCM.push(SCN.len)
popsc():
	d := SCM.len - 1; m := SCM.pop()
	while SCN.len > m: remove(SCD, skey(d, SCN.pop()))
findsym(n int) int:
	d ~= SCM.len - 1
	while d >= 0: f := dgi(SCD, skey(d, n)); if f >= 0 { return f } d -= 1
	-1
addsym(n int, k int, t int, id int, st int, line int) int:
	d := SCM.len - 1
	if contains(SCD, skey(d, n)): serr(line, str("redefinition of '", snm(n), "'"))
	SY.push(Sym{k, n, t, id, st}); insert(SCD, skey(d, n), SY.len - 1); SCN.push(n); SY.len - 1
isprec(n int) bool: s := snm(n); s == "highp" || s == "mediump" || s == "lowp"
lookty(n int) int: dgi(TYNAMES, n)
attype() bool: TOK.k == TK_ID && (isprec(TOK.id) || lookty(TOK.id) >= 0)
iskw(s const byte[:]) bool: TOK.k == TK_ID && snm(TOK.id) == s
acckw(s const byte[:]) bool: if iskw(s) { adv(); true } else { false }
parsetype() int:
	while TOK.k == TK_ID && isprec(TOK.id): adv()
	if TOK.k != TK_ID: serr(TOK.line, "expected type name")
	t := lookty(TOK.id); if t < 0: serr(TOK.line, str("unknown type '", snm(TOK.id), "'"))
	adv(); t
arrtype(el int, len int) int:
	key := ((el as u64) << 12) ^ ((len as! u32) as u64); f := dgi(ARRTY, key); if f >= 0: return f
	t := nty(Ty{T_ARR, el, len}); insert(ARRTY, key, t); t
arrsuffix(base int) int:
	if !isp('['): return base
	if TY[base].k == T_ARR: serr(TOK.line, "multi-dimensional arrays are not supported")
	line := TOK.line; adv(); se := passign(); t, bits := cfold(se)
	if TY[t].k != T_INT && TY[t].k != T_UINT: serr(line, "array size must be an integer constant expression")
	len := (bits as! i32) as int
	if len <= 0: serr(line, "array size must be positive")
	expp(']')
	if isp('['): serr(TOK.line, "multi-dimensional arrays are not supported")
