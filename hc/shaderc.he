tpind(): for i TPI { TPO.push('\t') }
tpvar(t int, n const byte[:]): if TY[t].k == T_ARR { format(TPO, hlslty(TY[t].el), " ", n, "[", TY[t].cols, "]") } else { format(TPO, hlslty(t), " ", n) }
tpopstr(op int) const byte[:]: if op == P_SHL { "<<" } else if op == P_SHR { ">>" } else if op == P_LE { "<=" } else if op == P_GE { ">=" } else if op == P_EQ { "==" } else if op == P_NE { "!=" } else if op == P_AND { "&&" } else if op == P_OR { "||" } else if op == P_ADDA { "+=" } else if op == P_SUBA { "-=" } else if op == P_MULA { "*=" } else if op == P_DIVA { "/=" } else if op == P_MODA { "%=" } else if op == P_ANDA { "&=" } else if op == P_ORA { "|=" } else if op == P_XORA { "^=" } else if op == P_SHLA { "<<=" } else if op == P_SHRA { ">>=" } else if op == '=' { "=" } else if op == '+' { "+" } else if op == '-' { "-" } else if op == '*' { "*" } else if op == '/' { "/" } else if op == '%' { "%" } else if op == '&' { "&" } else if op == '|' { "|" } else if op == '^' { "^" } else if op == '<' { "<" } else if op == '>' { ">" } else if op == ',' { "," } else { "?" }
