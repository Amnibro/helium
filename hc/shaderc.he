genstruct():
	line := TOK.line; name := expid()
	if lookty(name) >= 0: serr(line, str("redefinition of type '", snm(name), "'"))
	t := nty(Ty{T_STRUCT, -1, 0, 0, name}); expp('{')
	while !isp('}'):
		if TOK.k == TK_EOF: serr(TOK.line, "unexpected end of file inside struct")
		b ~= parsetype(); b = arrsuffix(b)
		loop:
			fq := expid(); ft := arrsuffix(b); TY[t].fnm.push(fq); TY[t].fty.push(ft)
			if !accp(','): break
		expp(';')
	adv(); expp(';')
	if TY[t].fty.len == 0: serr(line, str("struct '", snm(name), "' has no fields"))
	insert(TYNAMES, name, t); d := recdecl(D_STRUCT, line); DC[d].ty = t; DC[d].name = name
genglobal(isc bool, t0 int, name int, line int):
	t := arrsuffix(t0); iid ~= 0; fd ~= false; fb u32 ~= 0; ie ~= -1
	if accp('='):
		ie = passign()
		if isc && isscal(t):
			ft, b := cfold(ie); iid = cscalaras(ft, b, t, line); fd = true; fb = convbits(ft, b, t)
		else:
