genfunc(ret int, name int, pty int[>..], pnm int[>..], pq int[>..], body int, line int):
	head := dgi(FNS, name); o ~= head
	while o >= 0:
		if SY[o].params.len == pty.len:
			same ~= true; for t, i pty { if SY[o].params[i] != t { same = false } }
