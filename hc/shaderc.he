		sel, st := rvalue(x.e)
		if st != TINT && st != TUINT: serr(line, "switch selector must be int or uint")
		ng := x.grps.len; mg := nid(); gl int[>..] ~= []; dl ~= mg
		for g x.grps: l := nid(); gl.push(l); if GRP[g].def { dl = l }
		emit2(SBODY, SOP_SELECTIONMERGE, mg, 0); w int[>..] ~= [sel, dl]
		for g, i x.grps: for lb GRP[g].labels { w.push((lb as! i32 as! u32) as int); w.push(gl[i]) }
		emitw(SBODY, SOP_SWITCH, w[..]); BTERM = true; sb := BRKT; BRKT = mg
		for g, i x.grps:
			beginblock(gl[i]); pushsc(); for t GRP[g].sts { genstmt(t) } popsc()
			if !BTERM: branch(if i + 1 < ng { gl[i + 1] } else { mg })
		BRKT = sb; beginblock(mg)
	else if k == S_RET:
		FHASRET = true; rt := if CURRT >= 0 { CURRT } else { TVOID }
		if x.e >= 0:
			if rt == TVOID: serr(line, "void function cannot return a value")
			v := rvalas(x.e, rt); emit1(SBODY, SOP_RETURNVALUE, v)
		else:
			if rt != TVOID: serr(line, "non-void function must return a value")
			emit0(SBODY, SOP_RETURN)
