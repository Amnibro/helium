extractc(a int, at int, j int) int: x := nid(); t := tyid(TY[at].el); emit4(SBODY, SOP_COMPOSITEEXTRACT, t, x, a, j); x
genctor(e int, ty int) Val:
	x := EX[e]; argc := x.args.len; line := x.line; y := TY[ty]
	if argc == 0: serr(line, str("constructor '", tyname(ty), "' requires arguments"))
	if isscal(ty):
		if argc != 1: serr(line, "scalar constructor takes exactly one argument")
		a ~= 0; at ~= 0; a0, at0 := rvalue(x.args[0]); a = a0; at = at0
		if isvec(at): a = extractc(a, at, 0); at = TY[at].el
		return rv(ty, convert(a, at, ty, line))
	if y.k == T_MAT:
		rows := y.rows; cols := y.cols; comps int[>..] ~= []
		if argc == 1:
			a, at := rvalue(x.args[0])
			if !isscal(at): serr(line, str("cannot construct '", tyname(ty), "' from '", tyname(at), "'"))
			d := convert(a, at, TFLOAT, line); z := cfloat(0.0)
			for c cols: for r rows { comps.push(if c == r { d } else { z }) }
		else:
			for i argc:
				a, at := rvalue(x.args[i])
				if isscal(at):
					if comps.len >= 16: serr(line, str("too many components for '", tyname(ty), "'"))
					comps.push(convert(a, at, TFLOAT, line))
				else if isvec(at):
					for j TY[at].cols:
						if comps.len >= 16: serr(line, str("too many components for '", tyname(ty), "'"))
						xx := extractc(a, at, j); comps.push(convert(xx, TY[at].el, TFLOAT, line))
				else:
					serr(line, str("invalid constructor argument of type '", tyname(at), "'"))
			if comps.len != rows * cols: serr(line, str("'", tyname(ty), "' constructor requires ", rows * cols, " components, got ", comps.len))
		ct := tyid(TVEC[rows - 2]); cids int[>..] ~= []
		for c cols:
			cid := nid(); w int[>..] ~= [ct, cid]; for r rows { w.push(comps[c * rows + r]) } emitw(SBODY, SOP_COMPOSITECONSTRUCT, w[..]); cids.push(cid)
		r := nid(); w int[>..] ~= [tyid(ty)]; w.push(r); w.append(cids[..]); emitw(SBODY, SOP_COMPOSITECONSTRUCT, w[..]); return rv(ty, r)
	if y.k == T_STRUCT:
		if argc != y.fty.len: serr(line, str("'", snm(y.name), "' constructor requires ", y.fty.len, " argument(s), got ", argc))
		w int[>..] ~= [tyid(ty)]; r := nid(); w.push(r)
		for i argc: w.push(rvalas(x.args[i], TY[ty].fty[i]))
		emitw(SBODY, SOP_COMPOSITECONSTRUCT, w[..]); return rv(ty, r)
	if !isvec(ty): serr(line, str("unsupported constructor '", tyname(ty), "'"))
	el := y.el; comps int[>..] ~= []
	if argc == 1:
		a, at := rvalue(x.args[0])
		if isscal(at): cv := convert(a, at, el, line); id, vt := splat(cv, el, y.cols); return rv(ty, id)
		if isvec(at) && TY[at].cols >= y.cols:
			for i y.cols: xx := extractc(a, at, i); comps.push(convert(xx, TY[at].el, el, line))
			r := nid(); w int[>..] ~= [tyid(ty)]; w.push(r); w.append(comps[..]); emitw(SBODY, SOP_COMPOSITECONSTRUCT, w[..]); return rv(ty, r)
		serr(line, str("cannot construct '", tyname(ty), "' from '", tyname(at), "'"))
	for i argc:
		a, at := rvalue(x.args[i])
		if isscal(at):
			if comps.len >= 4: serr(line, str("too many components for '", tyname(ty), "'"))
			comps.push(convert(a, at, el, line))
		else if isvec(at):
			for j TY[at].cols:
				if comps.len >= 4: serr(line, str("too many components for '", tyname(ty), "'"))
				xx := extractc(a, at, j); comps.push(convert(xx, TY[at].el, el, line))
		else:
			serr(line, str("invalid constructor argument of type '", tyname(at), "'"))
	if comps.len != y.cols: serr(line, str("'", tyname(ty), "' constructor requires ", y.cols, " components, got ", comps.len))
	r := nid(); w int[>..] ~= [tyid(ty)]; w.push(r); w.append(comps[..]); emitw(SBODY, SOP_COMPOSITECONSTRUCT, w[..]); rv(ty, r)
gencall(e int) Val:
	x := EX[e]; n := x.name; argc := x.args.len; line := x.line
	if x.asz != -1:
		el := lookty(n)
		if el < 0: serr(line, str("unknown type '", snm(n), "'"))
		len := if x.asz != 0 { x.asz } else { argc }
		if argc != len: serr(line, str("array constructor expects ", len, " element(s), got ", argc))
		if len <= 0: serr(line, "array constructor requires at least one element")
		at := arrtype(el, len); w int[>..] ~= [tyid(at)]; r := nid(); w.push(r)
		for i argc: w.push(rvalas(x.args[i], el))
		emitw(SBODY, SOP_COMPOSITECONSTRUCT, w[..]); return rv(at, r)
	ct := lookty(n); if ct >= 0: return genctor(e, ct)
	fh := dgi(FNS, n)
	if fh >= 0:
		ex ~= -1; cv ~= -1; vals Val[>..] ~= []
		for i argc: vals.push(genexpr(x.args[i]))
		o ~= fh
		while o >= 0:
			if SY[o].params.len == argc:
				ae ~= true; ac ~= true
				for i argc:
					p := SY[o].params[i]
					if p != vals[i].ty: ae = false
					ok := if SY[o].pq.len > 0 && SY[o].pq[i] != 0 { p == vals[i].ty } else { implconv(vals[i].ty, p) }
					if !ok: ac = false
				if ae: ex = o; break
				if ac && cv < 0: cv = o
			o = SY[o].nxo
		ch := if ex >= 0 { ex } else { cv }
		if ch < 0: serr(line, str("no matching overload for '", snm(n), "'"))
		cot int[>..] ~= []; coa int[>..] ~= []; r := nid(); w int[>..] ~= [tyid(SY[ch].ty)]; w.push(r); w.push(SY[ch].id)
		for i argc:
			if w.len >= 19: serr(line, "too many arguments")
			q := if SY[ch].pq.len > 0 { SY[ch].pq[i] } else { 0 }
			if q != 0:
				if vals[i].k == V_RV: serr(line, str("argument ", i + 1, " of '", snm(n), "' must be assignable (out/inout parameter)"))
				tmp := nid(); pt := ptrid(SY[ch].params[i], SC_FUNCTION); emit3(SLOCALS, SOP_VARIABLE, pt, tmp, SC_FUNCTION)
				if q == 2: cur := load(vals[i]); emit2(SBODY, SOP_STORE, tmp, cur)
				cot.push(tmp); coa.push(i); w.push(tmp)
			else if opq(SY[ch].params[i]):
				if vals[i].k != V_PTR: serr(line, str("argument ", i + 1, " of '", snm(n), "' must be a sampler or image variable"))
				w.push(vals[i].id)
			else:
				id := load(vals[i]); EX[x.args[i]].want = SY[ch].params[i]; w.push(convert(id, vals[i].ty, SY[ch].params[i], line))
		emitw(SBODY, SOP_FUNCTIONCALL, w[..])
		for t, i cot: ag := coa[i]; ld := nid(); pt := tyid(SY[ch].params[ag]); emit3(SBODY, SOP_LOAD, pt, ld, t); store(vals[ag], ld, line)
		return rv(SY[ch].ty, r)
	ii := dgi(INIX, n); if ii >= 0: return genintrin(e, ii)
	serr(line, str("unknown function '", snm(n), "'")); Val{}
recursive genexpr(e int) Val: v := genexpr1(e); EX[e].rt = v.ty; v
arrlen(sid0 int, mi int) Val:
	ln := nid(); ut := tyid(TUINT); emit4(SBODY, SOP_ARRAYLENGTH, ut, ln, sid0, mi); r := nid(); it := tyid(TINT); emit3(SBODY, SOP_BITCAST, it, r, ln); rv(TINT, r)
recursive genexpr1(e int) Val:
	x := EX[e]; k := x.k; line := x.line
	if k == E_FLT: return rv(TFLOAT, cfloat(x.fv as f32))
	if k == E_INT: return rv(TINT, cint((x.iv as! i32) as int))
	if k == E_UINT: return rv(TUINT, cuint((x.iv as! u32) as int))
	if k == E_BOOL: return rv(TBOOL, cscalar(TBOOL, if x.bv { 1 } else { 0 }))
	if k == E_REF: return genref(e)
	if k == E_MEM: return genmember(e)
	if k == E_CALL: return gencall(e)
	if k == E_LEN:
		b := EX[x.l]
		if b.k == E_REF:
			s := findsym(b.name)
			if s >= 0 && SY[s].k == SY_BM && TY[SY[s].ty].k == T_ARR && TY[SY[s].ty].cols == -1: return arrlen(SY[s].id, SY[s].mi)
		if b.k == E_MEM && EX[b.l].k == E_REF:
			s := findsym(EX[b.l].name)
			if s >= 0 && SY[s].k == SY_VAR && TY[SY[s].ty].k == T_STRUCT && (SY[s].st == SC_STORAGEBUFFER || SY[s].st == SC_UNIFORM):
				st := TY[SY[s].ty]
				for fq, i st.fnm: if fq == b.name && TY[st.fty[i]].k == T_ARR && TY[st.fty[i]].cols == -1 { return arrlen(SY[s].id, i) }
		base := genexpr(x.l)
		if TY[base.ty].k != T_ARR || TY[base.ty].cols == -1: serr(line, ".length() requires an array")
		return rv(TINT, cint(TY[base.ty].cols))
	if k == E_IDX:
		base := genexpr(x.l); bt := base.ty; by := TY[bt]
		if by.k != T_VEC && by.k != T_MAT && by.k != T_ARR: serr(line, str("cannot index '", tyname(bt), "'"))
		ix, it := rvalue(x.r)
		if it != TINT && it != TUINT: serr(line, "index must be an integer")
		el := if by.k == T_VEC || by.k == T_ARR { by.el } else { TVEC[by.rows - 2] }
		pv := if base.k != V_PTR { spill(base) } else { base }
		elaid := if pv.lt != 0 { max(dgi(LAIDE, pv.lt), 0) } else { 0 }
		pt := if elaid != 0 { ptridraw(elaid, pv.st) } else { ptrid(el, pv.st) }
		p := nid(); emit4(SBODY, SOP_ACCESSCHAIN, pt, p, pv.id, ix); return Val{V_PTR, el, p, pv.st, elaid}
	if k == E_UN:
		op := x.op
		if op == P_INC || op == P_DEC:
			lv := genexpr(x.l)
			if lv.k == V_RV: serr(line, str("operand of '", if op == P_INC { "++" } else { "--" }, "' must be assignable"))
			old := load(lv); t := lv.ty; ek := TY[elty(t)].k
			one ~= if ek == T_FLOAT { cfloat(1.0) } else if ek == T_UINT { cuint(1) } else { cint(1) }
			if isvec(t): o2, d := splat(one, elty(t), TY[t].cols); one = o2
			r := nid(); oc := if ek == T_FLOAT { if op == P_INC { SOP_FADD } else { SOP_FSUB } } else { if op == P_INC { SOP_IADD } else { SOP_ISUB } }
			tt := tyid(t); emit4(SBODY, oc, tt, r, old, one); store(lv, r, line); return rv(t, if x.post { old } else { r })
		a, t := rvalue(x.l); ek := TY[elty(t)].k; r := nid()
		if op == '-':
			if TY[t].k == T_MAT { n1 := cfloat(-1.0); tt := tyid(t); emit4(SBODY, SOP_MATRIXTIMESSCALAR, tt, r, a, n1) } else if ek == T_FLOAT { tt := tyid(t); emit3(SBODY, SOP_FNEGATE, tt, r, a) } else if ek == T_INT || ek == T_UINT { tt := tyid(t); emit3(SBODY, SOP_SNEGATE, tt, r, a) } else { serr(line, str("cannot negate '", tyname(t), "'")) }
		else if op == '!':
			if t != TBOOL: serr(line, "'!' requires a bool operand")
			tt := tyid(t); emit3(SBODY, SOP_LOGICALNOT, tt, r, a)
		else if op == '~':
			if ek != T_INT && ek != T_UINT: serr(line, "'~' requires integer operands")
			tt := tyid(t); emit3(SBODY, SOP_NOT, tt, r, a)
		else:
			serr(line, "unsupported unary operator")
		return rv(t, r)
	if k == E_BIN:
		op := x.op
		if op == ',': genexpr(x.l); return genexpr(x.r)
		if op == '=':
			lv := genexpr(x.l)
			if lv.k == V_RV: serr(line, "left side of '=' is not assignable")
			src := rvalas(x.r, lv.ty); store(lv, src, line); return rv(lv.ty, src)
		bo := cbaseop(op)
		if bo != 0:
			lv := genexpr(x.l)
			if lv.k == V_RV: serr(line, "left side of assignment is not assignable")
			a := load(lv); b, bt := rvalue(x.r); r := genbinop(bo, line, a, lv.ty, b, bt)
			if r.ty != lv.ty && !implconv(r.ty, lv.ty): serr(line, str("cannot assign '", tyname(r.ty), "' to '", tyname(lv.ty), "'"))
			cv := convert(r.id, r.ty, lv.ty, line); store(lv, cv, line); return rv(lv.ty, cv)
		if op == P_AND || op == P_OR:
			a, at := rvalue(x.l)
			if at != TBOOL: serr(line, "'&&'/'||' require bool operands")
			tmp := nid(); bp := ptrid(TBOOL, SC_FUNCTION); emit3(SLOCALS, SOP_VARIABLE, bp, tmp, SC_FUNCTION); emit2(SBODY, SOP_STORE, tmp, a)
			rl := nid(); mg := nid(); emit2(SBODY, SOP_SELECTIONMERGE, mg, 0)
			if op == P_AND { emit3(SBODY, SOP_BRANCHCONDITIONAL, a, rl, mg) } else { emit3(SBODY, SOP_BRANCHCONDITIONAL, a, mg, rl) }
			BTERM = true; beginblock(rl); b, bt := rvalue(x.r)
			if bt != TBOOL: serr(line, "'&&'/'||' require bool operands")
			emit2(SBODY, SOP_STORE, tmp, b); branch(mg); beginblock(mg); r := nid(); tt := tyid(TBOOL); emit3(SBODY, SOP_LOAD, tt, r, tmp); return rv(TBOOL, r)
		a, at := rvalue(x.l); b, bt := rvalue(x.r); return genbinop(op, line, a, at, b, bt)
