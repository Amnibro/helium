	s := nst(S_EXPR, line); e := pexpr(); ST[s].e = e; expp(';'); s
struct Lay { loc int = -1, set int = -1, bind int = -1, lx int = -1, ly int = -1, lz int = -1, fmt int = -1 }
playout() Lay:
	l ~= Lay{}; expp('(')
	loop:
		key := expid(); k := snm(key); v ~= -1
		if accp('='):
			if TOK.k != TK_INT && TOK.k != TK_UINT: serr(TOK.line, str("expected integer for layout qualifier '", k, "'"))
			v = (TOK.iv as! i32) as int; adv()
		if k == "location" { l.loc = v } else if k == "set" { l.set = v } else if k == "binding" { l.bind = v } else if k == "std140" || k == "std430" { v = v } else if k == "local_size_x" { l.lx = v } else if k == "local_size_y" { l.ly = v } else if k == "local_size_z" { l.lz = v } else if k == "rgba32f" { l.fmt = 1 } else if k == "rgba16f" { l.fmt = 2 } else if k == "r32f" { l.fmt = 3 } else if k == "rgba8" { l.fmt = 4 } else if k == "rgba8ui" { l.fmt = 32 } else if k == "r32ui" { l.fmt = 33 } else if k == "rg32f" { l.fmt = 6 } else if k == "rg16f" { l.fmt = 7 } else if k == "r16f" { l.fmt = 9 } else { serr(TOK.line, str("unsupported layout qualifier '", k, "'")) }
		if !accp(','): break
	expp(')'); l
isscal(t int) bool: k := TY[t].k; k == T_BOOL || k == T_INT || k == T_UINT || k == T_FLOAT
isvec(t int) bool: TY[t].k == T_VEC
elty(t int) int: if TY[t].k == T_VEC { TY[t].el } else { t }
ncomp(t int) int: if TY[t].k == T_VEC { TY[t].cols } else { 1 }
vecty(el int, n int) int:
	if n == 1: return el
	k := TY[el].k
	if k == T_FLOAT { TVEC[n - 2] } else if k == T_INT { TIVEC[n - 2] } else if k == T_UINT { TUVEC[n - 2] } else if k == T_BOOL { TBVEC[n - 2] } else { -1 }
tyname(t int) const byte[:]:
	y := TY[t]; k := y.k; c := y.cols
	if k == T_VOID: return "void"
	if k == T_BOOL: return "bool"
	if k == T_INT: return "int"
	if k == T_UINT: return "uint"
	if k == T_FLOAT: return "float"
	if k == T_SAMP: return if c == SD_CUBE { "samplerCube" } else if c == SD_3D { "sampler3D" } else if c == SD_2DA { "sampler2DArray" } else if c == SD_2DS { "sampler2DShadow" } else if c == SD_CUBES { "samplerCubeShadow" } else if c == SD_2DAS { "sampler2DArrayShadow" } else if y.el >= 0 && TY[y.el].k == T_UINT { "usampler2D" } else { "sampler2D" }
	if k == T_ARR: return "array"
	if k == T_STRUCT: return snm(y.name)
	if k == T_IMG: return "image2D"
	if k == T_MAT: return if c == 2 { "mat2" } else if c == 3 { "mat3" } else { "mat4" }
	if k == T_VEC:
		ek := TY[y.el].k
		if ek == T_FLOAT: return if c == 2 { "vec2" } else if c == 3 { "vec3" } else { "vec4" }
		if ek == T_INT: return if c == 2 { "ivec2" } else if c == 3 { "ivec3" } else { "ivec4" }
		if ek == T_UINT: return if c == 2 { "uvec2" } else if c == 3 { "uvec3" } else { "uvec4" }
		return if c == 2 { "bvec2" } else if c == 3 { "bvec3" } else { "bvec4" }
	"?"
prank(t int) int: k := TY[t].k; if k == T_INT { 1 } else if k == T_UINT { 2 } else if k == T_FLOAT { 3 } else { 0 }
convert(id int, from int, to int, line int) int:
	if from == to: return id
	fk := TY[elty(from)].k; tk := TY[elty(to)].k
	if ncomp(from) != ncomp(to): serr(line, str("cannot convert '", tyname(from), "' to '", tyname(to), "'"))
	if fk == tk: return id
	op := if fk == T_INT && tk == T_FLOAT { SOP_CONVERTSTOF } else if fk == T_UINT && tk == T_FLOAT { SOP_CONVERTUTOF } else if fk == T_INT && tk == T_UINT || fk == T_UINT && tk == T_INT { SOP_BITCAST } else if fk == T_FLOAT && tk == T_INT { SOP_CONVERTFTOS } else if fk == T_FLOAT && tk == T_UINT { SOP_CONVERTFTOU } else { 0 }
	if op == 0: serr(line, str("cannot convert '", tyname(from), "' to '", tyname(to), "'"))
	r := nid(); t := tyid(to); emit3(SBODY, op, t, r, id); r
implconv(from int, to int) bool:
	if from == to: return true
	if ncomp(from) != ncomp(to): return false
	if isscal(from) != isscal(to) && !(isvec(from) && isvec(to)): return false
	fr := prank(elty(from)); tr := prank(elty(to)); fr != 0 && tr != 0 && fr <= tr
splat(sid int, st int, n int) int, int:
	vt := vecty(st, n); r := nid(); w int[>..] ~= [tyid(vt)]; w.push(r)
	for i n: w.push(sid)
	emitw(SBODY, SOP_COMPOSITECONSTRUCT, w[..]); return r, vt
rvalue(e int) int, int: v := genexpr(e); return load(v), v.ty
spill(v Val) Val:
	ld := load(v); vr := nid(); pt := ptrid(v.ty, SC_FUNCTION); emit3(SLOCALS, SOP_VARIABLE, pt, vr, SC_FUNCTION); emit2(SBODY, SOP_STORE, vr, ld)
	Val{V_PTR, v.ty, vr, SC_FUNCTION}
rvalas(e int, want int) int:
	id, t := rvalue(e)
	if t != want && !implconv(t, want): serr(EX[e].line, str("cannot convert '", tyname(t), "' to '", tyname(want), "'"))
	EX[e].want = want; convert(id, t, want, EX[e].line)
balance(line int, a0 int, at0 int, b0 int, bt0 int) int, int, int, int:
	a ~= a0; at ~= at0; b ~= b0; bt ~= bt0; ar := prank(elty(at)); br := prank(elty(bt))
	if ar == 0 || br == 0: serr(line, str("invalid operands ('", tyname(at), "' and '", tyname(bt), "')"))
	el := if ar >= br { elty(at) } else { elty(bt) }
	if elty(at) != el: w := vecty(el, ncomp(at)); a = convert(a, at, w, line); at = w
	if elty(bt) != el: w := vecty(el, ncomp(bt)); b = convert(b, bt, w, line); bt = w
	if isvec(at) && isscal(bt):
		x, y := splat(b, bt, TY[at].cols); b = x; bt = y
	else if isscal(at) && isvec(bt):
		x, y := splat(a, at, TY[bt].cols); a = x; at = y
	else if isvec(at) && isvec(bt) && TY[at].cols != TY[bt].cols:
		serr(line, str("vector size mismatch ('", tyname(at), "' and '", tyname(bt), "')"))
	return a, at, b, bt
dryty(e int) int:
	sb := copy(SBODY); sl := copy(SLOCALS); st := BTERM; SBODY.clear(); SLOCALS.clear()
	v := genexpr(e); SBODY.clear(); SBODY.append(sb[..]); SLOCALS.clear(); SLOCALS.append(sl[..]); BTERM = st; v.ty
unify(at int, bt int, line int) int:
	if at == bt: return at
	ar := prank(elty(at)); br := prank(elty(bt))
	if ar == 0 || br == 0: serr(line, str("mismatched types ('", tyname(at), "' and '", tyname(bt), "')"))
	el := if ar >= br { elty(at) } else { elty(bt) }; ca := ncomp(at); cb := ncomp(bt)
	if isvec(at) && isvec(bt) && ca != cb: serr(line, str("vector size mismatch ('", tyname(at), "' and '", tyname(bt), "')"))
	vecty(el, if ca > cb { ca } else { cb })
genbinop(op int, line int, a0 int, at0 int, b0 int, bt0 int) Val:
	at := at0; bt := bt0; ak := TY[at].k; bk := TY[bt].k
	if ak == T_MAT || bk == T_MAT:
		if (op == '+' || op == '-') && ak == T_MAT && bk == T_MAT:
			if at != bt: serr(line, "matrix size mismatch")
			ct := tyid(TVEC[TY[at].rows - 2]); cols int[>..] ~= []
			for c TY[at].cols:
				ca := nid(); emit4(SBODY, SOP_COMPOSITEEXTRACT, ct, ca, a0, c); cb := nid(); emit4(SBODY, SOP_COMPOSITEEXTRACT, ct, cb, b0, c)
				cr := nid(); emit4(SBODY, if op == '+' { SOP_FADD } else { SOP_FSUB }, ct, cr, ca, cb); cols.push(cr)
			r := nid(); w int[>..] ~= [tyid(at)]; w.push(r); w.append(cols[..]); emitw(SBODY, SOP_COMPOSITECONSTRUCT, w[..]); return rv(at, r)
		if op != '*': serr(line, "only '*', '+', and '-' are supported with matrix operands")
		r := nid()
		if ak == T_MAT && bk == T_MAT:
			if at != bt: serr(line, "matrix size mismatch")
			t := tyid(at); emit4(SBODY, SOP_MATRIXTIMESMATRIX, t, r, a0, b0); return rv(at, r)
		if ak == T_MAT && isvec(bt):
			if TY[TY[bt].el].k != T_FLOAT || TY[bt].cols != TY[at].cols: serr(line, "matrix/vector size mismatch")
			rt := TVEC[TY[at].rows - 2]; t := tyid(rt); emit4(SBODY, SOP_MATRIXTIMESVECTOR, t, r, a0, b0); return rv(rt, r)
		if isvec(at) && bk == T_MAT:
			if TY[TY[at].el].k != T_FLOAT || TY[at].cols != TY[bt].rows: serr(line, "vector/matrix size mismatch")
			rt := TVEC[TY[bt].cols - 2]; t := tyid(rt); emit4(SBODY, SOP_VECTORTIMESMATRIX, t, r, a0, b0); return rv(rt, r)
		m := if ak == T_MAT { a0 } else { b0 }; mt := if ak == T_MAT { at } else { bt }; s ~= if ak == T_MAT { b0 } else { a0 }; sty := if ak == T_MAT { bt } else { at }
		if !isscal(sty): serr(line, "invalid matrix operand")
		s = convert(s, sty, TFLOAT, line); t := tyid(mt); emit4(SBODY, SOP_MATRIXTIMESSCALAR, t, r, m, s); return rv(mt, r)
