		vw := nty(Ty{T_STRUCT, -1, 0, 0, bn}); TY[vw].fnm.append(mn[..]); TY[vw].fty.append(mt[..]); insert(TYIDS, vw, sid0); addsym(inst, SY_VAR, vw, vr, st, line)
	else:
