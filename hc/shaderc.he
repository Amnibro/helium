ppeval(s const byte[:]) int: x := expand(s, true); PXS.clear(); PXS.append(x[..]); PXP = 0; pxtern()
ppdefine(s const byte[:]):
	p ~= 0; e := s.len
	while p < e && (s[p] == ' ' || s[p] == '\t'): p += 1
	if p >= e || !idst(s[p] as int): pperr("expected macro name after #define")
	ns := p; while p < e && idch(s[p] as int) { p += 1 } name := sid(s[ns..p])
	m ~= Mac{name, false, [], []}
	if p < e && s[p] == '(':
		m.isf = true; p += 1
		loop:
			while p < e && (s[p] == ' ' || s[p] == '\t'): p += 1
			if p < e && s[p] == ')': p += 1; break
			if p >= e || !idst(s[p] as int): pperr(str("bad parameter list for macro '", snm(name), "'"))
			ps := p; while p < e && idch(s[p] as int) { p += 1 } m.params.push(sid(s[ps..p]))
			while p < e && (s[p] == ' ' || s[p] == '\t'): p += 1
			if p < e && s[p] == ',': p += 1; continue
			if p < e && s[p] == ')': p += 1; break
