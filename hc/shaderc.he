			SY[s].laid = if y.k == T_STRUCT || y.k == T_ARR && (y.cols >= 0 || TY[y.el].k == T_STRUCT) { mtids[i] } else { 0 }
	if isbuf { RBUF.push(RRes{bn, l.set, l.bind, ro}) } else { RBLK.push(RBlk{bn, l.set, l.bind, (off + 15) / 16 * 16, mt.len, fm}) }
	d := recdecl(D_BLOCK, line); DC[d].name = bn; DC[d].set = l.set; DC[d].bind = l.bind; DC[d].ro = ro; DC[d].isbuf = isbuf; DC[d].inst = inst; DC[d].mty.append(mt[..]); DC[d].mnm.append(mn[..])
genopaque(l Lay, t0 int, name int, ro bool, wo bool, line int):
	t ~= t0
