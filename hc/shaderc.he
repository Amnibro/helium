	if iid != 0 { emit4(SGLOB, SOP_VARIABLE, pt, vr, SC_PRIVATE, iid) } else { emit3(SGLOB, SOP_VARIABLE, pt, vr, SC_PRIVATE) }
	nameid(vr, snm(name)); s := addsym(name, SY_VAR, t, vr, SC_PRIVATE, line); SY[s].hcv = fd; SY[s].cbits = fb
	d := recdecl(D_GLOBAL, line); DC[d].ty = t; DC[d].name = name; DC[d].isc = isc; DC[d].init = ie
gentop():
	while TOK.k != TK_EOF:
		if accp(';'): continue
		line := TOK.line
		if acckw("struct"): genstruct(); continue
		l ~= Lay{}; hl ~= false; flat ~= false; io ~= false; isin ~= false; ro ~= false; wo ~= false
		loop:
			if acckw("layout") { l = playout(); hl = true } else if acckw("flat") { flat = true } else if acckw("readonly") { ro = true } else if acckw("writeonly") { wo = true } else if acckw("in") { io = true; isin = true } else if acckw("out") { io = true; isin = false } else { break }
		if io:
			if isin && accp(';'):
