recdecl(k int, line int) int: DC.push(Dc{k, line}); DECLS.push(DC.len - 1); DC.len - 1
opq(t int) bool: TY[t].k == T_SAMP || TY[t].k == T_IMG
fntyid(ret int, pty const int[:], pq const int[:]) int:
	rt := tyid(ret); pt int[>..] ~= []
