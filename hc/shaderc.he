		c, ct := rvalue(x.c)
		if ct != TBOOL: serr(line, "ternary condition must be bool")
		at := dryty(x.l); bt := dryty(x.r); rt := unify(at, bt, line)
		tmp := nid(); pt := ptrid(rt, SC_FUNCTION); emit3(SLOCALS, SOP_VARIABLE, pt, tmp, SC_FUNCTION)
		tl := nid(); el := nid(); mg := nid(); emit2(SBODY, SOP_SELECTIONMERGE, mg, 0); emit3(SBODY, SOP_BRANCHCONDITIONAL, c, tl, el)
		BTERM = true; beginblock(tl); va := rvalas(x.l, rt); emit2(SBODY, SOP_STORE, tmp, va); branch(mg)
		beginblock(el); vb := rvalas(x.r, rt); emit2(SBODY, SOP_STORE, tmp, vb); branch(mg)
		beginblock(mg); r := nid(); tt := tyid(rt); emit3(SBODY, SOP_LOAD, tt, r, tmp); return rv(rt, r)
	serr(line, "internal: unhandled expression"); Val{}
beginblock(l int): emit1(SBODY, SOP_LABEL, l); BTERM = false
branch(t int): emit1(SBODY, SOP_BRANCH, t); BTERM = true
condb(e int, line int, what const byte[:]) int: c, t := rvalue(e); if t != TBOOL { serr(line, what) } c
recursive genstmt(s int):
	if BTERM: beginblock(nid())
	x := ST[s]; k := x.k; line := x.line
	if k == S_BLOCK:
		pushsc(); for b x.blk { genstmt(b) } popsc()
	else if k == S_DECL:
		vr := nid(); pt := ptrid(x.ty, SC_FUNCTION); emit3(SLOCALS, SOP_VARIABLE, pt, vr, SC_FUNCTION); nameid(vr, snm(x.name)); addsym(x.name, SY_VAR, x.ty, vr, SC_FUNCTION, line)
		if x.init >= 0: i := rvalas(x.init, x.ty); emit2(SBODY, SOP_STORE, vr, i)
