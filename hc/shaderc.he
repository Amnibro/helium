genublock(l Lay, bn int, isbuf bool, ro bool, line int):
	kind := if isbuf { "buffer" } else { "uniform" }
	if l.set < 0 || l.bind < 0: serr(line, str(kind, " block '", snm(bn), "' requires layout(set = N, binding = M)"))
	mt int[>..] ~= []; mn int[>..] ~= []; ml int[>..] ~= []; expp('{')
	while !isp('}'):
		mline := TOK.line; m ~= parsetype(); nmm := expid()
		if accp('['):
