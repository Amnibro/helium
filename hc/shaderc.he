		if TY[elty(at)].k != T_FLOAT: serr(line, str("'", fnn, "' requires float operands"))
		rt := vecty(TBOOL, ncomp(at)); r := nid(); t := tyid(rt); emit3(SBODY, f.op, t, r, v); return rv(rt, r)
	ids int[>..] ~= []; tys int[>..] ~= []
	for i argc: v, t := rvalue(a[i]); ids.push(v); tys.push(t)
	if k == I_EXT && f.op == G_FMIX && argc == 3 && TY[elty(tys[2])].k == T_BOOL:
		if tys[0] != tys[1] || ncomp(tys[2]) != ncomp(tys[0]): serr(line, "mix() with a bvec selector requires matching operand types")
		r := nid(); t := tyid(tys[0]); emit5(SBODY, SOP_SELECT, t, r, ids[2], ids[1], ids[0]); return rv(tys[0], r)
	tc ~= 1; for t tys { if ncomp(t) > tc { tc = ncomp(t) } }
	ai ~= f.ops != 0; for t tys { kk := TY[elty(t)].k; if kk != T_INT && kk != T_UINT { ai = false } }
	el ~= TFLOAT; inst ~= f.op
	if ai: au ~= false; for t tys { if TY[elty(t)].k == T_UINT { au = true } } el = if au { TUINT } else { TINT }; inst = if au { f.opu } else { f.ops }
