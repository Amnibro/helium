recursive std140(t int, line int) int, int:
	y := TY[t]
	if y.k == T_FLOAT || y.k == T_INT || y.k == T_UINT: return 4, 4
	if y.k == T_VEC: return if y.cols == 2 { 8 } else { 16 }, if y.cols == 2 { 8 } else if y.cols == 3 { 12 } else { 16 }
