recursive pprimary() int:
	line := TOK.line
	if accp('('): e := pexpr(); expp(')'); return e
	if TOK.k == TK_FLT: e := nex(E_FLT, line); EX[e].fv = TOK.fv; adv(); return e
	if TOK.k == TK_INT || TOK.k == TK_UINT: e := nex(if TOK.k == TK_INT { E_INT } else { E_UINT }, line); EX[e].iv = TOK.iv; adv(); return e
	if TOK.k == TK_ID:
		n := TOK.id; s := snm(n)
		if s == "true" || s == "false": e := nex(E_BOOL, line); EX[e].bv = s == "true"; adv(); return e
		adv(); asz ~= -1
		if isp('[') && lookty(n) >= 0:
			adv(); asz = 0
			if TOK.k == TK_INT || TOK.k == TK_UINT: asz = (TOK.iv as! i32) as int; adv()
			expp(']')
		if isp('('):
			adv(); e := nex(E_CALL, line); EX[e].name = n; EX[e].asz = asz
			if !isp(')'): loop { a := passign(); EX[e].args.push(a); if !accp(',') { break } }
			expp(')'); return e
		if asz != -1: serr(line, "expected '(' after array type")
		e := nex(E_REF, line); EX[e].name = n; return e
	serr(line, "unexpected token in expression"); -1
recursive ppostfix() int:
	e ~= pprimary()
	loop:
		line := TOK.line
		if accp('.'):
			mb := expid()
			if snm(mb) == "length" && isp('('): adv(); expp(')'); m := nex(E_LEN, line); EX[m].l = e; e = m; continue
			m := nex(E_MEM, line); EX[m].l = e; EX[m].name = mb; e = m
		else if accp('['):
			x := nex(E_IDX, line); EX[x].l = e; i := pexpr(); EX[x].r = i; expp(']'); e = x
		else if isp(P_INC) || isp(P_DEC):
			u := nex(E_UN, line); EX[u].op = TOK.p; EX[u].l = e; EX[u].post = true; adv(); e = u
		else:
			break
	e
recursive punary() int:
	line := TOK.line
	if TOK.k == TK_P:
		p := TOK.p
		if p == '-' || p == '!' || p == '~' || p == '+' || p == P_INC || p == P_DEC:
			adv(); o := punary()
			if p == '+': return o
			e := nex(E_UN, line); EX[e].op = p; EX[e].l = o; return e
	ppostfix()
binprec(p int) int: if p == '*' || p == '/' || p == '%' { 10 } else if p == '+' || p == '-' { 9 } else if p == P_SHL || p == P_SHR { 8 } else if p == '<' || p == '>' || p == P_LE || p == P_GE { 7 } else if p == P_EQ || p == P_NE { 6 } else if p == '&' { 5 } else if p == '^' { 4 } else if p == '|' { 3 } else if p == P_AND { 2 } else if p == P_OR { 1 } else { 0 }
recursive pbinary(mp int) int:
	l ~= punary()
	loop:
		if TOK.k != TK_P: break
		op := TOK.p; pr := binprec(op)
		if pr == 0 || pr < mp: break
		line := TOK.line; adv(); r := pbinary(pr + 1); e := nex(E_BIN, line); EX[e].op = op; EX[e].l = l; EX[e].r = r; l = e
	l
recursive pternary() int:
	c := pbinary(1)
	if accp('?'):
		line := EX[c].line; a := passign(); expp(':'); b := passign(); e := nex(E_COND, line); EX[e].c = c; EX[e].l = a; EX[e].r = b; return e
	c
isassign(p int) bool: p == '=' || p >= P_ADDA && p <= P_SHRA
recursive passign() int:
	l := pternary()
	if TOK.k == TK_P && isassign(TOK.p):
		op := TOK.p; line := TOK.line; adv(); r := passign(); e := nex(E_BIN, line); EX[e].op = op; EX[e].l = l; EX[e].r = r; return e
	l
pexpr() int: passign()
recursive pblock() int:
	line := TOK.line; expp('{'); b := nst(S_BLOCK, line)
	while !isp('}'): if TOK.k == TK_EOF { serr(TOK.line, "unexpected end of file inside block") } s := pstmt(); ST[b].blk.push(s)
	adv(); b
pdecl() int:
	line := TOK.line; bt ~= parsetype(); bt = arrsuffix(bt); head ~= -1; tail ~= -1
	loop:
		n := expid(); t := arrsuffix(bt); s := nst(S_DECL, line); ST[s].ty = t; ST[s].name = n
		if accp('='): i := passign(); ST[s].init = i
		if tail >= 0 { ST[tail].nx = s } else { head = s }
		tail = s
		if !accp(','): break
	expp(';'); head
pcomma() int:
	e ~= passign()
	while isp(','): line := TOK.line; adv(); r := passign(); s := nex(E_BIN, line); EX[s].op = ','; EX[s].l = e; EX[s].r = r; e = s
	e
recursive pstmt() int:
	line := TOK.line
	if isp('{'): return pblock()
	if acckw("if"):
		expp('('); s := nst(S_IF, line); c := pexpr(); ST[s].e = c; expp(')'); a := pstmt(); ST[s].a = a
		if acckw("else"): b := pstmt(); ST[s].b = b
		return s
	if acckw("for"):
		expp('('); s := nst(S_FOR, line)
		if !accp(';'):
			if attype():
				i := pdecl(); ST[s].a = i
			else:
				i := nst(S_EXPR, TOK.line); x := pexpr(); ST[i].e = x; ST[s].a = i; expp(';')
		if !isp(';'): c := pexpr(); ST[s].e = c
		expp(';')
		if !isp(')'): it := pcomma(); ST[s].it = it
		expp(')'); b := pstmt(); ST[s].b = b; return s
	if acckw("while"):
		expp('('); s := nst(S_WHILE, line); c := pexpr(); ST[s].e = c; expp(')'); b := pstmt(); ST[s].b = b; return s
	if acckw("do"):
		s := nst(S_DO, line); b := pstmt(); ST[s].b = b
		if !acckw("while"): serr(TOK.line, "expected 'while' after do-block")
		expp('('); c := pexpr(); ST[s].e = c; expp(')'); expp(';'); return s
	if acckw("switch"):
		expp('('); s := nst(S_SWITCH, line); c := pexpr(); ST[s].e = c; expp(')'); expp('{'); cur ~= -1
		while !isp('}'):
			if TOK.k == TK_EOF: serr(TOK.line, "unexpected end of file inside switch")
			if acckw("case") || iskw("default"):
