	if acckw("discard"): expp(';'); return nst(S_DISCARD, line)
	if acckw("break"): expp(';'); return nst(S_BREAK, line)
	if acckw("continue"): expp(';'); return nst(S_CONT, line)
	if acckw("const"):
		if !attype(): serr(TOK.line, "expected type after 'const'")
