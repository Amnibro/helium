lnend(s const byte[:], i int) int: e ~= i; while e < s.len && s[e] != '\n' { e += 1 } e
recursive ppfile(raw const byte[:], fi int):
	src := strip_comments(raw); s := src[..]; ppmark(1, fi); FIDX = fi; PPLINE = 1; cb := CONDS.len; p ~= 0
	while p < s.len:
		lst ~= p; sl := PPLINE; jn byte[>..] ~= []; hj ~= false; le ~= 0
		loop:
			le = lnend(s, lst); cont := le > lst && s[le - 1] == '\\'
			if cont || hj: hj = true; jn.append(s[lst..(if cont { le - 1 } else { le })])
			if !cont: break
			PPLINE += 1; lst = if le < s.len { le + 1 } else { le }
		line byte[>..] ~= []; line.append(if hj { jn[..] } else { s[lst..le] })
		q ~= 0; while q < line.len && (line[q] == ' ' || line[q] == '\t') { q += 1 }
		isd := q < line.len && line[q] == '#'
		if !isd && ppact():
			while le < s.len:
				pd := scan_pending(line[..])
				if pd == PEND_DONE: break
				nx ~= le + 1; pk ~= nx
				while ch(s, pk) == ' ' || ch(s, pk) == '\t' || ch(s, pk) == '\n': pk += 1
				if pd == PEND_PAREN && ch(s, pk) != '(': break
				if ch(s, pk) == '#': break
				hj = true; line.push(' ')
				loop:
					ne := lnend(s, nx); cont := ne > nx && s[ne - 1] == '\\'
					line.append(s[nx..(if cont { ne - 1 } else { ne })]); le = ne
					if !cont || le >= s.len: break
					PPLINE += 1; nx = le + 1
				PPLINE += 1
		if isd:
			q += 1; while q < line.len && (line[q] == ' ' || line[q] == '\t') { q += 1 }
			ds := q; while q < line.len && idch(line[q] as int) { q += 1 } d := snm(sid(line[ds..q])); rest := line[q..]; act := ppact(); spl ~= false
			if d == "include":
				if act: spl = ppinclude(rest, fi, sl + 1)
			else if d == "define":
				if act: ppdefine(rest)
			else if d == "undef":
				if act: r ~= 0; while r < rest.len && (rest[r] == ' ' || rest[r] == '\t') { r += 1 } ns := r; while r < rest.len && idch(rest[r] as int) { r += 1 } k := mac(sid(rest[ns..r])); if k >= 0 { remove(MIDX, MACS[k].name); MACS[k].name = -2 }
			else if d == "ifdef" || d == "ifndef":
				r ~= 0; while r < rest.len && (rest[r] == ' ' || rest[r] == '\t') { r += 1 } ns := r; while r < rest.len && idch(rest[r] as int) { r += 1 }
				df := mac(sid(rest[ns..r])) >= 0; a := act && (if d == "ifndef" { !df } else { df }); CONDS.push(Cond{act, a, a, false})
			else if d == "if":
				a := act && ppeval(rest) != 0; CONDS.push(Cond{act, a, a, false})
			else if d == "elif":
				if CONDS.len <= cb: pperr("#elif without #if")
				c := &CONDS[CONDS.len - 1]
				if c.se: pperr("#elif after #else")
				if c.taken { c.act = false } else { c.act = c.pa && ppeval(rest) != 0 } c.taken = c.taken || c.act
			else if d == "else":
				if CONDS.len <= cb: pperr("#else without #if")
				c := &CONDS[CONDS.len - 1]
				if c.se: pperr("duplicate #else")
				c.se = true; c.act = c.pa && !c.taken; c.taken = true
			else if d == "endif":
				if CONDS.len <= cb: pperr("#endif without #if")
				CONDS.pop()
			else if d == "version" || d == "extension" || d == "pragma" || d == "line":
