		if x.args.len != y.cols: serr(x.line, str("array constructor expects ", y.cols, " element(s), got ", x.args.len))
		id := nid(); w int[>..] ~= [tyid(want)]; w.push(id)
		for a x.args: w.push(constexpr(a, y.el))
