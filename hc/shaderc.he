preprocess(src const byte[:]):
	KW_DEFINED = sid("defined"); MACS.clear(); MIDX = dictionary<int, int>{..}; INCL = dictionary<int, bool>{..}; CONDS.clear(); EXPN.clear(); PPO.clear()
	n byte[>..] ~= []; n.append("shader"); SFILES.push(n); ppfile(src, 0); FIDX = 0
struct Snm { s int, n int }
var SNB byte[>..]
var SNM Snm[>..]
var SNH int[>..]
snm(id int) const byte[:]: x := SNM[id]; SNB[x.s..x.s + x.n]
shash(s const byte[:]) u64: h u64 ~= 1469598103934665603; for c s { h = (h ^ c) * 1099511628211 } h
sid(s const byte[:]) int:
	if SNH.len == 0: SNH.resize(1 << 10, -1)
	if SNM.len * 2 >= SNH.len:
		n := SNH.len * 2; SNH.clear(); SNH.resize(n, -1)
		for x, i SNM: j ~= (shash(SNB[x.s..x.s + x.n]) as int) & n - 1; while SNH[j] >= 0 { j = j + 1 & n - 1 } SNH[j] = i
	m := SNH.len - 1; j ~= (shash(s) as int) & m
	while SNH[j] >= 0: if snm(SNH[j]) == s { return SNH[j] } j = j + 1 & m
	id := SNM.len; SNM.push(Snm{SNB.len, s.len}); SNB.append(s); SNH[j] = id; id
dgi<K>(d dictionary<K, int>&, k K) int: i := dat(d, k); if i < 0 { -1 } else { d.slots[i].val }
T_VOID := 0
T_BOOL := 1
T_INT := 2
T_UINT := 3
T_FLOAT := 4
T_VEC := 5
T_MAT := 6
T_SAMP := 7
T_ARR := 8
T_STRUCT := 9
T_IMG := 10
SD_2D := 0
SD_CUBE := 1
SD_3D := 2
SD_2DA := 3
SD_2DS := 4
SD_CUBES := 5
SD_2DAS := 6
struct Ty { k int, el int = -1, cols int = 0, rows int = 0, name int = -1, fnm int[>..] = [], fty int[>..] = [] }
E_FLT := 0
E_INT := 1
E_UINT := 2
E_BOOL := 3
E_REF := 4
E_BIN := 5
E_UN := 6
E_COND := 7
E_CALL := 8
E_MEM := 9
E_IDX := 10
E_LEN := 11
struct Ex { k int, line int, rt int = -1, want int = -1, fv real = 0.0, iv u64 = 0, bv bool = false, name int = -1, op int = 0, l int = -1, r int = -1, c int = -1, post bool = false, args int[>..] = [], asz int = -1 }
S_DECL := 0
S_EXPR := 1
S_IF := 2
S_FOR := 3
S_WHILE := 4
S_DO := 5
S_SWITCH := 6
S_RET := 7
S_DISCARD := 8
S_BREAK := 9
S_CONT := 10
S_BLOCK := 11
struct St { k int, line int, ty int = -1, name int = -1, init int = -1, nx int = -1, e int = -1, a int = -1, b int = -1, it int = -1, blk int[>..] = [], grps int[>..] = [] }
struct Grp { labels int[>..] = [], def bool, sts int[>..] = [] }
D_STRUCT := 0
D_GLOBAL := 1
D_INOUT := 2
D_BLOCK := 3
D_OPAQUE := 4
D_SHARED := 5
D_FUNC := 6
struct Dc { k int, line int, ty int = -1, name int = -1, isin bool = false, flat bool = false, loc int = 0, isc bool = false, init int = -1, set int = 0, bind int = 0, ro bool = false, isbuf bool = false, inst int = -1, mty int[>..] = [], mnm int[>..] = [], pty int[>..] = [], pnm int[>..] = [], pq int[>..] = [], body int = -1 }
SY_VAR := 0
SY_BM := 1
SY_FUNC := 2
SY_POS := 3
struct Sym { k int, name int, ty int, id int, st int, mi int = 0, laid int = 0, hcv bool = false, cbits u32 = 0, params int[>..] = [], pq int[>..] = [], nxo int = -1 }
V_RV := 0
V_PTR := 1
V_SW := 2
struct Val { k int = 0, ty int = -1, id int = 0, st int = 0, lt int = 0, bt int = -1, sw int = 0, swn int = 0 }
var TY Ty[>..]
var EX Ex[>..]
var ST St[>..]
var GRP Grp[>..]
var DC Dc[>..]
var SY Sym[>..]
var STAGE = 0
var TVOID = 0
var TBOOL = 0
var TINT = 0
var TUINT = 0
var TFLOAT = 0
var TVEC = [0, 0, 0]
var TIVEC = [0, 0, 0]
var TUVEC = [0, 0, 0]
var TBVEC = [0, 0, 0]
var TMAT = [0, 0, 0]
var TSAMP = 0
var TUSAMP = 0
var TSCUBE = 0
var TS3D = 0
var TS2DA = 0
var TS2DS = 0
var TSCUBES = 0
var TS2DAS = 0
var TYNAMES = dictionary<int, int>{..}
var ARRTY = dictionary<u64, int>{..}
var IMGTY = dictionary<int, int>{..}
var LSIZE = [0, 0, 0]
var NEXTID = 1
var GLSLEXT = 0
var SNAMES u32[>..]
var SDECOS u32[>..]
var SGLOB u32[>..]
var SFUNCS u32[>..]
var SBODY u32[>..]
var SLOCALS u32[>..]
var SIFACE u32[>..]
var TYIDS = dictionary<int, int>{..}
var PTRIDS = dictionary<u64, int>{..}
var CONSTIDS = dictionary<u64, int>{..}
var FNTYIDS = dictionary<u64, int>{..}
var LAIDS = dictionary<int, int>{..}
var LAIDA = dictionary<int, int>{..}
var LAIDE = dictionary<int, int>{..}
var SAMPIMG = dictionary<int, int>{..}
var NEEDIQ = false
var NEEDEF = false
var SCD = dictionary<u64, int>{..}
var SCN int[>..]
var SCM int[>..]
var FNS = dictionary<int, int>{..}
var CURRT = -1
var FHASRET = false
var BTERM = false
var BRKT = 0
var CONTT = 0
var ENTRYF = 0
var PVVAR = 0
var DECLS int[>..]
nty(t Ty) int: TY.push(t); TY.len - 1
nex(k int, line int) int: EX.push(Ex{k, line}); EX.len - 1
nst(k int, line int) int: ST.push(St{k, line}); ST.len - 1
nid() int: NEXTID += 1; NEXTID - 1
emitw(s u32[>..]&, op int, w const int[:]): s.push(((w.len + 1) << 16 | op) as! u32); for x w { s.push(x as! u32) }
emit0(s u32[>..]&, op int): s.push((1 << 16 | op) as! u32)
emit1(s u32[>..]&, op int, a int): s.push((2 << 16 | op) as! u32); s.push(a as! u32)
emit2(s u32[>..]&, op int, a int, b int): s.push((3 << 16 | op) as! u32); s.push(a as! u32); s.push(b as! u32)
emit3(s u32[>..]&, op int, a int, b int, c int): s.push((4 << 16 | op) as! u32); s.push(a as! u32); s.push(b as! u32); s.push(c as! u32)
emit4(s u32[>..]&, op int, a int, b int, c int, d int): s.push((5 << 16 | op) as! u32); s.push(a as! u32); s.push(b as! u32); s.push(c as! u32); s.push(d as! u32)
emit5(s u32[>..]&, op int, a int, b int, c int, d int, e int): s.push((6 << 16 | op) as! u32); s.push(a as! u32); s.push(b as! u32); s.push(c as! u32); s.push(d as! u32); s.push(e as! u32)
pushstr(s u32[>..]&, t const byte[:]):
	w u32 ~= 0; sh ~= 0
	for i t.len + 1: w |= (if i < t.len { t[i] as u32 } else { 0 as u32 }) << sh; sh += 8; if sh == 32 { s.push(w); w = 0; sh = 0 }
	if sh != 0: s.push(w)
emitstr(s u32[>..]&, op int, w const int[:], t const byte[:]): s.push(((w.len + (t.len + 4) / 4 + 1) << 16 | op) as! u32); for x w { s.push(x as! u32) } pushstr(s, t)
nameid(id int, n const byte[:]): emitstr(SNAMES, SOP_NAME, [id], n)
recursive tyid(t int) int:
	f := dgi(TYIDS, t); if f >= 0: return f
	id := nid(); y := TY[t]
	if y.k == T_VOID { emit1(SGLOB, SOP_TYPEVOID, id) } else if y.k == T_BOOL { emit1(SGLOB, SOP_TYPEBOOL, id) } else if y.k == T_INT { emit3(SGLOB, SOP_TYPEINT, id, 32, 1) } else if y.k == T_UINT { emit3(SGLOB, SOP_TYPEINT, id, 32, 0) } else if y.k == T_FLOAT { emit2(SGLOB, SOP_TYPEFLOAT, id, 32) }
	if y.k == T_VEC:
		e := tyid(y.el); emit3(SGLOB, SOP_TYPEVECTOR, id, e, y.cols)
	else if y.k == T_ARR && y.cols == -1:
		e := tyid(y.el); emit2(SGLOB, SOP_TYPERUNTIMEARRAY, id, e); ey := TY[y.el]
		emit3(SDECOS, SOP_DECORATE, id, DEC_ARRAYSTRIDE, if ey.k == T_VEC { if ey.cols == 2 { 8 } else { 16 } } else { 4 })
	else if y.k == T_ARR:
		e := tyid(y.el); l := cscalar(TUINT, y.cols as! u32); emit3(SGLOB, SOP_TYPEARRAY, id, e, l)
	else if y.k == T_STRUCT:
		w int[>..] ~= [id]; for f y.fty { w.push(tyid(f)) } emitw(SGLOB, SOP_TYPESTRUCT, w[..]); nameid(id, snm(y.name))
	else if y.k == T_MAT:
		c := tyid(TVEC[y.rows - 2]); emit3(SGLOB, SOP_TYPEMATRIX, id, c, y.cols)
	else if y.k == T_IMG:
		st := tyid(if y.cols == 32 || y.cols == 33 { TUINT } else { TFLOAT }); emitw(SGLOB, SOP_TYPEIMAGE, [id, st, 1, 0, 0, 0, 2, y.cols])
	else if y.k == T_SAMP:
		st := tyid(if y.el >= 0 { y.el } else { TFLOAT }); img := nid(); c := y.cols
		dim := if c == SD_CUBE || c == SD_CUBES { 3 } else if c == SD_3D { 2 } else { 1 }
		dep := if c == SD_2DS || c == SD_CUBES || c == SD_2DAS { 1 } else { 0 }
		arr := if c == SD_2DA || c == SD_2DAS { 1 } else { 0 }
		emitw(SGLOB, SOP_TYPEIMAGE, [img, st, dim, dep, arr, 0, 1, 0]); emit2(SGLOB, SOP_TYPESAMPLEDIMAGE, id, img); insert(SAMPIMG, t, img)
	insert(TYIDS, t, id); id
ptridraw(tid int, st int) int:
	key := (tid as u64) << 4 | st as u64; f := dgi(PTRIDS, key); if f >= 0: return f
	id := nid(); emit3(SGLOB, SOP_TYPEPOINTER, id, st, tid); insert(PTRIDS, key, id); id
ptrid(t int, st int) int: ptridraw(tyid(t), st)
cscalar(t int, bits u32) int:
	tid := tyid(t); key := (tid as u64) << 32 | bits as u64; f := dgi(CONSTIDS, key); if f >= 0: return f
	id := nid()
	if TY[t].k == T_BOOL { emit2(SGLOB, if bits != 0 { SOP_CONSTANTTRUE } else { SOP_CONSTANTFALSE }, tid, id) } else { emit3(SGLOB, SOP_CONSTANT, tid, id, bits as int) }
	insert(CONSTIDS, key, id); id
cfloat(f f32) int: cscalar(TFLOAT, binary::f32_bits(f))
cint(v int) int: cscalar(TINT, v as! u32)
cuint(v int) int: cscalar(TUINT, v as! u32)
rv(t int, id int) Val: Val{V_RV, t, id}
swi(v Val, i int) int: v.sw >> i * 8 & 255
load(v Val) int:
	if v.k == V_RV: return v.id
	y := TY[v.ty]
	if y.k == T_ARR && y.cols == -1: serr(0, "runtime arrays cannot be loaded whole; index them instead")
	if v.k == V_PTR && v.lt != 0 && y.k == T_STRUCT:
		res := nid(); w int[>..] ~= [tyid(v.ty)]; w.push(res)
		for ft, i y.fty:
			if !isscal(ft) && !isvec(ft): serr(0, str("cannot load '", snm(y.name), "' whole from a buffer block; access its members instead"))
			fp := nid(); pt := ptrid(ft, v.st); ci := cint(i); emit4(SBODY, SOP_ACCESSCHAIN, pt, fp, v.id, ci)
			fv := nid(); ftid := tyid(ft); emit3(SBODY, SOP_LOAD, ftid, fv, fp); w.push(fv)
		emitw(SBODY, SOP_COMPOSITECONSTRUCT, w[..]); return res
	ld := nid()
	if v.k == V_PTR: t := tyid(v.ty); emit3(SBODY, SOP_LOAD, t, ld, v.id); return ld
	bt := tyid(v.bt); emit3(SBODY, SOP_LOAD, bt, ld, v.id)
	if v.swn == 1: res := nid(); t := tyid(v.ty); emit4(SBODY, SOP_COMPOSITEEXTRACT, t, res, ld, swi(v, 0)); return res
	res := nid(); w int[>..] ~= [tyid(v.ty)]; w.push(res); w.push(ld); w.push(ld)
	for i v.swn: w.push(swi(v, i))
	emitw(SBODY, SOP_VECTORSHUFFLE, w[..]); res
store(d Val, src int, line int):
	if d.k == V_PTR && d.lt != 0 && TY[d.ty].k == T_STRUCT:
		for ft, i TY[d.ty].fty: fv := nid(); ftid := tyid(ft); emit4(SBODY, SOP_COMPOSITEEXTRACT, ftid, fv, src, i); fp := nid(); pt := ptrid(ft, d.st); ci := cint(i); emit4(SBODY, SOP_ACCESSCHAIN, pt, fp, d.id, ci); emit2(SBODY, SOP_STORE, fp, fv)
		return
	if d.k == V_PTR: emit2(SBODY, SOP_STORE, d.id, src); return
	if d.k != V_SW: serr(line, "cannot assign to this expression")
