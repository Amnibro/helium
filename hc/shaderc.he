setmac(m Mac): k := mac(m.name); if k >= 0 { MACS[k] = m } else { insert(MIDX, m.name, MACS.len); MACS.push(m) }
recursive ppinclude(s const byte[:], pf int, pl int) bool:
	p ~= 0; e := s.len
	while p < e && (s[p] == ' ' || s[p] == '\t'): p += 1
	op := if p < e { s[p] as int } else { 0 }
	if op != '"' && op != '<': pperr("expected \"path\" after #include")
	cl := if op == '"' { '"' } else { '>' }; p += 1; ps := p
	while p < e && s[p] as int != cl: p += 1
