fbits(f f32) u32: binary::f32_bits(f)
bitsf(b u32) f32: binary::f32_from_bits(b)
recursive cfold(e int) int, u32:
	x := EX[e]; k := x.k
	if k == E_FLT: return TFLOAT, fbits(x.fv as f32)
	if k == E_INT: return TINT, (x.iv as! i32) as! u32
	if k == E_UINT: return TUINT, x.iv as! u32
	if k == E_BOOL: return TBOOL, if x.bv { 1 as u32 } else { 0 as u32 }
	if k == E_UN && x.op == '-':
		t, b := cfold(x.l); return t, if t == TFLOAT { fbits(-bitsf(b)) } else { (0 - (b as! i32) as int) as! u32 }
	if k == E_REF:
		s := findsym(x.name)
		if s >= 0 && SY[s].hcv: return SY[s].ty, SY[s].cbits
	if k == E_BIN:
		op := x.op; io := op == '%' || op == P_SHL || op == P_SHR || op == '&' || op == '|' || op == '^'
		if op == '+' || op == '-' || op == '*' || op == '/' || io:
			lt, lb := cfold(x.l); rt, rb := cfold(x.r)
			if lt == TFLOAT || rt == TFLOAT:
				if io: serr(x.line, "integer operator on float constants")
				a := if lt == TFLOAT { bitsf(lb) } else { (lb as! i32) as f32 }; b := if rt == TFLOAT { bitsf(rb) } else { (rb as! i32) as f32 }
				r := if op == '+' { a + b } else if op == '-' { a - b } else if op == '*' { a * b } else if b != 0.0 { a / b } else { 0.0 as f32 }
				return TFLOAT, fbits(r)
			a := (lb as! i32) as int; b := (rb as! i32) as int
			r := if op == '+' { a + b } else if op == '-' { a - b } else if op == '*' { a * b } else if op == '/' { if b != 0 { a / b } else { 0 } } else if op == '%' { if b != 0 { a % b } else { 0 } } else if op == '&' { a & b } else if op == '|' { a | b } else if op == '^' { a ^ b } else if op == P_SHL { a << b } else { a >> b }
			return if lt == TUINT || rt == TUINT { TUINT } else { TINT }, r as! u32
	serr(x.line, "expected a constant expression"); return 0, 0 as u32
convbits(t int, b u32, want int) u32: if t == TINT && want == TFLOAT { fbits((b as! i32) as f32) } else if t == TUINT && want == TFLOAT { fbits(b as f32) } else { b }
cscalaras(t int, bits u32, want int, line int) int:
	if t != want && !(t == TINT && want == TFLOAT || t == TUINT && want == TFLOAT || t == TINT && want == TUINT || t == TUINT && want == TINT): serr(line, str("cannot convert constant to '", tyname(want), "'"))
	cscalar(want, convbits(t, bits, want))
recursive constexpr(e int, want int) int:
	x := EX[e]; y := TY[want]
	if isscal(want): t, b := cfold(e); return cscalaras(t, b, want, x.line)
	if y.k == T_VEC:
		if x.k != E_CALL || lookty(x.name) != want: serr(x.line, str("constant '", tyname(want), "' initializers must be written as constructors"))
		cs int[>..] ~= []
		if x.args.len == 1:
			c := constexpr(x.args[0], y.el); for i y.cols { cs.push(c) }
		else:
			for a x.args: if cs.len >= y.cols { serr(x.line, "too many components") } cs.push(constexpr(a, y.el))
			if cs.len != y.cols: serr(x.line, str("wrong number of components for '", tyname(want), "'"))
		id := nid(); w int[>..] ~= [tyid(want)]; w.push(id); w.append(cs[..]); emitw(SGLOB, SOP_CONSTANTCOMPOSITE, w[..]); return id
	if y.k == T_ARR:
