		serr(line, str("uniforms outside blocks must be opaque types (sampler2D, image2D); put '", snm(name), "' in a uniform block"))
	if l.set < 0 || l.bind < 0: serr(line, str("'", snm(name), "' requires layout(set = N, binding = M)"))
