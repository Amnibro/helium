	else if k == S_EXPR:
		genexpr(x.e)
	else if k == S_IF:
		c := condb(x.e, line, "if condition must be bool"); mg := nid(); tl := nid(); el := if x.b >= 0 { nid() } else { mg }
		emit2(SBODY, SOP_SELECTIONMERGE, mg, 0); emit3(SBODY, SOP_BRANCHCONDITIONAL, c, tl, el); BTERM = true
		beginblock(tl); pushsc(); genstmt(x.a); popsc()
		if !BTERM: branch(mg)
		if x.b >= 0:
			beginblock(el); pushsc(); genstmt(x.b); popsc()
			if !BTERM: branch(mg)
		beginblock(mg)
	else if k == S_FOR || k == S_WHILE:
		pushsc()
		if k == S_FOR && x.a >= 0: genstmt(x.a)
		hd := nid(); cl := nid(); bl := nid(); ctl := nid(); mg := nid()
		branch(hd); beginblock(hd); emit3(SBODY, SOP_LOOPMERGE, mg, ctl, 0); branch(cl); beginblock(cl)
		c := if x.e >= 0 { condb(x.e, line, "loop condition must be bool") } else { cscalar(TBOOL, 1) }
		emit3(SBODY, SOP_BRANCHCONDITIONAL, c, bl, mg); BTERM = true; sb := BRKT; sc := CONTT; BRKT = mg; CONTT = ctl
		beginblock(bl); pushsc(); genstmt(x.b); popsc()
		if !BTERM: branch(ctl)
		BRKT = sb; CONTT = sc; beginblock(ctl)
		if k == S_FOR && x.it >= 0: genexpr(x.it)
		branch(hd); beginblock(mg); popsc()
	else if k == S_DO:
		pushsc(); hd := nid(); bl := nid(); ctl := nid(); mg := nid()
		branch(hd); beginblock(hd); emit3(SBODY, SOP_LOOPMERGE, mg, ctl, 0); branch(bl); sb := BRKT; sc := CONTT; BRKT = mg; CONTT = ctl
		beginblock(bl); genstmt(x.b)
		if !BTERM: branch(ctl)
