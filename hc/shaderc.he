			if TY[y.ty].k == T_SAMP { format(TPO, "\t", mslstex(y.ty), " ", n, "_tex;\n\tsampler ", n, "_smp;\n") } else { format(TPO, "\t", mslimgty(TY[y.ty].cols, y.ro), " ", n, ";\n") }
		else if y.k == D_SHARED:
			format(TPO, "\tthreadgroup ", hlslty(if TY[y.ty].k == T_ARR { TY[y.ty].el } else { y.ty }), "* ", n, ";\n")
	TPO.append(if STAGE == ST_VERT { "\tfloat4 gl_Position;\n\tint gl_VertexIndex;\n\tint gl_InstanceIndex;\n" } else if STAGE == ST_FRAG { "\tfloat4 gl_FragCoord;\n\tbool gl_FrontFacing;\n" } else { "\tuint3 gl_GlobalInvocationID;\n\tuint3 gl_LocalInvocationID;\n\tuint3 gl_WorkGroupID;\n\tuint gl_LocalInvocationIndex;\n" })
	for d DECLS: y := DC[d]; if y.k == D_INOUT || y.k == D_GLOBAL && !y.isc { TPO.push('\t'); tpvar(y.ty, snm(y.name)); TPO.append(";\n") }
	for d DECLS: if DC[d].k == D_FUNC { TPO.push('\n'); mslfunc(d) }
	TPO.append("};\n")
	if STAGE == ST_VERT:
		TPO.append("\nstruct cf_vs_in\n{\n")
		for d DECLS: y := DC[d]; if y.k == D_INOUT && y.isin { format(TPO, "\t", hlslty(y.ty), " ", snm(y.name), " [[attribute(", y.loc, ")]];\n") }
		TPO.append("};\nstruct cf_vs_out\n{\n\tfloat4 cf_position [[position]];\n")
		for d DECLS: y := DC[d]; if y.k == D_INOUT && !y.isin { format(TPO, "\t", hlslty(y.ty), " ", snm(y.name), " [[user(locn", y.loc, ")]];\n") }
		TPO.append("};\n")
	else if STAGE == ST_FRAG:
		TPO.append("\nstruct cf_ps_in\n{\n\tfloat4 cf_position [[position]];\n")
		for d DECLS: y := DC[d]; if y.k == D_INOUT && y.isin { format(TPO, "\t", hlslty(y.ty), " ", snm(y.name), " [[user(locn", y.loc, ")", if y.flat { ", flat" } else { "" }, "]];\n") }
		TPO.append("};\nstruct cf_ps_out\n{\n")
		for d DECLS: y := DC[d]; if y.k == D_INOUT && !y.isin { format(TPO, "\t", hlslty(y.ty), " ", snm(y.name), " [[color(", y.loc, ")]];\n") }
		TPO.append("};\n")
	TPO.append(if STAGE == ST_VERT { "\nvertex cf_vs_out main0(cf_vs_in cf_in [[stage_in]], uint cf_vid [[vertex_id]], uint cf_iid [[instance_id]]" } else if STAGE == ST_FRAG { "\nfragment cf_ps_out main0(cf_ps_in cf_in [[stage_in]], bool cf_front [[front_facing]]" } else { "\nkernel void main0(uint3 cf_gtid [[thread_position_in_threadgroup]], uint3 cf_dtid [[thread_position_in_grid]], uint3 cf_gid [[threadgroup_position_in_grid]], uint cf_gidx [[thread_index_in_threadgroup]]" })
	for d DECLS:
		y := DC[d]; n := snm(y.name)
		if y.k == D_BLOCK:
			if y.isbuf:
				ix := if !cp || y.ro { uc + y.bind - tc } else { uc + roc + y.bind - rwc }; rn byte[>..] ~= []
				if y.inst >= 0 { format(rn, snm(y.inst), "_", snm(y.mnm[0])) } else { rn.append(snm(y.mnm[0])) }
				format(TPO, ", device ", if y.ro { "const " } else { "" }, hlslty(TY[y.mty[0]].el), "* ", rn[..], " [[buffer(", ix, ")]]")
			else:
				format(TPO, ", constant cf_ub_", n, "& ", n, " [[buffer(", y.bind, ")]]")
		else if y.k == D_OPAQUE:
			ix := if cp && TY[y.ty].k == T_IMG && !y.ro { tc + y.bind } else { y.bind }
			if TY[y.ty].k == T_SAMP { format(TPO, ", ", mslstex(y.ty), " ", n, "_tex [[texture(", ix, ")]], sampler ", n, "_smp [[sampler(", ix, ")]]") } else { format(TPO, ", ", mslimgty(TY[y.ty].cols, y.ro), " ", n, " [[texture(", ix, ")]]") }
	TPO.append(")\n{\n")
	for d DECLS: y := DC[d]; if y.k == D_SHARED { if TY[y.ty].k == T_ARR { format(TPO, "\tthreadgroup ", hlslty(TY[y.ty].el), " cf_sh_", snm(y.name), "[", TY[y.ty].cols, "];\n") } else { format(TPO, "\tthreadgroup ", hlslty(y.ty), " cf_sh_", snm(y.name), ";\n") } }
	TPO.append("\tcf_shader s = {"); fs ~= true
	for d DECLS:
		y := DC[d]; n := snm(y.name); sp := if fs { " " } else { ", " }
		if y.k == D_BLOCK:
			if y.isbuf && y.inst >= 0 { format(TPO, sp, snm(y.inst), "_", snm(y.mnm[0])) } else if y.isbuf { format(TPO, sp, snm(y.mnm[0])) } else { format(TPO, sp, "&", n) }
			fs = false
		else if y.k == D_OPAQUE:
			if TY[y.ty].k == T_SAMP { format(TPO, sp, n, "_tex, ", n, "_smp") } else { format(TPO, sp, n) }
			fs = false
		else if y.k == D_SHARED:
			format(TPO, sp, if TY[y.ty].k == T_ARR { "cf_sh_" } else { "&cf_sh_" }, n); fs = false
	TPO.append(" };\n")
	if STAGE == ST_VERT:
		for d DECLS: y := DC[d]; if y.k == D_INOUT && y.isin { format(TPO, "\ts.", snm(y.name), " = cf_in.", snm(y.name), ";\n") }
		TPO.append("\ts.gl_VertexIndex = int(cf_vid);\n\ts.gl_InstanceIndex = int(cf_iid);\n")
	else if STAGE == ST_FRAG:
		TPO.append("\ts.gl_FragCoord = cf_in.cf_position;\n\ts.gl_FrontFacing = cf_front;\n")
		for d DECLS: y := DC[d]; if y.k == D_INOUT && y.isin { format(TPO, "\ts.", snm(y.name), " = cf_in.", snm(y.name), ";\n") }
	else:
		TPO.append("\ts.gl_GlobalInvocationID = cf_dtid;\n\ts.gl_LocalInvocationID = cf_gtid;\n\ts.gl_WorkGroupID = cf_gid;\n\ts.gl_LocalInvocationIndex = cf_gidx;\n")
	for d DECLS: y := DC[d]; if y.k == D_GLOBAL && !y.isc && y.init >= 0 { format(TPO, "\ts.", snm(y.name), " = "); tpinit(y.init); TPO.append(";\n") }
	TPO.append("\ts.cf_main_();\n")
	if STAGE == ST_VERT:
		TPO.append("\tcf_vs_out cf_out;\n\tcf_out.cf_position = s.gl_Position;\n")
		for d DECLS: y := DC[d]; if y.k == D_INOUT && !y.isin { format(TPO, "\tcf_out.", snm(y.name), " = s.", snm(y.name), ";\n") }
		TPO.append("\treturn cf_out;\n}\n")
	else if STAGE == ST_FRAG:
		TPO.append("\tcf_ps_out cf_out;\n")
		for d DECLS: y := DC[d]; if y.k == D_INOUT && !y.isin { format(TPO, "\tcf_out.", snm(y.name), " = s.", snm(y.name), ";\n") }
		TPO.append("\treturn cf_out;\n}\n")
	else:
		TPO.append("}\n")
struct Cls { what const byte[:], set int, first int, count int }
stname(st int) const byte[:]: if st == ST_VERT { "vertex" } else if st == ST_FRAG { "fragment" } else { "compute" }
chkcls(path const byte[:], st int, c Cls, rs const RRes[:], rule const byte[:], err byte[>..]&) bool:
	seen bool[>..] ~= []; seen.resize(64, false)
	for r rs:
		if r.set != c.set: format(err, path, ": ", stname(st), " shader ", c.what, " '", snm(r.name), "' is in set ", r.set, ", and must be in set ", c.set, " (", rule, ")"); return false
		b := r.bind - c.first
		if b < 0 || b >= c.count || b >= 64 || seen[b]: format(err, path, ": ", stname(st), " shader ", c.what, " '", snm(r.name), "' is at binding ", r.bind, "; the ", c.count, " ", c.what, "(s) of this shader must take bindings ", c.first, " to ", c.first + c.count - 1, " of set ", c.set, " (", rule, ")"); return false
		seen[b] = true
	true
chkbind(path const byte[:], st int, err byte[>..]&) bool:
	ns := RSAMP.len; nu := RBLK.len
	if ns > 64 || RIMG.len > 64 || RBUF.len > 64 || nu > 4: format(err, path, ": too many resources for SDL_GPU (at most 4 uniform blocks per stage)"); return false
	iro RRes[>..] ~= []; irw RRes[>..] ~= []; bro RRes[>..] ~= []; brw RRes[>..] ~= []; ub RRes[>..] ~= []
	for r RIMG: if r.ro { iro.push(r) } else { irw.push(r) }
	for r RBUF: if r.ro { bro.push(r) } else { brw.push(r) }
	for b RBLK: ub.push(RRes{b.name, b.set, b.bind, true})
	if st == ST_COMP:
		rule := "SDL_GPU compute sets: 0 holds samplers, then read-only storage textures, then read-only storage buffers; 1 read-write storage textures, then read-write storage buffers; 2 uniform blocks"
		return chkcls(path, st, Cls{"sampler", 0, 0, ns}, RSAMP[..], rule, err) && chkcls(path, st, Cls{"read-only storage texture", 0, ns, iro.len}, iro[..], rule, err) && chkcls(path, st, Cls{"read-only storage buffer", 0, ns + iro.len, bro.len}, bro[..], rule, err) && chkcls(path, st, Cls{"read-write storage texture", 1, 0, irw.len}, irw[..], rule, err) && chkcls(path, st, Cls{"read-write storage buffer", 1, irw.len, brw.len}, brw[..], rule, err) && chkcls(path, st, Cls{"uniform block", 2, 0, nu}, ub[..], rule, err)
	rs := if st == ST_VERT { 0 } else { 2 }
	rule := if st == ST_VERT { "SDL_GPU vertex sets: 0 holds samplers, then storage textures, then storage buffers; 1 uniform blocks" } else { "SDL_GPU fragment sets: 2 holds samplers, then storage textures, then storage buffers; 3 uniform blocks" }
	if irw.len > 0 || brw.len > 0: format(err, path, ": ", stname(st), " shader storage ", if irw.len > 0 { "texture" } else { "buffer" }, " '", snm(if irw.len > 0 { irw[0].name } else { brw[0].name }), "' must be declared readonly: SDL_GPU graphics stages only read storage resources"); return false
	chkcls(path, st, Cls{"sampler", rs, 0, ns}, RSAMP[..], rule, err) && chkcls(path, st, Cls{"storage texture", rs, ns, iro.len}, iro[..], rule, err) && chkcls(path, st, Cls{"storage buffer", rs, ns + iro.len, bro.len}, bro[..], rule, err) && chkcls(path, st, Cls{"uniform block", rs + 1, 0, nu}, ub[..], rule, err)
chkin(path const byte[:], err byte[>..]&) bool:
	used bool[>..] ~= []; used.resize(256, false)
	for x RINP:
		sp := if x.ty == 13 { 4 } else { 1 }
		if x.loc < 0 || x.loc + sp > 16: format(err, path, ": vertex input '", snm(x.name), "' needs a location from 0 to 15 (layout(location = N))"); return false
		if x.ty == 0: format(err, path, ": vertex input '", snm(x.name), "' has a type a vertex buffer cannot supply"); return false
		for k sp:
			if used[x.loc + k]: format(err, path, ": vertex input '", snm(x.name), "' overlaps location ", x.loc + k); return false
			used[x.loc + k] = true
	true
pu16(b byte[>..]&, v int): b.push((v & 255) as byte); b.push((v >> 8 & 255) as byte)
pu32(b byte[>..]&, v int): pu16(b, v & 65535); pu16(b, v >> 16 & 65535)
blob(st int, spv const u32[:], b byte[>..]&):
	b.append("GSHD"); pu16(b, 1); b.push(st as byte); b.push(RINP.len as byte)
	for i 3: pu32(b, if st == ST_COMP { LSIZE[i] } else { 0 })
	iro ~= 0; for r RIMG { if r.ro { iro += 1 } } bro ~= 0; for r RBUF { if r.ro { bro += 1 } }
	pu16(b, RSAMP.len); pu16(b, iro); pu16(b, RIMG.len - iro); pu16(b, bro); pu16(b, RBUF.len - bro); pu16(b, RBLK.len)
	nu := RBLK.len; off ~= (56 + 4 * nu + 2 * RINP.len + 3) & ~3; so := off; off += spv.len * 4; mo := off; off += MSLO.len + 1; ho := off
	pu32(b, so); pu32(b, spv.len * 4); pu32(b, mo); pu32(b, MSLO.len); pu32(b, ho); pu32(b, HLSLO.len)
	for k nu: sz ~= 0; for x RBLK { if x.bind == k { sz = x.size } } pu32(b, sz)
	for x RINP: b.push(x.loc as byte); b.push(x.ty as byte)
	while b.len < so: b.push(0)
	for w spv: pu32(b, w as int)
	b.append(MSLO[..]); b.push(0); b.append(HLSLO[..]); b.push(0)
compile_blob(stage int, path const byte[:], src const byte[:], out byte[>..]&, err byte[>..]&) bool:
	INCDIR.clear(); sl ~= path.len; while sl > 0 && path[sl - 1] != '/' && path[sl - 1] != '\\' { sl -= 1 } INCDIR.append(path[..sl])
	spv u32[>..] ~= []
	if !cspv(src, stage, spv):
		if ERRM.len >= 7 && ERRM[..7] == "shader:" { err.append(path); err.push(':'); err.append(ERRM[7..]) } else { err.append(ERRM[..]) }
		return false
	if !chkbind(path, stage, err) || stage == ST_VERT && !chkin(path, err): return false
	blob(stage, spv[..], out); true
