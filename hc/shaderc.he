	pushsc()
	for t, i pty:
		if pq[i] != 0 || opq(t): nameid(pids[i], snm(pnm[i])); addsym(pnm[i], SY_VAR, t, pids[i], if opq(t) { SC_UNIFORMCONSTANT } else { SC_FUNCTION }, line); continue
		vr := nid(); pt := ptrid(t, SC_FUNCTION); emit3(SLOCALS, SOP_VARIABLE, pt, vr, SC_FUNCTION); emit2(SBODY, SOP_STORE, vr, pids[i]); nameid(vr, snm(pnm[i])); addsym(pnm[i], SY_VAR, t, vr, SC_FUNCTION, line)
	genstmt(body); popsc()
	if !BTERM:
		if ret == TVOID { emit0(SBODY, SOP_RETURN) } else if FHASRET { emit0(SBODY, SOP_UNREACHABLE) } else { serr(line, str("function '", snm(name), "' is missing a return statement")) }
	emit4(SFUNCS, SOP_FUNCTION, rtid, fid, 0, ftid)
	for t, i pty: ptd := if pq[i] != 0 { ptrid(t, SC_FUNCTION) } else if opq(t) { ptrid(t, SC_UNIFORMCONSTANT) } else { tyid(t) }; emit2(SFUNCS, SOP_FUNCTIONPARAMETER, ptd, pids[i])
	emit1(SFUNCS, SOP_LABEL, nid()); SFUNCS.append(SLOCALS[..]); SFUNCS.append(SBODY[..]); emit0(SFUNCS, SOP_FUNCTIONEND)
	SBODY.clear(); SBODY.append(sb[..]); SLOCALS.clear(); SLOCALS.append(sl[..]); CURRT = scr; FHASRET = shr
	SY.push(Sym{SY_FUNC, name, ret, fid, 0}); s := SY.len - 1; SY[s].params.append(pty[..]); SY[s].pq.append(pq[..]); SY[s].nxo = head; insert(FNS, name, s)
