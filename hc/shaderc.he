		mt.push(m); mn.push(nmm); ml.push(mline)
	adv(); inst ~= -1
	if TOK.k == TK_ID: inst = TOK.id; adv()
	expp(';')
	if mt.len == 0: serr(line, str(kind, " block '", snm(bn), "' is empty"))
	mtids int[>..] ~= []
	for m, i mt:
		y := TY[m]
