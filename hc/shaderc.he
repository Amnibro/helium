ch(s const byte[:], i int) int: if i >= 0 && i < s.len { s[i] as int } else { 0 }
idst(c int) bool: c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
idch(c int) bool: idst(c) || c >= '0' && c <= '9'
lnum(raw int) int: FIDX * 1000000 + raw
serr(line int, m const byte[:]):
	fi := line / 1000000; l := line % 1000000
	ERRM.clear(); ERRM.append(if fi < SFILES.len { SFILES[fi][..] } else { "shader" }); format(ERRM, ":", l, ": error: ", m)
	exception::throw(1)
dig(c int, b int) int: d := if c >= '0' && c <= '9' { c - '0' } else if c >= 'a' && c <= 'f' { c - 'a' + 10 } else if c >= 'A' && c <= 'F' { c - 'A' + 10 } else { 99 }; if d < b { d } else { -1 }
c_strtoull(s const byte[:], i0 int) u64, int:
	i ~= i0; b ~= 10
	if ch(s, i) == '0' && (ch(s, i + 1) == 'x' || ch(s, i + 1) == 'X') && dig(ch(s, i + 2), 16) >= 0 { b = 16; i += 2 } else if ch(s, i) == '0' { b = 8 }
	v u64 ~= 0; st := i
	while dig(ch(s, i), b) >= 0: v = v * b as u64 + dig(ch(s, i), b) as u64; i += 1
	return v, if i == st && b != 8 { i0 } else { i }
c_strtod(s const byte[:], i0 int) real:
	i ~= i0; while ch(s, i) >= '0' && ch(s, i) <= '9' { i += 1 }
	if ch(s, i) == '.': i += 1; while ch(s, i) >= '0' && ch(s, i) <= '9' { i += 1 }
	if ch(s, i) == 'e' || ch(s, i) == 'E':
		j ~= i + 1; if ch(s, j) == '+' || ch(s, j) == '-' { j += 1 }
		if ch(s, j) >= '0' && ch(s, j) <= '9': while ch(s, j) >= '0' && ch(s, j) <= '9' { j += 1 } i = j
	v, ok := parse_flt(s[i0..i]); v
lex_next() Tok:
	p ~= LP; s := PPT[..]
	loop:
		while ch(s, p) == ' ' || ch(s, p) == '\t' || ch(s, p) == '\r' || ch(s, p) == '\n': if ch(s, p) == '\n' { LLINE += 1 } p += 1
		if ch(s, p) == '/' && ch(s, p + 1) == '/': while p < s.len && s[p] != '\n' { p += 1 } continue
		if ch(s, p) == '/' && ch(s, p + 1) == '*':
			p += 2
			while p < s.len && !(s[p] == '*' && ch(s, p + 1) == '/'): if s[p] == '\n' { LLINE += 1 } p += 1
			if p < s.len: p += 2
			continue
		if ch(s, p) == '#' && ch(s, p + 1) == 'l' && (ch(s, p + 2) == ' ' || ch(s, p + 2) == '\t'):
			p += 3; a, q := c_strtol(s, p); LLINE = a; b, q2 := c_strtol(s, q); FIDX = b; p = q2
			while p < s.len && s[p] != '\n': p += 1
			if ch(s, p) == '\n': p += 1
			continue
		break
	t ~= Tok{}; t.line = lnum(LLINE); c := ch(s, p)
	if c == 0: t.k = TK_EOF; LP = p; return t
	if idst(c): st := p; while idch(ch(s, p)) { p += 1 } t.k = TK_ID; t.id = sid(s[st..p]); LP = p; return t
	if c >= '0' && c <= '9' || c == '.' && ch(s, p + 1) >= '0' && ch(s, p + 1) <= '9':
		st := p; fl ~= false
		if c == '0' && (ch(s, p + 1) == 'x' || ch(s, p + 1) == 'X'):
			p += 2; while dig(ch(s, p), 16) >= 0 { p += 1 }
		else:
			while ch(s, p) >= '0' && ch(s, p) <= '9': p += 1
			if ch(s, p) == '.': fl = true; p += 1; while ch(s, p) >= '0' && ch(s, p) <= '9' { p += 1 }
			if ch(s, p) == 'e' || ch(s, p) == 'E': fl = true; p += 1; if ch(s, p) == '+' || ch(s, p) == '-' { p += 1 } while ch(s, p) >= '0' && ch(s, p) <= '9' { p += 1 }
		if fl:
			t.k = TK_FLT; t.fv = c_strtod(s, st); if ch(s, p) == 'f' || ch(s, p) == 'F' { p += 1 }
		else if ch(s, p) == 'f' || ch(s, p) == 'F':
			t.k = TK_FLT; t.fv = c_strtod(s, st); p += 1
		else:
			v, e := c_strtoull(s, st); t.iv = v
			if ch(s, p) == 'u' || ch(s, p) == 'U' { p += 1; t.k = TK_UINT } else { t.k = TK_INT }
		LP = p; return t
	t.k = TK_P; p += 1; c2 := ch(s, p)
	if c == '<': t.p = if c2 == '<' { p += 1; if ch(s, p) == '=' { p += 1; P_SHLA } else { P_SHL } } else if c2 == '=' { p += 1; P_LE } else { '<' }
	else if c == '>': t.p = if c2 == '>' { p += 1; if ch(s, p) == '=' { p += 1; P_SHRA } else { P_SHR } } else if c2 == '=' { p += 1; P_GE } else { '>' }
	else if c == '=': t.p = if c2 == '=' { p += 1; P_EQ } else { '=' }
	else if c == '!': t.p = if c2 == '=' { p += 1; P_NE } else { '!' }
	else if c == '&': t.p = if c2 == '&' { p += 1; P_AND } else if c2 == '=' { p += 1; P_ANDA } else { '&' }
	else if c == '|': t.p = if c2 == '|' { p += 1; P_OR } else if c2 == '=' { p += 1; P_ORA } else { '|' }
	else if c == '+': t.p = if c2 == '+' { p += 1; P_INC } else if c2 == '=' { p += 1; P_ADDA } else { '+' }
	else if c == '-': t.p = if c2 == '-' { p += 1; P_DEC } else if c2 == '=' { p += 1; P_SUBA } else { '-' }
	else if c == '*': t.p = if c2 == '=' { p += 1; P_MULA } else { '*' }
	else if c == '/': t.p = if c2 == '=' { p += 1; P_DIVA } else { '/' }
	else if c == '%': t.p = if c2 == '=' { p += 1; P_MODA } else { '%' }
	else if c == '^': t.p = if c2 == '=' { p += 1; P_XORA } else { '^' }
	else: t.p = c
	LP = p; t
c_strtol(s const byte[:], i0 int) int, int:
	i ~= i0
	while ch(s, i) == ' ' || ch(s, i) == '\t' || ch(s, i) == '\n' || ch(s, i) == '\r': i += 1
	ng ~= false; if ch(s, i) == '-' || ch(s, i) == '+' { ng = ch(s, i) == '-'; i += 1 }
	v ~= 0; st := i
	while ch(s, i) >= '0' && ch(s, i) <= '9': v = v * 10 + ch(s, i) - '0'; i += 1
	return if ng { -v } else { v }, if i == st { i0 } else { i }
adv(): if AHEAD.len > 0 { TOK = AHEAD[0]; remove_at(AHEAD, 0) } else { TOK = lex_next() }
peek(n int) Tok:
	if n == 0: return TOK
	while AHEAD.len < n: AHEAD.push(lex_next())
	AHEAD[n - 1]
isp(p int) bool: TOK.k == TK_P && TOK.p == p
accp(p int) bool: if isp(p) { adv(); true } else { false }
expp(p int):
	if !isp(p): if p < 256 { m byte[>..] ~= []; m.append("expected '"); m.push(p as byte); m.push('\''); serr(TOK.line, m[..]) } else { serr(TOK.line, "unexpected token") }
	adv()
isid(id int) bool: TOK.k == TK_ID && TOK.id == id
accid(id int) bool: if isid(id) { adv(); true } else { false }
expid() int: if TOK.k != TK_ID { serr(TOK.line, "expected identifier") } n := TOK.id; adv(); n
pperr(m const byte[:]): serr(lnum(PPLINE), m)
ppact() bool: for c CONDS { if !c.act { return false } } true
strip_comments(src const byte[:]) byte[>..]:
	o byte[>..] ~= []; i ~= 0; n := src.len
	while i < n:
		if src[i] == '/' && ch(src, i + 1) == '/':
			while i < n && src[i] != '\n': i += 1
		else if src[i] == '/' && ch(src, i + 1) == '*':
			i += 2; o.push(' ')
			while i < n && !(src[i] == '*' && ch(src, i + 1) == '/'): if src[i] == '\n' { o.push('\n') } i += 1
			if i < n: i += 2
		else:
			o.push(src[i]); i += 1
	o
ppmark(line int, fi int): format(PPO, "\n#l ", line, " ", fi, "\n")
pexp(name int) bool: for e EXPN { if e == name { return true } } false
mac(name int) int: if contains(MIDX, name) { get_or_insert(MIDX, name, -1) } else { -1 }
numskip(s const byte[:], p0 int) int:
	p ~= p0 + 1
	while p < s.len && (idch(s[p] as int) || s[p] == '.' || (s[p] == '+' || s[p] == '-') && (s[p - 1] == 'e' || s[p - 1] == 'E')): p += 1
	p
recursive expand(s const byte[:], prot bool) byte[>..]:
	o byte[>..] ~= []; p ~= 0; e := s.len
	while p < e:
		c := s[p] as int
		if idst(c):
			is := p; while p < e && idch(s[p] as int) { p += 1 } name := sid(s[is..p])
			if prot && name == KW_DEFINED:
				o.append("defined"); q ~= p
				while q < e && (s[q] == ' ' || s[q] == '\t'): q += 1
				if q < e && s[q] == '(':
					while p < e && s[p] != ')': o.push(s[p]); p += 1
					if p < e: o.push(s[p]); p += 1
				else:
					while p < e && (s[p] == ' ' || s[p] == '\t'): o.push(s[p]); p += 1
					while p < e && idch(s[p] as int): o.push(s[p]); p += 1
				continue
			m := mac(name)
			if m < 0 || pexp(name): o.append(s[is..p]); continue
			if !MACS[m].isf:
				EXPN.push(name); b := expand(MACS[m].body[..], prot); EXPN.pop(); o.append(b[..]); continue
			q ~= p
			while q < e && (s[q] == ' ' || s[q] == '\t' || s[q] == '\n'): q += 1
			if q >= e || s[q] != '(': o.append(s[is..p]); continue
			q += 1; args (byte[>..])[>..] ~= []; cur byte[>..] ~= []; dep ~= 0; closed ~= false
			while q < e:
				a := s[q]
				if a == '(':
					dep += 1; cur.push(a); q += 1
				else if a == ')':
					if dep == 0: q += 1; closed = true; break
					dep -= 1; cur.push(a); q += 1
				else if a == ',' && dep == 0:
					args.push(copy(cur)); cur.clear(); q += 1
				else:
					cur.push(a); q += 1
			args.push(copy(cur)); p = q
			if !closed: pperr(str("unterminated argument list invoking macro '", snm(name), "'"))
			np := MACS[m].params.len
			if args.len != np && !(np == 0 && args.len == 1 && args[0].len == 0): pperr(str("macro '", snm(name), "' expects ", np, " argument(s), got ", args.len))
			sub byte[>..] ~= []; bd := MACS[m].body[..]; b ~= 0
			while b < bd.len:
				if idst(bd[b] as int):
					bs := b; while b < bd.len && idch(bd[b] as int) { b += 1 } bn := sid(bd[bs..b]); pi ~= -1
					for x, i MACS[m].params: if pi < 0 && x == bn { pi = i }
					if pi >= 0 { sub.append(args[pi][..]) } else { sub.append(bd[bs..b]) }
				else:
					sub.push(bd[b]); b += 1
			EXPN.push(name); x := expand(sub[..], prot); EXPN.pop(); o.append(x[..]); continue
		if c >= '0' && c <= '9' || c == '.' && p + 1 < e && s[p + 1] >= '0' && s[p + 1] <= '9': ns := p; p = numskip(s, p); o.append(s[ns..p]); continue
		o.push(s[p]); p += 1
	o
PEND_DONE := 0
PEND_ARGS := 1
PEND_PAREN := 2
scan_pending(s const byte[:]) int:
	p ~= 0; e := s.len
	while p < e:
		c := s[p] as int
		if idst(c):
			is := p; while p < e && idch(s[p] as int) { p += 1 } name := sid(s[is..p]); m := mac(name)
			if m < 0 || !MACS[m].isf || pexp(name): continue
			q ~= p; while q < e && (s[q] == ' ' || s[q] == '\t') { q += 1 }
			if q >= e: return PEND_PAREN
			if s[q] != '(': continue
			p = q + 1; dep ~= 0; closed ~= false
			while p < e:
				a := s[p]; p += 1
				if a == '(' { dep += 1 } else if a == ')' { if dep == 0 { closed = true; break } dep -= 1 }
			if !closed: return PEND_ARGS
			continue
		if c >= '0' && c <= '9' || c == '.' && p + 1 < e && s[p + 1] >= '0' && s[p + 1] <= '9': p = numskip(s, p); continue
		p += 1
	PEND_DONE
var PXS byte[>..]
var PXP = 0
pxws(): while ch(PXS[..], PXP) == ' ' || ch(PXS[..], PXP) == '\t' { PXP += 1 }
recursive pxprim() int:
	pxws(); c := ch(PXS[..], PXP)
	if c == '(':
		PXP += 1; v := pxtern(); pxws()
		if ch(PXS[..], PXP) != ')': pperr("expected ')' in #if expression")
		PXP += 1; return v
	if c == '!': PXP += 1; return if pxprim() == 0 { 1 } else { 0 }
	if c == '~': PXP += 1; return ~pxprim()
	if c == '-': PXP += 1; return -pxprim()
	if c == '+': PXP += 1; return pxprim()
	if c >= '0' && c <= '9':
		v, q := c_strtoull(PXS[..], PXP); PXP = q
		while ch(PXS[..], PXP) == 'u' || ch(PXS[..], PXP) == 'U' || ch(PXS[..], PXP) == 'l' || ch(PXS[..], PXP) == 'L': PXP += 1
		return v as! int
	if idst(c):
		st := PXP; while idch(ch(PXS[..], PXP)) { PXP += 1 }
		if sid(PXS[st..PXP]) == KW_DEFINED:
			pxws(); par := ch(PXS[..], PXP) == '('
			if par: PXP += 1
			pxws()
			if !idst(ch(PXS[..], PXP)): pperr("expected identifier after 'defined'")
			ns := PXP; while idch(ch(PXS[..], PXP)) { PXP += 1 } name := sid(PXS[ns..PXP])
			if par:
				pxws()
				if ch(PXS[..], PXP) != ')': pperr("expected ')' after defined(")
				PXP += 1
			return if mac(name) >= 0 { 1 } else { 0 }
		return 0
	pperr("bad #if expression"); 0
b2i(b bool) int: if b { 1 } else { 0 }
recursive pxbin(mp int) int:
	l ~= pxprim()
	loop:
		pxws(); a := ch(PXS[..], PXP); b := ch(PXS[..], PXP + 1); pr ~= 0; op ~= 0
		if a == '*' { pr = 10; op = '*' } else if a == '/' { pr = 10; op = '/' } else if a == '%' { pr = 10; op = '%' } else if a == '+' { pr = 9; op = '+' } else if a == '-' { pr = 9; op = '-' } else if a == '<' && b == '<' { pr = 8; op = P_SHL } else if a == '>' && b == '>' { pr = 8; op = P_SHR } else if a == '<' && b == '=' { pr = 7; op = P_LE } else if a == '>' && b == '=' { pr = 7; op = P_GE } else if a == '<' { pr = 7; op = '<' } else if a == '>' { pr = 7; op = '>' } else if a == '=' && b == '=' { pr = 6; op = P_EQ } else if a == '!' && b == '=' { pr = 6; op = P_NE } else if a == '&' && b == '&' { pr = 2; op = P_AND } else if a == '|' && b == '|' { pr = 1; op = P_OR } else if a == '&' { pr = 5; op = '&' } else if a == '^' { pr = 4; op = '^' } else if a == '|' { pr = 3; op = '|' }
		if pr == 0 || pr < mp: break
		PXP += if op >= 256 { 2 } else { 1 }
		r := pxbin(pr + 1)
		l = if op == '*' { l * r } else if op == '/' { if r != 0 { l / r } else { 0 } } else if op == '%' { if r != 0 { l % r } else { 0 } } else if op == '+' { l + r } else if op == '-' { l - r } else if op == P_SHL { l << r } else if op == P_SHR { l >> r } else if op == '<' { b2i(l < r) } else if op == '>' { b2i(l > r) } else if op == P_LE { b2i(l <= r) } else if op == P_GE { b2i(l >= r) } else if op == P_EQ { b2i(l == r) } else if op == P_NE { b2i(l != r) } else if op == '&' { l & r } else if op == '^' { l ^ r } else if op == '|' { l | r } else if op == P_AND { b2i(l != 0 && r != 0) } else { b2i(l != 0 || r != 0) }
