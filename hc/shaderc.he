		if TY[dm].k == T_MAT: emit3(SDECOS, SOP_MEMBERDECORATE, sid0, i, DEC_COLMAJOR); emit4(SDECOS, SOP_MEMBERDECORATE, sid0, i, DEC_MATRIXSTRIDE, 16)
		emitstr(SNAMES, SOP_MEMBERNAME, [sid0, i], snm(mn[i])); off += sz
	emit2(SDECOS, SOP_DECORATE, sid0, DEC_BLOCK); nameid(sid0, snm(bn))
	if isbuf && ro: for i mt.len { emit3(SDECOS, SOP_MEMBERDECORATE, sid0, i, DEC_NONWRITABLE) }
	st := if isbuf { SC_STORAGEBUFFER } else { SC_UNIFORM }; pid := nid(); emit3(SGLOB, SOP_TYPEPOINTER, pid, st, sid0); vr := nid()
	emit3(SGLOB, SOP_VARIABLE, pid, vr, st); emit3(SDECOS, SOP_DECORATE, vr, DEC_DESCRIPTORSET, l.set); emit3(SDECOS, SOP_DECORATE, vr, DEC_BINDING, l.bind)
	if inst >= 0:
