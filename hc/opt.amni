	fn sib(d int, bs int, t int) bool { let s = scl(t); if s < 0 || bs < 0 || bs == d || dn[bs] == 0 || !(FK[bs] == 0 && nd[bs] == 1 || FK[bs] >= 2 && FK[bs] <= 4) { return false; } FK[d] = 7; FB[d] = bs as i32; FI[d] = IR[di[t]].a; FS[d] = s as i8; FD[d] = 0; FK[t] = 8; true }
	for i in i0..i1 { let x = IR[i]; let op = x.op as int; let d = x.d as int; if d < 0 { continue; } dn[d] = 1; if nd[d] != 1 { continue; } di[d] = i as i32;
		if op == I_BIN && x.c == B_ADD && x.l < 0 && x.w == 3 && x.a != x.d && x.b >= 0 && FK[x.b] != 1 && FK[x.a] != 1 { if !sib(d, x.a as int, x.b as int) { sib(d, x.b as int, x.a as int); } continue; }
		if op == I_IMM { FK[d] = 1; FD[d] = x.c; }
		if op == I_SLOT { FK[d] = 2; FD[d] = x.c; } if op == I_GADDR { FK[d] = 3; FD[d] = x.c; } if op == I_RADDR { FK[d] = 4; FD[d] = x.c; } if op == I_FADDR { FK[d] = 5; FD[d] = x.c; }
		if op == I_BIN && x.c == B_ADD && x.l < 0 && x.w == 3 && x.a != x.d && dn[x.a] != 0 && FK[x.b] == 1 && FD[x.b] > -(1 << 30) && FD[x.b] < (1 << 30) { let a = x.a as int;
