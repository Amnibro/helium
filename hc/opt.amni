		for k in (us[v] as int)..(us[v + 1] as int) { let b = ul[k] as int; if vis[b] != v as i32 { vis[b] = v as i32; wk.push(b as i32); } }
		while wk.len > 0 { let b = wk.pop() as int; if CBS[b] < st[v] { st[v] = CBS[b]; }
