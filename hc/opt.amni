import ir;
let ONAMES = ["", "imm", "mov", "bin", "cmp", "un", "lbl", "jmp", "bz", "bnz", "call", "ret", "ld", "st", "slot", "gaddr", "raddr", "param", "sys", "ext", "chk", "copy", "faddr", "callr", "ret2", "res2", "fbin", "fcmp", "cvt", "fun", "zero", "dss", "dsr", "nop", "bchk"];
fn ir_dump(fi int) {
	let f = NFS[fi];
	for i in (f.i0 as int)..(f.i1 as int) {
		let x = IR[i]; let op = x.op as int;
		var b byte[>..] = []; format(b, i, ": ", ONAMES[op], " w", x.w, " d", x.d, " a", x.a, " b", x.b, " c", x.c);
		if x.l >= 0 { format(b, " l", x.l); }
		if op == I_CALL || op == I_CALLR || op == I_SYS { b.append(" ["); for j in x.b { if j > 0 { b.push(' '); } format(b, ARGL[(x.a as int) + j]); } b.push(']'); }
		print(b);
	}
}
var OU i32[>..<]; var OD i32[>..<];
fn usesb(op int) bool { op == I_BIN || op == I_CMP || op == I_FBIN || op == I_FCMP || op == I_FUN || op == I_BCHK }
fn opnds(i int) {
	OU.clear(); OD.clear(); let x = IR[i]; let op = x.op as int; let d = x.d as int; let a = x.a as int; let b = x.b as int;
	if op == I_CALL || op == I_CALLR || op == I_SYS { for j in b { OU.push(ARGL[a + j]); } if op == I_CALLR { OU.push(x.c as i32); } if d >= 0 { OD.push(d as i32); } if op == I_CALL && x.l >= 0 { OD.push(x.l); } return; }
	if op == I_ZERO || op == I_COPY || op == I_ST || op == I_RET || op == I_BZ || op == I_BNZ { if op == I_ZERO || op == I_COPY { OU.push(d as i32); } if a >= 0 && op != I_ZERO { OU.push(a as i32); } if b >= 0 { OU.push(b as i32); } return; }
	if op == I_LBL || op == I_JMP || op == I_DSS || op == I_DSR || op == I_NOP { return; }
	if a >= 0 && op != I_IMM && op != I_SLOT && op != I_GADDR && op != I_RADDR && op != I_FADDR && op != I_PARAM { OU.push(a as i32); }
	if b >= 0 && usesb(op) { OU.push(b as i32); }
	if op == I_FUN && x.c == 6 && x.l >= 0 { OU.push(x.l); }
	if d >= 0 { OD.push(d as i32); }
}
var SLV i32[>..<];
fn mem2reg(fi int) {
	let f = NFS[fi]; let i0 = f.i0 as int; let i1 = f.i1 as int; var nv0 = f.nv as int;
	var so i32[>..<] = []; so.resize(nv0, -1);
	var sw i32[>..<] = []; sw.resize(f.sb as int + 8, -2);
	for i in i0..i1 { let x = IR[i]; if x.op as int == I_SLOT { so[x.d] = x.c as i32; } }
	for i in i0..i1 { let op = IR[i].op as int; if op == I_DSS || op == I_DSR { let m = MSLOT[IR[i].a] as int; if m >= 0 && m < sw.len { sw[m] = -1; } } }
	for i in i0..i1 {
		let x = IR[i]; let op = x.op as int; opnds(i);
		for u, k in OU { let s = so[u] as int; if s < 0 || sw[s] == -1 { continue; }
			let ok = (op == I_LD || op == I_ST) && x.a == u && x.c == 0 && !(op == I_ST && x.b == u) && OU.len <= 2;
			if !ok { sw[s] = -1; } else { if sw[s] == -2 { sw[s] = x.w as i32; } else { if sw[s] != x.w as i32 { sw[s] = -1; } } } }
	}
	SLV.clear(); SLV.resize(sw.len, -1);
	for i in i0..i1 {
		let x = IR[i]; let op = x.op as int;
		if op == I_SLOT { let s = x.c as int; if sw[s] >= 0 { IR[i].op = I_NOP as u8; } continue; }
		if (op == I_LD || op == I_ST) && x.a >= 0 && so[x.a] >= 0 { let s = so[x.a] as int; if sw[s] >= 0 {
			if SLV[s] < 0 { SLV[s] = nv0 as i32; nv0++; }
			if op == I_LD { IR[i] = Ir { I_MOV as u8, x.w, x.d, SLV[s], -1, 0, -1 }; } else { IR[i] = Ir { I_EXT as u8, x.w, SLV[s], x.b, -1, 0, -1 }; } } }
	}
