fn ismov(i int) bool { let x = IR[i]; let op = x.op as int; op == I_MOV || op == I_EXT && (x.w == 3 || x.w == 11) }
fn copyprop(fi int) {
	let f = NFS[fi]; let i0 = f.i0 as int; let i1 = f.i1 as int; let nv = f.nv as int;
	var nd i32[>..<] = []; nd.resize(nv, 0); var uc i32[>..<] = []; uc.resize(nv, 0);
	for i in i0..i1 { opnds(i); for d in OD { nd[d] += 1; } for u in OU { uc[u] += 1; } }
	var rp i32[>..<] = []; rp.resize(nv, -1);
	for i in i0..i1 { if !ismov(i) { continue; } let d = IR[i].d as int; var a = IR[i].a as int; if nd[d] != 1 { continue; } while rp[a] >= 0 { a = rp[a] as int; }
		if nd[a] == 1 { rp[d] = a as i32; IR[i].op = I_NOP as u8; continue; }
		var seen = 0; var j = i + 1; var ok = true;
		while j < i1 && seen < (uc[d] as int) { let op = IR[j].op as int; if op == I_LBL { ok = false; break; } opnds(j); for u in OU { if u as int == d { seen++; } } var ka = false; for q in OD { if q as int == a { ka = true; } } if seen < (uc[d] as int) && (ka || op == I_JMP || op == I_BZ || op == I_BNZ || op == I_RET) { ok = false; break; } j++; }
		if ok && seen == (uc[d] as int) { for k in (i + 1)..j { let s0 = rp[d]; rp[d] = a as i32; subst(k, rp); rp[d] = s0; } IR[i].op = I_NOP as u8; } }
	for i in i0..i1 { subst(i, rp); }
