fn extw(v int, w int) int { let z = wsz(w); if z == 8 { return v; } let sh = 64 - 8 * z; if wsg(w) { (v << sh) >> sh } else { ((v as! u64) << (sh as u64) >> (sh as u64)) as! int } }
fn ccv(c int, a int, b int) bool { let ua = a as! u64; let ub = b as! u64; if c == CC_E { a == b } else { if c == CC_NE { a != b } else { if c == CC_L { a < b } else { if c == CC_GE { a >= b } else { if c == CC_LE { a <= b } else { if c == CC_G { a > b } else { if c == CC_B { ua < ub } else { if c == CC_AE { ua >= ub } else { if c == CC_BE { ua <= ub } else { ua > ub } } } } } } } } } }
fn constfold(fi int) {
	let f = NFS[fi]; let i0 = f.i0 as int; let i1 = f.i1 as int; let nv = f.nv as int;
	var nd i32[>..<] = []; nd.resize(nv, 0); for i in i0..i1 { opnds(i); for d in OD { nd[d] += 1; } }
	var kn i8[>..<] = []; kn.resize(nv, 0); var kv i64[>..<] = []; kv.resize(nv, 0);
	for i in i0..i1 {
		let x = IR[i]; let op = x.op as int; let d = x.d as int; let a = x.a as int; let b = x.b as int; let c = x.c as int; let w = x.w as int;
		fn k(v int) bool { v >= 0 && kn[v] != 0 }
		var r = 0; var ok = false;
		if op == I_IMM { ok = true; r = c; }
		if (op == I_MOV || op == I_EXT && (w & 8) == 0) && k(a) { ok = true; r = if op == I_EXT { extw(kv[a] as int, w) } else { kv[a] as int }; }
		if op == I_BIN && x.l < 0 && k(a) && k(b) && c != B_DIV && c != B_MOD && c != B_UDIV && c != B_UMOD { let p = kv[a] as int; let q = kv[b] as int; ok = true;
			r = extw(if c == B_ADD { p + q } else { if c == B_SUB { p - q } else { if c == B_MUL { p * q } else { if c == B_AND { p & q } else { if c == B_OR { p | q } else { if c == B_XOR { p ^ q } else { if c == B_SHL { p << (q & 63) } else { if c == B_SAR { p >> (q & 63) } else { ((p as! u64) >> ((q & 63) as u64)) as! int } } } } } } } }, w); }
		if op == I_CMP && k(a) && k(b) { ok = true; r = if ccv(c, kv[a] as int, kv[b] as int) { 1 } else { 0 }; }
		if ok && d >= 0 && nd[d] == 1 { kn[d] = 1; kv[d] = r as i64; if op != I_IMM { IR[i] = Ir { I_IMM as u8, w as u8, d as i32, -1, -1, r as i64, -1 }; } continue; }
		if (op == I_BZ || op == I_BNZ) && k(a) { let t = kv[a] != 0; if t == (op == I_BNZ) { IR[i] = Ir { I_JMP as u8, 3, -1, -1, -1, c as i64, -1 }; } else { IR[i].op = I_NOP as u8; } }
	}
}
fn deadcode(fi int) {
	let f = NFS[fi]; let i0 = f.i0 as int; let i1 = f.i1 as int;
	var ch = true;
	while ch { ch = false;
		var rf i8[>..<] = []; rf.resize(LBL.len, 0);
		for i in i0..i1 { let op = IR[i].op as int; if op == I_JMP || op == I_BZ || op == I_BNZ { rf[IR[i].c] = 1; } }
		var dead = false;
		for i in i0..i1 { let op = IR[i].op as int;
			if op == I_LBL { if rf[IR[i].c] != 0 { dead = false; } else { IR[i].op = I_NOP as u8; ch = true; } continue; }
			if dead && op != I_NOP { IR[i].op = I_NOP as u8; ch = true; continue; }
			if op == I_JMP || op == I_RET { dead = true; } }
	}
}
