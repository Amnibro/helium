fn optimize_all() {
	var lim byte[>..] = []; let mx = if env("HC_INL", lim) { let v, ok = parse_int(lim[..]); v } else { 40 };
	var noi byte[>..] = []; let inl = !env("HC_NOINL", noi);
	let n = NFS.len; var stt i8[>..<] = []; stt.resize(n, 0); var ok i8[>..<] = []; ok.resize(n, 0); var order i32[>..<] = [];
	var sf i32[>..<] = []; var sp i32[>..<] = [];
	for r in n { if stt[r] != 0 { continue; } sf.push(r as i32); sp.push(NFS[r].i0); stt[r] = 1;
		while sf.len > 0 { let t = sf.len - 1; let fi = sf[t] as int; var p = sp[t] as int; var pushed = false;
			while p < (NFS[fi].i1 as int) { let x = IR[p]; p++; if x.op as int == I_CALL && x.c >= 0 && stt[x.c] == 0 { sp[t] = p as i32; let c = x.c as int; stt[c] = 1; sf.push(c as i32); sp.push(NFS[c].i0); pushed = true; break; } }
			if !pushed { sf.pop(); sp.pop(); stt[fi] = 2; order.push(fi as i32); } } }
	for fi in order { if inl { inline_into(fi as int, ok); } mem2reg(fi as int); copyprop(fi as int); constfold(fi as int); deadcode(fi as int); if inl && NFS[fi].inst >= 0 && isize(fi as int) <= mx { ok[fi] = 1; } }
}
fn subst(i int, rp i32[>..<]&) {
	var x = IR[i]; let op = x.op as int;
