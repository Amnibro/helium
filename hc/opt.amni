		if op == I_BCHK { let k1 = vof(x.a as int) as i64; let k2 = vof(x.b as int) as i64; var h = ((k1 * 1000003 + k2 * 7919 + 34) as! u64); h = (h ^ (h >> 29)) * 0x9E3779B97F4A7C15; var p = ((h >> 20) % (hs as u64)) as int; var hit = false;
			while hv[3 * p] == gen as i32 { if hk[4 * p] == 34 && hk[4 * p + 1] == k1 && hk[4 * p + 2] == k2 { hit = true; break; } p = (p + 1) % hs; }
			if hit { IR[i].op = I_NOP as u8; } else { hv[3 * p] = gen as i32; hk[4 * p] = 34; hk[4 * p + 1] = k1; hk[4 * p + 2] = k2; hk[4 * p + 3] = 0; hv[3 * p + 1] = -1; hv[3 * p + 2] = -1; } continue; }
		if d < 0 || op == I_ZERO || op == I_COPY || op == I_ST { continue; }
		if nd[d] > 1 { vn[d] = nvn as i32; nvn++; continue; }
		if op == I_MOV { vn[d] = vof(x.a as int) as i32; continue; }
		let ok = op == I_IMM || (op == I_BIN || op == I_UN) && x.l < 0 || op == I_CMP || op == I_EXT || op == I_SLOT || op == I_GADDR || op == I_RADDR || op == I_FADDR || op == I_LD || op == I_FBIN || op == I_FCMP || op == I_CVT && x.c != 5 || op == I_FUN && x.c != 6;
		if !ok { vn[d] = nvn as i32; nvn++; continue; }
		let usea = op != I_IMM && op != I_SLOT && op != I_GADDR && op != I_RADDR && op != I_FADDR;
		let useb = op == I_BIN || op == I_CMP || op == I_FBIN || op == I_FCMP;
		var va = if usea { vof(x.a as int) } else { -1 }; var vb = if useb { vof(x.b as int) } else { -1 };
		let comm = op == I_BIN && (x.c == B_ADD || x.c == B_MUL || x.c == B_AND || x.c == B_OR || x.c == B_XOR) || op == I_FBIN && (x.c == B_ADD || x.c == B_MUL) || op == I_CMP && (x.c == CC_E || x.c == CC_NE);
		if comm && vb < va { let t = va; va = vb; vb = t; }
		let k0 = (op | (x.w as int << 8)) as i64; let k1 = va as i64; let k2 = vb as i64; let k3 = x.c ^ (if op == I_LD { (mem as i64) << 40 } else { 0 });
		var h = ((k0 * 31 + k1) * 1000003 + k2 * 7919 + k3 * 131) as! u64; h = (h ^ (h >> 29)) * 0x9E3779B97F4A7C15; var p = ((h >> 20) % (hs as u64)) as int;
		var hit = -1;
		while hv[3 * p] == gen as i32 { if hk[4 * p] == k0 && hk[4 * p + 1] == k1 && hk[4 * p + 2] == k2 && hk[4 * p + 3] == k3 { hit = p; break; } p = (p + 1) % hs; }
		if hit >= 0 { let r = hv[3 * hit + 2] as int; let rv = hv[3 * hit + 1]; if vn[r] == rv && r != d { IR[i] = Ir { I_MOV as u8, 3, d as i32, r as i32, -1, 0, -1 }; vn[d] = rv; continue; } }
		vn[d] = nvn as i32; nvn++;
		if hit < 0 { hv[3 * p] = gen as i32; hk[4 * p] = k0; hk[4 * p + 1] = k1; hk[4 * p + 2] = k2; hk[4 * p + 3] = k3; }
		let q = if hit >= 0 { hit } else { p }; hv[3 * q + 1] = vn[d]; hv[3 * q + 2] = d as i32;
	}
}
fn rdonly(i int) bool { let x = IR[i]; let op = x.op as int; op == I_IMM || op == I_MOV || op == I_EXT || op == I_BIN || op == I_UN || op == I_CMP || op == I_SLOT || op == I_GADDR || op == I_RADDR || op == I_FADDR || op == I_LD || op == I_FBIN || op == I_FCMP || op == I_BCHK || op == I_NOP || op == I_BZ || op == I_BNZ || op == I_CVT && x.c != 5 || op == I_FUN && (x.c >= 1 && x.c <= 4 || x.c >= 7) }
fn cpfwd(fi int) {
	let f = NFS[fi]; let i0 = f.i0 as int; let i1 = f.i1 as int; let nv = f.nv as int;
	var nd i32[>..<] = []; nd.resize(nv, 0); var us i32[>..<] = []; us.resize(nv + 1, 0); var kn i8[>..<] = []; kn.resize(nv, 0); var kv i64[>..<] = []; kv.resize(nv, 0); var sv i64[>..<] = []; sv.resize(nv, -1);
	var so int[>..] = []; var mk int[>..] = [];
	for i in i0..i1 { opnds(i); for d in OD { nd[d] += 1; } for u in OU { us[u + 1] += 1; } let op = IR[i].op as int; if op == I_SLOT { so.push(IR[i].c as int); } if op == I_DSS || op == I_DSR { if MSLOT[IR[i].a] >= 0 { mk.push(MSLOT[IR[i].a] as int); } } }
	for i in i0..i1 { let x = IR[i]; let d = x.d as int; if d >= 0 && nd[d] == 1 { if x.op as int == I_IMM { kn[d] = 1; kv[d] = x.c; } if x.op as int == I_SLOT { sv[d] = x.c; } } }
	sort(so[..]); for v in nv { us[v + 1] += us[v]; }
	var ul i32[>..<] = []; ul.resize(us[nv] as int, 0); var uc i32[>..<] = []; uc.resize(nv, 0);
	for i in i0..i1 { opnds(i); for u in OU { ul[(us[u] + uc[u]) as int] = i as i32; uc[u] += 1; } }
	var sl i32[>..<] = []; var stk i32[>..<] = []; var dirty int[>..] = [];
	for i in i0..i1 {
		let x = IR[i]; if x.op as int != I_COPY || x.d < 0 || sv[x.d] < 0 || !(kn[x.b] != 0) { continue; }
		let s = sv[x.d] as int; let z = kv[x.b] as int; let a = x.a as int; if a < 0 || sv[a] >= 0 && (sv[a] as int) == s { continue; }
		var bad = false; for m in dirty { if m == s { bad = true; } } for m in mk { if m >= s && m < s + z { bad = true; } } for o in so { if o > s && o < s + z { bad = true; } } if bad { continue; }
		var e = i + 1; while e < i1 && rdonly(e) { e++; }
		sl.clear(); for k in i0..i1 { if IR[k].op as int == I_SLOT && IR[k].c as int == s { sl.push(k as i32); } }
		var last = i; var cpo = -1;
		for k in sl { let v = IR[k].d as int; if nd[v] != 1 { bad = true; break; }
			stk.clear(); stk.push(v as i32);
			while stk.len > 0 && !bad { let w = stk.pop() as int;
				for q in (us[w] as int)..(us[w + 1] as int) { let p = ul[q] as int; let y = IR[p]; let yo = y.op as int;
					if p == i && y.d as int == w && y.a as int != w { if w != v { bad = true; } continue; }
					if p <= i || p > e { bad = true; break; }
					if p > last { last = p; }
					if yo == I_LD && y.a as int == w { continue; }
					if (yo == I_BIN && (y.c == B_ADD || y.c == B_SUB && y.a as int == w) || yo == I_MOV || yo == I_EXT && y.w == 3) && y.d >= 0 && nd[y.d] == 1 { stk.push(y.d); continue; }
					if yo == I_COPY && p == e && y.a as int == w && y.d as int != w && y.b as int != w { cpo = p; continue; }
					bad = true; break; } } }
		if bad || cpo >= 0 && last > cpo { continue; }
		if nd[a] > 1 { for p in (i + 1)..(last + 1) { opnds(p); for d in OD { if d as int == a { bad = true; } } } }
		if bad { continue; }
		IR[i].op = I_NOP as u8; if sv[a] >= 0 { dirty.push(sv[a] as int); }
		for k in sl { let v = IR[k].d as int; for q in (us[v] as int)..(us[v + 1] as int) { let p = ul[q] as int; if p > i { if IR[p].a as int == v { IR[p].a = a as i32; } if IR[p].b as int == v && usesb(IR[p].op as int) { IR[p].b = a as i32; } } } }
	}
}
