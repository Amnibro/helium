			if op == I_RET { if y.a >= 0 && x.d >= 0 { IR.push(Ir { I_MOV as u8, 3, x.d, (y.a as int + vb) as i32, -1, 0, -1 }); } if y.b >= 0 && x.l >= 0 { IR.push(Ir { I_MOV as u8, 3, x.l, (y.b as int + vb) as i32, -1, 0, -1 }); } IR.push(Ir { I_JMP as u8, 3, -1, -1, -1, lend as i64, -1 }); continue; }
			if y.d >= 0 { y.d = (y.d as int + vb) as i32; }
