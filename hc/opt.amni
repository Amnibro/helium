}
fn isize(fi int) int { let f = NFS[fi]; var n = 0; for i in (f.i0 as int)..(f.i1 as int) { let op = IR[i].op as int; if op != I_NOP && op != I_LBL { n++; } } n }
fn inline_into(fi int, ok i8[>..<]&) {
	let f = NFS[fi]; let ni0 = IR.len; var nv = f.nv as int; var sb = f.sb as int; var lm i32[>..<] = [];
	for i in (f.i0 as int)..(f.i1 as int) {
		let x = IR[i]; let cal = x.c as int;
		if !(x.op as int == I_CALL && cal >= 0 && cal != fi && ok[cal] != 0) { IR.push(x); continue; }
		let g = NFS[cal]; let vb = nv; nv += g.nv as int; let sbase = al(sb, 16); sb = sbase + (g.sb as int); let lend = nlbl();
		lm.clear(); lm.resize(LBL.len, -1); var mm i32[>..<] = []; var mo i32[>..<] = [];
		for j in (g.i0 as int)..(g.i1 as int) {
			var y = IR[j]; let op = y.op as int;
