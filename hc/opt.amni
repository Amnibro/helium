	if op == I_CALL || op == I_CALLR || op == I_SYS { for j in x.b { ARGL[(x.a as int) + j] = r(ARGL[(x.a as int) + j]); } if op == I_CALLR { x.c = r(x.c as i32) as i64; } IR[i] = x; return; }
	if op == I_LBL || op == I_JMP || op == I_DSS || op == I_DSR || op == I_NOP || op == I_IMM || op == I_SLOT || op == I_GADDR || op == I_RADDR || op == I_FADDR || op == I_PARAM { return; }
