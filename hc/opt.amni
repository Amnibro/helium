			if op == I_SLOT { y.c += sbase as i64; }
			if op == I_DSS || op == I_DSR { let m = y.a as int; var k = -1; for q, qi in mm { if q as int == m { k = mo[qi] as int; } } if k < 0 { MUSE.push(MUSE[m]); MSLOT.push(if MSLOT[m] >= 0 { MSLOT[m] + (sbase as i32) } else { -1 }); k = MUSE.len - 1; mm.push(m as i32); mo.push(k as i32); } y.a = k as i32; IR.push(y); continue; }
			if op == I_CALL || op == I_CALLR || op == I_SYS { let a0 = ARGL.len; for q in y.b { ARGL.push((ARGL[(y.a as int) + q] as int + vb) as i32); } y.a = a0 as i32; if op == I_CALLR { y.c = (y.c as int + vb) as i64; } if op == I_CALL && y.l >= 0 { y.l = (y.l as int + vb) as i32; } IR.push(y); continue; }
			if y.a >= 0 && op != I_IMM && op != I_SLOT && op != I_GADDR && op != I_RADDR && op != I_FADDR { y.a = (y.a as int + vb) as i32; }
