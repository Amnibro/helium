	var lpos i32[>..<] = []; lpos.resize(LBL.len, -1);
	for i in i0..i1 { if IR[i].op as int == I_LBL { lpos[IR[i].c] = (i - i0) as i32; } }
	var lp i32[>..<] = []; var dep i32[>..<] = []; dep.resize(n + 1, 0);
	for i in i0..i1 { let op = IR[i].op as int; if op == I_JMP || op == I_BZ || op == I_BNZ { let p = lpos[IR[i].c] as int; if p >= 0 && p < i - i0 { lp.push(p as i32); lp.push((i - i0) as i32); dep[p] += 1; dep[i - i0 + 1] -= 1; } } }
	for i in 1..(n + 1) { dep[i] += dep[i - 1]; }
	FK.clear(); FK.resize(nv, 0); FB.clear(); FB.resize(nv, -1); FD.clear(); FD.resize(nv, 0); UC.clear(); UC.resize(nv, 0);
	for i in i0..i1 { opnds(i); for d in OD { nd[d] += 1; } for u in OU { UC[u] += 1; } }
	for i in i0..i1 { let x = IR[i]; let op = x.op as int; let d = x.d as int; if d < 0 || nd[d] != 1 { continue; }
		if op == I_IMM { FK[d] = 1; FD[d] = x.c; }
		if op == I_SLOT { FK[d] = 2; FD[d] = x.c; } if op == I_GADDR { FK[d] = 3; FD[d] = x.c; } if op == I_RADDR { FK[d] = 4; FD[d] = x.c; } if op == I_FADDR { FK[d] = 5; FD[d] = x.c; }
		if op == I_BIN && x.c == B_ADD && x.l < 0 && x.w == 3 && FK[x.b] == 1 && FD[x.b] > -(1 << 30) && FD[x.b] < (1 << 30) { let a = x.a as int;
			if FK[a] >= 2 && FK[a] <= 4 { FK[d] = FK[a]; FD[d] = FD[a] + FD[x.b]; } else { if FK[a] == 6 { FK[d] = 6; FB[d] = FB[a]; FD[d] = FD[a] + FD[x.b]; } else { if FK[a] == 0 && nd[a] == 1 { FK[d] = 6; FB[d] = a as i32; FD[d] = FD[x.b]; } } } }
	}
	for i in i0..i1 { opnds(i); let p = (i - i0) as i32; let m = 1 << (3 * min(dep[i - i0] as int, 4));
		for u0 in OU { let u = if FK[u0] == 6 { FB[u0] as int } else { u0 as int }; if FK[u] != 0 { continue; } if st[u] < 0 { st[u] = p; } en[u] = p; wt[u] += m as i32; }
		for d in OD { if FK[d] != 0 { continue; } if st[d] < 0 { st[d] = p; } en[d] = p; wt[d] += m as i32; } }
	for v in VZERO { st[v] = 0; }
	var ch = true;
	while ch { ch = false; var k = 0; while k < lp.len { let p = lp[k]; let j = lp[k + 1]; k += 2;
		for v in nv { if st[v] < 0 { continue; }
			if st[v] < p && en[v] >= p && en[v] < j { en[v] = j; ch = true; }
			if nd[v] > 1 && st[v] >= p && st[v] <= j && en[v] < j { en[v] = j; ch = true; } } } }
	XW.clear(); XW.resize(nv, 0); XREG.clear(); XREG.resize(nv, -1);
	var ncall i32[>..<] = []; ncall.resize(n + 1, 0);
	var ga i32[>..<] = []; ga.resize(n + 1, 0); var gb i32[>..<] = []; gb.resize(n + 1, 0);
	for i in i0..i1 { let x = IR[i]; let op = x.op as int; let w = x.w as int; let p = i - i0; let isc = op == I_CALL || op == I_CALLR || op == I_SYS || op == I_CVT && x.c == 5; ncall[p + 1] = ncall[p] + (if isc || op == I_PARAM { 1 } else { 0 });
		ga[p + 1] = ga[p] + (if op == I_COPY || op == I_ZERO { 1 } else { 0 }); gb[p + 1] = gb[p] + (if op == I_FUN && x.c == 5 { 1 } else { 0 });
		let d = x.d as int; if d < 0 || op == I_ZERO || op == I_COPY || op == I_ST { continue; }
		let fw = if op == I_FBIN || op == I_FUN && x.c < 7 || op == I_CVT && (x.c == 1 || x.c == 2 || x.c == 7) || (op == I_LD || op == I_MOV || op == I_EXT) && (w & 8) != 0 { w } else { if op == I_CVT && x.c == 3 { 11 } else { if op == I_CVT && x.c == 4 { 10 } else { -1 } } };
		if fw < 0 && ismov(i) && (w == 3 || w == 11) { continue; }
		if fw < 0 || XW[d] != 0 && XW[d] as int != fw { XW[d] = -1; } else { if XW[d] == 0 { XW[d] = fw as i8; } } }
	var pc = true; var it = 0;
	while pc && it < 7 { pc = false; it++; for i in i0..i1 { let x = IR[i]; let d = x.d as int; if !ismov(i) || d < 0 || XW[d] < 0 || x.w == 11 { continue; } let a = x.a as int; let fa = XW[a] as int; if fa < 0 { XW[d] = -1; pc = true; continue; } if fa == 0 { continue; } if XW[d] == 0 { XW[d] = fa as i8; pc = true; } else { if XW[d] as int != fa { XW[d] = -1; pc = true; } } } }
	for v in nv { if XW[v] < 0 { XW[v] = 0; } }
	var cnt i32[>..<] = []; cnt.resize(n + 1, 0); for v in nv { if st[v] >= 0 { cnt[st[v]] += 1; } }
	var acc = 0; for i in (n + 1) { let c = cnt[i] as int; cnt[i] = acc as i32; acc += c; }
	var ord i32[>..<] = []; ord.resize(acc, 0); for v in nv { if st[v] >= 0 { ord[cnt[st[v]]] = v as i32; cnt[st[v]] += 1; } }
	var xo i32[>..<] = []; var go i32[>..<] = [];
	for v in ord { if XW[v] != 0 && ncall[en[v]] - ncall[st[v] + 1] <= 0 { xo.push(v); } else { go.push(v); } }
	var bad i8[>..<] = []; bad.resize(nv, 0);
	for v in nv { if st[v] < 0 { continue; } let s0 = st[v] as int; let e0 = en[v] as int + 1; let cl = ncall[e0] - ncall[s0] > 0; bad[v] = ((if cl || ga[e0] - ga[s0] > 0 { 1 } else { 0 }) | (if cl || gb[e0] - gb[s0] > 0 { 2 } else { 0 }) | (if cl { 4 } else { 0 })) as i8; }
	var nob i8[>..<] = [];
	lscan(xo, st, en, wt, XREGS, XREG, nob);
	if xo.len > 0 { var ing i8[>..<] = []; ing.resize(nv, 0); for v in go { ing[v] = 1; } for v in xo { if XREG[v] < 0 { ing[v] = 1; } } go.clear(); for v in ord { if ing[v] != 0 { go.push(v); } } }
	lscan(go, st, en, wt, CREGS, REGOF, bad);
