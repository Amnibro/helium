import parse;
var FO byte[>..]; var FOL = 0; var NSLP = false;
fn fw(s const byte[:]) { FO.append(s); }
fn ft(n int) { fw(tok_text(ND[n].t as int)); }
fn tabs(d int) { for i in d { FO.push('\t'); } }
fn qn(id int) { fw(nm(id)); }
recursive fn tconst(n int) bool { let k = ND[n].k as int; if k == N_TCONST { return true; } if (k == N_TSLICE || k == N_TREF) && (ND[n].fl & 1) != 0 { return true; } if k == N_TARR || k == N_TSLICE || k == N_TREF || k == N_TVAR { return tconst(ND[n].a as int); } false }
recursive fn ftyw(n int) { if tconst(n) { fw("("); fty(n); fw(")"); } else { fty(n); } }
recursive fn fty(n int) {
	let x = ND[n]; let k = x.k as int;
	if k == N_TPRIM { ft(n); return; }
	if k == N_TNAME { qn(x.s as int); if x.n > 0 { fw("<"); for i in x.n { if i > 0 { fw(", "); } fty(kid(n, i)); } fw(">"); } if (x.fl & 1) != 0 { fw(".."); } return; }
	if k == N_TCONST { fw("const "); fty(x.a as int); return; }
	if k == N_TSLICE { if (x.fl & 1) != 0 { fw("const "); ftyw(x.a as int); } else { fty(x.a as int); } fw("[:]"); return; }
	if k == N_TREF { if (x.fl & 1) != 0 { fw("const "); ftyw(x.a as int); } else { fty(x.a as int); } if (x.fl & 2) == 0 || x.c > 0 { fw("&"); } if x.c > 0 { fw("<"); fw(nm(x.c as int - T_KW)); if x.s >= 0 { fw(" in "); qn(x.s as int); } fw(">"); } if (x.fl & 2) != 0 { fw("?"); } return; }
	if k == N_TARR {
		fty(x.a as int); let o = x.op as int;
		if o == A_FIXED { fw("["); fx(x.b as int, 0, true); fw("]"); return; }
		if o == A_LIM { fw("[.."); if x.b >= 0 { fx(x.b as int, 0, true); } fw("]"); return; }
		if o == A_GROW { fw("[>..]"); return; }
		if o == A_GS { fw("[>..<]"); return; }
		if x.c >= 0 { fw("["); fw(nm(x.c as int - T_KW)); fw("]"); return; }
		fw("[]"); return;
	}
	if k == N_TVAR { fty(x.a as int); fw("."); qn(x.s as int); return; }
	if k == N_TIDX { ft(n); fw(if (x.fl & 1) != 0 { " upto " } else { " in " }); qn(x.s as int); return; }
	if k == N_TFN { fw("fn"); if (x.fl & 1) != 0 { fw("("); for i in x.n { if i > 0 { fw(", "); } fty(kid(n, i)); } fw(")"); if x.b >= 0 { let r = x.b as int; fw(" -> "); if ND[r].n != 1 { fw("("); } for i in ND[r].n { if i > 0 { fw(", "); } fty(kid(r, i)); } if ND[r].n != 1 { fw(")"); } } } return; }
	fw("?type?");
}
fn bprec(n int) int { let k = ND[n].k as int; if k == N_INT || k == N_FLT { return 11; } if k == N_BIN { return binprec(TK[ND[n].t].k as int); } if k == N_UN || k == N_AS { return 11; } if k == N_BLOCK || k == N_IF || k == N_MATCH || k == N_EBLOCK || k == N_LOOP || k == N_WHILE || k == N_FOR || k == N_FUNVAL || k == N_RET || k == N_BREAK { return -1; } 12 }
recursive fn fxp(n int, p int, inb bool) { if bprec(n) < p { let sf = FOL; let sn = NSLP; FOL = 0; NSLP = false; fw("("); fx(n, 0, true); fw(")"); FOL = sf; NSLP = sn; } else { fx(n, p, inb); } }
recursive fn flist(n int) { let sf = FOL; let sn = NSLP; FOL = 0; NSLP = false; for i in ND[n].n { if i > 0 { fw(", "); } fx(kid(n, i), 0, true); } FOL = sf; NSLP = sn; }
fn fsub(n int) { let sf = FOL; let sn = NSLP; FOL = 0; NSLP = false; fx(n, 0, true); FOL = sf; NSLP = sn; }
fn fscr(n int) { let sf = FOL; let sn = NSLP; FOL = 0; NSLP = true; fx(n, 0, true); FOL = sf; NSLP = sn; }
recursive fn fbitems(b int) { let x = ND[b]; for i in x.n { let c = kid(b, i); fw(" "); fstmt1(c, true); fw(";"); if ND[c].k as int == N_IF && ND[c].fl == 1 { fbitems(ND[c].b as int); } } if x.a >= 0 { let t = x.a as int; fw(" "); fstmt1(t, true); if ND[t].k as int == N_IF && ND[t].fl == 1 { fw(";"); fbitems(ND[t].b as int); } } }
recursive fn fbrace(b int) { fw("{"); fbitems(b); fw(" }"); }
recursive fn fx(n int, p int, inb bool) {
	let x = ND[n]; let k = x.k as int;
	if k == N_INT || k == N_FLT || k == N_STR || k == N_TRUE || k == N_FALSE || k == N_NULL || k == N_SELF { ft(n); return; }
	if k == N_ID { qn(x.s as int); return; }
	if k == N_BIN { let q = bprec(n); let sf = FOL; FOL = TK[x.t].k as int; fxp(x.a as int, q, true); FOL = sf; fw(" "); ft(n); fw(" "); fxp(x.b as int, q + 1, true); return; }
	if k == N_UN { ft(n); let a = x.a as int; if ND[a].k as int == N_UN && tok_text(ND[a].t as int)[0] == tok_text(x.t as int)[0] { fw("("); fsub(a); fw(")"); } else { fxp(a, 11, true); } return; }
	if k == N_CALL { fxp(x.a as int, 12, true); if x.c >= 0 { fw("<"); for i in ND[x.c].n { if i > 0 { fw(", "); } fty(kid(x.c as int, i)); } fw(">"); } fw("("); flist(n); fw(")"); if x.b >= 0 { fw(" "); ffv(x.b as int); } return; }
	if k == N_IDX { fxp(x.a as int, 12, true); fw("["); fsub(x.b as int); fw("]"); return; }
	if k == N_SLICE { fxp(x.a as int, 12, true); fw("["); if (x.fl & 1) != 0 { fw("^"); } if x.b >= 0 { let sn = NSLP; NSLP = false; let sf = FOL; FOL = T_DOTDOT; fx(x.b as int, 0, true); FOL = sf; NSLP = sn; } fw(".."); if (x.fl & 2) != 0 { fw("^"); } if x.c >= 0 { fsub(x.c as int); } fw("]"); return; }
	if k == N_DOT { fxp(x.a as int, 12, true); fw("."); qn(x.s as int); return; }
	if k == N_AS { let w = FOL == T_AND || FOL == T_LT || FOL == T_SHL || FOL == T_LTEQ || FOL == T_DOTDOT || FOL == T_QUEST || FOL == T_ANDEQ || FOL == T_ANDAND; if w { fw("("); } let sf = FOL; FOL = 0; fxp(x.a as int, 12, true); FOL = sf; fw(if (x.fl & 1) != 0 { " as! " } else { " as " }); fty(x.b as int); if w { fw(")"); } return; }
	if k == N_ARR { fw("["); if x.c >= 0 { fw(".."); fsub(x.c as int); } else { if x.a >= 0 { fsub(x.a as int); fw("; "); fsub(x.b as int); } else { flist(n); } } fw("]"); return; }
	if k == N_SLIT { if NSLP { fw("("); NSLP = false; fslit(n); NSLP = true; fw(")"); } else { fslit(n); } return; }
	if k == N_FUNVAL { ffv(n); return; }
	if k == N_IF { fw("if "); fscr(x.a as int); fw(" "); fbrace(x.b as int); if x.c >= 0 { fw(" else "); if ND[x.c].k as int == N_IF { fx(x.c as int, 0, true); } else { fbrace(x.c as int); } } return; }
	if k == N_MATCH { fw("match "); fscr(x.a as int); fw(" { "); for i in x.n { if i > 0 { fw(", "); } farm(kid(n, i), -1); } fw(" }"); return; }
	if k == N_EBLOCK { fw("block "); fbrace(x.a as int); return; }
	if k == N_BLOCK { fbrace(n); return; }
	if k == N_LOOP { fw("loop "); fbrace(x.a as int); return; }
	if k == N_WHILE { fw("while "); fscr(x.a as int); fw(" "); fbrace(x.b as int); return; }
	if k == N_FOR { fforh(n); fw(" "); fbrace(x.d as int); return; }
	if k == N_RET { fret(n); return; }
	if k == N_BREAK { fw("break"); if x.a >= 0 { fw(" "); fx(x.a as int, 0, true); } return; }
	if k == N_CONT { fw("continue"); return; }
	if k == N_CFOR { fcfor(n, -1); return; }
