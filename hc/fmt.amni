	if (x.fl & 1) != 0 { fw("_"); } else { for i in x.n { if i > 0 { fw(", "); } fpat(kid(a, i)); } if x.s >= 0 { fw(if (x.fl & 2) != 0 { " &" } else { " " }); qn(x.s as int); } }
	fw(" => "); fx(x.b as int, 0, true);
}
recursive fn fcfor(n int, d int) {
	let x = ND[n]; let nb = x.a as int; let src = x.b as int; let m = x.fl as int;
	fw("const for <"); for i in ND[nb].n { if i > 0 { fw(", "); } qn(kid(nb, i)); } fw("> in ");
	let o = x.op as int;
