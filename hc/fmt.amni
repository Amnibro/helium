	for i in x.n { if i > 0 { fw(", "); } if (fl & V_GLOBAL) != 0 { fnsp(x.c as int, TK[x.t].f as int); } qn(kid(n, i)); }
	if x.a >= 0 { fw(" "); fty(x.a as int); }
	if x.b >= 0 { fw(if (fl & V_BYREF) != 0 { " .= " } else { if kw { " = " } else { if (fl & V_VAR) != 0 { " ~= " } else { " := " } } }); flist(x.b as int); }
}
fn is_stmtk(k int) bool { k == N_VDECL || k == N_ASSIGN || k == N_INCDEC || k == N_FN }
recursive fn fstmt1(n int, inb bool) {
	let x = ND[n]; let k = x.k as int;
	if k == N_VDECL { fvdecl(n); return; }
	if k == N_ASSIGN { if x.op as int == T_COMMA { flist(x.a as int); fw(" = "); } else { fx(x.a as int, 0, true); fw(" "); ft(n); fw(" "); } fx(x.b as int, 0, true); return; }
	if k == N_INCDEC { fx(x.a as int, 12, true); ft(n); return; }
	if k == N_FN { ffn(n, -1); return; }
	if k == N_IF && x.fl == 1 { fw("guard "); fx(x.a as int, 0, true); if x.c >= 0 { fw(" else "); fbrace(x.c as int); } return; }
	fx(n, 0, inb);
}
fn blockish(n int) bool { let k = ND[n].k as int; k == N_IF && ND[n].fl != 1 || k == N_WHILE || k == N_FOR || k == N_LOOP || k == N_MATCH || k == N_EBLOCK || k == N_CFOR && ND[n].fl == 0 || k == N_FN }
fn isguard(n int) bool { ND[n].k as int == N_IF && ND[n].fl == 1 }
recursive fn sline(n int) int { let x = ND[n]; let k = x.k as int; if k == N_ASSIGN && x.op as int == T_COMMA && ND[x.a].n > 0 { return sline(kid(x.a as int, 0)); } if (k == N_ASSIGN || k == N_INCDEC || k == N_BIN || k == N_CALL || k == N_IDX || k == N_DOT || k == N_AS || k == N_SLICE) && x.a >= 0 { return min(sline(x.a as int), TK[x.t].line as int); } TK[x.t].line as int }
fn oneline(b int) bool { b < BEND.len && BEND[b] >= 0 && TK[BEND[b]].line == TK[ND[b].t].line }
recursive fn bitems(b int, r i32[>..]&) bool {
	let x = ND[b]; for i in x.n { r.push(kid(b, i) as i32); }
	if x.a < 0 { return x.n > 0 && isguard(kid(b, x.n - 1)) && bitems(ND[kid(b, x.n - 1)].b as int, r); }
	let t = x.a as int; r.push(t as i32); if isguard(t) { return bitems(ND[t].b as int, r); } true
}
var SEMB = -1; var SEMS i32[>..];
fn semprop(b int, c int) { if b != SEMB && !SEMS.contains(b as i32) { return; } let k = ND[c].k as int; if k == N_EBLOCK { SEMS.push(ND[c].a); } if k != N_IF || ND[c].fl == 1 { return; } SEMS.push(ND[c].b); var e = ND[c].c as int; while e >= 0 { if ND[e].k as int == N_IF && ND[e].fl != 1 { SEMS.push(ND[e].b); e = ND[e].c as int; } else { SEMS.push(e as i32); e = -1; } } }
fn needsemi(b int, c int, tail bool) bool { let k = ND[c].k as int; (b == SEMB || SEMS.contains(b as i32)) && !tail && !is_stmtk(k) && !isguard(c) && k != N_RET && k != N_BREAK && k != N_CONT }
recursive fn fob(b int, d int) { if oneline(b) { fw(": "); finl(b, false); fw("\n"); } else { fw(":\n"); fblk(b, d + 1); } }
recursive fn finl(b int, cl bool) {
	var r i32[>..] = []; let tl = bitems(b, r);
	if r.len == 0 { fw(";"); return; }
	for i in r.len {
		let c = r[i] as int; let last = i == r.len - 1; let ns = last && needsemi(b, c, tl); if last { semprop(b, c); }
		if !last || cl || ns && blockish(c) { fstmt1(c, true); fw(if last { if ns { ";" } else { "" } } else { "; " }); } else { fopen(c, -1); if ns { fw(";"); } }
	}
}
fn chain1(n int) bool { if !oneline(ND[n].b as int) { return false; } let l = TK[ND[n].t].line; var e = ND[n].c as int; while e >= 0 { if ND[e].k as int == N_IF && ND[e].fl != 1 { if !oneline(ND[e].b as int) || TK[ND[e].t].line != l { return false; } e = ND[e].c as int; } else { return oneline(e) && TK[ND[e].t].line == l; } } true }
recursive fn finlif(n int) {
	fw("if "); fscr(ND[n].a as int); fw(": "); finl(ND[n].b as int, ND[n].c >= 0); var e = ND[n].c as int;
	while e >= 0 { if ND[e].k as int == N_IF && ND[e].fl != 1 { fw(" else if "); fscr(ND[e].a as int); fw(": "); finl(ND[e].b as int, ND[e].c >= 0); e = ND[e].c as int; } else { fw(" else: "); finl(e, false); e = -1; } }
}
recursive fn fopen(n int, d int) {
	let x = ND[n]; let k = x.k as int; let il = d < 0;
	if k == N_IF && x.fl != 1 {
		if il || chain1(n) { finlif(n); if !il { fw("\n"); } return; }
		fw("if "); fscr(x.a as int); fob(x.b as int, d); var e = x.c as int;
		while e >= 0 { tabs(d); if ND[e].k as int == N_IF && ND[e].fl != 1 { fw("else if "); fscr(ND[e].a as int); fob(ND[e].b as int, d); e = ND[e].c as int; } else { fw("else"); fob(e, d); e = -1; } }
		return;
	}
	let bb = if k == N_WHILE { x.b as int } else { if k == N_FOR { x.d as int } else { if k == N_LOOP || k == N_EBLOCK { x.a as int } else { if k == N_FN { x.c as int } else { if k == N_CFOR && x.fl == 0 { x.c as int } else { -1 } } } } };
	if k == N_WHILE { fw("while "); fscr(x.a as int); }
	if k == N_FOR { fforh(n); }
	if k == N_LOOP { fw("loop"); }
	if k == N_EBLOCK { fw("block"); }
	if k == N_CFOR && x.fl == 0 { fcfor(n, 0); }
	if k == N_FN { let fl = x.fl as int; if (fl & F_EXTERN) != 0 { ffn(n, -1); if !il { fw("\n"); } return; } if (fl & F_EXPORT) != 0 { let e = x.e as int; fw("export "); if ND[e].a >= 0 { fw(tok_text(ND[e].a as int)); fw(" "); } } fmods(fl); fsig(n); }
	let sv = SEMB; if k == N_FN { SEMB = if x.b < 0 { bb } else { -1 }; }
	if bb >= 0 { if il { fw(": "); finl(bb, false); } else { fob(bb, d); } SEMB = sv; return; }
	if k == N_MATCH { fw("match "); fscr(x.a as int); if il || x.n == 0 { fw(": "); for i in x.n { if i > 0 { fw(", "); } farm(kid(n, i), -1); } if x.n == 0 { fw(";"); } if !il { fw("\n"); } return; } fw(":\n"); for i in x.n { tabs(d + 1); farm(kid(n, i), d + 1); fw("\n"); } return; }
	fstmt1(n, false); if !il { fw("\n"); }
}
recursive fn fblk(b int, d int) {
	var r i32[>..] = []; let tl = bitems(b, r);
	if r.len == 0 { tabs(d); fw(";\n"); return; }
	var i = 0;
	while i < r.len {
		tabs(d); let ln = sline(r[i] as int);
		loop {
			let c = r[i] as int; let last = i == r.len - 1; let jn = !last && sline(r[i + 1] as int) == ln; let ns = last && needsemi(b, c, tl); if last { semprop(b, c); }
			i++;
