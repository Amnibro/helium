}
recursive fn fret(n int) { let x = ND[n]; fw("return"); if x.n > 0 { fw(" "); flist(n); } if x.s >= 0 { fw(" from "); qn(x.s as int); } }
recursive fn fforh(n int) { let x = ND[n]; fw("for "); if (x.fl & 1) != 0 { fw("&"); } qn(x.s as int); var typed = false; if x.l >= 0 { fw(" "); fty(x.l as int); typed = true; } if x.c >= 0 { fw(", "); qn(x.c as int); if x.n >= 0 { fw(" "); fty(x.n as int); typed = true; } } fw(if typed { " in " } else { " " }); let sn = NSLP; NSLP = true; let sf = FOL; FOL = if x.b >= 0 { T_DOTDOT } else { 0 }; fx(x.a as int, 0, true); FOL = 0; if x.b >= 0 { fw(".."); fx(x.b as int, 0, true); } FOL = sf; NSLP = sn; }
recursive fn fslit(n int) { let x = ND[n]; fty(x.a as int); fw("{"); for i in x.n { if i > 0 { fw(", "); } let fi = kid(n, i); if ND[fi].k as int == N_CFOR { fcfor(fi, -1); continue; } if ND[fi].s >= 0 { qn(ND[fi].s as int); fw(": "); } fx(ND[fi].a as int, 0, true); } if (x.fl & 1) != 0 { if x.n > 0 { fw(", "); } fw(".."); } fw("}"); }
recursive fn ffv(n int) { let x = ND[n]; fw("{"); if (x.fl & 1) != 0 { fw(" "); for i in x.n { if i > 0 { fw(", "); } let p = kid(n, i); if (ND[p].fl & 1) != 0 { fw("var "); } qn(ND[p].s as int); if ND[p].a >= 0 { fw(": "); fty(ND[p].a as int); } } fw(" =>"); } fbitems(x.a as int); fw(" }"); }
recursive fn fpat(it int) { let lo = ND[it].a as int; fx(lo, 0, true); if ND[it].b >= 0 { fw(".."); fx(ND[it].b as int, 0, true); } }
recursive fn farm(a int, d int) {
	let x = ND[a];
