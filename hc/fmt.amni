	qn(x.s as int);
	if x.d >= 0 { fw("<"); for i in ND[x.d].n { if i > 0 { fw(", "); } let g = kid(x.d as int, i); qn(ND[g].s as int); if ND[g].a >= 0 { fw(" "); fty(ND[g].a as int); } } fw(">"); }
	fw("("); for i in x.n { if i > 0 { fw(", "); } let p = kid(n, i); if (ND[p].fl & 1) != 0 { fw("var "); } qn(ND[p].s as int); if ND[p].a >= 0 { fw(" "); fty(ND[p].a as int); } if ND[p].b >= 0 { fw(" = "); fx(ND[p].b as int, 0, true); } } fw(")");
	if x.b >= 0 { let r = x.b as int; fw(" "); for i in ND[r].n { if i > 0 { fw(", "); } fty(kid(r, i)); } }
}
recursive fn ffn(n int, d int) {
	let x = ND[n]; let fl = x.fl as int;
	if (fl & F_EXTERN) != 0 { let e = x.e as int; fw("extern "); fmods(fl); fsig(n); if ND[e].a >= 0 { fw(" = "); fw(tok_text(ND[e].a as int)); } if d >= 0 { fw("\n"); } return; }
	if (fl & F_EXPORT) != 0 { let e = x.e as int; fw("export "); if ND[e].a >= 0 { fw(tok_text(ND[e].a as int)); fw(" "); } }
	fmods(fl);
	if d < 0 { fw("fn "); fsig(n); fw(" "); fbrace(x.c as int); return; }
	let sv = SEMB; SEMB = if x.b < 0 { x.c as int } else { -1 }; fsig(n); fob(x.c as int, d); SEMB = sv;
}
recursive fn ffields(n int) { for i in ND[n].n { if i > 0 { fw(", "); } let f = kid(n, i); let fl = ND[f].fl as int; if fl == 4 { fw("pad"); if ND[f].c > 0 { format(FO, " ", ND[f].c); } continue; } if fl == 3 { fw("const "); } if fl == 1 { fw("let "); } qn(ND[f].s as int); fw(" "); fty(ND[f].a as int); if ND[f].b >= 0 { fw(" = "); fx(ND[f].b as int, 0, true); } } }
fn fgens(g int) { if g >= 0 { fw("<"); for i in ND[g].n { if i > 0 { fw(", "); } let q = kid(g, i); qn(ND[q].s as int); if ND[q].a >= 0 { fw(" "); fty(ND[q].a as int); } } fw(">"); } }
fn fnsq(n int) { fnsp(ND[n].a as int, TK[ND[n].t].f as int); }
recursive fn ftop(n int, cl bool) {
	let x = ND[n]; let k = x.k as int;
	if k == N_FN { if (x.fl & F_EXTERN) != 0 && x.e >= 0 && ND[x.e].b >= 0 { fw("extern "); fw(tok_text(ND[x.e].b as int)); fw(" { "); fmods(x.fl as int); fw("fn "); fsig(n); if ND[x.e].a >= 0 { fw(" = "); fw(tok_text(ND[x.e].a as int)); } fw("; }"); if !cl { fw("\n"); } return; } ffn(n, if cl { -1 } else { 0 }); return; }
	if k == N_STRUCT { fw("struct "); fnsq(n); qn(x.s as int); fgens(x.d as int); fw(" { "); ffields(n); fw(" }"); if !cl { fw("\n"); } return; }
	if k == N_ENUM { fw("enum "); fnsq(n); qn(x.s as int); fgens(x.d as int); fw(" { "); for i in x.n { if i > 0 { fw(", "); } let v = kid(n, i); qn(ND[v].s as int); if (ND[v].fl & 1) != 0 { fw(" { "); ffields(v); fw(" }"); } } fw(" }"); if !cl { fw("\n"); } return; }
	if k == N_ALIAS { fw("type "); fnsq(n); qn(x.s as int); fw(" = "); fty(x.b as int); if !cl { fw("\n"); } return; }
	if k == N_IMPORT { fw("use "); if (x.fl & 1) != 0 { fw("."); } for c in nm(x.s as int) { FO.push(if c == '/' { '.' } else { c }); } if x.a >= 0 { fw(" from "); fw(tok_text(x.a as int)); } if !cl { fw("\n"); } return; }
	if k == N_VDECL { fvdecl(n); if !cl { fw("\n"); } return; }
	fw("?top?\n");
}
fn to_he(path const byte[:], out const byte[:]) bool {
	let t0 = TK.len; let n0 = TOP.len; let f = FILES.len;
	KEEPEND = true;
	if !parse_file(path) { print(PERR); return false; }
	FO.clear();
	let src = SRC[(FILES[f].s as int)..((FILES[f].s + FILES[f].n) as int)];
	var i = 0;
	while i < src.len && src[i] == '/' && i + 1 < src.len && src[i + 1] == '/' { var e = i; while e < src.len && src[e] != '\n' { e++; } fw("#"); fw(src[(i + 2)..e]); fw("\n"); i = e + 1; while i < src.len && (src[i] == '\n' || src[i] == ' ' || src[i] == '\t' || src[i] == '\r') { i++; } }
	if FILENS[FILENS.len - 1] >= 0 { fw("namespace "); qn(FILENS[FILENS.len - 1] as int); fw("\n"); }
	for j in n0..TOP.len { let c = TOP[j] as int; let jn = j + 1 < TOP.len && TK[ND[TOP[j + 1]].t].line == TK[ND[c].t].line; ftop(c, jn); if jn { fw("; "); } }
	write_file(out, FO[..])
}
