}
fn fmods(fl int) { if (fl & F_LUT) != 0 { fw("lut "); } if (fl & F_CHECKFREE) != 0 { fw("checkfree "); } if (fl & F_SIMD) != 0 { fw("simd "); } if (fl & F_INLINE) != 0 { fw("inline "); } if (fl & F_REC) != 0 { fw("recursive "); } if (fl & F_THREAD) != 0 { fw("thread_fn "); } }
recursive fn fsig(n int) {
