	let c = x.c as int;
	if m == 1 { fw(" {"); for i in ND[c].n { if i > 0 { fw(","); } fw(" "); let fi = kid(c, i); if ND[fi].k as int == N_CFOR { fcfor(fi, -1); continue; } if ND[fi].s >= 0 { qn(ND[fi].s as int); fw(": "); } fx(ND[fi].a as int, 0, true); } fw(", }"); return; }
	if m == 2 { fw(" { "); for i in ND[c].n { if i > 0 { fw(", "); } farm(kid(c, i), -1); } fw(", }"); return; }
	if d < 0 { fw(" "); fbrace(c); return; }
}
fn fnsp(a int, f int) { let fns = FILENS[f] as int; if a != fns { if a >= 0 { qn(a); } fw("::"); } }
fn vflags(fl int) const byte[:] { if (fl & V_REUSE) != 0 { return if (fl & V_REUSE_SL) != 0 { "reusable[] " } else { "reusable " }; } "" }
recursive fn fvdecl(n int) {
	let x = ND[n]; let fl = x.fl as int; let kw = (fl & V_CONST) != 0 || (fl & V_BYREF) != 0 || (fl & V_REUSE) != 0 || x.b < 0;
	fw(vflags(fl));
