use parse
TY_ERR := 0; TY_VOID := 1; TY_BOOL := 2; TY_INT := 3; TY_FLT := 4; TY_STRUCT := 5; TY_ENUM := 6; TY_VARIANT := 7; TY_ARR := 8; TY_SLICE := 9; TY_REF := 10
TY_NULL := 11; TY_ILIT := 12; TY_FLIT := 13; TY_MULTI := 14; TY_FNV := 15; TY_TP := 16; TY_VARINT := 17; TY_STRLIT := 18; TY_ARRLIT := 19
RF_CONST := 1; RF_OPT := 2
CL_FIXED := 0; CL_VAR := 1; CL_RES := 2
struct Ty { k u8, s u8, fl u16, a i32, c i32, l i32, n i32, b i64 }
struct SI { node i32, ta i32, tn i32, f0 i32, fnum i32, cls u8, done u8, flat bool, zero bool, size i64, name i32 }
struct FI { name i32, ty i32, def i32, fl u16, padn i32, off i64 }
struct EI { node i32, ta i32, tn i32, v0 i32, vnum i32, cls u8, done u8, tagsz u8, flat bool, size i64, name i32 }
struct VI { name i32, f0 i32, fnum i32, si i32, size i64, haspay bool }
var TY Ty[>..]
var TYL i32[>..]
var TYH i32[>..]
var STI SI[>..]
var SFI FI[>..]
var ENI EI[>..]
var ENV VI[>..]
var T_VOID int; var T_BOOL int; var T_I8 int; var T_I16 int; var T_I32 int; var T_I64 int; var T_U8 int; var T_U16 int; var T_U32 int; var T_U64 int; var T_F32 int; var T_F64 int
var T_NULL int; var T_ILIT int; var T_FLIT int; var T_STRLIT int; var T_VARINT int; var T_ERRT int; var TT_STR int; var T_ARRLIT int; var T_FNV int
th(t Ty) u64:
	h ~= hash_mix(t.k | (t.s as u64) << 8 | (t.fl as u64) << 16 | (t.a as! u64) << 32); h = hash_mix(h ^ t.c as! u64 ^ (t.b as! u64) << 20); for i t.n { h = hash_mix(h ^ TYL[t.l as int + i] as! u64) } h
teq(x Ty, y Ty) bool:
	if x.k != y.k || x.s != y.s || x.fl != y.fl || x.a != y.a || x.c != y.c || x.b != y.b || x.n != y.n: return false
	for i x.n:
		if TYL[x.l as int + i] != TYL[y.l as int + i]: return false
	true
tmk(t Ty) int:
	if TYH.len == 0: TYH.resize(1 << 14, -1)
	if TY.len * 2 >= TYH.len:
		n := TYH.len * 2; TYH.clear(); TYH.resize(n, -1)
		for x, i TY: j ~= (th(x) as int) & n - 1; while TYH[j] >= 0 { j = j + 1 & n - 1 } TYH[j] = i
	m := TYH.len - 1
	j ~= (th(t) as int) & m
	while TYH[j] >= 0: if teq(TY[TYH[j]], t) { return TYH[j] } j = j + 1 & m
	TY.push(t); TYH[j] = TY.len - 1
	TY.len - 1
tsimple(k int, s int) int:
	tmk(Ty{k: k, s: s, a: -1, c: -1, ..})
tlist(k int, xs i32[:], a int) int:
	l := TYL.len; TYL.append(xs); tmk(Ty{k: k, a: a, c: -1, l: l, n: xs.len, ..})
t_int(s int) int:
	tsimple(TY_INT, s)
t_arr(e int, ak int, size i64, ls int) int:
	tmk(Ty{k: TY_ARR as u8, s: ak, a: e, c: ls, b: size, ..})
t_slice(e int, cq bool) int:
	tmk(Ty{k: TY_SLICE as u8, a: e, c: -1, ..})
t_ref(e int, fl int) int:
	if e >= 0 && TY[e].k == TY_REF && TY[e].c < 0: return if fl & RF_OPT != 0 && TY[e].fl & RF_OPT == 0 { t_ref(TY[e].a as int, RF_OPT) } else { e }
	tmk(Ty{k: TY_REF as u8, fl: fl & RF_OPT, a: e, c: -1, ..})
t_rel(e int, fl int, w int, pool int) int:
	tmk(Ty{k: TY_REF as u8, fl: fl, a: e, c: w, b: pool, ..})
t_struct(si int) int:
	tmk(Ty{k: TY_STRUCT as u8, a: si, c: -1, ..})
t_enum(ei int, vm bool) int:
	tmk(Ty{k: TY_ENUM as u8, fl: if vm { 1 } else { 0 }, a: ei, c: -1, ..})
t_variant(ei int, vi int) int:
	tmk(Ty{k: TY_VARIANT as u8, a: ei, c: vi, ..})
t_tp(name int) int:
	tmk(Ty{k: TY_TP as u8, a: name as i32, c: -1, ..})
types_init():
	if TY.len > 0: return
	T_ERRT = tsimple(TY_ERR, 0); T_VOID = tsimple(TY_VOID, 0); T_BOOL = tsimple(TY_BOOL, 0)
	T_I8 = t_int(0); T_I16 = t_int(1); T_I32 = t_int(2); T_I64 = t_int(3); T_U8 = t_int(4); T_U16 = t_int(5); T_U32 = t_int(6); T_U64 = t_int(7)
	T_F32 = tsimple(TY_FLT, 4); T_F64 = tsimple(TY_FLT, 8)
	T_NULL = tsimple(TY_NULL, 0); T_ILIT = tsimple(TY_ILIT, 0); T_FLIT = tsimple(TY_FLIT, 0); T_STRLIT = tsimple(TY_STRLIT, 0); T_VARINT = tsimple(TY_VARINT, 0); T_ARRLIT = tsimple(TY_ARRLIT, 0); T_FNV = tsimple(TY_FNV, 0)
	TT_STR = t_slice(T_U8, true)
tk_(t int) int:
	TY[t].k as int
is_int(t int) bool:
	TY[t].k == TY_INT
is_num(t int) bool:
	k := TY[t].k; k == TY_INT || k == TY_FLT
is_signed(t int) bool:
	TY[t].s < 4
ibits(t int) int:
	8 << (TY[t].s & 3) as int
is_arr(t int) bool:
	TY[t].k == TY_ARR
akind(t int) int:
	TY[t].s as int
elem(t int) int:
	TY[t].a as int
is_ref(t int) bool:
	TY[t].k == TY_REF
is_opt(t int) bool:
	TY[t].k == TY_REF && TY[t].fl & RF_OPT != 0
deref(t int) int:
	if TY[t].k == TY_REF && TY[t].c < 0:
		TY[t].a as int
	else:
		t
is_byte_arr(t int) bool:
	k u8 := TY[t].k; (k == TY_ARR || k == TY_SLICE) && TY[t].a == T_U8
int_storage_of_tok(k int) int:
	if k == K_I8 { return 0 } if k == K_I16 { return 1 } if k == K_I32 { return 2 } if k == K_I64 || k == K_INT: return 3
	if k == K_U8 || k == K_BYTE { return 4 } if k == K_U16 { return 5 } if k == K_U32 { return 6 } if k == K_U64 || k == K_UINT: return 7
	-1
prim_type(k int) int:
	if k == K_BOOL { return T_BOOL } if k == K_VARINT { return T_VARINT } if k == K_F32 { return T_F32 } if k == K_F64 || k == K_REAL: return T_F64
	s := int_storage_of_tok(k)
	if s >= 0:
		t_int(s)
	else:
		T_ERRT
int_min(t int) i64:
	if !is_signed(t) { return 0 } b := ibits(t); if b == 64:
		-9223372036854775807 - 1
	else:
		-(1 << b - 1)
int_max_u(t int) u64:
	b := ibits(t); sg := is_signed(t); if b == 64:
		if sg:
			9223372036854775807
		else:
			18446744073709551615
	else:
		if sg:
			(1 << b - 1) - 1
		else:
			(1 << b) - 1
lim_lenstore(cap i64) int:
	if cap < 256:
		4
	else:
		if cap < 65536:
			5
		else:
			if cap < 4294967296:
				6
			else:
				7
recursive tclass(t int) int:
	x := TY[t]
	k := x.k as int
	if k == TY_STRUCT: si_layout(x.a as int); return STI[x.a].cls as int
	if k == TY_VARIANT: ei_layout(x.a as int); v := ENV[ENI[x.a].v0 as int + x.c as int]; if v.si >= 0 { si_layout(v.si as int); return STI[v.si].cls as int } return CL_FIXED
	if k == TY_ENUM: ei_layout(x.a as int); if x.fl & 1 == 0 { return CL_FIXED } return CL_VAR
	if k == TY_ARR: a := x.s as int; if a == A_GROW || a == A_GS { return CL_RES } if a == A_VAR { return CL_VAR } if a == A_LIM && x.b < 0 { return CL_VAR } ec := tclass(x.a as int); return if ec > CL_FIXED { CL_VAR } else { CL_FIXED }
	if k == TY_VARINT || k == TY_REF && x.c == 8: return CL_VAR
	CL_FIXED
is_fixed(t int) bool:
	tclass(t) == CL_FIXED
is_bytes(t int) bool:
	tclass(t) == CL_VAR && TY[t].k != TY_VARINT && TY[t].k != TY_REF
isz(s int) i64:
	1 << (s & 3) as i64
pad_align(t int) i64:
	x := TY[t]; k := x.k
	if k == TY_INT: return isz(x.s)
	if k == TY_FLT: return x.s
	if k == TY_REF: if x.c >= 0 { return if x.c == 8 { 1 } else { isz(x.c) } } return 8
	if k == TY_SLICE: return 8
	1
recursive tsize(t int) i64:
	x := TY[t]
	k := x.k as int
	if k == TY_BOOL: return 1
	if k == TY_INT: return isz(x.s as int)
	if k == TY_FLT: return x.s as i64
	if k == TY_REF: if x.c >= 0 { return isz(x.c as int) } return 8
	if k == TY_SLICE: return 16
	if k == TY_STRUCT: si_layout(x.a as int); return STI[x.a].size
	if k == TY_VARIANT: ei_layout(x.a as int); v := ENV[ENI[x.a].v0 as int + x.c as int]; if v.si < 0 { return 0 } si_layout(v.si as int); return if STI[v.si].zero { 0 } else { STI[v.si].size }
	if k == TY_ENUM: ei_layout(x.a as int); return ENI[x.a].size
	if k == TY_ARR:
		a := x.s as int; if a == A_FIXED { return max(x.b, 1) * tsize(x.a as int) } if a == A_LIM: return isz(x.c as int) + max(x.b, 1) * tsize(x.a as int)
	0
recursive tflat(t int) bool:
	x := TY[t]; k := x.k
	if k == TY_REF || k == TY_SLICE: return false
	if k == TY_STRUCT: si_layout(x.a); return STI[x.a].flat
	if k == TY_ENUM || k == TY_VARIANT: ei_layout(x.a); return ENI[x.a].flat
	if k == TY_ARR: return tflat(x.a)
	true
var LAYOUT_HOOK int
recursive si_layout(si int):
	if STI[si].done != 0: return
	STI[si].done = 1
	off i64 ~= 0; cls ~= CL_FIXED; flat ~= true
	f0 := STI[si].f0; fnum := STI[si].fnum
	for i fnum:
		fi := f0 + i
		ft := SFI[fi].ty
		if ft >= 0:
			c := tclass(ft)
			if c > cls: cls = c
			if !tflat(ft): flat = false
	cur_var ~= false
	for i fnum:
		fi := f0 + i
		ft := SFI[fi].ty
		if ft < 0:
			if SFI[fi].padn < 0:
				if cls == CL_FIXED:
					a i64 ~= 1
					for j i + 1..fnum:
						if SFI[f0 + j].ty >= 0: a = pad_align(SFI[f0 + j].ty); break
					next_off := (off + a - 1) / a * a
					SFI[fi].padn = next_off - off
					SFI[fi].off = off
					off = next_off
				else:
					SFI[fi].padn = 0
					SFI[fi].off = -1
			else:
				SFI[fi].off = if !cur_var { off } else { -1 }
				if !cur_var: off += SFI[fi].padn
			continue
		c := tclass(ft)
		if c != CL_FIXED: cur_var = true
		SFI[fi].off = if !cur_var { off } else { -1 }
		if !cur_var: off += tsize(ft)
	STI[si].cls = cls; STI[si].flat = flat
	STI[si].size = if cls == CL_FIXED { max(off, 1) } else { off }
	STI[si].zero = cls == CL_FIXED && off == 0
	STI[si].done = 2
recursive ei_layout(ei int):
	if ENI[ei].done != 0: return
	ENI[ei].done = 1
	nv := ENI[ei].vnum
	tz := if nv <= 256 { 1 } else { 2 }
	ENI[ei].tagsz = tz
	mx i64 ~= 0; cls ~= CL_FIXED; flat ~= true
	for i nv:
		v := ENI[ei].v0 + i
		if ENV[v].si >= 0:
			si := ENV[v].si
			si_layout(si)
			if STI[si].cls > cls: cls = STI[si].cls
			if !STI[si].flat: flat = false
			ps := if STI[si].zero { 0 } else { STI[si].size }
			ENV[v].size = ps
			if ps > mx: mx = ps
	ENI[ei].cls = cls; ENI[ei].flat = flat
	ENI[ei].size = tz as i64 + mx
	ENI[ei].done = 2
sfield(si int, name int) int:
	for i STI[si].fnum { if SFI[STI[si].f0 as int + i].name == name { return i } } -1
ls_kind_name(s int, out byte[>..]&): names := ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"]; out.append(names[s & 7]);
recursive ty_name_into(t int, out byte[>..]&):
	x := TY[t]
	k := x.k as int
	if k == TY_ERR: out.append("<error>"); return
	if k == TY_VOID: out.append("void"); return
	if k == TY_BOOL: out.append("bool"); return
	if k == TY_INT: ls_kind_name(x.s as int, out); return
	if k == TY_FLT: out.append(if x.s == 4 { "f32" } else { "f64" }); return
	if k == TY_VARINT: out.append("varint"); return
	if k == TY_NULL: out.append("null"); return
	if k == TY_ILIT: out.append("integer constant"); return
	if k == TY_FLIT: out.append("float constant"); return
	if k == TY_STRLIT: out.append("const u8[:]"); return
	if k == TY_TP: out.append(nm(x.a as int)); return
	if k == TY_STRUCT: out.append(nm(STI[x.a].name as int)); targs_into(STI[x.a].ta as int, STI[x.a].tn as int, out); return
	if k == TY_ENUM: out.append(nm(ENI[x.a].name as int)); targs_into(ENI[x.a].ta as int, ENI[x.a].tn as int, out); if x.fl & 1 != 0 { out.append("..") } return
	if k == TY_VARIANT: out.append(nm(ENI[x.a].name as int)); targs_into(ENI[x.a].ta as int, ENI[x.a].tn as int, out); out.push('.'); out.append(nm(ENV[ENI[x.a].v0 as int + x.c as int].name as int)); return
	if k == TY_SLICE: if x.fl & 1 != 0 { out.append("const ") } ty_name_into(x.a as int, out); out.append("[:]"); return
	if k == TY_REF:
		if x.fl & 1 != 0: out.append("const ")
		ty_name_into(x.a as int, out)
		if x.c >= 0: out.append("&<"); if x.c == 8 { out.append("varint"); } else { ls_kind_name(x.c as int, out); } out.push('>'); if x.fl & 2 != 0 { out.push('?') } return
		out.append(if x.fl & 2 != 0 { "?" } else { "&" }); return
	if k == TY_ARR:
		ty_name_into(x.a as int, out)
		a := x.s as int
		if a == A_FIXED: format(out, "[", x.b, "]")
		if a == A_VAR:
			out.append(if x.c >= 0 && x.c != 6 { "[" } else { "[]" }); if x.c >= 0 && x.c != 6: if x.c == 8 { out.append("varint"); } else { ls_kind_name(x.c as int, out); } out.push(']')
		if a == A_LIM:
			if x.b >= 0: format(out, "[..", x.b, "]") else: out.append("[..]")
		if a == A_GROW: out.append("[>..]")
		if a == A_GS: out.append("[>..<]")
		return
	if k == TY_MULTI: for i x.n { if i > 0 { out.append(", ") } ty_name_into(TYL[x.l as int + i] as int, out) } return
	out.append("fn");
recursive targs_into(l int, n int, out byte[>..]&): if n == 0 { return } out.push('<'); for i n { if i > 0 { out.append(", ") } ty_name_into(TYL[l + i], out) } out.push('>');
ty_name(t int) byte[>..]:
	s byte[>..] ~= []; ty_name_into(t, s); s
