use check
use pkg
B_PRINT := 1; B_STR := 2; B_FORMAT := 3; B_ASSERT := 4; B_ABORT := 5; B_EXIT := 6; B_COPY := 7; B_DEFAULT := 8; B_LEN := 9
B_PUSH := 20; B_APPEND := 21; B_POP := 22; B_POPN := 23; B_RESIZE := 24; B_CLEAR := 25; B_INDEXOF := 26; B_CAP := 27
B_TOBYTES := 30; B_BYTESOF := 31; B_FROMBYTES := 32; B_EMBED := 33; B_EMBEDSH := 48
B_SPAWN := 40; B_SPAWNC := 41; B_TWAIT := 42; B_HWT := 43; B_QPUT := 44; B_QGET := 45; B_QPOLL := 46; B_QLIMIT := 47
B_ALLOCI := 34; B_ALLOCR := 35; B_FREE := 36; B_ALLOCS := 37; B_FREES := 38; B_REALLOCS := 39
struct NF { name i32, node i32, inst i32, own i32 }
var NESTS NF[>..<]
var CANDS i32[>..<]
var BINDS Gb[>..<]
var DSPL i32[>..<]
var TSP i32[>..<]
var FNA i8[>..<]
fna(n int) int:
	if n < FNA.len:
		FNA[n] as int
	else:
		0
struct XBe { inst i32, g i32, p i32 }
var XB XBe[>..<]; var XBS i32[>..<]
xb_same(i int, xb const i32[:]) bool:
	c ~= 0; for e XB { if e.inst == i { if c + 3 > xb.len || e.g != xb[c] || FI_[e.p].blk != xb[c + 1] || FI_[e.p].bown != xb[c + 2] { return false } c += 3 } } c == xb.len
var RANKS i32[>..<]
var DIDX i32[>..<]
builtin_of(name const byte[:]) int:
	if name == "print" { return B_PRINT } if name == "str" { return B_STR } if name == "format" { return B_FORMAT } if name == "assert": return B_ASSERT
	if name == "abort" { return B_ABORT } if name == "exit" { return B_EXIT } if name == "copy" { return B_COPY } if name == "default": return B_DEFAULT
	if name == "to_bytes" { return B_TOBYTES } if name == "bytes_of" { return B_BYTESOF } if name == "from_bytes" { return B_FROMBYTES } if name == "embed_file" { return B_EMBED } if name == "embed_shader": return B_EMBEDSH
	if name == "len": return B_LEN
	if name == "thread_spawn" { return B_SPAWN } if name == "thread_spawn_contained" { return B_SPAWNC } if name == "thread_wait" { return B_TWAIT } if name == "hardware_threads": return B_HWT
	if name == "qput" { return B_QPUT } if name == "qget" { return B_QGET } if name == "qpoll" { return B_QPOLL } if name == "qlimit": return B_QLIMIT
	-1
member_of(name const byte[:]) int:
	if name == "push" { return B_PUSH } if name == "append" { return B_APPEND } if name == "pop" { return B_POP } if name == "pop_n": return B_POPN
	if name == "resize" { return B_RESIZE } if name == "clear" { return B_CLEAR } if name == "index_of" { return B_INDEXOF } if name == "len": return B_LEN
	if name == "alloc_index" { return B_ALLOCI } if name == "alloc_ref" { return B_ALLOCR } if name == "free": return B_FREE
	if name == "alloc_slice" { return B_ALLOCS } if name == "free_slice" { return B_FREES } if name == "realloc_slice": return B_REALLOCS
	-1
var FREEM bool
user_fn_n(name int, k int) bool:
	d ~= dmap(name); while d >= 0 { if DC[d].k as int == D_FN && !is_std_node(DC[d].node) && ND[DC[d].node].n == k { return true } d = DC[d].next } false
has_fn(name int) bool:
	d ~= dmap(name); while d >= 0 { if DC[d].k as int == D_FN { return true } d = DC[d].next } false
nscore(q int, at int) i64:
	o := NESTS[q].own; x ~= AOWN; dp i64 ~= 0; rp i64 ~= if at >= 0 { ND[at].t as i64 } else { 1 << 38 }
	while x >= 0 && x != o: rp = ND[FI_[x].node].t as i64; dp++; x = FI_[x].par as int
	t := ND[NESTS[q].node].t as i64
	dp << 40 | (if t <= rp { rp - t } else { (1 << 39) + t - rp })
find_nest(name int, at int) int:
	b ~= -1; bs i64 ~= 0; for q, i NESTS { if q.name == name && visible(q.own) { sc := nscore(i, at); if b < 0 || sc < bs { b = i; bs = sc } } } b
recursive decl_nested(n int):
	if ND[n].d >= 0: ngen_decl(n); return
	i ~= -1
	for f NESTS:
		if f.node == n && f.own == AOWN: i = f.inst
	if i < 0: i = new_inst(n, n, NEND[n], AOWN); NESTS.push(NF{ND[n].s, n, i, AOWN}); sig_inst(i)
	e0 := CERR.len; ne := NERR; f0 := FI_.len; c0 := CALL.len; check_inst(i)
	if NERR > ne && e0 == 0:
		m byte[>..] ~= []; m.append(CERR[..]); CERR.clear(); CALL.resize(c0); NERR = ne; mi := intern(m[..]); DEFE.push(i); DEFM.push(mi); for j f0..FI_.len: DEFE.push(j); DEFM.push(mi)
var DEFE i32[>..<]; var DEFM i32[>..<]
defer_err(i int):
	for e, k DEFE:
		if e == i:
			NERR++; if LSPM { CALL.append(nm(DEFM[k])); CALL.push('\n') } if CERR.len == 0: CERR.append(nm(DEFM[k]))
var NGD i32[>..<]; var NGO i32[>..<]
ngen_decl(c int): for k NGD.len { if DC[NGD[k]].node == c && NGO[k] == AOWN { return } } dadd(D_FN, c, node_file(c), ND[c].s); NGD.push(DC.len - 1); NGO.push(AOWN);
ngok(d int) bool:
	for k NGD.len { if NGD[k] == d { return visible(NGO[k]) } } true
recursive pre_decl_block_fns(b int) int:
	m := NESTS.len
	for q ND[b].n:
		c := kid(b, q); if ND[c].k as int == N_FN && ND[c].d >= 0 { ngen_decl(c); continue } if ND[c].k as int == N_FN: i := new_inst(c, c, NEND[c], AOWN); NESTS.push(NF{ND[c].s, c, i, AOWN}); sig_inst(i)
	m
pop_block_fns(m int):
	if NESTS.len > m: NESTS.pop_n(NESTS.len - m);
propagate_calls():
	changed ~= true
	while changed:
		changed = false
		for e CEDGES:
			cr := e.caller; ce := e.callee
			if FI_[ce].lr && !FI_[cr].lr: FI_[cr].lr = true; changed = true
			for c CAPS:
				if c.inst == ce:
					v := c.lv; if visible_in(LVS[v].own, cr) || LVS[v].cfn != cr:
						if add_cap_one(cr, v): changed = true
gen_list(fnode int) int:
	ND[fnode].d as int
is_blockparam(fnode int, gname int) bool:
	for i ND[fnode].n:
		p := kid(fnode, i); if ND[p].a >= 0 && mentions(ND[p].a, gname): return false
	true
recursive mentions(t int, g int) bool:
	if t < 0: return false
	x := ND[t]; k := x.k
	if k == N_TNAME: if x.s == g { return true } for i x.n { if mentions(kid(t, i), g) { return true } } return false
	if k == N_TARR || k == N_TSLICE || k == N_TREF || k == N_TCONST || k == N_TVAR: return mentions(x.a, g)
	false
blk_gen(fnode int) int:
	gl := gen_list(fnode); if gl < 0 { return -1 } r ~= -1; for i ND[gl].n { g := ND[kid(gl, i)].s; if is_blockparam(fnode, g) { r = g } } r
xcall(fnode int, ntya int, k int) int:
	gl := gen_list(fnode); if gl < 0 { return -1 } bg := blk_gen(fnode); c ~= 0; for i ND[gl].n { g := ND[kid(gl, i)].s; if i >= ntya && g != bg && is_blockparam(fnode, g) { if c == k { return g } c += 1 } } -1
bref(q int) int:
	a := ARGW[q]; if is_pending(a) || TY[a].k == TY_REF { return a } dv := deref_val(a); k := ND[DIDX[q]].k; if TY[dv].k != TY_SLICE && !is_fixed(dv) && (k == N_ID || k == N_DOT || k == N_IDX):
		t_ref(dv, 0)
	else:
		a
upname(p int) int:
	s byte[>..] ~= []; s.push('$'); s.append(nm(ND[p].s)); intern(s)
MEX ~= false
recursive mty_ex(tn int, t int, g0 int): sv := MEX; MEX = true; match_ty(tn, t, g0); MEX = sv
recursive match_ty(tn0 int, t0 int, g0 int) bool:
	if tn0 < 0: return true
	x := ND[tn0]; k := x.k
	t := deref(t0)
	if k == N_TNAME:
		if x.n == 0:
			for i g0..BINDS.len:
				if BINDS[i].name == x.s: if BINDS[i].ty < 0 { BINDS[i].ty = (if MEX || AMPA && TY[t0].k == TY_REF { t0 } else { deref_val(t) }) } return true
			return true
		if TY[t].k == TY_STRUCT:
			si := TY[t].a; if STI[si].tn == x.n:
				for i x.n: mty_ex(kid(tn0, i), TYL[STI[si].ta as int + i], g0)
		if TY[t].k == TY_ENUM || TY[t].k == TY_VARIANT:
			ei := TY[t].a; if ENI[ei].tn == x.n:
				for i x.n: mty_ex(kid(tn0, i), TYL[ENI[ei].ta as int + i], g0)
		return true
	if k == N_TARR || k == N_TSLICE: if TY[t].k == TY_ARR || TY[t].k == TY_SLICE { et := TY[t].a; en := ND[x.a]; if en.k as int == N_TNAME && en.n == 0 && TY[et].k == TY_REF { for i g0..BINDS.len { if BINDS[i].name == en.s { if BINDS[i].ty < 0 { BINDS[i].ty = et } return true } } } return match_ty(x.a, et, g0) } if TY[t].k == TY_STRLIT { return match_ty(x.a, T_U8, g0) } return true
	if k == N_TREF: if TY[t0].k == TY_REF { return match_ty(x.a, TY[t0].a, g0) } return match_ty(x.a, t, g0)
	if k == N_TCONST: return match_ty(x.a, t0, g0)
	if k == N_TVAR && TY[t].k == TY_VARIANT: return match_ty(x.a, t_enum(TY[t].a as int, false), g0)
	true
recursive arg_rank(n int, a int, p int) int:
	if p < 0: return 1
	if a == p: return 0
	ak := TY[a].k; pk := TY[p].k
	if ak == TY_SLICE && pk == TY_SLICE && TY[a].a == TY[p].a: return 0
	if ak == TY_MULTI && pk != TY_MULTI && TY[a].n > 0 && ND[n].k as int == N_CALL: return arg_rank(n, TYL[TY[a].l] as int, p)
	if pk == TY_ERR || ak == TY_ERR: return 0
	if pk == TY_REF && TY[p].c < 0 && TY[p].fl & RF_OPT == 0: tgt := TY[p].a; if deref(a) == tgt { return 0 } if TY[tgt].k == TY_ENUM && ak == TY_VARIANT && TY[a].a == TY[tgt].a { return 1 } if ak == TY_ILIT || ak == TY_FLIT { r := arg_rank(n, a, tgt); return if r >= 0 { r + 1 } else { r } } return -1
	if ak == TY_REF && TY[a].c < 0: d := TY[a].a; if d == p { return 0 } if pk == TY_REF && TY[p].fl & RF_OPT != 0 && TY[p].a == TY[a].a { return 0 } return arg_rank(n, d, p)
	if ak == TY_ILIT:
		v, u, ok := cval(n)
		if pk == TY_INT: if !ok || int_fits(v, u, p) || bn_ad(n) && !is_signed(p) { return if p == T_I64 { 1 } else { 2 } } return -1
		if pk == TY_FLT: return 3
		if pk == TY_VARINT: return 2
		return -1
	if ak == TY_FLIT: if pk == TY_FLT { return if TY[p].s == 8 { 1 } else { 2 } } return -1
	if ak == TY_STRLIT: if pk == TY_SLICE && TY[p].a == T_U8 { return 0 } if is_byte_arr(p) { return 2 } return -1
	if ak == TY_ARRLIT && ND[n].k as int != N_ARR: x := ND[n]; nk := x.k; w ~= 0; if nk == N_IF { for b [x.b, x.c] { if b >= 0 && !ends(b) { r := arg_rank(b, at(b), p); if r < 0 { return -1 } w = max(w, r) } } return w } if nk == N_MATCH { for i x.n { b := ND[kid(n, i)].b; if b >= 0 && !ends(b) { r := arg_rank(b, at(b), p); if r < 0 { return -1 } w = max(w, r) } } return w } if (nk == N_BLOCK || nk == N_EBLOCK) && x.a >= 0 { return arg_rank(x.a, at(x.a), p) } return -1
	if ak == TY_ARRLIT: if pk != TY_ARR && pk != TY_SLICE { return -1 } x := ND[n]; if x.c >= 0 { return 2 } if x.a >= 0 { return if arg_rank(x.a, at(x.a), TY[p].a) < 0 { -1 } else { 2 } } w ~= 1; for i x.n { r := arg_rank(kid(n, i), at(kid(n, i)), TY[p].a); if r < 0 { return -1 } if r > 1 { w = 2 } } return if x.n > 0 && pk == TY_ARR && TY[p].s as int == A_FIXED && TY[p].b == x.n { w } else { 2 }
	if ak == TY_NULL: if pk == TY_REF && TY[p].fl & RF_OPT != 0 { return 0 } return -1
	if pk == TY_REF && TY[p].fl & RF_OPT != 0 && TY[p].a == a: return 0
	if (ak == TY_INT || ak == TY_VARINT) && pk == TY_FLT: return 3
	if pk == TY_ARR && TY[p].s as int == A_LIM && (ak == TY_ARR || ak == TY_SLICE) && TY[a].a == TY[p].a && conv_ok(a, p, n): return 2
	if widens(a, p): return 2
	if pk == TY_SLICE && (ak == TY_ARR || ak == TY_SLICE) && TY[a].a == TY[p].a: return 2
	if pk == TY_ENUM && ak == TY_VARIANT && TY[a].a == TY[p].a: return 2
	if pk == TY_ENUM && ak == TY_ENUM && TY[a].a == TY[p].a: return 2
	if pk == TY_ARR && (ak == TY_ARR || ak == TY_SLICE) && TY[a].a == TY[p].a && is_construct(n): return 2
	-1
recursive sig_inst(i int):
	node := FI_[i].node
	ns := decl_ns(node)
	g0 := GB.len
	for j FI_[i].gn: GB.push(GBS[FI_[i].g0 as int + j])
	p0 := TYL.len
	pts i32[..128] ~= []
	for j ND[node].n:
		p := kid(node, j)
		t ~= -1
		if ND[p].a >= 0: t = decode_rel(rtype(ND[p].a, ns))
		else:
			t = gb_find(upname(p)); if t < 0: t = T_ERRT
		pts.push(t)
	FI_[i].p0 = TYL.len; TYL.append(pts[..]); FI_[i].pn = pts.len
	if ND[node].b >= 0:
		rl := ND[node].b
		if ND[rl].n == 1: FI_[i].ret = decode_rel(rtype(kid(rl, 0), ns))
		else: rs i32[..64] ~= []; for j ND[rl].n { r0 := rtype(kid(rl, j), ns); rs.push(r0) } FI_[i].ret = tlist(TY_MULTI, rs[..], -1)
	else:
		FI_[i].ret = -1; FI_[i].rinf = true; if ND[node].fl & F_EXTERN != 0 || surely_void(node): FI_[i].ret = T_VOID; FI_[i].rinf = false
	GB.pop_n(GB.len - g0);
surely_void(fnode int) bool:
	body := ND[fnode].c
	if body < 0: return true
	tl := ND[body].a
	tail_void(tl) && !has_valret(body)
recursive tail_void(tl int) bool:
	if tl < 0: return true
	x := ND[tl]; k := x.k
	if k == N_WHILE || k == N_FOR || k == N_RET || k == N_BREAK || k == N_CONT: return true
	if k == N_IF: return x.c < 0 || tail_void(x.b) && tail_void(x.c)
	if k == N_BLOCK: return tail_void(x.a)
	false
recursive has_valret(n int) bool:
	if n < 0: return false
	x := ND[n]; k := x.k
	if k == N_RET: return x.n > 0 && x.s < 0
	if k == N_FN || k == N_CFOR: return k == N_CFOR && has_valret(x.c)
	if k == N_INT || k == N_FLT || k == N_STR || k == N_ID: return false
	if k >= 40 && k < 50: return false
	if has_valret(x.a) || has_valret(x.b) || has_valret(x.c) || has_valret(x.d): return true
	if k == N_BLOCK || k == N_CALL || k == N_MATCH || k == N_ARM || k == N_LIST || k == N_ARR || k == N_SLIT || k == N_RET:
		for i x.n:
			if has_valret(kid(n, i)): return true
	false
ptype_of(i int, j int) int:
	TYL[FI_[i].p0 + j] as int
recursive rets_to(node int, f int, inner bool) bool:
	j ~= node + 1; e := NEND[node]
	while j < e { x := ND[j]; k := x.k; if k == N_FN { if rets_to(j, f, true) { return true } j = NEND[j]; continue } if k == N_RET && (x.s == f || x.s < 0 && !inner) { return true } j += 1 } false
recursive check_inst(i int): sv := NSOV; NSOV = -1; check_inst0(i); NSOV = sv
recursive check_inst0(i int):
	if FI_[i].st != 0: return
	node := FI_[i].node
	FI_[i].st = 1
	if ND[node].fl & F_EXTERN != 0: sa0 := AOWN; sc0 := CFN; AOWN = i; CFN = i; for j ND[node].n { p := kid(node, j); if ND[p].b >= 0 { pt := ptype_of(i, j); NSOV = decl_ns(node); ck(ND[p].b, pt); NSOV = -1; conv(ND[p].b, pt) } } AOWN = sa0; CFN = sc0; FI_[i].st = 2; return
	sa := AOWN; sc := CFN; sm := SCOPE.len; ld := LOOPD; bt := BRK_T.len; nm0 := NESTS.len
	AOWN = i; CFN = i; LOOPD = 0
	g0 := GB.len
	for j FI_[i].gn: GB.push(GBS[FI_[i].g0 as int + j])
	for j ND[node].n:
		p := kid(node, j); if ND[p].b >= 0: pt := ptype_of(i, j); NSOV = decl_ns(node); ck(ND[p].b, pt); NSOV = -1; conv(ND[p].b, pt)
	lm ~= 0
	for j FI_[i].gn:
		g := GBS[FI_[i].g0 as int + j]; if g.name as int == LPN: lm = g.ty
	for j ND[node].n: p := kid(node, j); v := add_lv(ND[p].s, ptype_of(i, j), LV_PARAM | (if ND[p].fl & 1 != 0 { LV_VAR } else { 0 }) | (if lm >> j & 1 != 0 { LV_LIT } else { 0 }), p); set_r(p, R_LOCAL, v)
	body := ND[node].c
	rt := FI_[i].ret
	t := ck(body, if rt >= 0 { rt } else { -1 })
	FI_[i].nc = ends(body) && !rets_to(node, FI_[i].name, false)
	tail := ND[body].a
	if rt >= 0:
		if tail >= 0 && rt != T_VOID && t != T_VOID && !ends(tail): conv(tail, rt)
	else:
		if FI_[i].ret < 0:
			if tail >= 0 && t != T_VOID:
				rr := ref_res(tail, default_t(tail)); FI_[i].ret = rr; if TY[rr].k == TY_REF: conv(tail, rr)
			else: FI_[i].ret = T_VOID
		else:
			if tail >= 0 && t != T_VOID && FI_[i].ret != T_VOID: conv(tail, FI_[i].ret)
	GB.pop_n(GB.len - g0)
	SCOPE.pop_n(SCOPE.len - sm); NESTS.pop_n(NESTS.len - nm0)
	while BRK_T.len > bt: BRK_T.pop()
	AOWN = sa; CFN = sc; LOOPD = ld
	FI_[i].st = 2
recursive imp_tv(t int, ns int, b0 int):
	if t < 0: return
	x := ND[t]; k := x.k
	if k == N_TARR || k == N_TSLICE || k == N_TREF || k == N_TCONST: imp_tv(x.a, ns, b0); return
	if k != N_TNAME: return
	if x.n > 0: for i x.n { imp_tv(kid(t, i), ns, b0) } return
	for q b0..BINDS.len:
		if BINDS[q].name == x.s: return
	if lookup_q(x.s, ns, D_STRUCT) >= 0 || lookup_q(x.s, ns, D_ENUM) >= 0 || lookup_q(x.s, ns, D_ALIAS) >= 0: return
	BINDS.push(Gb{x.s, -1});
tv_name(fnode int, p int) int:
	tn := ND[p].a
	if tn < 0: return upname(p)
	if ND[tn].k as int != N_TNAME || ND[tn].n != 0: return -1
	gl := gen_list(fnode)
	if gl >= 0:
		for j ND[gl].n:
			if ND[kid(gl, j)].s == ND[tn].s: return ND[tn].s
	-1
lit_mask(fnode int, s int, an int) int:
	m ~= 0
	for j min(an, ND[fnode].n as int):
		k := TY[ARGW[s + j] as int].k as int
		v := tv_name(fnode, kid(fnode, j))
		an_ := DIDX[s + j] as int
		if k != TY_ILIT && k != TY_FLIT && !is_lp(an_) || v < 0 || j > 30: continue
		typed ~= false
		for q min(an, ND[fnode].n as int):
			if q != j && !is_pending(ARGW[s + q] as int) && tv_name(fnode, kid(fnode, q)) == v: typed = true
		if !typed: m |= 1 << j
	m
same_binds(i int, b0 int, bn int) bool:
	if FI_[i].gn != bn: return false
	for j bn:
		if GBS[FI_[i].g0 + j].ty != BINDS[b0 + j].ty || GBS[FI_[i].g0 + j].name != BINDS[b0 + j].name: return false
	true
on_chain(i int, b int) bool:
	j ~= b; while j >= 0 { if j == i { return true } j = if FI_[j].bown >= 0 { FI_[j].bown as int } else { FI_[j].par as int } } false
recursive get_inst(node int, b0 int, bn int, blk int, bown int) int:
	par := if ND[node].fl & F_NESTED != 0 { AOWN } else { -1 }
	xb i32[>..<] ~= []; xb.append(XBS[..]); XBS.clear()
	for f, i FI_:
		if f.node as int == node && f.blk as int == blk && (blk == -1 && (!f.dy || on_chain(i, bown)) || f.bown as int == bown) && f.par as int == par && same_binds(i, b0, bn) && xb_same(i, xb[..]) && !DEFE.contains(i as i32): return i
	i := new_inst(node, node, NEND[node] as int, par)
