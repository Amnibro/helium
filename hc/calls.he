var SCK i32[>..<]
sck_has(v int) bool:
	k ~= 0; while k < SCK.len { if SCK[k] == v && SCK[k + 1] == AOWN { return true } k += 2 } false
recursive slit_infer(n int, sn int) int:
	gn i32[..16] ~= []; gen_names(ND[sn].d, gn); args i32[..16] ~= []; for g gn: args.push(-1)
	items := flat_items(n); sa := AOWN; m0 := SCOPE.len; g0 := GB.len; named := items.len > 0 && ND[items[0]].s >= 0; fpos ~= 0; k ~= 0
	while k < items.len:
		fi := items[k]; inst := items[k + 1]; k += 2; SCOPE.pop_n(SCOPE.len - m0); GB.pop_n(GB.len - g0); AOWN = sa; if inst != sa: cf_chain(inst, sa)
		fd ~= -1; if named:
			fnm := cf_acc(ND[fi].s); for q ND[sn].n:
				f := kid(sn, q); if ND[f].fl & 4 == 0 && ND[f].s == fnm: fd = f
		else: c ~= 0; for q ND[sn].n { f := kid(sn, q); if ND[f].fl & 4 == 0 { if c == fpos { fd = f } c++ } } fpos++
		if fd < 0 { continue } ta := ND[fd].a
		if ta >= 0 && ND[ta].k == N_TNAME && ND[ta].n == 0:
			for g, gi gn:
				if ND[ta].s == g && args[gi] < 0: v := ND[fi].a; vt := ck(v, -1); args[gi] = (if is_pending(vt) { default_t(v) } else { vt }); SCK.push(v); SCK.push(AOWN)
		else:
			if ta >= 0 && args.contains(-1):
				v := ND[fi].a; vt := ck(v, -1); if !is_pending(vt) { b0 := BINDS.len; for g, gi gn { BINDS.push(Gb{g, args[gi]}) } match_ty(ta, vt, b0); for gi gn.len { if args[gi] < 0 && BINDS[b0 + gi].ty >= 0 { args[gi] = BINDS[b0 + gi].ty } } BINDS.pop_n(BINDS.len - b0); SCK.push(v); SCK.push(AOWN) }
	SCOPE.pop_n(SCOPE.len - m0); GB.pop_n(GB.len - g0); AOWN = sa
	for a args:
		if a < 0: return -1
	t_struct(inst_struct(sn, args[..]))
recursive ck_slit(n int, want int) int:
	x := ND[n]
	tnode := x.a as int
	ns := ns_of(n)
	t ~= -1
	if ND[tnode].k == N_TNAME && ND[tnode].n == 0 && gb_find(ND[tnode].s as int) < 0:
		d := lookup_q(ND[tnode].s as int, ns, D_STRUCT)
		if d >= 0 && ND[DC[d].node].d >= 0:
			if want >= 0 && TY[want].k == TY_STRUCT && STI[TY[want].a].node == DC[d].node: t = want else: t = slit_infer(n, DC[d].node as int)
	if t < 0: t = rtype(tnode, ns)
	si ~= -1
	if TY[t].k == TY_STRUCT: si = TY[t].a as int
	if TY[t].k == TY_VARIANT: si = ENV[ENI[TY[t].a].v0 as int + TY[t].c as int].si as int
	if si < 0: if TY[t].k != TY_ERR { cerr(n, "not a struct type") } return set_t(n, T_ERRT)
	nf := STI[si].fnum as int
	items := flat_items(n); sa := AOWN; m0 := SCOPE.len; g0 := GB.len
	named := items.len > 0 && ND[items[0]].s >= 0
	fpos ~= 0; k ~= 0
	while k < items.len:
		fi := items[k] as int; inst := items[k + 1] as int; k += 2
		SCOPE.pop_n(SCOPE.len - m0); GB.pop_n(GB.len - g0); AOWN = sa; if inst != sa: cf_chain(inst, sa)
		idx ~= -1
		if named:
			idx = sfield(si, cf_acc(ND[fi].s as int)); if idx < 0: m byte[>..] ~= []; format(m, "no field ", nm(cf_acc(ND[fi].s as int)), " in ", tn(t)); cerr(fi, m); continue
		else:
			while fpos < nf && SFI[STI[si].f0 as int + fpos].ty < 0 { fpos++ } idx = fpos; fpos++; if idx >= nf: cerr(fi, "too many initializers"); continue
		ft := SFI[STI[si].f0 as int + idx].ty as int
		set_r(fi, R_FIELD, idx)
		v := ND[fi].a as int
		if !sck_has(v) { ck(v, ft) } conv(v, ft)
	SCOPE.pop_n(SCOPE.len - m0); GB.pop_n(GB.len - g0); AOWN = sa
	for j nf:
		f := SFI[STI[si].f0 as int + j]
		if f.ty < 0: continue
		gn, gi := sl_given(n, j); given := gn >= 0
		if !given && f.def >= 0: sa := AOWN; AOWN = sdinst(si); g0 := dpush(AOWN); ck(f.def as int, f.ty as int); conv(f.def as int, f.ty as int); GB.pop_n(GB.len - g0); AOWN = sa
		if !given && f.def < 0: ck_defs(f.ty as int)
		if !given && f.def < 0 && x.fl & 1 == 0 && !is_opt(f.ty as int): m byte[>..] ~= []; format(m, "missing field ", nm(f.name as int), " in ", tn(t)); cerr(n, m)
	set_r(n, R_CTOR, si)
	set_t(n, t)
var XROOTS i32[>..]
lib_file(f int) bool: n := nm(FILES[f].name); LIBDIR.len > 0 && n.len > LIBDIR.len && n[..LIBDIR.len] == LIBDIR[..]
all_typed(f int) bool:
	for j ND[f].n: if ND[kid(f, j)].a < 0 { return false }
	true
check_program() bool:
	GLOBI = new_inst(-1, 0, ND.len, -1)
	FI_[GLOBI].st = 2
	AOWN = GLOBI; CFN = GLOBI
	md := lookup(intern("main"), -1, D_FN)
	if md < 0 && !LSPM: cerr(0, "no main function"); return false
	for d, i DC:
		if d.k as int == D_GLOBAL && d.file == 0: global_type(i)
	for d DC: if d.k as int == D_FN && ND[d.node].fl & F_EXPORT != 0 && ND[d.node].d < 0 { EXPN.push(d.node) }
	if md >= 0: get_inst(DC[md].node, BINDS.len, 0, -1, -1)
	if LSPM: for d DC { fq := d.node as int; if d.k as int == D_FN && ND[fq].d < 0 && ND[fq].fl & (F_EXTERN | F_NESTED) == 0 && ND[fq].c >= 0 && !lib_file(d.file as int) && all_typed(fq) { get_inst(fq, BINDS.len, 0, -1, -1) } }
	for x EXPN: get_inst(x, BINDS.len, 0, -1, -1)
	for d XROOTS: get_inst(DC[d].node, BINDS.len, 0, -1, -1)
	for d, i DC:
		if d.k as int == D_GLOBAL: global_type(i)
	propagate_calls()
	NERR == 0
