		s := ck_args(n, 0, -1); an := ARGW.len - s; pick ~= -1; pr ~= 99; ps i64 ~= 0; for c, ci cs:
			r := nrank(c, s, an, -1); if r >= 0 && (r < pr || r == pr && csc[ci] < ps): pick = c; pr = r; ps = csc[ci]
		if pick < 0:
			for j an:
				d := deref(ARGW[s + j]); if pick < 0 && TY[d].k == TY_ENUM:
					ei := TY[d].a; ins i32[>..<] ~= []; for vi ENI[ei].vnum:
						f ~= -1; for c cs { pt := deref(ptype_of(c, j)); if f < 0 && FI_[c].pn == an && TY[pt].k == TY_VARIANT && TY[pt].a == ei && TY[pt].c as int == vi && nfits(c, s, an, j) { f = c } } if f >= 0: ins.push(f)
					if ins.len == ENI[ei].vnum && ins.len > 0: i0 := ins[0]; for k an { if k != j { conv(DIDX[s + k], ptype_of(i0, k)) } } pop_args(s); d0 := DSPL.len; DSPL.push(j); DSPL.append(ins[..]); for c ins { note_caps_of(c); note_edge(c) } set_r(n, R_CASE, d0); return set_t(n, if FI_[i0].ret >= 0 { FI_[i0].ret as int } else { T_VOID })
		pop_args(s); if pick >= 0:
			for q, qi NESTS:
				if q.inst == pick: nf = qi
	call_reinst(n, NESTS[nf].inst)
var RINS i32[>..<]
recursive call_reinst(n int, i0 int) int:
	if !DEFE.contains(i0 as i32): return call_inst(n, i0)
	nd0 := FI_[i0].node as int; o ~= AOWN
	while o >= 0: if FI_[o].node as int == nd0 { return call_inst(n, o) }; o = if FI_[o].bown >= 0 { FI_[o].bown as int } else { FI_[o].par as int }
	k ~= 0; while k < RINS.len: if RINS[k] as int == i0 && RINS[k + 1] as int == AOWN { return call_inst(n, RINS[k + 2] as int) } k += 3
	nd := FI_[i0].node as int; i := new_inst(nd, nd, NEND[nd] as int, FI_[i0].par as int); sig_inst(i); FI_[i].bown = AOWN as i32; RINS.push(i0 as i32); RINS.push(AOWN as i32); RINS.push(i as i32)
	sa := AOWN; check_inst(i); AOWN = sa
