var EXPN i32[>..]
exp_sym(node int) const byte[:]: e := ND[node].e; if e >= 0 && ND[e].a >= 0 { tok_str(ND[e].a) } else { nm(ND[node].s) }
exp_of(i int) int:
	nd := FI_[i].node as int
	if EXPN.len == 0 || nd < 0 || ND[nd].fl & F_EXTERN == 0: return -1
	s := exp_sym(nd)
	for x EXPN { if exp_sym(x) == s { return get_inst(x, BINDS.len, 0, -1, -1) } }
	-1
recursive call_inst(n int, i int) int:
	x := exp_of(i)
	if x >= 0: return call_inst(n, x)
	defer_err(i)
	s := ck_args(n, 0, -1)
	for j ND[n].n:
		c := kid(n, j); if j < FI_[i].pn as int: conv(c, ptype_of(i, j))
	pop_args(s)
	note_caps_of(i); note_edge(i)
	set_r(n, R_FN, i)
	set_t(n, if FI_[i].ret >= 0 { FI_[i].ret as int } else { T_VOID })
note_caps_of(i int):
	for c CAPS:
		if c.inst == i:
			v := c.lv; if LVS[v].cfn != CFN: note_cap(v)
recursive case_inst(n int, name int, s int, an int, j int, t int, blk int, bown int) int:
	ARGW[s + j] = t
	fnode, b0, bn := resolve(n, name, ns_of(n), s, an, blk, ND[n].c, false)
	inst := if fnode >= 0 { get_inst(fnode, b0, bn, blk, if blk >= 0 { bown } else { AOWN }) } else { -1 }
	BINDS.pop_n(BINDS.len - b0)
	inst
elref(e int) int: if TY[e].k == TY_REF && TY[e].c >= 0 { t_ref(TY[e].a as int, TY[e].fl as int) } else { t_ref(e, 0) }
recursive conv_arg(c int, pt int):
	if pt < 0 || TY[pt].k != TY_REF || TY[pt].fl & RF_OPT != 0 || TY[pt].c >= 0: conv(c, pt); return
	if is_pending(at(c)): conv(c, TY[pt].a); return
	k := ND[c].k; if (k == N_BLOCK || k == N_IF || k == N_MATCH) && deref(at(c)) == TY[pt].a && tail_place(c): conv_tail(c, pt); set_t(c, pt)
recursive try_case(n int, name int, s int, an int, blk int, bown int) int:
	for j an:
		a0 := ARGW[s + j]; d := deref(a0)
		if TY[d].k != TY_ENUM: continue
		ei := TY[d].a; vn := ENI[ei].vnum
		ok ~= vn > 0; ins i32[>..<] ~= []
		for vi vn:
			if ok:
				vt := t_variant(ei, vi); inst ~= case_inst(n, name, s, an, j, vt, blk, bown); if inst < 0 { inst = case_inst(n, name, s, an, j, t_ref(vt, 0), blk, bown) } if inst < 0: ok = false else: ins.push(inst)
		ARGW[s + j] = a0
		if !ok: continue
		d0 := DSPL.len; DSPL.push(j); DSPL.append(ins[..])
		i0 := DSPL[d0 + 1]
		rt ~= -1; for vi vn:
			r := FI_[DSPL[d0 + 1 + vi]].ret; if rt < 0: rt = r
		for vi vn: i := DSPL[d0 + 1 + vi]; if FI_[i].ret >= 0 && FI_[i].ret != rt { cerr(n, "case functions must agree on their result type") } note_caps_of(i); note_edge(i)
		for k an { if k != j { conv_arg(DIDX[s + k] as int, ptype_of(i0, k)) } }
		set_r(n, R_CASE, d0)
		if rt < 0: cerr(n, "a case function called here needs its result type written"); return set_t(n, T_ERRT)
		return set_t(n, rt)
	-1
recursive ck_spawn(n int) int:
	x := ND[n]
	if x.n == 0 || ND[kid(n, 0)].k as int != N_ID: cerr(n, "thread_spawn needs a thread_fn"); return set_t(n, T_ERRT)
	wn := kid(n, 0)
	wnm ~= ND[wn].s
	wb := block_binding(wnm)
	if wb >= 0 && FI_[wb].blk < -1: wnm = -2 - FI_[wb].blk as int
	s := ARGW.len
	for i 1..x.n: c := kid(n, i); ARGW.push(ck(c, -1)); DIDX.push(c)
	an := x.n as int - 1
	fnode, b0, bn := resolve(n, wnm, ns_of(n), s, an, -1, -1, false)
	if fnode < 0 || ND[fnode].fl & F_THREAD == 0: BINDS.pop_n(BINDS.len - b0); pop_args(s); m byte[>..] ~= []; format(m, "no thread_fn ", nm(ND[wn].s), " matches these arguments"); cerr(n, m); return set_t(n, T_ERRT)
	inst := get_inst(fnode, b0, bn, -1, AOWN)
	BINDS.pop_n(BINDS.len - b0)
	for j an: c := DIDX[s + j]; conv(c, ptype_of(inst, j))
	pop_args(s)
	note_edge(inst)
	TSP.push(n); TSP.push(AOWN); TSP.push(inst)
	set_t(n, T_I64)
var CFEL i8[>..]
recursive cf_try(n int, fnode int, s int, an int, b0 int, bn int, blk int, want int, name int) int, int, int:
	r := ND[fnode].b; gl := gen_list(fnode); ty := ND[n].c
	if ND[fnode].fl & F_EXTERN != 0 || r < 0 || ND[r].n != 1 || gl < 0: return fnode, b0, bn
	rt := kid(r, 0); if ND[rt].k as int != N_TNAME || ND[rt].n != 0: return fnode, b0, bn
	g := ND[rt].s; gi ~= -1; for j ND[gl].n { if ND[kid(gl, j)].s == g { gi = j } } bi ~= -1; for q b0..b0 + bn { if BINDS[q].name == g { bi = q } }
	if gi < 0 || ty >= 0 && gi < ND[ty].n as int || bi < 0 || BINDS[bi].ty as int != T_F64: return fnode, b0, bn
	js i32[>..<] ~= []; ot i32[>..<] ~= []
	for j min(an, ND[fnode].n as int):
		pa := ND[kid(fnode, j)].a; if pa < 0 || ND[pa].k as int != N_TNAME || ND[pa].s != g { continue } if ND[pa].n != 0 { return fnode, b0, bn } c := DIDX[s + j] as int; while CFEL.len < ND.len { CFEL.push(0) }
		if !is_pending(ARGW[s + j] as int) && CFEL[c] == 0 { return fnode, b0, bn } js.push(j as i32); ot.push(ARGW[s + j])
	if js.len == 0: return fnode, b0, bn
	for j js: ARGW[s + j] = T_F32 as i32
	f2, c0, cn0 := resolve(n, name, ns_of(n), s, an, blk, ty, false); same ~= f2 == fnode && cn0 == bn; if same { for q bn { u := BINDS[c0 + q]; v := BINDS[b0 + q]; if u.name != v.name || u.ty != v.ty && !(b0 + q == bi && u.ty as int == T_F32) { same = false } } } BINDS.pop_n(BINDS.len - c0)
	if same: while CFEL.len < ND.len { CFEL.push(0) } CFEL[n] = 1
	if !same || want != T_F32: for j, i js { ARGW[s + j] = ot[i] } return fnode, b0, bn
	BINDS.pop_n(BINDS.len - b0); f3, b3, n3 := resolve(n, name, ns_of(n), s, an, blk, ty, true)
	for j, i js { c := DIDX[s + j] as int; if is_pending(ot[i] as int) { ARGW[s + j] = ot[i] } else { ck(c, T_F32); ARGW[s + j] = T_F32 as i32 } }
	return f3, b3, n3
recursive call_fn(n int, name int, recv int, want int) int:
	isst := n == STMTN || want == T_VOID
	s := ck_args(n, 0, recv)
	an ~= ARGW.len - s
	blk ~= ND[n].b
	bown ~= AOWN
	if blk < 0 && an > 0 && ARGW[s + an - 1] == T_FNV && ND[DIDX[s + an - 1]].k as int == N_ID:
		fnm := ND[DIDX[s + an - 1]].s
		bg := block_binding(fnm)
		eb := if bg >= 0 { FI_[bg].blk as int } else { -2 - fnm }
		f2, c0, cn0 := resolve(n, name, ns_of(n), s, an - 1, eb, ND[n].c, false)
		BINDS.pop_n(BINDS.len - c0)
		if f2 >= 0: an--; blk = eb; bown = if bg >= 0 { FI_[bg].bown as int } else { AOWN }; while FNA.len <= n { FNA.push(0) } FNA[n] = 1
	fnode0, b0, bn := resolve(n, name, ns_of(n), s, an, blk, ND[n].c, true)
	fnode ~= fnode0
	if fnode >= 0: fnode, b0, bn = cf_try(n, fnode, s, an, b0, bn, blk, want, name)
	if fnode >= 0 && case_better(n, name, s, an, blk, fnode, LRANK): BINDS.pop_n(BINDS.len - b0); dr := try_case(n, name, s, an, blk, bown); if dr >= 0 { pop_args(s); return dr } fnode, b0, bn = resolve(n, name, ns_of(n), s, an, blk, ND[n].c, true)
	if fnode < 0:
		BINDS.pop_n(BINDS.len - b0); dr := try_case(n, name, s, an, blk, bown); if dr >= 0: pop_args(s); return dr
	if fnode < 0:
		m byte[>..] ~= []; format(m, "no function ", nm(name), " matches (")
		for j an: if j > 0 { m.append(", ") } m.append(tn(ARGW[s + j]))
		m.append(")")
		cerr(n, m)
		pop_args(s)
		BINDS.pop_n(BINDS.len - b0)
		return set_t(n, T_ERRT)
	np0 := ND[fnode].n
	if an > np0: ntya := if ND[n].c >= 0 { ND[ND[n].c].n as int } else { 0 }; for k an - np0 { fnm := ND[DIDX[s + np0 + k]].s; bg2 := block_binding(fnm); XBS.push(xcall(fnode, ntya, k)); XBS.push((if bg2 >= 0 { FI_[bg2].blk as int } else { -2 - fnm })); XBS.push((if bg2 >= 0 { FI_[bg2].bown as int } else { AOWN })) } while FNA.len <= n { FNA.push(0) } FNA[n] = fna(n) + an - np0; an = np0
	lm := lit_mask(fnode, s, an)
	if lm != 0: BINDS.push(Gb{LPN as i32, lm})
	inst ~= get_inst(fnode, b0, BINDS.len - b0, blk, bown)
	BINDS.pop_n(BINDS.len - b0)
	ex := exp_of(inst); if ex >= 0 { inst = ex }
	for j an: conv_arg(DIDX[s + j] as int, ptype_of(inst, j))
	pop_args(s)
	note_caps_of(inst); note_edge(inst)
	set_r(n, R_FN, inst)
	rt := FI_[inst].ret
	if rt < 0 && FI_[inst].st == 1 && isst: return set_t(n, T_VOID)
	if rt < 0: if FI_[inst].st == 1 { m byte[>..] ~= []; format(m, "recursive call to ", nm(name), " needs its result type written"); cerr(n, m) } return set_t(n, T_ERRT)
	set_t(n, rt)
is_gname(name int) bool:
	i ~= AOWN; while i >= 0 { f := FI_[i]; for q (f.g0 as int)..(f.g0 + f.gn) as int { if GBS[q].name == name { return true } } i = f.par } false
recursive shlit(a int) int:
	k := ND[a].k; if k == N_STR { return a } if k != N_ID: return -1
	v := ND[a].s; if find_lv(v) >= 0 || is_gname(v): return -1
	d := lookup(v, ns_of(a), D_GLOBAL); if d < 0 { return -1 } x := ND[DC[d].node]; if x.fl & V_VAR != 0 || x.b < 0: return -1
	iv := kid(x.b, 0); if ND[iv].k as int == N_STR:
		iv
	else:
		if ND[iv].k as int == N_ID && iv != a:
			shlit(iv)
		else:
			-1
has_nl(s const byte[:]) bool:
	for c s { if c == '\n' { return true } } false
recursive ck_shader(n int, total int, recv int) int:
	ls i32[>..] ~= []; nmd i32[>..] ~= []
	for i total: c := if recv >= 0 { if i == 0 { recv } else { kid(n, i - 1) } } else { kid(n, i) }; l := shlit(c); if l < 0 { cerr(c, "embed_shader takes string literals, and let or const globals initialized with one"); return set_t(n, T_ERRT) } ls.push(l); nmd.push((if l != c { 1 } else { 0 }) as i32); ck(c, TT_STR); default_t(c)
	if ls.len == 0: cerr(n, "embed_shader takes a shader file's path, or a stage and its source"); return set_t(n, T_ERRT)
	cf := node_file(n); callf byte[>..] ~= []; callf.append(nm(FILES[cf].name)); err byte[>..] ~= []; m byte[>..] ~= []
	if ls.len == 1:
		v byte[>..] ~= []; v.append(tok_str(ND[ls[0]].t))
		if has_nl(v[..]): cerr(n, "embed_shader(\"x.frag\") takes a shader file's path; shader source follows its stage: embed_shader(\"frag\", source)"); return set_t(n, T_ERRT)
		path byte[>..] ~= []; if v.len > 0 && v[0] == '/': path.append(v[..]) else: sl ~= -1; for c, i callf { if c == '/' { sl = i } } if sl >= 0 { path.append(callf[..sl + 1]) } path.append(v[..])
		st := if path.len > 5 && path[^5..] == ".vert" { 0 } else { if path.len > 5 && path[^5..] == ".frag" { 1 } else { if path.len > 5 && path[^5..] == ".comp" { 2 } else { -1 } } }
		if st < 0: format(m, "embed_shader: cannot tell the shader stage of ", path[..], ": the extension must be .vert, .frag or .comp"); cerr(n, m[..]); return set_t(n, T_ERRT)
		src byte[>..] ~= []; if !read_file(path[..], src): format(m, "embed_shader: cannot open shader file: ", path[..]); cerr(n, m[..]); return set_t(n, T_ERRT)
		if !shader_compile(n, st, path[..], src[..], err): format(m, "embed_shader: ", err[..]); cerr(n, m[..]); return set_t(n, T_ERRT)
		return set_t(n, TT_STR)
	sn := tok_str(ND[ls[0]].t); st := if sn == "vert" { 0 } else { if sn == "frag" { 1 } else { if sn == "comp" { 2 } else { -1 } } }
	if st < 0: format(m, "embed_shader: the stage is \"vert\", \"frag\" or \"comp\", not \"", sn, "\""); cerr(ls[0], m[..]); return set_t(n, T_ERRT)
	src byte[>..] ~= []; starts i32[>..] ~= []
	for k 1..ls.len: if k > 1 { src.push('\n') } nl ~= 1; for c src { if c == '\n' { nl++ } } starts.push(nl); src.append(tok_str(ND[ls[k]].t))
	if shader_compile(n, st, callf[..], src[..], err): return set_t(n, TT_STR)
	line ~= 0; p ~= callf.len + 1; at_us ~= err.len > callf.len && err[..callf.len] == callf[..] && err[callf.len] == ':'
	if at_us:
		while p < err.len && err[p] >= '0' && err[p] <= '9': line = line * 10 + (err[p] - '0'); p++
	sep := if line > 0 { ": error: " } else { " " }; at_us = at_us && err.len >= p + sep.len && err[p..p + sep.len] == sep
	if !at_us: format(m, "embed_shader: ", err[..]); cerr(n, m[..]); return set_t(n, T_ERRT)
	msg := err[p + sep.len..]
	if line == 0: format(m, "embed_shader: ", msg); cerr(n, m[..]); return set_t(n, T_ERRT)
	part ~= 0; for s0, k starts:
		if s0 <= line: part = k
	lit := ls[part + 1]; lv := tok_str(ND[lit].t); at ~= TK[ND[lit].t].line
	if has_nl(lv): lines ~= 1; for c lv { if c == '\n' { lines++ } } at += min(line - starts[part] + 1, lines)
	format(m, "embed_shader: ", msg); if nmd[part + 1] != 0: format(m, " (in the shader embedded at ", callf[..], ":", TK[ND[n].t].line, ")")
	cerrl(TK[ND[lit].t].f, at, m[..]); set_t(n, T_ERRT)
recursive ck_builtin(n int, b int, recv int, want int) int:
	x := ND[n]
	set_r(n, R_BUILTIN, b)
	fm := FREEM; FREEM = false
	set_x(n, if fm { 2 } else { if recv >= 0 { 1 } else { 0 } })
	na := x.n
	arg(i int) int:
		if recv >= 0 && !fm:
			if i == 0:
				recv
			else:
				kid(n, i - 1)
		else:
			kid(n, i)
	total := na + (if recv >= 0 && !fm { 1 } else { 0 })
	need := if b == B_PRINT || b == B_STR || b == B_DEFAULT || b == B_POP || b == B_CLEAR || b == B_HWT || b == B_QGET || b == B_QPOLL { 0 } else { if b == B_REALLOCS { 3 } else { if b == B_PUSH || b == B_APPEND || b == B_POPN || b == B_RESIZE || b == B_INDEXOF || b >= B_ALLOCI && b <= B_REALLOCS { 2 } else { 1 } } }
	if total < need: cerr(n, "too few arguments to a builtin"); return set_t(n, T_ERRT)
	if b == B_PRINT || b == B_STR:
		for i total: c := arg(i); t := if recv >= 0 && i == 0 { at(c) } else { ck(c, -1) }; if is_pending(t) { default_t(c) } hook_walk(fin_t(c))
		return set_t(n, if b == B_STR { t_arr(T_U8, A_GROW, -1, -1) } else { T_VOID })
	if b == B_FORMAT:
		o := arg(0)
		if recv < 0: ck(o, -1)
		if pend_local(o): complete(o, T_U8)
		for i 1..total: c := arg(i); t := ck(c, -1); if is_pending(t) { default_t(c) } hook_walk(fin_t(c))
		return set_t(n, T_VOID)
	if b == B_ASSERT: ck(arg(0), T_BOOL); conv(arg(0), T_BOOL); narrow_push(arg(0)); return set_t(n, T_VOID)
	if b == B_ABORT: t := ck(arg(0), TT_STR); if is_pending(t) { default_t(arg(0)) } return set_t(n, T_VOID)
	if b == B_EXIT: ck(arg(0), T_I64); conv(arg(0), T_I64); return set_t(n, T_VOID)
	if b == B_DEFAULT: ta := x.c; if ta < 0 { cerr(n, "default needs a type: default<T>()"); return set_t(n, T_ERRT) } dt := decode_rel(rtype(kid(ta, 0), ns_of(n))); ck_defs(dt); return set_t(n, dt)
	if b == B_COPY:
		c := arg(0)
		if recv < 0: ck(c, want)
		t ~= at(c)
		if is_pending(t): t = default_t(c)
		d := deref(t)
		k := TY[d].k
		if k == TY_SLICE: return set_t(n, t_arr(TY[d].a, A_GROW, -1, -1))
		return set_t(n, d)
	if b == B_LEN: c := arg(0); if recv < 0 { ck(c, -1) } if TY[at(c)].k == TY_STRLIT { set_t(c, TT_STR) } return set_t(n, T_I64)
	if b == B_BYTESOF: c := arg(0); if recv < 0 { ck(c, -1) } if is_pending(at(c)) { default_t(c) } return set_t(n, TT_STR)
	if b == B_TOBYTES: c := arg(0); if recv < 0 { ck(c, -1) } if is_pending(at(c)) { default_t(c) } if total > 1 { ck(arg(1), -1); return set_t(n, T_VOID) } return set_t(n, t_arr(T_U8, A_GROW, -1, -1))
	if b == B_FROMBYTES: ta := x.c; t := if ta >= 0 { rtype(kid(ta, 0), ns_of(n)) } else { T_ERRT }; ck(arg(0), TT_STR); if is_pending(at(arg(0))) { default_t(arg(0)) } if TY[t].k == TY_ARR { rs i32[..2] ~= []; rs.push(t); rs.push(T_BOOL); return set_t(n, tlist(TY_MULTI, rs[..], -1)) } return set_t(n, t)
	if b == B_EMBED: ck(arg(0), TT_STR); default_t(arg(0)); return set_t(n, TT_STR)
	if b == B_EMBEDSH: return ck_shader(n, total, recv)
	if b == B_SPAWN || b == B_SPAWNC: return ck_spawn(n)
	if b == B_TWAIT: ck(arg(0), T_I64); conv(arg(0), T_I64); if total > 1 { ck(arg(1), -1) } return set_t(n, T_BOOL)
	if b == B_HWT: return set_t(n, T_I64)
	if b == B_QPUT: c := arg(0); t ~= ck(c, -1); if is_pending(t) { t = default_t(c) } d := deref(t); if d != t { set_cv(c, d) } return set_t(n, T_BOOL)
	if b == B_QGET || b == B_QPOLL || b == B_QLIMIT:
		ta := x.c; t := if ta >= 0 { rtype(kid(ta, 0), ns_of(n)) } else { T_ERRT }
		if ta < 0: cerr(n, "this builtin needs its queue's type: name it as <T>"); return set_t(n, T_ERRT)
		if b == B_QLIMIT: ck(arg(0), T_I64); conv(arg(0), T_I64); return set_t(n, T_VOID)
		if b == B_QGET && total == 0: return set_t(n, t)
		if total > 0: ck(arg(0), T_I64); conv(arg(0), T_I64)
		rs i32[..2] ~= []; rs.push(t); rs.push(T_BOOL); return set_t(n, tlist(TY_MULTI, rs[..], -1))
	r := recv
	if (b == B_PUSH || b == B_APPEND || b == B_ALLOCI || b == B_ALLOCR) && total == 2:
		rt0 := deref(at(r)); if TY[rt0].k == TY_ARR && TY[rt0].a == T_ERRT && ND[r].k as int == N_ID && rk(r) == R_LOCAL:
			c := arg(1); ct0 := ck(c, -1); ck0 := TY[ct0].k; e2 := if b == B_APPEND { if ck0 == TY_STRLIT { T_U8 } else { if ck0 == TY_ARRLIT { if ND[c].n > 0 { default_t(kid(c, 0)) } else { T_ERRT } } else { TY[deref(ct0)].a as int } } } else { if ck0 == TY_STRLIT { t_arr(T_U8, A_VAR, -1, 6) } else { if is_pending(ct0) { default_t(c) } else { deref_val(ct0) } } }; if e2 != T_ERRT: complete(r, e2)
	rt := deref(at(r))
	e := TY[rt].a
	if b == B_PUSH: if total != 2 { cerr(n, "push takes one value"); return set_t(n, T_ERRT) } c := arg(1); ck(c, e); conv(c, e); return set_t(n, elref(e))
	if b == B_APPEND: c := arg(1); t := ck(c, t_slice(e, true)); if TY[t].k == TY_STRLIT { set_t(c, TT_STR); } else { if TY[t].k == TY_ARRLIT { conv(c, t_arr(e, A_GROW, -1, -1)); } else { dt := deref(t); if (TY[dt].k == TY_ARR || TY[dt].k == TY_SLICE) && TY[dt].a != e { cerr(c, "append of a different element type") } } } return set_t(n, T_VOID)
	if b == B_POP: return set_t(n, decode_rel(e))
	if b == B_POPN: ck(arg(1), T_I64); conv(arg(1), T_I64); return set_t(n, T_VOID)
	if b == B_RESIZE: ck(arg(1), T_I64); conv(arg(1), T_I64); if total > 2 { ck(arg(2), e); conv(arg(2), e) } return set_t(n, T_VOID)
	if b == B_CLEAR: return set_t(n, T_VOID)
	if b == B_INDEXOF: c := arg(1); ck(c, t_ref(e, 0)); conv(c, t_ref(e, 0)); return set_t(n, T_I64)
	if b == B_ALLOCI || b == B_ALLOCR: c := arg(1); ck(c, e); conv(c, e); return set_t(n, if b == B_ALLOCI { T_I64 } else { elref(e) })
	if b == B_FREE || b == B_ALLOCS: fa := deref(ck(arg(1), T_I64)); if TY[fa].k == TY_INT && fa != T_I64 { set_cv(arg(1), T_I64) } else { conv(arg(1), T_I64) }; if b == B_ALLOCS { ck_defs(e) } return set_t(n, if b == B_FREE { T_VOID } else { t_slice(e, false) })
	if b == B_FREES || b == B_REALLOCS: c := arg(1); ck(c, t_slice(e, true)); conv(c, t_slice(e, true)); if b == B_FREES { return set_t(n, T_VOID) } ck(arg(2), T_I64); conv(arg(2), T_I64); return set_t(n, t_slice(e, false))
