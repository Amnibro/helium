import os;
import lower;
fn main() {
	var a byte[>..] = [];
	var o byte[>..] = [];
	if arg_count() < 3 { print("usage: hc file.amni out.c [--native] [--debug]"); exit(2); }
	arg(1, a); arg(2, o);
	var native = false;
	for i in 3..arg_count() { var m byte[>..] = []; arg(i, m); if m[..] == "--native" { native = true; } if m[..] == "--debug" { DBG = true; } }
	var lib byte[>..] = [];
	if !env("HC_LIB", lib) { lib.append("hc/lib"); }
	LIBDIR.append(lib);
	if !load_program(a) { print(DERR); exit(1); }
	if native { let rf = load_import(intern("rt"), 0, -1); if rf < 0 { print(DERR); exit(1); } for d in DC { if d.k as int == D_FN && d.file as int == rf { XROOTS.push(d.name); } } }
	if !check_program() { print(CERR); exit(1); }
	if DERR.len > 0 { print(DERR); exit(1); }
	var c byte[>..] = [];
	if native { if !lower_program(c) { print(LERR); exit(1); } if !write_file(o, c) || !make_exec(o) { print("cannot write ", o); exit(1); } return; }
	if !gen_program(c) { print(GERR); exit(1); }
	if !write_file(o, c) { print("cannot write ", o); exit(1); }
}
