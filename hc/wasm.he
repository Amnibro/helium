use lower
WRO := 1024
var WO byte[>..<]
var WARI i32[>..<]
var WLB i32[>..<]
var BS i32[>..<]; var BE i32[>..<]; var BRPO i32[>..<]; var BIDOM i32[>..<]; var BS0 i32[>..<]; var BS1 i32[>..<]; var BNS i8[>..<]; var BLOOP bool[>..<]; var BMRG bool[>..<]; var BFP i32[>..<]
var BORD i32[>..<]; var PRS i32[>..<]; var PRN i32[>..<]; var PRL i32[>..<]
var MCS i32[>..<]; var MCN i32[>..<]; var MCL i32[>..<]
var CK i8[>..<]; var CT i32[>..<]
WAR ~= 0; WSLO ~= 0; RT_SOVF ~= -1; WFP ~= 0; WT0 ~= 0; WSBA ~= 0; WGB ~= 0; WIMP ~= 1; WNF ~= 0
ul(o byte[>..<]&, v0 int): v ~= v0 as! u64; loop { b := (v & 127) as int; v = v >> 7; if v != 0 { o.push((b | 128) as byte) } else { o.push(b as byte); break } }
sl(o byte[>..<]&, v0 int): v ~= v0; loop { b := v & 127; v = v >> 7; if v == 0 && b & 64 == 0 || v == -1 && b & 64 != 0 { o.push(b as byte); break } o.push((b | 128) as byte) }
wb(b int): WO.push(b as byte)
var VMAP i32[>..<]; var VUSED i32[>..<]; VN ~= 0
wl(v int) int:
	if v == -2: return WT0
	if v == -3: return WT0 + 1
	WAR + 12 + VMAP[v] as int
var VST i32[>..<]; var VEN i32[>..<]; var WLP i32[>..<]
wops(i int, us i32[>..<]&, ds i32[>..<]&):
	x := IR[i]; op := x.op as int; us.clear(); ds.clear()
	if op == I_NOP || op == I_LBL || op == I_JMP || op == I_DSS || op == I_DSR: return
	if op == I_CALL || op == I_SYS || op == I_CALLR: for k x.b { us.push(ARGL[x.a + k]) } if op == I_CALLR { us.push(x.c as i32) } if op != I_SYS && x.l >= 0 { ds.push(x.l) } if x.d >= 0 { ds.push(x.d) } return
	if x.a >= 0 { us.push(x.a) } if x.b >= 0 { us.push(x.b) } if op == I_FUN && x.c == 6 { us.push(x.l) }
	if x.d >= 0 { if op == I_COPY || op == I_ZERO { us.push(x.d) } else { ds.push(x.d) } }
wcolor(fi int):
	f := NFS[fi]; i0 := f.i0 as int; nv := f.nv as int; VST.clear(); VST.resize(nv, -1); VEN.clear(); VEN.resize(nv, -1)
	us i32[>..<] ~= []; ds i32[>..<] ~= []; lp i32[>..<] ~= []
	for i i0..(f.i1 as int):
		wops(i, us, ds)
		for v us: if VST[v] < 0 { VST[v] = i0 as i32 } VEN[v] = i as i32
		for v ds: if VST[v] < 0 { VST[v] = i as i32 } VEN[v] = i as i32
		op := IR[i].op as int; if (op == I_JMP || op == I_BZ || op == I_BNZ) && WLP[IR[i].c] <= i { lp.push(WLP[IR[i].c]); lp.push(i as i32) }
	ch ~= lp.len > 0
	while ch:
		ch = false
		for q lp.len / 2: h := lp[2 * q]; p := lp[2 * q + 1]; for v nv { s := VST[v]; e := VEN[v]; if s >= 0 && (s < h && e >= h || s <= p && e > p) && (s > h || e < p) { VST[v] = min(s, h); VEN[v] = max(e, p); ch = true } }
	bs int[>..] ~= []; be int[>..] ~= []
	for v nv: if VST[v] >= 0 { bs.push((VST[v] as int) << 24 | v); be.push((VEN[v] as int) << 24 | v) }
	sort(bs[..]); sort(be[..]); fr i32[>..<] ~= []; j ~= 0; VN = 0
	for k bs:
		v := k & 16777215
		while j < be.len && be[j] >> 24 < VST[v] { fr.push(VMAP[be[j] & 16777215]); j += 1 }
		if fr.len > 0 { VMAP[v] = fr.pop() } else { VMAP[v] = VN as i32; VN += 1 }
		VUSED.push(v as i32)
fg(k int): wb(0x20); ul(WO, WAR + 4 + k)
fs(k int): wb(0x21); ul(WO, WAR + 4 + k)
wsplit(k int): wb(0x44); for q 8 { wb([0, 0, 0, 2, 0, 0, 0xA0, 0x41][q]) } fg(k); wb(0xA2); fs(7); fg(7); fg(7); fg(k); wb(0xA1); wb(0xA1); fs(k + 1); fg(k); fg(k + 1); wb(0xA1); fs(k + 2)
wfma(a int, b int, c int, w int):
	fget(a, w); if w & 3 == 2 { wb(0xBB) } fs(0); fget(b, w); if w & 3 == 2 { wb(0xBB) } fs(3); fget(c, w); if w & 3 == 2 { wb(0xBB) } fs(6)
	wsplit(0); wsplit(3); fg(0); fg(3); wb(0xA2); fs(0)
	fg(1); fg(4); wb(0xA2); fg(0); wb(0xA1); fg(1); fg(5); wb(0xA2); wb(0xA0); fg(2); fg(4); wb(0xA2); wb(0xA0); fg(2); fg(5); wb(0xA2); wb(0xA0); fs(1)
	fg(0); fg(6); wb(0xA0); fs(2); fg(2); fg(0); wb(0xA1); fs(3); fg(0); fg(2); fg(3); wb(0xA1); wb(0xA1); fg(6); fg(3); wb(0xA1); wb(0xA0); fg(1); wb(0xA0); fg(2); wb(0xA0)
	if w & 3 == 2 { wb(0xB6) }
lg(v int): wb(0x20); ul(WO, wl(v))
lst(v int): wb(0x21); ul(WO, wl(v))
i64c(v int): wb(0x42); sl(WO, v)
fget(v int, w int): lg(v); if w & 3 == 3 { wb(0xBF) } else { wb(0xA7); wb(0xBE) }
fput(d int, w int): if w & 3 == 3 { wb(0xBD) } else { wb(0xBC); wb(0xAD) } lst(d)
wext(w int):
	z := w & 3; sg := w & 12 == 0
	if z == 2: if sg { wb(0xC4) } else { wb(0xA7); wb(0xAD) }
	if z == 1: if sg { wb(0xC3) } else { i64c(65535); wb(0x83) }
	if z == 0: if sg { wb(0xC2) } else { i64c(255); wb(0x83) }
waddr(a int, c int) int: lg(a); if c < 0 || c >= 1 << 31 { i64c(c); wb(0x7C); wb(0xA7); return 0 } wb(0xA7); c
wmem(op int, al int, off int): wb(op); ul(WO, al); ul(WO, off)
wcall(f int, n int): for k (n)..(WARI[f] as int) { i64c(0) } wb(0x10); ul(WO, WIMP + f)
wlocs(l int): i64c(WRO + LOCS[2 * l]); i64c(LOCS[2 * l + 1])
wtrap(k int, l int, a int, b int):
	if k == K_OOB { lg(a); lg(b); wlocs(l); wcall(RT_OOB, 4) } else if k & 255 == K_NARD { lg(a); i64c(k >> 8); wlocs(l); wcall(RT_NARD, 4) } else if k & 255 == K_OVFD { lg(a); lg(b); i64c(k >> 8); wlocs(l); wcall(RT_OVF, 5) } else { i64c(k); wlocs(l); wcall(RT_DIE, 3) }
	wb(0x00)
wif(): wb(0x04); wb(0x40)
wx(k int): if k == 2 { wb(0xBF) } else if k == 3 { wb(0xA7); wb(0xBE); wb(0xBB) } else if k != 1 { wb(0xA7) }
wi(k int): if k == 0 { wb(0xAC) } else if k == 2 { wb(0xBD) } else if k == 3 { wb(0xB6); wb(0xBC); wb(0xAD) } else if k != 1 { wb(0xAD) }
wty(o byte[>..<]&, k int): o.push(if k == 1 { 0x7E } else if k == 2 || k == 3 { 0x7C } else { 0x7F })
wimc(k int, a int, b int, d int):
	s := WIMS[k] as int; for j b { lg(ARGL[a + j] as int); wx(WIMK[s + j] as int) }
	wb(0x10); ul(WO, 1 + k); r := WIMR[k] as int
	if r < 0 { if d >= 0 { i64c(0); lst(d) } } else { wi(r); if d >= 0 { lst(d) } else { wb(0x1A) } }
var WEXI i32[>..<]; var WEXF i32[>..<]; var WEXK i8[>..<]; var WEXS i32[>..<]; var WEXR i8[>..<]
wexk(i int) int:
	k0 := WEXK.len; WEXS.push(WEXK.len as i32); for j ND[FI_[i].node].n as int { pt := ptype_of(i, j); if is_pair(pt) { WEXK.push(4); WEXK.push(4) } else { WEXK.push(wkind(pt) as i8) } }
	rt := FI_[i].ret as int; vr := rt >= 0 && rt != T_VOID && TY[rt].k != TY_VOID; if vr && (is_agg(rt) || is_pair(rt)) { WEXK.resize(k0); WEXS.pop(); return -1 } WEXR.push(if vr { wkind(rt) as i8 } else { -1 }); WEXK.len - k0
wgad(c int): if TLSM { wb(0x23); ul(WO, 1); i64c(c); wb(0x7C) } else { i64c(WGB + c) }
var WSD int[>..<]; var WSB byte[>..<]; var WSL int[>..<]
wseg(dst int, b const byte[:]): WSD.push(dst); WSL.push(b.len); WSB.append(b)
wovf(c int, w int, l int, a int, b int):
	if l < 0: return
	k := if DBG { K_OVFD | c << 8 | w << 16 } else { K_OVF }
	if w & 3 == 3:
		if c == B_ADD { lg(a); lg(-2); wb(0x85); lg(b); lg(-2); wb(0x85); wb(0x83); i64c(0); wb(0x53) }
		if c == B_SUB { lg(a); lg(b); wb(0x85); lg(a); lg(-2); wb(0x85); wb(0x83); i64c(0); wb(0x53) }
		if c == B_MUL { lg(a); i64c(-1); wb(0x51); lg(b); i64c(1 << 63); wb(0x51); wb(0x71); lg(-2); i64c(1); lg(a); lg(a); wb(0x50); lg(a); i64c(-1); wb(0x51); wb(0x72); wb(0x1B); wb(0x7F); lg(b); wb(0x52); lg(a); i64c(0); wb(0x52); wb(0x71); lg(a); i64c(-1); wb(0x52); wb(0x71); wb(0x72) }
	else:
		lg(-2); lg(-2); wext(w); wb(0x52)
	wif(); wtrap(k, l, a, b); wb(0x0B)
wbt(): wb(0x40)
wfcmp(c int, w int): d := w & 3 == 3; wb([if d { 0x61 } else { 0x5B }, if d { 0x62 } else { 0x5C }, if d { 0x63 } else { 0x5D }, if d { 0x64 } else { 0x5E }, if d { 0x65 } else { 0x5F }, if d { 0x66 } else { 0x60 }][c])
wcc(c int): wb(if c == CC_E { 0x51 } else if c == CC_NE { 0x52 } else if c == CC_L { 0x53 } else if c == CC_GE { 0x59 } else if c == CC_LE { 0x57 } else if c == CC_G { 0x55 } else if c == CC_B { 0x54 } else if c == CC_AE { 0x5A } else if c == CC_BE { 0x58 } else { 0x56 })
wfop(w int, f int, d int): wb(if w & 3 == 3 { d } else { f })
wins(i int):
	x := IR[i]; op := x.op as int; w := x.w as int; d := x.d as int; a := x.a as int; b := x.b as int; c := x.c; l := x.l as int
	if op == I_NOP || op == I_LBL || op == I_JMP || op == I_BZ || op == I_BNZ: return
	if op == I_IMM: i64c(c); lst(d); return
	if op == I_MOV: lg(a); lst(d); return
	if op == I_EXT: lg(a); wext(w); lst(d); return
	if op == I_PARAM: wb(0x20); ul(WO, c); lst(d); return
	if op == I_SLOT: wb(0x20); ul(WO, WFP); i64c(c); wb(0x7C); lst(d); return
	if op == I_GADDR: wgad(c as int); lst(d); return
	if op == I_RADDR: i64c(WRO + c); lst(d); return
	if op == I_FADDR: i64c(c); lst(d); return
	if op == I_BIN:
		if c == B_DIV || c == B_MOD:
			if l >= 0: lg(b); wb(0x50); wif(); wtrap(K_DIV0, l, a, b); wb(0x0B)
			lg(b); i64c(-1); wb(0x51); wif()
			if c == B_DIV { i64c(0); lg(a); wb(0x7D) } else { i64c(0) } lst(-2)
			wb(0x05); lg(a); lg(b); wb(if c == B_DIV { 0x7F } else { 0x81 }); lst(-2)
			wb(0x0B)
			if c == B_MOD:
				lg(-2); i64c(0); wb(0x53); wif(); lg(b); i64c(0); wb(0x53); wif(); lg(-2); lg(b); wb(0x7D); lst(-2); wb(0x05); lg(-2); lg(b); wb(0x7C); lst(-2); wb(0x0B); wb(0x0B)
			if c == B_DIV && l >= 0 && w & 3 == 3: lg(b); i64c(-1); wb(0x51); lg(a); i64c(1 << 63); wb(0x51); wb(0x71); wif(); wtrap(K_DOVF, l, a, b); wb(0x0B)
			if c == B_DIV && l >= 0 && w & 3 != 3 && DBG: lg(-2); lg(-2); wext(w); wb(0x52); wif(); wtrap(K_OVF, l, a, b); wb(0x0B)
			lg(-2); wext(w); lst(d); return
		if (c == B_UDIV || c == B_UMOD) && l >= 0: lg(b); wb(0x50); wif(); wtrap(K_DIV0, l, a, b); wb(0x0B)
		lg(a); lg(b); wb([0x7C, 0x7D, 0x7E, 0, 0, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x80, 0x82][c]); lst(-2)
		if c <= B_MUL && l >= 0: wovf(c as int, w, l, a, b); lg(-2); lst(d); return
		lg(-2); wext(w); lst(d); return
	if op == I_CMP: lg(a); lg(b); wcc(c as int); wb(0xAD); lst(d); return
	if op == I_UN:
		if c == 0:
			i64c(0); lg(a); wb(0x7D); lst(-2)
			if l >= 0: if w & 3 == 3 { lg(a); i64c(1 << 63); wb(0x51) } else { lg(-2); lg(-2); wext(w); wb(0x52) } wif(); wtrap(K_OVF, l, a, -1); wb(0x0B)
			lg(-2); if l < 0 { wext(w) } lst(d); return
		if c == 1: lg(a); i64c(-1); wb(0x85); wext(w); lst(d); return
		lg(a); i64c(1); wb(0x85); lst(d); return
	if op == I_BCHK: lg(a); lg(b); wb(0x5A); wif(); wtrap(K_OOB, l, a, b); wb(0x0B); return
	if op == I_CHK:
		k := if c != 0 { K_NARD | (c as int) << 8 } else { K_NARROW }
		if c & 2 != 0 { wtrap(k, l, a, -1) } else { lg(a); lg(a); wext(w); wb(0x52); wif(); wtrap(k, l, a, -1); wb(0x0B) }
		if d >= 0: lg(a); lst(d)
		return
	if op == I_LD:
		z := w & 3; sg := w & 12 == 0; o := waddr(a, c as int)
		wmem(if z == 3 { 0x29 } else if z == 2 { if sg { 0x34 } else { 0x35 } } else if z == 1 { if sg { 0x32 } else { 0x33 } } else { if sg { 0x30 } else { 0x31 } }, z, o); lst(d); return
	if op == I_ST: z := w & 3; o := waddr(a, c as int); lg(b); wmem([0x3C, 0x3D, 0x3E, 0x37][z], z, o); return
	if op == I_CALL:
		if c < -1: wimc(-2 - c as int, a, b, d); return
		if c < 0: wb(0x00); return
		for k b: lg(ARGL[a + k] as int)
		wcall(c as int, b); if l >= 0 { lst(l) } else { wb(0x1A) } if d >= 0 { lst(d) } else { wb(0x1A) } return
	if op == I_CALLR:
		if l < -1: wb(0x00); return
		for k b: lg(ARGL[a + k] as int)
		lg(c as int); wb(0xA7); wb(0x11); ul(WO, b); ul(WO, 0); if l >= 0 { lst(l) } else { wb(0x1A) } if d >= 0 { lst(d) } else { wb(0x1A) } return
	if op == I_SYS:
		if c == 2: o := waddr(ARGL[a + 1] as int, 0); lg(ARGL[a] as int); wb(0xFE); wmem(0x42, 3, o); lst(d); return
		for k 7: if k < b { lg(ARGL[a + k] as int) } else { i64c(0) }
		wb(0x10); ul(WO, 0); lst(d); return
	if op == I_RET: wret(a, b); return
	if op == I_FBIN: fget(a, w); fget(b, w); wfop(w, [0x92, 0x93, 0x94, 0x95][c], [0xA0, 0xA1, 0xA2, 0xA3][c]); fput(d, w); return
	if op == I_FCMP: fget(a, w); fget(b, w); wfcmp(c as int, w); wb(0xAD); lst(d); return
	if op == I_CVT:
		if c == 1 || c == 2: lg(a); wfop(w, if c == 1 { 0xB4 } else { 0xB5 }, if c == 1 { 0xB9 } else { 0xBA }); fput(d, w); return
		if c == 3: fget(a, 10); wb(0xBB); fput(d, 11); return
		if c == 4: fget(a, 11); wb(0xB6); fput(d, 10); return
		if c == 7: lg(a); i64c(if w & 3 == 2 { 1 << 31 } else { 1 << 63 }); wb(0x85); lst(d); return
		if c == 5:
			fget(a, w); if w & 3 == 2 { wb(0xBB) } wb(0xBD); lst(-3)
			lg(-3); wb(0xBF); wb(0xFC); ul(WO, 6); lst(-2)
			lg(-3); wb(0xBF); lg(-3); wb(0xBF); wb(0x62); lg(-3); wb(0xBF); wb(0x44); for q 8 { wb([0, 0, 0, 0, 0, 0, 0xE0, 0x43][q]) } wb(0x66); wb(0x72); wif(); i64c(1 << 63); lst(-2); wb(0x0B)
			lg(-2); i64c(1 << 63); wb(0x51); wif(); lg(-3); wcall(RT_F2I, 1); wb(0x1A); lst(-2); wb(0x0B)
			lg(-2); lst(d); return
		wb(0x00); return
	if op == I_FUN:
		if c >= 7: lg(a); wb(if c == 7 { 0x79 } else if c == 8 { 0x7A } else { 0x7B }); lst(d); return
		if c >= 1 && c <= 4: fget(a, w); wfop(w, [0, 0x8E, 0x8D, 0x8F, 0x91][c], [0, 0x9C, 0x9B, 0x9D, 0x9F][c]); fput(d, w); return
		if c == 5:
			fget(a, w); wfop(w, 0x8F, 0x9D); fput(-2, w)
			fget(a, w); fget(-2, w); wfop(w, 0x93, 0xA1); wfop(w, 0x8B, 0x99); if w & 3 == 3 { wb(0x44); for q 8 { wb([0, 0, 0, 0, 0, 0, 0xE0, 0x3F][q]) } } else { wb(0x43); for q 4 { wb([0, 0, 0, 0x3F][q]) } } wfop(w, 0x60, 0x66)
			wif(); fget(-2, w); if w & 3 == 3 { wb(0x44); for q 8 { wb([0, 0, 0, 0, 0, 0, 0xF0, 0x3F][q]) } } else { wb(0x43); for q 4 { wb([0, 0, 0x80, 0x3F][q]) } } fget(a, w); wfop(w, 0x98, 0xA6); wfop(w, 0x92, 0xA0); fput(-2, w); wb(0x0B)
			lg(-2); lst(d); return
		if c == 6: wfma(a, b, l, w); fput(d, w); return
		wb(0x00); return
	if op == I_COPY: lg(d); wb(0xA7); lg(a); wb(0xA7); lg(b); wb(0xA7); wb(0xFC); ul(WO, 10); wb(0); wb(0); return
	if op == I_ZERO: lg(d); wb(0xA7); wb(0x41); sl(WO, 0); lg(b); wb(0xA7); wb(0xFC); ul(WO, 11); wb(0); return
	if op == I_DSS || op == I_DSR:
		if MUSE[a] == 0: return
		so := MSLOT[a] as int
		if op == I_DSS { wb(0x20); ul(WO, WFP); wb(0xA7); wgad(DSN); wb(0xA7); wmem(0x29, 3, 0); wmem(0x37, 3, so) } else { wgad(DSN); wb(0xA7); wb(0x20); ul(WO, WFP); wb(0xA7); wmem(0x29, 3, so); wmem(0x37, 3, 0) }
		return
	wb(0x00)
wret(a int, b int):
	if WSBA > 0: wb(0x20); ul(WO, WFP); i64c(WSBA); wb(0x7C); wb(0x24); ul(WO, 0)
	if a >= 0 { lg(a) } else { i64c(0) } if b >= 0 { lg(b) } else { i64c(0) } wb(0x0F)
wcfg(fi int):
	f := NFS[fi]; BS.clear(); BE.clear(); i ~= f.i0 as int; s ~= i
	while i < f.i1:
		op := IR[i].op as int
		if op == I_LBL && i > s: BS.push(s as i32); BE.push(i as i32); s = i
		if op == I_JMP || op == I_BZ || op == I_BNZ || op == I_RET: BS.push(s as i32); BE.push((i + 1) as i32); s = i + 1
		i += 1
	if s < f.i1 { BS.push(s as i32); BE.push(f.i1) }
	n := BS.len
	for k n: j ~= BS[k] as int; while j < BE[k] { if IR[j].op as int == I_LBL { WLB[IR[j].c as int] = k as i32 } else if IR[j].op as int != I_NOP { break } j += 1 }
