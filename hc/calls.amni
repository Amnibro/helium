recursive fn ck_args(n int, a0n int, first int) int {
	let start = ARGW.len;
	if first >= 0 { ARGW.push(at(first) as i32); DIDX.push(first as i32); }
	for i in ND[n].n { let c = kid(n, i); let t = ck(c, -1); ARGW.push((if is_amp(c) && TY[t].k != TY_REF && !is_pending(t) { t_ref(t, 0) } else { t }) as i32); DIDX.push(c as i32); }
