}
recursive fn try_case(n int, name int, s int, an int, blk int, bown int) int {
	for j in an {
		let a0 = ARGW[s + j] as int; let d = deref(a0);
		if TY[d].k != TY_ENUM { continue; }
		let ei = TY[d].a as int; let vn = ENI[ei].vnum as int;
		var ok = vn > 0; var ins i32[>..<] = [];
		for vi in vn { if ok { let vt = t_variant(ei, vi); var inst = case_inst(n, name, s, an, j, vt, blk, bown); if inst < 0 { inst = case_inst(n, name, s, an, j, t_ref(vt, 0), blk, bown); } if inst < 0 { ok = false; } else { ins.push(inst as i32); } } }
		ARGW[s + j] = a0 as i32;
		if !ok { continue; }
		let d0 = DSPL.len; DSPL.push(j as i32); DSPL.append(ins[..]);
		let i0 = DSPL[d0 + 1] as int;
