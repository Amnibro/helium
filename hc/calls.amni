			if b >= 0 && !(b == B_FORMAT && user_format(n)) && !(b != B_FORMAT && b != B_PRINT && b != B_STR && user_fn_n(name, ND[n].n as int)) { return ck_builtin(n, b, -1, want); }
			let mb = member_of(nm(name));
