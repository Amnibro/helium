recursive fn call_inst(n int, i int) int {
	defer_err(i);
	let s = ck_args(n, 0, -1);
	for j in ND[n].n { let c = kid(n, j); if j < FI_[i].pn as int { conv(c, ptype_of(i, j)); } }
	pop_args(s);
	note_caps_of(i); note_edge(i);
