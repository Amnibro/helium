fn sck_has(v int) bool { var k = 0; while k < SCK.len { if SCK[k] as int == v && SCK[k + 1] as int == AOWN { return true; } k += 2; } false }
recursive fn slit_infer(n int, sn int) int {
	var gn i32[..16] = []; gen_names(ND[sn].d as int, gn); var args i32[..16] = []; for g in gn { args.push(-1); }
	let items = flat_items(n); let sa = AOWN; let m0 = SCOPE.len; let g0 = GB.len; let named = items.len > 0 && ND[items[0]].s >= 0; var fpos = 0; var k = 0;
	while k < items.len { let fi = items[k] as int; let inst = items[k + 1] as int; k += 2; SCOPE.pop_n(SCOPE.len - m0); GB.pop_n(GB.len - g0); AOWN = sa; if inst != sa { cf_chain(inst, sa); }
		var fd = -1; if named { let fnm = cf_acc(ND[fi].s as int); for q in ND[sn].n { let f = kid(sn, q); if (ND[f].fl & 4) == 0 && ND[f].s as int == fnm { fd = f; } } } else { var c = 0; for q in ND[sn].n { let f = kid(sn, q); if (ND[f].fl & 4) == 0 { if c == fpos { fd = f; } c++; } } fpos++; }
		if fd < 0 { continue; } let ta = ND[fd].a as int;
		if ta >= 0 && ND[ta].k == N_TNAME && ND[ta].n == 0 { for g, gi in gn { if ND[ta].s == g && args[gi] < 0 { let v = ND[fi].a as int; let vt = ck(v, -1); args[gi] = (if is_pending(vt) { default_t(v) } else { vt }) as i32; SCK.push(v as i32); SCK.push(AOWN as i32); } } } }
	SCOPE.pop_n(SCOPE.len - m0); GB.pop_n(GB.len - g0); AOWN = sa;
	for a in args { if a < 0 { return -1; } }
	t_struct(inst_struct(sn, args[..]))
}
recursive fn ck_slit(n int, want int) int {
	let x = ND[n];
	let tnode = x.a as int;
	let ns = ns_of(n);
	var t = -1;
	if ND[tnode].k == N_TNAME && ND[tnode].n == 0 && gb_find(ND[tnode].s as int) < 0 {
		let d = lookup_q(ND[tnode].s as int, ns, D_STRUCT);
		if d >= 0 && ND[DC[d].node].d >= 0 { if want >= 0 && TY[want].k == TY_STRUCT && STI[TY[want].a].node == DC[d].node { t = want; } else { t = slit_infer(n, DC[d].node as int); } }
	}
	if t < 0 { t = rtype(tnode, ns); }
	var si = -1;
	if TY[t].k == TY_STRUCT { si = TY[t].a as int; }
	if TY[t].k == TY_VARIANT { si = ENV[(ENI[TY[t].a].v0 as int) + (TY[t].c as int)].si as int; }
	if si < 0 { if TY[t].k != TY_ERR { cerr(n, "not a struct type"); } return set_t(n, T_ERRT); }
	let nf = STI[si].fnum as int;
	let items = flat_items(n); let sa = AOWN; let m0 = SCOPE.len; let g0 = GB.len;
	let named = items.len > 0 && ND[items[0]].s >= 0;
	var fpos = 0; var k = 0;
	while k < items.len {
		let fi = items[k] as int; let inst = items[k + 1] as int; k += 2;
		SCOPE.pop_n(SCOPE.len - m0); GB.pop_n(GB.len - g0); AOWN = sa; if inst != sa { cf_chain(inst, sa); }
		var idx = -1;
		if named { idx = sfield(si, cf_acc(ND[fi].s as int)); if idx < 0 { var m byte[>..] = []; format(m, "no field ", nm(cf_acc(ND[fi].s as int)), " in ", tn(t)); cerr(fi, m); continue; } }
		else { while fpos < nf && SFI[(STI[si].f0 as int) + fpos].ty < 0 { fpos++; } idx = fpos; fpos++; if idx >= nf { cerr(fi, "too many initializers"); continue; } }
		let ft = SFI[(STI[si].f0 as int) + idx].ty as int;
		set_r(fi, R_FIELD, idx);
		let v = ND[fi].a as int;
		if !sck_has(v) { ck(v, ft); } conv(v, ft);
	}
	SCOPE.pop_n(SCOPE.len - m0); GB.pop_n(GB.len - g0); AOWN = sa;
	for j in nf {
		let f = SFI[(STI[si].f0 as int) + j];
		if f.ty < 0 { continue; }
		let gn, gi = sl_given(n, j); let given = gn >= 0;
		if !given && f.def >= 0 { let sa = AOWN; AOWN = GLOBI; ck(f.def as int, f.ty as int); conv(f.def as int, f.ty as int); AOWN = sa; }
		if !given && f.def < 0 && (x.fl & 1) == 0 && !is_opt(f.ty as int) { var m byte[>..] = []; format(m, "missing field ", nm(f.name as int), " in ", tn(t)); cerr(n, m); }
	}
	set_r(n, R_CTOR, si);
	set_t(n, t)
}
var XROOTS i32[>..];
fn check_program() bool {
	GLOBI = new_inst(-1, 0, ND.len, -1);
	FI_[GLOBI].st = 2;
	AOWN = GLOBI; CFN = GLOBI;
	let md = lookup(intern("main"), -1, D_FN);
	if md < 0 { cerr(0, "no main function"); return false; }
	for d, i in DC { if d.k as int == D_GLOBAL && d.file == 0 { global_type(i); } }
	let mi = get_inst(DC[md].node as int, BINDS.len, 0, -1, -1);
	for r in XROOTS { let d = lookup(r as int, -1, D_FN); if d >= 0 { get_inst(DC[d].node as int, BINDS.len, 0, -1, -1); } }
	for d, i in DC { if d.k as int == D_GLOBAL { global_type(i); } }
	propagate_calls();
	NERR == 0
}
