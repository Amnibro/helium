	let ck_ = ND[cal].k as int;
	if ck_ == N_ID {
		let name = ND[cal].s as int;
		let v0 = find_lv(name);
		let v = if v0 >= 0 && (LVS[v0].fl & LV_CFB) != 0 { -1 } else { v0 };
