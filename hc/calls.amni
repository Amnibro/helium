		for j in np { imp_tv(ND[kid(fnode, j)].a as int, ns_of(fnode), b0); }
		for j in np { let p = kid(fnode, j); if ND[p].a < 0 { BINDS.push(Gb { upname(p) as i32, -1 }); } }
		if tyargs >= 0 { for j in min(ND[tyargs].n as int, BINDS.len - b0) { BINDS[b0 + j].ty = rtype(kid(tyargs, j), ns) as i32; } }
		for j in ap { let p = kid(fnode, j); let a = ARGW[a0 + j] as int; AMPA = is_amp(DIDX[a0 + j] as int) && TY[a].k == TY_REF; if !is_pending(a) { if ND[p].a >= 0 { match_ty(ND[p].a as int, a, b0); } else { for q in b0..BINDS.len { if BINDS[q].name as int == upname(p) && BINDS[q].ty < 0 { BINDS[q].ty = (if AMPA || TY[a].k == TY_REF && has_rel(deref(a)) { a } else { let dv = deref_val(a); if TY[dv].k != TY_SLICE && !is_fixed(dv) && names_store(DIDX[a0 + j] as int) { t_ref(dv, 0) } else { dv } }) as i32; } } } } AMPA = false; }
		for j in ap { let p = kid(fnode, j); let a = ARGW[a0 + j] as int; if is_pending(a) { let dt = if TY[a].k == TY_ARRLIT { arrlit_default(DIDX[a0 + j] as int) } else { pend_default(a) }; if ND[p].a >= 0 { match_ty(ND[p].a as int, dt, b0); } else { for q in b0..BINDS.len { if BINDS[q].name as int == upname(p) && BINDS[q].ty < 0 { BINDS[q].ty = dt as i32; } } } } }
		var ok = true;
		for k in ex { let g = xcall(fnode, ntya, k); for q in b0..BINDS.len { if BINDS[q].name as int == g { BINDS[q].ty = T_FNV as i32; } } }
		for q in b0..BINDS.len { if BINDS[q].ty < 0 { if bg >= 0 && BINDS[q].name as int == bg { BINDS[q].ty = T_FNV as i32; } else { ok = false; } } }
		if !ok { BINDS.pop_n(BINDS.len - b0); continue; }
		let g0 = GB.len;
		for q in b0..BINDS.len { GB.push(BINDS[q]); }
		let fns = ns_of(fnode);
		var worst = 0;
