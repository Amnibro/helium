	set_t(n, if FI_[i].ret >= 0 { FI_[i].ret as int } else { T_VOID })
}
fn note_caps_of(i int) {
	for c in CAPS { if c.inst as int == i { let v = c.lv as int; if LVS[v].cfn as int != CFN { note_cap(v); } } }
}
recursive fn case_inst(n int, name int, s int, an int, j int, t int, blk int, bown int) int {
	ARGW[s + j] = t as i32;
	let fnode, b0, bn = resolve(n, name, ns_of(n), s, an, blk, ND[n].c as int, false);
	let inst = if fnode >= 0 { get_inst(fnode, b0, bn, blk, if blk >= 0 { bown } else { AOWN }) } else { -1 };
	BINDS.pop_n(BINDS.len - b0);
