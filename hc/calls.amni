	if b == B_FREES || b == B_REALLOCS { let c = arg(1); ck(c, t_slice(e, true)); conv(c, t_slice(e, true)); if b == B_FREES { return set_t(n, T_VOID); } ck(arg(2), T_I64); conv(arg(2), T_I64); return set_t(n, t_slice(e, false)); }
	set_t(n, T_ERRT)
}
