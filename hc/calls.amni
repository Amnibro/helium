import check;
import pkg;
let B_PRINT = 1; let B_STR = 2; let B_FORMAT = 3; let B_ASSERT = 4; let B_ABORT = 5; let B_EXIT = 6; let B_COPY = 7; let B_DEFAULT = 8; let B_LEN = 9;
let B_PUSH = 20; let B_APPEND = 21; let B_POP = 22; let B_POPN = 23; let B_RESIZE = 24; let B_CLEAR = 25; let B_INDEXOF = 26; let B_CAP = 27;
let B_TOBYTES = 30; let B_BYTESOF = 31; let B_FROMBYTES = 32; let B_EMBED = 33; let B_EMBEDSH = 48;
let B_SPAWN = 40; let B_SPAWNC = 41; let B_TWAIT = 42; let B_HWT = 43; let B_QPUT = 44; let B_QGET = 45; let B_QPOLL = 46; let B_QLIMIT = 47;
let B_ALLOCI = 34; let B_ALLOCR = 35; let B_FREE = 36; let B_ALLOCS = 37; let B_FREES = 38; let B_REALLOCS = 39;
struct NF { name i32, node i32, inst i32, own i32 }
var NESTS NF[>..<];
var CANDS i32[>..<];
var BINDS Gb[>..<];
var DSPL i32[>..<];
var TSP i32[>..<];
var FNA i8[>..<];
fn fna(n int) int { if n < FNA.len { FNA[n] as int } else { 0 } }
struct XBe { inst i32, g i32, p i32 }
var XB XBe[>..<]; var XBS i32[>..<];
fn xb_same(i int, xb const i32[:]) bool { var c = 0; for e in XB { if e.inst as int == i { if c + 3 > xb.len || e.g != xb[c] || FI_[e.p].blk != xb[c + 1] || FI_[e.p].bown != xb[c + 2] { return false; } c += 3; } } c == xb.len }
var RANKS i32[>..<];
var DIDX i32[>..<];
fn builtin_of(name const byte[:]) int {
	if name == "print" { return B_PRINT; } if name == "str" { return B_STR; } if name == "format" { return B_FORMAT; } if name == "assert" { return B_ASSERT; }
	if name == "abort" { return B_ABORT; } if name == "exit" { return B_EXIT; } if name == "copy" { return B_COPY; } if name == "default" { return B_DEFAULT; }
	if name == "to_bytes" { return B_TOBYTES; } if name == "bytes_of" { return B_BYTESOF; } if name == "from_bytes" { return B_FROMBYTES; } if name == "embed_file" { return B_EMBED; } if name == "embed_shader" { return B_EMBEDSH; }
	if name == "len" { return B_LEN; }
	if name == "thread_spawn" { return B_SPAWN; } if name == "thread_spawn_contained" { return B_SPAWNC; } if name == "thread_wait" { return B_TWAIT; } if name == "hardware_threads" { return B_HWT; }
	if name == "qput" { return B_QPUT; } if name == "qget" { return B_QGET; } if name == "qpoll" { return B_QPOLL; } if name == "qlimit" { return B_QLIMIT; }
	-1
}
fn member_of(name const byte[:]) int {
	if name == "push" { return B_PUSH; } if name == "append" { return B_APPEND; } if name == "pop" { return B_POP; } if name == "pop_n" { return B_POPN; }
	if name == "resize" { return B_RESIZE; } if name == "clear" { return B_CLEAR; } if name == "index_of" { return B_INDEXOF; } if name == "len" { return B_LEN; }
	if name == "alloc_index" { return B_ALLOCI; } if name == "alloc_ref" { return B_ALLOCR; } if name == "free" { return B_FREE; }
	if name == "alloc_slice" { return B_ALLOCS; } if name == "free_slice" { return B_FREES; } if name == "realloc_slice" { return B_REALLOCS; }
	-1
}
var FREEM bool;
fn user_fn_n(name int, k int) bool { var d = dmap(name); while d >= 0 { if DC[d].k as int == D_FN && !is_std_node(DC[d].node as int) && ND[DC[d].node].n as int == k { return true; } d = DC[d].next as int; } false }
fn has_fn(name int) bool { var d = dmap(name); while d >= 0 { if DC[d].k as int == D_FN { return true; } d = DC[d].next as int; } false }
fn find_nest(name int) int { var i = NESTS.len - 1; while i >= 0 { if NESTS[i].name as int == name && visible(NESTS[i].own as int) { return i; } i--; } -1 }
recursive fn decl_nested(n int) {
	if ND[n].d >= 0 { ngen_decl(n); return; }
	var i = -1;
	for f in NESTS { if f.node as int == n && f.own as int == AOWN { i = f.inst as int; } }
	if i < 0 { i = new_inst(n, n, NEND[n] as int, AOWN); NESTS.push(NF { ND[n].s, n as i32, i as i32, AOWN as i32 }); sig_inst(i); }
	let e0 = CERR.len; let ne = NERR; let f0 = FI_.len; check_inst(i);
	if NERR > ne && e0 == 0 { var m byte[>..] = []; m.append(CERR[..]); CERR.clear(); NERR = ne; let mi = intern(m[..]); DEFE.push(i as i32); DEFM.push(mi as i32); for j in f0..FI_.len { DEFE.push(j as i32); DEFM.push(mi as i32); } }
}
var DEFE i32[>..<]; var DEFM i32[>..<];
fn defer_err(i int) { for e, k in DEFE { if e as int == i { NERR++; if CERR.len == 0 { CERR.append(nm(DEFM[k] as int)); } } } }
var NGD i32[>..<]; var NGO i32[>..<];
fn ngen_decl(c int) { for k in NGD.len { if DC[NGD[k]].node as int == c && NGO[k] as int == AOWN { return; } } dadd(D_FN, c, node_file(c), ND[c].s as int); NGD.push((DC.len - 1) as i32); NGO.push(AOWN as i32); }
fn ngok(d int) bool { for k in NGD.len { if NGD[k] as int == d { return visible(NGO[k] as int); } } true }
recursive fn pre_decl_block_fns(b int) int {
	let m = NESTS.len;
	for q in ND[b].n { let c = kid(b, q); if ND[c].k as int == N_FN && ND[c].d >= 0 { ngen_decl(c); continue; } if ND[c].k as int == N_FN { let i = new_inst(c, c, NEND[c] as int, AOWN); NESTS.push(NF { ND[c].s, c as i32, i as i32, AOWN as i32 }); sig_inst(i); } }
	m
}
fn pop_block_fns(m int) { if NESTS.len > m { NESTS.pop_n(NESTS.len - m); } }
fn propagate_calls() {
	var changed = true;
	while changed {
		changed = false;
		for e in CEDGES {
			let cr = e.caller as int; let ce = e.callee as int;
			if FI_[ce].lr && !FI_[cr].lr { FI_[cr].lr = true; changed = true; }
			for c in CAPS { if c.inst as int == ce { let v = c.lv as int; if visible_in(LVS[v].own as int, cr) || LVS[v].cfn as int != cr { if add_cap_one(cr, v) { changed = true; } } } }
		}
	}
}
fn gen_list(fnode int) int { ND[fnode].d as int }
fn is_blockparam(fnode int, gname int) bool {
	for i in ND[fnode].n { let p = kid(fnode, i); if ND[p].a >= 0 && mentions(ND[p].a as int, gname) { return false; } }
	true
}
recursive fn mentions(t int, g int) bool {
	if t < 0 { return false; }
	let x = ND[t]; let k = x.k as int;
	if k == N_TNAME { if x.s as int == g { return true; } for i in x.n { if mentions(kid(t, i), g) { return true; } } return false; }
	if k == N_TARR || k == N_TSLICE || k == N_TREF || k == N_TCONST || k == N_TVAR { return mentions(x.a as int, g); }
	false
}
fn blk_gen(fnode int) int { let gl = gen_list(fnode); if gl < 0 { return -1; } var r = -1; for i in ND[gl].n { let g = ND[kid(gl, i)].s as int; if is_blockparam(fnode, g) { r = g; } } r }
fn xcall(fnode int, ntya int, k int) int { let gl = gen_list(fnode); if gl < 0 { return -1; } let bg = blk_gen(fnode); var c = 0; for i in ND[gl].n { let g = ND[kid(gl, i)].s as int; if i >= ntya && g != bg && is_blockparam(fnode, g) { if c == k { return g; } c += 1; } } -1 }
fn bref(q int) int { let a = ARGW[q] as int; if is_pending(a) || TY[a].k == TY_REF { return a; } let dv = deref_val(a); let k = ND[DIDX[q]].k as int; if TY[dv].k != TY_SLICE && !is_fixed(dv) && (k == N_ID || k == N_DOT || k == N_IDX) { t_ref(dv, 0) } else { a } }
fn upname(p int) int { var s byte[>..] = []; s.push('$'); s.append(nm(ND[p].s as int)); intern(s) }
recursive fn match_ty(tn0 int, t0 int, g0 int) bool {
	if tn0 < 0 { return true; }
	let x = ND[tn0]; let k = x.k as int;
	let t = deref(t0);
	if k == N_TNAME {
		if x.n == 0 {
			for i in g0..BINDS.len { if BINDS[i].name == x.s { if BINDS[i].ty < 0 { BINDS[i].ty = (if AMPA && TY[t0].k == TY_REF { t0 } else { deref_val(t) }) as i32; } return true; } }
			return true;
		}
		if TY[t].k == TY_STRUCT { let si = TY[t].a as int; if STI[si].tn == x.n { for i in x.n { match_ty(kid(tn0, i), TYL[(STI[si].ta as int) + i] as int, g0); } } }
		if TY[t].k == TY_ENUM { let ei = TY[t].a as int; if ENI[ei].tn == x.n { for i in x.n { match_ty(kid(tn0, i), TYL[(ENI[ei].ta as int) + i] as int, g0); } } }
		return true;
	}
	if k == N_TARR || k == N_TSLICE { if TY[t].k == TY_ARR || TY[t].k == TY_SLICE { let et = TY[t].a as int; let en = ND[x.a]; if en.k as int == N_TNAME && en.n == 0 && TY[et].k == TY_REF { for i in g0..BINDS.len { if BINDS[i].name == en.s { if BINDS[i].ty < 0 { BINDS[i].ty = et as i32; } return true; } } } return match_ty(x.a as int, et, g0); } if TY[t].k == TY_STRLIT { return match_ty(x.a as int, T_U8, g0); } return true; }
	if k == N_TREF { if TY[t0].k == TY_REF { return match_ty(x.a as int, TY[t0].a as int, g0); } return match_ty(x.a as int, t, g0); }
	if k == N_TCONST { return match_ty(x.a as int, t0, g0); }
	true
}
recursive fn arg_rank(n int, a int, p int) int {
	if p < 0 { return 1; }
	if a == p { return 0; }
	let ak = TY[a].k as int; let pk = TY[p].k as int;
	if pk == TY_ERR || ak == TY_ERR { return 0; }
	if pk == TY_REF && TY[p].c < 0 && (TY[p].fl & RF_OPT) == 0 { let tgt = TY[p].a as int; if deref(a) == tgt { return 0; } if ak == TY_ILIT || ak == TY_FLIT { return arg_rank(n, a, tgt); } return -1; }
	if ak == TY_REF && TY[a].c < 0 { let d = TY[a].a as int; if d == p { return 0; } if pk == TY_REF && (TY[p].fl & RF_OPT) != 0 && TY[p].a == TY[a].a { return 0; } return arg_rank(n, d, p); }
	if ak == TY_ILIT {
		let v, u, ok = cval(n);
		if pk == TY_INT { if !ok || int_fits(v, u, p) || bn_ad(n) && !is_signed(p) { return 2; } return -1; }
		if pk == TY_FLT { return 3; }
		if pk == TY_VARINT { return 2; }
		return -1;
	}
	if ak == TY_FLIT { if pk == TY_FLT { return if TY[p].s == 8 { 1 } else { 2 }; } return -1; }
	if ak == TY_STRLIT { if pk == TY_SLICE && TY[p].a as int == T_U8 { return 0; } if is_byte_arr(p) { return 2; } return -1; }
	if ak == TY_ARRLIT && ND[n].k as int != N_ARR { let x = ND[n]; let nk = x.k as int; var w = 0; if nk == N_IF { for b in [x.b, x.c] { if b >= 0 && !ends(b as int) { let r = arg_rank(b as int, at(b as int), p); if r < 0 { return -1; } w = max(w, r); } } return w; } if nk == N_MATCH { for i in x.n { let b = ND[kid(n, i)].b as int; if b >= 0 && !ends(b) { let r = arg_rank(b, at(b), p); if r < 0 { return -1; } w = max(w, r); } } return w; } if (nk == N_BLOCK || nk == N_EBLOCK) && x.a >= 0 { return arg_rank(x.a as int, at(x.a as int), p); } return -1; }
	if ak == TY_ARRLIT { if pk != TY_ARR && pk != TY_SLICE { return -1; } let x = ND[n]; if x.c >= 0 { return 2; } if x.a >= 0 { return if arg_rank(x.a as int, at(x.a as int), TY[p].a as int) < 0 { -1 } else { 2 }; } for i in x.n { if arg_rank(kid(n, i), at(kid(n, i)), TY[p].a as int) < 0 { return -1; } } return 2; }
	if ak == TY_NULL { if pk == TY_REF && (TY[p].fl & RF_OPT) != 0 { return 0; } return -1; }
	if pk == TY_REF && (TY[p].fl & RF_OPT) != 0 && TY[p].a as int == a { return 0; }
	if ak == TY_INT && pk == TY_FLT { return 3; }
	if widens(a, p) { return 2; }
	if pk == TY_SLICE && (ak == TY_ARR || ak == TY_SLICE) && TY[a].a == TY[p].a { return 2; }
	if pk == TY_ENUM && ak == TY_VARIANT && TY[a].a == TY[p].a { return 2; }
	if pk == TY_ARR && (ak == TY_ARR || ak == TY_SLICE) && TY[a].a == TY[p].a && is_construct(n) { return 2; }
	-1
}
recursive fn sig_inst(i int) {
	let node = FI_[i].node as int;
	let ns = ns_of(node);
	let g0 = GB.len;
	for j in FI_[i].gn { GB.push(GBS[(FI_[i].g0 as int) + j]); }
	let p0 = TYL.len;
	var pts i32[..128] = [];
	for j in ND[node].n {
		let p = kid(node, j);
		var t = -1;
		if ND[p].a >= 0 { t = decode_rel(rtype(ND[p].a as int, ns)); } else { t = gb_find(upname(p)); if t < 0 { t = T_ERRT; } }
		pts.push(t as i32);
	}
	FI_[i].p0 = TYL.len as i32; TYL.append(pts[..]); FI_[i].pn = pts.len as i32;
	if ND[node].b >= 0 {
		let rl = ND[node].b as int;
		if ND[rl].n == 1 { FI_[i].ret = decode_rel(rtype(kid(rl, 0), ns)) as i32; }
		else { var rs i32[..64] = []; for j in ND[rl].n { let r0 = rtype(kid(rl, j), ns); rs.push(r0 as i32); } FI_[i].ret = tlist(TY_MULTI, rs[..], -1) as i32; }
	} else { FI_[i].ret = -1; FI_[i].rinf = true; if (ND[node].fl & F_EXTERN) != 0 || surely_void(node) { FI_[i].ret = T_VOID as i32; FI_[i].rinf = false; } }
	GB.pop_n(GB.len - g0);
}
fn surely_void(fnode int) bool {
	let body = ND[fnode].c as int;
	if body < 0 { return true; }
	let tl = ND[body].a as int;
	tail_void(tl) && !has_valret(body)
}
recursive fn tail_void(tl int) bool {
	if tl < 0 { return true; }
	let x = ND[tl]; let k = x.k as int;
	if k == N_WHILE || k == N_FOR || k == N_RET || k == N_BREAK || k == N_CONT { return true; }
	if k == N_IF { return x.c < 0 || (tail_void(x.b as int) && tail_void(x.c as int)); }
	if k == N_BLOCK { return tail_void(x.a as int); }
	false
}
recursive fn has_valret(n int) bool {
	if n < 0 { return false; }
	let x = ND[n]; let k = x.k as int;
	if k == N_RET { return x.n > 0 && x.s < 0; }
	if k == N_FN || k == N_CFOR { return k == N_CFOR && has_valret(x.c as int); }
	if k == N_INT || k == N_FLT || k == N_STR || k == N_ID { return false; }
	if k >= 40 && k < 50 { return false; }
	if has_valret(x.a as int) || has_valret(x.b as int) || has_valret(x.c as int) || has_valret(x.d as int) { return true; }
	if k == N_BLOCK || k == N_CALL || k == N_MATCH || k == N_ARM || k == N_LIST || k == N_ARR || k == N_SLIT || k == N_RET { for i in x.n { if has_valret(kid(n, i)) { return true; } } }
	false
}
fn ptype_of(i int, j int) int { TYL[(FI_[i].p0 as int) + j] as int }
recursive fn rets_to(node int, f int, inner bool) bool {
	var j = node + 1; let e = NEND[node] as int;
	while j < e { let x = ND[j]; let k = x.k as int; if k == N_FN { if rets_to(j, f, true) { return true; } j = NEND[j] as int; continue; } if k == N_RET && (x.s as int == f || x.s < 0 && !inner) { return true; } j += 1; } false
}
recursive fn check_inst(i int) {
	if FI_[i].st != 0 { return; }
	let node = FI_[i].node as int;
	FI_[i].st = 1;
	if (ND[node].fl & F_EXTERN) != 0 { let sa0 = AOWN; let sc0 = CFN; AOWN = i; CFN = i; for j in ND[node].n { let p = kid(node, j); if ND[p].b >= 0 { let pt = ptype_of(i, j); ck(ND[p].b as int, pt); conv(ND[p].b as int, pt); } } AOWN = sa0; CFN = sc0; FI_[i].st = 2; return; }
	let sa = AOWN; let sc = CFN; let sm = SCOPE.len; let ld = LOOPD; let bt = BRK_T.len; let nm0 = NESTS.len;
	AOWN = i; CFN = i; LOOPD = 0;
	let g0 = GB.len;
	for j in FI_[i].gn { GB.push(GBS[(FI_[i].g0 as int) + j]); }
	for j in ND[node].n { let p = kid(node, j); if ND[p].b >= 0 { let pt = ptype_of(i, j); ck(ND[p].b as int, pt); conv(ND[p].b as int, pt); } }
	var lm = 0;
	for j in FI_[i].gn { let g = GBS[(FI_[i].g0 as int) + j]; if g.name as int == LPN { lm = g.ty as int; } }
	for j in ND[node].n { let p = kid(node, j); let v = add_lv(ND[p].s as int, ptype_of(i, j), LV_PARAM | (if (ND[p].fl & 1) != 0 { LV_VAR } else { 0 }) | (if ((lm >> j) & 1) != 0 { LV_LIT } else { 0 }), p); set_r(p, R_LOCAL, v); }
	let body = ND[node].c as int;
	let rt = FI_[i].ret as int;
	let t = ck(body, if rt >= 0 { rt } else { -1 });
	FI_[i].nc = ends(body) && !rets_to(node, FI_[i].name as int, false);
	let tail = ND[body].a as int;
	if rt >= 0 { if tail >= 0 && rt != T_VOID && t != T_VOID && !ends(tail) { conv(tail, rt); } }
	else {
		if FI_[i].ret < 0 { if tail >= 0 && t != T_VOID { let rr = ref_res(tail, default_t(tail)); FI_[i].ret = rr as i32; if TY[rr].k == TY_REF { conv(tail, rr); } } else { FI_[i].ret = T_VOID as i32; } }
		else { if tail >= 0 && t != T_VOID && FI_[i].ret as int != T_VOID { conv(tail, FI_[i].ret as int); } }
	}
	GB.pop_n(GB.len - g0);
	SCOPE.pop_n(SCOPE.len - sm); NESTS.pop_n(NESTS.len - nm0);
	while BRK_T.len > bt { BRK_T.pop(); }
	AOWN = sa; CFN = sc; LOOPD = ld;
	FI_[i].st = 2;
}
recursive fn imp_tv(t int, ns int, b0 int) {
	if t < 0 { return; }
	let x = ND[t]; let k = x.k as int;
	if k == N_TARR || k == N_TSLICE || k == N_TREF || k == N_TCONST { imp_tv(x.a as int, ns, b0); return; }
	if k != N_TNAME { return; }
	if x.n > 0 { for i in x.n { imp_tv(kid(t, i), ns, b0); } return; }
	for q in b0..BINDS.len { if BINDS[q].name == x.s { return; } }
	if lookup_q(x.s as int, ns, D_STRUCT) >= 0 || lookup_q(x.s as int, ns, D_ENUM) >= 0 || lookup_q(x.s as int, ns, D_ALIAS) >= 0 { return; }
	BINDS.push(Gb { x.s, -1 });
}
fn tv_name(fnode int, p int) int {
	let tn = ND[p].a as int;
	if tn < 0 { return upname(p); }
	if ND[tn].k as int != N_TNAME || ND[tn].n != 0 { return -1; }
	let gl = gen_list(fnode);
	if gl >= 0 { for j in ND[gl].n { if ND[kid(gl, j)].s == ND[tn].s { return ND[tn].s as int; } } }
	-1
}
fn lit_mask(fnode int, s int, an int) int {
	var m = 0;
	for j in min(an, ND[fnode].n as int) {
		let k = TY[ARGW[s + j] as int].k as int;
		let v = tv_name(fnode, kid(fnode, j));
		let an_ = DIDX[s + j] as int;
		if (k != TY_ILIT && k != TY_FLIT && !is_lp(an_)) || v < 0 || j > 30 { continue; }
		var typed = false;
		for q in min(an, ND[fnode].n as int) { if q != j && !is_pending(ARGW[s + q] as int) && tv_name(fnode, kid(fnode, q)) == v { typed = true; } }
		if !typed { m |= 1 << j; }
	}
	m
}
fn same_binds(i int, b0 int, bn int) bool {
	if FI_[i].gn as int != bn { return false; }
	for j in bn { if GBS[(FI_[i].g0 as int) + j].ty != BINDS[b0 + j].ty || GBS[(FI_[i].g0 as int) + j].name != BINDS[b0 + j].name { return false; } }
	true
}
fn on_chain(i int, b int) bool { var j = b; while j >= 0 { if j == i { return true; } j = if FI_[j].bown >= 0 { FI_[j].bown as int } else { FI_[j].par as int }; } false }
recursive fn get_inst(node int, b0 int, bn int, blk int, bown int) int {
	let par = if (ND[node].fl & F_NESTED) != 0 { AOWN } else { -1 };
	var xb i32[>..<] = []; xb.append(XBS[..]); XBS.clear();
	for f, i in FI_ { if f.node as int == node && f.blk as int == blk && (blk == -1 && (!f.dy || on_chain(i, bown)) || f.bown as int == bown) && f.par as int == par && same_binds(i, b0, bn) && xb_same(i, xb[..]) && !DEFE.contains(i as i32) { return i; } }
	let i = new_inst(node, node, NEND[node] as int, par);
	FI_[i].g0 = GBS.len as i32;
	for j in bn { GBS.push(BINDS[b0 + j]); }
	FI_[i].gn = bn as i32;
	FI_[i].blk = blk as i32; FI_[i].bown = bown as i32;
