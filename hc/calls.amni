		for i in total { let c = arg(i); let t = if recv >= 0 && i == 0 { at(c) } else { ck(c, -1) }; if is_pending(t) { default_t(c); } hook_walk(fin_t(c)); }
		return set_t(n, if b == B_STR { t_arr(T_U8, A_GROW, -1, -1) } else { T_VOID });
	}
	if b == B_FORMAT {
		let o = arg(0);
		if recv < 0 { ck(o, -1); }
		if pend_local(o) { complete(o, T_U8); }
		for i in 1..total { let c = arg(i); let t = ck(c, -1); if is_pending(t) { default_t(c); } hook_walk(fin_t(c)); }
		return set_t(n, T_VOID);
	}
