	if b == B_APPEND { let c = arg(1); let t = ck(c, t_slice(e, true)); if TY[t].k == TY_STRLIT { set_t(c, TT_STR); } else { if TY[t].k == TY_ARRLIT { conv(c, t_arr(e, A_GROW, -1, -1)); } else { let dt = deref(t); if (TY[dt].k == TY_ARR || TY[dt].k == TY_SLICE) && TY[dt].a as int != e { cerr(c, "append of a different element type"); } } } return set_t(n, T_VOID); }
