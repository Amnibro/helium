}
recursive fn ck_spawn(n int) int {
	let x = ND[n];
	if x.n == 0 || ND[kid(n, 0)].k as int != N_ID { cerr(n, "thread_spawn needs a thread_fn"); return set_t(n, T_ERRT); }
	let wn = kid(n, 0);
	var wnm = ND[wn].s as int;
	let wb = block_binding(wnm);
	if wb >= 0 && FI_[wb].blk < -1 { wnm = -2 - FI_[wb].blk as int; }
	let s = ARGW.len;
	for i in 1..x.n { let c = kid(n, i); ARGW.push(ck(c, -1) as i32); DIDX.push(c as i32); }
	let an = x.n as int - 1;
	let fnode, b0, bn = resolve(n, wnm, ns_of(n), s, an, -1, -1, false);
	if fnode < 0 || (ND[fnode].fl & F_THREAD) == 0 { BINDS.pop_n(BINDS.len - b0); pop_args(s); var m byte[>..] = []; format(m, "no thread_fn ", nm(ND[wn].s as int), " matches these arguments"); cerr(n, m); return set_t(n, T_ERRT); }
	let inst = get_inst(fnode, b0, bn, -1, AOWN);
	BINDS.pop_n(BINDS.len - b0);
	for j in an { let c = DIDX[s + j] as int; conv(c, ptype_of(inst, j)); }
	pop_args(s);
	note_edge(inst);
	TSP.push(n as i32); TSP.push(AOWN as i32); TSP.push(inst as i32);
	set_t(n, T_I64)
}
recursive fn call_fn(n int, name int, recv int, want int) int {
	let s = ck_args(n, 0, recv);
	var an = ARGW.len - s;
	var blk = ND[n].b as int;
	var bown = AOWN;
	if blk < 0 && an > 0 && ARGW[s + an - 1] as int == T_FNV && ND[DIDX[s + an - 1]].k as int == N_ID {
		let fnm = ND[DIDX[s + an - 1]].s as int;
		let bg = block_binding(fnm);
		let eb = if bg >= 0 { FI_[bg].blk as int } else { -2 - fnm };
		let f2, c0, cn0 = resolve(n, name, ns_of(n), s, an - 1, eb, ND[n].c as int, false);
		BINDS.pop_n(BINDS.len - c0);
		if f2 >= 0 { an--; blk = eb; bown = if bg >= 0 { FI_[bg].bown as int } else { AOWN }; while FNA.len <= n { FNA.push(0); } FNA[n] = 1; }
	}
	let fnode, b0, bn = resolve(n, name, ns_of(n), s, an, blk, ND[n].c as int, true);
	if fnode < 0 { BINDS.pop_n(BINDS.len - b0); let dr = try_case(n, name, s, an, blk, bown); if dr >= 0 { pop_args(s); return dr; } }
	if fnode < 0 {
		var m byte[>..] = []; format(m, "no function ", nm(name), " matches (");
		for j in an { if j > 0 { m.append(", "); } m.append(tn(ARGW[s + j] as int)); }
		m.append(")");
		cerr(n, m);
		pop_args(s);
		BINDS.pop_n(BINDS.len - b0);
		return set_t(n, T_ERRT);
	}
	let np0 = ND[fnode].n as int;
	if an > np0 { let ntya = if ND[n].c >= 0 { ND[ND[n].c].n as int } else { 0 }; for k in an - np0 { let fnm = ND[DIDX[s + np0 + k]].s as int; let bg2 = block_binding(fnm); XBS.push(xcall(fnode, ntya, k) as i32); XBS.push((if bg2 >= 0 { FI_[bg2].blk as int } else { -2 - fnm }) as i32); XBS.push((if bg2 >= 0 { FI_[bg2].bown as int } else { AOWN }) as i32); } while FNA.len <= n { FNA.push(0); } FNA[n] = (fna(n) + an - np0) as i8; an = np0; }
	let lm = lit_mask(fnode, s, an);
	if lm != 0 { BINDS.push(Gb { LPN as i32, lm as i32 }); }
	let inst = get_inst(fnode, b0, BINDS.len - b0, blk, bown);
	BINDS.pop_n(BINDS.len - b0);
	for j in an { let c = DIDX[s + j] as int; let pt = ptype_of(inst, j); if pt >= 0 && TY[pt].k == TY_REF && (TY[pt].fl & RF_OPT) == 0 && TY[pt].c < 0 { if is_pending(at(c)) { conv(c, TY[pt].a as int); } } else { conv(c, pt); } }
	pop_args(s);
	note_caps_of(inst); note_edge(inst);
	set_r(n, R_FN, inst);
	let rt = FI_[inst].ret as int;
	if rt < 0 && FI_[inst].st == 1 && n == STMTN { return set_t(n, T_VOID); }
	if rt < 0 { if FI_[inst].st == 1 { var m byte[>..] = []; format(m, "recursive call to ", nm(name), " needs its result type written"); cerr(n, m); } return set_t(n, T_ERRT); }
	set_t(n, rt)
}
fn is_gname(name int) bool { var i = AOWN; while i >= 0 { let f = FI_[i]; for q in (f.g0 as int)..((f.g0 + f.gn) as int) { if GBS[q].name as int == name { return true; } } i = f.par as int; } false }
recursive fn shlit(a int) int {
	let k = ND[a].k as int; if k == N_STR { return a; } if k != N_ID { return -1; }
	let v = ND[a].s as int; if find_lv(v) >= 0 || is_gname(v) { return -1; }
	let d = lookup(v, ns_of(a), D_GLOBAL); if d < 0 { return -1; } let x = ND[DC[d].node]; if (x.fl & V_VAR) != 0 || x.b < 0 { return -1; }
	let iv = kid(x.b as int, 0); if ND[iv].k as int == N_STR { iv } else { if ND[iv].k as int == N_ID && iv != a { shlit(iv) } else { -1 } }
}
fn has_nl(s const byte[:]) bool { for c in s { if c == '\n' { return true; } } false }
recursive fn ck_shader(n int, total int, recv int) int {
	var ls i32[>..] = []; var nmd i32[>..] = [];
	for i in total { let c = if recv >= 0 { if i == 0 { recv } else { kid(n, i - 1) } } else { kid(n, i) }; let l = shlit(c); if l < 0 { cerr(c, "embed_shader takes string literals, and let or const globals initialized with one"); return set_t(n, T_ERRT); } ls.push(l as i32); nmd.push((if l != c { 1 } else { 0 }) as i32); ck(c, TT_STR); default_t(c); }
	if ls.len == 0 { cerr(n, "embed_shader takes a shader file's path, or a stage and its source"); return set_t(n, T_ERRT); }
	let cf = node_file(n); var callf byte[>..] = []; callf.append(nm(FILES[cf].name as int)); var err byte[>..] = []; var m byte[>..] = [];
	if ls.len == 1 {
		var v byte[>..] = []; v.append(tok_str(ND[ls[0]].t as int));
		if has_nl(v[..]) { cerr(n, "embed_shader(\"x.frag\") takes a shader file's path; shader source follows its stage: embed_shader(\"frag\", source)"); return set_t(n, T_ERRT); }
		var path byte[>..] = []; if v.len > 0 && v[0] == '/' { path.append(v[..]); } else { var sl = -1; for c, i in callf { if c == '/' { sl = i; } } if sl >= 0 { path.append(callf[..sl + 1]); } path.append(v[..]); }
		let st = if path.len > 5 && path[^5..] == ".vert" { 0 } else { if path.len > 5 && path[^5..] == ".frag" { 1 } else { if path.len > 5 && path[^5..] == ".comp" { 2 } else { -1 } } };
		if st < 0 { format(m, "embed_shader: cannot tell the shader stage of ", path[..], ": the extension must be .vert, .frag or .comp"); cerr(n, m[..]); return set_t(n, T_ERRT); }
		var src byte[>..] = []; if !read_file(path[..], src) { format(m, "embed_shader: cannot open shader file: ", path[..]); cerr(n, m[..]); return set_t(n, T_ERRT); }
		if !shader_compile(n, st, path[..], src[..], err) { format(m, "embed_shader: ", err[..]); cerr(n, m[..]); return set_t(n, T_ERRT); }
		return set_t(n, TT_STR);
	}
	let sn = tok_str(ND[ls[0]].t as int); let st = if sn == "vert" { 0 } else { if sn == "frag" { 1 } else { if sn == "comp" { 2 } else { -1 } } };
	if st < 0 { format(m, "embed_shader: the stage is \"vert\", \"frag\" or \"comp\", not \"", sn, "\""); cerr(ls[0] as int, m[..]); return set_t(n, T_ERRT); }
	var src byte[>..] = []; var starts i32[>..] = [];
	for k in 1..ls.len { if k > 1 { src.push('\n'); } var nl = 1; for c in src { if c == '\n' { nl++; } } starts.push(nl as i32); src.append(tok_str(ND[ls[k]].t as int)); }
	if shader_compile(n, st, callf[..], src[..], err) { return set_t(n, TT_STR); }
	var line = 0; var p = callf.len + 1; var at_us = err.len > callf.len && err[..callf.len] == callf[..] && err[callf.len] == ':';
	if at_us { while p < err.len && err[p] >= '0' && err[p] <= '9' { line = line * 10 + (err[p] - '0') as int; p++; } }
	let sep = if line > 0 { ": error: " } else { " " }; at_us = at_us && err.len >= p + sep.len && err[p..p + sep.len] == sep;
	if !at_us { format(m, "embed_shader: ", err[..]); cerr(n, m[..]); return set_t(n, T_ERRT); }
	let msg = err[p + sep.len..];
	if line == 0 { format(m, "embed_shader: ", msg); cerr(n, m[..]); return set_t(n, T_ERRT); }
	var part = 0; for s0, k in starts { if s0 as int <= line { part = k; } }
	let lit = ls[part + 1] as int; let lv = tok_str(ND[lit].t as int); var at = TK[ND[lit].t].line as int;
	if has_nl(lv) { var lines = 1; for c in lv { if c == '\n' { lines++; } } at += min(line - starts[part] as int + 1, lines); }
	format(m, "embed_shader: ", msg); if nmd[part + 1] != 0 { format(m, " (in the shader embedded at ", callf[..], ":", TK[ND[n].t].line, ")"); }
	cerrl(TK[ND[lit].t].f as int, at, m[..]); set_t(n, T_ERRT)
}
recursive fn ck_builtin(n int, b int, recv int, want int) int {
	let x = ND[n];
	set_r(n, R_BUILTIN, b);
	let fm = FREEM; FREEM = false;
	set_x(n, if fm { 2 } else { if recv >= 0 { 1 } else { 0 } });
	let na = x.n as int;
	fn arg(i int) int { if recv >= 0 && !fm { if i == 0 { recv } else { kid(n, i - 1) } } else { kid(n, i) } }
