	if b == B_HWT { return set_t(n, T_I64); }
	if b == B_QPUT { let c = arg(0); var t = ck(c, -1); if is_pending(t) { t = default_t(c); } let d = deref(t); if d != t { set_cv(c, d); } return set_t(n, T_BOOL); }
	if b == B_QGET || b == B_QPOLL || b == B_QLIMIT {
