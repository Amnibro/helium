	if a == -2 { var d = dmap(b); while d >= 0 { if DC[d].k as int == D_FN { if ngok(d) { CANDS.push(d as i32); } } d = DC[d].next as int; } return; }
	if ns >= 0 { var d = dmap(qual(ns, name)); while d >= 0 { if DC[d].k as int == D_FN { if ngok(d) { CANDS.push(d as i32); } } d = DC[d].next as int; } }
	var d = dmap(name);
	while d >= 0 { if DC[d].k as int == D_FN { if ngok(d) { CANDS.push(d as i32); } } d = DC[d].next as int; }
}
fn is_std_node(node int) bool { let f = node_file(node); let sp = lib_path("std"); nm(FILES[f].name) == sp[..] }
recursive fn resolve(n int, name int, ns int, a0 int, an int, blk int, tyargs int, report bool) int, int, int {
	let c0 = CANDS.len;
	cands_add(name, ns);
	var best = -1; var bestr = 99; var bestb0 = -1; var bestbn = 0; var tie = false; var bestuser = false;
	let nb0 = BINDS.len;
	for ci in c0..CANDS.len {
		let fnode = DC[CANDS[ci]].node as int;
		let np = ND[fnode].n as int;
		var nreq = 0;
		for j in np { if ND[kid(fnode, j)].b < 0 { nreq = j + 1; } }
		if an < nreq { continue; }
		let ntya = if tyargs >= 0 { ND[tyargs].n as int } else { 0 }; let ex = max(an - np, 0);
		if ex > 0 { var xok = true; for k in ex { if ARGW[a0 + np + k] as int != T_FNV || xcall(fnode, ntya, k) < 0 { xok = false; } } if !xok { continue; } }
