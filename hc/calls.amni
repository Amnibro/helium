fn untyped_any(f int) bool { for j in ND[f].n { if ND[kid(f, j)].a < 0 { return true; } } false }
var AMPA bool;
fn is_amp(c int) bool { ND[c].k as int == N_UN && ND[c].op as int == T_AND || ND[c].k as int == N_ID && rk(c) == R_LOCAL && TY[LVS[AV[aix(c)] as int].ty as int].k == TY_REF }
fn deref_val(a int) int { let d = deref(a); if TY[d].k == TY_STRLIT { TT_STR } else { if TY[d].k == TY_VARIANT { t_enum(TY[d].a as int, false) } else { d } } }
fn arrlit_default(n int) int { let x = ND[n]; let el = if x.a >= 0 { x.a as int } else { if x.n > 0 { kid(n, 0) } else { -1 } }; if el < 0 { return T_ARRLIT; } let et = at(el); let e = if TY[et].k == TY_ARRLIT { arrlit_default(el) } else { pend_default(et) }; if TY[e].k == TY_ARRLIT { T_ARRLIT } else { t_slice(deref_val(e), false) } }
