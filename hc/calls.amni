recursive fn ck_defs(t int) { if t < 0 { return; } let k = TY[t].k as int; if k == TY_ENUM { if ENI[TY[t].a].vnum > 0 { ck_defs(t_variant(TY[t].a as int, 0)); } return; } if k == TY_ARR { ck_defs(TY[t].a as int); return; } let si = if k == TY_STRUCT { TY[t].a as int } else { if k == TY_VARIANT { ENV[(ENI[TY[t].a].v0 as int) + (TY[t].c as int)].si as int } else { -1 } }; if si < 0 { return; } for j in STI[si].fnum { let f = SFI[(STI[si].f0 as int) + j]; if f.ty < 0 { continue; } if f.def >= 0 { if at(f.def as int) < 0 { let sa = AOWN; AOWN = GLOBI; ck(f.def as int, f.ty as int); conv(f.def as int, f.ty as int); AOWN = sa; } } else { ck_defs(f.ty as int); } } }
recursive fn user_format(n int) bool { if ND[n].n == 0 { return false; } let t = deref(ck(kid(n, 0), -1)); if pend_local(kid(n, 0)) { return false; } !(TY[t].k == TY_ARR && TY[t].a as int == T_U8 && (is_grow(t) || TY[t].s as int == A_LIM)) }
fn is_grow(t int) bool { TY[t].s as int == A_GROW || TY[t].s as int == A_GS }
var HOOK i32[>..];
var HOOKW u8[>..];
var NAME_FORMAT int = -1;
recursive fn hook_res(k int, ei int, ns int, s int) int, int, int { let f1, b1, n1 = resolve(0, NAME_FORMAT, ns, s, 2, -1, -1, false); if f1 >= 0 || k != TY_VARIANT { return f1, b1, n1; } BINDS.pop_n(BINDS.len - b1); ARGW[s + 1] = t_enum(ei, false) as i32; resolve(0, NAME_FORMAT, ns, s, 2, -1, -1, false) }
recursive fn hook_of(t int) int {
