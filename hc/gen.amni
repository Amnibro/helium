		if r == R_LOCAL { let fc = (LVS[rv(n)].fl & LV_FLET) != 0 && at(n) != (LVS[rv(n)].ty as int); if fc { ow("(("); ct(at(n)); ow(")"); } lv_expr(rv(n)); if fc { ow(")"); } return; }
