	if k == TY_VARIANT { let v = ENV[(ENI[x.a].v0 as int) + (x.c as int)]; if v.si >= 0 { for i in STI[v.si].fnum { let f = SFI[(STI[v.si].f0 as int) + i]; if f.ty >= 0 { comp_one(f.ty as int, fmt); } } } }
	if k == TY_ENUM { let ei = x.a as int; for i in ENI[ei].vnum { let v = ENV[(ENI[ei].v0 as int) + i]; if v.si >= 0 && !STI[v.si].zero { if fmt { for j in STI[v.si].fnum { let f = SFI[(STI[v.si].f0 as int) + j]; if f.ty >= 0 { comp_one(f.ty as int, fmt); } } } else { gen_heq(t_variant(ei, i)); } } } }
	if k == TY_ARR || k == TY_SLICE { comp_one(x.a as int, fmt); }
