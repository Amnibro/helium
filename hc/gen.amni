import calls;
var O byte[>..<];
var TF byte[>..<]; var TD byte[>..<]; var PR byte[>..<]; var GL byte[>..<]; var GI byte[>..<]; var HF byte[>..<];
var CN byte[>..]; var CNO i32[>..]; var CNL i32[>..]; var CST u8[>..];
var HFN u8[>..]; var HEQ u8[>..];
var TDS byte[>..<];
var SCR byte[>..<];
var TMPN int;
var GCF int = -1;
var LSTK i32[>..<]; var LRES i32[>..<];
var GERR byte[>..];
let INTC = ["int8_t", "int16_t", "int32_t", "int64_t", "uint8_t", "uint16_t", "uint32_t", "uint64_t"];
fn ow(s const byte[:]) { O.append(s); }
fn oi(v i64) { format(O, v); }
fn gerr(n int, m const byte[:]) { if GERR.len > 0 { return; } let x = TK[ND[max(n, 0)].t]; GERR.append(nm(FILES[x.f].name)); format(GERR, ":", x.line, ": error: ", m); }
fn cn_grow() { while CNO.len < TY.len { CNO.push(-1); CNL.push(0); CST.push(0); HFN.push(0); HEQ.push(0); } }
fn fwd(s0 int) { TF.append("typedef struct "); TF.append(CN[s0..]); TF.push(' '); TF.append(CN[s0..]); TF.append(";\n"); }
fn is_res(t int) bool { TY[t].k == TY_ARR && (TY[t].s as int == A_GROW || TY[t].s as int == A_GS) }
fn is_lim(t int) bool { TY[t].k == TY_ARR && TY[t].s as int == A_LIM && TY[t].b >= 0 }
fn is_vimg(t int) bool { t >= 0 && TY[t].k == TY_ARR && (TY[t].s as int == A_VAR || (TY[t].s as int == A_LIM && TY[t].b < 0)) }
fn vlim(t int) int { if TY[t].s as int == A_LIM { 1 } else { 0 } }
fn vargs(t int) { format(O, ", ", isz(TY[t].c as int), ", ", vlim(t)); }
fn vok(n int, t int) bool { if TY[t].c == 8 { gerr(n, "varint array lengths are not supported by the self-hosted compiler yet"); return false; } if !is_fixed(TY[t].a as int) && !is_vval(TY[t].a as int) { gerr(n, "arrays of these variable-size elements are not supported by the self-hosted compiler yet"); return false; } if is_seq(t) && vlim(t) == 1 { gerr(n, "limited arrays need fixed-size elements"); return false; } true }
fn is_seq(t int) bool { (TY[t].k == TY_ARR || TY[t].k == TY_SLICE) && is_vval(TY[t].a as int) }
var DSU = 0;
var HRG byte[>..];
var HRS byte[>..];
var HRL byte[>..];
var TW byte[>..];
var TWD i8[>..];
var QTY i32[>..];
fn qid(t int) int { for q, i in QTY { if q as int == t { return i; } } QTY.push(t as i32); QTY.len - 1 }
var RELM = false;
var RELQ i32[>..];
var EFW i8[>..];
var EBD i8[>..];
var VSTC i8[>..];
recursive fn is_vst(t int) bool { if t < 0 || TY[t].k != TY_STRUCT { return false; } while VSTC.len < TY.len { VSTC.push(0); } if VSTC[t] != 0 { return VSTC[t] == 1; } si_layout(TY[t].a as int); var r = false; if STI[TY[t].a].cls as int == CL_VAR && ND[STI[TY[t].a].node].k as int == N_STRUCT { let f0 = STI[TY[t].a].f0 as int; for i in STI[TY[t].a].fnum { let ft = SFI[f0 + i].ty as int; if ft >= 0 && (is_vimg(ft) || is_vst(ft)) { r = true; } } } VSTC[t] = if r { 1 } else { 2 }; r }
fn is_vval(t int) bool { is_vimg(t) || is_vst(t) }
var PKD i8[>..];
var VZD i8[>..];
var VOD i8[>..];
fn pk_need(t int) { while PKD.len < TY.len { PKD.push(0); } if PKD[t] != 0 { return; } PKD[t] = 1; cbody(t); TD.append("typedef struct { "); TD.append(cn(t)); format(TD, " v; } PK", t, ";\n"); }
recursive fn vz_into(b byte[..512]&, t int, p const byte[:]) {
	if is_vimg(t) && is_seq(t) { gen_vzs(t); format(b, "vzs", t, "(", p, ")"); return; }
	if is_vimg(t) { format(b, "hr_vszf(", p, ", ", isz(TY[t].c as int), ", ", vlim(t), ", sizeof("); b.append(cn(TY[t].a as int)); b.append("))"); return; }
	if is_vst(t) { gen_vz(t); format(b, "vz", t, "(", p, ")"); return; }
	format(b, "(int64_t)sizeof("); b.append(cn(t)); b.append(")");
}
recursive fn gen_vz(t int) {
	while VZD.len < TY.len { VZD.push(0); }
	if VZD[t] != 0 { return; }
	VZD[t] = 1;
	let si = TY[t].a as int; let f0 = STI[si].f0 as int;
	for i in STI[si].fnum { let ft = SFI[f0 + i].ty as int; if ft >= 0 { cbody(ft); vpre_e(ft); } }
	var sig byte[..128] = []; format(sig, "static int64_t vz", t, "(const uint8_t *p)");
	PR.append(sig[..]); PR.append(";\n");
	HF.append(sig[..]); hh(" { const uint8_t *q = p; ");
	for i in STI[si].fnum { let f = SFI[f0 + i]; if f.ty < 0 { format(HF, "q += ", max(f.padn, 0), "; "); continue; } var e byte[..512] = []; vz_into(e, f.ty as int, "q"); format(HF, "q += ", e[..], "; "); }
	hh("return q - p; }\n");
}
var VZS i8[>..];
recursive fn gen_vzs(t int) {
	while VZS.len < TY.len { VZS.push(0); }
	if VZS[t] != 0 { return; }
	VZS[t] = 1;
	let e = TY[t].a as int;
	cbody(e); if is_vst(e) { gen_vz(e); } if is_vimg(e) && is_seq(e) { gen_vzs(e); }
	var sig byte[..128] = []; format(sig, "static int64_t vzs", t, "(const uint8_t *p)");
	PR.append(sig[..]); PR.append(";\n");
	var ez byte[..512] = []; vz_into(ez, e, "q");
	HF.append(sig[..]); format(HF, " { int64_t n = hr_vget(p, ", isz(TY[t].c as int), "); const uint8_t *q = p + ", isz(TY[t].c as int), "; for (int64_t i = 0; i < n; i++) q += ", ez[..], "; return q - p; }\n");
}
fn vpre_e(e int) { if is_vst(e) { gen_vz(e); } if is_vimg(e) && is_seq(e) { gen_vzs(e); } }
recursive fn gen_vo(si int) {
	while VOD.len < STI.len { VOD.push(0); }
	if VOD[si] != 0 { return; }
	VOD[si] = 1;
	let f0 = STI[si].f0 as int;
	for i in STI[si].fnum { let ft = SFI[f0 + i].ty as int; if ft >= 0 { cbody(ft); vpre_e(ft); } }
	for i in STI[si].fnum {
		if SFI[f0 + i].ty < 0 || SFI[f0 + i].off >= 0 { continue; }
		var sig byte[..128] = []; format(sig, "static uint8_t *vo", si, "_", i, "(uint8_t *p)");
		PR.append(sig[..]); PR.append(";\n");
		HF.append(sig[..]); hh(" { uint8_t *q = p; ");
		for j in i { let f = SFI[f0 + j]; if f.ty < 0 { format(HF, "q += ", max(f.padn, 0), "; "); continue; } var e byte[..512] = []; vz_into(e, f.ty as int, "q"); format(HF, "q += ", e[..], "; "); }
		hh("return q; }\n");
	}
}
fn vpre(t int) { if (TY[t].k == TY_ARR || TY[t].k == TY_SLICE) && is_seq(t) { vpre_e(TY[t].a as int); return; } if !is_vst(t) { return; } let si = TY[t].a as int; gen_vo(si); for i in STI[si].fnum { let ft = SFI[(STI[si].f0 as int) + i].ty as int; if ft >= 0 && !is_vval(ft) { pk_need(ft); } } }
recursive fn vfa_into(b byte[..512]&, si int, i int, base const byte[:]) { let f = SFI[(STI[si].f0 as int) + i]; if f.off >= 0 { format(b, "((uint8_t*)(", base, ") + ", f.off, ")"); return; } gen_vo(si); format(b, "vo", si, "_", i, "(", base, ")"); }
recursive fn vfx_into(b byte[..512]&, si int, i int, base const byte[:]) { let ft = SFI[(STI[si].f0 as int) + i].ty as int; var a byte[..512] = []; vfa_into(a, si, i, base); if is_vval(ft) { b.append(a[..]); return; } pk_need(ft); format(b, "(((PK", ft, "*)(", a[..], "))->v)"); }
var SCR2 byte[>..];
fn is_fix(t int) bool { TY[t].k == TY_ARR && TY[t].s as int == A_FIXED }
recursive fn cn(t int) const byte[:] {
	cn_grow();
	if CNO[t] < 0 { cn_make(t); }
	let o = CNO[t] as int;
	CN[o..o + (CNL[t] as int)]
}
recursive fn cn_make(t int) {
	let x = TY[t]; let k = x.k as int;
	if k == TY_REF && x.c < 0 && is_vval(x.a as int) { let s0 = CN.len; CN.append("uint8_t*"); CNO[t] = s0 as i32; CNL[t] = (CN.len - s0) as i32; return; }
	if k == TY_REF && x.c < 0 { let e = cn(x.a as int); let s0 = CN.len; CN.append(e); CN.push('*'); CNO[t] = s0 as i32; CNL[t] = (CN.len - s0) as i32; return; }
	if k == TY_VARIANT { let v = ENV[(ENI[x.a].v0 as int) + (x.c as int)]; if v.si >= 0 { let e = cn(t_struct(v.si as int)); let s0 = CN.len; CN.append(e); CNO[t] = s0 as i32; CNL[t] = (CN.len - s0) as i32; return; } }
	let s0 = CN.len;
	if k == TY_INT { CN.append(INTC[x.s & 7]); }
	else { if k == TY_REF { CN.append(INTC[x.c & 3]); }
	else { if k == TY_BOOL { CN.append("bool"); }
	else { if k == TY_FLT { CN.append(if x.s == 4 { "float" } else { "double" }); }
	else { if k == TY_VOID { CN.append("void"); }
	else { if k == TY_STRUCT && is_vst(t) { CN.append("uint8_t*"); }
	else { if k == TY_STRUCT { format(CN, "S", x.a); fwd(s0); }
	else { if k == TY_ENUM { format(CN, "E", x.a); while EFW.len <= x.a as int { EFW.push(0); } if EFW[x.a] == 0 { EFW[x.a] = 1; fwd(s0); } }
	else { if k == TY_VARIANT { CN.append("hr_unit"); }
	else { if k == TY_ARR { let a = x.s as int; if a == A_GROW || a == A_GS { CN.append("hrv"); } else { if a == A_FIXED { format(CN, "A", t); fwd(s0); } else { if a == A_LIM && x.b >= 0 { format(CN, "L", t); fwd(s0); } else { CN.append("uint8_t*"); } } } }
	else { if k == TY_SLICE || k == TY_STRLIT || k == TY_ARRLIT { CN.append("hsl"); }
	else { if k == TY_MULTI { format(CN, "M", t); fwd(s0); }
	else { if k == TY_ILIT || k == TY_VARINT { CN.append("int64_t"); }
	else { if k == TY_FLIT { CN.append("double"); }
	else { CN.append("void*"); } } } } } } } } } } } } } }
	CNO[t] = s0 as i32; CNL[t] = (CN.len - s0) as i32;
}
fn fname_into(b byte[>..<]&, name int) { for c in nm(name) { b.push(if c == ':' { '_' } else { c }); } b.push('_'); }
recursive fn cbody(t int) {
	cn_grow();
	let x = TY[t]; let k = x.k as int;
	if k == TY_REF || CST[t] != 0 { cn(t); return; }
	CST[t] = 1;
	cn(t);
	if k == TY_VARIANT { let v = ENV[(ENI[x.a].v0 as int) + (x.c as int)]; if v.si >= 0 { cbody(t_struct(v.si as int)); } return; }
	if k == TY_STRUCT {
		let si = x.a as int; si_layout(si);
		let f0 = STI[si].f0 as int; let fnum = STI[si].fnum as int;
		for i in fnum { let ft = SFI[f0 + i].ty; if ft >= 0 { cbody(ft as int); } }
		if is_vst(t) { return; }
		TD.append("struct "); TD.append(cn(t)); TD.append(" { ");
		var any = false;
		for i in fnum {
			let f = SFI[f0 + i];
			if f.ty < 0 { if f.padn > 0 { format(TD, "uint8_t _p", i, "[", f.padn, "]; "); any = true; } continue; }
			TD.append(cn(f.ty as int)); TD.push(' '); fname_into(TD, f.name as int); TD.append("; "); any = true;
		}
		if !any { TD.append("uint8_t _e; "); }
		TD.append("};\n");
		return;
	}
	if k == TY_ENUM {
		let ei = x.a as int; ei_layout(ei);
		while EBD.len <= ei { EBD.push(0); }
		if EBD[ei] != 0 { return; }
		EBD[ei] = 1;
		let v0 = ENI[ei].v0 as int;
		var pay = false;
		for i in ENI[ei].vnum { let v = ENV[v0 + i]; if v.si >= 0 && !STI[v.si].zero { cbody(t_struct(v.si as int)); pay = true; } }
		TD.append("struct "); TD.append(cn(t)); TD.append(if ENI[ei].tagsz == 1 { " { uint8_t tag; " } else { " { uint16_t tag; " });
		if pay { TD.append("union { "); for i in ENI[ei].vnum { let v = ENV[v0 + i]; if v.si >= 0 && !STI[v.si].zero { TD.append(cn(t_struct(v.si as int))); format(TD, " v", i, "; "); } } TD.append("} u; "); }
		TD.append("};\n");
		return;
	}
	if k == TY_ARR {
		let a = x.s as int;
		if a == A_FIXED || (a == A_LIM && x.b >= 0) {
			cbody(x.a as int);
			TD.append("struct "); TD.append(cn(t)); TD.append(" { ");
			if a == A_LIM { TD.append(INTC[lim_lenstore(x.b) & 7]); TD.append(" n; "); }
			TD.append(cn(x.a as int)); format(TD, " e[", max(x.b, 1), "]; };\n");
		}
		return;
	}
	if k == TY_MULTI {
		for i in x.n { cbody(TYL[(x.l as int) + i] as int); }
		TD.append("struct "); TD.append(cn(t)); TD.append(" { ");
		for i in x.n { TD.append(cn(TYL[(x.l as int) + i] as int)); format(TD, " r", i, "; "); }
		TD.append("};\n");
	}
}
fn ct(t int) { cbody(t); ow(cn(t)); }
fn esz(t int) { ow("sizeof("); ct(t); ow(")"); }
fn wloc(n int) { let x = TK[ND[max(n, 0)].t]; ow("\""); for c in nm(FILES[x.f].name) { if c == '"' || c == '\\' { O.push('\\'); } O.push(c); } format(O, ":", x.line, "\""); }
fn tmp(t int, clean bool) int {
	cbody(t);
	TMPN++;
	TDS.append(cn(t)); format(TDS, " _t", TMPN);
	if clean { TDS.append(" __attribute__((cleanup(hr_rdrop)))"); }
	TDS.append(" = {0}; ");
	TMPN
}
fn nt() int { TMPN++; TMPN }
fn ot(k int) { format(O, "_t", k); }
fn lv_name(v int) { for c in nm(LVS[v].name as int) { O.push(if c == '$' || c == ':' { '_' } else { c }); } format(O, "_", v); }
fn lv_isptr(v int) bool { (LVS[v].fl & LV_REF) != 0 && TY[LVS[v].ty].k != TY_REF && !is_vval(LVS[v].ty as int) }
fn lv_expr(v int) {
	let p = lv_isptr(v);
	if LVS[v].cfn as int != GCF { ow(if p { "(**c" } else { "(*c" }); format(O, v, ")"); return; }
	if p { ow("(*"); lv_name(v); ow(")"); return; }
	lv_name(v);
}
fn lv_addr(v int) { if LVS[v].cfn as int != GCF { format(O, "c", v); return; } ow("&"); lv_name(v); }
fn fin(n int) int { let c = cv(n); if c >= 0 { c } else { let t = at(n); if t < 0 { T_VOID } else { t } } }
recursive fn is_place(n int) bool {
	let x = ND[n]; let k = x.k as int;
	if k == N_ID { let r = rk(n); return r == R_LOCAL || r == R_GLOBAL; }
	if k == N_DOT { if rk(n) == R_FIELD && is_vst(deref(at(x.a as int))) { return !is_vval(at(n)); } return rk(n) == R_FIELD && rel_field(n) < 0 && (is_place(x.a as int) || TY[at(x.a as int)].k == TY_REF); }
	if k == N_IDX { let bt = at(x.a as int); return TY[deref(bt)].k == TY_SLICE || is_place(x.a as int) || TY[bt].k == TY_REF; }
	if k == N_UN && x.op as int == T_AND { return is_place(x.a as int); }
	if k == N_CALL && rk(n) == R_BUILTIN && (rv(n) == B_PUSH) { return true; }
	false
}
fn owned(n int) bool { is_res(fin(n)) && !is_place(n) }
fn cstr_lit(s const byte[:]) {
	O.push('"');
	for c in s {
		if c == '"' || c == '\\' { O.push('\\'); O.push(c); }
		else { if c >= 32 && c < 127 && c != '?' { O.push(c); } else { O.push('\\'); O.push('0' + ((c >> 6) & 7)); O.push('0' + ((c >> 3) & 7)); O.push('0' + (c & 7)); } }
	}
	O.push('"');
}
fn oint(v i64, uns bool, t int) {
	let k = TY[t].k as int;
	if k == TY_FLT { ow("(("); ct(t); ow(")"); if uns { format(O, v as! u64, ".0"); } else { format(O, v, ".0"); } ow(")"); return; }
	if k == TY_BOOL { ow(if v != 0 { "true" } else { "false" }); return; }
	ow("(("); ct(if k == TY_INT { t } else { T_I64 }); ow(")");
	if uns { format(O, v as! u64, "ULL)"); return; }
	if v == -9223372036854775807 - 1 { ow("(-9223372036854775807LL-1))"); return; }
	format(O, v, "LL)");
}
recursive fn gx(n int) {
	let c = cv(n); let t = at(n);
	if c < 0 || c == t { gx1(n); return; }
	gcv(n, t, c);
}
recursive fn gx1(n int) {
	if is_res(at(n)) && !is_place(n) { let k = tmp(at(n), true); ow("(*hr_tmp(&"); ot(k); ow(", "); gx0(n); ow("))"); return; }
	gx0(n);
}
recursive fn gxo(n int) {
	let c = cv(n); let t = at(n);
	if c >= 0 && c != t { if is_res(c) { gcv(n, t, c); return; } gx(n); return; }
	if is_res(t) && is_place(n) { ow("hr_rdup("); gx0(n); ow(", "); esz(TY[t].a as int); ow(")"); return; }
	gx0(n);
}
recursive fn gaddr(n int) {
	if is_vval(deref(at(n))) { gx0(n); return; }
	if is_place(n) { ow("(&("); gx0(n); ow("))"); return; }
	let t = at(n);
	let c = cv(n);
	if c >= 0 && TY[c].k == TY_REF && TY[t].k != TY_REF {
		let pt = TY[c].a as int;
		let k = tmp(pt, is_res(pt));
		ow("("); ot(k); ow(" = ("); if pt == t { if is_res(t) { gx0(n); } else { gx1(n); } } else { gcv(n, t, pt); } ow("), &"); ot(k); ow(")");
		return;
	}
	let k = tmp(t, is_res(t));
	ow("("); ot(k); ow(" = ("); gxo(n); ow("), &"); ot(k); ow(")");
}
recursive fn gsl(n int, f int) {
	let d = deref(f);
	let k = TY[d].k as int;
	if TY[f].k == TY_REF && TY[f].c < 0 {
		let p = nt();
		ow("({ "); ct(f); ow(" _t"); oi(p); ow(" = "); gx0(n); ow("; ");
		if k == TY_SLICE { ow("*_t"); oi(p); }
		else { if is_vimg(d) { ow("hr_vsl(_t"); oi(p); vargs(d); ow(")"); }
		else { if is_res(d) { ow("hr_sl(*_t"); oi(p); ow(")"); }
		else { if is_fix(d) { ow("(hsl){ (uint8_t*)_t"); oi(p); format(O, "->e, ", TY[d].b, " }"); }
		else { ow("(hsl){ (uint8_t*)_t"); oi(p); ow("->e, _t"); oi(p); ow("->n }"); } } } }
		ow("; })");
		return;
	}
	if k == TY_SLICE || k == TY_STRLIT { gx0(n); return; }
	if is_vimg(d) { if !vok(n, d) { return; } ow("hr_vsl("); gx0(n); vargs(d); ow(")"); return; }
	if is_res(d) { ow("hr_sl("); if is_place(n) { gx0(n); } else { let tk0 = tmp(d, true); ow("*hr_tmp(&"); ot(tk0); ow(", "); gx0(n); ow(")"); } ow(")"); return; }
	let p = nt();
	ow("({ "); ct(d); ow(" *_t"); oi(p); ow(" = ");
	if is_place(n) { ow("&("); gx0(n); ow(")"); } else { let tk0 = tmp(d, false); ow("("); ot(tk0); ow(" = "); gx0(n); ow(", &"); ot(tk0); ow(")"); }
	ow("; ");
	if is_fix(d) { ow("(hsl){ (uint8_t*)_t"); oi(p); format(O, "->e, ", TY[d].b, " }"); }
	else { ow("(hsl){ (uint8_t*)_t"); oi(p); ow("->e, _t"); oi(p); ow("->n }"); }
	ow("; })");
}
recursive fn gas(n int) {
