		else { hh("for (int64_t i = 0; i < v.n; i++) { if (i) hr_fc(o, \", \"); "); var ex byte[..128] = []; ex.append("(("); ex.append(cn(e)); ex.append("*)v.p)[i]"); hf_val(e, ex[..]); hh("} "); } } }
