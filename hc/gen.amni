	let q0 = RELQ.len;
	let sm = RELM; RELM = true;
	ct(e); format(O, " _x", p, " = "); gx(c); ow("; ");
	RELM = sm;
	grel_targets(q0, p);
	ct(e); format(O, " *_p", p, " = ");
	if lim { format(O, "&_v", p, "->e[_v", p, "->n]; if (_v", p, "->n >= ", TY[rt].b, ") hr_die(\"push past a limited array's capacity\", "); wloc(n); format(O, "); _v", p, "->n++; "); }
	else { ow("("); ct(e); format(O, "*)hr_grow(_v", p, ", 1, sizeof _x", p, "); "); }
	format(O, "*_p", p, " = _x", p, "; ");
