var HOPD i64[>..];
recursive fn gen_hop(t int, o int, bt int) {
	let key = (t as i64) * 4096 + (o as i64) * 64 + (if bt == t { 0 } else { 1 });
	for h in HOPD { if h == key { return; } }
	HOPD.push(key);
	cbody(t);
	let lt = leaf_type(t);
	let sc = bt != t;
	var sig byte[..256] = [];
	format(sig, "static "); sig.append(cn(t)); format(sig, " hop", t, "_", o, "(");
	sig.append(cn(t)); sig.append(" a, "); sig.append(cn(if sc { bt } else { t })); sig.append(" b)");
	PR.append(sig[..]); PR.append(";\n");
	HF.append(sig[..]); hh(" { "); HF.append(cn(t)); hh(" r; ");
	hop_body(t, o, "r", "a", "b", sc);
	hh("return r; }\n");
}
recursive fn hop_body(t int, o int, r const byte[:], a const byte[:], b const byte[:], sc bool) {
	let k = TY[t].k as int;
	if k == TY_INT {
		let sg = is_signed(t);
		if o == T_DIV || o == T_MOD { format(HF, r, " = ", if o == T_DIV { if sg { "HR_SDIV(" } else { "HR_UDIV(" } } else { if sg { "HR_SMOD(" } else { "HR_UDIV_MOD(" } }); HF.append(cn(t)); format(HF, ", ", a, ", ", b, ", \"elementwise\"); "); return; }
		if sg && (o == T_PLUS || o == T_MINUS || o == T_MUL) { format(HF, r, " = ", if o == T_PLUS { "HR_SADD(" } else { if o == T_MINUS { "HR_SSUB(" } else { "HR_SMUL(" } }); HF.append(cn(t)); format(HF, ", ", a, ", ", b, ", \"elementwise\"); "); return; }
		if o == T_SHL || o == T_SHR { format(HF, r, " = ("); HF.append(cn(t)); format(HF, ")((", a, ") ", ar_op(o), " ((", b, ") & ", ibits(t) - 1, ")); "); return; }
		format(HF, r, " = ("); HF.append(cn(t)); format(HF, ")((uint64_t)(", a, ") ", ar_op(o), " (uint64_t)(", b, ")); "); return;
	}
	if k == TY_FLT { if o == T_MOD { format(HF, r, " = ", if TY[t].s == 4 { "fmodf(" } else { "fmod(" }, a, ", ", b, "); "); return; } format(HF, r, " = ("); HF.append(cn(t)); format(HF, ")((", a, ") ", ar_op(o), " (", b, ")); "); return; }
	if k == TY_STRUCT {
		let si = TY[t].a as int; let f0 = STI[si].f0 as int;
		for i in STI[si].fnum {
			let f = SFI[f0 + i]; if f.ty < 0 { continue; }
			var rr byte[..256] = []; var aa byte[..256] = []; var bb byte[..256] = [];
			rr.append(r); rr.push('.'); aa.append(a); aa.push('.'); bb.append(b); if !sc { bb.push('.'); }
			for ch in nm(f.name as int) { rr.push(ch); aa.push(ch); if !sc { bb.push(ch); } }
			rr.push('_'); aa.push('_'); if !sc { bb.push('_'); }
			hop_body(f.ty as int, o, rr[..], aa[..], bb[..], sc);
		}
		return;
	}
	if is_fix(t) {
		let p = nt();
		format(HF, "for (int64_t _i", p, " = 0; _i", p, " < ", TY[t].b, "; _i", p, "++) { ");
		var rr byte[..256] = []; var aa byte[..256] = []; var bb byte[..256] = [];
		format(rr, r, ".e[_i", p, "]"); format(aa, a, ".e[_i", p, "]"); if sc { bb.append(b); } else { format(bb, b, ".e[_i", p, "]"); }
		hop_body(TY[t].a as int, o, rr[..], aa[..], bb[..], sc);
		hh("} ");
	}
}
var HNEG i32[>..];
recursive fn gen_hneg(t int) {
	for h in HNEG { if h as int == t { return; } }
	HNEG.push(t as i32);
	cbody(t);
	var sig byte[..256] = [];
	format(sig, "static "); sig.append(cn(t)); format(sig, " hneg", t, "("); sig.append(cn(t)); sig.append(" a)");
	PR.append(sig[..]); PR.append(";\n");
	HF.append(sig[..]); hh(" { "); HF.append(cn(t)); hh(" z; memset(&z, 0, sizeof z); "); HF.append(cn(t)); hh(" r; ");
	hop_body(t, T_MINUS, "r", "z", "a", false);
	hh("return r; }\n");
}
fn fn_cname_to(b byte[>..<]&, i int) { format(b, "f", i, "_"); let s = FI_[i].name as int; if s >= 0 { for c in nm(s) { b.push(if c == ':' { '_' } else { c }); } } }
fn fn_cname(i int) { fn_cname_to(O, i); }
fn ext_name(i int) {
	let node = FI_[i].node as int;
	let x = ND[node].e as int;
	if x >= 0 && ND[x].a >= 0 { let s = tok_str(ND[x].a as int); if s.len > 3 && s[0] == 'g' && s[1] == 's' && s[2] == '_' { ow("hr_"); ow(s[3..]); return; } ow(s); return; }
	ow(nm(ND[node].s as int));
}
fn is_ext(i int) bool { (ND[FI_[i].node].fl & F_EXTERN) != 0 }
recursive fn gcall_args(n int, inst int, recv int) { gcall_args1(n, inst, recv, -1, 0); }
var DSPJ = -1;
var DSPV = 0;
var DSPQ = 0;
recursive fn gcase(n int) {
	let d0 = rv(n);
	let j0 = DSPL[d0] as int;
	let i0 = DSPL[d0 + 1] as int;
	let recv = if ax(n) == 1 && ND[ND[n].a].k == N_DOT { ND[ND[n].a].a as int } else { -1 };
	let na = ND[n].n as int + (if recv >= 0 { 1 } else { 0 });
	let rt = FI_[i0].ret as int;
	let vd = rt < 0 || rt == T_VOID;
	let q = nt();
	let c0 = carg(n, recv, j0);
	let et = deref(at(c0));
	let ei = TY[et].a as int;
	var lrw = false;
	ow("({ ");
	for j in na {
		if j != j0 { gcall_arg(n, i0, recv, j, true, q); continue; }
		ct(et); format(O, " *_m", q, " = ");
		var byr = false;
		for vi in ENI[ei].vnum { let pt = ptype_of(DSPL[d0 + 1 + vi] as int, j0); if TY[pt].k == TY_REF { byr = true; } }
		if byr && TY[at(c0)].k == TY_REF { gx0(c0); } else { if byr && is_place(c0) { ow("&("); gx(c0); ow(")"); } else { let k = tmp(et, false); ow("("); ot(k); ow(" = "); if TY[at(c0)].k == TY_REF { ow("*"); gx0(c0); } else { gx(c0); } ow(", &"); ot(k); ow(")"); } }
		ow("; ");
	}
	if !vd { ct(rt); format(O, " _r", q, "; "); }
	format(O, "switch (_m", q, "->tag) { ");
	let sj = DSPJ; let sv = DSPV; let sq = DSPQ;
	for vi in ENI[ei].vnum {
		let i = DSPL[d0 + 1 + vi] as int;
		if !is_ext(i) && FI_[i].lr { lrw = true; }
		format(O, "case ", vi, ": ");
		if !vd { format(O, "_r", q, " = "); }
		if is_ext(i) { ext_name(i); } else { fn_cname(i); }
		ow("(");
		DSPJ = j0; DSPV = vi; DSPQ = q;
		gcall_args1(n, i, recv, q, na);
		DSPJ = sj; DSPV = sv; DSPQ = sq;
		ow("); break; ");
	}
	ow("default: __builtin_unreachable(); } ");
	if lrw { glrcheck(); }
	if !vd { format(O, "_r", q, "; "); }
	ow("})");
}
recursive fn gcase_arg(pt int) {
	let byr = TY[pt].k == TY_REF;
	let vt = deref(pt);
	let v = ENV[(ENI[TY[vt].a].v0 as int) + DSPV];
	if v.si >= 0 && !STI[v.si].zero { if byr { ow("&"); } format(O, "_m", DSPQ, "->u.v", DSPV); return; }
	if byr { ow("&"); } ow("("); ct(vt); ow("){0}");
}
recursive fn gcall_args1(n int, inst int, recv int, op int, on int) {
	let x = ND[n];
	let np = ND[FI_[inst].node].n as int;
	let na = x.n as int + (if recv >= 0 { 1 } else { 0 });
	var first = true;
	for j in np {
		let pt = ptype_of(inst, j);
		if !first { ow(", "); }
		first = false;
		if j >= na {
			let p = kid(FI_[inst].node as int, j);
			let sa = AOWN; AOWN = inst; gx(ND[p].b as int); AOWN = sa;
			continue;
		}
		if j == DSPJ { DSPJ = -1; gcase_arg(pt); DSPJ = j; continue; }
		if j < on { format(O, "_o", op, "_", j); continue; }
		gcall_arg(n, inst, recv, j, false, 0);
	}
	for cp in CAPS { if cp.inst as int == inst { if !first { ow(", "); } first = false; lv_addr(cp.lv as int); } }
}
recursive fn gcall(n int) {
	let r = rk(n);
	if r == R_BUILTIN { gbuiltin(n); return; }
	if r == R_BLOCK { gblkcall(n); return; }
	if r == R_CASE { gcase(n); return; }
	if r != R_FN { gerr(n, "unsupported call"); return; }
	let inst = rv(n);
	let recv = if ax(n) == 1 && ND[ND[n].a].k == N_DOT { ND[ND[n].a].a as int } else { -1 };
	let lrw = !is_ext(inst) && FI_[inst].lr;
	let rt = FI_[inst].ret as int;
	let vd = rt < 0 || rt == T_VOID;
	let q = nt();
	let na = ND[n].n as int + (if recv >= 0 { 1 } else { 0 });
	var lim = 0;
	for j in 1..na { if impure(carg(n, recv, j)) { lim = j; } }
	let so = ORDP; let sn = ORDN;
	if lim > 0 { ow("({ "); for j in lim { gcall_arg(n, inst, recv, j, true, q); } ORDP = q; ORDN = lim; }
	if lrw { ow("({ "); if !vd { ct(rt); format(O, " _c", q, " = "); } }
	if is_ext(inst) { ext_name(inst); } else { fn_cname(inst); }
	ow("(");
	let po = ORDP; let pn = ORDN; ORDP = so; ORDN = sn;
	gcall_args1(n, inst, recv, po, pn);
	ow(")");
	if lrw { ow("; "); glrcheck(); if !vd { format(O, "_c", q, "; "); } ow("})"); }
	if lim > 0 { ow("; })"); }
}
var ORDP = -1;
var ORDN = 0;
fn carg(n int, recv int, j int) int { if recv >= 0 { if j == 0 { recv } else { kid(n, j - 1) } } else { kid(n, j) } }
recursive fn impure(n int) bool {
	if n < 0 || n >= ND.len { return false; }
	let x = ND[n]; let k = x.k as int;
	if k == N_FOR { return impure(x.a as int) || impure(x.b as int) || impure(x.d as int); }
	if k == N_CALL || k == N_ASSIGN || k == N_INCDEC || k == N_RET || k == N_BREAK || k == N_CONT { return true; }
	if k == N_ID || k == N_INT || k == N_FLT || k == N_STR || k == N_TRUE || k == N_FALSE || k == N_NULL || k == N_FN { return false; }
	if k == N_AS { return impure(x.a as int); }
	if impure(x.a as int) || impure(x.b as int) || impure(x.c as int) { return true; }
	for i in x.n { if impure(kid(n, i)) { return true; } }
	false
}
recursive fn gcall_arg(n int, inst int, recv int, j int, decl bool, q int) {
	let pt = ptype_of(inst, j);
	let c = carg(n, recv, j);
	let ct0 = fin(c);
	if decl { if TY[pt].k == TY_REF && TY[pt].c < 0 { ct(pt); } else { if is_res(pt) { ow("hrv"); } else { if TY[pt].k == TY_SLICE { ow("hsl"); } else { ct(pt); } } } format(O, " _o", q, "_", j, " = "); }
	if TY[pt].k == TY_REF && TY[pt].c < 0 { if TY[ct0].k == TY_REF || TY[ct0].k == TY_NULL { gx(c); } else { gaddr(c); } }
	else { if is_res(pt) { gxo(c); } else { if TY[pt].k == TY_SLICE { gas(c); } else { gx(c); } } }
	if decl { ow("; "); }
}
recursive fn gblkcall(n int) {
	let bi = rv(n);
	let fv = FI_[bi].node as int;
	let sa = AOWN;
	ow("({ ");
	let np = ND[fv].n as int;
	let na = ND[n].n as int;
	if (ND[fv].fl & 1) != 0 {
		for j in np { let p = kid(fv, j); AOWN = bi; let v = rv(p); AOWN = sa; if j < na { ct(LVS[v].ty as int); ow(" "); lv_name(v); ow(" = "); gxas(kid(n, j), LVS[v].ty as int); ow("; "); } }
	} else {
		if na >= 1 { AOWN = bi; let v = rv(fv); AOWN = sa; if v >= 0 { ct(LVS[v].ty as int); ow(" "); lv_name(v); ow(" = "); gxas(kid(n, 0), LVS[v].ty as int); ow("; "); } else { ow("(void)("); gx(kid(n, 0)); ow("); "); } }
	}
	AOWN = bi;
	let body = ND[fv].a as int;
	for i in ND[body].n { gstmt(kid(body, i)); }
	let tl = ND[body].a as int;
	if tl >= 0 { if FI_[bi].ret as int != T_VOID && !ends(tl) { gx(tl); ow("; "); } else { gstmt(tl); } }
	AOWN = sa;
	ow(" })");
}
recursive fn grecv_ptr(r int) {
	let t = at(r);
	if TY[t].k == TY_REF { gx0(r); return; }
	if is_place(r) { ow("&("); gx0(r); ow(")"); return; }
	let k = tmp(t, is_res(t)); ow("("); ot(k); ow(" = "); gxo(r); ow(", &"); ot(k); ow(")");
}
recursive fn has_relq(c int) bool { if ND[c].k as int != N_SLIT || (cv(c) >= 0 && cv(c) != at(c)) { return false; } let si = rv(c); if si < 0 { return false; } let f0 = STI[si].f0 as int; for i in ND[c].n { let k = kid(c, i); let f = SFI[f0 + rv(k)]; if f.ty >= 0 && is_rel(f.ty as int) && ND[ND[k].a].k as int != N_NULL { return true; } } false }
recursive fn relpush(n int, recv int, c int, e int, p int, lim bool) bool {
