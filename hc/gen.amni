}
recursive fn grel_targets(q0 int, p int) { var i = q0; while i < RELQ.len { let v = ND[RELQ[i + 1]].a as int; if ND[v].k as int != N_SELF { format(O, "void *_r", p, "_", i, " = (void*)("); if TY[fin(v)].k == TY_REF || TY[fin(v)].k == TY_NULL { gx(v); } else { gaddr(v); } ow("); "); } i += 2; } }
recursive fn grel_fix(f0 int, q0 int, p int) {
	var i = q0;
	while i < RELQ.len {
		let f = SFI[f0 + RELQ[i] as int]; let v = ND[RELQ[i + 1]].a as int; let ft = f.ty as int;
		format(O, "hr_rst(&_p", p, "->"); fname_into(O, f.name as int); ow(", ");
		if ND[v].k as int == N_SELF { format(O, "(void*)_p", p); } else { format(O, "_r", p, "_", i); }
		format(O, ", ", ((TY[ft].fl as int) & RF_OPT) != 0, ", ", 8 << ((TY[ft].c as int) & 3), "); ");
		i += 2;
	}
	RELQ.resize(q0);
}
recursive fn grel_at(c int, dst int, lv int) {
	let e = at(c); let p = nt(); let f0 = STI[rv(c)].f0 as int; let q0 = RELQ.len;
	ow("{ "); ct(e); format(O, " *_p", p, " = "); if lv >= 0 { lv_addr(lv); } else { gaddr(dst); } ow("; ");
	let sm = RELM; RELM = true;
	ct(e); format(O, " _x", p, " = "); gslit(c); ow("; ");
	RELM = sm;
	grel_targets(q0, p);
	format(O, "*_p", p, " = _x", p, "; ");
	grel_fix(f0, q0, p);
