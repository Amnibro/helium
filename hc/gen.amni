		ow(")");
		return;
	}
	if k == TY_STRLIT || is_byte_arr(d) { if top { ow("hr_fs("); } else { ow("hr_fq("); } ow(o); ow(", "); if TY[at(n)].k == TY_STRLIT { gx(n); } else { gas(n); } ow(")"); return; }
	if k == TY_INT { ow(if is_signed(d) { "hr_fi(" } else { "hr_fu(" }); ow(o); ow(", "); if d != t { ow("*"); } gx(n); ow(")"); return; }
	if k == TY_ILIT { ow("hr_fi("); ow(o); ow(", "); gx(n); ow(")"); return; }
	if k == TY_FLT { ow(if TY[d].s == 4 { "hr_ff(" } else { "hr_fd(" }); ow(o); ow(", "); if d != t { ow("*"); } gx(n); ow(")"); return; }
	if k == TY_FLIT { ow("hr_fd("); ow(o); ow(", "); gx(n); ow(")"); return; }
	if k == TY_BOOL { ow("hr_fc("); ow(o); ow(", ("); if d != t { ow("*"); } gx(n); ow(") ? \"true\" : \"false\")"); return; }
