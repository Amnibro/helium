recursive fn gblk(b int, res int, val bool) {
	let x = ND[b];
	if x.k as int != N_BLOCK { if res >= 0 { gtail(b, res); } else { if val { gx(b); ow(";"); } else { gstmt(b); } } return; }
	for i in x.n { gstmt(kid(b, i)); }
	if x.a >= 0 {
		let tl = x.a as int;
		if res >= 0 { gtail(tl, res); return; }
		if val && at(tl) != T_VOID && !ends(tl) { gx(tl); ow("; "); return; }
		gstmt(tl);
	}
}
recursive fn gif(n int, res int) {
	let x = ND[n];
	ow("if (");
	let m = ax(n);
	if m != 0 && m != -1 { ow("("); gx0(x.a as int); ow(") != 0"); } else { gx(x.a as int); }
	ow(") { ");
	if m > 1 { let v = m & ((1 << 30) - 1); ct(LVS[v].ty as int); ow(" *"); lv_name(v); ow(" = "); gx0(x.a as int); ow("; "); }
	gblk(x.b as int, res, false);
	ow(" }");
	if x.c >= 0 { ow(" else { "); if ND[x.c].k == N_IF { gif(x.c as int, res); } else { gblk(x.c as int, res, false); } ow(" }"); }
}
fn lbl_push(res int) int { let l = nt(); LSTK.push(l as i32); LRES.push(res as i32); l }
fn lbl_pop(l int) { LSTK.pop(); LRES.pop(); format(O, " _bk", l, ":; "); }
recursive fn gloop(n int, res int) {
	let l = lbl_push(res);
	ow("for (;;) { "); gblk(ND[n].a as int, -1, false); ow(" }");
	lbl_pop(l);
}
recursive fn geblock(n int, res int) {
	let l = lbl_push(res);
	ow("{ "); gblk(ND[n].a as int, res, false); ow(" }");
	lbl_pop(l);
}
recursive fn gwhile(n int) {
	let x = ND[n];
	let l = lbl_push(-1);
	ow("while (");
	if ax(n) == 1 { ow("("); gx0(x.a as int); ow(") != 0"); } else { gx(x.a as int); }
	ow(") { "); gblk(x.b as int, -1, false); ow(" }");
	lbl_pop(l);
}
recursive fn gfor(n int) {
	let x = ND[n];
	let v = rv(n);
	let m = ax(n);
	let iv = if x.c >= 0 { m >> 2 } else { -1 };
	let l = lbl_push(-1);
	let p = nt();
	let et = LVS[v].ty as int;
	if (m & 3) == 0 {
		let rt0 = fin(if x.b >= 0 { x.b as int } else { x.a as int });
		let ctt = if TY[rt0].k == TY_INT { rt0 } else { T_I64 };
		ow("{ "); ct(ctt); ow(" _e"); oi(p); ow(" = ");
		if x.b >= 0 { gx(x.b as int); } else { gx(x.a as int); }
		ow("; for ("); ct(ctt); format(O, " _k", p, " = ");
		if x.b >= 0 { gx(x.a as int); } else { ow("0"); }
		format(O, "; _k", p, " < _e", p, "; _k", p, "++) { "); ct(et); ow(" "); lv_name(v); format(O, " = ("); ct(et); format(O, ")_k", p, "; ");
		if iv >= 0 { ct(LVS[iv].ty as int); ow(" "); lv_name(iv); ow(" = ("); ct(LVS[iv].ty as int); format(O, ")_k", p, "; "); }
		gblk(x.d as int, -1, false);
		ow(" } }");
		lbl_pop(l);
		return;
	}
	let a = x.a as int;
	let bt = at(a);
	let d = deref(bt);
	let e = TY[d].a as int;
	let byref = (x.fl & 1) != 0;
	if is_res(d) {
		ow("{ hrv *_v"); oi(p); ow(" = "); grecv_ptr(a); format(O, "; for (int64_t _k", p, " = 0; _k", p, " < _v", p, "->n; _k", p, "++) { ");
		ct(e); ow(if byref { " *" } else { " " }); lv_name(v); ow(if byref { " = &((" } else { " = ((" }); ct(e); format(O, "*)_v", p, "->b)[_k", p, "]; ");
	} else {
		ow("{ hsl _v"); oi(p); ow(" = "); gsl(a, bt); format(O, "; for (int64_t _k", p, " = 0; _k", p, " < _v", p, ".n; _k", p, "++) { ");
		ct(e); ow(if byref { " *" } else { " " }); lv_name(v); ow(if byref { " = &((" } else { " = ((" }); ct(e); format(O, "*)_v", p, ".p)[_k", p, "]; ");
	}
	if iv >= 0 { ct(LVS[iv].ty as int); ow(" "); lv_name(iv); ow(" = ("); ct(LVS[iv].ty as int); format(O, ")_k", p, "; "); }
	gblk(x.d as int, -1, false);
	ow(" } }");
	lbl_pop(l);
}
recursive fn gmatch(n int, res int) {
	let x = ND[n];
	let a = x.a as int;
	let st = at(a);
	let d = deref(st);
	let p = nt();
	let isenum = TY[d].k == TY_ENUM;
	ow("{ ");
	if isenum { ct(d); ow(" *_m"); oi(p); ow(" = "); if TY[st].k == TY_REF { gx0(a); } else { if is_place(a) { ow("&("); gx(a); ow(")"); } else { let k0 = tmp(d, false); ow("("); ot(k0); ow(" = "); gxo(a); ow(", &"); ot(k0); ow(")"); } } ow("; "); }
	else { ct(d); ow(" _m"); oi(p); ow(" = "); gx(a); ow("; "); }
	var first = true;
	for i in x.n {
		let arm = kid(n, i);
		let ar = ND[arm];
		if !first { ow(" else "); }
		first = false;
		if (ar.fl & 1) != 0 { ow("{ "); gblk(ar.b as int, res, false); ow(" }"); continue; }
		ow("if (");
		for j in ar.n {
			if j > 0 { ow(" || "); }
			let it = kid(arm, j);
			let lo = ND[it].a as int;
			if isenum { format(O, "_m", p, "->tag == ", rv(lo)); }
			else {
				if ND[it].b >= 0 { format(O, "(_m", p, " >= "); gx(lo); format(O, " && _m", p, " < "); gx(ND[it].b as int); ow(")"); }
				else { if leaf_kind(d) == 0 && TY[d].k != TY_INT && TY[d].k != TY_BOOL { ow("heq"); oi(d); format(O, "(_m", p, ", "); gx(lo); ow(")"); gen_heq(d); } else { format(O, "_m", p, " == "); gx(lo); } }
			}
		}
		ow(") { ");
		if ar.s >= 0 && isenum {
			let v = rv(arm);
			let vi = rv(ND[kid(arm, 0)].a as int);
			let lt = LVS[v].ty as int;
			let vt = deref(lt);
			let ei = TY[d].a as int;
			let vv = ENV[(ENI[ei].v0 as int) + vi];
			let has = vv.si >= 0 && !STI[vv.si].zero;
			ct(lt); ow(" "); lv_name(v); ow(" = ");
			if TY[lt].k == TY_REF { if has { format(O, "&_m", p, "->u.v", vi, "; "); } else { ow("0; "); } }
			else { if has { format(O, "_m", p, "->u.v", vi, "; "); } else { ow("0; "); } }
		}
		gblk(ar.b as int, res, false);
		ow(" }");
	}
	ow(" }");
}
fn gmatch_dummy() {}
recursive fn gvdecl(n int) {
	let x = ND[n];
	if x.n > 1 {
		if ax(n) == 1 {
			var ids i32[..64] = [];
			for i in x.n { let iv = kid(x.b as int, i); let p = nt(); ids.push(p as i32); ct(fin(iv)); ow(" _t"); oi(p); ow(" = "); gx(iv); ow("; "); }
			let v0 = rv(n);
			for i in x.n { decl_lv(v0 + i); format(O, " = _t", ids[i], "; "); }
			return;
		}
		let init = kid(x.b as int, 0);
		let p = nt();
		ct(at(init)); ow(" _t"); oi(p); ow(" = "); gx(init); ow("; ");
		let v0 = rv(n);
		for i in x.n { decl_lv(v0 + i); format(O, " = _t", p, ".r", i, "; "); }
		return;
	}
	let v = rv(n);
	let t = LVS[v].ty as int;
	decl_lv(v);
	ow(" = ");
	if x.b < 0 { ow("{0}; "); return; }
	let init = kid(x.b as int, 0);
	if TY[t].k == TY_REF { let it = fin(init); if TY[it].k == TY_REF || TY[it].k == TY_NULL { gx(init); } else { gaddr(init); } ow("; "); return; }
	if is_res(t) { gxo(init); ow("; "); return; }
	let it = at(init);
	if TY[it].k == TY_MULTI { gx(init); format(O, ".r0; "); return; }
	gx(init); ow("; ");
}
fn decl_lv(v int) {
	let t = LVS[v].ty as int;
	ct(t); ow(" ");
	if lv_isptr(v) { ow("*"); }
	lv_name(v);
	if is_res(t) && !lv_isptr(v) { ow(" __attribute__((cleanup(hr_rdrop)))"); }
}
recursive fn gassign(n int) {
	let x = ND[n];
	let o = x.op as int;
	if o == T_COMMA {
		let p = nt();
		ow("{ "); ct(at(x.b as int)); ow(" _t"); oi(p); ow(" = "); gx(x.b as int); ow("; ");
		let tl = x.a as int;
		for i in ND[tl].n { let tg = kid(tl, i); gx(tg); format(O, " = _t", p, ".r", i, "; "); }
		ow("}");
		return;
	}
	let a = x.a as int;
	let tt = at(a);
	let d = deref(tt);
	if o == T_DOTASSIGN && TY[tt].k == TY_REF {
		let b = x.b as int;
		gx0(a); ow(" = ");
		if TY[fin(b)].k == TY_REF || TY[fin(b)].k == TY_NULL { gx(b); } else { gaddr(b); }
		ow(";");
		return;
	}
	if o == T_ASSIGN || o == T_DOTASSIGN {
		if is_res(d) { ow("hr_rset("); if TY[tt].k == TY_REF { gx0(a); } else { ow("&("); gx(a); ow(")"); } ow(", "); gxo(x.b as int); ow(");"); return; }
		if TY[tt].k == TY_REF && TY[at(x.b as int)].k != TY_REF && TY[fin(x.b as int)].k != TY_REF && TY[at(x.b as int)].k != TY_NULL { ow("*"); gx0(a); ow(" = "); gx(x.b as int); ow(";"); return; }
		if ND[a].k == N_ID { gx(a); ow(" = "); gx(x.b as int); ow(";"); return; }
		let q = nt();
		ow("{ "); ct(d); ow(" *_t"); oi(q); ow(" = &("); gx(a); ow("); *_t"); oi(q); ow(" = "); gx(x.b as int); ow("; }");
		return;
	}
	let p = nt();
	ow("{ "); ct(d); ow(" *_t"); oi(p); ow(" = ");
	if TY[tt].k == TY_REF { gx0(a); } else { ow("&("); gx(a); ow(")"); }
	ow("; *_t"); oi(p); ow(" = ");
	garith(base_op(o), d, -1, x.b as int, p, n);
	ow("; }");
}
fn gdummy() { let rt = FI_[GCF].ret as int; if rt < 0 || rt == T_VOID { ow("return;"); return; } ow("{ "); ct(rt); ow(" _z; memset(&_z, 0, sizeof _z); return _z; }"); }
fn glrcheck() {
	ow("if (HR_UNLIKELY(hr_lr)) { ");
	if FI_[GCF].tg { let rt = FI_[GCF].ret as int; format(O, "if (hr_lr == ", GCF + 1, ") { hr_lr = 0; "); if rt < 0 || rt == T_VOID { ow("return; } "); } else { format(O, "return _lrv", GCF, "; } "); } }
	gdummy(); ow(" } ");
}
fn movable_local(c int) bool { if ND[c].k != N_ID || rk(c) != R_LOCAL { return false; } let v = rv(c); LVS[v].cfn as int == GCF && !lv_isptr(v) && TY[LVS[v].ty].k != TY_REF && (cv(c) < 0 || cv(c) == at(c)) }
recursive fn gmove(c int) {
	if movable_local(c) { let v = rv(c); let p = nt(); ow("({ hrv _mv"); oi(p); ow(" = "); lv_name(v); ow("; "); lv_name(v); ow(".b = 0; "); lv_name(v); format(O, ".n = 0; _mv", p, "; })"); return; }
	gxo(c);
}
recursive fn gret(n int) {
	let x = ND[n];
	let lt = ax(n);
	if lt >= 0 && lt != GCF {
		let rt0 = FI_[lt].ret as int;
		ow("{ ");
		if x.n > 1 { format(O, "_lrv", lt, " = ("); ct(rt0); ow("){ "); for i in x.n { if i > 0 { ow(", "); } let c = kid(n, i); if is_res(fin(c)) { gmove(c); } else { gx(c); } } ow(" }; "); }
		else { if x.n == 1 { format(O, "_lrv", lt, " = "); let c = kid(n, 0); if is_res(rt0) { gmove(c); } else { gx(c); } ow("; "); } }
		format(O, "hr_lr = ", lt + 1, "; "); gdummy(); ow(" }");
		return;
	}
	if x.n == 0 { ow("return;"); return; }
	let f = if lt >= 0 { lt } else { ret_fn() };
	let rt = FI_[f].ret as int;
	if x.n > 1 { ow("return ("); ct(rt); ow("){ "); for i in x.n { if i > 0 { ow(", "); } let c = kid(n, i); if is_res(fin(c)) { gmove(c); } else { gx(c); } } ow(" };"); return; }
	let c = kid(n, 0);
	ow("return "); if is_res(rt) { gmove(c); } else { gx(c); } ow(";");
}
recursive fn gbreak(n int) {
	let x = ND[n];
	if LSTK.len == 0 { gerr(n, "break outside a loop"); return; }
	let l = LSTK[LSTK.len - 1] as int;
	let r = LRES[LRES.len - 1] as int;
	ow("{ ");
	if x.a >= 0 { if r >= 0 { ow("_r"); oi(r); ow(" = "); gx(x.a as int); ow("; "); } else { ow("(void)("); gx(x.a as int); ow("); "); } }
	format(O, "goto _bk", l, "; }");
}
recursive fn gstmt(n int) {
	if n < 0 { return; }
	let sp = O.len; let td = TDS.len;
	let x = ND[n];
	let k = x.k as int;
	let decl = k == N_VDECL;
	if k == N_VDECL { gvdecl(n); } else { gstmt1(n); }
	ow("\n");
	if TDS.len > td {
		SCR.clear(); SCR.append(O[sp..]); O.resize(sp);
		if !decl { ow("{ "); }
		O.append(TDS[td..]); TDS.resize(td);
		O.append(SCR[..]);
		if !decl { ow("}\n"); }
	}
}
recursive fn gstmt1(n int) {
	let x = ND[n];
	let k = x.k as int;
	if k == N_ASSIGN { gassign(n); return; }
	if k == N_INCDEC { let a = x.a as int; let tt = at(a); if TY[tt].k == TY_REF { ow("(*"); gx0(a); ow(")"); } else { gx(a); } ow(if x.op as int == T_INC { "++;" } else { "--;" }); return; }
	if k == N_FN { return; }
	if k == N_IF { gif(n, -1); return; }
	if k == N_WHILE { gwhile(n); return; }
	if k == N_LOOP { gloop(n, -1); return; }
	if k == N_FOR { gfor(n); return; }
	if k == N_MATCH { gmatch(n, -1); return; }
	if k == N_EBLOCK { geblock(n, -1); return; }
	if k == N_BLOCK { ow("{ "); gblk(n, -1, false); ow(" }"); return; }
	if k == N_RET { gret(n); return; }
	if k == N_BREAK { gbreak(n); return; }
	if k == N_CONT { ow("continue;"); return; }
	if k == N_CFOR { gerr(n, "const for is not supported by the self-hosted compiler yet"); return; }
	if owned(n) { ow("hr_rgive("); gx0(n); ow(");"); return; }
	ow("(void)("); gx(n); ow(");");
}
fn gsig(i int) {
	let rt = FI_[i].ret as int;
	ow("static ");
	if rt < 0 { ow("void"); } else { ct(rt); }
	ow(" "); fn_cname(i); ow("(");
	let node = FI_[i].node as int;
	var first = true;
	let sa = AOWN; AOWN = i;
	for j in ND[node].n {
		let p = kid(node, j);
		let v = rv(p);
		if !first { ow(", "); }
		first = false;
		let t = ptype_of(i, j);
		ct(t); ow(" "); lv_name(v); if is_res(t) { ow("_in"); }
	}
	AOWN = sa;
	for cp in CAPS { if cp.inst as int == i { if !first { ow(", "); } first = false; let v = cp.lv as int; ct(LVS[v].ty as int); ow(if lv_isptr(v) { " **c" } else { " *c" }); oi(v); } }
	if first { ow("void"); }
	ow(")");
}
fn gen_fn(i int) {
	let node = FI_[i].node as int;
	AOWN = i; GCF = i;
	LSTK.clear(); LRES.clear();
	let s0 = O.len;
	gsig(i);
	PR.append(O[s0..]); PR.append(";\n");
	ow(" {\n");
	for j in ND[node].n { let p = kid(node, j); let v = rv(p); if is_res(ptype_of(i, j)) { ow("hrv "); lv_name(v); ow(" __attribute__((cleanup(hr_rdrop))) = "); lv_name(v); ow("_in;\n"); } }
	let body = ND[node].c as int;
	let rt = FI_[i].ret as int;
	let tl = ND[body].a as int;
	for q in ND[body].n { gstmt(kid(body, q)); }
	if tl >= 0 {
		if rt >= 0 && rt != T_VOID && at(tl) != T_VOID && !ends(tl) {
			let sp = O.len; let td = TDS.len;
			if TY[rt].k == TY_MULTI && ND[tl].k == N_CALL { ow("return "); gx(tl); ow(";\n"); }
			else { ow("return "); if is_res(rt) { gmove(tl); } else { gx(tl); } ow(";\n"); }
			if TDS.len > td { SCR.clear(); SCR.append(O[sp..]); O.resize(sp); ow("{ "); O.append(TDS[td..]); TDS.resize(td); O.append(SCR[..]); ow("}\n"); }
		} else { gstmt(tl); }
	}
	ow("}\n");
}
fn gen_program(out byte[>..]&) bool {
	O.clear();
	for f, i in FI_ { if f.tg && f.ret >= 0 && f.ret as int != T_VOID { let sv = O.len; ow("static __thread "); ct(f.ret as int); format(O, " _lrv", i, ";\n"); GL.append(O[sv..]); O.resize(sv); } }
	for d in ORDER {
		let di = d as int;
		let t = GLT[di] as int;
		let g = DC[di].node as int;
		if const_of(di) >= 0 && TY[t].k == TY_ILIT { continue; }
		let sv = O.len;
		AOWN = GLOBI; GCF = GLOBI;
		ow("static "); ct(t); format(O, " g", di, ";\n");
		GL.append(O[sv..]); O.resize(sv);
		let x = ND[g];
		if x.b >= 0 {
			let iv = kid(x.b as int, 0);
			let sp = O.len;
			format(O, "g", di, " = ");
			if is_res(t) { gxo(iv); } else { gx(iv); }
			ow(";\n");
			if TDS.len > 0 { SCR.clear(); SCR.append(O[sp..]); O.resize(sp); ow("{ "); O.append(TDS[..]); TDS.clear(); O.append(SCR[..]); ow("}\n"); }
			GI.append(O[sp..]); O.resize(sp);
		}
	}
	var mi = -1;
	for f, i in FI_ {
		if f.node < 0 || f.st != 2 { continue; }
		let node = f.node as int;
		if ND[node].k != N_FN || (ND[node].fl & F_EXTERN) != 0 { continue; }
		if f.par < 0 && nm(f.name as int) == "main" { mi = i; }
		gen_fn(i);
		if GERR.len > 0 { return false; }
	}
	out.append("#include \"hrt.h\"\n");
	out.append(TF);
	out.append("#pragma pack(push, 1)\n");
	out.append(TD);
	out.append("#pragma pack(pop)\n");
	out.append(PR);
	out.append(GL);
	out.append(HF[..]);
	out.append(O[..]);
	out.append("static void hr_init_globals(void) {\n"); out.append(GI); out.append("}\n");
	out.append("static void hr_main(void) { ");
	if mi >= 0 { let rt = FI_[mi].ret as int; if rt >= 0 && TY[rt].k == TY_INT { out.append("hr_flush(); exit((int)"); } O.clear(); fn_cname(mi); out.append(O[..]); out.append("()"); if rt >= 0 && TY[rt].k == TY_INT { out.append(")"); } out.append("; "); }
	out.append("}\n");
	GERR.len == 0
}
