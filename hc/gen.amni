	if is_lim(a) { ow("(("); ct(a); format(O, "){ ", s.len, ", "); cstr_lit(s); ow(" })"); return; }
	if is_vimg(a) { DSU++; ow("hr_vfrom(hr_str("); cstr_lit(s); format(O, ", ", s.len, ")"); vargs(a); ow(", 1)"); return; }
	ow("hr_str("); cstr_lit(s); format(O, ", ", s.len, ")");
