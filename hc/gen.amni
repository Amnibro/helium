fn hh(s const byte[:]) { HF.append(s); }
recursive fn need_helper(t int) bool { let k = TY[t].k as int; if is_byte_arr(t) { return false; } if k == TY_REF { return need_helper(TY[t].a as int); } k == TY_STRUCT || k == TY_ENUM || k == TY_VARIANT || k == TY_ARR || k == TY_SLICE || k == TY_MULTI }
recursive fn comp_one(t int, fmt bool) { let u = if TY[t].k == TY_REF { TY[t].a as int } else { t }; if TY[t].k == TY_REF && !fmt { return; } if need_helper(u) || (!fmt && is_byte_arr(u) && !is_fix(u)) { if fmt { gen_hf(u); } else { gen_heq(u); } } }
recursive fn comp_pre(t int, fmt bool) {
