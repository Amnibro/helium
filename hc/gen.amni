		else { let sa = AOWN; AOWN = GLOBI; gx(f.def as int); AOWN = sa; }
		ow(", "); any = true;
	}
	if !any { ow("0"); }
	ow("})");
}
recursive fn gfmt(o const byte[:], n int, t int, top bool) {
	let d = deref(t);
