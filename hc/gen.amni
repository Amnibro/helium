		else { if is_lim(t) { hh("if (a.n != b.n) return false; for (int64_t i = 0; i < a.n; i++) if (!("); ea.append("a.e[i]"); eb.append("b.e[i]"); }
		else { if is_seq(t) { var za byte[..512] = []; var zb byte[..512] = []; vz_into(za, e, "qa"); vz_into(zb, e, "qb"); format(HF, "if (a.n != b.n) return false; uint8_t *qa = a.p, *qb = b.p; for (int64_t i = 0; i < a.n; i++, qa += ", za[..], ", qb += ", zb[..], ") if (!("); ea.append("qa"); eb.append("qb"); }
		else { hh("if (a.n != b.n) return false; for (int64_t i = 0; i < a.n; i++) if (!("); ea.append("(("); ea.append(cn(e)); ea.append("*)a.p)[i]"); eb.append("(("); eb.append(cn(e)); eb.append("*)b.p)[i]"); } } }
