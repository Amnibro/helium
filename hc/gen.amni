		let ei = x.a as int; let v = ENV[(ENI[ei].v0 as int) + (x.c as int)];
		if v.si >= 0 && STI[v.si].fnum > 0 { hh("hr_fc(o, \""); hh(nm(v.name as int)); hh(" { \"); "); var first = true; let sf0 = STI[v.si].f0 as int; for j in STI[v.si].fnum { let f = SFI[sf0 + j]; if f.ty < 0 { continue; } if !first { hh("hr_fc(o, \", \"); "); } first = false; var e byte[..128] = []; e.append("v."); for c in nm(f.name as int) { e.push(c); } e.push('_'); hf_val(f.ty as int, e[..]); } hh("hr_fc(o, \" }\"); "); }
		else { hh("hr_fc(o, \""); hh(nm(ENI[ei].name as int)); hh("."); hh(nm(v.name as int)); hh("\"); "); }
