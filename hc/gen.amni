fn hsl_ty(t int) bool { TY[t].k == TY_SLICE || (TY[t].k == TY_ARR && !is_fix(t) && !is_lim(t)) }
recursive fn gxas(n int, t int) { let f = fin(n); if f == t { gx(n); return; } gcv(n, at(n), t); }
fn fin_lit(n int) int { let t = at(n); if t < 0 || TY[t].k == TY_ILIT { T_I64 } else { if TY[t].k == TY_FLIT { T_F64 } else { t } } }
