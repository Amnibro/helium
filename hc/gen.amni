var VCK i32[>..];
var VFD i8[>..];
recursive fn vneeds(t int) bool {
	let x = TY[t]; let k = x.k as int;
	if k == TY_BOOL || k == TY_ENUM { return true; }
	if k == TY_REF { return x.c >= 0; }
	if k == TY_ARR { return (x.s as int == A_LIM && x.b >= 0) || vneeds(x.a as int); }
	if k == TY_STRUCT || k == TY_VARIANT { let si = if k == TY_STRUCT { x.a as int } else { ENV[(ENI[x.a].v0 as int) + (x.c as int)].si as int }; if si < 0 { return false; } let f0 = STI[si].f0 as int; for i in STI[si].fnum { let ft = SFI[f0 + i].ty as int; if ft >= 0 && vneeds(ft) { return true; } } }
	false
}
recursive fn vf_reject(n int, t int) bool {
	let x = TY[t]; let k = x.k as int;
	if k == TY_REF && x.c < 0 { gerr(n, "an image cannot hold a plain reference: it is an address (§12)"); return false; }
	if k == TY_SLICE { gerr(n, "an image cannot hold a slice: it is an address (§12)"); return false; }
	if k == TY_ARR { return vf_reject(n, x.a as int); }
	if k == TY_STRUCT || k == TY_VARIANT { let si = if k == TY_STRUCT { x.a as int } else { ENV[(ENI[x.a].v0 as int) + (x.c as int)].si as int }; if si >= 0 { let f0 = STI[si].f0 as int; for i in STI[si].fnum { let ft = SFI[f0 + i].ty as int; if ft >= 0 && !vf_reject(n, ft) { return false; } } } }
	if k == TY_ENUM { let ei = x.a as int; for i in ENI[ei].vnum { if !vf_reject(n, t_variant(ei, i)) { return false; } } }
	true
}
recursive fn vc_name(b byte[..512]&, t int, e int) { format(b, "vc", t, "_", e); }
recursive fn vc_call(n int, t int, e int, q const byte[:]) {
	gen_vc(n, t, e);
	format(HF, "if (!vc", t, "_", e, "(", q, ", b0, n, esz)) return false; ");
}
recursive fn gen_vc(n int, t int, e int) {
	var i = 0;
	while i < VCK.len { if VCK[i] as int == t && VCK[i + 1] as int == e { return; } i += 2; }
	VCK.push(t as i32); VCK.push(e as i32);
	let x = TY[t]; let k = x.k as int;
	cbody(t);
	if k == TY_ENUM { let ei = x.a as int; for vi in ENI[ei].vnum { let v = ENV[(ENI[ei].v0 as int) + vi]; if v.si >= 0 && !STI[v.si].zero && vneeds(t_struct(v.si as int)) { gen_vc(n, t_struct(v.si as int), e); } } }
	if k == TY_STRUCT || k == TY_VARIANT { let si = if k == TY_STRUCT { x.a as int } else { ENV[(ENI[x.a].v0 as int) + (x.c as int)].si as int }; if si >= 0 { let f0 = STI[si].f0 as int; for j in STI[si].fnum { let ft = SFI[f0 + j].ty as int; if ft >= 0 && vneeds(ft) { gen_vc(n, ft, e); } } } }
	if k == TY_ARR && vneeds(x.a as int) { gen_vc(n, x.a as int, e); }
	var sig byte[..128] = []; format(sig, "static bool vc", t, "_", e, "(const uint8_t *q, const uint8_t *b0, int64_t n, int64_t esz)");
	PR.append(sig[..]); PR.append(";\n");
	HF.append(sig[..]); hh(" { (void)b0; (void)n; (void)esz; ");
	if k == TY_BOOL { hh("if (*q > 1) return false; "); }
	if k == TY_REF && x.c >= 0 {
		let opt = ((x.fl as int) & RF_OPT) != 0;
		let pt = deref(x.a as int);
		format(HF, "int64_t o = hr_rget((void*)q, ", isz(x.c as int), "); ");
		if opt { hh("if (o == 0) return true; "); }
		hh("int64_t tg = (q - b0) + o; ");
		if TY[pt].k == TY_VARIANT && TY[e].k == TY_ENUM && TY[pt].a == TY[e].a {
			hh("tg -= (int64_t)offsetof("); HF.append(cn(e)); format(HF, ", u); if (tg < 0 || tg >= n || tg % esz) return false; if ((int64_t)((const "); HF.append(cn(e)); format(HF, "*)(b0 + tg))->tag != ", TY[pt].c, ") return false; ");
		} else { if pt != deref(e) && !(TY[pt].k == TY_VARIANT && TY[deref(e)].k == TY_VARIANT && TY[pt].a == TY[deref(e)].a && TY[pt].c == TY[deref(e)].c) { gerr(n, "from_bytes cannot verify a relative reference into a field of an element (§12)"); } hh("if (tg < 0 || tg >= n || tg % esz) return false; "); }
	}
	if k == TY_ENUM {
		let ei = x.a as int;
		HF.append("int64_t tg = ((const "); HF.append(cn(t)); format(HF, "*)q)->tag; if (tg >= ", ENI[ei].vnum, ") return false; ");
		for vi in ENI[ei].vnum { let v = ENV[(ENI[ei].v0 as int) + vi]; if v.si >= 0 && !STI[v.si].zero && vneeds(t_struct(v.si as int)) { format(HF, "if (tg == ", vi, ") { "); var qa byte[..128] = []; qa.append("q + offsetof("); qa.append(cn(t)); qa.append(", u)"); vc_call(n, t_struct(v.si as int), e, qa[..]); hh("} "); } }
	}
	if k == TY_STRUCT || k == TY_VARIANT {
		let st = if k == TY_STRUCT { t } else { let v = ENV[(ENI[x.a].v0 as int) + (x.c as int)]; if v.si >= 0 { t_struct(v.si as int) } else { -1 } };
		if st >= 0 { let si = TY[st].a as int; let f0 = STI[si].f0 as int; for j in STI[si].fnum { let f = SFI[f0 + j]; let ft = f.ty as int; if ft >= 0 && vneeds(ft) { var qa byte[>..<] = []; qa.append("q + offsetof("); qa.append(cn(st)); qa.append(", "); fname_into(qa, f.name as int); qa.append(")"); vc_call(n, ft, e, qa[..]); } } }
	}
	if k == TY_ARR {
		let a = x.s as int; let el = x.a as int;
		var qa byte[..128] = []; qa.append("q + offsetof("); qa.append(cn(t)); qa.append(", e) + i * (int64_t)sizeof("); qa.append(cn(el)); qa.append(")");
		if a == A_LIM { HF.append("__typeof__(((const "); HF.append(cn(t)); HF.append("*)0)->n) ln; memcpy(&ln, q + offsetof("); HF.append(cn(t)); format(HF, ", n), sizeof ln); if ((int64_t)ln < 0 || (int64_t)ln > ", x.b, ") return false; "); if vneeds(el) { hh("for (int64_t i = 0; i < (int64_t)ln; i++) { "); vc_call(n, el, e, qa[..]); hh("} "); } }
		else { if vneeds(el) { format(HF, "for (int64_t i = 0; i < ", x.b, "; i++) { "); vc_call(n, el, e, qa[..]); hh("} "); } }
	}
	hh("return true; }\n");
}
recursive fn vf_need(n int, e int) {
	while VFD.len < TY.len { VFD.push(0); }
	if VFD[e] != 0 { return; }
	VFD[e] = 1;
	if !vf_reject(n, e) { return; }
	cbody(e);
	if vneeds(e) { gen_vc(n, e, e); }
	var sig byte[..128] = []; format(sig, "static int64_t vf", e, "(const uint8_t *p, int64_t n)");
	PR.append(sig[..]); PR.append(";\n");
	HF.append(sig[..]); hh(" { int64_t esz = sizeof("); HF.append(cn(e)); hh("); if (n % esz) return -1; int64_t c = n / esz; ");
	if vneeds(e) { format(HF, "for (int64_t i = 0; i < c; i++) if (!vc", e, "_", e, "(p + i * esz, p, n, esz)) return -1; "); }
	hh("return c; }\n");
}
var PQD i8[>..];
recursive fn pneeds(t int) bool {
	let x = TY[t]; let k = x.k as int;
	if is_vval(t) || is_res(t) { return true; }
	if k == TY_ARR { return pneeds(x.a as int); }
	if k == TY_STRUCT || k == TY_VARIANT { let si = if k == TY_STRUCT { x.a as int } else { ENV[(ENI[x.a].v0 as int) + (x.c as int)].si as int }; if si < 0 { return false; } let f0 = STI[si].f0 as int; for i in STI[si].fnum { let ft = SFI[f0 + i].ty as int; if ft >= 0 && pneeds(ft) { return true; } } }
	if k == TY_ENUM { let ei = x.a as int; for i in ENI[ei].vnum { let v = ENV[(ENI[ei].v0 as int) + i]; if v.si >= 0 && !STI[v.si].zero && pneeds(t_struct(v.si as int)) { return true; } } }
	false
}
recursive fn pq_field(pk bool, ft int, e const byte[:]) {
	if pneeds(ft) { gen_pq(ft); format(HF, if pk { "pq" } else { "uq" }, ft, if pk { "(o, &" } else { "(q, &" }, e, "); "); return; }
	if pk { format(HF, "hr_append(o, &", e, ", sizeof ", e, ", 1); "); } else { format(HF, "memcpy(&", e, ", *q, sizeof ", e, "); *q += sizeof ", e, "; "); }
}
recursive fn gen_pq(t int) {
	while PQD.len < TY.len { PQD.push(0); }
	if PQD[t] != 0 { return; }
	PQD[t] = 1;
	cbody(t);
	let x = TY[t]; let k = x.k as int;
	let c = cn(t);
	var s1 byte[>..] = []; format(s1, "static void pq", t, "(hrv *o, const "); s1.append(c); s1.append(" *v)");
	var s2 byte[>..] = []; format(s2, "static void uq", t, "(const uint8_t **q, "); s2.append(c); s2.append(" *v)");
