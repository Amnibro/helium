			ow(";\n");
			if TDS.len > 0 { SCR.clear(); SCR.append(O[sp..]); O.resize(sp); ow("{ "); O.append(TDS[..]); TDS.clear(); O.append(SCR[..]); ow("}\n"); }
			GI.append(O[sp..]); O.resize(sp);
		}
	}
	if TSP.len > 0 { GL.append("typedef struct { uint8_t _e; "); GL.append(HRG[..]); GL.append("} HRG;\nstatic void hr_gsave(HRG *s) { "); GL.append(HRS[..]); GL.append("}\nstatic void hr_gload(HRG *s) { "); GL.append(HRL[..]); GL.append("}\n"); }
	var mi = -1;
	for f, i in FI_ {
		if f.node < 0 || f.st != 2 { continue; }
		let node = f.node as int;
		if ND[node].k != N_FN || (ND[node].fl & F_EXTERN) != 0 { continue; }
		if f.par < 0 && nm(f.name as int) == "main" { mi = i; }
		gen_fn(i);
		if GERR.len > 0 { return false; }
	}
	out.append("#include \"hrt.h\"\n");
	out.append(TF);
	out.append("#pragma pack(push, 1)\n");
	out.append(TD);
	out.append("#pragma pack(pop)\n");
	out.append(PR);
	out.append(GL);
	out.append(TW[..]);
	out.append(HF[..]);
	out.append(O[..]);
	out.append("static void hr_init_globals(void) {\n"); out.append(GI); out.append("}\n");
	out.append("static void hr_main(void) { ");
	if mi >= 0 { let rt = FI_[mi].ret as int; if rt >= 0 && TY[rt].k == TY_INT { out.append("hr_flush(); exit((int)"); } O.clear(); fn_cname(mi); out.append(O[..]); out.append("()"); if rt >= 0 && TY[rt].k == TY_INT { out.append(")"); } out.append("; "); }
	out.append("}\n");
	GERR.len == 0
}
