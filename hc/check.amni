import decl;
let R_NONE = 0; let R_LOCAL = 1; let R_GLOBAL = 2; let R_FN = 3; let R_BUILTIN = 4; let R_FIELD = 5; let R_CONST = 6; let R_VARIANT = 7; let R_MEMBER = 8; let R_CTOR = 9; let R_BLOCK = 10; let R_UFCS = 11; let R_VCTOR = 12; let R_FCONST = 13; let R_CASE = 14;
let LV_LIT = 128; let LPN = -7; let LV_VAR = 1; let LV_CONST = 2; let LV_PARAM = 4; let LV_REF = 8; let LV_FOR = 16; let LV_BLKP = 32; let LV_FLET = 64;
let IS_DONE = 2;
struct FnI { node i32, lo i32, hi i32, ab i32, par i32, cfn i32, g0 i32, gn i32, ret i32, p0 i32, pn i32, st u8, lr bool, blk i32, bown i32, name i32, fl u16, rinf bool, tg bool }
struct LV { name i32, ty i32, fl u16, cfn i32, own i32, node i32, cnt i32 }
struct Cap { inst i32, lv i32 }
struct CEdge { caller i32, callee i32 }
var FI_ FnI[>..];
var LVS LV[>..];
var SCOPE i32[>..<];
var NAR i32[>..<];
var CAPS Cap[>..];
var CEDGES CEdge[>..];
var GBS Gb[>..];
var AT i32[>..]; var AC i32[>..]; var AK u8[>..]; var AV i32[>..]; var AX i32[>..];
var CI int = -1;
var AOWN int = -1;
var CFN int = -1;
var GLOBI int = -1;
var CERR byte[>..];
var NERR int;
var RETWANT int = -1;
var LOOPD int;
var ARGW i32[>..<];
var ORDER i32[>..];
fn cerr(n int, m const byte[:]) { NERR++; if CERR.len > 0 { return; } let x = TK[ND[max(n, 0)].t]; CERR.append(nm(FILES[x.f].name)); format(CERR, ":", x.line, ": error: ", m); }
fn new_inst(node int, lo int, hi int, par int) int {
	let i = FI_.len;
	FI_.push(FnI { node: node as i32, lo: lo as i32, hi: hi as i32, ab: AT.len as i32, par: par as i32, cfn: i as i32, g0: GBS.len as i32, gn: 0, ret: -1, p0: 0, pn: 0, st: 0, blk: -1, bown: -1, name: if node >= 0 { ND[node].s } else { -1 }, .. });
	let n = hi - lo;
	AT.resize(AT.len + n, -1); AC.resize(AC.len + n, -1); AK.resize(AK.len + n, 0); AV.resize(AV.len + n, -1); AX.resize(AX.len + n, -1);
	i
}
fn aix(n int) int {
	var i = AOWN;
	while i >= 0 { let f = FI_[i]; if n >= (f.lo as int) && n < (f.hi as int) { return (f.ab as int) + n - (f.lo as int); } i = f.par as int; }
	let g = FI_[GLOBI];
	(g.ab as int) + n
}
fn at(n int) int { AT[aix(n)] as int }
fn set_t(n int, t int) int { AT[aix(n)] = t as i32; t }
fn set_r(n int, k int, v int) { let i = aix(n); AK[i] = k as u8; AV[i] = v as i32; }
fn rk(n int) int { AK[aix(n)] as int }
fn rv(n int) int { AV[aix(n)] as int }
fn set_x(n int, v int) { AX[aix(n)] = v as i32; }
fn ax(n int) int { AX[aix(n)] as int }
fn set_cv(n int, t int) { AC[aix(n)] = t as i32; }
fn cv(n int) int { AC[aix(n)] as int }
fn tn(t int) byte[>..] { ty_name(t) }
fn add_lv(name int, t int, fl int, node int) int {
	LVS.push(LV { name as i32, t as i32, fl as u16, CFN as i32, AOWN as i32, node as i32, 0 });
	SCOPE.push((LVS.len - 1) as i32);
	LVS.len - 1
}
fn visible_in(own int, cur int) bool { var i = cur; while i >= 0 { if i == own { return true; } i = FI_[i].par as int; } false }
fn visible(own int) bool { visible_in(own, AOWN) }
fn find_lv(name int) int {
	var i = SCOPE.len - 1;
	while i >= 0 { let v = SCOPE[i] as int; if LVS[v].name as int == name && visible(LVS[v].own as int) { return v; } i--; }
	-1
}
fn add_cap_one(cf int, v int) bool {
	if cf < 0 || cf == (LVS[v].cfn as int) { return false; }
	for x in CAPS { if x.inst as int == cf && x.lv as int == v { return false; } }
	CAPS.push(Cap { cf as i32, v as i32 });
	true
}
fn note_cap(v int) {
	let own = LVS[v].own as int;
	var a = AOWN;
	while a >= 0 && a != own {
		add_cap_one(FI_[a].cfn as int, v);
		a = FI_[a].par as int;
	}
}
fn note_edge(callee int) {
	if CFN < 0 || callee < 0 || CFN == callee { return; }
	for e in CEDGES { if e.caller as int == CFN && e.callee as int == callee { return; } }
	CEDGES.push(CEdge { CFN as i32, callee as i32 });
}
recursive fn narrow_push(c int) {
	if c < 0 { return; }
	let x = ND[c]; let k = x.k as int;
	if k == N_ID && rk(c) == R_LOCAL {
		let v = rv(c);
		let t = LVS[v].ty as int;
		if TY[t].k == TY_REF && (TY[t].fl & RF_OPT) != 0 {
			NAR.push(v as i32); NAR.push(t as i32);
			LVS[v].ty = t_ref(TY[t].a as int, 0) as i32;
		}
		return;
	}
	if k == N_BIN && x.op as int == T_ANDAND {
		narrow_push(x.a as int);
		narrow_push(x.b as int);
	}
}
fn narrow_pop(m int) {
	while NAR.len > m {
		let old_t = NAR.pop();
		let v = NAR.pop() as int;
		LVS[v].ty = old_t;
	}
}
fn is_pending(t int) bool { let k = TY[t].k as int; k == TY_ILIT || k == TY_FLIT || k == TY_STRLIT || k == TY_ARRLIT || k == TY_NULL }
fn int_fits(v i64, uns bool, t int) bool {
	if TY[t].k != TY_INT { return false; }
	if uns { return !is_signed(t) && ibits(t) == 64; }
	if v < 0 { return is_signed(t) && v >= int_min(t); }
	(v as u64) <= int_max_u(t)
}
fn widens(f int, t int) bool {
	if f == t { return true; }
	let a = TY[f]; let b = TY[t];
	if a.k == TY_INT && b.k == TY_INT { let fs = is_signed(f); let ts = is_signed(t); if fs == ts { return ibits(t) > ibits(f); } return !fs && ts && ibits(t) > ibits(f); }
	if a.k == TY_INT && b.k == TY_FLT { return true; }
	if a.k == TY_FLT && b.k == TY_FLT { return b.s > a.s; }
	if a.k == TY_INT && b.k == TY_VARINT { return !(ibits(f) == 64 && !is_signed(f)); }
	if a.k == TY_VARINT && b.k == TY_INT { return t == T_I64; }
	false
}
recursive fn cval(n int) i64, bool, bool {
	if n < 0 { return 0, false, false; }
	let x = ND[n]; let k = x.k as int;
	if k == N_INT { return TK[x.t].v, TK[x.t].uns, true; }
	if k == N_UN { let v, u, ok = cval(x.a as int); if !ok { return 0, false, false; } if x.op as int == T_MINUS { if v == -9223372036854775807 - 1 && ND[x.a].k as int != N_INT { return 0, false, false; } return -v, false, true; } if x.op as int == T_BITNOT { return ~v, false, true; } return 0, false, false; }
	if k == N_ID && rk(n) == R_CONST { return CONSTV[rv(n)], false, true; }
	if k == N_BIN {
		let a, ua, oa = cval(x.a as int); let b, ub, ob = cval(x.b as int);
		if !oa || !ob { return 0, false, false; }
		let o = x.op as int;
		if o == T_PLUS { return a + b, false, true; } if o == T_MINUS { return a - b, false, true; } if o == T_MUL { return a * b, false, true; }
		if o == T_DIV { if b == 0 { return 0, false, false; } return a / b, false, true; }
		if o == T_MOD { if b == 0 { return 0, false, false; } return ((a % b) + b) % b, false, true; }
		if o == T_SHL { return a << b, false, true; } if o == T_SHR { return a >> b, false, true; }
		if o == T_AND { return a & b, false, true; } if o == T_OR { return a | b, false, true; } if o == T_XOR { return a ^ b, false, true; }
	}
	if k == N_IF || k == N_BLOCK { return 0, false, false; }
	return 0, false, false;
}
var CONSTV i64[>..];
var CONSTD i32[>..];
recursive fn conv_tail(n int, t int) {
	let x = ND[n]; let k = x.k as int;
	if k == N_BLOCK || k == N_EBLOCK { if x.a >= 0 && !ends(x.a as int) { conv(x.a as int, t); } return; }
	if k == N_IF { if !ends(x.b as int) { conv(x.b as int, t); } if x.c >= 0 && !ends(x.c as int) { conv(x.c as int, t); } return; }
	if k == N_MATCH { for i in x.n { let b = ND[kid(n, i)].b as int; if b >= 0 && !ends(b) { conv(b, t); } } }
}
recursive fn conv(n int, t int) bool {
	if t < 0 || n < 0 { return true; }
	let f = at(n);
	if f < 0 { return true; }
	if f == t { return true; }
	let fk = TY[f].k as int;
	let tkd = TY[t].k as int;
	if tkd == TY_ERR || fk == TY_ERR { return true; }
	if fk == TY_VOID && ends(n) { return true; }
	let nk = ND[n].k as int;
	if (nk == N_BLOCK || nk == N_EBLOCK || nk == N_IF || nk == N_MATCH) && fk != TY_VOID && (fk == TY_VARIANT && tkd == TY_ENUM && TY[f].a == TY[t].a || conv_ok(if fk == TY_REF && TY[f].c < 0 { TY[f].a as int } else { f }, t, n) && (tkd == TY_SLICE || fk == TY_REF)) { conv_tail(n, t); set_t(n, t); return true; }
	if tkd == TY_BOOL && fk == TY_REF && (TY[f].fl & RF_OPT) != 0 { set_cv(n, T_BOOL); return true; }
	if tkd == TY_REF && TY[t].c < 0 && fk != TY_NULL && fk != TY_REF { if tclass(t) >= 0 { let ok = conv(n, TY[t].a as int); if ok && cv(n) < 0 { set_cv(n, t); } return ok; } }
	if fk == TY_REF && TY[f].c < 0 && tkd != TY_REF { if conv_ok(TY[f].a as int, t, n) { set_cv(n, t); return true; } }
	if nk == N_ID && rk(n) == R_LOCAL && (LVS[rv(n)].fl & (LV_LIT | LV_VAR)) == LV_LIT && (fk == TY_INT || fk == TY_FLT) && (tkd == TY_INT || tkd == TY_FLT) && !(fk == TY_FLT && tkd == TY_INT) { set_cv(n, t); return true; }
	if fk == TY_ILIT {
		let v, u, ok = cval(n);
		if tkd == TY_INT { if ok && !int_fits(v, u, t) { var m byte[>..] = []; format(m, "constant ", v, " does not fit in ", tn(t)); cerr(n, m); return false; } commit(n, t); return true; }
		if tkd == TY_FLT || tkd == TY_VARINT { commit(n, t); return true; }
	}
	if fk == TY_FLIT && tkd == TY_FLT { commit(n, t); return true; }
	if fk == TY_STRLIT && (is_byte_arr(t) || (tkd == TY_REF && is_byte_arr(TY[t].a as int))) { commit(n, if tkd == TY_REF { TY[t].a as int } else { t }); return true; }
	if fk == TY_ARRLIT && (tkd == TY_ARR || tkd == TY_SLICE) { commit(n, t); return true; }
	if fk == TY_NULL && tkd == TY_REF && (TY[t].fl & RF_OPT) != 0 { commit(n, t); return true; }
	if conv_ok(f, t, n) { set_cv(n, t); return true; }
	var m byte[>..] = []; format(m, "cannot convert ", tn(f), " to ", tn(t)); cerr(n, m);
	false
}
fn conv_ok(f int, t int, n int) bool {
	if f == t { return true; }
	let a = TY[f]; let b = TY[t];
	if widens(f, t) { return true; }
	if b.k == TY_BOOL && a.k == TY_REF && (a.fl & RF_OPT) != 0 { return true; }
	if b.k == TY_SLICE && (a.k == TY_ARR || a.k == TY_SLICE) && a.a == b.a { return true; }
	if b.k == TY_SLICE && a.k == TY_STRLIT && b.a as int == T_U8 { return true; }
	if b.k == TY_REF && a.k == TY_REF && ((b.fl & RF_OPT) != 0 || (a.fl & RF_OPT) == 0) {
		if a.a == b.a { return true; }
		if TY[b.a].k == TY_ENUM && TY[a.a].k == TY_VARIANT && TY[a.a].a == TY[b.a].a { return true; }
		if TY[b.a].k == TY_ENUM && TY[a.a].k == TY_ENUM && TY[a.a].a == TY[b.a].a { return true; }
	}
	if b.k == TY_REF && (b.a as int == f) { return true; }
	if b.k == TY_ENUM && a.k == TY_VARIANT && a.a == b.a { return true; }
	if b.k == TY_ENUM && a.k == TY_ENUM && a.a == b.a { return true; }
	if b.k == TY_ARR && a.k == TY_ARR && a.a == b.a { return true; }
	if b.k == TY_ARR && a.k == TY_SLICE && a.a == b.a { return true; }
	false
}
fn is_construct(n int) bool { let k = ND[n].k as int; k == N_CALL || k == N_ARR || k == N_STR }
recursive fn commit(n int, t int) {
	if n < 0 { return; }
	let x = ND[n]; let k = x.k as int;
	let f = at(n);
	if f >= 0 && !is_pending(f) { if f != t && conv_ok(f, t, n) { set_cv(n, t); } return; }
	set_t(n, t);
	if k == N_UN { commit(x.a as int, t); return; }
	if k == N_BIN {
		let o = x.op as int;
		if o == T_SHL || o == T_SHR { commit(x.a as int, t); return; }
		if binprec(o) >= 5 { commit(x.a as int, t); commit(x.b as int, t); }
		return;
	}
	if k == N_IF { commit(x.b as int, t); if x.c >= 0 { commit(x.c as int, t); } return; }
	if k == N_BLOCK { if x.a >= 0 { commit(x.a as int, t); } return; }
	if k == N_EBLOCK { commit(x.a as int, t); return; }
	if k == N_MATCH { for i in x.n { commit(ND[kid(n, i)].b as int, t); } return; }
	if k == N_ARR {
		let e = if TY[t].k == TY_ARR || TY[t].k == TY_SLICE { TY[t].a as int } else { T_ERRT };
		if x.a >= 0 { conv(x.a as int, e); conv(x.b as int, T_I64); }
		for i in x.n { conv(kid(n, i), e); }
		if TY[t].k == TY_SLICE { set_t(n, t_arr(e, A_FIXED, x.n as i64, -1)); set_cv(n, t); }
		return;
	}
}
recursive fn default_t(n int) int {
	let t = at(n);
	if t < 0 { return T_VOID; }
	let k = TY[t].k as int;
	if k == TY_ILIT { let v, u, ok = cval(n); let d = if ok && u { T_U64 } else { T_I64 }; commit(n, d); return d; }
	if k == TY_FLIT { commit(n, T_F64); return T_F64; }
	if k == TY_STRLIT { set_t(n, TT_STR); return TT_STR; }
	if k == TY_ARRLIT {
		let x = ND[n];
		var e = -1;
		if x.a >= 0 { e = default_t(x.a as int); let cnt, u0, ok = cval(x.b as int); conv(x.b as int, T_I64); let a = t_arr(e, A_FIXED, cnt, -1); set_t(n, a); return a; }
		for i in x.n { let c = kid(n, i); let ct = at(c); if !is_pending(ct) { e = ct; } }
		if e < 0 && x.n > 0 { e = default_t(kid(n, 0)); }
		if e < 0 { cerr(n, "an empty [] has no element type here"); return T_ERRT; }
		for i in x.n { conv(kid(n, i), e); }
		let a = t_arr(e, A_FIXED, x.n as i64, -1);
		set_t(n, a);
		return a;
	}
	t
}
fn unify(n int, a int, b int) int {
	let ta = at(a); let tb = at(b);
	if ta < 0 || tb < 0 { return T_ERRT; }
	let da = deref(ta); let db = deref(tb);
	let ka = TY[da].k as int; let kb = TY[db].k as int;
	if ka == TY_ERR || kb == TY_ERR { return T_ERRT; }
	if ka == TY_ILIT && kb == TY_ILIT { return T_ILIT; }
	if (ka == TY_ILIT || ka == TY_FLIT) && kb == TY_FLIT { return T_FLIT; }
	if ka == TY_FLIT && kb == TY_ILIT { return T_FLIT; }
	if ka == TY_STRLIT && kb == TY_STRLIT { set_t(a, TT_STR); set_t(b, TT_STR); return TT_STR; }
	if ka == TY_STRLIT || ka == TY_ARRLIT || ka == TY_NULL { conv(a, db); return db; }
	if kb == TY_STRLIT || kb == TY_ARRLIT || kb == TY_NULL { conv(b, da); return da; }
	if ka == TY_ILIT { conv(a, db); return db; }
	if kb == TY_ILIT { conv(b, da); return da; }
	if ka == TY_FLIT { if kb == TY_FLT { conv(a, db); return db; } if kb == TY_INT { return T_FLIT; } }
	if kb == TY_FLIT { if ka == TY_FLT { conv(b, da); return da; } if ka == TY_INT { return T_FLIT; } }
	if da == db { if ta != da { set_cv(a, da); } if tb != db { set_cv(b, db); } return da; }
	if widens(da, db) && !(ka == TY_FLT && kb == TY_INT) { set_cv(a, db); if tb != db { set_cv(b, db); } return db; }
	if widens(db, da) && !(kb == TY_FLT && ka == TY_INT) { set_cv(b, da); if ta != da { set_cv(a, da); } return da; }
	if ka == TY_INT && kb == TY_FLT { set_cv(a, db); return db; }
	if kb == TY_INT && ka == TY_FLT { set_cv(b, da); return da; }
	if ka == TY_VARIANT && kb == TY_VARIANT && TY[da].a == TY[db].a { let et = t_enum(TY[da].a as int, false); set_cv(a, et); set_cv(b, et); return et; }
	if ka == TY_ENUM && kb == TY_VARIANT && TY[da].a == TY[db].a { set_cv(b, da); if ta != da { set_cv(a, da); } return da; }
	if kb == TY_ENUM && ka == TY_VARIANT && TY[da].a == TY[db].a { set_cv(a, db); if tb != db { set_cv(b, db); } return db; }
	var m byte[>..] = []; format(m, "operands of types ", tn(da), " and ", tn(db), " need a cast to a common type"); cerr(n, m);
	T_ERRT
}
recursive fn leaf_kind(t int) int {
	let x = TY[t]; let k = x.k as int;
	if k == TY_INT { return 1; } if k == TY_FLT { return 2; }
	if k == TY_STRUCT { var r = 0; for i in STI[x.a].fnum { let f = SFI[(STI[x.a].f0 as int) + i]; if f.ty < 0 { continue; } let l = leaf_kind(f.ty as int); if l == 0 || (r != 0 && r != l) { return 0; } r = l; } return r + 4; }
	if k == TY_ARR && x.s == A_FIXED as u8 { let l = leaf_kind(x.a as int); if l == 0 { return 0; } return (l & 3) + 4; }
	0
}
recursive fn leaf_type(t int) int {
	let x = TY[t]; let k = x.k as int;
	if k == TY_INT || k == TY_FLT { return t; }
	if k == TY_STRUCT { var r = -1; for i in STI[x.a].fnum { let f = SFI[(STI[x.a].f0 as int) + i]; if f.ty < 0 { continue; } let l = leaf_type(f.ty as int); if l < 0 || (r >= 0 && r != l) { return -1; } r = l; } return r; }
	if k == TY_ARR && x.s == A_FIXED as u8 { return leaf_type(x.a as int); }
	-1
}
recursive fn ck_bin(n int, want int) int {
	let x = ND[n]; let o = x.op as int;
	let a = x.a as int; let b = x.b as int;
	if o == T_ANDAND {
		ck(a, T_BOOL); conv(a, T_BOOL);
		let nm0 = NAR.len; narrow_push(a);
		ck(b, T_BOOL); conv(b, T_BOOL);
		narrow_pop(nm0);
		return set_t(n, T_BOOL);
	}
	if o == T_OROR { ck(a, T_BOOL); conv(a, T_BOOL); ck(b, T_BOOL); conv(b, T_BOOL); return set_t(n, T_BOOL); }
	if o == T_DOTEQ || o == T_DOTNEQ { ck(a, -1); ck(b, -1); return set_t(n, T_BOOL); }
	let cmp = o == T_EQ || o == T_NEQ || o == T_LT || o == T_GT || o == T_LTEQ || o == T_GTEQ;
	let w = if cmp { -1 } else { want };
	let ta = ck(a, if ND[a].k as int == N_INT { -1 } else { w });
	let sh = o == T_SHL || o == T_SHR;
	let tb = ck(b, if sh { -1 } else { if is_pending(ta) { w } else { deref(ta) } });
	if sh {
		if TY[tb].k == TY_ILIT { conv(b, T_I64); } else { if TY[deref(tb)].k != TY_INT { cerr(b, "shift count must be an integer"); } }
		let da = deref(ta);
		if TY[da].k == TY_ILIT { if want >= 0 && TY[want].k == TY_INT { conv(a, want); return set_t(n, want); } return set_t(n, T_ILIT); }
		if TY[da].k != TY_INT { cerr(a, "shift of a non-integer"); }
		if ta != da { set_cv(a, da); }
		return set_t(n, da);
	}
	let da = deref(ta); let db = deref(tb);
	let la = leaf_kind(da); let lb = leaf_kind(db);
	if (la >= 4 || lb >= 4) && !cmp {
		if da == db { if ta != da { set_cv(a, da); } if tb != db { set_cv(b, db); } return set_t(n, da); }
		if la >= 4 && (o == T_MUL || o == T_DIV) { conv(b, leaf_type(da)); if ta != da { set_cv(a, da); } return set_t(n, da); }
		if lb >= 4 && o == T_MUL { conv(a, leaf_type(db)); if tb != db { set_cv(b, db); } return set_t(n, db); }
		if lb >= 4 && o == T_DIV { conv(a, leaf_type(db)); if tb != db { set_cv(b, db); } return set_t(n, db); }
	}
	if cmp && (TY[da].k == TY_INT && TY[db].k == TY_INT) && is_signed(da) != is_signed(db) && (ibits(da) == 64 || ibits(db) == 64) && !widens(da, db) && !widens(db, da) {
		set_x(n, 1);
		return set_t(n, T_BOOL);
	}
	if cmp && (o == T_EQ || o == T_NEQ) {
		let ka = TY[da].k as int; let kb = TY[db].k as int;
		if ka == TY_NULL || kb == TY_NULL { if ka == TY_NULL && kb == TY_NULL { return set_t(n, T_BOOL); } if ka == TY_NULL { set_t(a, tb); } else { set_t(b, ta); } return set_t(n, T_BOOL); }
		if ka == TY_STRLIT || kb == TY_STRLIT || (is_byte_arr(da) && is_byte_arr(db)) { if ka == TY_STRLIT { set_t(a, TT_STR); } if kb == TY_STRLIT { set_t(b, TT_STR); } set_x(n, 2); return set_t(n, T_BOOL); }
		if (ka == TY_STRUCT || ka == TY_ARR || ka == TY_ENUM || ka == TY_VARIANT || ka == TY_SLICE) && da == db { set_x(n, 3); return set_t(n, T_BOOL); }
		if ka == TY_ENUM && kb == TY_VARIANT || ka == TY_VARIANT && kb == TY_ENUM { set_x(n, 3); return set_t(n, T_BOOL); }
		if ka == TY_ARRLIT || kb == TY_ARRLIT { if ka == TY_ARRLIT { conv(a, db); } else { conv(b, da); } set_x(n, 3); return set_t(n, T_BOOL); }
		if (ka == TY_ARR || ka == TY_SLICE) && (kb == TY_ARR || kb == TY_SLICE) && TY[da].a == TY[db].a { let st = t_slice(TY[da].a as int, false); conv(a, st); conv(b, st); set_x(n, 3); return set_t(n, T_BOOL); }
	}
	let u = unify(n, a, b);
	if cmp { if TY[u].k == TY_ILIT { conv(a, T_I64); conv(b, T_I64); } if TY[u].k == TY_FLIT { conv(a, T_F64); conv(b, T_F64); } return set_t(n, T_BOOL); }
	let uk = TY[u].k as int;
	if (o == T_AND || o == T_OR || o == T_XOR) && uk != TY_INT && uk != TY_ILIT && uk != TY_BOOL && uk != TY_ERR { cerr(n, "bitwise operator on a non-integer"); }
	if uk == TY_BOOL && o != T_AND && o != T_OR && o != T_XOR { cerr(n, "arithmetic on bool"); }
	set_t(n, u)
}
fn ck_un(n int, want int) int {
	let x = ND[n]; let o = x.op as int;
	let a = x.a as int;
	if o == T_NOT { ck(a, T_BOOL); conv(a, T_BOOL); return set_t(n, T_BOOL); }
	if o == T_AND { let t = ck(a, if want >= 0 && TY[want].k == TY_REF { TY[want].a as int } else { -1 }); if is_pending(t) { default_t(a); } set_x(n, 1); return set_t(n, at(a)); }
	let t = ck(a, if ND[a].k as int == N_INT || ND[a].k as int == N_FLT { -1 } else { want });
	let d = deref(t);
	if t != d { set_cv(a, d); }
	if o == T_MINUS && TY[d].k == TY_INT && !is_signed(d) { cerr(n, "unary - of an unsigned integer"); }
	set_t(n, d)
}
fn deref_place(t int) int { if TY[t].k == TY_REF && TY[t].c < 0 { TY[t].a as int } else { t } }
recursive fn ck_id(n int, want int) int {
	let name = ND[n].s as int;
	let v = find_lv(name);
	if v >= 0 { set_r(n, R_LOCAL, v); note_cap(v); return set_t(n, if (LVS[v].fl & LV_FLET) != 0 { T_FLIT } else { LVS[v].ty as int }); }
	let ns = ns_of(n);
	if find_nest(name) >= 0 || block_binding(name) >= 0 { set_x(n, -1); return set_t(n, T_FNV); }
	var d = lookup_q(name, ns, D_GLOBAL);
	if d >= 0 {
		let g = DC[d].node as int;
		let ci = const_of(d);
		if ci >= 0 { set_r(n, R_CONST, ci); return set_t(n, T_ILIT); }
		set_r(n, R_GLOBAL, d);
		return set_t(n, global_type(d));
	}
	d = lookup_q(name, ns, D_FN);
	if d >= 0 { set_r(n, R_FN, d); set_x(n, -1); return set_t(n, T_FNV); }
	if find_nest(name) >= 0 || block_binding(name) >= 0 { set_x(n, -1); return set_t(n, T_FNV); }
	var m byte[>..] = []; format(m, "unknown name: ", nm(name)); cerr(n, m);
	set_t(n, T_ERRT)
}
var GLT i32[>..];
var GLST u8[>..];
recursive fn const_of(d int) int {
	for c, i in CONSTD { if c as int == d { return i; } }
	let g = DC[d].node as int;
	let x = ND[g];
	if (x.fl & V_VAR) != 0 || x.a >= 0 || x.b < 0 { return -1; }
	let iv = kid(x.b as int, 0);
	let v, ok = ceval(iv, ns_of(g));
	if !ok { return -1; }
	if !all_int(iv) { return -1; }
	CONSTD.push(d as i32); CONSTV.push(v);
	CONSTD.len - 1
}
recursive fn all_int(n int) bool {
	let x = ND[n]; let k = x.k as int;
	if k == N_INT { return true; }
	if k == N_UN { return all_int(x.a as int); }
	if k == N_BIN { return all_int(x.a as int) && all_int(x.b as int); }
	if k == N_ID { let d = lookup_q(x.s as int, ns_of(n), D_GLOBAL); if d < 0 { return false; } return const_of(d) >= 0; }
	if k == N_DOT { return nm(x.s as int) == "len"; }
	false
}
recursive fn global_type(d int) int {
	while GLT.len < DC.len { GLT.push(-1); GLST.push(0); }
	if GLT[d] >= 0 { return GLT[d] as int; }
	let g = DC[d].node as int;
	let x = ND[g];
	let saved = AOWN; let sc = CFN;
	AOWN = GLOBI; CFN = GLOBI;
	var t = -1;
	if x.a >= 0 { t = rtype(x.a as int, ns_of(g)); GLT[d] = t as i32; if x.b >= 0 { let iv = kid(x.b as int, 0); ck(iv, t); conv(iv, t); } }
	else {
		if GLST[d] == 1 { cerr(g, "global initializer depends on itself"); AOWN = saved; CFN = sc; return T_ERRT; }
		GLST[d] = 1;
		let iv = kid(x.b as int, 0);
		ck(iv, -1);
		t = default_t(iv);
		if TY[t].k == TY_STRLIT { t = TT_STR; }
		if TY[t].k == TY_VARIANT && (ND[iv].k == N_DOT || ND[iv].k == N_SLIT) && (x.fl & V_VAR) != 0 { t = t_enum(TY[t].a as int, false); set_cv(iv, t); }
		GLT[d] = t as i32;
	}
	if !ORD_HAS(d) { ORDER.push(d as i32); }
	AOWN = saved; CFN = sc;
	t
}
fn ORD_HAS(d int) bool { for o in ORDER { if o as int == d { return true; } } false }
fn place_ok(n int) bool { let k = ND[n].k as int; k == N_ID || k == N_DOT || k == N_IDX || (k == N_UN && ND[n].op as int == T_MUL) }
var HRELC i8[>..];
recursive fn has_rel(t int) bool {
	if t < 0 { return false; }
	while HRELC.len < TY.len { HRELC.push(-1); }
	if HRELC[t] >= 0 { return HRELC[t] == 1; }
	HRELC[t] = 0;
	let x = TY[t]; let k = x.k as int;
	var r = false;
	if k == TY_STRUCT { let si = x.a as int; for i in STI[si].fnum { let ft = SFI[(STI[si].f0 as int) + i].ty as int; if ft >= 0 && ((TY[ft].k == TY_REF && TY[ft].c >= 0) || has_rel(ft)) { r = true; } } }
	if k == TY_ARR && x.s as int == A_FIXED { r = has_rel(x.a as int); }
	while HRELC.len < TY.len { HRELC.push(-1); }
	HRELC[t] = if r { 1 } else { 0 };
	r
}
fn decode_rel(ft int) int { if TY[ft].k == TY_REF && TY[ft].c >= 0 { t_ref(TY[ft].a as int, TY[ft].fl as int) } else { ft } }
recursive fn ck_dot(n int, want int) int {
	let x = ND[n];
	let a = x.a as int;
	let name = x.s as int;
	if ND[a].k == N_ID && find_lv(ND[a].s as int) < 0 {
		let ns = ns_of(a);
		let de = lookup_q(ND[a].s as int, ns, D_ENUM);
		if de >= 0 && lookup_q(ND[a].s as int, ns, D_GLOBAL) < 0 {
			let et = rtype_name_enum(de);
			let ei = TY[et].a as int;
			for i in ENI[ei].vnum { if ENV[(ENI[ei].v0 as int) + i].name as int == name { set_r(n, R_VARIANT, i); return set_t(n, t_variant(ei, i)); } }
			var m byte[>..] = []; format(m, "no variant ", nm(name), " in ", tn(et)); cerr(n, m); return set_t(n, T_ERRT);
		}
	}
	let t0 = ck(a, -1);
	var t = t0;
	if TY[t].k == TY_STRLIT { t = TT_STR; set_t(a, TT_STR); }
	if TY[t].k == TY_ARRLIT { t = default_t(a); }
	let d = deref(t);
	let k = TY[d].k as int;
	if (k == TY_ARR || k == TY_SLICE) && nm(name) == "len" { set_r(n, R_MEMBER, 1); return set_t(n, T_I64); }
	if k == TY_ARR && nm(name) == "cap" { set_r(n, R_MEMBER, 2); return set_t(n, T_I64); }
	if k == TY_STRUCT {
		let si = TY[d].a as int;
		let fi = sfield(si, name);
		if fi >= 0 { set_r(n, R_FIELD, fi); let ft = SFI[(STI[si].f0 as int) + fi].ty as int; return set_t(n, decode_rel(ft)); }
	}
	if k == TY_VARIANT {
		let v = ENV[(ENI[TY[d].a].v0 as int) + (TY[d].c as int)];
		if v.si >= 0 { let fi = sfield(v.si as int, name); if fi >= 0 { set_r(n, R_FIELD, fi); set_x(n, v.si as int); return set_t(n, decode_rel(SFI[(STI[v.si].f0 as int) + fi].ty as int)); } }
	}
	var m byte[>..] = []; format(m, "no field ", nm(name), " in ", tn(d)); cerr(n, m);
	set_t(n, T_ERRT)
}
fn rtype_name_enum(de int) int { let node = DC[de].node as int; var none i32[..1] = []; t_enum(inst_enum(node, none[..]), false) }
recursive fn ck_idx(n int, want int) int {
	let x = ND[n];
	var t = ck(x.a as int, -1);
	if TY[t].k == TY_STRLIT { set_t(x.a as int, TT_STR); t = TT_STR; }
	if TY[t].k == TY_ARRLIT { t = default_t(x.a as int); }
	let d = deref(t);
	let ti = ck(x.b as int, T_I64);
	if TY[ti].k == TY_ILIT { conv(x.b as int, T_I64); } else { let di = deref(ti); if TY[di].k != TY_INT && TY[di].k != TY_VARINT { cerr(x.b as int, "index must be an integer"); } else { if di != ti { set_cv(x.b as int, di); } } }
	let k = TY[d].k as int;
	if k == TY_ARR || k == TY_SLICE { return set_t(n, decode_rel(TY[d].a as int)); }
	var m byte[>..] = []; format(m, "cannot index ", tn(d)); cerr(n, m);
	set_t(n, T_ERRT)
}
recursive fn ck_slice(n int, want int) int {
	let x = ND[n];
	var t = ck(x.a as int, -1);
	if TY[t].k == TY_STRLIT { set_t(x.a as int, TT_STR); t = TT_STR; }
	if TY[t].k == TY_ARRLIT { t = default_t(x.a as int); }
	let d = deref(t);
	if x.b >= 0 { ck(x.b as int, T_I64); conv(x.b as int, T_I64); }
	if x.c >= 0 { ck(x.c as int, T_I64); conv(x.c as int, T_I64); }
	let k = TY[d].k as int;
	if k == TY_ARR { return set_t(n, t_slice(TY[d].a as int, false)); }
	if k == TY_SLICE { return set_t(n, d); }
	var m byte[>..] = []; format(m, "cannot slice ", tn(d)); cerr(n, m);
	set_t(n, T_ERRT)
}
recursive fn ck_as(n int, want int) int {
	let x = ND[n];
	let t = rtype(x.b as int, ns_of(n));
	let f = ck(x.a as int, if TY[t].k == TY_INT || TY[t].k == TY_FLT { -1 } else { t });
	let df = deref(f);
	if TY[df].k == TY_ILIT && (x.fl & 1) != 0 && TY[t].k == TY_INT { default_t(x.a as int); }
	else { if TY[df].k == TY_ILIT || TY[df].k == TY_FLIT { conv(x.a as int, if TY[t].k == TY_INT || TY[t].k == TY_FLT { t } else { T_I64 }); }
	else { if df != f { set_cv(x.a as int, df); } } }
	set_t(n, t)
}
recursive fn ck_block(n int, want int) int {
	let x = ND[n];
	let m = SCOPE.len;
	let nm0 = NAR.len;
	let nf0 = pre_decl_block_fns(n);
	for i in x.n { cstmt(kid(n, i)); }
	var t = T_VOID;
	if x.a >= 0 { t = ck(x.a as int, want); }
	pop_block_fns(nf0);
	narrow_pop(nm0);
	SCOPE.pop_n(SCOPE.len - m);
	set_t(n, t)
}
recursive fn ends(n int) bool {
	if n < 0 { return false; }
	let k = ND[n].k as int;
	if k == N_RET || k == N_BREAK || k == N_CONT { return true; }
	if k == N_CALL && ND[ND[n].a].k == N_ID { let s = nm(ND[ND[n].a].s as int); if s == "abort" || s == "exit" { return true; } }
	if k == N_BLOCK { if ND[n].a >= 0 { return ends(ND[n].a as int); } if ND[n].n > 0 { return ends(kid(n, (ND[n].n as int) - 1)); } return false; }
	if k == N_IF { return ND[n].c >= 0 && ends(ND[n].b as int) && ends(ND[n].c as int); }
	if k == N_LOOP { return !has_break(ND[n].a as int); }
	false
}
recursive fn has_break(n int) bool {
	if n < 0 { return false; }
	let x = ND[n]; let k = x.k as int;
	if k == N_BREAK { return true; }
	if k == N_WHILE || k == N_LOOP || k == N_FOR || k == N_FN || k == N_FUNVAL { return false; }
	if k >= 40 && k < 50 { return false; }
	if k == N_VDECL { return has_break(x.b as int); }
	if k == N_CALL { if has_break(x.a as int) { return true; } for i in x.n { if has_break(kid(n, i)) { return true; } } return false; }
	if has_break(x.a as int) || has_break(x.b as int) || has_break(x.c as int) || has_break(x.d as int) { return true; }
	if k == N_BLOCK || k == N_MATCH || k == N_LIST || k == N_ARR || k == N_SLIT || k == N_RET {
		for i in x.n {
			let c = kid(n, i);
			if has_break(c) { return true; }
			if k == N_MATCH && has_break(ND[c].b as int) { return true; }
		}
	}
	false
}
recursive fn ck_if(n int, want int) int {
	let x = ND[n];
	let c = ck(x.a as int, T_BOOL);
	conv(x.a as int, T_BOOL);
	let m = SCOPE.len;
	let nm0 = NAR.len;
	narrow_push(x.a as int);
	let tb = ck(x.b as int, want);
	narrow_pop(nm0);
	SCOPE.pop_n(SCOPE.len - m);
	if x.c < 0 { return set_t(n, T_VOID); }
	let tc = ck(x.c as int, want);
	let eb = ends(x.b as int); let ec = ends(x.c as int);
	if eb && !ec { return set_t(n, tc); }
	if ec && !eb { return set_t(n, tb); }
	if eb && ec { return set_t(n, tb); }
	if tb == T_VOID || tc == T_VOID { return set_t(n, T_VOID); }
	if tb == tc { return set_t(n, tb); }
	if want >= 0 && want != T_VOID && (is_pending(tb) || conv_ok(tb, want, x.b as int)) && (is_pending(tc) || conv_ok(tc, want, x.c as int)) { conv(x.b as int, want); conv(x.c as int, want); return set_t(n, want); }
	let db = deref(tb); let dc = deref(tc);
	if (TY[db].k == TY_ARR || TY[db].k == TY_SLICE) && (TY[dc].k == TY_ARR || TY[dc].k == TY_SLICE) && TY[db].a == TY[dc].a { let st = t_slice(TY[db].a as int, false); conv_tail(n, st); return set_t(n, st); }
	let u = unify(n, x.b as int, x.c as int);
	set_t(n, u)
}
recursive fn ck_while(n int) int {
	let x = ND[n];
	let c = ck(x.a as int, T_BOOL);
	conv(x.a as int, T_BOOL);
	let nm0 = NAR.len;
	narrow_push(x.a as int);
	LOOPD++;
	ck(x.b as int, T_VOID);
	LOOPD--;
	narrow_pop(nm0);
	set_t(n, T_VOID)
}
var BRK_T i32[>..<];
recursive fn ck_loop(n int, want int) int {
	BRK_T.push(-1);
	LOOPD++;
	ck(ND[n].a as int, T_VOID);
	LOOPD--;
	let t = BRK_T.pop() as int;
	set_t(n, if t < 0 { T_VOID } else { t })
}
recursive fn ck_for(n int) int {
	let x = ND[n];
	let m = SCOPE.len;
	var et = T_I64;
	if x.b >= 0 {
		let ta = ck(x.a as int, -1); let tb = ck(x.b as int, -1);
		let u = unify(n, x.a as int, x.b as int);
		et = if TY[u].k == TY_ILIT { conv(x.a as int, T_I64); conv(x.b as int, T_I64); T_I64 } else { u };
		set_x(n, 0);
	} else {
		var t = ck(x.a as int, -1);
		if TY[t].k == TY_STRLIT { set_t(x.a as int, TT_STR); t = TT_STR; }
		if TY[t].k == TY_ARRLIT { t = default_t(x.a as int); }
		let d = deref(t);
		if TY[d].k == TY_ILIT { conv(x.a as int, T_I64); et = T_I64; set_x(n, 0); }
		else { if TY[d].k == TY_INT || TY[d].k == TY_VARINT { et = if TY[d].k == TY_VARINT { T_I64 } else { d }; if et != t { set_cv(x.a as int, et); } set_x(n, 0); }
		else { if TY[d].k == TY_ARR || TY[d].k == TY_SLICE { et = decode_rel(TY[d].a as int); set_x(n, 1); }
		else { var mm byte[>..] = []; format(mm, "cannot iterate over ", tn(d)); cerr(n, mm); } } }
	}
	if x.l >= 0 { et = rtype(x.l as int, ns_of(n)); }
	let byref = (x.fl & 1) != 0 || is_bytes(et);
	let v = add_lv(x.s as int, if byref { t_ref(et, 0) } else { et }, LV_FOR | (if byref { LV_REF } else { 0 }), n);
	set_r(n, R_LOCAL, v);
	if x.c >= 0 { let iv = add_lv(x.c as int, if x.n >= 0 { rtype(x.n as int, ns_of(n)) } else { T_I64 }, LV_FOR, n); set_x(n, ax(n) | (iv << 2)); }
	LOOPD++;
	ck(x.d as int, T_VOID);
	LOOPD--;
	SCOPE.pop_n(SCOPE.len - m);
	set_t(n, T_VOID)
}
recursive fn ck_match(n int, want int) int {
	let x = ND[n];
	var st = ck(x.a as int, -1);
	if TY[st].k == TY_ILIT { conv(x.a as int, T_I64); st = T_I64; }
	if TY[st].k == TY_VARIANT { st = t_enum(TY[st].a as int, false); set_cv(x.a as int, st); }
	let d = deref(st);
	var rt = -1;
	var allv = true;
	for i in x.n {
		let arm = kid(n, i);
		let m = SCOPE.len;
		let ax0 = ND[arm];
		if (ax0.fl & 1) == 0 {
			for j in ax0.n {
				let it = kid(arm, j);
				let lo = ND[it].a as int;
				if TY[d].k == TY_ENUM && ND[lo].k == N_ID {
					let ei = TY[d].a as int;
					var found = -1;
					for q in ENI[ei].vnum { if ENV[(ENI[ei].v0 as int) + q].name == ND[lo].s { found = q; } }
					if found < 0 { var mm byte[>..] = []; format(mm, "no variant ", nm(ND[lo].s as int), " in ", tn(d)); cerr(lo, mm); }
					set_r(lo, R_VARIANT, found); set_t(lo, d);
					if ax0.s >= 0 && found >= 0 { let vt = t_variant(ei, found); let byr = (ax0.fl & 2) != 0 || is_bytes(vt); let v = add_lv(ax0.s as int, if byr { t_ref(vt, 0) } else { vt }, if byr { LV_REF } else { 0 }, arm); set_r(arm, R_LOCAL, v); }
				} else {
					ck(lo, d); conv(lo, d);
					if ND[it].b >= 0 { ck(ND[it].b as int, d); conv(ND[it].b as int, d); }
				}
			}
		}
		let bt = ck(ax0.b as int, want);
		SCOPE.pop_n(SCOPE.len - m);
		if bt == T_VOID { allv = false; } else { if !ends(ax0.b as int) { if rt < 0 || is_pending(rt) { rt = bt; } } }
	}
	if !allv || rt < 0 { return set_t(n, T_VOID); }
	var allw = want >= 0 && want != T_VOID;
	if allw { for i in x.n { let b = ND[kid(n, i)].b as int; let bt = at(b); if !ends(b) && !is_pending(bt) && !conv_ok(bt, want, b) { allw = false; } } }
	if allw { for i in x.n { let b = ND[kid(n, i)].b as int; if !ends(b) { conv(b, want); } } return set_t(n, want); }
	if is_pending(rt) { for i in x.n { let b = ND[kid(n, i)].b as int; let bt = at(b); if !is_pending(bt) && !ends(b) { rt = bt; } } }
	if is_pending(rt) { let b = ND[kid(n, 0)].b as int; rt = default_t(b); }
	for i in x.n { let b = ND[kid(n, i)].b as int; if !ends(b) { conv(b, rt); } }
	set_t(n, rt)
}
fn find_from_fn(name int) int {
	var i = AOWN;
	while i >= 0 {
		if FI_[i].node >= 0 && ND[FI_[i].node].k == N_FN && FI_[i].name as int == name { return i; }
		i = if FI_[i].bown >= 0 { FI_[i].bown as int } else { FI_[i].par as int };
	}
	-1
}
recursive fn ck_ret(n int) int {
	let x = ND[n];
	let f = if x.s >= 0 { find_from_fn(x.s as int) } else { ret_fn() };
	if f < 0 { cerr(n, "return outside a function"); return T_VOID; }
	if f != CFN { FI_[CFN].lr = true; FI_[f].tg = true; set_x(n, f); } else { set_x(n, -1); }
	let rt = FI_[f].ret as int;
	if x.n == 0 { if rt >= 0 && rt != T_VOID && !FI_[f].rinf { cerr(n, "return needs a value"); } if rt < 0 { FI_[f].ret = T_VOID as i32; } return set_t(n, T_VOID); }
	if rt >= 0 && TY[rt].k == TY_MULTI && x.n == 1 { let c = kid(n, 0); ck(c, rt); return set_t(n, T_VOID); }
	if x.n > 1 {
		if rt < 0 { var ts i32[..64] = []; for i in x.n { ck(kid(n, i), -1); let dt0 = default_t(kid(n, i)); ts.push(dt0 as i32); } FI_[f].ret = tlist(TY_MULTI, ts[..], -1) as i32; return set_t(n, T_VOID); }
		for i in x.n { let et = if TY[rt].k == TY_MULTI && i < TY[rt].n as int { TYL[(TY[rt].l as int) + i] as int } else { T_ERRT }; ck(kid(n, i), et); conv(kid(n, i), et); }
		return set_t(n, T_VOID);
	}
	let c = kid(n, 0);
	if rt < 0 { ck(c, -1); var t = default_t(c); FI_[f].ret = t as i32; return set_t(n, T_VOID); }
	ck(c, rt); conv(c, rt);
	set_t(n, T_VOID)
}
fn ret_fn() int { var i = AOWN; while i >= 0 { if FI_[i].node >= 0 && ND[FI_[i].node].k == N_FN { return i; } i = FI_[i].par as int; } -1 }
recursive fn ck_break(n int) int {
	let x = ND[n];
	if x.a >= 0 {
		if BRK_T.len == 0 { cerr(n, "break with a value outside loop or block"); return T_VOID; }
		let w = BRK_T[BRK_T.len - 1] as int;
		let t = ck(x.a as int, if w >= 0 { w } else { -1 });
		if w < 0 { BRK_T[BRK_T.len - 1] = default_t(x.a as int) as i32; } else { conv(x.a as int, w); }
	}
	set_t(n, T_VOID)
}
recursive fn ck(n int, want int) int {
	if n < 0 { return T_VOID; }
	let x = ND[n];
	let k = x.k as int;
	if k == N_INT { if want >= 0 && (TY[want].k == TY_INT || TY[want].k == TY_FLT || TY[want].k == TY_VARINT) { set_t(n, T_ILIT); conv(n, want); return want; } return set_t(n, T_ILIT); }
	if k == N_FLT { if want >= 0 && TY[want].k == TY_FLT { return set_t(n, want); } return set_t(n, T_FLIT); }
	if k == N_STR { if want >= 0 && is_byte_arr(want) { return set_t(n, want); } return set_t(n, T_STRLIT); }
	if k == N_TRUE || k == N_FALSE { return set_t(n, T_BOOL); }
	if k == N_NULL { if want >= 0 && is_opt(want) { return set_t(n, want); } return set_t(n, T_NULL); }
	if k == N_SELF { return set_t(n, if want >= 0 { want } else { T_ERRT }); }
	if k == N_ID { return ck_id(n, want); }
	if k == N_BIN { let t = ck_bin(n, want); if want >= 0 && is_pending(t) && (TY[want].k == TY_INT || TY[want].k == TY_FLT) { conv(n, want); return want; } return t; }
	if k == N_UN { let t = ck_un(n, want); if want >= 0 && is_pending(t) && (TY[want].k == TY_INT || TY[want].k == TY_FLT) { conv(n, want); return want; } return t; }
	if k == N_DOT { return ck_dot(n, want); }
	if k == N_IDX { return ck_idx(n, want); }
	if k == N_SLICE { return ck_slice(n, want); }
	if k == N_AS { return ck_as(n, want); }
	if k == N_ARR { return ck_arr(n, want); }
	if k == N_BLOCK { return ck_block(n, want); }
	if k == N_EBLOCK { BRK_T.push(if want >= 0 && want != T_VOID { want as i32 } else { -1 }); let bt = ck(x.a as int, want); let t = BRK_T.pop() as int; if bt != T_VOID && !is_pending(bt) { return set_t(n, bt); } if t >= 0 { if bt != T_VOID { conv(x.a as int, t); } return set_t(n, t); } return set_t(n, bt); }
	if k == N_IF { return ck_if(n, want); }
	if k == N_WHILE { return ck_while(n); }
	if k == N_LOOP { return ck_loop(n, want); }
	if k == N_FOR { return ck_for(n); }
	if k == N_MATCH { return ck_match(n, want); }
	if k == N_RET { return ck_ret(n); }
	if k == N_BREAK { return ck_break(n); }
	if k == N_CONT { return set_t(n, T_VOID); }
	if k == N_CALL { return ck_call(n, want); }
	if k == N_SLIT { return ck_slit(n, want); }
	if k == N_FUNVAL { return set_t(n, T_FNV); }
	cerr(n, "unsupported expression");
	set_t(n, T_ERRT)
}
recursive fn ck_arr(n int, want int) int {
	let x = ND[n];
	var e = -1;
	if want >= 0 && (TY[want].k == TY_ARR || TY[want].k == TY_SLICE) { e = TY[want].a as int; }
	if x.c >= 0 { ck(x.c as int, T_I64); conv(x.c as int, T_I64); if want >= 0 { return set_t(n, want); } return set_t(n, T_ARRLIT); }
	if x.a >= 0 { ck(x.a as int, e); ck(x.b as int, T_I64); if e >= 0 { conv(x.a as int, e); conv(x.b as int, T_I64); if TY[want].k == TY_SLICE { let cnt, u0, ok = cval(x.b as int); set_t(n, t_arr(e, A_FIXED, cnt, -1)); set_cv(n, want); return want; } return set_t(n, want); } return set_t(n, T_ARRLIT); }
	for i in x.n { ck(kid(n, i), e); }
	if e >= 0 {
		for i in x.n { conv(kid(n, i), e); }
		if TY[want].k == TY_SLICE { set_t(n, t_arr(e, A_FIXED, x.n as i64, -1)); set_cv(n, want); return want; }
		return set_t(n, want);
	}
	set_t(n, T_ARRLIT)
}
var STMTN = -1;
recursive fn cstmt(n int) {
	let x = ND[n];
	let k = x.k as int;
	if k == N_VDECL { ck_vdecl(n); return; }
	if k == N_ASSIGN { ck_assign(n); return; }
	if k == N_INCDEC { let t = ck(x.a as int, -1); if TY[deref(t)].k != TY_INT && TY[deref(t)].k != TY_VARINT { cerr(n, "++/-- needs an integer"); } return; }
	if k == N_FN { decl_nested(n); return; }
	STMTN = n;
	let t = ck(n, -1);
	if is_pending(t) { default_t(n); }
}
fn fin_t(n int) int { let c = cv(n); if c >= 0 { c } else { at(n) } }
recursive fn names_store(n int) bool {
	let x = ND[n]; let k = x.k as int;
	if k == N_ID { let r = rk(n); return r == R_LOCAL || r == R_GLOBAL; }
	if k == N_DOT { return rk(n) == R_FIELD && (names_store(x.a as int) || TY[at(x.a as int)].k == TY_REF); }
	if k == N_IDX { let bt = at(x.a as int); return TY[deref(bt)].k == TY_SLICE || names_store(x.a as int) || TY[bt].k == TY_REF; }
	false
}
recursive fn ck_vdecl(n int) {
	let x = ND[n];
	let fl = x.fl as int;
	let ns = ns_of(n);
	let byref = (fl & V_BYREF) != 0;
	var dt = if x.a >= 0 { rtype(x.a as int, ns) } else { -1 };
	var lf = (if (fl & V_VAR) != 0 { LV_VAR } else { 0 }) | (if (fl & V_CONST) != 0 { LV_CONST } else { 0 }) | (if byref { LV_REF } else { 0 });
	if x.n > 1 {
		if x.b < 0 { cerr(n, "several names need a call's results"); return; }
		let init = kid(x.b as int, 0);
		let t = ck(init, -1);
		if TY[t].k != TY_MULTI { if ND[x.b].n as int == x.n as int { for i in 1..x.n { let iv = kid(x.b as int, i); ck(iv, dt); if dt >= 0 { conv(iv, dt); } else { default_t(iv); } } if dt >= 0 { conv(init, dt); } else { default_t(init); } for i in x.n { let iv = kid(x.b as int, i); let v = add_lv(LS[(x.l as int) + i] as int, if dt >= 0 { dt } else { fin_t(iv) }, lf, n); if i == 0 { set_r(n, R_LOCAL, v); } } set_x(n, 1); return; } cerr(n, "several names need a call with as many results"); return; }
		if TY[t].n != x.n { cerr(n, "result count does not match the names"); }
		for i in x.n { let et = if i < TY[t].n as int { TYL[(TY[t].l as int) + i] as int } else { T_ERRT }; let v = add_lv(LS[(x.l as int) + i] as int, et, lf, n); if i == 0 { set_r(n, R_LOCAL, v); } }
		return;
	}
	var t = dt;
	if x.b >= 0 {
		let init = kid(x.b as int, 0);
		if dt < 0 && ND[init].k == N_ARR && ND[init].n == 0 && ND[init].a < 0 && ND[init].c < 0 {
			t = t_arr(T_ERRT, A_GROW, -1, -1);
			set_t(init, t);
		} else {
			let it = ck(init, dt);
			if dt >= 0 { if byref { if !(TY[dt].k == TY_REF) { conv(init, dt); } } else { conv(init, dt); } }
			else {
				if TY[it].k == TY_FLIT && (lf & (LV_VAR | LV_REF)) == 0 { lf = lf | LV_FLET; }
				t = default_t(init);
				if TY[t].k == TY_MULTI { t = TYL[TY[t].l] as int; }
				if TY[t].k == TY_VARIANT && (ND[init].k == N_DOT || ND[init].k == N_SLIT) && (lf & LV_VAR) != 0 { t = t_enum(TY[t].a as int, false); set_cv(init, t); }
				if byref || (ND[init].k == N_UN && ND[init].op as int == T_AND) { if TY[t].k != TY_REF { t = t_ref(t, 0); } }
				else { if TY[t].k == TY_REF && TY[t].c < 0 && (TY[t].fl & RF_OPT) == 0 && is_fixed(TY[t].a as int) && !has_rel(TY[t].a as int) { t = TY[t].a as int; set_cv(init, t); } else { if TY[t].k != TY_REF && TY[t].k != TY_SLICE && !is_fixed(t) && names_store(init) { t = t_ref(t, 0); } } }
			}
		}
	} else {
		if t < 0 { cerr(n, "a declaration needs a type or an initializer"); t = T_ERRT; }
	}
	if byref && TY[t].k != TY_REF { t = t_ref(t, 0); }
	let v = add_lv(LS[x.l] as int, t, lf, n);
	set_r(n, R_LOCAL, v);
}
recursive fn ck_assign(n int) {
	let x = ND[n];
	let o = x.op as int;
	if o == T_COMMA {
		let t = ck(x.b as int, -1);
		let tl = x.a as int;
		for i in ND[tl].n { let tg = kid(tl, i); let tt = ck(tg, -1); }
		return;
	}
	if o == T_DOTASSIGN {
		let tt = ck(x.a as int, -1);
		let rt = ck(x.b as int, tt);
		if is_pending(rt) {
			if TY[rt].k == TY_NULL && TY[tt].k == TY_REF { set_t(x.b as int, t_ref(TY[tt].a as int, RF_OPT)); }
			else { default_t(x.b as int); }
		}
		if ND[x.a].k == N_ID && rk(x.a as int) == R_LOCAL {
			let v = rv(x.a as int);
			if is_opt(at(x.b as int)) || TY[at(x.b as int)].k == TY_NULL {
				LVS[v].ty = t_ref(TY[LVS[v].ty].a as int, RF_OPT) as i32;
			}
		}
		return;
	}
	let tt = ck(x.a as int, -1);
	let d = deref(tt);
	if o == T_ASSIGN {
		if TY[tt].k == TY_REF && is_opt(tt) {
			let rt = ck(x.b as int, tt);
			if TY[rt].k == TY_NULL { commit(x.b as int, tt); return; }
			if TY[rt].k == TY_REF { conv(x.b as int, tt); return; }
		}
		ck(x.b as int, d); conv(x.b as int, d);
		return;
	}
	let lk = leaf_kind(d);
	let rt = ck(x.b as int, if (lk >= 4 && (o == T_MULEQ || o == T_DIVEQ)) || o == T_SHLEQ || o == T_SHREQ { -1 } else { d });
	if lk >= 4 && (o == T_MULEQ || o == T_DIVEQ) && deref(rt) != d { conv(x.b as int, leaf_type(d)); return; }
	if o == T_SHLEQ || o == T_SHREQ { if is_pending(rt) { conv(x.b as int, T_I64); } return; }
	conv(x.b as int, d);
}
