use std
use os
spans(s const byte[:], out int[>..]&):
	at ~= 0
	while at < s.len:
		while at < s.len && is_space(s[at]): at += 1
		b := at
		while at < s.len && !is_space(s[at]): at += 1
		if at > b { out.push(b); out.push(at) }
main():
	a := args()
	buf byte[900] ~= [0; 900]
	bad ~= 0
	total ~= 0
	x ~= 99
	for t 400:
		n := 1 + t * 2
		den := [3, 9, 40, 150, 700][t % 5]
		for i n:
			x = (x * 1103515245 + 12345) & 0x7FFFFFFF
			r := x >> 8
			buf[i] = if r % den == 0 { " \t\n\r\x0B\x0C"[r / den % 6] } else if r % 37 == 1 { "\x08\x0E\x1F!\x89\xA0\x8D"[r / 37 % 7] } else { (97 + r % 26) as byte }
		s := buf[..n]
		want int[>..] ~= []
		spans(s, want)
		got := words(s)
		total += got.len
		if got.len * 2 != want.len { bad += 1 } else { for w, k got { if (std_ptr(w) - std_ptr(s)) as int != want[2 * k] || w.len != want[2 * k + 1] - want[2 * k] { bad += 1 } } }
	print("words ", total, " mismatches ", bad)
	bad = 0
	if std_vk_cpu() == 1 || a.len > 1 && a[1] == "HC_NOVK":
		for p 257:
			for i 256: buf[i] = (33 + (i * 7 + p) % 90) as byte
			if p < 256 { buf[p] = " \t\n\r\x0B\x0C"[p % 6] }
			if p > 9 { buf[p - 9] = "\x08\x0E\x1F!\x89\xA0\x8D"[p % 7] }
			bad += if std_vk_span(std_ptr(buf[..]), 256) == p { 0 } else { 1 }
	print("direct mismatches ", bad)
