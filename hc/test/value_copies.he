use std
struct In { d byte[>..], k int = 7 }
struct Out { i In, s f32 = 1.0 }
var A byte[>..][>..] = []
var B Out[>..] = []
var C In[>..] = []
var D = In{[], 0}
var H In[>..] = []
mk(n int) byte[>..]: b byte[>..] ~= []; for i n { b.push(i as byte) } b
mki(n int) In: In{mk(n)}
churn(): for z 8 { j byte[>..] ~= []; for i 64 { j.push(200 as byte) } s := str("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"); if s.len == 0 { print("x") } }
f1(): b := mk(64); A.push(b)
f2(): b := mk(64); a byte[>..][>..] ~= [b]; A.append(a[..])
f3(): x := mki(64); B.push(Out{x})
f4(): x := mki(64); y ~= Out{In{[], 0}}; y.i = x; B.push(y)
f5(): b := mk(64); D.d = b
f6(): b := mk(64); H.push(In{b}); H.push(In{b, 3})
f7() In, int: b := mk(64); return In{b}, 3
f8(): x := mki(64); C.push(x); C.push(x)
main():
	f1(); f2(); f3(); f4(); f5(); f6(); r, q := f7(); f8(); churn()
	print(str(A[0][60], " ", A[1][60], " ", B[0].i.d[60], " ", B[1].i.d[60], " ", D.d[60], " ", H[0].d[60], " ", H[1].d[60], " ", r.d[60], " ", q, " ", C[0].d[60], " ", C[1].d[60]))
	C[0].d[5] = 98; print(str(C[1].d[5]))
	b := mk(8); rr byte[>..][>..] ~= [b; 3]; rr[0][1] = 77; s In[>..] ~= [In{mk(8)}; 3]; s[0].d[1] = 76
	f byte[>..][3] ~= [b; 3]; f[0][2] = 75; qq byte[>..][>..] ~= [mk(8); 2]; qq[0][3] = 74
	print(str(rr[1][1], " ", rr[2][1], " ", b[1], " ", s[1].d[1], " ", s[2].d[1], " ", f[1][2], " ", b[2], " ", qq[1][3]))
	x := In{mk(8)}; z ~= In{[], 0}; z = x; z.d[2] = 8; w := [x, x]; w[0].d[4] = 6; y ~= x; y.d[1] = 9
	print(str(x.d[1], " ", x.d[2], " ", x.d[4], " ", w[1].d[4]))
