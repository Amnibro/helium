import std;
import os;
import math;
import stream.world;
var FAILS = 0;
fn check(ok bool, what const byte[:]) { if ok { print("PASS ", what); } else { print("FAIL ", what); FAILS += 1; } }
var SEED = 4242;
fn rnd() int { SEED = (SEED * 1103515245 + 12345) % 2147483648; SEED }
var DIR byte[>..] = [];
var IO = 0;
fn path_of(k int) byte[>..] { str(DIR[..], "/c", k, ".bin") }
fn setup(sync bool, hyst bool) {
	stream::grid(24, 24, 0.0, 0.0, 25.0);
	stream::load_r = 100.0; stream::unload_r = if hyst { 125.0 } else { 100.0 }; stream::inner_r = 50.0; stream::budget = 2 << 20; stream::sync = sync; stream::io_delay_ms = IO;
	for k in 24 * 24 { let p = path_of(k); stream::cell_path(k % 24, k / 24, p[..]); }
}
fn make_files() {
	for k in 24 * 24 {
		var b byte[>..] = [];
		let n = 8192 + rnd() % (56 * 1024);
		for i in n { b.push((rnd() >> 7) as byte); }
		let p = path_of(k);
		write_file(p[..], b[..]);
	}
}
fn pace(t0 int, f int) { let due = t0 + f * 16666667; let now = time_ns(); if due > now { sleep_ms(((due - now) / 1000000) as int); } }
fn flight(sync bool) bool, f32, f32 {
	setup(sync, true);
	if !sync { stream::start(2); }
	var times int[>..] = []; var miss = 0; var worst_mem = 0; var bad = 0; var seen int[>..] = [];
	var file byte[>..] = []; var nw int[>..] = [];
	let t0 = time_ns();
	for f in 600 {
		let t = f as f32 / 60.0;
		let x = 300.0 + 200.0 * sin(0.12 * t as real) as f32; let z = 300.0 + 100.0 * sin(0.24 * t as real) as f32;
		let a = time_ns();
		stream::update(x, z);
		times.push(time_ns() - a);
		stream::take_new(nw);
		for k in nw { seen.push(k); }
		worst_mem = max(worst_mem, stream::resident_bytes());
		if f >= 60 { for k in 24 * 24 { if stream::dist(k, x, z) <= stream::inner_r && !stream::loaded(k) { miss += 1; } } }
		for k in nw { file.clear(); if !read_file(path_of(k)[..], file) || file.len != stream::bytes(k).len { bad += 1; continue; } for i in file.len { if file[i] != stream::bytes(k)[i] { bad += 1; break; } } }
		pace(t0, f + 1);
	}
	if !sync { stream::stop(); }
	var srt int[>..] = []; srt.append(times[..]);
	var i = 1; while i < srt.len { var j = i; while j > 0 && srt[j - 1] > srt[j] { let tt = srt[j]; srt[j] = srt[j - 1]; srt[j - 1] = tt; j -= 1; } i += 1; }
	let p99 = srt[(srt.len * 99) / 100] as f32 / 1.0e6; let mx = srt[srt.len - 1] as f32 / 1.0e6;
	print(if sync { "sync control" } else { "flight" }, ": misses ", miss, " p99 ", p99, " ms max ", mx, " ms peak resident ", worst_mem, " loads ", seen.len, " content errors ", bad);
	if !sync {
		check(miss == 0, "S1 every inner cell loaded after warm-up");
		check(p99 <= 1.0 && mx <= 4.0, "S2 update p99 <= 1 ms, max <= 4 ms");
		check(worst_mem <= 2 << 20, "S3 resident <= 2 MB");
		check(bad == 0 && seen.len > 0, "S4 loaded bytes match files");
	}
	return miss == 0, p99, mx;
}
fn osc(hyst bool, budget int) int {
	setup(false, hyst);
	stream::budget = budget;
	stream::start(2);
	var base int[>..] = [];
	let t0 = time_ns();
	for f in 420 {
		let t = f as f32 / 60.0;
		let z = 300.0 + (if f >= 120 { 10.0 * sin(6.2831853 * (t - 2.0) as real) as f32 } else { 0.0 });
		stream::update(312.5, z);
		if f == 119 { base.clear(); for k in 24 * 24 { base.push(stream::load_count(k)); } }
		pace(t0, f + 1);
	}
	stream::stop();
	var worst = 0;
	for k in 24 * 24 { worst = max(worst, stream::load_count(k) - base[k]); }
	worst
}
fn main() {
	var d byte[>..] = [];
	if !env("STREAM_DIR", d) { d.append("/tmp/helium_stream_test"); }
	DIR.append(d[..]); make_dir(DIR[..]);
	make_files();
	flight(false);
	let ok, p99, mx = flight(true);
	let _ = ok;
	print(if !(p99 <= 1.0 && mx <= 4.0) { "PASS" } else { "FAIL (reported, not gating: files on tmpfs read in microseconds)" }, " S2 control on tmpfs: synchronous loading fails S2");
	IO = 4;
	print("with 4 ms emulated storage latency per file (post-hoc):");
	flight(false);
	let ok4, p4, m4 = flight(true);
	let _ = ok4;
	check(!(p4 <= 1.0 && m4 <= 4.0), "S2 control, 4 ms storage (post-hoc): synchronous loading fails S2");
	IO = 0;
	let w = osc(true, 2 << 20);
	let w0 = osc(false, 2 << 20);
	print("S5 2 MB budget: most loads of one cell ", w, ", control ", w0, if w0 > 1 { "" } else { " (vacuous: the budget keeps boundary cells unloaded, reported, not gating)" });
	let w4 = osc(true, 4 << 20);
	print("S5b 4 MB budget (post-hoc): most loads of one cell ", w4);
	check(w4 <= 1, "S5b hysteresis, 4 MB budget (post-hoc): no cell loaded more than once");
	let w40 = osc(false, 4 << 20);
	print("S5b control unload_r = load_r: most loads of one cell ", w40);
	check(w40 > 1, "S5b control: no hysteresis fails");
	for k in 24 * 24 { delete_file(path_of(k)[..]); }
	delete_dir(DIR[..]);
	if FAILS == 0 { print("stream: ok"); } else { print("stream: FAILED ", FAILS); exit(1); }
}
