use os
use net.sock
use net.tls
use crypto.ecc
use crypto.hash
use crypto.x509

sh(cmd const byte[:]) bool: run_command(str(cmd, " >/dev/null 2>&1")) == 0
bg(cmd const byte[:], out const byte[:], done const byte[:]): run_command(str("rm -f ", done, "; (", cmd, " > ", out, " 2>/dev/null; touch ", done, ") &"))
path(dir const byte[:], name const byte[:]) byte[>..]: str(dir, "/", name)
has(h const byte[:], n const byte[:]) bool:
	i ~= 0
	while i + n.len <= h.len:
		if h[i..i + n.len] == n: return true
		i += 1
	false
wait_file(p const byte[:], secs real) bool:
	t0 := time(); b byte[>..] ~= []
	while time() - t0 < secs:
		if read_file(p, b): return true
		sleep(0.01)
	false
acc(l int, c net::Tls&) int:
	fd ~= -1; t0 := time()
	while fd < 0 && time() - t0 < 5.0: net::tls_pump(c); fd = net::accept(l)
	fd
shake(c net::Tls&, s net::Tls&):
	t0 := time()
	while (net::tls_state(c) == net::TLS_HANDSHAKE || net::tls_state(s) == net::TLS_HANDSHAKE) && time() - t0 < 5.0: net::tls_pump(c); net::tls_pump(s)
matrix(l int, port int, cert const byte[:], key const byte[:], pin const byte[:], suite int, group int) bool:
	c ~= net::tls_open("127.0.0.1", port, "amni-v1"); c.only = suite; c.want.append(pin)
	if group == 0x17: c.group = group
	s ~= net::tls_accept(acc(l, c), cert, key, "amni-v1")
	if group == 0x18: s.group = group
	shake(c, s); msg byte[>..] ~= []; gc byte[>..] ~= []; gs byte[>..] ~= []; i ~= 0; j ~= 0; t0 := time()
	for x 1048576: msg.push(((x * 7 + x / 255) % 251) as! byte)
	while (gc.len < msg.len || gs.len < msg.len) && time() - t0 < 30.0 && net::tls_state(c) == net::TLS_OPEN && net::tls_state(s) == net::TLS_OPEN:
		if i < msg.len && c.wbuf.len < 65536: n := min(16000, msg.len - i); net::tls_write(c, msg[i..i + n]); i += n
		if j < msg.len && s.wbuf.len < 65536: n := min(16000, msg.len - j); net::tls_write(s, msg[j..j + n]); j += n
		net::tls_pump(c); net::tls_pump(s); net::tls_read(c, gc); net::tls_read(s, gs)
	open := net::tls_state(c) == net::TLS_OPEN && net::tls_state(s) == net::TLS_OPEN; net::tls_close(c); t1 := time()
	while net::tls_state(s) == net::TLS_OPEN && time() - t1 < 5.0: net::tls_pump(s)
	closed := net::tls_state(s) == net::TLS_CLOSED; net::tls_close(s)
	open && closed && c.hrr == (group == 0x18) && s.hrr == c.hrr && c.kx == group && s.kx == group && c.suite == suite && s.suite == suite && c.sel[..] == "amni-v1" && s.sel[..] == "amni-v1" && gc[..] == msg[..] && gs[..] == msg[..]
serve(l int, cert const byte[:], key const byte[:], alpn const byte[:], http bool, secs real) byte[>..]:
	got byte[>..] ~= []; t0 := time(); fd ~= -1
	while fd < 0 && time() - t0 < secs:
		fd = net::accept(l)
		if fd < 0: sleep(0.005)
	if fd < 0: return got
	s ~= net::tls_accept(fd, cert, key, alpn); done ~= false
	while !done && net::tls_state(s) != net::TLS_ERR && net::tls_state(s) != net::TLS_CLOSED && time() - t0 < secs:
		net::tls_pump(s); net::tls_read(s, got); n := got.len
		done = if http { n >= 4 && got[n - 4..] == "\r\n\r\n" } else { n > 0 && got[n - 1] == 10 }
		if !done: sleep(0.002)
	body := "hello from helium tls\n"; r := if http { str("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: ", body.len, "\r\nConnection: close\r\n\r\n", body) } else { copy(got) }
	if done:
		net::tls_write(s, r[..]); k ~= 0
		while s.wbuf.len > 0 && k < 500: net::tls_pump(s); sleep(0.002); k += 1
	net::tls_close(s); got
relay_flip(l int, port int, cert const byte[:], key const byte[:], pin const byte[:]) bool:
	l2 := net::listen(net::addr("127.0.0.1", 0)); c ~= net::tls_open("127.0.0.1", net::local_port(l2), "amni-v1"); c.want.append(pin); a := acc(l2, c); b := net::connect(net::addr("127.0.0.1", port)); net::nodelay(a, true); net::nodelay(b, true); fd ~= -1; t0 := time()
	while fd < 0 && time() - t0 < 5.0: fd = net::accept(l)
	s ~= net::tls_accept(fd, cert, key, "amni-v1"); cb byte[>..] ~= []; sb byte[>..] ~= []; flipped ~= false
	while net::tls_state(s) == net::TLS_HANDSHAKE && time() - t0 < 5.0:
		net::tls_pump(c); net::recv(a, cb)
		while cb.len >= 5 && cb.len >= 5 + (cb[3] as int << 8 | cb[4] as int):
			n := 5 + (cb[3] as int << 8 | cb[4] as int)
			if cb[0] == 23 && !flipped: flipped = true; cb[n - 1] ^= 1
			net::send_all(b, cb[..n]); rest byte[>..] ~= []; rest.append(cb[n..]); cb = rest
		net::tls_pump(s); sb.clear(); net::recv(b, sb)
		if sb.len > 0: net::send_all(a, sb[..])
	t1 := time()
	while net::tls_state(c) == net::TLS_OPEN && time() - t1 < 2.0:
		sb.clear(); net::recv(b, sb)
		if sb.len > 0: net::send_all(a, sb[..])
		net::tls_pump(c)
	net::close(a); net::close(b); net::close(l2); flipped && s.err[..] == "bad record MAC" && s.alert == 20 && c.err[..] == "alert 20"
mem(c net::Tls&, s net::Tls&, flip bool):
	net::tls_start(c)
	for r 8:
		for lv 3:
			if c.qo[lv].len > 0:
				d ~= copy(c.qo[lv]); c.qo[lv].clear()
				if flip && lv == 1: d[d.len - 1] ^= 1
				net::tls_feed(s, lv, d[..])
		for lv 3:
			if s.qo[lv].len > 0:
				d ~= copy(s.qo[lv]); s.qo[lv].clear(); net::tls_feed(c, lv, d[..])
fetch(dir const byte[:], pin const byte[:], flag const byte[:], want12 bool) bool:
	pl := net::listen(net::addr("127.0.0.1", 0)); sp := net::local_port(pl); net::close(pl)
	bg(str("timeout 20 openssl s_server -accept ", sp, " -cert ", dir, "/cert.pem -key ", dir, "/key.pem -www ", flag, " -naccept 1"), path(dir, "ss.out"), path(dir, "ss.done"))
	page byte[>..] ~= []; v12 ~= false; tries ~= 0
	while tries < 70 && page.len == 0:
		c ~= net::tls_open("127.0.0.1", sp, ""); c.want.append(pin)
		if net::tls_wait(c, 3000) == net::TLS_OPEN:
			net::tls_write(c, "GET / HTTP/1.0\r\n\r\n"); t0 := time()
			while net::tls_state(c) == net::TLS_OPEN && time() - t0 < 4.0: net::tls_pump(c); net::tls_read(c, page); sleep(0.002)
			net::tls_read(c, page); v12 = c.v12
		else: sleep(0.1)
		net::tls_close(c); tries += 1
	wait_file(path(dir, "ss.done"), 3.0); has(page[..], "HTTP/1.0 200") && has(page[..], if want12 { "New, TLSv1.2" } else { "New, TLSv1.3" }) && v12 == want12
client_cmd(dir const byte[:], port int) byte[>..]: str("printf 'ping-amni\\n' | timeout 9 openssl s_client -connect 127.0.0.1:", port, " -tls1_3 -CAfile ", dir, "/cert.pem -verify_return_error -verify_hostname amni-lan -alpn amni-v1 -quiet")
curl_cmd(dir const byte[:], port int) byte[>..]: str("curl -s --http1.1 --cacert ", dir, "/cert.pem --resolve amni-lan:", port, ":127.0.0.1 https://amni-lan:", port, "/hello -m 7 -o ", dir, "/body.txt")
main():
	a := args()
	given := a.len > 1
	dir byte[>..] ~= []
	if given:
		dir.append(a[1])
	else:
		dir.append("tls_test.tmp")
	sh(str("mkdir -p ", dir))
	key := crypto::ec_generate(crypto::P256)
	cert, okc := crypto::x509_self_signed("amni-lan", key[..], (time() as int) - 60, 3700)
	kder, okk := crypto::pkcs8_ec(key[..])
	pin := crypto::sha256(cert[..])
	write_file(path(dir, "cert.der"), cert[..])
	write_file(path(dir, "key.der"), kder[..])
	sh(str("openssl x509 -inform der -in ", dir, "/cert.der -out ", dir, "/cert.pem"))
	sh(str("openssl pkey -inform der -in ", dir, "/key.der -out ", dir, "/key.pem"))
	l := net::listen(net::addr("127.0.0.1", 0))
	port := net::local_port(l)
	suites int[3] := [0x1301, 0x1302, 0x1303]
	groups int[3] := [0x1D, 0x17, 0x18]
	for si 3:
		for gi 3:
			sn := if si == 0 { "1301" } else if si == 1 { "1302" } else { "1303" }
			gn := if gi == 0 { "x25519" } else if gi == 1 { "p256" } else { "p384 retry" }
			print("T3 ", sn, " ", gn, " ", matrix(l, port, cert[..], key[..], pin[..], suites[si], groups[gi]))
	bg(client_cmd(dir, port), path(dir, "sc.out"), path(dir, "sc.done"))
	got1 := serve(l, cert[..], key[..], "amni-v1", false, 9.0)
	wait_file(path(dir, "sc.done"), 9.0)
	f1 byte[>..] ~= []
	read_file(path(dir, "sc.out"), f1)
	print("T3 openssl s_client ", got1[..] == "ping-amni\n" && f1[..] == "ping-amni\n")
	bg(curl_cmd(dir, port), path(dir, "curl.out"), path(dir, "curl.done"))
	got2 := serve(l, cert[..], key[..], "http/1.1", true, 9.0)
	wait_file(path(dir, "curl.done"), 9.0)
	f2 byte[>..] ~= []
	read_file(path(dir, "body.txt"), f2)
	print("T3 curl ", has(got2[..], "GET /hello HTTP/1.1") && f2[..] == "hello from helium tls\n")
	c1 ~= net::tls_open("127.0.0.1", port, "amni-v1")
	c1.want.append(crypto::sha256("other")[..])
	s1 ~= net::tls_accept(acc(l, c1), cert[..], key[..], "amni-v1")
	shake(c1, s1)
	print("T3 control wrong pin ", net::tls_state(c1) == net::TLS_ERR && starts_with(c1.err[..], "certificate rejected") && net::tls_state(s1) != net::TLS_OPEN)
	key2 := crypto::ec_generate(crypto::P256)
	c2 ~= net::tls_open("127.0.0.1", port, "amni-v1")
	c2.want.append(pin[..])
	s2 ~= net::tls_accept(acc(l, c2), cert[..], key2[..], "amni-v1")
	shake(c2, s2)
	print("T3 control wrong key ", net::tls_state(c2) == net::TLS_ERR && c2.err[..] == "CertificateVerify failed" && net::tls_state(s2) != net::TLS_OPEN)
	c3 ~= net::tls_open("127.0.0.1", port, "other")
	c3.want.append(pin[..])
	s3 ~= net::tls_accept(acc(l, c3), cert[..], key[..], "amni-v1")
	shake(c3, s3)
	print("T3 control protocol ", s3.err[..] == "no application protocol" && s3.alert == 120 && c3.err[..] == "alert 120")
	print("T3 control flipped record ", relay_flip(l, port, cert[..], key[..], pin[..]))
	mc1 ~= net::tls_quic(false, "amni-lan", "amni-v1", "client-params", "", "")
	mc1.want.append(pin[..])
	ms1 ~= net::tls_quic(true, "", "amni-v1", "server-params", cert[..], key[..])
	mem(mc1, ms1, false)
	ok1 := net::tls_state(mc1) == net::TLS_OPEN && net::tls_state(ms1) == net::TLS_OPEN && !mc1.hrr && !ms1.hrr && mc1.qs.len == 4 && ms1.qs.len == 4 && mc1.qs[0][..] == ms1.qs[0][..] && mc1.qs[1][..] == ms1.qs[1][..] && mc1.qs[2][..] == ms1.qs[2][..] && mc1.qs[3][..] == ms1.qs[3][..] && mc1.ptp[..] == "server-params" && ms1.ptp[..] == "client-params" && mc1.sel[..] == "amni-v1" && ms1.sel[..] == "amni-v1"
	print("T3 message level ", ok1)
	mc2 ~= net::tls_quic(false, "amni-lan", "amni-v1", "client-params", "", "")
	mc2.want.append(pin[..])
	ms2 ~= net::tls_quic(true, "", "amni-v1", "server-params", cert[..], key[..])
	ms2.group = 0x18
	mem(mc2, ms2, false)
	ok2 := net::tls_state(mc2) == net::TLS_OPEN && net::tls_state(ms2) == net::TLS_OPEN && mc2.hrr && ms2.hrr && mc2.qs.len == 4 && ms2.qs.len == 4 && mc2.qs[0][..] == ms2.qs[0][..] && mc2.qs[1][..] == ms2.qs[1][..] && mc2.qs[2][..] == ms2.qs[2][..] && mc2.qs[3][..] == ms2.qs[3][..] && mc2.ptp[..] == "server-params" && ms2.ptp[..] == "client-params" && mc2.sel[..] == "amni-v1" && ms2.sel[..] == "amni-v1"
	print("T3 message level retry ", ok2)
	mc3 ~= net::tls_quic(false, "amni-lan", "amni-v1", "client-params", "", "")
	mc3.want.append(pin[..])
	ms3 ~= net::tls_quic(true, "", "amni-v1", "server-params", cert[..], key[..])
	mem(mc3, ms3, true)
	print("T3 control flipped finished ", net::tls_state(mc3) == net::TLS_OPEN && net::tls_state(ms3) == net::TLS_ERR && ms3.err[..] == "client Finished failed" && ms3.alert == 51)
	mc4 ~= net::tls_quic(false, "amni-lan", "other", "client-params", "", "")
	mc4.want.append(pin[..])
	ms4 ~= net::tls_quic(true, "", "amni-v1", "server-params", cert[..], key[..])
	mem(mc4, ms4, false)
	print("T3 control protocol message level ", net::tls_state(ms4) == net::TLS_ERR && ms4.err[..] == "no application protocol" && ms4.alert == 120)
	print("T4 tls 1.3 ", fetch(dir[..], pin[..], "-tls1_3", false))
	print("T4 tls 1.2 ", fetch(dir[..], pin[..], "-tls1_2", true))
	if !given: sh(str("rm -rf ", dir));
