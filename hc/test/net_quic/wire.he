use net.quic_wire
use crypto.ecc
use os
use crypto.hash

A2_FRAME := ""
A2_PACKET := ""
A3_PAYLOAD := "02000000000600405a020000560303eefce7f7b37ba1d1632e96677825ddf73988cfc79825df566dc5430b9a045a1200130100002e00330024001d00209d3c940d89690b84d08a60993c144eca684d1081287c834d5311bcf32bb9da1a002b00020304"
A3_PACKET := "cf000000010008f067a5502a4262b5004075c0d95a482cd0991cd25b0aac406a5816b6394100f37a1c69797554780bb38cc5a99f5ede4cf73c3ec2493a1839b3dbcba3f6ea46c5b7684df3548e7ddeb9c3bf9c73cc3f3bded74b562bfb19fb84022f8ef4cdd93795d77d06edbb7aaf2f58891850abbdca3d20398c276456cbc42158407dd074ee"
eqh(b const byte[:], hex const byte[:]) bool: h := crypto::hexb(hex); b == h[..]
add(fs net::QFrame[>..]&, ty int, a int, b int, c int, fin bool, data const byte[:], tok const byte[:], nr int):
	f ~= net::QFrame{}; f.ty = ty; f.a = a; f.b = b; f.c = c; f.fin = fin; f.data.append(data); f.tok.append(tok)
	for i nr: f.rg.push(i * 37 % 70 + i * 1000)
	fs.push(f)
same(x const net::QFrame&, y const net::QFrame&) bool:
	ok ~= x.ty == y.ty && x.a == y.a && x.b == y.b && x.c == y.c && x.fin == y.fin && x.data[..] == y.data[..] && x.tok[..] == y.tok[..] && x.rg.len == y.rg.len
	if ok:
		for i x.rg.len: ok = ok && x.rg[i] == y.rg[i]
	ok
frames_ok() bool:
	fs net::QFrame[>..] ~= []; big := 4611686018427387903; all byte[>..] ~= []; ok ~= true
	add(fs, 1, 0, 0, 0, false, "", "", 0); add(fs, 2, 1000000, 250, 0, false, "", "", 1); add(fs, 2, big, 16384, 0, false, "", "", 5); add(fs, 4, 4, 77, 1073741824, false, "", "", 0); add(fs, 5, 8, 63, 0, false, "", "", 0)
	add(fs, 6, 16383, 0, 0, false, "hello crypto", "", 0); add(fs, 7, 0, 0, 0, false, "token", "", 0); add(fs, 8, 12, 0, 0, false, "abc", "", 0); add(fs, 8, 3, 4611686018427387000, 0, true, "", "", 0); add(fs, 0, 1, 0, 0, false, "", "", 0)
	add(fs, 16, 64, 0, 0, false, "", "", 0); add(fs, 17, 5, 16384, 0, false, "", "", 0); add(fs, 18, 100, 0, 0, false, "", "", 0); add(fs, 19, 1152921504606846976, 0, 0, false, "", "", 0); add(fs, 20, 1, 0, 0, false, "", "", 0); add(fs, 21, 2, 3, 0, false, "", "", 0)
	add(fs, 22, 7, 0, 0, false, "", "", 0); add(fs, 23, 9, 0, 0, false, "", "", 0); add(fs, 24, 5, 2, 0, false, "12345678", "0123456789abcdef", 0); add(fs, 25, 4, 0, 0, false, "", "", 0); add(fs, 26, 0, 0, 0, false, "pathchal", "", 0); add(fs, 27, 0, 0, 0, false, "pathresp", "", 0)
	add(fs, 28, 376, 6, 0, false, "no application protocol", "", 0); add(fs, 29, 7, 0, 0, false, "bye", "", 0); add(fs, 30, 0, 0, 0, false, "", "", 0)
	for i fs.len:
		one byte[>..] ~= []; net::qf_put(one, fs[i]); net::qf_put(all, fs[i]); g, e := net::qf_get(one[..], 0); ok = ok && e == one.len && same(g, fs[i])
	o ~= 0; k ~= 0
	while o >= 0 && o < all.len && k < fs.len: g, e := net::qf_get(all[..], o); ok = ok && e > o && same(g, fs[k]); o = e; k += 1
	ok = ok && o == all.len && k == fs.len
	s1 byte[>..] ~= [8, 4, 120, 121]; g1, e1 := net::qf_get(s1[..], 0); ok = ok && e1 == 4 && g1.ty == 8 && g1.a == 4 && g1.b == 0 && !g1.fin && g1.data[..] == "xy"
	s2 byte[>..] ~= [13, 4, 16, 122]; g2, e2 := net::qf_get(s2[..], 0); ok = ok && e2 == 4 && g2.ty == 8 && g2.a == 4 && g2.b == 16 && g2.fin && g2.data[..] == "z"
	s3 byte[>..] ~= [3, 9, 1, 0, 2, 5, 6, 7]; g3, e3 := net::qf_get(s3[..], 0); ok = ok && e3 == 8 && g3.ty == 2 && g3.a == 9 && g3.b == 1 && g3.rg.len == 1 && g3.rg[0] == 2
	s4 byte[>..] ~= [31]; g4, e4 := net::qf_get(s4[..], 0); ok = ok && e4 == -1
	for cut all.len:
		p := all[..cut]; q ~= 0; n ~= 0
		while q >= 0 && q < p.len && n < 100: g, e := net::qf_get(p, q); ok = ok && e <= p.len; q = e; n += 1
	ok
keys_ok() bool:
	cid := crypto::hexb("8394c8f03e515708")
	ck := net::qk_initial(cid[..], false)
	sk := net::qk_initial(cid[..], true)
	ok ~= eqh(ck.key[..], "1f369613dd76d5467730efcbe3b1a22d") && eqh(ck.iv[..], "fa044b2f42a3fd3b46fb255c") && eqh(ck.hp[..], "9f50449e04a0e810283a1e9933adedd2") && eqh(ck.sec[..], "c00cf151ca5be075ed0ebfb5c80323c42d6b7db67881289af4008f1f6c357aea")
	ok = ok && eqh(sk.key[..], "cf3a5331653c364c88f0f379b6067e37") && eqh(sk.iv[..], "0ac1493ca1905853b0bba03e") && eqh(sk.hp[..], "c206b8d9b9f0f37644430b490eeaa314") && eqh(sk.sec[..], "3c199828fd139efd216c155ad844cc81fb82fa8d7446fa7d78be803acdda951b")
	ok
client_ok() bool:
	cid := crypto::hexb("8394c8f03e515708")
	ck := net::qk_initial(cid[..], false)
	empty byte[>..] ~= []
	payload := crypto::hexb(A2_FRAME)
	payload.resize(1162, 0)
	hdr := net::qh_long(0, cid[..], empty[..], empty[..], 4, 2, 1162)
	ok ~= eqh(hdr[..], "c300000001088394c8f03e5157080000449e00000002")
	pkt := net::qp_seal(ck, hdr[..], 4, 2, payload[..])
	ok = ok && eqh(pkt[..], A2_PACKET)
	h := net::qh_parse(pkt[..], 0)
	ok = ok && h.ok && h.lg && h.ty == 0 && h.dcid[..] == cid[..] && h.pno == 18 && h.stop == 1200
	o := net::qp_open(ck, pkt[..], 18, -1)
	ok = ok && o.ok && o.pn == 2 && o.data[..] == payload[..]
	ok
server_ok() bool:
	cid := crypto::hexb("8394c8f03e515708")
	sk := net::qk_initial(cid[..], true)
	empty byte[>..] ~= []
	scid := crypto::hexb("f067a5502a4262b5")
	payload := crypto::hexb(A3_PAYLOAD)
	hdr := net::qh_long(0, empty[..], scid[..], empty[..], 2, 1, payload.len)
	ok ~= eqh(hdr[..], "c1000000010008f067a5502a4262b50040750001")
	pkt := net::qp_seal(sk, hdr[..], 2, 1, payload[..])
	ok = ok && eqh(pkt[..], A3_PACKET)
	h := net::qh_parse(pkt[..], 0)
	ok = ok && h.ok && h.pno == 18 && h.stop == 135
	o := net::qp_open(sk, pkt[..], 18, -1)
	ok = ok && o.ok && o.pn == 1 && o.data[..] == payload[..]
	ok
chacha_ok() bool:
	sec := crypto::hexb("9ac312a7f877468ebe69422748ad00a15443f18203a07d6060f688f30f21632b")
	k := net::qk_from(0x1303, sec[..])
	ok ~= eqh(k.key[..], "c6d98ff3441c3fe1b2182094f69caa2ed4b716b65488960a7a984979fb23e1c8") && eqh(k.iv[..], "e0459b3474bdd0e44a41c144") && eqh(k.hp[..], "25a282b9e82f06f21f488917a4fc8f1b73573685608597d0efcb076b0ab7a7a4")
	u := net::qk_update(k)
	ok = ok && eqh(u.sec[..], "1223504755036d556342ee9361d253421a826c9ecdf3c7148684b36b714881f9")
	empty byte[>..] ~= []
	hdr := net::qh_short(empty[..], 0, 3, 654360564)
	ok = ok && eqh(hdr[..], "4200bff4")
	pl byte[>..] ~= [1]
	pkt := net::qp_seal(k, hdr[..], 3, 654360564, pl[..])
	ok = ok && eqh(pkt[..], "4cfe4189655e5cd55c41f69080575d7999c25a5bfb")
	o := net::qp_open(k, pkt[..], 1, 654360563)
	ok = ok && o.ok && o.pn == 654360564 && o.data[..] == pl[..]
	ok
control_ok() bool:
	cid := crypto::hexb("8394c8f03e515709")
	k := net::qk_initial(cid[..], false)
	pkt := crypto::hexb(A2_PACKET)
	o := net::qp_open(k, pkt[..], 18, -1)
	!o.ok
vr(hex const byte[:], v int, n int) bool:
	b := crypto::hexb(hex)
	g, nx := net::qv_get(b[..], 0)
	g == v && nx == n
varints_ok() bool:
	ok ~= vr("c2197c5eff14e88c", 151288809941952652, 8) && vr("9d7f3e7d", 494878333, 4) && vr("7bbd", 15293, 2) && vr("25", 37, 1) && vr("4025", 37, 2)
	vals int[>..] ~= [0, 63, 64, 16383, 16384, 1073741823, 1073741824, 4611686018427387903]
	lens int[>..] ~= [1, 1, 2, 2, 4, 4, 8, 8]
	for i vals.len:
		v := vals[i]
		l := lens[i]
		out byte[>..] ~= []
		ok = ok && net::qv_len(v) == l
		net::qv_put(out, v)
		ok = ok && out.len == l
		g, nx := net::qv_get(out[..], 0)
		ok = ok && g == v && nx == l
		if l > 1:
			g2, n2 := net::qv_get(out[..out.len - 1], 0)
			ok = ok && g2 == -1
	ok
params_ok() bool:
	p ~= net::qtp_new()
	p.v[1] = 30000
	p.v[4] = 1048576
	p.v[5] = 65536
	p.v[6] = 65537
	p.v[7] = 65538
	p.v[8] = 100
	p.v[9] = 101
	p.iscid.append("abcdefgh")
	p.odcid.append("12345678")
	s := net::qtp_put(p, true)
	c := net::qtp_put(p, false)
	q1, g1 := net::qtp_get(s[..], true)
	ok ~= g1 && q1.iscid[..] == p.iscid[..] && q1.odcid[..] == p.odcid[..]
	for i 17: ok = ok && q1.v[i] == p.v[i]
	q2, g2 := net::qtp_get(c[..], false)
	ok = ok && g2 && q2.odcid.len == 0
	for i 17: ok = ok && q2.v[i] == p.v[i]
	q3, g3 := net::qtp_get(s[..], false)
	ok = ok && !g3
	q4, g4 := net::qtp_get(c[..], true)
	ok = ok && !g4
	dbl byte[>..] ~= []
	dbl.append(s[..])
	dbl.append(s[..])
	q5, g5 := net::qtp_get(dbl[..], true)
	ok = ok && !g5
	ok
main():
	print("Q1 keys ", keys_ok())
	print("Q1 client initial ", client_ok())
	print("Q1 server initial ", server_ok())
	print("Q1 chacha20 ", chacha_ok())
	print("Q1 control ", control_ok())
	print("Q2 varints ", varints_ok())
	print("Q2 frames ", frames_ok())
	print("Q2 parameters ", params_ok());
