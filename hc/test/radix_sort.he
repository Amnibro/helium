# sort on fixed-width integer slices is a radix sort; checks order and a checksum for every width
use os
main():
	rs ~= 2463534242 as u32
	for n [0, 1, 5, 300, 5000]:
		a u32[>..] ~= []; b i32[>..] ~= []; c i64[>..] ~= []; d u8[>..] ~= []; e i16[>..] ~= []
		for i n:
			rs ^= rs << 13; rs ^= rs >> 17; rs ^= rs << 5
			a.push(rs); b.push(rs as! i32); c.push((rs as i64) - 2000000000); d.push(rs as! u8); e.push(rs as! i16)
		sort(a[..]); sort(b[..]); sort(c[..]); sort(d[..]); e2 := sorted(e[..])
		ok ~= true; h ~= 0
		for i 1..n:
			if a[i-1] > a[i] || b[i-1] > b[i] || c[i-1] > c[i] || d[i-1] > d[i] || e2[i-1] > e2[i]: ok = false
		for i n: h = (h * 31 + a[i] as int + b[i] as int + c[i] as int + d[i] as int + e2[i] as int) % 1000000007
		print(n, " ", ok, " ", h)
