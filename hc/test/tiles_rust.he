use tiles.rust
NUMS := ["0", "-0", "1", "0.1", "1e21", "1e-7", "1.5e-7", "-1234.5678", "NaN", "inf", "-inf", "100", "1e300", "5e-324", "0.30000000000000004", "123456789.125", "1e16", "12345678901234567890", "2.5", "0.000001", "1.7976931348623157e308", "-0.000123"]
FIXED := ["1.005 2", "1.45 1", "-1.5 0", "2.5 0", "0.5 0", "1.5 0", "-0 2", "-0.001 2", "1e21 2", "123.456 0", "NaN 2", "inf 3", "-inf 1", "1.255 2", "-2.345 2", "1234.5678 3", "0 0", "1e-10 3", "9.995 2", "0.125 2", "0.375 2", "-0.4 0", "25.4 4", "0.0005 3", "1e300 1", "-0.5 0"]
CAST := ["-3.5", "NaN", "1e20", "-1e20", "4294967295.9", "4294967296", "65535.5", "255.9", "-2147483648.5", "2147483647.9", "9.3e18", "-9.3e18", "3.99", "-3.99", "inf", "-inf", "0.5", "-0"]
VALS := ["0", "-0", "1", "-1", "NaN", "inf", "-inf", "2.5", "-0.5"]
shown(v real) byte[>..]:
	o byte[>..] ~= []
	rs::display(o, v)
	o
shown_fixed(v real, d int) byte[>..]:
	o byte[>..] ~= []
	rs::fixed(o, v, d)
	o
main():
	for t NUMS:
		v, ok := parse_flt(t)
		print("num [", t, "] ", shown(v))
	for t FIXED:
		sp ~= 0
		while t[sp] != ' ': sp++
		v, ok := parse_flt(t[..sp])
		d, ok2 := parse_int(t[sp + 1..])
		print("fixed [", t, "] ", shown_fixed(v, d))
	for t CAST:
		v, ok := parse_flt(t)
		print("cast [", t, "] ", rs::to_usize(v), " ", rs::to_u32(v), " ", rs::to_u16(v), " ", rs::to_u8(v), " ", rs::to_i32(v), " ", rs::to_i64(v))
	for a VALS:
		for b VALS:
			x, okx := parse_flt(a)
			y, oky := parse_flt(b)
			print("mm [", a, " ", b, "] ", shown(rs::max(x, y)), " ", shown(rs::min(x, y)))
	for t VALS:
		v, ok := parse_flt(t)
		print("sc [", t, "] ", shown(rs::signum(v)), " ", shown(rs::clamp(v, -1.0, 1.0)));
