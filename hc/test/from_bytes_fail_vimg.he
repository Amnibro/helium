main():
	b byte[>..] ~= []
	xs f32[3] := [1.5, -2.0, 3.25]
	b.append(to_bytes(xs[..]))
	a, ok := from_bytes<f32[]>(b[..])
	print(a.len, " ", ok, " ", a[2])
	c, ok2 := from_bytes<f32[]>(b[..1])
	print(c.len, " ", ok2)
	raw byte[4] := [0, 0, 128, 63]
	d, ok3 := from_bytes<f32[]>(raw[..])
	print(d.len, " ", ok3)
