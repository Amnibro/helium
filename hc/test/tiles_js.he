use tiles.js
NUMS := ["0", "-0", "1", "0.1", "1e21", "1e-7", "123456789012345680000", "1.5e-7", "0.000001", "0.0000001", "-1234.5678", "NaN", "Infinity", "-Infinity", "100", "1e300", "5e-324", "0.30000000000000004"]
FIXED := ["1.005 2", "1.45 1", "-1.5 0", "2.5 0", "-0 2", "-0.001 2", "1e21 2", "123.456 0", "NaN 2", "0.5 0", "1.255 2", "-2.345 2", "1234.5678 3", "0 0", "1e-10 3", "9.995 2"]
LOC := ["1234567.891 2", "0.5 0", "2.5 0", "-2.5 0", "1.005 2", "-0 3", "-0.0001 3", "1e21 0", "NaN 3", "Infinity 3", "-Infinity 0", "1234.5 0", "0.125 2", "999.9996 3", "-1234567.25 1", "12 3", "0.1 3", "1e-7 3", "123456.7891 3", "-0.4 0"]

split_case(s const byte[:]) real, int:
	at ~= 0
	while s[at] != ' ': at++
	v, ok := parse_flt(s[..at])
	n, ok2 := parse_int(s[at + 1..])
	return v, n

main():
	for s NUMS:
		v, ok := parse_flt(s)
		print("num [", s, "] ", js::num_str(v))
	for s FIXED:
		v, n := split_case(s)
		print("fixed [", s, "] ", js::to_fixed(v, n))
	for s LOC:
		v, n := split_case(s)
		print("loc [", s, "] ", js::locale_string(v, n));
