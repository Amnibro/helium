import os;
import uikit;
import text;
fn bytes_eq(a const byte[:], b const byte[:]) int {
	if a.len != b.len { return 0; }
	for i in a.len { if a[i] != b[i] { return 0; } }
	1
}
fn eqi(got int, want int, name const byte[:]) int {
	if got != want { print("FAIL ", name, " ", got, " != ", want); return 1; }
	print("PASS ", name);
	0
}
fn main() {
	var fail = 0;
	fail += eqi(uikit::theme_count(), 35, "theme count");
	fail += eqi(if uikit::look_count() >= 5 { 1 } else { 0 }, 1, "looks");
	fail += eqi(uikit::family_count(), 7, "families");
	var seen int[35] = [0; 35];
	var uniq = 0;
	for f in 7 {
		var prev = -1;
		var distinct = 0;
		for v in 5 {
			uikit::theme_set(f, v);
			let s = uikit::theme_signature();
			var hit = 0;
			for i in uniq { if seen[i] == s { hit = 1; } }
			if hit == 0 { seen[uniq] = s; uniq += 1; }
			if s != prev { distinct += 1; }
			prev = s;
		}
		fail += eqi(distinct, 5, uikit::family_name(f));
	}
	fail += eqi(uniq, 35, "unique themes");
	uikit::reset();
	uikit::widgets_reset();
	let root = uikit::flex(-1, uikit::DIR_ROW);
	uikit::set_pad(root, 0.0);
	uikit::set_gap(root, 0.0);
	let a = uikit::button(root, "One", 0);
	let b = uikit::button(root, "Two", 1);
	uikit::set_px(a, 40.0, 20.0);
	uikit::set_px(b, 50.0, 20.0);
	uikit::layout_root(root, 0.0, 0.0, 200.0, 40.0);
	fail += eqi(uikit::N[a].x as int, 0, "row x0");
	fail += eqi(uikit::N[b].x as int, 40, "row x1");
	uikit::pointer(uikit::N[a].x + 2.0, uikit::N[a].y + 2.0, 1);
	fail += eqi(uikit::N[a].i3, 1, "button click");
	let c = uikit::checkbox(root, "Go", 0, 2);
	uikit::layout_root(root, 0.0, 0.0, 300.0, 40.0);
	uikit::pointer(uikit::N[c].x + 4.0, uikit::N[c].y + 4.0, 1);
	fail += eqi(if uikit::N[c].flags & uikit::FL_ON != 0 { 1 } else { 0 }, 1, "check");
	let s = uikit::slider(root, 0.0, 0);
	uikit::set_px(s, 100.0, 20.0);
	uikit::layout_root(root, 0.0, 0.0, 400.0, 40.0);
	uikit::pointer(uikit::N[s].x + 50.0, uikit::N[s].y + 4.0, 1);
	fail += eqi(if uikit::N[s].val > 0.3 && uikit::N[s].val < 0.7 { 1 } else { 0 }, 1, "slider");
	let f = uikit::text_field(root, "hi", 0);
	uikit::layout_root(root, 0.0, 0.0, 500.0, 40.0);
	uikit::focus_set(f);
	uikit::type_text("!");
	fail += eqi(if uikit::s_text(uikit::N[f].str_i) == "hi!" { 1 } else { 0 }, 1, "type");
	fail += eqi(if uikit::undo(f) { 1 } else { 0 }, 1, "undo");
	fail += eqi(if uikit::s_text(uikit::N[f].str_i) == "hi" { 1 } else { 0 }, 1, "undo text");
	uikit::ime_set("yo");
	uikit::ime_commit();
	fail += eqi(if uikit::s_text(uikit::N[f].str_i) == "hiyo" { 1 } else { 0 }, 1, "ime");
	let tb = uikit::table(-1, 3, 2, 0);
	uikit::table_set(tb, 0, 0, "c");
	uikit::table_set(tb, 1, 0, "a");
	uikit::table_set(tb, 2, 0, "b");
	uikit::table_sort(tb, 0, 0);
	fail += eqi(uikit::table_row(tb, 0), 1, "sort a");
	fail += eqi(uikit::table_row(tb, 1), 2, "sort b");
	fail += eqi(uikit::table_row(tb, 2), 0, "sort c");
	let vl = uikit::virtual_list(-1, 1000, 0);
	uikit::set_px(vl, 100.0, 56.0);
	uikit::N[vl].val = 280.0;
	uikit::N[vl].val2 = 28.0;
	uikit::layout_root(vl, 0.0, 0.0, 100.0, 56.0);
	let lo, hi = uikit::list_window(vl);
	fail += eqi(lo, 10, "virt first");
	fail += eqi(hi, 12, "virt last");
	let d = uikit::dialogue(-1, "Hello", 0, 0);
	uikit::tick(0.1);
	fail += eqi(uikit::N[d].i0, 1, "typewriter");
	let dm = uikit::damage_number(-1, "12", 1);
	let y0 = uikit::N[dm].y;
	uikit::tick(0.5);
	fail += eqi(if uikit::N[dm].y < y0 { 1 } else { 0 }, 1, "damage float");
	fail += eqi(if uikit::role_name(a) == "button" { 1 } else { 0 }, 1, "role");
	fail += eqi(if text::effect_count() >= 5 { 1 } else { 0 }, 1, "effects");
	uikit::reset();
	let hid = uikit::button(-1, "Hide", 0);
	uikit::set_min_bp(hid, 2);
	uikit::layout_root(hid, 0.0, 0.0, 400.0, 40.0);
	fail += eqi(uikit::N[hid].w as int, 0, "breakpoint");
	uikit::reset();
	let hud = uikit::flex(-1, uikit::DIR_COL);
	let hr = uikit::flex(hud, uikit::DIR_ROW);
	for look in 6 { let h = uikit::health_bar(hr, 0.4, look); uikit::set_px(h, 120.0, 18.0); }
	let mid = uikit::flex(hud, uikit::DIR_ROW);
	uikit::minimap(mid, 0);
	uikit::inventory(mid, 4, 3, 0);
	uikit::radial(mid, 6, 1, 0);
	let talk = uikit::flex(hud, uikit::DIR_ROW);
	for look in 5 { let d = uikit::dialogue(talk, "The gate is open.", 12, look); uikit::set_px(d, 150.0, 64.0); }
	let nums = uikit::flex(hud, uikit::DIR_ROW);
	for look in 6 { uikit::damage_number(nums, "128", look); }
	uikit::layout_root(hud, 0.0, 0.0, 960.0, 800.0);
	fail += eqi(uikit::overlap_count(), 0, "hud overlap");
	fail += eqi(if uikit::fonts_ready() { 1 } else { 0 }, 1, "fonts");
	let av = uikit::measure_run("AV", 32.0, false, false, false);
	let parts = uikit::measure_run("A", 32.0, false, false, false) + uikit::measure_run("V", 32.0, false, false, false);
	fail += eqi(if av + 0.5 < parts { 1 } else { 0 }, 1, "kern AV");
	fail += eqi(if uikit::L1.len > 0 { 1 } else { 0 }, 1, "ligatures");
	uikit::reset();
	let tb2 = uikit::table(-1, 3, 2, 0);
	uikit::table_set(tb2, 0, 0, "Ada");
	uikit::table_set(tb2, 1, 0, "Bea");
	uikit::table_set(tb2, 2, 0, "Zed");
	uikit::table_filter(tb2, "Be");
	fail += eqi(if uikit::table_filtered(tb2, 1) { 1 } else { 0 }, 1, "filter hit");
	fail += eqi(if uikit::table_filtered(tb2, 0) { 1 } else { 0 }, 0, "filter miss");
	uikit::table_resize(tb2, 0, 80.0);
	uikit::table_pin(tb2, 1);
	fail += eqi(uikit::col_width(tb2, 0, 200, 2), 80, "col resize");
	fail += eqi(uikit::N[tb2].i3, 1, "col pin");
	uikit::reset();
	let named = uikit::button(-1, "Save", 0);
	uikit::layout_root(named, 0.0, 0.0, 120.0, 40.0);
	var tree byte[>..] = [];
	uikit::a11y_export(tree);
	fail += eqi(if text::contains(tree[..], "button") && text::contains(tree[..], "Save") { 1 } else { 0 }, 1, "a11y tree");
	var report byte[>..] = [];
	report.append("WCAG contrast across 35 themes. Body pairs need 4.5:1. Accent buttons need 3:1.\n\n");
	var bad = 0;
	for f in 7 {
		for v in 5 {
			uikit::theme_set(f, v);
			let body = uikit::contrast_ratio(uikit::THEME.ink, uikit::THEME.bg);
			let surf = uikit::contrast_ratio(uikit::THEME.ink, uikit::THEME.surface);
			let accent = uikit::contrast_ratio(uikit::THEME.on_accent, uikit::THEME.accent);
			let ok = body >= 4.5 && surf >= 4.5 && accent >= 3.0;
			if !ok { bad += 1; }
			format(report, uikit::family_name(f), "/", uikit::variant_name(f, v), " ink/bg ", body, " ink/surface ", surf, " on-accent ", accent, if ok { " PASS\n" } else { " FAIL\n" });
		}
	}
	format(report, "\nfailures ", bad, "\n");
	write_file("docs/ui-contrast.md", report);
	fail += eqi(bad, 0, "contrast");
	var vel f32 = 0.0;
	let sprung = uikit::spring_step(0.0 as f32, vel, 1.0 as f32, 0.05 as f32);
	fail += eqi(if sprung > 0.0 && sprung < 1.0 { 1 } else { 0 }, 1, "spring");
	fail += eqi(uikit::catalog_count(), 300, "catalog themes");
	fail += eqi(uikit::genre_count(), 41, "genres");
	fail += eqi(uikit::icon_count(), 500, "icons");
	fail += eqi(uikit::fx_count(), 100, "fx count");
	fail += eqi(uikit::style_count(), 20, "styles");
	fail += eqi(uikit::pair_count(), 30, "font pairs");
	var seen_c int[300] = [0; 300];
	var uniq_c = 0;
	var bad_c = 0;
	for i in uikit::catalog_count() {
		uikit::catalog_set(i);
		let body = uikit::contrast_ratio(uikit::THEME.ink, uikit::THEME.bg);
		let surf = uikit::contrast_ratio(uikit::THEME.ink, uikit::THEME.surface);
		let accent = uikit::contrast_ratio(uikit::THEME.on_accent, uikit::THEME.accent);
		if body < 4.5 || surf < 4.5 || accent < 3.0 { bad_c += 1; }
		let s = uikit::theme_signature();
		var hit = 0;
		for k in uniq_c { if seen_c[k] == s { hit = 1; } }
		if hit == 0 && uniq_c < 300 { seen_c[uniq_c] = s; uniq_c += 1; }
	}
	fail += eqi(bad_c, 0, "catalog contrast");
	fail += eqi(uniq_c, 300, "catalog unique");
	uikit::reset();
	uikit::theme_set(0, 1);
	let deco_b = uikit::button(-1, "A", 0);
	uikit::set_px(deco_b, 40.0, 20.0);
	uikit::layout_root(deco_b, 0.0, 0.0, 80.0, 40.0);
	uikit::note_deco(8.0, 4.0, 30.0, 16.0);
	fail += eqi(if uikit::overlap_count() > 0 { 1 } else { 0 }, 1, "deco overlap");
	uikit::reset();
	fail += eqi(uikit::overlap_count(), 0, "deco clear");
	var bad_m = 0;
	for i in uikit::icon_count() {
		let a = uikit::icon_mask(i);
		for j in i { if uikit::icon_mask(j) == a { bad_m += 1; } }
	}
	fail += eqi(bad_m, 0, "icon masks");
	fail += eqi(if uikit::icon_named() >= 200 { 1 } else { 0 }, 1, "named pictograms");
	fail += eqi(bytes_eq(uikit::icon_name(0), "sword"), 1, "icon sword");
	var bad_name = 0;
	let nn = uikit::icon_named();
	for i in nn {
		let a = uikit::icon_name(i);
		if a.len < 2 { bad_name += 1; }
		for j in i { if bytes_eq(a, uikit::icon_name(j)) != 0 { bad_name += 1; } }
	}
	fail += eqi(bad_name, 0, "icon names");
	var bad_s = 0;
	for g in 24 {
		for s in 7 {
			uikit::reset();
			uikit::theme_set(0, 1);
			let root = uikit::flex(-1, uikit::DIR_COL);
			uikit::build_screen(root, g, s);
			uikit::layout_root(root, 0.0, 0.0, 200.0, 480.0);
			let ov = uikit::overlap_count();
			let cl = uikit::text_clip_count();
			if ov != 0 || cl != 0 { print("screen ", g, " ", s, " ov ", ov, " cl ", cl); bad_s += 1; }
		}
	}
	for g in 17 {
		uikit::reset();
		uikit::theme_set(0, 1);
		let root = uikit::flex(-1, uikit::DIR_COL);
		uikit::app_page(root, g + 24);
		uikit::layout_root(root, 0.0, 0.0, 560.0, 640.0);
		let ov = uikit::overlap_count();
		let cl = uikit::text_clip_count();
		if ov != 0 || cl != 0 { print("app ", g + 24, " ov ", ov, " cl ", cl); bad_s += 1; }
	}
	fail += eqi(bad_s, 0, "screens");
	print("ui fails ", fail);
	if fail != 0 { abort("uikit tests failed"); }
}
