use std
use os
fill(b byte[:], seed int):
	x ~= seed
	for i b.len:
		x = (x * 1103515245 + 12345) & 0x7FFFFFFF
		b[i] = (x >> 16 & 255) as byte
sum(b const byte[:]) int:
	h ~= 7
	for c b: h = (h * 31 + c as int) & 0xFFFFFFF
	h
want(o byte[:], k const byte[:]):
	for y 16:
		a := (k[2 * y] as int) | ((k[2 * y + 1] as int) << 8)
		c ~= 0
		for z 16:
			b := (k[2 * z] as int) | ((k[2 * z + 1] as int) << 8)
			c += if b < a || (b == a && z < y) { 1 } else { 0 }
		o[c] = y as byte
main():
	a := args()
	direct := std_vk_cpu() == 1 || (a.len > 1 && a[1] == "HC_NOVK")
	keys byte[32] ~= [0; 32]
	o1 byte[16] ~= [0; 16]
	o2 byte[16] ~= [0; 16]
	bad ~= 0
	tot ~= 0
	for t 4000:
		fill(keys[..], 100 + t)
		if t % 4 == 1 { for i 32 { keys[i] = keys[i] & 3 } }
		if t % 4 == 2 { for i 16 { keys[2 * i + 1] = 0; keys[2 * i] = keys[2 * i] & 1 } }
		if t % 4 == 3 { for i 32 { keys[i] = (if t % 8 == 3 { 0 } else { 255 }) as! byte } }
		want(o1[..], keys[..])
		fill(o2[..], 9)
		order16(o2[..], keys[..])
		bad += if o1[..] == o2[..] { 0 } else { 1 }
		tot = (tot * 31 + sum(o2[..])) & 0xFFFFFFF
		if direct:
			fill(o2[..], 9)
			std_vk_ord16(std_ptr(o2[..]), std_ptr(keys[..]))
			bad += if o1[..] == o2[..] { 0 } else { 1 }
	print("order16 mismatches ", bad)
	print("order16 sum ", tot)
	src byte[400] ~= [0; 400]
	dst byte[400] ~= [0; 400]
	wnt byte[400] ~= [0; 400]
	bad = 0
	tot = 0
	for n 331:
		for off 3:
			for rnd 2:
				fill(dst[..], 7 + n)
				fill(src[..], 900 + n)
				for i 400: wnt[i] = dst[i]
				for i n: wnt[off + i] = wnt[off + i] ^ src[2 * off + i]
				if rnd == 0 { xor_bytes(dst[off..off + n], src[2 * off..]) } else if direct { std_vk_xor(std_ptr(dst[off..]), std_ptr(src[2 * off..]), n) } else { xor_bytes(dst[off..off + n], src[2 * off..2 * off + n]) }
				bad += if dst[..] == wnt[..] { 0 } else { 1 }
		tot = (tot * 31 + sum(dst[..])) & 0xFFFFFFF
	print("xor_bytes mismatches ", bad)
	print("xor_bytes sum ", tot)
