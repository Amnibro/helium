use helper
struct Point { x int, y int }
twice(p Point) int: p.x * 2 + helper::bump(p.y)
total(xs int[:]) int:
	s ~= 0
	for v xs: s += v
	s
main():
	p := Point{3, 4}
	t := total([1, 2, 3])
	print(twice(p), t, p.x)
