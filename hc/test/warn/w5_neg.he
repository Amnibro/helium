# W5 negatives: called once per element (single loop), a cold nested loop, and the tab form
use os
a(i int, j int) real: 1.0 / ((i + j) * (i + j + 1) / 2 + i + 1) as real
main():
	s ~= 0.0
	for i 10: s += a(i, i)
	for i 10:
		for j 10: s += a(i, j)
	t := tab(10, 10) { i, j => a(i, j) }
	for k 3:
		for i 10:
			for j 10: s += t[i * 10 + j]
	print(s > 0.0)
