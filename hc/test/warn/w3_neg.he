# W3 negatives: different arguments, an impure callee, a repeat guarded by &&, a cheap accessor,
# and two different slices of one array
use os
tri(x int) int:
	s ~= 0
	for i x: s += i
	s
sq(x int) int: x * x + 1
total(s const byte[:]) int:
	t ~= 0
	for x s: t += x as int
	t
noisy(x int) int:
	print("!")
	x
main():
	a := 7
	b := tri(a) + tri(a + 1)
	c := noisy(a) + noisy(a)
	d := a > 0 && tri(a) > 3 && tri(a) < 100
	e := sq(a) + sq(a)
	w := "abcdef"
	f := total(w[..a - 5]) - total(w[a - 5..])
	g := total(w[2..]) + total(w[^2..])
	print(b, " ", c, " ", d, " ", e, " ", f, " ", g)
