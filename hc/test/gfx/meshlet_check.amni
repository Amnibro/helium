import os;
import math;
import gfx.meshlet;
var P f32[>..];
var I u32[>..];
fn ball(around int, down int) {
	P.clear(); I.clear();
	for j in down + 1 {
		let th = PI * j as real / down as real;
		for i in around + 1 {
			let ph = 2.0 * PI * (i % around) as real / around as real;
			let st = if j == 0 || j == down { 0.0 } else { sin(th) };
			let x = st * cos(ph); let y = if j == 0 { 1.0 } else if j == down { -1.0 } else { cos(th) }; let z = -st * sin(ph);
			let d = 1.0 + 0.04 * sin(12.0 * x) * sin(12.0 * y) * sin(12.0 * z);
			P.append([(x * d) as f32, (y * d) as f32, (z * d) as f32]);
		}
	}
	for j in down { for i in around { let a = (j * (around + 1) + i) as u32; let b = a + (around + 1) as u32; I.append([a, b, a + 1, a + 1, b, b + 1]); } }
}
var hk int[>..];
var hc int[>..];
fn open_edges(ix const u32[:]) int {
	var size = 64;
	while size < ix.len * 4 { size *= 2; }
	hk.clear(); hc.clear();
	for i in size { hk.push(-1); hc.push(0); }
	for t in ix.len / 3 {
		for e in 3 {
			let a = meshlet::weld[ix[t * 3 + e] as int]; let b = meshlet::weld[ix[t * 3 + (e + 1) % 3] as int];
			let key = (if a < b { a } else { b }) * 4294967296 + (if a < b { b } else { a });
			var h = ((key * 0x1E3779B97F4A7C15) >> 20) & (size - 1);
			while hk[h] != -1 && hk[h] != key { h = (h + 1) & (size - 1); }
			hk[h] = key; hc[h] += 1;
		}
	}
	var bad = 0;
	for i in size { if hk[i] != -1 && hc[i] != 2 { bad += 1; } }
	bad
}
fn mix(k int) int { var x = k * 0x1E3779B97F4A7C15; x = x ^ (x >> 29); x * 0x3F58476D1CE4E5B9 }
fn tri_key(a int, b int, c int) int { let m = if a <= b && a <= c { 0 } else if b <= c { 1 } else { 2 }; let v = [a, b, c]; (v[m] << 42) | (v[(m + 1) % 3] << 21) | v[(m + 2) % 3] }
fn pt_tri(px real, py real, pz real, t const u32[:]) real {
	let a = t[0] as int * 3; let b = t[1] as int * 3; let c = t[2] as int * 3;
	let ax = P[a] as real; let ay = P[a + 1] as real; let az = P[a + 2] as real;
	let abx = P[b] as real - ax; let aby = P[b + 1] as real - ay; let abz = P[b + 2] as real - az;
	let acx = P[c] as real - ax; let acy = P[c + 1] as real - ay; let acz = P[c + 2] as real - az;
	let apx = px - ax; let apy = py - ay; let apz = pz - az;
	let d1 = abx * apx + aby * apy + abz * apz; let d2 = acx * apx + acy * apy + acz * apz;
	var u = 0.0; var w = 0.0;
	let bpx = apx - abx; let bpy = apy - aby; let bpz = apz - abz;
	let d3 = abx * bpx + aby * bpy + abz * bpz; let d4 = acx * bpx + acy * bpy + acz * bpz;
	let cpx = apx - acx; let cpy = apy - acy; let cpz = apz - acz;
	let d5 = abx * cpx + aby * cpy + abz * cpz; let d6 = acx * cpx + acy * cpy + acz * cpz;
	let vc = d1 * d4 - d3 * d2; let vb = d5 * d2 - d1 * d6; let va = d3 * d6 - d5 * d4;
	if d1 <= 0.0 && d2 <= 0.0 { u = 0.0; w = 0.0; }
	else if d3 >= 0.0 && d4 <= d3 { u = 1.0; w = 0.0; }
	else if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0 { u = d1 / (d1 - d3); w = 0.0; }
	else if d6 >= 0.0 && d5 <= d6 { u = 0.0; w = 1.0; }
	else if vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0 { u = 0.0; w = d2 / (d2 - d6); }
	else if va <= 0.0 && d4 - d3 >= 0.0 && d5 - d6 >= 0.0 { w = (d4 - d3) / ((d4 - d3) + (d5 - d6)); u = 1.0 - w; }
	else { let den = 1.0 / (va + vb + vc); u = vb * den; w = vc * den; }
	let qx = apx - abx * u - acx * w; let qy = apy - aby * u - acy * w; let qz = apz - abz * u - acz * w;
	sqrt(qx * qx + qy * qy + qz * qz)
}
fn errs() f32, f32 {
	var lo f32 = 1e30; var hi f32 = 0.0;
	for c in meshlet::count { let e = meshlet::tab[c * meshlet::ROW + 16]; if e > 0.0 && e < lo { lo = e; } if e > hi { hi = e; } }
	return lo, hi;
}
fn main() {
	var good = true;
	ball(512, 256);
	let nv = P.len / 3;
	for i in nv * 6 { P.push(0.0); }
	let t0 = clock_ns();
	meshlet::build(P[..], 3, 0, nv, I[..]);
	let secs = (clock_ns() - t0) as real / 1e9;
	var big = 0; var n0 = 0; var fs = 0; var fx = 0;
	for c in meshlet::count { let n = meshlet::rng[c * 2 + 1] as int / 3; if n > big { big = n; } }
	for c in meshlet::leaves { let st = meshlet::rng[c * 2] as int; for t in meshlet::rng[c * 2 + 1] as int / 3 { let k = mix(tri_key(meshlet::idx[st + t * 3] as int, meshlet::idx[st + t * 3 + 1] as int, meshlet::idx[st + t * 3 + 2] as int)); fs += k; fx = fx ^ k; n0 += 1; } }
	var m0 = 0; var gs = 0; var gx = 0;
	for t in I.len / 3 { let a = I[t * 3] as int; let b = I[t * 3 + 1] as int; let c = I[t * 3 + 2] as int; if meshlet::weld[a] == meshlet::weld[b] || meshlet::weld[b] == meshlet::weld[c] || meshlet::weld[a] == meshlet::weld[c] { continue; } let k = mix(tri_key(a, b, c)); gs += k; gx = gx ^ k; m0 += 1; }
	let top = meshlet::cut_tris(1e29);
	let n1 = big <= 128 && n0 == m0 && fs == gs && fx == gx && top * 100 <= m0 && secs <= 5.0;
	print("meshlet N1 ", meshlet::count, " clusters in ", meshlet::levels, " levels, largest ", big, " triangles; level 0 holds ", n0, " of ", m0, " (same set: ", fs == gs && fx == gx, "); coarsest cut ", top, " triangles = 1 / ", if top > 0 { m0 / top } else { 0 }, "; built in ", secs, " s, ", meshlet::next_v - nv, " new vertices", if n1 { " PASS" } else { " FAIL" });
	for l in meshlet::level_tris.len {
		var es f32[>..] = []; var orphan = 0; var ot = 0;
		for c in meshlet::count { if meshlet::tab[c * meshlet::ROW + 18] as int == l { es.push(meshlet::tab[c * meshlet::ROW + 16]); if meshlet::tab[c * meshlet::ROW + 17] > 1e29 { orphan += 1; ot += meshlet::rng[c * 2 + 1] as int / 3; } } }
		for i in es.len { for j in es.len - 1 - i { if es[j] > es[j + 1] { let t = es[j]; es[j] = es[j + 1]; es[j + 1] = t; } } }
		print("  level ", l, ": ", meshlet::level_tris[l], " triangles, ", es.len, " clusters, error min ", es[0], " median ", es[es.len / 2], " p90 ", es[es.len * 9 / 10], " max ", es[es.len - 1], ", no parent ", orphan, " (", ot, " tris)");
	}
	for q in 8 { let e = 0.0125 * pow(1.5, q as real) as f32; print("  cut at ", e, ": ", meshlet::cut_tris(e), " triangles"); }
	good = good && n1;
	let lo, hi = errs();
	var out u32[>..] = [];
	var worst = 0; var line byte[>..] = [];
	for k in 16 {
		let e = (lo as real * pow(hi as real / lo as real, k as real / 15.0)) as f32 * (if k == 15 { 1.0001 } else { 1.0 });
		meshlet::cut(e, out);
		let oe = open_edges(out[..]);
		if oe > worst { worst = oe; }
		line.append(str(" ", out.len / 3));
	}
	out.clear();
	for c in meshlet::count { let b = c * meshlet::ROW; let e = if meshlet::tab[b] < 0.0 { 0.0 } else { hi * 1.0001 }; if meshlet::tab[b + 16] <= e && meshlet::tab[b + 17] > e { let st = meshlet::rng[c * 2] as int; for q in meshlet::rng[c * 2 + 1] as int { out.push(meshlet::idx[st + q]); } } }
	let ctl = open_edges(out[..]);
	let n2 = worst == 0 && ctl > 0;
	print("meshlet N2 errors ", lo, " to ", hi, ": worst cut has ", worst, " edges not shared by two triangles; cut sizes", line, "; control (two errors mixed) ", ctl, " open edges", if n2 { " PASS" } else { " FAIL" });
	good = good && n2;
	ball(128, 64);
	let nv2 = P.len / 3;
	for i in nv2 * 6 { P.push(0.0); }
	meshlet::build(P[..], 3, 0, nv2, I[..]);
	let lo2, hi2 = errs();
	var n3 = true;
	for q in 4 {
		let k = q * 4 + 3;
		let e = (lo2 as real * pow(hi2 as real / lo2 as real, k as real / 15.0)) as f32 * (if k == 15 { 1.0001 } else { 1.0 });
		meshlet::cut(e, out);
		var far = 0.0;
		for v in nv2 / 4 {
			let px = P[v * 12] as real; let py = P[v * 12 + 1] as real; let pz = P[v * 12 + 2] as real;
			var best = 1e30;
			for t in out.len / 3 { let d = pt_tri(px, py, pz, out[t * 3..t * 3 + 3]); if d < best { best = d; } }
			if best > far { far = best; }
		}
		let ok = far <= 2.0 * e as real;
		n3 = n3 && ok;
		print("meshlet N3 error ", e, ": ", out.len / 3, " triangles, farthest vertex ", far, " = ", far / e as real, " e", if ok { " PASS" } else { " FAIL" });
	}
	good = good && n3;
	print(if good { "meshlet: ok" } else { "meshlet: FAILED" });
	if !good { exit(1); }
}
