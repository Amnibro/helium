fn vsm_frame(virt bool, n int) byte[>..] { s3d::sun.virt = virt; shoot(n, IN_OUT); gfx::read_pixels(IN_OUT) }
fn vsm_soft(p const byte[:], e const byte[:], m const byte[:]) int {
	var lo = 255;
	for i in m.len { if m[i] != 0 { lo = min(lo, sh_luma(p, i)); } }
	var n = 0;
	for i in m.len { let g = p[i * 4 + 1] as int; if g > p[i * 4] as int + 8 && g > p[i * 4 + 2] as int + 8 { continue; } let l = sh_luma(p, i); if l + 7 < sh_luma(e, i) && l > lo + 7 { n++; } }
	n
}
fn vsm_checks() bool {
	IN_OUT = gfx::render_target(1280, 720, gfx::RGBA8);
	reset_scene();
	dark_scene();
	s3d::sky = DEF_SKY; s3d::sky.draw = true; s3d::sun = DEF_SUN; s3d::sun.to_sun = linalg::unit3(float3 { 0.5, 0.8, 0.3 }); s3d::sun.shadows = true; s3d::sun.map_size = 4096; s3d::sun.shadow_far = 24.0;
	let green = shapes::material(linalg::v3(0.2, 0.8, 0.2), 0.0, 0.7);
	let _ = s3d::add(shapes::plane(40.0, shapes::material(linalg::v3(0.8, 0.8, 0.8), 0.0, 1.0)));
	let a = s3d::add(shapes::sphere(0.5, 64, 32, green));
	let b = s3d::add(shapes::cube(linalg::v3(0.3, 0.3, 0.3), green));
	s3d::place(a, gfx::translate(float3 { 0.0, 1.2, 0.0 }));
	s3d::place(b, gfx::translate(float3 { 2.0, 0.8, -1.0 }));
	s3d::meshlets = false;
	s3d::init(1280, 720);
	ml_eye(float3 { 0.0, 2.5, 5.0 }, float3 { 0.0, 0.7, 0.0 });
	s3d::items[a].visible = false; s3d::items[b].visible = false;
	let e = vsm_frame(false, 3);
	s3d::items[a].visible = true; s3d::items[b].visible = true;
	let c1 = vsm_frame(false, 3);
	let v1 = vsm_frame(true, 3);
	let d1, l1, x1 = s3d::vsm_stats();
	s3d::vsm_test_blank(true);
	let k1 = vsm_frame(true, 3);
	s3d::vsm_test_blank(false);
	let mc = ml_mask(c1[..], e[..], true); let mv = ml_mask(v1[..], e[..], true); let mk = ml_mask(k1[..], e[..], true);
	let i1 = ml_iou(mc[..], mv[..]); let ik = ml_iou(mc[..], mk[..]);
	let o1 = i1 >= 0.97 && ml_n(mc[..]) >= 2000 && ik < 0.5;
	print("gpu: virtual shadows V1 shadow pixels cascades ", ml_n(mc[..]), " virtual ", ml_n(mv[..]), " IoU ", r3(i1), " (bar >= 0.97); control with a blank page table IoU ", r3(ik), " (bar < 0.5)", if o1 { " PASS" } else { " FAIL" });
	let o2 = d1 == 0 && l1 > 0 && x1 == 0;
	print("gpu: virtual shadows V2 still scene, third frame: pages drawn ", d1, " (bar 0), pages in use ", l1, ", pages that did not fit ", x1, " (bar 0)", if o2 { " PASS" } else { " FAIL" });
	let _ = vsm_frame(true, 3);
	s3d::place(b, gfx::translate(float3 { 2.3, 0.8, -1.0 }));
	let v3 = vsm_frame(true, 1);
	let d3, l3, x3 = s3d::vsm_stats();
	let c3 = vsm_frame(false, 3);
	let i3 = ml_iou(ml_mask(c3[..], e[..], true)[..], ml_mask(v3[..], e[..], true)[..]);
	let o3 = d3 > 0 && d3 * 2 <= l3 && i3 >= 0.97;
	print("gpu: virtual shadows V3 one box moved: pages drawn ", d3, " of ", l3, " in use (bar > 0 and at most half), IoU ", r3(i3), " (bar >= 0.97)", if o3 { " PASS" } else { " FAIL" });
	ml_eye(float3 { 3.0, 1.6, 4.0 }, float3 { 0.5, 0.2, -0.5 });
	s3d::items[a].visible = false; s3d::items[b].visible = false;
	let e4 = vsm_frame(false, 3);
	s3d::items[a].visible = true; s3d::items[b].visible = true;
	let c4 = vsm_frame(false, 3);
	let v4 = vsm_frame(true, 3);
	let d4, l4, x4 = s3d::vsm_stats();
	let i4 = ml_iou(ml_mask(c4[..], e4[..], true)[..], ml_mask(v4[..], e4[..], true)[..]);
	let o4 = i4 >= 0.97 && x4 == 0 && d4 == 0;
	print("gpu: virtual shadows V4 camera moved: IoU ", r3(i4), " (bar >= 0.97), pages in use ", l4, ", did not fit ", x4, " (bar 0), drawn on the third frame ", d4, " (bar 0)", if o4 { " PASS" } else { " FAIL" });
	ml_eye(float3 { -0.75, 0.25, 0.6 }, float3 { -0.75, 0.0, -0.1 });
	s3d::sun.map_size = 2048; s3d::sun.shadow_far = 60.0;
	s3d::items[a].visible = false; s3d::items[b].visible = false;
	let e5 = vsm_frame(false, 3);
	s3d::items[a].visible = true; s3d::items[b].visible = true;
	let c5 = vsm_frame(false, 3);
	let v5 = vsm_frame(true, 3);
	let d5, l5, x5 = s3d::vsm_stats();
	let m5 = ml_mask(c5[..], e5[..], true); let n5 = ml_mask(v5[..], e5[..], true);
	let sc = vsm_soft(c5[..], e5[..], m5[..]); let sv = vsm_soft(v5[..], e5[..], n5[..]);
	let o5 = ml_n(n5[..]) >= 2000 && sv * 2 <= sc && x5 == 0;
	print("gpu: virtual shadows V5 close to the shadow edge: half-lit pixels cascades (2048 map, 60 m) ", sc, ", virtual ", sv, " (bar at most half), shadow pixels ", ml_n(n5[..]), ", pages in use ", l5, ", did not fit ", x5, if o5 { " PASS" } else { " FAIL" });
	ml_eye(float3 { 0.0, 2.5, 5.0 }, float3 { 0.0, 0.7, 0.0 });
	s3d::sun.map_size = 4096; s3d::sun.shadow_far = 24.0;
	let h6 = vsm_frame(true, 3);
	s3d::sun.angle = 0.07;
	let c6 = vsm_frame(false, 3);
	let v6 = vsm_frame(true, 3);
	let d6, l6, x6 = s3d::vsm_stats();
	s3d::sun.angle = 0.0;
	let m6 = ml_mask(c6[..], e[..], true); let n6 = ml_mask(v6[..], e[..], true); let mh = ml_mask(h6[..], e[..], true);
	let s6 = vsm_soft(c6[..], e[..], m6[..]); let t6 = vsm_soft(v6[..], e[..], n6[..]); let sh = vsm_soft(h6[..], e[..], mh[..]);
	var a6 = 0; var ah = 0; var u6 = 0;
	for i in m6.len { if m6[i] != 0 || n6[i] != 0 || mh[i] != 0 { u6++; a6 += abs(sh_luma(c6[..], i) - sh_luma(v6[..], i)); ah += abs(sh_luma(c6[..], i) - sh_luma(h6[..], i)); } }
	let e6 = a6 as real / max(u6, 1) as real; let eh = ah as real / max(u6, 1) as real;
	let o6 = t6 >= sh * 2 && t6 * 10 >= s6 * 7 && t6 * 10 <= s6 * 14 && e6 * 2.0 <= eh && x6 == 0 && d6 == 0;
	print("gpu: virtual shadows V6 soft sun (angle 0.07): half-lit pixels cascades ", s6, ", virtual ", t6, " (bar 0.7x to 1.4x of cascades and >= 2x the hard virtual count ", sh, "); mean shade difference from cascades ", r3(e6), ", hard control ", r3(eh), " (bar at most half the control); did not fit ", x6, ", drawn on the third frame ", d6, if o6 { " PASS" } else { " FAIL" });
	s3d::sun.virt = false;
	o1 && o2 && o3 && o4 && o5 && o6
}
fn hr_world() {
	for g in hair::grooms.len { hair::unload(g); }
	reset_scene();
	s3d::sky = DEF_SKY; s3d::sun = DEF_SUN; s3d::sun.shadows = true; s3d::look = DEF_LOOK; s3d::look.bloom = 0.0; s3d::look.ssao = false;
	s3d::ssr_on = false; s3d::ssgi_on = false; s3d::gi_on = false; s3d::temporal = 0; s3d::fog_on = false; s3d::sss_on = false;
}
fn hr_cam(x f32, y f32, z f32) { s3d::view = s3d::Camera { eye: float3 { x, y + z / 90.0, z }, target: float3 { x, y, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: 0.5, near: 0.05, far: 50.0 }; }
fn hr_head(at float3, sc f32) int, int {
	let a = shapes::sphere(0.1, 32, 16, shapes::material(linalg::v3(0.75, 0.6, 0.5), 0.0, 0.6));
	let it = s3d::add(a);
	s3d::place(it, gfx::mul(gfx::translate(at), gfx::scale(float3 { sc, sc, sc })));
	return it, gltf::assets[a].nodes.first as int;
}
fn hr_data(node int, st hair::Style, n int, low f32, d byte[>..]&) {
	var rp float3[>..] = [];
	var rn float3[>..] = [];
	let _ = hair::mesh_roots(node, float3 { -1.0, low, -1.0 }, float3 { 1.0, 1.0, 1.0 }, n, 7, rp, rn);
	hair::groom(rp[..], rn[..], st, d);
}
fn hr_frame(dt f32) byte[>..] {
	if s3d::render_begin() { hair::draw(dt); s3d::render_end(IN_OUT); }
	gfx::flush();
	gfx::read_pixels(IN_OUT)
}
fn hr_shot() byte[>..] { let _ = hr_frame(0.0); hr_frame(0.0) }
fn hr_run(n int) { for _ in n { if s3d::render_begin() { hair::draw(1.0 / 60.0); s3d::render_end(IN_OUT); } gfx::flush(); } }
fn hr_ch(a const byte[:], b const byte[:], thr int, x0 int, x1 int) int, real {
	var n = 0;
	var sx = 0.0;
	for y in 720 { for x in x0..x1 { if sk_d(a, b, y * 1280 + x) > thr { n += 1; sx += x as real; } } }
	return n, sx / max(n, 1) as real;
}
fn hr_far(a const byte[:], b const byte[:], cx real, cy real, r real) int {
	var n = 0;
	for y in 720 { for x in 1280 { if (x as real - cx) * (x as real - cx) + (y as real - cy) * (y as real - cy) > r * r && sk_d(a, b, y * 1280 + x) > 2 { n += 1; } } }
	n
}
fn hr_lum(px const byte[:], a const byte[:], b const byte[:], rin real) real {
	var n = 0;
	var s = 0.0;
	let rr = rin * rin;
	for y in 720 { for x in 1280 { if ((x - 640) * (x - 640) + (y - 360) * (y - 360)) as real > rr && sk_d(a, b, y * 1280 + x) > 8 { n += 1; s += vc_l8(px, y * 1280 + x); } } }
	s / max(n, 1) as real
}
fn hr_tip(g int) real { let _ = hair::probe(g, 2); hr_run(1); hair::probe(g, 2) as real }
fn hr_f(d const byte[:], at int) real { hair::f32_at(d, at) as real }
fn hr_pass(ok bool) const byte[:] { if ok { " PASS" } else { " FAIL" } }
fn hr_mid(v real[>..]&) real {
	var mid = 0.0;
	for k in v.len { var less = 0; var same = 0; for j in v.len { if v[j] < v[k] { less += 1; } else if v[j] == v[k] { same += 1; } } if less <= v.len / 2 && less + same > v.len / 2 { mid = v[k]; } }
	mid
}
fn hr_cpu() bool {
	reset_scene();
	let _, node = hr_head(float3 { 0.0, 0.0, 0.0 }, 1.0);
	var d0 byte[>..] = [];
	var d1 byte[>..] = [];
	var d2 byte[>..] = [];
	var d3 byte[>..] = [];
	hr_data(node, hair::Style { steps: 14, length: 0.16, clumps: 40, curl: 0.004, .. }, 700, 0.02, d0);
	hr_data(node, hair::Style { steps: 14, length: 0.16, clumps: 40, curl: 0.004, .. }, 700, 0.02, d1);
	hr_data(node, hair::Style { steps: 14, length: 0.16, clumps: 40, curl: 0.004, seed: 8, .. }, 700, 0.02, d2);
	var same = d0.len == d1.len;
	var diff = 0;
	for i in min(d0.len, d1.len) { if d0[i] != d1[i] { same = false; } if d0[i] != d2[i] { diff += 1; } }
	let want = 16 + 700 * 14 * 48 + 700 * 13 * 16;
	let h1 = same && diff > 0 && d0.len == want;
	print("gpu: hair H1 generator: same seed identical ", same, ", other seed differs in ", diff, " bytes, size ", d0.len, " (bar ", want, ")", hr_pass(h1));
	let bad = "HMX2000000000000000000000000";
	let b0 = hair::load("", 12);
	let b1 = hair::load(bad, 12);
	let b2 = hair::load(d0[0..d0.len - 16], 12);
	let b3 = hair::load(d0[..], 12);
	let h2 = b0 == -1 && b1 == -1 && b2 == -1 && b3 >= 0;
	print("gpu: hair H2 load: empty ", b0, ", wrong magic ", b1, ", truncated ", b2, " (bar -1 each), whole ", b3, " (bar >= 0)", hr_pass(h2));
	hair::unload(b3);
	let c = hair::card_mesh(d0[..], shapes::material(linalg::v3(0.3, 0.2, 0.1), 0.0, 0.5));
	let cn = hair::find_cards(c, "");
	let rt = hair::card_data(c, cn, -1, d3);
	var worst = 0.0;
	var counts = rt && d3.len >= d0.len;
	if counts {
		for i in 12 { if d3[4 + i] != d0[4 + i] { counts = false; } }
		for p in 700 * 14 { for k in 3 { worst = max(worst, abs(hr_f(d3[..], 16 + p * 48 + k * 4) - hr_f(d0[..], 16 + p * 48 + k * 4))); } }
	}
	let vc = gltf::prims[gltf::meshes[gltf::nodes[gltf::assets[c].nodes.first as int].mesh as int].prims.first as int].vcount;
	let h14 = counts && worst <= 0.00001;
	print("gpu: hair H14 cards round trip: read back ", rt, ", counts equal ", counts, ", largest point error ", worst, " m (bar <= 0.00001)", hr_pass(h14));
	HR_VC = vc == 2 * 700 * 14;
	h1 && h2 && h14
}
var HR_VC = false;
var HR_IT = 0;
var HR_NODE = 0;
let HR_AT = float3 { 0.0, 1.6, 0.0 };
fn hr_r() real { 0.1 * 360.0 / tan(0.25) / 1.8 }
fn hr_disc() real { 3.14159265 * hr_r() * hr_r() }
fn hr_style() hair::Style { hair::Style { steps: 14, length: 0.16, clumps: 40, curl: 0.004, .. } }
fn hr_setup(st hair::Style, n int, strands int, low f32, at float3, sc f32) int {
	let it, node = hr_head(at, sc);
	HR_IT = it;
	HR_NODE = node;
	var d byte[>..] = [];
	hr_data(node, st, n, low, d);
	let g = hair::load(d[..], strands);
	hair::follow(g, it, -1);
	g
}
fn hr_pair(g int) byte[>..], byte[>..] {
	let a = hr_shot();
	hair::grooms[g].show = false;
	let b = hr_shot();
	hair::grooms[g].show = true;
	return a, b;
}
fn hr_look() bool {
	hr_world();
	hr_cam(0.0, 1.6, 1.8);
	let g = hr_setup(hr_style(), 700, 12, 0.02, HR_AT, 1.0);
	let a, b = hr_pair(g);
	let a2, b2 = hr_pair(g);
	let _ = codec_png::write(path(OUT_DIR[..], "hair.png")[..], 1280, 720, 4, a[..]);
	let n, cx = hr_ch(a[..], b[..], 8, 0, 1280);
	let far = hr_far(a[..], b[..], 640.0, 360.0, 3.2 * hr_r());
	let n0, _ = hr_ch(b[..], b2[..], 8, 0, 1280);
	let h3 = n as real / hr_disc() >= 0.4 && far == 0 && n0 == 0;
	print("gpu: hair H3 coverage: ", n, " changed pixels, ", r3(n as real / hr_disc()), " of the head's disc (bar >= 0.4), ", far, " beyond 3.2 radii (bar 0); control hidden twice ", n0, " (bar 0)", hr_pass(h3));
	let rep = sk_apart(a[..], a2[..]);
	print("gpu: hair H12 repeat: largest difference ", rep, " / 255 (bar <= 2)", hr_pass(rep <= 2));
	let sky = s3d::sky;
	s3d::sky.zenith = float3 { 0.0, 0.0, 0.0 };
	s3d::sky.horizon = float3 { 0.0, 0.0, 0.0 };
	s3d::sky.ground = float3 { 0.0, 0.0, 0.0 };
	let ka, kb = hr_pair(g);
	let l1 = hr_lum(ka[..], ka[..], kb[..], hr_r() + 2.0);
	let rgb = s3d::sun.rgb;
	s3d::sun.rgb = float3 { 0.0, 0.0, 0.0 };
	let d = hr_shot();
	s3d::sun.rgb = rgb;
	s3d::sky = sky;
	let ld = hr_lum(d[..], ka[..], kb[..], hr_r() + 2.0);
	let h9 = ld <= 0.7 * l1;
	print("gpu: hair H9 sun: mean hair brightness ", r3(ld), " with the sun off, ratio ", r3(ld / max(l1, 0.001)), " (bar <= 0.7)", hr_pass(h9));
	let wall = s3d::add(shapes::cube(float3 { 0.6, 0.6, 0.01 }, shapes::material(linalg::v3(0.5, 0.5, 0.5), 0.0, 0.7)));
	s3d::place(wall, gfx::translate(float3 { 0.0, 1.6, 0.6 }));
	let w1, w0 = hr_pair(g);
	s3d::items[wall].visible = false;
	let wd = sk_apart(w1[..], w0[..]);
	let ws = sk_apart(w1[..], a[..]);
	let h4 = wd <= 2 && ws > 8;
	print("gpu: hair H4 wall: largest difference shown vs hidden ", wd, " / 255 (bar <= 2), wall frame vs open frame ", ws, " (must be > 8)", hr_pass(h4));
	s3d::place(HR_IT, gfx::translate(float3 { 0.3, 1.6, 0.0 }));
	let m1, m0 = hr_pair(g);
	let _, cm = hr_ch(m1[..], m0[..], 8, 0, 1280);
	hair::follow(g, HR_IT, HR_NODE);
	let k1 = hr_shot();
	let _, ck = hr_ch(k1[..], m0[..], 8, 0, 1280);
	hair::grooms[g].item = -1;
	hair::place(g, gfx::translate(HR_AT));
	let s1 = hr_shot();
	let _, cs = hr_ch(s1[..], m0[..], 8, 0, 1280);
	let h13 = abs(cm - cx - 235.0) <= 15.0 && abs(ck - cm) <= 1.0 && abs(cs - cx) < 40.0;
	print("gpu: hair H13 follow: center moved ", r3(cm - cx), " px (bar 235 within 15), anchored to the node ", r3(ck - cx), " (bar within 1 of the first); control not following ", r3(cs - cx), " (bar below 40)", hr_pass(h13));
	h3 && rep <= 2 && h9 && h4 && h13
}
fn hr_near(g int) real, bool {
	var p byte[>..] = [];
	hair::points(g, p);
	var best = 1e9;
	var fin = p.len > 0;
	for i in p.len / 48 {
		let x = hr_f(p[..], i * 48);
		let y = hr_f(p[..], i * 48 + 4);
		let z = hr_f(p[..], i * 48 + 8);
		let d = sqrt(x * x + y * y + z * z);
		fin = fin && d == d && d < 1e6;
		best = min(best, d);
	}
	return best, fin;
}
fn hr_sim() bool {
	hr_world();
	hr_cam(0.0, 1.6, 1.8);
	var st = hr_style();
	st.droop = 0.0;
	st.clumps = 0;
	st.curl = 0.0;
	let g = hr_setup(st, 700, 12, 0.02, HR_AT, 1.0);
	hr_run(120);
	let t1 = hr_tip(g);
	let _ = hair::probe(g, 2);
	s3d::place(HR_IT, gfx::translate(float3 { 0.1, 1.6, 0.0 }));
	hr_run(1);
	let lag = hair::probe(g, 2) as real;
	hr_run(180);
	let rest = hr_tip(g);
	hair::grooms[g].phys = hair::Physics { styled: 0.0, tip: 0.0, root: 0.0, bend: 0.0, .. };
	hr_run(120);
	let t0 = hr_tip(g);
	let h5 = t1 <= 3.0 && t0 >= 10.0;
	print("gpu: hair H5 style: mean tip offset ", r3(t1), " mm after 120 steps (bar <= 3); control styling and hold 0: ", r3(t0), " mm (bar >= 10)", hr_pass(h5));
	let h7 = lag >= 5.0 && rest <= 3.0;
	print("gpu: hair H7 inertia: tip offset ", r3(lag), " mm right after a 0.1 m jump (bar >= 5), ", r3(rest), " mm 180 steps later (bar <= 3)", hr_pass(h7));
	hr_world();
	hr_cam(0.0, 1.6, 1.8);
	let it, node = hr_head(HR_AT, 1.0);
	var rp float3[>..] = [];
	var rn float3[>..] = [];
	for i in 200 {
		let a = i as real * 0.0314159265;
		rp.push(float3 { linalg::f(0.02 * cos(a)), 0.09798, linalg::f(0.02 * sin(a)) });
		rn.push(float3 { linalg::f(cos(a)), 0.0, linalg::f(sin(a)) });
	}
	var d byte[>..] = [];
	hair::groom(rp[..], rn[..], hair::Style { steps: 14, length: 0.16, vary: 0.0, droop: 0.0, .. }, d);
	let f = hair::load(d[..], 4);
	hair::follow(f, it, -1);
	hair::grooms[f].phys = hair::Physics { styled: 0.0, tip: 0.0, root: 0.0, bend: 0.0, .. };
	hr_run(300);
	let n0, _ = hr_near(f);
	hair::solid(f, node);
	hair::grooms[f].reset = true;
	hr_run(300);
	let n1, fin = hr_near(f);
	let h6 = n1 >= 0.095 && n0 <= 0.085 && fin;
	print("gpu: hair H6 collision: nearest point to the head's center ", r3(n1 * 1000.0), " mm with the collider (bar >= 95), parts ", hair::grooms[f].parts, ", cells ", hair::grooms[f].cells, "; control without ", r3(n0 * 1000.0), " mm (bar <= 85)", hr_pass(h6));
	hr_world();
	var d0 byte[>..] = [];
	var d1 byte[>..] = [];
	var px byte[>..] = [];
	let _, hn = hr_head(float3 { 0.0, 0.0, 0.0 }, 1.0);
	hr_data(hn, hr_style(), 700, 0.02, d0);
	let c = hair::card_mesh(d0[..], shapes::material(linalg::v3(0.3, 0.2, 0.1), 0.0, 0.5));
	let cn = gltf::assets[c].nodes.first as int;
	let pr = gltf::prims[gltf::meshes[gltf::nodes[cn].mesh as int].prims.first as int];
	for v in pr.vcount { gltf::verts[(pr.vfirst + v) * gltf::VERTEX_FLOATS + gltf::AT_JOINT] = ((v / 28) % 2) as f32; }
	let nm = gltf::names.len;
	gltf::names.append("j0j1");
	for k in 2 {
		gltf::nodes.push(gltf::Node { parent: -1, mesh: -1, skin: -1, children: gltf::Span { gltf::ints.len, 0 }, t: float3 { 0.0, 0.0, 0.0 }, r: linalg::quat_identity(), s: float3 { 1.0, 1.0, 1.0 }, matrix: gfx::mat4_identity, has_matrix: false, weights: gltf::Span { gltf::floats.len, 0 }, name: gltf::Span { nm + 2 * k, 2 } });
		gltf::ints.push(cn + 1 + k);
		gltf::matrices.push(gfx::mat4_identity);
	}
	gltf::assets[c].nodes.count += 2;
	gltf::assets[c].roots.count += 2;
	gltf::skins.push(gltf::Skin { gltf::Span { gltf::ints.len - 2, 2 }, gltf::Span { gltf::matrices.len - 2, 2 }, -1, gltf::Span { 0, 0 } });
	gltf::nodes[cn].skin = gltf::skins.len - 1;
	let made = hair::card_data(c, hair::find_cards(c, ""), -1, d1);
	let b = if made { hair::load(d1[..], 4) } else { -1 };
	var h15 = b >= 0 && hair::grooms[b].bones == 2;
	var bound = 0.0;
	var loose = 0.0;
	var parts = 0;
	var cells = 0;
	var fin2 = false;
	if h15 {
		let ci = s3d::add(c);
		s3d::items[ci].visible = false;
		hair::follow(b, ci, -1);
		gltf::nodes[cn + 2].t = float3 { 0.05, 0.0, 0.0 };
		let _ = hr_shot();
		hair::points(b, px);
		for p in 700 * 14 {
			let dx = hr_f(px[..], p * 48) - hr_f(d0[..], 16 + p * 48);
			let dy = hr_f(px[..], p * 48 + 4) - hr_f(d0[..], 16 + p * 48 + 4);
			let dz = hr_f(px[..], p * 48 + 8) - hr_f(d0[..], 16 + p * 48 + 8);
			if (p / 14) % 2 == 1 { bound = max(bound, sqrt((dx - 0.05) * (dx - 0.05) + dy * dy + dz * dz)); } else { loose = max(loose, sqrt(dx * dx + dy * dy + dz * dz)); }
		}
		hair::body(b, c, "", ["j0"], [""]);
		parts = hair::grooms[b].parts;
		cells = hair::grooms[b].cells;
		hr_run(10);
		let _, f2 = hr_near(b);
		fin2 = f2;
		h15 = bound <= 0.0005 && loose < 0.0005 && parts == 1 && cells > 0 && fin2;
	}
	print("gpu: hair H15 bones: groom ", b, ", worst error of bound points ", bound, " m (bar <= 0.0005), unbound points moved ", loose, " m (bar < 0.0005), collider parts ", parts, " (bar 1), cells ", cells, " (bar > 0), finite ", fin2, hr_pass(h15));
	h5 && h7 && h6 && h15
}
fn hr_psnr(a const byte[:], b const byte[:]) real {
	let k = (3.2 * hr_r()) as int;
	var s = 0.0;
	for y in 360 - k..360 + k { for x in 640 - k..640 + k { for c in 3 { let d = (a[(y * 1280 + x) * 4 + c] as int - b[(y * 1280 + x) * 4 + c] as int) as real; s += d * d; } } }
	10.0 * log10(65025.0 * (12 * k * k) as real / max(s, 1e-9))
}
fn hr_more() bool {
	hr_world();
	hr_cam(0.0, 1.6, 1.8);
	let ga = hr_setup(hr_style(), 700, 12, 0.02, float3 { -0.35, 1.6, 0.0 }, 1.0);
	let gb = hr_setup(hr_style(), 700, 12, 0.02, float3 { 0.35, 1.6, 0.0 }, 1.0);
	let both = hr_shot();
	hair::grooms[gb].show = false;
	let one = hr_shot();
	hair::grooms[ga].show = false;
	let none = hr_shot();
	let na, _ = hr_ch(both[..], none[..], 8, 0, 640);
	let nb, _ = hr_ch(both[..], none[..], 8, 640, 1280);
	let ka, _ = hr_ch(one[..], both[..], 2, 0, 640);
	let kb, _ = hr_ch(one[..], none[..], 2, 640, 1280);
	let h10 = na as real / hr_disc() >= 0.4 && nb as real / hr_disc() >= 0.4 && ka == 0 && kb == 0;
	print("gpu: hair H10 two grooms: ", r3(na as real / hr_disc()), " and ", r3(nb as real / hr_disc()), " of each head's disc changed (bar >= 0.4 each); one hidden: ", ka, " pixels differ on the other's half, ", kb, " on its own half against no hair (bar 0 each)", hr_pass(h10));
	hr_world();
	hr_cam(0.0, 1.6, 1.8);
	s3d::sun.shadows = false;
	let g = hr_setup(hr_style(), 700, 12, 0.02, HR_AT, 1.0);
	let s1, s0 = hr_pair(g);
	s3d::place(HR_IT, gfx::mul(gfx::translate(HR_AT), gfx::scale(float3 { 2.0, 2.0, 2.0 })));
	hr_cam(0.0, 1.6, 3.6);
	let s2 = hr_shot();
	let _ = codec_png::write(path(OUT_DIR[..], "hair_x2.png")[..], 1280, 720, 4, s2[..]);
	let ps = hr_psnr(s1[..], s2[..]);
	let pc = hr_psnr(s1[..], s0[..]);
	let h11 = ps >= 30.0 && pc < 30.0;
	print("gpu: hair H11 scale: PSNR ", r3(ps), " dB at twice the size and distance (bar >= 30); control hair hidden ", r3(pc), " dB (bar < 30)", hr_pass(h11));
	s3d::place(HR_IT, gfx::translate(HR_AT));
	hr_cam(0.0, 1.6, 1.8);
	s3d::sun.shadows = true;
	var th real[>..] = [];
	var t0 real[>..] = [];
	hr_run(4);
	for _ in 21 { let t = gfx::time(); hr_run(1); th.push((gfx::time() - t) * 1000.0); }
	hair::grooms[g].show = false;
	hr_run(4);
	for _ in 21 { let t = gfx::time(); hr_run(1); t0.push((gfx::time() - t) * 1000.0); }
	let cost = hr_mid(th) - hr_mid(t0);
	let h16 = cost <= 14.0;
	print("gpu: hair H16 cost: median frame ", r3(hr_mid(th)), " ms with hair, ", r3(hr_mid(t0)), " ms without, hair ", r3(cost), " ms (bar <= 14)", hr_pass(h16));
	hr_world();
	hr_cam(0.0, 1.6, 1.8);
	let _, node = hr_head(HR_AT, 1.0);
	var d byte[>..] = [];
	hr_data(node, hr_style(), 700, 0.02, d);
	let e0 = hr_shot();
	var m = shapes::material(linalg::v3(0.3, 0.2, 0.1), 0.0, 0.5);
	m.double_sided = true;
	s3d::place(s3d::add(hair::card_mesh(d[..], m)), gfx::translate(HR_AT));
	let e1 = hr_shot();
	let _ = codec_png::write(path(OUT_DIR[..], "hair_cards.png")[..], 1280, 720, 4, e1[..]);
	let nc, _ = hr_ch(e1[..], e0[..], 8, 0, 1280);
	let h17 = HR_VC && nc as real / hr_disc() >= 0.3;
	print("gpu: hair H17 cards: vertex count is twice the points ", HR_VC, ", ", r3(nc as real / hr_disc()), " of the head's disc changed (bar >= 0.3)", hr_pass(h17));
	hr_world();
	hr_cam(0.0, 1.6, 1.8);
	let f = hr_setup(hair::fur(), 12000, 12, -1.0, HR_AT, 1.0);
	let f1, f0 = hr_pair(f);
	let _ = codec_png::write(path(OUT_DIR[..], "hair_fur.png")[..], 1280, 720, 4, f1[..]);
	let nf, _ = hr_ch(f1[..], f0[..], 8, 0, 1280);
	let h18 = nf as real / hr_disc() >= 0.7;
	print("gpu: hair H18 fur: ", r3(nf as real / hr_disc()), " of the head's disc changed (bar >= 0.7)", hr_pass(h18));
	hr_world();
	hr_cam(0.0, 1.6, 1.8);
	s3d::sky.zenith = float3 { 0.0, 0.0, 0.0 };
	s3d::sky.horizon = float3 { 0.0, 0.0, 0.0 };
	s3d::sky.ground = float3 { 0.0, 0.0, 0.0 };
	s3d::sun.shadows = false;
	let q = hr_setup(hr_style(), 700, 12, 0.02, HR_AT, 1.0);
	let k1, k0 = hr_pair(q);
	s3d::sun.to_sun = linalg::unit3(float3 { 1.0, 0.3, 0.2 });
	let ks = hr_shot();
	hair::grooms[q].look.shade = 0.0;
	let kn = hr_shot();
	let l1 = hr_lum(ks[..], k1[..], k0[..], 0.0);
	let l0 = hr_lum(kn[..], k1[..], k0[..], 0.0);
	let _ = codec_png::write(path(OUT_DIR[..], "hair_side.png")[..], 1280, 720, 4, ks[..]);
	let h8 = l1 <= 0.92 * l0;
	print("gpu: hair H8 self-shadow: mean hair brightness ", r3(l1), " shadowed, ", r3(l0), " unshadowed, ratio ", r3(l1 / max(l0, 0.001)), " (bar <= 0.92)", hr_pass(h8));
	h10 && h11 && h16 && h17 && h18 && h8
}
fn ml_world(eye float3, target float3, sky bool) {
	reset_scene();
	s3d::sky = DEF_SKY; s3d::sun = DEF_SUN; s3d::look = DEF_LOOK; s3d::look.bloom = 0.0; s3d::look.ssao = false;
	s3d::ssr_on = false; s3d::ssgi_on = false; s3d::gi_on = false; s3d::temporal = 0; s3d::fog_on = false; s3d::sss_on = false;
	s3d::clouds.on = false; s3d::sun.rgb = float3 { 0.0, 0.0, 0.0 }; s3d::sun.shadows = false; envmap::on = false; s3d::sky.ambient = if sky { 0.05 } else { 0.005 }; s3d::sky.draw = sky;
	s3d::place(s3d::add(shapes::plane(45.0, shapes::material(linalg::v3(0.5, 0.5, 0.5), 0.0, 0.7))), gfx::mat4_identity);
	s3d::place(s3d::add(shapes::sphere(1.0, 32, 16, shapes::material(linalg::v3(0.7, 0.7, 0.7), 0.0, 0.4))), gfx::translate(float3 { -3.0, 1.0, 10.0 }));
	s3d::place(s3d::add(shapes::sphere(1.0, 32, 16, shapes::material(linalg::v3(0.8, 0.7, 0.3), 1.0, 0.3))), gfx::translate(float3 { 0.0, 1.0, 0.0 }));
	s3d::place(s3d::add(shapes::sphere(1.0, 32, 16, shapes::material(linalg::v3(0.7, 0.7, 0.7), 0.0, 0.8))), gfx::translate(float3 { 4.0, 1.0, -12.0 }));
	s3d::view = s3d::Camera { eye: eye, target: target, up: float3 { 0.0, 1.0, 0.0 }, fov_y: 0.9, near: 0.1, far: 200.0 };
}
fn ml_field(n int) {
	for i in n {
		let p = float3 { (i % 70) as f32 - 34.5, 0.4, (i / 70) as f32 - 34.5 };
		let c = float3 { 2.0 * (0.25 + 0.75 * ((i * 7) % 5) as f32 / 4.0), 2.0 * (0.25 + 0.75 * ((i * 3) % 8) as f32 / 7.0), 2.0 * (0.25 + 0.75 * ((i * 5) % 3) as f32 / 2.0) };
		if i % 4 == 3 { s3d::add_spot(p, float3 { p.x, 0.0, p.z }, c, 1.5, 0.9, false); } else { s3d::add_light(p, c, 1.5); }
	}
}
fn ml_crowd(n int) {
	for i in n {
		let r = 0.5 * sqrt((i as real + 0.5) / n as real);
		let a = 2.399963229728653 * i as real;
		s3d::add_light(float3 { linalg::f(r * cos(a)), 1.0, linalg::f(r * sin(a)) }, float3 { 0.004 + 0.002 * (i % 3) as f32, 0.005, 0.007 - 0.002 * (i % 2) as f32 }, 4.0);
	}
}
fn ml_frame() byte[>..] { if s3d::render_begin() { s3d::render_end(IN_OUT); } gfx::flush(); gfx::read_pixels(IN_OUT) }
fn ml_ms(n int) real { var t real[>..] = []; for _ in n { let a = gfx::time(); let _ = ml_frame(); t.push((gfx::time() - a) * 1000.0); } hr_mid(t) }
fn ml_top(a const byte[:], b const byte[:]) int, int { var top = 0; var n = 0; for i in 1280 * 720 { let d = sk_d(a, b, i); top = max(top, d); if d > 8 { n += 1; } } return top, n; }
fn ml_mean(px const byte[:]) real, real { var s = 0.0; var w = 0; for i in 1280 * 720 { s += vc_l8(px, i); if px[i * 4] == 255 && px[i * 4 + 1] == 255 && px[i * 4 + 2] == 255 { w += 1; } } return s / 921600.0, w as real / 921600.0; }
fn ml_pair() byte[>..], byte[>..], real {
	let _ = ml_frame();
	let a = ml_frame();
	s3d::test_all_lights = true;
	let t = gfx::time();
	let b = ml_frame();
	let ms = (gfx::time() - t) * 1000.0;
	s3d::test_all_lights = false;
	return a, b, ms;
}
fn lights_checks() bool {
	half_table();
	s3d::init(1280, 720);
	IN_OUT = gfx::render_target(1280, 720, gfx::RGBA8);
	let env = envmap::on;
	ml_world(float3 { 0.0, 7.0, 38.0 }, float3 { 0.0, -4.0, 10.0 }, false);
	let _ = ml_frame();
	let none = ml_ms(21);
	let dark, _ = ml_mean(ml_frame()[..]);
	ml_field(4900);
	let fa, fb, brute = ml_pair();
	let drop = clusters::dropped;
	let top = clusters::top;
	let l1 = drop == 0 && top <= 1023;
	print("gpu: lights L1 nothing dropped: ", s3d::lights.len, " lights, dropped ", drop, " (bar 0), fullest cell ", top, " (bar <= 1023)", hr_pass(l1));
	let d2, _ = ml_top(fa[..], fb[..]);
	let lit, white = ml_mean(fa[..]);
	let _ = codec_png::write(path(OUT_DIR[..], "lights_field.png")[..], 1280, 720, 4, fa[..]);
	s3d::test_cluster_range = 0.05;
	let fc = ml_frame();
	s3d::test_cluster_range = 1.0;
	let _, miss = ml_top(fc[..], fb[..]);
	let l2 = d2 <= 1 && lit >= 2.0 * dark && white < 0.25 && miss >= 1000;
	print("gpu: lights L2 right frame: largest difference ", d2, " / 255 (bar <= 1), brightness ", r3(lit), " against ", r3(dark), " with no lights (bar >= 2 times), full white ", r3(white), " of the frame (bar < 0.25); control grid at a twentieth of the range: ", miss, " pixels differ (bar >= 1000)", hr_pass(l2));
	let many = ml_ms(21);
	var tu real[>..] = [];
	for _ in 21 { let t = gfx::time(); s3d::light_upload(); tu.push((gfx::time() - t) * 1000.0); }
	let l4 = many - none <= 17.0 && hr_mid(tu) <= 4.0 && brute >= 10.0 * many;
	print("gpu: lights L4 cost: ", r3(many), " ms with the lights, ", r3(none), " ms without, lights ", r3(many - none), " ms (bar <= 17); pack and grid ", r3(hr_mid(tu)), " ms on the CPU (bar <= 4); every-light frame ", r3(brute), " ms = ", r3(brute / max(many, 0.001)), " times the grid frame (bar >= 10)", hr_pass(l4));
	ml_world(float3 { 0.0, 2.0, 5.0 }, float3 { 0.0, 0.5, 0.0 }, true);
	ml_crowd(700);
	let ca, cb, _ = ml_pair();
	let ctop = clusters::top;
	let cdrop = clusters::dropped;
	let d3, _ = ml_top(ca[..], cb[..]);
	let cm, _ = ml_mean(ca[..]);
	let _ = codec_png::write(path(OUT_DIR[..], "lights_crowd.png")[..], 1280, 720, 4, ca[..]);
	let l3 = ctop >= 700 && cdrop == 0 && d3 <= 1 && cm >= 30.0 && cm <= 220.0;
	print("gpu: lights L3 crowded cell: fullest cell ", ctop, " (bar >= 700), dropped ", cdrop, " (bar 0), largest difference ", d3, " / 255 (bar <= 1), brightness ", r3(cm), " (bar 30..220)", hr_pass(l3));
	envmap::on = env;
	gfx::release(IN_OUT);
	l1 && l2 && l3 && l4
}
fn td_world() {
	reset_scene();
	s3d::sky = DEF_SKY; s3d::sun = DEF_SUN; s3d::look = DEF_LOOK; s3d::look.bloom = 0.0; s3d::look.ssao = false;
	s3d::ssr_on = false; s3d::ssgi_on = false; s3d::gi_on = false; s3d::temporal = 0; s3d::fog_on = false; s3d::sss_on = false;
	s3d::clouds.on = false; s3d::day_bakes = 0; envmap::intensity = 1.0;
	s3d::place(s3d::add(shapes::plane(40.0, shapes::material(linalg::v3(0.5, 0.5, 0.5), 0.0, 0.8))), gfx::mat4_identity);
	s3d::place(s3d::add(shapes::sphere(0.5, 32, 16, shapes::material(linalg::v3(0.7, 0.7, 0.7), 0.0, 0.5))), gfx::translate(float3 { 0.0, 0.5, 0.0 }));
	s3d::view = s3d::Camera { eye: float3 { 0.0, 1.2, 5.0 }, target: float3 { 0.0, 0.9, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: 0.9, near: 0.1, far: 200.0 };
}
fn td_deg(y real) real {
	var lo = -90.0;
	var hi = 90.0;
	for _ in 40 { let m = (lo + hi) * 0.5; if sin(m * 0.017453292519943295) < y { lo = m; } else { hi = m; } }
	(lo + hi) * 0.5
}
fn td_draw() real {
	if s3d::render_begin() { s3d::render_end(IN_OUT); }
	gfx::flush();
	let px = gfx::read_pixels(IN_OUT);
	var s = 0.0;
	for i in 1280 * 720 { s += vc_l8(px[..], i); }
	s / 921600.0
}
fn td_at(hour f32, moon f32, name const byte[:]) real {
	let _ = s3d::time_of_day(s3d::Day { hour: hour, moon: moon, .. });
	let _ = td_draw();
	let l = td_draw();
	if name.len > 0 { let px = gfx::read_pixels(IN_OUT); let _ = codec_png::write(path(OUT_DIR[..], name)[..], 1280, 720, 4, px[..]); }
	l
}
fn td_sweep(h0 f32, n int, minutes f32, size int, clouds f32) real, real {
	var tf real[>..] = [];
	var tn real[>..] = [];
	var top = 0.0;
	var last = -1.0;
	for k in n {
		let t = gfx::time();
		let f = s3d::time_of_day(s3d::Day { hour: h0 + k as f32 * minutes / 60.0, size: size, clouds: clouds, .. });
		let l = td_draw();
		if f { tf.push((gfx::time() - t) * 1000.0); } else { tn.push((gfx::time() - t) * 1000.0); }
		if last >= 0.0 { top = max(top, abs(l - last)); }
		last = l;
	}
	return top, hr_mid(tf) - hr_mid(tn);
}
fn day_checks() bool {
	half_table();
	s3d::init(1280, 720);
	IN_OUT = gfx::render_target(1280, 720, gfx::RGBA8);
	td_world();
	let s1 = s3d::sun_at(12.0, 172, 40.0, 0.0);
	let s2 = s3d::sun_at(12.0, 80, 40.0, 0.0);
	let s3 = s3d::sun_at(6.0, 80, 40.0, 0.0);
	let s4 = s3d::sun_at(6.0, 80, 40.0, 90.0);
	let e1 = td_deg(s1.y as real);
	let e2 = td_deg(s2.y as real);
	let e3 = td_deg(s3.y as real);
	let turn = max(abs(s4.x + s3.z), max(abs(s4.y - s3.y), abs(s4.z - s3.x))) as real;
	let d1 = abs(e1 - 73.44) <= 0.2 && abs(e2 - 50.0) <= 1.0 && s3.x >= 0.99 && abs(e3) <= 1.5 && turn <= 0.001;
	print("gpu: day D1 sun position: noon day 172 ", r3(e1), " deg (bar 73.44 within 0.2), noon day 80 ", r3(e2), " deg (bar 50 within 1), 06:00 day 80 x ", r3(s3.x as real), " (bar >= 0.99) at ", r3(e3), " deg (bar within 1.5 of 0), turned north off by ", turn, " (bar <= 0.001)", hr_pass(d1));
	let noon = td_at(12.0, 0.02, "day_noon.png");
	let rn = s3d::sun.rgb;
	let l18 = td_at(18.0, 0.02, "");
	let l19 = td_at(19.0, 0.02, "day_dusk.png");
	let rd = s3d::sun.rgb;
	let l20 = td_at(20.25, 0.02, "day_twilight.png");
	let mid = td_at(0.0, 0.02, "day_night.png");
	let rm = s3d::sun.rgb;
	let em = td_deg(s3d::sun.to_sun.y as real);
	let dark = td_at(0.0, 0.0, "");
	let d2 = l18 < noon && l20 < l18 && mid >= 0.02 * noon && mid <= 0.35 * noon && dark <= 0.2 * mid;
	print("gpu: day D2 clock: 12:00 ", r3(noon), ", 18:00 ", r3(l18), ", 19:00 ", r3(l19), ", 20:15 ", r3(l20), " (bar each lower), 00:00 ", r3(mid), " = ", r3(mid / noon), " of noon (bar 0.02..0.35), no moon ", r3(dark), " = ", r3(dark / max(mid, 0.001)), " of moonlit (bar <= 0.2)", hr_pass(d2));
	let warm = (rd.x / max(rd.z, 1e-9)) as real / (rn.x / max(rn.z, 1e-9)) as real;
	let d3 = warm >= 2.0;
	print("gpu: day D3 dusk: red over blue ", r3(warm), " times noon's (bar >= 2)", hr_pass(d3));
	let ml = ((rm.x + rm.y + rm.z) / max(rn.x + rn.y + rn.z, 1e-9)) as real;
	let d4 = em > 10.0 && ml > 0.0 && ml <= 0.05;
	print("gpu: day D4 moon: elevation ", r3(em), " deg (bar > 10), light ", ml, " of noon's (bar > 0, <= 0.05)", hr_pass(d4));
	s3d::day_bakes = 0;
	let b0 = s3d::time_of_day(s3d::Day { hour: 15.0, .. });
	let b1 = s3d::time_of_day(s3d::Day { hour: 15.0, .. });
	let v0 = s3d::sun.to_sun;
	let b2 = s3d::time_of_day(s3d::Day { hour: 15.0 + 1.0 / 60.0, .. });
	let v1 = s3d::sun.to_sun;
	let b3 = s3d::time_of_day(s3d::Day { hour: 15.0 + 10.0 / 60.0, .. });
	let moved = v0.x != v1.x || v0.y != v1.y || v0.z != v1.z;
	let d5 = b0 && !b1 && !b2 && moved && b3 && s3d::day_bakes == 2;
	print("gpu: day D5 bakes: first ", b0, ", same time ", b1, ", 1 minute later ", b2, " with the sun moved ", moved, ", 10 minutes later ", b3, ", bakes ", s3d::day_bakes, " (bar true, false, false, true, true, 2)", hr_pass(d5));
	let top, cost = td_sweep(18.0, 301, 1.0, 0, 0.3);
	var lo = 19.0;
	var hi = 24.0;
	for _ in 40 { let m = (lo + hi) * 0.5; if s3d::sun_at(linalg::f(m), 172, 40.0, 0.0).y > -0.12187 { lo = m; } else { hi = m; } }
	let before = td_at(linalg::f(lo - 1.0 / 60.0), 0.02, "");
	let after = td_at(linalg::f(lo + 1.0 / 60.0), 0.02, "");
	let d6 = top <= 7.0 && abs(after - before) <= 3.0;
	print("gpu: day D6 no jump: largest step ", r3(top), " (bar <= 7), moon takes over at ", r3(lo), " h: ", r3(before), " before, ", r3(after), " after (bar within 3)", hr_pass(d6));
	let _, small = td_sweep(12.0, 85, 1.0, 128, 0.3);
	let d7 = cost <= 70.0 && small <= 14.0;
	print("gpu: day D7 cost: bake ", r3(cost), " ms at 512 (bar <= 70), ", r3(small), " ms at 128 (bar <= 14)", hr_pass(d7));
	gfx::release(IN_OUT);
	d1 && d2 && d3 && d4 && d5 && d6 && d7
}
fn hair_checks() bool {
	half_table();
	s3d::init(1280, 720);
	IN_OUT = gfx::render_target(1280, 720, gfx::RGBA8);
	let a = hr_cpu();
	let b = hr_look();
	let c = hr_sim();
	let d = hr_more();
	for g in hair::grooms.len { hair::unload(g); }
	print("gpu: hair verdict: data ", a, ", look ", b, ", motion ", c, ", scenes ", d);
	a && b && c && d
}
fn mark(name const byte[:], ok bool) bool {
	if SUB_LOG.len == 0 { return ok; }
	let n, top, slow, _ = sub_since(SUB_AT);
	print("gpu: submits ", name, ": ", n - SUB_AT, ", longest ", r2(top), " ms, ", slow, " above 100 ms");
	SUB_AT = n;
	ok
}
fn submit_checks(full bool) bool {
	if SUB_LOG.len == 0 { print("gpu: submit length not measured (run under tools/hc/gputime)"); return !full; }
	let n, top, slow, _ = sub_since(0);
	let fake = path(OUT_DIR[..], "gputime_control.log");
	var ctl real[>..] = [];
	if write_file(fake[..], "submit 1 2000000\nsubmit 1 900000000\nsubmit 3 4000000\n") { gputime_lines(fake[..], ctl); }
	var ctop = 0.0;
	for v in ctl { ctop = max(ctop, v / 1.0e6); }
	let b1 = n > 0 && top <= SUB_BAR_MS && ctop > SUB_BAR_MS;
	print("gpu: submit length B1: ", n, " submits, longest ", r2(top), " ms (bar <= ", SUB_BAR_MS, " ms), ", slow, " above 100 ms; control (a log holding one 900 ms submit) reads ", r2(ctop), " ms and must fail the bar: ", if b1 { "PASS" } else { "FAIL" });
	sphere_grid();
	s3d::init(1280, 720);
	let out = gfx::render_target(1280, 720, gfx::RGBA8);
	shoot(4, out);
	let a, ta, sa, _ = sub_since(0);
	for k in 12 { s3d::render(out); }
	let b, one, sb, _ = sub_since(a);
	shoot(12, out);
	let c, top1, sc, each = sub_since(b);
	gfx::release(out);
	reset_scene();
	s3d::look = DEF_LOOK; s3d::sun = DEF_SUN; s3d::sky = DEF_SKY;
	let b2 = b - a == 1 && c - b >= 12 && one >= 4.0 * each;
	print("gpu: submit length B2 control: 12 frames in one command buffer read as ", b - a, " submit(s), longest ", r3(one), " ms; flushed one by one ", c - b, " submits, median ", r3(each), " ms, longest ", r3(top1), " ms (bar: one submit, at least 4 times the median single frame): ", if b2 { "PASS" } else { "FAIL" });
	b1 && b2
}
fn gpu_checks(dir const byte[:], golden const byte[:]) bool {
	var good = true;
	// GFX_MAKE_GOLDEN: unset or 0 runs the checks, 1 writes both goldens and stops
	var mg byte[>..] = [];
	if env("GFX_MAKE_GOLDEN", mg) && mg.len > 0 {
		if mg.len != 1 || (mg[0] != 48 && mg[0] != 49) { print("gpu: FAILED: GFX_MAKE_GOLDEN must be 0 or 1, got ", mg[..]); return false; }
		if mg[0] == 49 { return make_goldens(); }
	}
	let _ = env("HELIUM_GPUTIME", SUB_LOG);
	var only byte[>..] = [];
	let _ = env("GFX_ONLY", only);
	if only.len > 0 {
		let ok = if only[..] == "lights" { lights_checks() } else if only[..] == "day" { day_checks() } else if only[..] == "hair" { hair_checks() } else if only[..] == "gtao" { gtao_checks() } else if only[..] == "gi" { gi_checks() } else if only[..] == "mblur" { mb_checks() } else if only[..] == "dof" { dof_checks() } else if only[..] == "fx" { fx_checks() } else if only[..] == "tsr" { tsr_checks(dir) } else if only[..] == "probe" { probe_checks(dir) } else if only[..] == "ssgi" { ssgi_checks() } else if only[..] == "decal" { decal_checks() } else if only[..] == "weather" { weather_checks() } else if only[..] == "rect" { rect_checks() } else if only[..] == "small" { small_checks() } else if only[..] == "inst" { instance_checks() } else if only[..] == "caust" { caustic_checks() } else if only[..] == "tex" { texture_checks() } else if only[..] == "stream" { stream_checks() } else if only[..] == "rtr" { rtr_checks() } else if only[..] == "meshlet" { meshlet_checks() } else if only[..] == "sss" { sss_checks() } else if only[..] == "cloth" { cloth_checks() } else if only[..] == "cloud" { cloud_checks() } else if only[..] == "vfog" { fog_checks() } else if only[..] == "sea" { sea_checks() } else if only[..] == "vsm" { vsm_checks() } else { shadow_checks() };
		let e = gfx::error();
		if e.len > 0 { print("gpu: gfx error ", e[..]); return false; }
		return mark(only[..], ok) && submit_checks(false);
	}
	if !mark("furnace", furnace(FURNACE_K)) { good = false; }

	sphere_grid();
	s3d::init(480, 360);
	let out = gfx::render_target(480, 360, gfx::RGBA8);
	s3d::render(out);
	let got = gfx::read_pixels(out);
	let sp = path(dir, "spheres.png");
	print("gpu: spheres png ", sp[..], " ", gfx::save_png(out, sp[..]));
	// the golden is required: a missing, unreadable or wrong-sized golden is a failure
	if GOLDEN.len == 0 {
		print("gpu: spheres FAILED: no golden given (expected hc/test/gfx/golden/spheres.png)");
		good = false;
	} else {
		var want byte[>..] = [];
		var ref byte[>..] = [];
		let readable = read_file(GOLDEN[..], want);
		let gw, gh, gok = codec_png::decode(want[..], ref);
		if !readable || !gok || gw != 480 || gh != 360 {
			print("gpu: spheres FAILED: golden ", GOLDEN[..], " unreadable or not a 480x360 PNG");
			good = false;
		} else {
			let db = psnr(got[..], ref[..]);
			print("gpu: spheres psnr ", round(db * 100.0) / 100.0, " dB vs golden (bar > 40 dB) ", if db > 40.0 { "PASS" } else { "FAIL" });
			if db <= 40.0 { good = false; }
		}
	}
	gfx::release(out);

	// the shipped look on the same grid (shadows, SSAO and bloom on)
	sphere_grid();
	shipped_look();
	s3d::init(480, 360);
	let dout = gfx::render_target(480, 360, gfx::RGBA8);
	s3d::render(dout);
	let dgot = gfx::read_pixels(dout);
	let dsp = path(dir, "spheres_default.png");
	print("gpu: default png ", dsp[..], " ", gfx::save_png(dout, dsp[..]));
	gfx::release(dout);
	let ddb = golden_psnr(dgot[..], GOLDEN_DEF[..]);
	if ddb < 0.0 {
		print("gpu: default FAILED: golden ", GOLDEN_DEF[..], " missing, unreadable or not a 480x360 PNG (expected hc/test/gfx/golden/spheres_default.png)");
		good = false;
	} else {
		print("gpu: default spheres (shipped look: shadows, ssao, bloom on) psnr ", r2(ddb), " dB vs golden (bar > 40 dB) ", if ddb > 40.0 { "PASS" } else { "FAIL" });
		if ddb <= 40.0 { good = false; }
		let cdb = golden_psnr(got[..], GOLDEN_DEF[..]);
		print("gpu: default control (effects-off image vs the shipped-look golden) psnr ", r2(cdb), " dB must fail the 40 dB bar: ", if cdb <= 40.0 { "PASS" } else { "FAIL" });
		if cdb > 40.0 { good = false; }
	}
	let dmean, dlo, dhi = luma_stats(dgot[..]);
	print("gpu: default spheres luma mean ", dmean, " range ", dlo, "..", dhi);
	if dmean < 30 || dmean > 225 || dhi - dlo < 120 { good = false; }
	sphere_grid();
	s3d::init(480, 360);

	// timing at 720p on the same scene: 30 warmup frames, then 200 timed frames, each
	// render + submit + fence wait with no readback. Wall clock per frame always; GPU time
	// per frame from timestamp queries when run under the gputime layer (HELIUM_GPUTIME).
	s3d::init(1280, 720);
	let big = gfx::render_target(1280, 720, gfx::RGBA8);
	s3d::render(big);
	let _ = gfx::read_pixels(big);
	for k in TIME_WARMUP { s3d::render(big); gfx::flush(); }
	var log byte[>..] = [];
	let have_log = env("HELIUM_GPUTIME", log) && log.len > 0;
	var gpu_ns real[>..] = [];
	if have_log { gputime_lines(log[..], gpu_ns); }
	let first = gpu_ns.len;
	var wall real[>..] = [];
	for k in TIME_FRAMES {
		let t = gfx::time();
		s3d::render(big);
		gfx::flush();
		wall.push((gfx::time() - t) * 1000.0);
	}
	print("gpu: timing 1280x720 sphere grid (", s3d::batch.len, " draws, 4x msaa; shadows, ssao and bloom off as in the baseline): ", TIME_WARMUP, " warmup + ", TIME_FRAMES, " timed frames, each render + submit + fence wait, no readback");
	print("gpu: timing wall-clock ms/frame ", stats(wall)[..]);
	if have_log {
		gputime_lines(log[..], gpu_ns);
		let n = gpu_ns.len - first;
		if n > 0 && n % TIME_FRAMES == 0 {
			let per = n / TIME_FRAMES;
			var frame real[>..] = [];
			for f in TIME_FRAMES {
				var t = 0.0;
				for j in per { t += gpu_ns[first + f * per + j]; }
				frame.push(t / 1.0e6);
			}
			print("gpu: timing gpu-timestamp ms/frame ", stats(frame)[..], " (", per, " submit(s) per frame, top-of-pipe to bottom-of-pipe)");
		} else {
			print("gpu: timing gpu-timestamp: ", n, " submits for ", TIME_FRAMES, " frames, cannot split per frame");
			good = false;
		}
	} else {
		print("gpu: timing gpu-timestamp: not measured (run under tools/hc/gputime, see tools/hc/gfxtest.sh)");
	}
	// the same scene and size with the shipped look: what an application gets by default
	shipped_look();
	frame_time("default", "1280x720 sphere grid, shipped look (shadows 3x2048^2, ssao 16, bloom on), taa off", big);
	s3d::temporal = 1;
	s3d::temporal_reset = true;
	frame_time("default", "1280x720 sphere grid, shipped look, taa on", big);
	s3d::temporal = 0;
	s3d::temporal_reset = true;
	gfx::release(big);

	// a full frame with every feature, in the shipped look and sun
	reset_scene();
	s3d::look = DEF_LOOK;
	s3d::sun = DEF_SUN;
	s3d::sky = DEF_SKY;
	s3d::temporal = 0;
	print("gpu: frame look: shadows ", s3d::sun.shadows, ", ssao ", s3d::look.ssao, ", bloom ", r2(s3d::look.bloom as real), " (scene3d defaults)");
	let a = gltf::load_bytes(embed_file("fixtures/scene.glb"), "");
	let floor = shapes::plane(6.0, shapes::material(linalg::v3(0.5, 0.52, 0.55), 0.0, 0.7));
	s3d::add(floor);
	let it = s3d::add(a);
	s3d::place(it, gfx::translate(float3 { 0.0, 0.6, 0.0 }));
	s3d::animate(it, gltf::find_animation(a, "wave"), 0.7);
	let ball = shapes::sphere(0.5, 32, 16, shapes::material(linalg::v3(0.95, 0.95, 0.95), 1.0, 0.25));
	s3d::place(s3d::add(ball), gfx::translate(float3 { 1.6, 0.5, 0.4 }));
	s3d::add_light(float3 { -1.5, 1.2, 1.0 }, float3 { 6.0, 2.0, 0.8 }, 6.0);
	s3d::view = s3d::Camera { eye: float3 { 2.5, 2.2, 5.0 }, target: float3 { 0.0, 0.6, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: 0.9, near: 0.1, far: 60.0 };
	s3d::init(640, 360);
	sparks::init(512);
	sparks::ground = 0.0;
	sparks::burst(float3 { 1.6, 1.1, 0.4 }, float3 { 0.0, 1.0, 0.0 }, 300, 3.0, 0.6, 1.5, float4 { 4.0, 2.2, 0.8, 1.0 }, 0.05, 7);
	sparks::step(0.0);
	for k in 8 { sparks::step(0.03); }
	let frame = gfx::render_target(640, 360, gfx::RGBA8);
	s3d::render(frame);
	var text TextVtx[>..] = [];
	sdf_text(text, 16.0, 16.0, 28.0, "helium gfx", [255, 255, 255, 255], 1, true);
	sdf_draw(frame, 640, 360, text);
	let px = gfx::read_pixels(frame);
	let frp = path(dir, "frame.png");
	print("gpu: frame png ", frp[..], " ", gfx::save_png(frame, frp[..]));
	let mean, lo, hi = luma_stats(px[..]);
	print("gpu: frame mean ", mean, " range ", lo, "..", hi);
	if mean < 30 || mean > 225 || hi - lo < 120 { good = false; }
	gfx::release(frame);
	let _ = mark("goldens, timing, frame", true);
	if !mark("motion", motion_checks()) { good = false; }
	if !mark("taa", taa_checks(dir)) { good = false; }
	if !mark("tsr", tsr_checks(dir)) { good = false; }
	if !mark("shadow", shadow_checks()) { good = false; }
	if !mark("vsm", vsm_checks()) { good = false; }
	if !mark("look_taa", look_taa_checks(dir)) { good = false; }
	if !mark("ghost", ghost_checks()) { good = false; }
	if !mark("t8_still", t8_still()) { good = false; }
	if !mark("s5_inflight", s5_inflight()) { good = false; }
	if !mark("s6_layers", s6_layers()) { good = false; }
	if !mark("gtao", gtao_checks()) { good = false; }
	if !mark("gi", gi_checks()) { good = false; }
	if !mark("mb", mb_checks()) { good = false; }
	if !mark("dof", dof_checks()) { good = false; }
	if !mark("fx", fx_checks()) { good = false; }
	if !mark("probe", probe_checks(dir)) { good = false; }
	if !mark("ssgi", ssgi_checks()) { good = false; }
	if !mark("decal", decal_checks()) { good = false; }
	if !mark("weather", weather_checks()) { good = false; }
	if !mark("rect", rect_checks()) { good = false; }
	if !mark("small", small_checks()) { good = false; }
	if !mark("instance", instance_checks()) { good = false; }
	if !mark("caustic", caustic_checks()) { good = false; }
	if !mark("texture", texture_checks()) { good = false; }
	if !mark("stream", stream_checks()) { good = false; }
	if !mark("rtr", rtr_checks()) { good = false; }
	if !mark("meshlet", meshlet_checks()) { good = false; }
	if !mark("sss", sss_checks()) { good = false; }
	if !mark("cloth", cloth_checks()) { good = false; }
	if !mark("hair", hair_checks()) { good = false; }
	if !mark("cloud", cloud_checks()) { good = false; }
	if !mark("vfog", fog_checks()) { good = false; }
	if !mark("sea", sea_checks()) { good = false; }
	if !mark("day", day_checks()) { good = false; }
	if !mark("lights", lights_checks()) { good = false; }
	if !submit_checks(true) { good = false; }
	let err = gfx::error();
	if err.len > 0 { print("gpu: gfx error ", err[..]); good = false; }
	good
}

fn main() {
	cpu_checks();
	// read argv straight into owned buffers (os.args() hands back slices of freed buffers)
	let argc = arg_count();
	if argc < 2 { return; }
	OUT_DIR.clear();
	arg(1, OUT_DIR);
	var kv byte[>..] = [];
	if env("FURNACE_K", kv) && kv.len > 0 { var k = 0; for c in kv { if c >= 48 && c <= 57 { k = k * 10 + (c as int - 48); } } if k > 0 { FURNACE_K = k; } }
	GOLDEN.clear();
	if argc > 2 { arg(2, GOLDEN); }
	GOLDEN_DEF.clear();
	if argc > 3 { arg(3, GOLDEN_DEF); }
	DEF_LOOK = s3d::look;
	DEF_SUN = s3d::sun;
	DEF_SKY = s3d::sky;
	print("gpu: out dir ", OUT_DIR[..]);
	if !gfx::open_headless(64, 64) { print("gpu: skipped (no device: ", gfx::error()[..], ")"); return; }
	let t0 = gfx::time();
	let good = gpu_checks(OUT_DIR[..], GOLDEN[..]);
	print(if good { "gpu: ok" } else { "gpu: FAILED" }, " (", round((gfx::time() - t0) * 10.0) / 10.0, " s, ", gfx::driver()[..], ")");
	gfx::close();
}
