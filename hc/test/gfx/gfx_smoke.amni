}
fn sk_apart(a const byte[:], b const byte[:]) int { var top = 0; for i in a.len { let d = a[i] as int - b[i] as int; top = if i % 4 == 3 { top } else { max(top, max(d, -d)) }; } top }
fn sk_pair() int { s3d::sss_on = false; let off = rr_frame(2); s3d::sss_on = true; let on = rr_frame(2); sk_apart(on[..], off[..]) }
fn sk_x45() bool {
