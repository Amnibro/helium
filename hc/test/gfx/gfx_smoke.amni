	TX_BC = tx_shot(true, true, false, "");
	let small = s3d::texture_bytes();
	let p = psnr(TX_REF[..], TX_BC[..]);
	let gray = tx_shot(false, true, true, "");
	let pc = psnr(TX_REF[..], gray[..]);
	let ratio = small as real / max(raw, 1) as real;
	let a = p >= 40.0 && ratio <= 0.26 && pc < 40.0;
	print("gpu: textures T4 scene: 1280 x 720 with image M compressed on load against uncompressed ", r2(p), " dB (bar 40), texture memory ", small, " of ", raw, " bytes = ", r3(ratio), " (bar 0.26), control with flat gray textures ", r2(pc), " dB", if pc < 40.0 { ", fails as it must" } else { " FAILED to fail" }, if a { "" } else { " FAILED" });
	let cpu = tx_shot(true, false, false, "");
	let w = tx_worst(TX_BC[..], cpu[..], 15);
	let b = w <= 2 && s3d::texture_bytes() == raw;
	print("gpu: textures T5 no BC on the device: blocks decoded on the CPU against the GPU's own decode, largest difference ", w, " / 255 (bar 2), texture memory back to ", s3d::texture_bytes(), " bytes", if b { "" } else { " FAILED" });
	a && b
}
fn tx_t6() bool {
	var dir byte[>..] = [];
	dir.append(OUT_DIR[..]);
	dir.append("/texcache");
	tx_scene(true, true, false, dir[..], 1280, 720);
	var pc byte[>..] = [];
	var pn byte[>..] = [];
	s3d::tex_path(0, true, pc);
	s3d::tex_path(1, false, pn);
	let _ = delete_file(pc[..]);
	let _ = delete_file(pn[..]);
	gfx::release(IN_OUT);
	var e0 = s3d::tex_encoded;
	var c0 = s3d::tex_cached;
	s3d::tex_ns = 0;
	let first = tx_shot(true, true, false, dir[..]);
	let t1 = s3d::tex_ns as real / 1.0e6;
	let enc1 = s3d::tex_encoded - e0;
	let files = (if file_exists(pc[..]) { 1 } else { 0 }) + (if file_exists(pn[..]) { 1 } else { 0 });
	e0 = s3d::tex_encoded; c0 = s3d::tex_cached; s3d::tex_ns = 0;
	let second = tx_shot(true, true, false, dir[..]);
	let t2 = s3d::tex_ns as real / 1.0e6;
	let enc2 = s3d::tex_encoded - e0;
	let hit2 = s3d::tex_cached - c0;
	let d2 = tx_worst(first[..], second[..], 15);
	var whole byte[>..] = [];
	let got = read_file(pn[..], whole);
	let cut = got && write_file(pn[..], whole[..whole.len / 2]);
	e0 = s3d::tex_encoded; c0 = s3d::tex_cached;
	let third = tx_shot(true, true, false, dir[..]);
	let enc3 = s3d::tex_encoded - e0;
	let hit3 = s3d::tex_cached - c0;
	let d3 = tx_worst(first[..], third[..], 15);
	let d0 = tx_worst(first[..], TX_BC[..], 15);
	let ok = enc1 == 2 && files == 2 && enc2 == 0 && hit2 == 2 && d2 == 0 && t1 >= 5.0 * t2 && cut && enc3 == 1 && hit3 == 1 && d3 == 0 && d0 == 0;
	print("gpu: textures T6 cache: first load encoded ", enc1, " textures and wrote ", files, " files in ", r2(t1), " ms; second load encoded ", enc2, ", read ", hit2, " from the cache in ", r2(t2), " ms (", r2(t1 / max(t2, 0.001)), " times faster, bar 5), picture difference ", d2, " (bar 0), against no cache ", d0, "; control with one file cut short: encoded ", enc3, " (want 1), read ", hit3, ", difference ", d3, if ok { "" } else { " FAILED" });
	ok
}
fn tx_gltf(image const byte[:]) byte[>..] {
