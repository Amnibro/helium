	let a0, b0 = sk_qs(0.05, sk_skin(0.02, 0.4, 0.0, 0.0), 1.0, 183, 0, false);
	let c1, g1 = sk_qs(1.2, sk_skin(0.02, 0.4, 0.7, 0.0), 1.0, 8, 0, false);
	let c0, g0 = sk_qs(1.2, sk_skin(0.02, 0.4, 0.0, 0.0), 1.0, 8, 0, false);
