	let edge = gi_half(plain[..], 8, 461409, 0) as real <= 0.001 * mid && gi_half(plain[..], 8, 461410, 0) as real >= 0.5 * mid;
	let ok = edge && top <= 0.02 && mean > 0.1;
	print("gpu: sss X3 card from pixel 610 ", edge, ", wall pixels 600 to 609 on 41 rows: largest ", r4(top), " of the card's middle (bar <= 0.02); control depth off: mean ", r4(mean), " (bar > 0.1)", if ok { " PASS" } else { " FAIL" });
	ok
}
fn sk_ball(glow f32, at float3) {
