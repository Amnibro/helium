}
fn sk_stat(px const byte[:], half int, blk int) real, real {
	let bk = if blk > 0 { blk } else { half * 2 };
	let nb = half * 2 / bk;
	var s = 0.0;
	var dv = 0.0;
	for by in nb { for bx in nb {
		var bs = 0.0;
		var bq = 0.0;
		var gx = 0.0;
		var gy = 0.0;
		for y in bk { for x in bk { let v = gi_half(px, 8, (360 - half + by * bk + y) * 1280 + 640 - half + bx * bk + x, 0) as real; bs += v; bq += v * v; gx += v * (x as real - (bk - 1) as real / 2.0); gy += v * (y as real - (bk - 1) as real / 2.0); } }
		s += bs;
		let tilt = if blk > 0 { (gx * gx + gy * gy) * 12.0 / (bk * bk * (bk * bk - 1)) as real } else { 0.0 };
		dv += bq - bs * bs / (bk * bk) as real - tilt;
	} }
	let n = (nb * nb * bk * bk) as real;
	let m = s / n;
	return m, sqrt(max(dv / n, 0.0)) / max(m, 1e-12);
}
fn sk_qs(dist real, m gltf::Material, gain f32, half int, blk int, plain bool) real, real {
	sk_q(dist, m, gain);
	shoot(2, IN_OUT);
	let px = gfx::read_pixels(if plain { s3d::sss_plain() } else { s3d::hdr_target() });
	let m, d = sk_stat(px[..], half, blk);
	return m, d;
}
fn sk_y14() bool {
