	s3d::sss_on = true;
	let p1, q1 = sk_qs(0.05, sk_skin(0.02, 0.4, 0.7, 0.0), 1.0, 200, 0, true);
	let p0, q0 = sk_qs(0.05, sk_skin(0.02, 0.4, 0.0, 0.0), 1.0, 200, 0, true);
	let pd, qd = sk_qs(0.05, sk_skin(0.02, 0.4, 0.7, 0.0), 0.95, 200, 0, true);
	let y2 = abs(p1 / p0 - 1.0) <= 0.01 && abs(pd / p0 - 1.0) > 0.01;
	print("gpu: sss Y2 near, plain light, pores 0.7 over pores 0: ", r4(p1 / p0), " (bar within 0.01 of 1); control light 5% dimmer ", r4(pd / p0), if y2 { " PASS" } else { " FAIL" });
	y1 && y2 && y3 && y4
}
fn sk_d(a const byte[:], b const byte[:], i int) int { var top = 0; for c in 3 { let d = a[i * 4 + c] as int - b[i * 4 + c] as int; top = max(top, max(d, -d)); } top }
fn sk_up(a const byte[:], b const byte[:], i int) int { var s = 0; for c in 3 { s += a[i * 4 + c] as int - b[i * 4 + c] as int; } s }
fn sk_y5() bool {
	s3d::sss_on = false;
