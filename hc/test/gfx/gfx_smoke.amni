	s3d::view = s3d::Camera { eye: float3 { 0.0, 1.0, 3.0 }, target: float3 { 0.0, 1.0, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: 0.8, near: 0.05, far: 80.0 };
	s3d::init(640, 360);
	let out = gfx::render_target(640, 360, gfx::RGBA8);
	s3d::render(out);
	let px = gfx::read_pixels(out);
