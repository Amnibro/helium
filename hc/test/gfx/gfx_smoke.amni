			}
		}
	}
	let ok = same == 6 && zsame == 6 && refused == tried && ctl;
	print("gpu: textures T3 KTX2: ", same, " of 6 formats read back identical with 7 levels, ", zsame, " of 6 as zlib streams, ", refused, " of ", tried, " damaged files refused (cut short, wrong first byte, level count 0 and 99, level past the end, BasisLZ, Zstandard, a changed zlib byte), untouched files read ", if ctl { "yes" } else { "NO" }, if ok { "" } else { " FAILED" });
	ok
}
fn tx_scene(compress bool, gpu bool, gray bool, cache const byte[:], w int, h int) {
	reset_scene();
	dark_scene();
	s3d::sky = DEF_SKY; s3d::sun = DEF_SUN; s3d::sun.shadows = false;
	s3d::tex_compress = compress; s3d::tex_gpu_bc = gpu; s3d::set_texture_cache(cache);
	var flat byte[>..] = [];
	var up byte[>..] = [];
	if gray { for k in 1024 * 1024 { flat.push(128); flat.push(128); flat.push(128); flat.push(255); up.push(128); up.push(128); up.push(255); up.push(255); } }
	var m = shapes::material(linalg::v3(1.0, 1.0, 1.0), 0.0, 0.6);
	m.base_tex = gltf::TexRef { texture: gltf::add_texture_rgba(if gray { flat[..] } else { TX_C[..] }, 1024, 1024, 10497), uv: 0, m: float4 { 2.0, 0.0, 0.0, 2.0 }, .. };
	m.normal_tex = gltf::TexRef { texture: gltf::add_texture_rgba(if gray { up[..] } else { TX_N[..] }, 1024, 1024, 10497), uv: 0, m: float4 { 2.0, 0.0, 0.0, 2.0 }, .. };
	s3d::place(s3d::add(shapes::plane(7.0, m)), gfx::mat4_identity);
	s3d::place(s3d::add(shapes::cube(float3 { 0.7, 0.7, 0.7 }, m)), gfx::translate(float3 { -1.3, 0.7, 0.0 }));
	s3d::place(s3d::add(shapes::sphere(0.8, 48, 24, m)), gfx::translate(float3 { 1.3, 0.8, 0.3 }));
	s3d::view = s3d::Camera { eye: float3 { 0.0, 2.2, 4.5 }, target: float3 { 0.0, 0.6, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: 0.8, near: 0.05, far: 80.0 };
	s3d::init(w, h);
	IN_OUT = gfx::render_target(w, h, gfx::RGBA8);
}
fn tx_shot(compress bool, gpu bool, gray bool, cache const byte[:]) byte[>..] {
	tx_scene(compress, gpu, gray, cache, 1280, 720);
	s3d::render(IN_OUT);
