// gfx_smoke: end-to-end checks for hc/lib/gfx (run by tools/hc/gfxtest.sh).
//
// No arguments: CPU checks only, deterministic output compared with gfx_smoke.out
//   (math, inflate + PNG + JPEG decoding, the glTF loader, animation sampling,
//   procedural shapes, SDF text layout).
// With an output directory: also renders headless and prints "gpu: ..." lines:
//   furnace  - white roughness x metal sphere grid lit by a sun swept over the sphere of
//              directions: per-material directional albedo (should be 1), compensated
//              and four controls that must fail (single scatter, wrong F, legacy diffuse
//              weight, x0.9), the same on flat tiles seen at n.v 0.35 .. 0.05 (grazing),
//              and the ambient pass-through (fp16) check
//   spheres  - 5x5 metal/roughness grid, saved as spheres.png and compared with the
//              golden given as the second argument; PSNR must be > 40 dB, and a
//              missing golden fails
//   frame    - floor, skinned + morphed glTF, point light, particles and text,
//              saved as frame.png and checked for light and contrast
//   timing   - 1280x720 sphere grid, 30 warmup + 200 frames without readback: wall-clock
//              and (under tools/hc/gputime) GPU-timestamp min / median / p95 ms
import os;
import gfx;
import math;
import gfx.linalg;
import gfx.zlib;
import gfx.codec_png;
import gfx.codec_jpeg;
import gfx.gltf;
import gfx.motion;
import gfx.shapes;
import gfx.sparks;
import gfx.scene3d;
import gfx.sdf_font;

fn milli(v f32) int { round((v * 1000.0) as real) as int }

fn checksum(b const byte[:]) int {
	var s = 0;
	for k in b.len { s = (s * 31 + b[k] as int) % 1000000007; }
	s
}

fn cpu_checks() {
	// math
	let q = linalg::qaxis(linalg::v3(0.0, 1.0, 0.0), 1.5707963);
	let p = linalg::qrotate(q, linalg::v3(1.0, 0.0, 0.0));
	print("qrotate ", milli(p.x), " ", milli(p.y), " ", milli(p.z));
	let half_turn = linalg::qslerp(linalg::quat_identity(), q, 0.5);
	print("qslerp w ", milli(half_turn.w));
	let m = linalg::compose(linalg::v3(1.0, 2.0, 3.0), q, linalg::v3(2.0, 2.0, 2.0));
	print("inverse ok ", linalg::near_equal(gfx::mul(m, linalg::inverse(m)), gfx::mat4_identity, 0.0001));

	// codecs
	var png byte[>..] = [];
	let w, h, ok = codec_png::decode(embed_file("fixtures/palette.png"), png);
	print("png ", w, "x", h, " ", ok, " sum ", checksum(png[..]));
	var jpg byte[>..] = [];
	let jw, jh, jok = codec_jpeg::decode(embed_file("fixtures/photo420.jpg"), jpg);
	print("jpeg ", jw, "x", jh, " ", jok, " sum ", checksum(jpg[..]));
	var raw byte[>..] = [];
	print("inflate stored ", zlib::inflate([0x78 as byte, 0x01, 0x01, 0x03, 0x00, 0xFC, 0xFF, 0x61, 0x62, 0x63, 0x02, 0x4D, 0x01, 0x27], raw), " ", raw[..]);

	// glTF
	let a = gltf::load_bytes(embed_file("fixtures/scene.glb"), "");
	if a < 0 { print("gltf FAIL ", gltf::error()); return; }
	let s = gltf::assets[a];
	print("gltf meshes ", s.meshes.count, " nodes ", s.nodes.count, " roots ", s.roots.count, " materials ", s.materials.count, " images ", s.images.count, " skins ", s.skins.count, " animations ", s.animations.count, " skipped ", gltf::skipped());
	for pr in gltf::prims { print("  prim verts ", pr.vcount, " indices ", pr.icount, " targets ", pr.targets, " skinned ", pr.skinned, " tangents ", pr.tangents); }
	for mt in gltf::materials { print("  material ", gltf::text_of(mt.name), " mode ", mt.alpha_mode, " metal ", milli(mt.metallic), " rough ", milli(mt.roughness), " emissive ", milli(mt.emissive.x), " ", milli(mt.emissive.y), " two-sided ", mt.double_sided); }
	let im = gltf::images[0];
	print("  image ", im.width, "x", im.height, " sum ", checksum(gltf::pixels[im.pixels.first..im.pixels.first + im.pixels.count]));

	// animation
	let anim = gltf::find_animation(a, "wave");
	motion::rest(a);
	motion::apply(anim, 1.0, 1.0);
	motion::update(a, gfx::mat4_identity);
	let bone = gltf::find_node(a, "bone");
	let r = motion::pose_r[bone];
	print("anim rotation ", milli(r.x), " ", milli(r.y), " ", milli(r.z), " ", milli(r.w), " weight ", milli(motion::weight(gltf::find_node(a, "strip"), 0)));
	var pal gfx::mat4[>..] = [];
	motion::joints(0, pal);
	let moved = linalg::point(pal[1], linalg::v3(0.0, 2.0, 0.0));
	print("anim joint ", milli(moved.x), " ", milli(moved.y), " ", milli(moved.z));

	// shapes
	let before = gltf::indices.len;
	let ball = shapes::sphere(1.0, 16, 8, shapes::material(linalg::v3(1.0, 1.0, 1.0), 0.0, 0.5));
	print("sphere asset ", ball - a, " indices ", gltf::indices.len - before, " verts ", gltf::prims[gltf::prims.len - 1].vcount);

	// text layout
	var vs TextVtx[>..] = [];
	sdf_text(vs, 10.0, 20.0, 24.0, "Helium", [255, 255, 255, 255], 0, false);
	print("text width ", round((sdf_text_w("Helium", 24.0) * 100.0) as real) as int, " verts ", vs.len);
	gltf::reset();
}

fn half_to_f32(lo byte, hi byte) f32 {
	let h = (lo as int) | ((hi as int) << 8);
	let e = (h >> 10) & 31;
	let m = h & 1023;
	let sign f32 = if (h & 0x8000) != 0 { -1.0 } else { 1.0 };
	if e == 0 { return sign * (m as f32) / 16777216.0; }
	if e == 31 { return sign * 65504.0; }
	sign * linalg::f(pow(2.0, (e - 15) as real)) * (1.0 + m as f32 / 1024.0)
}

fn reset_scene() {
	s3d::items.clear();
	s3d::lights.clear();
	gltf::reset();
	s3d::forget();
}

// ---- furnace: energy of the GGX BRDF in a uniform white environment
//
// 11 roughness values (0, 0.1 .. 1.0) x metal {0, 1}, all white, in an 11 x 2 grid seen
// from far away (nearly orthographic). The sun is the only light: it sweeps K directions
// of a Fibonacci sphere with irradiance 4 pi / K each, shadows, SSAO, bloom and the sky
// ambient off, and the HDR frames are summed on the CPU. Each pixel then holds the
// integral of the BRDF times cos over the hemisphere, i.e. its directional albedo, which
// is 1 for a surface that neither loses nor gains energy. Only pixels inside a sphere
// (taken from a mask frame and eroded by two pixels so MSAA edges drop out) count.
//
// A sphere shows each n.v once per ring, so grazing views are a thin rim. The grazing
// test adds flat tiles tilted so that the camera sees them at n.v = 0.35, 0.2, 0.1 and
// 0.05 (per-pixel n.v read back from debug view 8), for both metal values and the same
// 11 roughness values, and holds them to the same per-pixel bar.
//
// Controls that must fail with the same verdict: compensation off (single scatter),
// F0 = 1 for dielectrics in the specular lobe only (wrong F), the older per-light
// 1 - F(v.h) diffuse weight (legacy diffuse) and the direct light scaled by 0.9.
let FN_COLS = 11;
let FN_CELL = 68;
let FN_W = 748;      // FN_COLS * FN_CELL
let FN_H = 136;      // 2 * FN_CELL
// A sun direction stands for a cone of about sqrt(4 pi / K) radians. Lobes narrower than
// that (low roughness) are point-sampled, so their pixels are noisy and the sphere mean
// is biased; only roughness >= FN_RESOLVED is gated, the rest is printed as unresolved.
let FN_RESOLVED = 3;            // in tenths
// Bars: material (tile) mean |albedo - 1| < FN_BAR, and every pixel |albedo - 1| < FN_PX
// (gain and loss alike) on the spheres and the grazing tiles. Set just above the worst
// case measured on the RX 9060 XT at 08016bc (results/2026-11-01_*): mean 1.37 % and
// pixel 1.88 %, both the white metal at rough 0.3, n.v 0.05, where the grazing sweep is
// still not converged (a CPU replay converges to +0.9 %); every other resolved tile and
// sphere stays under 0.5 %. The older 5 % mean / 8 % pixel bars passed the legacy
// diffuse weight on the spheres (2.61 % mean, 7.01 % pixel).
let FN_BAR f32 = 0.015;
let FN_PX f32 = 0.025;
let GZ_ROWS = 8;
let GZ_CELL = 48;
let GZ_W = 528;      // FN_COLS * GZ_CELL
let GZ_H = 384;      // GZ_ROWS * GZ_CELL
let GZ_D f32 = 200.0;           // camera distance
// The grazing sweep uses GZ_K_MUL times as many sun directions as the spheres. At n.v 0.05
// the rough 0.3 lobe is a thin sliver along the horizon, and a CPU replay of the shader
// over the same Fibonacci directions puts the white metal tile at +10.3 % with 4096
// directions, +1.4 % with 16384 and +0.9 % with 65536 to 1M (the converged value; the
// GPU measured +11.7 % mean at 4096), so 4096 measures the sampling, not the shading.
let GZ_K_MUL = 4;
var FN_WPX real = 0.0;          // worst pixel error of the resolved materials, last sweep
var FN_LOSS real = 0.0;         // worst pixel loss of the resolved materials, last sweep
var FN_GAIN real = 0.0;         // worst pixel gain of the resolved materials, last sweep

var HALF f32[>..] = [];
var MASK int[>..] = [];          // pixel index of every counted pixel
var MASK_ID int[>..] = [];       // its material (col + 11 * row)
var MU real[>..] = [];           // its n.v (grazing test)
var ACC real[>..] = [];

fn half_table() {
	if HALF.len > 0 { return; }
	for h in 65536 { HALF.push(half_to_f32((h & 255) as byte, (h >> 8) as byte)); }
}

fn red(px const byte[:], i int) f32 { HALF[(px[i * 8] as int) | ((px[i * 8 + 1] as int) << 8)] }

fn furnace_look() {
	s3d::sun.shadows = false;
	s3d::look.ssao = false;
	s3d::look.bloom = 0.0;
}

fn furnace_scene() {
	reset_scene();
	for row in 2 {
		for c in FN_COLS {
			let rough = c as f32 / 10.0;
			let ball = shapes::sphere(0.45, 64, 32, shapes::material(linalg::v3(1.0, 1.0, 1.0), row as f32, rough));
			s3d::place(s3d::add(ball), gfx::translate(float3 { c as f32 - 5.0, 0.5 - row as f32, 0.0 }));
		}
	}
	// half height 1.0 at distance 30 so the grid fills FN_W x FN_H
	s3d::view = s3d::Camera { eye: float3 { 0.0, 0.0, 30.0 }, target: float3 { 0.0, 0.0, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: 0.0666419, near: 20.0, far: 40.0 };
	furnace_look();
}

// grazing tiles: row r (0 at the top) has metal r / 4 and target n.v gz_mu(r), so the
// two n.v = 0.05 rows sit next to each other in the middle of the frame
fn gz_mu(row int) real {
	let k = if row < 4 { row } else { 7 - row };
	if k == 0 { 0.35 } else if k == 1 { 0.2 } else if k == 2 { 0.1 } else { 0.05 }
}

fn grazing_scene() {
	reset_scene();
	for row in GZ_ROWS {
		for c in FN_COLS {
			let rough = c as f32 / 10.0;
			let mu = gz_mu(row);
			let xc = (c as real - 5.0);
			let yc = 3.5 - row as real;
			// view vector at the tile centre, and the tilt about x that gives n.v = mu with
			// n = (0, cos b, sin b): n.v = rho cos(b - phi)
			let len = sqrt(xc * xc + yc * yc + (GZ_D * GZ_D) as real);
			let vy = -yc / len;
			let vz = GZ_D as real / len;
			let rho = sqrt(vy * vy + vz * vz);
			let beta = atan2(vz, vy) - acos(mu / rho);
			// 0.8 wide, and long enough that it covers half a cell on screen
			let tile = shapes::plane(0.5, shapes::material(linalg::v3(1.0, 1.0, 1.0), (row / 4) as f32, rough));
			let m = linalg::compose(float3 { linalg::f(xc), linalg::f(yc), 0.0 }, linalg::qaxis(float3 { 1.0, 0.0, 0.0 }, linalg::f(beta)), float3 { 0.8, 1.0, linalg::f(0.5 / mu) });
			s3d::place(s3d::add(tile), m);
		}
	}
	// half height 4.0 at distance GZ_D (nearly orthographic: n.v drifts by about 0.0025 along a tile)
	s3d::view = s3d::Camera { eye: float3 { 0.0, 0.0, GZ_D }, target: float3 { 0.0, 0.0, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: linalg::f(2.0 * atan2(4.0, GZ_D as real)), near: GZ_D - 15.0, far: GZ_D + 15.0 };
	furnace_look();
}

fn sky_of(zenith f32, horizon f32, ambient f32, draw bool) s3d::Sky {
	s3d::Sky { zenith: float3 { zenith, zenith, zenith }, horizon: float3 { horizon, horizon, horizon }, ground: float3 { zenith, zenith, zenith }, ambient: ambient, draw: draw }
}

fn furnace_mask(out gfx::Texture, w int, h int, cell int) {
	// sun off, sky not drawn and cleared to 0, ambient 1: surfaces > 0, background 0
	s3d::sun.rgb = float3 { 0.0, 0.0, 0.0 };
	s3d::sky = sky_of(1.0, 0.0, 1.0, false);
	s3d::render(out);
	let px = gfx::read_pixels(s3d::hdr_target());
	MASK.clear();
	MASK_ID.clear();
	for y in 2..h - 2 {
		for x in 2..w - 2 {
			var inside = true;
			for dy in 5 { for dx in 5 { if red(px[..], (y + dy - 2) * w + x + dx - 2) <= 0.0 { inside = false; } } }
			if inside { MASK.push(y * w + x); MASK_ID.push(x / cell + FN_COLS * (y / cell)); }
		}
	}
}

// n.v of every mask pixel, from debug view 8
fn read_mu(out gfx::Texture) {
	s3d::debug_view = 8;
	s3d::render(out);
	s3d::debug_view = 0;
	let px = gfx::read_pixels(s3d::hdr_target());
	MU.clear();
	for p in MASK { MU.push(red(px[..], p) as real); }
}

// Ambient pass-through / fp16 check (not a furnace): uniform white sky ambient, sun off.
// ambient_light() is built to return exactly the environment for a white surface, so this
// only measures fp16, MSAA and raster error of the ambient path on sphere pixels.
fn ambient_passthrough(out gfx::Texture) f32 {
	s3d::sun.rgb = float3 { 0.0, 0.0, 0.0 };
	s3d::sky = sky_of(1.0, 1.0, 1.0, false);
	s3d::render(out);
	let px = gfx::read_pixels(s3d::hdr_target());
	var worst f32 = 0.0;
	var total real = 0.0;
	for p in MASK {
		let e = abs(red(px[..], p) - 1.0);
		worst = max(worst, e);
		total += e as real;
	}
	print("gpu: ambient pass-through (fp16 precision, not a furnace) pixels ", MASK.len, " mean error ", round(total / MASK.len as real * 1.0e6) / 1.0e4, " % max ", round((worst * 1.0e6) as real) / 1.0e4, " %");
	worst
}

fn pct(x real) real { round(x * 10000.0) / 100.0 }
fn r4(x real) real { round(x * 10000.0) / 10000.0 }

// sums the K sun directions into ACC
fn sweep(out gfx::Texture, k int) {
	s3d::sky = sky_of(0.0, 0.0, 0.0, false);
	ACC.clear();
	for i in MASK.len { ACC.push(0.0); }
	let e = linalg::f((4.0 * 3.14159265358979 / k as real) as real);
	s3d::sun.rgb = float3 { e, e, e };
	let golden = 3.14159265358979 * (3.0 - sqrt(5.0));
	for s in k {
		let z = 1.0 - (2.0 * s as real + 1.0) / k as real;
		let r = sqrt(max(1.0 - z * z, 0.0));
		let ph = golden * s as real;
		s3d::sun.to_sun = float3 { linalg::f(r * cos(ph)), linalg::f(z), linalg::f(r * sin(ph)) };
		s3d::render(out);
		let px = gfx::read_pixels(s3d::hdr_target());
		for p, i in MASK { ACC[i] += red(px[..], p) as real; }
	}
}

// Sets up a furnace variant: "single" (compensation off), "compensated", "wrong-F",
// "legacy-diffuse" or "x0.9".
fn variant(kind const byte[:]) {
	s3d::multiscatter = kind != "single";
	s3d::furnace_mode = if kind == "wrong-F" { 1 } else if kind == "legacy-diffuse" { 2 } else { 0 };
	s3d::furnace_scale = if kind == "x0.9" { 0.9 } else { 1.0 };
}

fn variant_reset() { s3d::multiscatter = true; s3d::furnace_mode = 0; s3d::furnace_scale = 1.0; }

// The verdict for one sweep: every resolved material's mean within FN_BAR and every
// resolved pixel within FN_PX.
fn passes(worst_mean real) bool { worst_mean < FN_BAR as real && FN_WPX < FN_PX as real }

// One sphere sweep; prints a table and returns the worst |albedo - 1| of any resolved
// material's mean.
fn furnace_sweep(out gfx::Texture, kind const byte[:], k int) real {
	variant(kind);
	sweep(out, k);
	variant_reset();
	var sum real[>..] = [];
	var lo real[>..] = [];
	var hi real[>..] = [];
	var cnt int[>..] = [];
	for m in 2 * FN_COLS { sum.push(0.0); lo.push(99.0); hi.push(0.0); cnt.push(0); }
	for m, i in MASK_ID {
		let a = ACC[i];
		sum[m] += a; lo[m] = min(lo[m], a); hi[m] = max(hi[m], a); cnt[m] += 1;
	}
	var worst_mean real = 0.0;
	var worst_px real = 0.0;
	var all real = 0.0;
	var r_mean real = 0.0;
	var r_px real = 0.0;
	var r_all real = 0.0;
	var r_n = 0;
	var r_loss real = 0.0;
	var r_gain real = 0.0;
	var d_px real = 0.0;
	var d_all real = 0.0;
	var m_px real = 0.0;
	var m_all real = 0.0;
	for m in 2 * FN_COLS {
		let mean = sum[m] / max(cnt[m], 1) as real;
		let px_err = max(abs(lo[m] - 1.0), abs(hi[m] - 1.0));
		let resolved = m % FN_COLS >= FN_RESOLVED;
		if resolved {
			r_mean = max(r_mean, abs(mean - 1.0)); r_px = max(r_px, px_err); r_all += abs(mean - 1.0); r_n += 1;
			r_loss = max(r_loss, 1.0 - lo[m]); r_gain = max(r_gain, hi[m] - 1.0);
			if m / FN_COLS == 0 { d_px = max(d_px, px_err); d_all = max(d_all, abs(mean - 1.0)); } else { m_px = max(m_px, px_err); m_all = max(m_all, abs(mean - 1.0)); }
		}
		print("gpu: furnace ", kind, " metal ", m / FN_COLS, " rough ", (m % FN_COLS) as real / 10.0, if resolved { "" } else { " (unresolved)" }, " pixels ", cnt[m], " albedo mean ", r4(mean), " min ", r4(lo[m]), " max ", r4(hi[m]), " | mean error ", pct(abs(mean - 1.0)), " % worst pixel ", pct(px_err), " %");
		worst_mean = max(worst_mean, abs(mean - 1.0));
		worst_px = max(worst_px, px_err);
		all += abs(mean - 1.0);
	}
	print("gpu: furnace ", kind, " summary (", k, " sun directions) rough >= 0.", FN_RESOLVED, ": worst material mean error ", pct(r_mean), " %, mean over materials ", pct(r_all / max(r_n, 1) as real), " %, worst pixel ", pct(r_px), " % (gain ", pct(max(r_gain, 0.0)), " %, loss ", pct(max(r_loss, 0.0)), " %); dielectric worst mean ", pct(d_all), " % worst pixel ", pct(d_px), " %; metal worst mean ", pct(m_all), " % worst pixel ", pct(m_px), " %; all roughness incl. unresolved: worst mean ", pct(worst_mean), " %, mean ", pct(all / (2 * FN_COLS) as real), " %, worst pixel ", pct(worst_px), " %");
	FN_WPX = r_px;
	FN_LOSS = max(r_loss, 0.0);
	FN_GAIN = max(r_gain, 0.0);
	r_mean
}

// One grazing sweep; prints a line per tile and a summary, and returns the worst
// |albedo - 1| of any resolved tile's mean (FN_WPX etc. as for the spheres).
fn grazing_sweep(out gfx::Texture, kind const byte[:], k int) real {
	variant(kind);
	sweep(out, k);
	variant_reset();
	let T = GZ_ROWS * FN_COLS;
	var sum real[>..] = []; var lo real[>..] = []; var hi real[>..] = []; var cnt int[>..] = [];
	var mlo real[>..] = []; var mhi real[>..] = [];
	for m in T { sum.push(0.0); lo.push(99.0); hi.push(-99.0); cnt.push(0); mlo.push(2.0); mhi.push(-1.0); }
	for m, i in MASK_ID {
		let a = ACC[i];
		sum[m] += a; lo[m] = min(lo[m], a); hi[m] = max(hi[m], a); cnt[m] += 1;
		mlo[m] = min(mlo[m], MU[i]); mhi[m] = max(mhi[m], MU[i]);
	}
	var r_mean real = 0.0; var r_px real = 0.0; var r_loss real = 0.0; var r_gain real = 0.0;
	var d_px real = 0.0; var m_px real = 0.0; var d_mean real = 0.0; var m_mean real = 0.0;
	var u_gain real = 0.0; var u_loss real = 0.0;
	var g05 real = 0.0;
	var empty = 0;
	for m in T {
		let row = m / FN_COLS;
		let c = m % FN_COLS;
		let metal = row / 4;
		let mean = sum[m] / max(cnt[m], 1) as real;
		let px_err = max(abs(lo[m] - 1.0), abs(hi[m] - 1.0));
		let resolved = c >= FN_RESOLVED;
		if cnt[m] < 100 { empty += 1; }
		if resolved {
			r_mean = max(r_mean, abs(mean - 1.0)); r_px = max(r_px, px_err);
			r_loss = max(r_loss, 1.0 - lo[m]); r_gain = max(r_gain, hi[m] - 1.0);
			if metal == 0 { d_px = max(d_px, px_err); d_mean = max(d_mean, abs(mean - 1.0)); } else { m_px = max(m_px, px_err); m_mean = max(m_mean, abs(mean - 1.0)); }
			if gz_mu(row) < 0.06 { g05 = max(g05, px_err); }
		} else {
			u_gain = max(u_gain, hi[m] - 1.0); u_loss = max(u_loss, 1.0 - lo[m]);
		}
		print("gpu: grazing ", kind, " metal ", metal, " n.v ", gz_mu(row), " rough ", c as real / 10.0, if resolved { "" } else { " (unresolved)" }, " pixels ", cnt[m], " n.v ", r4(mlo[m]), "..", r4(mhi[m]), " albedo mean ", r4(mean), " min ", r4(lo[m]), " max ", r4(hi[m]), " | worst pixel ", pct(px_err), " %");
	}
	print("gpu: grazing ", kind, " summary (", k, " sun directions) rough >= 0.", FN_RESOLVED, ": worst tile mean error ", pct(r_mean), " %, worst pixel ", pct(r_px), " % (gain ", pct(max(r_gain, 0.0)), " %, loss ", pct(max(r_loss, 0.0)), " %); dielectric worst mean ", pct(d_mean), " % worst pixel ", pct(d_px), " %; metal worst mean ", pct(m_mean), " % worst pixel ", pct(m_px), " %; n.v 0.05 rows worst pixel ", pct(g05), " %; unresolved (rough < 0.", FN_RESOLVED, ", reported) worst pixel gain ", pct(max(u_gain, 0.0)), " % loss ", pct(max(u_loss, 0.0)), " %; tiles with < 100 pixels ", empty);
	FN_WPX = if empty > 0 { 99.0 } else { r_px };
	FN_LOSS = max(r_loss, 0.0);
	FN_GAIN = max(r_gain, 0.0);
	r_mean
}

// runs one variant over the current mask; returns whether it passes
fn furnace_run(out gfx::Texture, grazing bool, kind const byte[:], k int) bool {
	let w = if grazing { grazing_sweep(out, kind, k) } else { furnace_sweep(out, kind, k) };
	passes(w)
}

// The furnace verdict: the compensated BRDF passes on the spheres and on the grazing
// tiles, and every control fails the same verdict (on the spheres, the tiles or both).
fn furnace(k int) bool {
	half_table();
	let keep_sky = s3d::sky;
	let keep_sun = s3d::sun;
	let keep_look = s3d::look;
	var good = true;
	var comp_ok bool[>..] = [];
	let kinds = ["single", "wrong-F", "legacy-diffuse", "x0.9"];
	var fails bool[>..] = [];       // control i fails on pass p at [p * kinds.len + i]
	for pass in 2 {
		let grazing = pass == 1;
		if grazing { grazing_scene(); } else { furnace_scene(); }
		let w = if grazing { GZ_W } else { FN_W };
		let h = if grazing { GZ_H } else { FN_H };
		s3d::init(w, h);
		let out = gfx::render_target(w, h, gfx::RGBA8);
		furnace_mask(out, w, h, if grazing { GZ_CELL } else { FN_CELL });
		if grazing { read_mu(out); } else if ambient_passthrough(out) >= 0.02 { good = false; }
		let kk = if grazing { GZ_K_MUL * k } else { k };
		comp_ok.push(furnace_run(out, grazing, "compensated", kk));
		for kd in kinds { fails.push(!furnace_run(out, grazing, kd, kk)); }
		gfx::release(out);
	}
	var controls byte[>..] = [];
	for kd, i in kinds {
		let sph = fails[i];
		let gz = fails[kinds.len + i];
		format(controls, " ", kd, " ", if sph || gz { "FAILS as required" } else { "NOT CAUGHT" }, " (spheres ", if sph { "fail" } else { "pass" }, ", grazing ", if gz { "fail" } else { "pass" }, ");");
		if !sph && !gz { good = false; }
	}
	if !comp_ok[0] || !comp_ok[1] { good = false; }
	print("gpu: furnace verdict (rough >= 0.", FN_RESOLVED, ", bars: material mean < ", pct(FN_BAR as real), " %, every pixel |albedo - 1| < ", pct(FN_PX as real), " %): compensated spheres ", if comp_ok[0] { "PASS" } else { "FAIL" }, ", grazing tiles ", if comp_ok[1] { "PASS" } else { "FAIL" }, "; controls:", controls[..]);
	s3d::sky = keep_sky;
	s3d::sun = keep_sun;
	s3d::look = keep_look;
	good
}

// ---- timing helpers
fn sort_reals(v real[>..]&) {
	for i in 1..v.len {
		let x = v[i];
		var j = i;
		while j > 0 && v[j - 1] > x { v[j] = v[j - 1]; j -= 1; }
		v[j] = x;
	}
}

// "min a median b p95 c" of v (sorted in place), in milliseconds with 3 decimals
fn stats(v real[>..]&) byte[>..] {
	sort_reals(v);
	var s byte[>..] = [];
	if v.len == 0 { s.append("no samples"); return s; }
	let p95 = v[min((v.len * 95 + 99) / 100 - 1, v.len - 1)];
	let med = if v.len % 2 == 1 { v[v.len / 2] } else { (v[v.len / 2 - 1] + v[v.len / 2]) / 2.0 };
	format(s, "min ", round(v[0] * 10000.0) / 10000.0, " median ", round(med * 10000.0) / 10000.0, " p95 ", round(p95 * 10000.0) / 10000.0, " ms");
	s
}

// GPU nanoseconds of every "submit <n> <ns>" line the gputime layer has written so far
fn gputime_lines(path const byte[:], ns real[>..]&) {
	ns.clear();
	var log byte[>..] = [];
	if !read_file(path, log) { return; }
	var i = 0;
	while i < log.len {
		var e = i;
		while e < log.len && log[e] != 10 { e += 1; }
		if e - i > 7 && log[i] == 115 && log[i + 1] == 117 && log[i + 2] == 98 {
			// last field is the nanosecond count
			var k = e;
			while k > i && log[k - 1] != 32 { k -= 1; }
			var v = 0;
			for c in log[k..e] { if c >= 48 && c <= 57 { v = v * 10 + (c as int - 48); } }
			ns.push(v as real);
		}
		i = e + 1;
	}
}

fn sphere_grid() {
	reset_scene();
	for row in 5 {
		for c in 5 {
			let metal = row as f32 / 4.0;
			let rough = 0.05 + 0.95 * c as f32 / 4.0;
			let ball = shapes::sphere(0.42, 48, 24, shapes::material(linalg::v3(0.9, 0.55, 0.3), metal, rough));
			s3d::place(s3d::add(ball), gfx::translate(float3 { (c as f32 - 2.0) * 1.0, (2.0 - row as f32) * 1.0, 0.0 }));
		}
	}
	let floor = shapes::cube(float3 { 3.0, 0.1, 3.0 }, shapes::material(linalg::v3(0.6, 0.6, 0.6), 0.0, 0.8));
	s3d::place(s3d::add(floor), gfx::translate(float3 { 0.0, -2.7, -1.0 }));
	s3d::view = s3d::Camera { eye: float3 { 0.0, 0.3, 7.5 }, target: float3 { 0.0, 0.0, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: 0.75, near: 0.1, far: 60.0 };
	s3d::sun.to_sun = float3 { 0.5, 0.7, 0.6 };
	s3d::sun.shadow_far = 20.0;
	// No shadows, SSAO or bloom: the golden image and the timing baseline were recorded
	// in this state, which the older furnace() left behind by restoring the look it had
	// set up itself; furnace() now restores the caller's look, so this sets it here.
	s3d::sun.shadows = false;
	s3d::look.ssao = false;
	s3d::look.bloom = 0.0;
}

fn psnr(a const byte[:], b const byte[:]) real {
	if a.len != b.len || a.len == 0 { return 0.0; }
	var se real = 0.0;
	var n = 0;
	for i in a.len {
		if i % 4 == 3 { continue; }
		let d = (a[i] as int - b[i] as int) as real;
		se += d * d;
		n += 1;
	}
	if se == 0.0 { return 99.0; }
	10.0 * log10(255.0 * 255.0 / (se / n as real))
}

// Output directory for the PNGs, kept in a global so it outlives every frame's scratch.
var OUT_DIR byte[>..] = [];
var GOLDEN byte[>..] = [];
var FURNACE_K = 4096;
let TIME_WARMUP = 30;
let TIME_FRAMES = 200;
fn path(dir const byte[:], name const byte[:]) byte[>..] { let _ = dir; var p byte[>..] = []; p.append(OUT_DIR[..]); p.append("/"); p.append(name); p }

fn gpu_checks(dir const byte[:], golden const byte[:]) bool {
	var good = true;
	if !furnace(FURNACE_K) { good = false; }

	sphere_grid();
	s3d::init(480, 360);
	let out = gfx::render_target(480, 360, gfx::RGBA8);
	s3d::render(out);
	let got = gfx::read_pixels(out);
	let sp = path(dir, "spheres.png");
	print("gpu: spheres png ", sp[..], " ", gfx::save_png(out, sp[..]));
	// the golden is required: a missing, unreadable or wrong-sized golden is a failure
	if GOLDEN.len == 0 {
		print("gpu: spheres FAILED: no golden given (expected hc/test/gfx/golden/spheres.png)");
		good = false;
	} else {
		var want byte[>..] = [];
		var ref byte[>..] = [];
		let readable = read_file(GOLDEN[..], want);
		let gw, gh, gok = codec_png::decode(want[..], ref);
		if !readable || !gok || gw != 480 || gh != 360 {
			print("gpu: spheres FAILED: golden ", GOLDEN[..], " unreadable or not a 480x360 PNG");
			good = false;
		} else {
			let db = psnr(got[..], ref[..]);
			print("gpu: spheres psnr ", round(db * 100.0) / 100.0, " dB vs golden (bar > 40 dB) ", if db > 40.0 { "PASS" } else { "FAIL" });
			if db <= 40.0 { good = false; }
		}
	}
	gfx::release(out);

	// timing at 720p on the same scene: 30 warmup frames, then 200 timed frames, each
	// render + submit + fence wait with no readback. Wall clock per frame always; GPU time
	// per frame from timestamp queries when run under the gputime layer (HELIUM_GPUTIME).
	s3d::init(1280, 720);
	let big = gfx::render_target(1280, 720, gfx::RGBA8);
	s3d::render(big);
	let _ = gfx::read_pixels(big);
	for k in TIME_WARMUP { s3d::render(big); gfx::flush(); }
	var log byte[>..] = [];
	let have_log = env("HELIUM_GPUTIME", log) && log.len > 0;
	var gpu_ns real[>..] = [];
	if have_log { gputime_lines(log[..], gpu_ns); }
	let first = gpu_ns.len;
	var wall real[>..] = [];
	for k in TIME_FRAMES {
		let t = gfx::time();
		s3d::render(big);
		gfx::flush();
		wall.push((gfx::time() - t) * 1000.0);
	}
	print("gpu: timing 1280x720 sphere grid (", s3d::batch.len, " draws, 4x msaa; shadows, ssao and bloom off as in the baseline): ", TIME_WARMUP, " warmup + ", TIME_FRAMES, " timed frames, each render + submit + fence wait, no readback");
	print("gpu: timing wall-clock ms/frame ", stats(wall)[..]);
	if have_log {
		gputime_lines(log[..], gpu_ns);
		let n = gpu_ns.len - first;
		if n > 0 && n % TIME_FRAMES == 0 {
			let per = n / TIME_FRAMES;
			var frame real[>..] = [];
			for f in TIME_FRAMES {
				var t = 0.0;
				for j in per { t += gpu_ns[first + f * per + j]; }
				frame.push(t / 1.0e6);
			}
			print("gpu: timing gpu-timestamp ms/frame ", stats(frame)[..], " (", per, " submit(s) per frame, top-of-pipe to bottom-of-pipe)");
		} else {
			print("gpu: timing gpu-timestamp: ", n, " submits for ", TIME_FRAMES, " frames, cannot split per frame");
			good = false;
		}
	} else {
		print("gpu: timing gpu-timestamp: not measured (run under tools/hc/gputime, see tools/hc/gfxtest.sh)");
	}
	gfx::release(big);

	// a full frame with every feature
	reset_scene();
	let a = gltf::load_bytes(embed_file("fixtures/scene.glb"), "");
	let floor = shapes::plane(6.0, shapes::material(linalg::v3(0.5, 0.52, 0.55), 0.0, 0.7));
	s3d::add(floor);
	let it = s3d::add(a);
	s3d::place(it, gfx::translate(float3 { 0.0, 0.6, 0.0 }));
	s3d::animate(it, gltf::find_animation(a, "wave"), 0.7);
	let ball = shapes::sphere(0.5, 32, 16, shapes::material(linalg::v3(0.95, 0.95, 0.95), 1.0, 0.25));
	s3d::place(s3d::add(ball), gfx::translate(float3 { 1.6, 0.5, 0.4 }));
	s3d::add_light(float3 { -1.5, 1.2, 1.0 }, float3 { 6.0, 2.0, 0.8 }, 6.0);
	s3d::view = s3d::Camera { eye: float3 { 2.5, 2.2, 5.0 }, target: float3 { 0.0, 0.6, 0.0 }, up: float3 { 0.0, 1.0, 0.0 }, fov_y: 0.9, near: 0.1, far: 60.0 };
	s3d::init(640, 360);
	sparks::init(512);
	sparks::ground = 0.0;
	sparks::burst(float3 { 1.6, 1.1, 0.4 }, float3 { 0.0, 1.0, 0.0 }, 300, 3.0, 0.6, 1.5, float4 { 4.0, 2.2, 0.8, 1.0 }, 0.05, 7);
	sparks::step(0.0);
	for k in 8 { sparks::step(0.03); }
	let frame = gfx::render_target(640, 360, gfx::RGBA8);
	s3d::render(frame);
	var text TextVtx[>..] = [];
	sdf_text(text, 16.0, 16.0, 28.0, "helium gfx", [255, 255, 255, 255], 1, true);
	sdf_draw(frame, 640, 360, text);
	let px = gfx::read_pixels(frame);
	let frp = path(dir, "frame.png");
	print("gpu: frame png ", frp[..], " ", gfx::save_png(frame, frp[..]));
	var lo = 255;
	var hi = 0;
	var sum = 0;
	for i in px.len / 4 {
		let l = (px[i * 4] as int * 2 + px[i * 4 + 1] as int * 5 + px[i * 4 + 2] as int) / 8;
		lo = min(lo, l); hi = max(hi, l); sum += l;
	}
	let mean = sum / max(px.len / 4, 1);
	print("gpu: frame mean ", mean, " range ", lo, "..", hi);
	if mean < 30 || mean > 225 || hi - lo < 120 { good = false; }
	let err = gfx::error();
	if err.len > 0 { print("gpu: gfx error ", err[..]); good = false; }
	good
}

fn main() {
	cpu_checks();
	// read argv straight into owned buffers (os.args() hands back slices of freed buffers)
	let argc = arg_count();
	if argc < 2 { return; }
	OUT_DIR.clear();
	arg(1, OUT_DIR);
	var kv byte[>..] = [];
	if env("FURNACE_K", kv) && kv.len > 0 { var k = 0; for c in kv { if c >= 48 && c <= 57 { k = k * 10 + (c as int - 48); } } if k > 0 { FURNACE_K = k; } }
	GOLDEN.clear();
	if argc > 2 { arg(2, GOLDEN); }
	print("gpu: out dir ", OUT_DIR[..]);
	if !gfx::open_headless(64, 64) { print("gpu: skipped (no device: ", gfx::error()[..], ")"); return; }
	let t0 = gfx::time();
	let good = gpu_checks(OUT_DIR[..], GOLDEN[..]);
	print(if good { "gpu: ok" } else { "gpu: FAILED" }, " (", round((gfx::time() - t0) * 10.0) / 10.0, " s, ", gfx::driver()[..], ")");
	gfx::close();
}
