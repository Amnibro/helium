	let f0, e0 = sk_qs(1.2, sk_skin(0.02, 0.4, 0.0, 0.0), 1.0, 50, 0, false);
	let fc, ec = sk_qs(1.2, sk_skin(0.02, 0.4, -0.7, 0.0), 1.0, 50, 0, false);
