	let off = rr_frame(2);
	let again = rr_frame(2);
	SK_FUZZ = 0.35;
	sk_ball(0.0, float3 { -0.12, 0.1, 0.0 });
	let on = rr_frame(2);
	SK_FUZZ = 0.0;
	sk_ball(50.0, float3 { -0.12, 0.1, 0.0 });
	let lit = rr_frame(2);
	var mask int[>..] = [];
	mask.resize(921600, 0);
	var cx = 0;
	var cy = 0;
	var cnt = 0;
	for i in 921600 { let g = sk_d(lit[..], off[..], i); mask[i] = if g > 0 { 1 } else { 0 }; cx += if g > 0 { i % 1280 } else { 0 }; cy += if g > 0 { i / 1280 } else { 0 }; cnt += mask[i]; }
	cx = cx / max(cnt, 1);
	cy = cy / max(cnt, 1);
	var edge = 0;
	var rise = 0;
	var rise0 = 0;
	var mid = 0;
	var out = 0;
	for i in 921600 {
		let x = i % 1280;
		let y = i / 1280;
		let d = sk_d(on[..], off[..], i);
		out = if mask[i] == 0 { max(out, d) } else { out };
		mid = if mask[i] == 1 && (x - cx) * (x - cx) + (y - cy) * (y - cy) <= 2304 { max(mid, d) } else { mid };
		if mask[i] == 1 && x >= 4 && x < 1276 && y >= 4 && y < 716 && mask[i - 4] * mask[i + 4] * mask[i - 5120] * mask[i + 5120] * mask[i - 3843] * mask[i - 3837] * mask[i + 3837] * mask[i + 3843] == 0 { edge += 1; rise += sk_up(on[..], off[..], i); rise0 += sk_up(again[..], off[..], i); }
	}
	let up = rise as real / 3.0 / max(edge, 1) as real;
	let up0 = rise0 as real / 3.0 / max(edge, 1) as real;
	let ok = up >= 3.0 && mid <= 1 && out == 0 && up0 < 3.0;
	print("gpu: sss Y5 fuzz 0.35: ", edge, " rim pixels rise ", r2(up), " / 255 on average (bar >= 3), middle largest change ", mid, " / 255 (bar <= 1), pixels without skin ", out, " / 255 (bar 0); control fuzz 0: rim rise ", r2(up0), if ok { " PASS" } else { " FAIL" });
	ok
}
fn sk_shot(pores f32) byte[>..] {
