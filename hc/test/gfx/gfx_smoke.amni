	s3d::lights.push(s3d::Light { pos: float3 { -0.0707, 0.1207, 0.0 }, range: 1.0, rgb: float3 { 1.0, 1.0, 1.0 }, kind: 1, dir: float3 { 0.7071, -0.7071, 0.0 }, cone: 0.17, edge: 0.1, .. });
