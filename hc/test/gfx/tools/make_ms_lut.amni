// make_ms_lut: writes hc/lib/gfx/shaders/ms_lut.glsl, the directional albedo E(mu, rough)
// of the single-scatter specular lobe in lighting.glsl (GGX D, Smith-Schlick G with
// k = rough^2 / 2, the same 1e-4 guard in the denominator) with the Fresnel term set to 1.
// surface.frag divides by it to restore the energy lost to multiple scattering.
//
//   HC_LIB=hc/lib build/hcn run hc/test/gfx/tools/make_ms_lut.amni > hc/lib/gfx/shaders/ms_lut.glsl
//
// Integration: for every table entry, S x S stratified half vectors drawn from the GGX
// distribution of normals (pdf D(h) n.h), mapped to light directions (pdf / 4 v.h).
// The table is N x N over mu = n.v in [0, 1] and rough in [0, 1]; the last line on
// stderr reports how far bilinear lookup strays from a direct integration at the cell
// centres.
import os;
import math;

let N = 32;
let S = 256;
let PI = 3.14159265358979;

fn albedo(mu real, rough real) real {
	let n_v = max(mu, 0.0001);
	let vx = sqrt(max(1.0 - n_v * n_v, 0.0));
	let vz = n_v;
	let a = max(rough * rough, 0.002);
	let k = rough * rough * 0.5;
	var sum real = 0.0;
	for i in S {
		for j in S {
			let u1 = (i as real + 0.5) / S as real;
			let u2 = (j as real + 0.5) / S as real;
			let t2 = a * a * u1 / (1.0 - u1);
			let ch = 1.0 / sqrt(1.0 + t2);
			let sh = sqrt(max(1.0 - ch * ch, 0.0));
			let ph = 2.0 * PI * u2;
			let hx = sh * cos(ph);
			let hy = sh * sin(ph);
			let hz = ch;
			let v_h = vx * hx + vz * hz;
			if v_h <= 0.0 { continue; }
			let lz = 2.0 * v_h * hz - vz;
			if lz <= 0.0 { continue; }
			let _ = hy;
			let g = (lz / (lz * (1.0 - k) + k)) * (n_v / (n_v * (1.0 - k) + k));
			// f * n.l / pdf with f = D G / (4 n.l n.v + 1e-4) and pdf = D n.h / (4 v.h)
			sum += g * lz * 4.0 * v_h / ((4.0 * lz * n_v + 0.0001) * hz);
		}
	}
	sum / (S * S) as real
}

fn fixed5(x real) byte[>..] {
	let n = round(x * 100000.0) as int;
	var s byte[>..] = [];
	format(s, n / 100000, ".");
	let f = n % 100000;
	var d = 10000;
	while d > 0 { format(s, (f / d) % 10); d /= 10; }
	s
}

fn lookup(t const real[:], mu real, rough real) real {
	let x = sqrt(clamp(mu, 0.0, 1.0)) * (N - 1) as real;
	let y = clamp(rough, 0.0, 1.0) * (N - 1) as real;
	let x0 = min(floor(x) as int, N - 2);
	let y0 = min(floor(y) as int, N - 2);
	let fx = x - x0 as real;
	let fy = y - y0 as real;
	let a = t[y0 * N + x0] * (1.0 - fx) + t[y0 * N + x0 + 1] * fx;
	let b = t[(y0 + 1) * N + x0] * (1.0 - fx) + t[(y0 + 1) * N + x0 + 1] * fx;
	a * (1.0 - fy) + b * fy
}

fn main() {
	var t real[>..] = [];
	for r in N {
		for m in N { let x = m as real / (N - 1) as real; t.push(albedo(x * x, r as real / (N - 1) as real)); }
	}
	print("// Generated by hc/test/gfx/tools/make_ms_lut.amni; do not edit.");
	print("// Directional albedo E(mu = n.v, rough) of the single-scatter GGX specular lobe in");
	print("// lighting.glsl with Fresnel = 1, ", N, " x ", N, ", row = rough (0..1),\n// column = sqrt(mu) (0..1).");
	print("const int MS_N = ", N, ";");
	print("const float MS_E[", N * N, "] = float[](");
	for r in N {
		var line byte[>..] = [];
		line.append("\t");
		for m in N {
			line.append(fixed5(t[r * N + m])[..]);
			if r < N - 1 || m < N - 1 { line.append(","); }
			if m < N - 1 { line.append(" "); }
		}
		print(line[..]);
	}
	print(");");
	var worst real = 0.0;
	var lo real = 2.0;
	var wm real = 0.0;
	var wr real = 0.0;
	for r in N - 1 {
		for m in N - 1 {
			let xm = (m as real + 0.5) / (N - 1) as real;
			let mu = xm * xm;
			let ro = (r as real + 0.5) / (N - 1) as real;
			if ro < 0.03 || mu < 0.01 { continue; }
			let e = albedo(mu, ro);
			let er = abs(lookup(t[..], mu, ro) - e) / e;
			if er > worst { worst = er; wm = mu; wr = ro; }
		}
	}
	for v in t { lo = min(lo, v); }
	var msg byte[>..] = [];
	format(msg, "make_ms_lut: min E ", fixed5(lo)[..], ", worst bilinear relative error at cell centres ", fixed5(worst * 100.0)[..], " % at mu ", fixed5(wm)[..], " rough ", fixed5(wr)[..], "\n");
	write_stderr(msg[..]);
}
