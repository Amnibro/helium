	else { ok = sky("P10 engine sky", 1.0, 1.0, true) && ok; ok = sky("P10 control, reference x 1.01", 1.01, 1.0, false) && ok; ok = sky("P10 control, x axis mirrored", 1.0, -1.0, false) && ok; gfx::close() }
	print(str("P4 longest dispatch ", MX as! int, " ms (bar 1000), bad samples ", BAD, " (bar 0): ", if MX < 1000.0 && BAD == 0 { "PASS" } else { "FAIL" }, if cpu { " (dispatch time reported)" } else { "" }))
	ok = ok && BAD == 0 && (cpu || MX < 1000.0)
