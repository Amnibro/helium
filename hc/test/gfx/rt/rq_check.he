use os
use gfx.hwrt
mt(o0 real, o1 real, o2 real, t const f32[:], k int) real, real, real:
	b := k * 9; e1 := [t[b + 3] - t[b], t[b + 4] - t[b + 1], t[b + 5] - t[b + 2]]; e2 := [t[b + 6] - t[b], t[b + 7] - t[b + 1], t[b + 8] - t[b + 2]]
	px := -e2[1] as real; py := e2[0] as real; det := e1[0] as real * px + e1[1] as real * py
	sx := o0 - t[b] as real; sy := o1 - t[b + 1] as real; sz := o2 - t[b + 2] as real; u := (sx * px + sy * py) / det
	qx := sy * e1[2] as real - sz * e1[1] as real; qy := sz * e1[0] as real - sx * e1[2] as real; qz := sx * e1[1] as real - sy * e1[0] as real
	v := qz / det; tt := (e2[0] as real * qx + e2[1] as real * qy + e2[2] as real * qz) / det
	return if u < 0.0 || v < 0.0 || u + v > 1.0 { -1.0 } else { tt }, u, v
check(gpu const f32[:], cpu const f32[:], p int, ob int, show bool) int, int:
	if !hwrt::scene(gpu) || !hwrt::run(p, [ob], 1, 1, 1): return -1, 0
	r f32[>..] ~= []; r.resize(256, 0.0); hwrt::get(ob, r[..]); bad ~= 0; hits ~= 0
	for i 64:
		bt ~= -1.0; bp ~= -1; bu ~= 0.0; bv ~= 0.0
		for k 3: t, u, v := mt(i as real * 0.01, 0.0, -1.0, cpu, k); if t > 0.0 && (bt < 0.0 || t < bt) { bt = t; bp = k; bu = u; bv = v }
		g := r[i * 4] as real; gp := r[i * 4 + 1] as! int
		if bp >= 0: hits++
		if abs(g - bt) > 1e-4 || gp != bp || bp >= 0 && (abs(r[i * 4 + 2] as real - bu) > 1e-4 || abs(r[i * 4 + 3] as real - bv) > 1e-4):
			bad++
			if show: print(str("rq: ray ", i, ": gpu t ", g, " prim ", gp, " uv ", r[i * 4 + 2], " ", r[i * 4 + 3], "; cpu t ", bt, " prim ", bp, " uv ", bu, " ", bv))
	return bad, hits
main():
	tris f32[>..] ~= [-0.1, -0.5, 1.0, 0.35, -0.5, 1.0, -0.1, 0.5, 1.0, 0.05, -0.5, 2.0, 0.7, -0.5, 2.0, 0.7, 0.5, 2.0, 0.0, -1.0, 5.0, 1.0, -1.0, 5.0, 0.0, 1.0, 5.0]
	moved f32[>..] ~= []; moved.append(tris[..]); for k [11, 14, 17] { moved[k] += 0.05 }
	if !hwrt::init(): print("rq: skipped (no ray-query device)"); return
	print(str("rq device: ", hwrt::name()))
	ob := hwrt::buf(64 * 16, 0x20, false); p := hwrt::pipe(embed_shader("rq_check.comp"), 1)
	if ob < 0 || p < 0: print("rq: FAILED (setup)"); hwrt::done(); return
	bad, hits := check(tris[..], tris[..], p, ob, true); cbad, _ := check(moved[..], tris[..], p, ob, false)
	print(str("rq: 64 rays, ", hits, " hits, ", bad, " mismatches (bar 0)"))
	print(str("rq control (one triangle moved 0.05 along z): ", cbad, " mismatches (must be at least 1)"))
	print(if bad == 0 && hits == 64 && cbad > 0 { "rq: ok" } else { "rq: FAILED" })
	hwrt::done()
