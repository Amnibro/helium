use std
struct H { d int[>..] }
main():
	hs H[>..] ~= []
	for i 130:
		hs.push(H{..})
		for j 10: hs[i].d.push(i * 100 + j)
	big int[>..] ~= []
	for i 100: big.push(i)
	head := big[0..100]
	for i 2500000: big.push(i ^ 5)
	for i 130: for j 3000: hs[i].d.push(j)
	s ~= 0
	for i 130: s += hs[i].d[9] + hs[i].d.len
	t ~= 0
	for v big: t += v & 255
	print(s, " ", big.len, " ", t, " ", head[99], " ", head.len)
