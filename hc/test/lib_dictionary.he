use std
use dictionary

main():
	ages ~= dictionary<byte[>..], int>{}
	insert(ages, "ann", 31)
	insert(ages, "bob", 27)
	print(insert(ages, "ann", 32), " count=", ages.count)
	print(get(ages, "ann", -1), " ", get(ages, "zed", -1), " ", contains(ages, "bob"), " ", contains(ages, "zed"))
	dict_at(ages, "bob") += 1
	get_or_insert(ages, "cy", 40) += 2
	get_or_insert(ages, "cy", 99) += 2
	for s sorted(items(ages)[..]): print(s.key, " => ", s.val)
	print(remove(ages, "ann"), " ", remove(ages, "ann"), " count=", ages.count)
	# lots of keys: growth, removal and reuse of freed slots
	sq ~= dictionary<int, int>{}
	for i 1000: insert(sq, i, i * i)
	for i 1000: if i % 3 == 0 { remove(sq, i) }
	for i 500: insert(sq, i * 3, -i)
	total ~= 0
	each(sq) { k, v => total += v }
	print("count=", sq.count, " total=", total, " 999->", get(sq, 999, 0), " 998->", get(sq, 998, 0))
	ks := keys(sq)
	vs := values(sq)
	print(ks.len, " ", vs.len)
	each(sq) { k, v => v = 0 }
	print(get(sq, 10, 7))
	clear(sq)
	print("after clear ", sq.count, " ", contains(sq, 10))
	# helpers
	c := counter(split("the cat and the hat and the bat", ' ')[..])
	for s sorted(items(c)[..]): print(s.key, " ", s.val)
	seen := set([3, 1, 3, 2, 1][..])
	print(seen.count, " ", contains(seen, 2), " ", contains(seen, 5))
	z := dict_from(["x", "y"][..], [1.5, 2.5][..])
	print(get(z, "y", 0.0))
