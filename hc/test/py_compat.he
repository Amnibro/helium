def c44() -> None:
    nums = [31, 7, 18, 4, 22]
    best = 100
    for mask in range(1 << len(nums)):
        s = 0
        for i in range(len(nums)):
            if mask % 2 == 1:
                s = s + nums[i]
            mask = mask // 2
        if abs(82 - 2 * s) < best:
            best = abs(82 - 2 * s)
    print(best)
    for i in range(5):
        print(i)
        i += 2
    for j in range(2, 9):
        if j % 2 == 0:
            j = j * 10
        print(j)
    def f(n: int) -> int:
        t = 0
        for k in range(n):
            while k > 0:
                t += k
                k -= 1
        return t
    print(f(5), [x for x in range(3)])
    for a in range(0, 10, 3):
        a = a + 1
        print(a)
