def f(n: int, s: str) -> int:
    parts: list[str] = s.split(",")
    total: int = 0
    best: int = -1
    for p in parts:
        v: int = int(p)
        if v > best:
            best: int = v
        total: int = total + v
    if n > 0:
        n: int = n - 1
        total: int = total * 2
    return total + best + n
def g(s: str) -> int:
    s: list[str] = s.split()
    k: int = 0
    while k < 3:
        k: int = k + 1
        if k == 2:
            flag: bool = True
            print(flag)
    return len(s) + k
