seed = 42
calls = 0
def rnd() -> int:
    global seed, calls
    seed = (seed * 1103515245 + 12345) % 2147483648
    calls += 1
    return seed
def outer() -> int:
    total = 0
    def add(k: int) -> None:
        nonlocal total
        total += k
    add(2)
    add(5)
    return total
print(rnd(), rnd(), calls, outer())
def perms(xs: list[int], path: list[int], used: list[bool], out: list[list[int]]) -> None:
    if len(path) == len(xs):
        out.append(path[:])
        return
    for i in range(len(xs)):
        if not used[i]:
            used[i] = True
            path.append(xs[i])
            perms(xs, path, used, out)
            path.pop()
            used[i] = False
