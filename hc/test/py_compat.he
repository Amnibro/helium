def hanoi(n: int, a: str, b: str, c: str) -> None:
    if n == 1:
        print(a + "->" + b)
    else:
        hanoi(n - 1, a, c, b)
        print(a + "->" + b)
        hanoi(n - 1, c, b, a)
def low(s: str) -> list[str]:
    return s.lower().split(",")
hanoi(2, "A", "C", "B")
print(low("A,B"))
def msort(a: list[int]) -> list[int]:
    if len(a) < 2:
        return a
    m = len(a) // 2
    l = msort(a[:m])
    r = msort(a[m:])
    o: list[int] = []
    i = j = 0
    while i < len(l) and j < len(r):
        if l[i] <= r[j]:
            o.append(l[i])
            i += 1
        else:
            o.append(r[j])
            j += 1
    return o + l[i:] + r[j:]
