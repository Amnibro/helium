		}
		if is(K_AS) { let n = mk(N_AS, st); ND[n].fl = if is(T_NOT) { 1 } else { 0 }; ND[n].a = e as i32; { let q_ = ptype(); ND[n].b = q_ as i32; } e = n; continue; }
		return e;
	}
}
fn pcall(callee int, tyargs int, st int) int {
	let c = mk(N_CALL, st); ND[c].a = callee as i32; ND[c].c = tyargs as i32;
