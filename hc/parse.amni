import lex;
let N_INT = 1; let N_FLT = 2; let N_STR = 3; let N_TRUE = 4; let N_FALSE = 5; let N_NULL = 6; let N_SELF = 7; let N_ID = 8;
let N_BIN = 9; let N_UN = 10; let N_CALL = 11; let N_IDX = 12; let N_SLICE = 13; let N_DOT = 14; let N_AS = 15; let N_ARR = 16; let N_SLIT = 17; let N_FI = 18;
let N_IF = 19; let N_MATCH = 20; let N_ARM = 21; let N_PITEM = 22; let N_BLOCK = 23; let N_EBLOCK = 24; let N_WHILE = 25; let N_LOOP = 26; let N_FOR = 27;
let N_RET = 28; let N_BREAK = 29; let N_CONT = 30; let N_FUNVAL = 31; let N_PARAM = 32; let N_VDECL = 33; let N_ASSIGN = 34; let N_INCDEC = 35; let N_LIST = 36; let N_CFOR = 37;
let N_TPRIM = 40; let N_TNAME = 41; let N_TARR = 42; let N_TSLICE = 43; let N_TREF = 44; let N_TFN = 45; let N_TVAR = 46; let N_TIDX = 47; let N_TCONST = 48;
let N_FN = 50; let N_STRUCT = 51; let N_ENUM = 52; let N_ALIAS = 53; let N_IMPORT = 54; let N_FIELD = 55; let N_VARIANT = 56; let N_GEN = 57; let N_EXT = 58;
let A_FIXED = 1; let A_VAR = 2; let A_LIM = 3; let A_GROW = 4; let A_GS = 5;
let F_EXTERN = 1; let F_EXPORT = 2; let F_SIMD = 4; let F_INLINE = 8; let F_REC = 16; let F_THREAD = 32; let F_CHECKFREE = 64; let F_NESTED = 128; let F_LUT = 256; let F_RETS = 512;
let V_VAR = 1; let V_CONST = 2; let V_BYREF = 4; let V_GLOBAL = 8; let V_REUSE = 16; let V_REUSE_SL = 32; let V_RESULTS = 64;
struct Node { k u8, op u8, fl u16, t i32, a i32, b i32, c i32, d i32, e i32, s i32, l i32, n i32 }
var ND Node[>..];
var LS i32[>..];
var WS i32[>..<];
var TOP i32[>..];
var FILENS i32[>..];
var P int;
var PERR byte[>..];
var TENT int;
var TFAIL bool;
var NOSL bool;
var STMTL bool;
var STMTE bool;
var CURNS int = -1;
var FILENS0 int = -1;
var SPLITS int[>..];
var NEND i32[>..];
fn set_end(n int) { while NEND.len < ND.len { NEND.push(-1); } NEND[n] = ND.len as i32; }
var NAME_FROM int = -1; var NAME_INLINE int = -1; var NAME_CHECKFREE int = -1; var NAME_LUT int = -1; var NAME_UNDER int = -1; var NAME_UPTO int = -1;
var NAME_FIELDS int = -1; var NAME_TYPES int = -1; var NAME_VARIANTS int = -1; var NAME_STD int = -1;
fn mk(k int, t int) int { ND.push(Node { k: k as u8, t: t as i32, a: -1, b: -1, c: -1, d: -1, e: -1, s: -1, l: 0, n: 0, .. }); ND.len - 1 }
fn tk() int { TK[P].k as int }
fn tkat(i int) int { TK[min(i, TK.len - 1)].k as int }
fn nx() { if TK[P].k != T_EOF { P++; } }
fn is(k int) bool { if tk() == k { nx(); return true; } false }
fn tname(k int) const byte[:] {
	let pu = ["(", ")", "[", "]", "{", "}", ",", ";", ":", "?", "::", ".", "..", ".=", ".==", ".!=", "+", "-", "*", "/", "%", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "++", "--", "=", "==", "!=", "<", ">", "<=", ">=", "<<", ">>", "<<=", ">>=", "!", "~", "&", "|", "^", "&&", "||", "->", "=>"];
	if k == T_EOF { return "end of file"; } if k == T_IDENT { return "identifier"; } if k == T_INT { return "integer literal"; } if k == T_FLT { return "float literal"; } if k == T_STR { return "string literal"; }
	if k >= T_KW { return nm(k - T_KW); }
	pu[k - T_LP]
}
fn perr(m const byte[:]) {
	if TENT > 0 { TFAIL = true; P = TK.len - 1; return; }
	if PERR.len > 0 { return; }
	let t = TK[P];
	PERR.append(nm(FILES[t.f].name)); format(PERR, ":", t.line, ": error: ", m);
	P = TK.len - 1;
}
fn cur_text() const byte[:] { let k = tk(); if k == T_IDENT || k == T_INT || k == T_FLT { tok_text(P) } else { tname(k) } }
fn ex(k int, ctx const byte[:]) { if tk() != k { var m byte[>..] = []; format(m, "expected '", tname(k), "' in ", ctx, ", found '", cur_text(), "'"); perr(m); return; } nx(); }
fn ident(ctx const byte[:]) int { if tk() != T_IDENT { var m byte[>..] = []; format(m, "expected identifier in ", ctx, ", found '", cur_text(), "'"); perr(m); return -1; } let v = TK[P].v as int; nx(); v }
fn close_angle(ctx const byte[:]) { if tk() == T_SHR { SPLITS.push(P); TK[P].k = T_GT as u8; return; } ex(T_GT, ctx); }
fn wbeg() int { WS.len }
fn wend(m int) int { let l = LS.len; for i in m..WS.len { LS.push(WS[i]); } WS.pop_n(WS.len - m); l }
fn setl(n int, m int) { let c = WS.len - m; { let q_ = wend(m); ND[n].l = q_ as i32; } ND[n].n = c as i32; }
fn kid(n int, i int) int { LS[(ND[n].l as int) + i] as int }
fn qcat(a int, b int) int { var s byte[>..] = []; if a >= 0 { s.append(nm(a)); } s.append("::"); s.append(nm(b)); intern(s) }
fn qname(ctx const byte[:]) int {
	if is(T_CC) { return qcat(-1, ident(ctx)); }
	let a = ident(ctx);
	if !is(T_CC) { return a; }
	qcat(a, ident(ctx))
}
fn declname(ctx const byte[:]) int {
	let a = if tk() == T_CC { -1 } else { ident(ctx) };
