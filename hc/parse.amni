		if is(T_LP) { e = pcall(e, -1, st); continue; }
		if tk() == T_LB { e = pindex(e); continue; }
		if is(T_DOT) {
			let nmid = ident("field access");
			if tk() == T_LC && !NOSL && ND[e].k == N_ID {
				let b = mk(N_TNAME, ND[e].t as int); ND[b].s = ND[e].s;
