fn pbound() int {
	let st = P;
	let neg = is(T_MINUS);
	if tk() == T_IDENT || tk() == T_CC { let n = mk(N_ID, P); { let q_ = qname("match pattern"); ND[n].s = q_ as i32; } if neg { let u = mk(N_UN, st); ND[u].op = T_MINUS as u8; ND[u].a = n as i32; return u; } return n; }
