	if k == T_MINUS || k == T_NOT || k == T_BITNOT || k == T_AND {
		let st = P; nx();
		let s = sub_begin(NOSL);
		let a = pun();
		sub_end(s);
		let n = mk(N_UN, st); ND[n].op = k as u8; ND[n].a = a as i32;
