}
fn at_word(w int) bool { tk() == T_IDENT && TK[P].v == w }
fn at_inline() bool { at_word(NAME_INLINE) && (tkat(P + 1) == K_FN || tkat(P + 1) == K_RECURSIVE || tkat(P + 1) == K_THREADFN) }
fn at_checkfree() bool { let n = tkat(P + 1); at_word(NAME_CHECKFREE) && (n == K_FN || n == K_RECURSIVE || n == K_THREADFN || n == K_SIMD || n == K_EXTERN || n == T_IDENT) }
fn at_lut() bool { at_word(NAME_LUT) && tkat(P + 1) == K_FN }
fn prim_tok(k int) bool { k >= K_BOOL && k <= K_REAL }
fn amni_type() bool { let k = tk(); FILES[TK[P].f].amni && (prim_tok(k) || k == T_IDENT || k == T_CC || k == K_FN || k == T_LP || k == K_CONST) }
fn lenstore() int { let k = tk(); if k == K_U8 || k == K_U16 || k == K_U32 || k == K_U64 || k == K_VARINT || k == K_BYTE || k == K_UINT { nx(); return k; } perr("unsigned integer storage type or varint expected"); 0 }
var FORBIND bool;
recursive fn ptype() int {
	let cq = is(K_CONST);
	var t = ptype_prim();
	var q = cq;
	loop {
		let st = P;
		if is(T_LB) {
			if is(T_COLON) { ex(T_RB, "slice type"); let n = mk(N_TSLICE, st); ND[n].a = t as i32; if q { ND[n].fl = 1; q = false; } t = n; continue; }
			let n = mk(N_TARR, st); ND[n].a = t as i32;
			if is(T_RB) { ND[n].op = A_VAR as u8; t = n; continue; }
			if is(T_DOTDOT) { ND[n].op = A_LIM as u8; if tk() != T_RB { { let q_ = pexpr(); ND[n].b = q_ as i32; } } }
			else { if is(T_GT) { ex(T_DOTDOT, "resizable array type"); ND[n].op = if is(T_LT) { A_GS as u8 } else { A_GROW as u8 }; }
			else { if prim_tok(tk()) { ND[n].op = A_VAR as u8; { let q_ = lenstore(); ND[n].c = q_ as i32; } }
			else { ND[n].op = A_FIXED as u8; { let q_ = pexpr(); ND[n].b = q_ as i32; } } } }
			ex(T_RB, "array type");
			t = n; continue;
		}
		if is(T_AND) {
			let n = mk(N_TREF, st); ND[n].a = t as i32; if q { ND[n].fl = 1; q = false; }
			if is(T_LT) { { let q_ = lenstore(); ND[n].c = q_ as i32; } if is(K_IN) { { let q_ = qname("relative reference pool"); ND[n].s = q_ as i32; } } close_angle("relative reference width"); }
			t = n; continue;
		}
		if is(T_QUEST) {
			if ND[t].k == N_TREF { ND[t].fl |= 2; } else { let n = mk(N_TREF, st); ND[n].a = t as i32; ND[n].fl = 2; if q { ND[n].fl |= 1; q = false; } t = n; }
			continue;
		}
		if tk() == T_DOTDOT { nx(); if ND[t].k == N_TNAME { ND[t].fl |= 1; } else { perr("variable mode (..) applies only to ADT type names"); } continue; }
		if is(T_DOT) { let n = mk(N_TVAR, st); ND[n].a = t as i32; { let q_ = ident("variant type"); ND[n].s = q_ as i32; } t = n; continue; }
		if q { let n = mk(N_TCONST, st); ND[n].a = t as i32; t = n; }
		return t;
	}
}
fn ptype_prim() int {
	let st = P;
	let k = tk();
	if prim_tok(k) {
		nx();
		let up = at_word(NAME_UPTO);
		if (k >= K_I8 && k <= K_U64 || k == K_BYTE || k == K_UINT || k == K_INT) && !FORBIND && (tk() == K_IN || up) {
			nx(); let n = mk(N_TIDX, st); ND[n].op = k as u8; ND[n].fl = if up { 1 } else { 0 }; { let q_ = qname("index type"); ND[n].s = q_ as i32; } return n;
		}
		let n = mk(N_TPRIM, st); ND[n].op = k as u8; return n;
	}
	if k == T_IDENT || k == T_CC {
		let n = mk(N_TNAME, st); { let q_ = qname("type"); ND[n].s = q_ as i32; }
		if is(T_LT) { let m = wbeg(); loop { WS.push(ptype() as i32); if !is(T_COMMA) { break; } if tk() == T_GT || tk() == T_SHR { break; } } close_angle("type argument list"); setl(n, m); }
		return n;
	}
	if is(K_FN) {
		let n = mk(N_TFN, st);
		if is(T_LP) {
			ND[n].fl = 1;
			let m = wbeg(); while tk() != T_RP && tk() != T_EOF { WS.push(ptype() as i32); if !is(T_COMMA) { break; } } ex(T_RP, "function type"); setl(n, m);
			if is(T_ARROW) {
				let r = mk(N_LIST, P); let m2 = wbeg();
				if is(T_LP) { while tk() != T_RP && tk() != T_EOF { WS.push(ptype() as i32); if !is(T_COMMA) { break; } } ex(T_RP, "function type return list"); } else { WS.push(ptype() as i32); }
				setl(r, m2); ND[n].b = r as i32;
			}
		}
		return n;
	}
	if is(T_LP) { let fb = FORBIND; FORBIND = false; let t = ptype(); FORBIND = fb; ex(T_RP, "parenthesized type"); return t; }
	var m byte[>..] = []; format(m, "type expected, found '", cur_text(), "'"); perr(m);
	mk(N_TPRIM, st)
}
recursive fn pexpr() int {
	let st = P;
	let k = tk();
	if k == K_IF { let e = pif(); if STMTL { STMTE = true; } return e; }
	if k == K_MATCH { let e = pmatch(); if STMTL { STMTE = true; } return e; }
	if k == K_BLOCK { nx(); let e = mk(N_EBLOCK, st); { let q_ = pblock("block expression"); ND[e].a = q_ as i32; } if STMTL { STMTE = true; } return e; }
	if k == T_LC { let e = pblock("block"); if STMTL { STMTE = true; } return e; }
	if k == K_WHILE { nx(); let e = mk(N_WHILE, st); { let q_ = pscrut(); ND[e].a = q_ as i32; } { let q_ = pblock("while body"); ND[e].b = q_ as i32; } if STMTL { STMTE = true; } return e; }
	if k == K_LOOP { nx(); let e = mk(N_LOOP, st); { let q_ = pblock("loop body"); ND[e].a = q_ as i32; } if STMTL { STMTE = true; } return e; }
	if k == K_FOR { let e = pfor(); if STMTL { STMTE = true; } return e; }
	if k == K_GUARD { perr("guard is a statement: it guards the rest of the block it is in"); return mk(N_NULL, st); }
	if k == K_RETURN {
		nx();
		let sl = STMTL; let se = STMTE; STMTL = false; STMTE = false;
		let r = mk(N_RET, st);
		if tk() != T_SEMI && tk() != T_RC && !at_from() { let m = wbeg(); loop { WS.push(pexpr() as i32); if !is(T_COMMA) { break; } } setl(r, m); }
		if at_from() { nx(); { let q_ = qname("return from"); ND[r].s = q_ as i32; } }
		STMTL = sl; STMTE = se;
		return r;
	}
	if k == K_BREAK {
		nx();
		let sl = STMTL; let se = STMTE; STMTL = false; STMTE = false;
		let r = mk(N_BREAK, st);
		if tk() != T_SEMI && tk() != T_RC { { let q_ = pexpr(); ND[r].a = q_ as i32; } }
		STMTL = sl; STMTE = se;
		return r;
	}
	if k == K_CONTINUE { nx(); return mk(N_CONT, st); }
	pbin(1)
}
fn at_from() bool { at_word(NAME_FROM) && (tkat(P + 1) == T_IDENT || tkat(P + 1) == T_CC) }
fn sub_begin(nosl bool) int { let s = (if NOSL { 1 } else { 0 }) | (if STMTL { 2 } else { 0 }) | (if STMTE { 4 } else { 0 }); NOSL = nosl; STMTL = false; STMTE = false; s }
fn sub_end(s int) { NOSL = (s & 1) != 0; STMTL = (s & 2) != 0; STMTE = (s & 4) != 0; }
fn pscrut() int { let s = sub_begin(true); let e = pexpr(); sub_end(s); e }
recursive fn pif() int {
	let st = P; nx();
	let n = mk(N_IF, st);
	{ let q_ = pscrut(); ND[n].a = q_ as i32; }
	{ let q_ = pblock("if body"); ND[n].b = q_ as i32; }
	if is(K_ELSE) { { let q_ = (if tk() == K_IF { pif() } else { pblock("else body") }); ND[n].c = q_ as i32; } }
	n
}
fn pfor() int {
	let st = P; nx();
	let n = mk(N_FOR, st);
	if is(T_AND) { ND[n].fl = 1; }
	{ let q_ = ident("for binding"); ND[n].s = q_ as i32; }
	let fb = FORBIND; FORBIND = true;
	ND[n].l = -1; ND[n].n = -1;
	if is(T_COLON) { { let q_ = ptype(); ND[n].l = q_ as i32; } }
	if is(T_COMMA) { { let q_ = ident("for index binding"); ND[n].c = q_ as i32; } if is(T_COLON) { { let q_ = ptype(); ND[n].n = q_ as i32; } } }
	FORBIND = fb;
	ex(K_IN, "for statement");
	let s = sub_begin(true);
	{ let q_ = pexpr(); ND[n].a = q_ as i32; }
	if is(T_DOTDOT) { { let q_ = pexpr(); ND[n].b = q_ as i32; } }
	sub_end(s);
	{ let q_ = pblock("for body"); ND[n].d = q_ as i32; }
	n
}
fn pmatch() int {
	let st = P; nx();
	let n = mk(N_MATCH, st);
	{ let q_ = pscrut(); ND[n].a = q_ as i32; }
	ex(T_LC, "match expression");
	parms(n);
	ex(T_RC, "match expression");
	if ND[n].n == 0 && PERR.len == 0 { perr("match must have at least one arm"); }
	n
}
fn parms(n int) {
	let s = sub_begin(NOSL);
	let m = wbeg();
	while tk() != T_RC && tk() != T_EOF {
		if tk() == K_CONST && tkat(P + 1) == K_FOR { WS.push(pcfor(2) as i32); }
		else { let a = ppattern(); ex(T_FAT, "match arm"); { let q_ = pexpr(); ND[a].b = q_ as i32; } WS.push(a as i32); }
		if !is(T_COMMA) { break; }
	}
	setl(n, m);
	sub_end(s);
}
fn ppattern() int {
	let a = mk(N_ARM, P);
	if at_word(NAME_UNDER) { nx(); ND[a].fl = 1; if tk() == T_COMMA { perr("_ cannot be listed with other patterns"); } return a; }
	let m = wbeg();
	loop {
		let it = mk(N_PITEM, P);
		{ let q_ = pbound(); ND[it].a = q_ as i32; }
		if is(T_DOTDOT) { { let q_ = pbound(); ND[it].b = q_ as i32; } }
		WS.push(it as i32);
		let lo = ND[it].a as int;
		if ND[lo].k == N_ID && ND[it].b < 0 && (tk() == T_AND || tk() == T_IDENT) {
			var hasq = false; for c in nm(ND[lo].s as int) { if c == ':' { hasq = true; } }
			if !hasq {
				if WS.len - m > 1 { perr("a list of patterns binds no payload: give the variant an arm of its own"); }
				if is(T_AND) { ND[a].fl |= 2; }
				{ let q_ = ident("match binding"); ND[a].s = q_ as i32; }
				if tk() == T_COMMA { perr("a list of patterns binds no payload: give the variant an arm of its own"); }
				setl(a, m);
				return a;
			}
		}
		if !is(T_COMMA) { break; }
