fn pprim() int {
	let st = P;
	let k = tk();
	if k == T_INT { nx(); return mk(N_INT, st); }
	if k == T_FLT { nx(); return mk(N_FLT, st); }
	if k == T_STR { nx(); return mk(N_STR, st); }
	if k == K_TRUE { nx(); return mk(N_TRUE, st); }
	if k == K_FALSE { nx(); return mk(N_FALSE, st); }
	if k == K_NULL { nx(); return mk(N_NULL, st); }
	if k == K_SELF { nx(); return mk(N_SELF, st); }
	if k == T_LP { nx(); let s = sub_begin(false); let e = pexpr(); ex(T_RP, "parenthesized expression"); sub_end(s); return e; }
	if k == T_LB { return parray(); }
	if k == T_IDENT || k == T_CC {
		let name = qname("expression");
		if tk() == T_LT {
			let ta = try_tyargs();
			if ta >= 0 {
				if is(T_LP) { let id = mk(N_ID, st); ND[id].s = name as i32; return pcall(id, ta, st); }
				let t = mk(N_TNAME, st); ND[t].s = name as i32; ND[t].l = ND[ta].l; ND[t].n = ND[ta].n;
				if is(T_DOT) { let v = mk(N_TVAR, st); ND[v].a = t as i32; { let q_ = ident("variant literal"); ND[v].s = q_ as i32; } return pslit(v, st); }
				return pslit(t, st);
			}
		}
		if tk() == T_LC && !NOSL { let t = mk(N_TNAME, st); ND[t].s = name as i32; return pslit(t, st); }
		let id = mk(N_ID, st); ND[id].s = name as i32;
		return id;
	}
	var m byte[>..] = []; format(m, "expression expected, found '", cur_text(), "'"); perr(m);
	mk(N_NULL, st)
}
fn try_tyargs() int {
	let save = P; let nd0 = ND.len; let ls0 = LS.len; let sp0 = SPLITS.len; let ws0 = WS.len;
	TENT++;
	nx();
	let l = mk(N_LIST, save);
	let m = wbeg();
	var ok = false;
	loop { WS.push(ptype() as i32); if TFAIL || !is(T_COMMA) { break; } if tk() == T_GT || tk() == T_SHR { break; } }
	if !TFAIL {
		if tk() == T_SHR { SPLITS.push(P); TK[P].k = T_GT as u8; ok = true; } else { if tk() == T_GT { nx(); ok = true; } }
		if ok {
			ok = false;
			if tk() == T_LP || (tk() == T_LC && !NOSL) { ok = true; }
			if tk() == T_DOT && !NOSL && tkat(P + 1) == T_IDENT && tkat(P + 2) == T_LC { ok = true; }
		}
	}
	TENT--;
	if ok && !TFAIL { setl(l, m); return l; }
	TFAIL = false;
	while SPLITS.len > sp0 { let q = SPLITS.pop(); TK[q].k = T_SHR as u8; }
	if WS.len > ws0 { WS.pop_n(WS.len - ws0); }
	ND.resize(nd0, Node { .. }); LS.resize(ls0, 0);
	P = save;
	-1
}
fn parray() int {
	let st = P; nx();
	let a = mk(N_ARR, st);
	let s = sub_begin(false);
	if is(T_DOTDOT) { { let q_ = pexpr(); ND[a].c = q_ as i32; } }
	else {
		if tk() != T_RB {
			let first = pexpr();
			if is(T_SEMI) { ND[a].a = first as i32; { let q_ = pexpr(); ND[a].b = q_ as i32; } }
			else { let m = wbeg(); WS.push(first as i32); while is(T_COMMA) && tk() != T_RB { WS.push(pexpr() as i32); } setl(a, m); }
		}
	}
	ex(T_RB, "array literal");
	sub_end(s);
	a
}
recursive fn pcfor(mode int) int {
	let cf = mk(N_CFOR, P);
	ex(K_CONST, "const for"); ex(K_FOR, "const for"); ex(T_LT, "const for bindings");
	let nb = mk(N_LIST, P); let m = wbeg();
	loop { WS.push(ident("const for binding") as i32); if !is(T_COMMA) || tk() == T_GT { break; } }
	setl(nb, m);
	close_angle("const for bindings");
	ex(K_IN, "const for");
	ND[cf].a = nb as i32;
	let src = mk(N_LIST, P);
	if is(T_LB) {
		ND[cf].op = 1;
		let s = sub_begin(false); let m2 = wbeg();
		while tk() != T_RB && tk() != T_EOF { WS.push(pexpr() as i32); if !is(T_COMMA) { break; } }
		ex(T_RB, "const for constant list"); setl(src, m2); sub_end(s);
	} else {
		let q = ident("const for source");
		ND[cf].op = (if q == NAME_FIELDS { 2 } else { if q == NAME_VARIANTS { 3 } else { if q == NAME_TYPES { 4 } else { 0 } } }) as u8;
		if ND[cf].op == 0 { perr("const for source must be fields<T>, variants<E>, types<...>, or [constants]"); }
		ex(T_LT, "const for source");
		let m2 = wbeg(); while tk() != T_GT && tk() != T_SHR && tk() != T_EOF { WS.push(ptype() as i32); if !is(T_COMMA) { break; } } close_angle("const for source"); setl(src, m2);
	}
	ND[cf].b = src as i32;
	ND[cf].fl = mode as u16;
	if mode == 1 { let il = mk(N_LIST, P); pinits(il, true); ND[cf].c = il as i32; }
	else { if mode == 2 { ex(T_LC, "const for arms"); let al = mk(N_LIST, P); parms(al); ex(T_RC, "const for arms"); ND[cf].c = al as i32; } else { { let q_ = pblock("const for body"); ND[cf].c = q_ as i32; } } }
	ND[cf].d = ND.len as i32;
	cf
}
fn pinits(n int, frag bool) {
	ex(T_LC, "constructor initializers");
	let s = sub_begin(false);
	let m = wbeg();
	while tk() != T_RC && tk() != T_EOF {
		if is(T_DOTDOT) { if frag { perr("trailing .. belongs to the whole constructor, not a const for fragment"); } ND[n].fl |= 1; break; }
		if tk() == K_CONST && tkat(P + 1) == K_FOR { WS.push(pcfor(1) as i32); if !is(T_COMMA) { break; } continue; }
		let fi = mk(N_FI, P);
		if tk() == T_IDENT && tkat(P + 1) == T_COLON { ND[fi].s = TK[P].v as i32; nx(); nx(); }
		{ let q_ = pexpr(); ND[fi].a = q_ as i32; }
		WS.push(fi as i32);
		if !is(T_COMMA) { break; }
	}
	ex(T_RC, "struct literal");
	setl(n, m);
	sub_end(s);
}
fn pslit(ty int, st int) int {
	let n = mk(N_SLIT, st); ND[n].a = ty as i32;
	pinits(n, false);
	var named = 0; var cf = false;
	for i in ND[n].n { let fi = kid(n, i); if ND[fi].k == N_CFOR { cf = true; } else { if ND[fi].s >= 0 { named++; } } }
	if !cf && named > 0 && named != ND[n].n { perr("struct literal mixes named and positional initializers"); }
	n
}
fn pfunval() int {
	let st = P;
	ex(T_LC, "function value");
	let fv = mk(N_FUNVAL, st);
	let b = mk(N_BLOCK, st);
	ND[fv].a = b as i32;
	if tk() == T_IDENT || tk() == K_VAR {
		let save = P; let nd0 = ND.len; let ws0 = WS.len;
		TENT++;
		var ok = true;
		let m = wbeg();
		loop {
			let pv = is(K_VAR);
			if tk() != T_IDENT { ok = false; break; }
			let p = mk(N_PARAM, P); ND[p].s = TK[P].v as i32; if pv { ND[p].fl = 1; } nx();
			if is(T_COLON) { { let q_ = ptype(); ND[p].a = q_ as i32; } }
			WS.push(p as i32);
			if TFAIL || !is(T_COMMA) { break; }
		}
		if TFAIL || !ok || !is(T_FAT) { ok = false; }
		TENT--;
		if ok { setl(fv, m); ND[fv].fl = 1; }
		else { TFAIL = false; if WS.len > ws0 { WS.pop_n(WS.len - ws0); } ND.resize(nd0, Node { .. }); P = save; }
	}
	pbody(b);
	set_end(fv);
	fv
}
recursive fn pblock(ctx const byte[:]) int { let st = P; ex(T_LC, ctx); let b = mk(N_BLOCK, st); pbody(b); b }
recursive fn pbody(b int) {
	let s = sub_begin(false);
	let m = wbeg();
	loop {
		STMTL = false; STMTE = false;
		if is(T_RC) { break; }
		if tk() == T_EOF { perr("expected '}' before end of file"); break; }
		if !pstmt(b) { break; }
	}
	setl(b, m);
	sub_end(s);
}
fn pstmt(b int) bool {
	let k = tk();
	if at_inline() || at_checkfree() || at_lut() || k == K_RECURSIVE || k == K_FN || k == K_THREADFN || k == K_EXTERN || k == K_EXPORT || k == K_SIMD { WS.push(pfn(true, -1, -1) as i32); return true; }
	if k == K_LET || k == K_VAR || k == K_CONST || k == K_REUSABLE {
		if k == K_CONST && tkat(P + 1) == K_FOR { WS.push(pcfor(0) as i32); return true; }
		let v = pvdecl(false); ex(T_SEMI, "variable declaration"); WS.push(v as i32); return true;
	}
	if k == K_GUARD { pguard(b); return false; }
	STMTL = true;
	let e = pexpr();
	STMTL = false;
	let st = P;
	if !STMTE {
		let o = tk();
		if o == T_ASSIGN || o == T_DOTASSIGN || o == T_PLUSEQ || o == T_MINUSEQ || o == T_MULEQ || o == T_DIVEQ || o == T_MODEQ || o == T_ANDEQ || o == T_OREQ || o == T_XOREQ || o == T_SHLEQ || o == T_SHREQ {
			nx(); let r = pexpr(); ex(T_SEMI, "assignment statement");
			let n = mk(N_ASSIGN, st); ND[n].op = o as u8; ND[n].a = e as i32; ND[n].b = r as i32; WS.push(n as i32); return true;
		}
		if o == T_INC || o == T_DEC { nx(); ex(T_SEMI, "increment statement"); let n = mk(N_INCDEC, st); ND[n].op = o as u8; ND[n].a = e as i32; WS.push(n as i32); return true; }
		if o == T_COMMA { WS.push(pmulti(e, st) as i32); return true; }
	}
	if is(T_SEMI) { WS.push(e as i32); return true; }
	if is(T_RC) { ND[b].a = e as i32; return false; }
	if STMTE { WS.push(e as i32); return true; }
	var m byte[>..] = []; format(m, "';' expected after expression, found '", cur_text(), "'"); perr(m);
	false
}
fn pmulti(first int, st int) int {
	let tl = mk(N_LIST, st);
	let m = wbeg(); WS.push(first as i32);
	while is(T_COMMA) { WS.push(pexpr() as i32); }
	setl(tl, m);
	let o = tk();
	if o == T_DOTASSIGN || o == T_PLUSEQ || o == T_MINUSEQ || o == T_MULEQ || o == T_DIVEQ || o == T_MODEQ || o == T_ANDEQ || o == T_OREQ || o == T_XOREQ || o == T_SHLEQ || o == T_SHREQ { perr("several targets take a call's results with `=` alone (§7.1)"); }
	if tk() != T_ASSIGN { perr("several values exist only in `return a, b;` and in a call's results, so a block or branch cannot end in `a, b`: return from each branch instead (§7.1)"); }
	nx();
	let n = mk(N_ASSIGN, st); ND[n].op = T_COMMA as u8; ND[n].a = tl as i32; { let q_ = pexpr(); ND[n].b = q_ as i32; }
	ex(T_SEMI, "assignment statement");
	n
}
fn pguard(b int) {
	let st = P; nx();
	let c = pscrut();
	var eb = -1;
	if is(K_ELSE) { eb = pblock("guard else"); is(T_SEMI); } else { ex(T_SEMI, "guard"); }
	let rest = mk(N_BLOCK, st);
	pbody(rest);
	let i = mk(N_IF, st); ND[i].a = c as i32; ND[i].b = rest as i32; ND[i].c = eb as i32; ND[i].fl = 1;
	if ND[rest].a >= 0 { ND[b].a = i as i32; } else { WS.push(i as i32); }
}
fn pvdecl(glob bool) int {
	let st = P;
	var fl = if glob { V_GLOBAL } else { 0 };
	if is(K_REUSABLE) { fl |= V_REUSE; if is(T_LB) { ex(T_RB, "reusable[]"); fl |= V_REUSE_SL; } }
	if is(K_VAR) { fl |= V_VAR; } else { if is(K_LET) { } else { if is(K_CONST) { fl |= V_CONST; } else { perr("let, var or const expected"); } } }
	let v = mk(N_VDECL, st);
	let m = wbeg();
	loop { WS.push((if glob { declname("global declaration") } else { ident("variable declaration") }) as i32); if !is(T_COMMA) { break; } }
	setl(v, m);
	ND[v].c = CURNS as i32;
	if is(T_COLON) || amni_type() { { let q_ = ptype(); ND[v].a = q_ as i32; } }
	if is(T_DOTASSIGN) { fl |= V_BYREF; }
	if (fl & V_BYREF) != 0 || is(T_ASSIGN) { let il = mk(N_LIST, P); let m2 = wbeg(); loop { WS.push(pexpr() as i32); if !is(T_COMMA) { break; } } setl(il, m2); ND[v].b = il as i32; }
	ND[v].fl = fl as u16;
	if glob {
		if ND[v].b < 0 && (fl & V_VAR) == 0 { perr("let and const global declarations require an initializer"); }
		if ND[v].n != 1 { perr("global declarations declare a single name"); }
	}
	v
}
fn pgenerics() int {
	if !is(T_LT) { return -1; }
	let l = mk(N_LIST, P);
	let m = wbeg();
	loop {
		let g = mk(N_GEN, P); { let q_ = ident("generic parameter list"); ND[g].s = q_ as i32; }
		if is(T_COLON) { { let q_ = ptype(); ND[g].a = q_ as i32; } }
		WS.push(g as i32);
		if !is(T_COMMA) { break; }
		if tk() == T_GT || tk() == T_SHR { break; }
	}
	close_angle("generic parameter list");
	setl(l, m);
	l
}
fn pfields(n int, ctx const byte[:]) {
	let m = wbeg();
	while tk() != T_RC && tk() != T_EOF {
		let f = mk(N_FIELD, P);
		if is(K_PAD) { ND[f].fl = 4; if tk() == T_INT { ND[f].c = TK[P].v as i32; nx(); } }
		else {
			let cq = is(K_CONST);
			if cq || is(K_LET) { ND[f].fl = if cq { 3 } else { 1 }; }
			{ let q_ = ident(ctx); ND[f].s = q_ as i32; }
			if !amni_type() { ex(T_COLON, ctx); }
			{ let q_ = ptype(); ND[f].a = q_ as i32; }
			if is(T_ASSIGN) { { let q_ = pexpr(); ND[f].b = q_ as i32; } }
		}
		WS.push(f as i32);
		if !is(T_COMMA) { break; }
	}
	setl(n, m);
}
fn pstruct() int {
	let st = P; nx();
	let n = mk(N_STRUCT, st);
	{ let q_ = declname("struct declaration"); ND[n].s = q_ as i32; } ND[n].a = CURNS as i32;
	{ let q_ = pgenerics(); ND[n].d = q_ as i32; }
	ex(T_LC, "struct declaration");
	pfields(n, "struct body");
	ex(T_RC, "struct declaration");
	n
}
fn penum() int {
	let st = P; nx();
	let n = mk(N_ENUM, st);
	{ let q_ = declname("enum declaration"); ND[n].s = q_ as i32; } ND[n].a = CURNS as i32;
	{ let q_ = pgenerics(); ND[n].d = q_ as i32; }
	ex(T_LC, "enum declaration");
	let m = wbeg();
	while tk() != T_RC && tk() != T_EOF {
		let v = mk(N_VARIANT, P); { let q_ = ident("enum variant"); ND[v].s = q_ as i32; }
		if is(T_LC) { ND[v].fl = 1; pfields(v, "variant body"); ex(T_RC, "enum variant"); }
		WS.push(v as i32);
		if !is(T_COMMA) { break; }
	}
	setl(n, m);
	ex(T_RC, "enum declaration");
	n
}
recursive fn pfn(nested bool, cname int, dylib int) int {
	let st = P;
	let n = mk(N_FN, st);
	var fl = if nested { F_NESTED } else { 0 };
	var cn = cname;
	if cname >= 0 || dylib >= 0 { fl |= F_EXTERN; }
	if at_lut() { nx(); fl |= F_LUT; }
	if at_checkfree() { nx(); fl |= F_CHECKFREE; }
	if is(K_EXPORT) { fl |= F_EXPORT; if tk() == T_STR { cn = P; nx(); } }
	if is(K_EXTERN) { fl |= F_EXTERN; if tk() == T_STR { cn = P; nx(); } }
	if at_checkfree() { nx(); fl |= F_CHECKFREE; }
	if is(K_SIMD) { fl |= F_SIMD; }
	if at_inline() { nx(); fl |= F_INLINE; }
	if is(K_RECURSIVE) { fl |= F_REC; }
	if is(K_THREADFN) { fl |= F_THREAD; } else { ex(K_FN, "function declaration"); }
	{ let q_ = (if nested { ident("function declaration") } else { declname("function declaration") }); ND[n].s = q_ as i32; }
	ND[n].a = CURNS as i32;
	{ let q_ = pgenerics(); ND[n].d = q_ as i32; }
	ex(T_LP, "function declaration");
	let m = wbeg();
	while tk() != T_RP && tk() != T_EOF {
		let p = mk(N_PARAM, P);
		if is(K_VAR) { ND[p].fl = 1; }
		{ let q_ = ident("parameter list"); ND[p].s = q_ as i32; }
		if is(T_COLON) || amni_type() { { let q_ = ptype(); ND[p].a = q_ as i32; } }
		if is(T_ASSIGN) { { let q_ = pexpr(); ND[p].b = q_ as i32; } }
		WS.push(p as i32);
		if !is(T_COMMA) { break; }
	}
	ex(T_RP, "function declaration");
	setl(n, m);
	if is(T_ARROW) || amni_type() {
		fl |= F_RETS;
		let r = mk(N_LIST, P); let m2 = wbeg();
		loop { WS.push(ptype() as i32); if !is(T_COMMA) { break; } }
		setl(r, m2); ND[n].b = r as i32;
	}
	if (fl & F_EXTERN) != 0 {
		if is(T_ASSIGN) { if tk() != T_STR { perr("an extern fn's symbol is a string: fn name(...) = \"symbol\"; (§7.10)"); } cn = P; nx(); }
		ex(T_SEMI, "extern declaration");
		let x = mk(N_EXT, st); ND[x].a = cn as i32; ND[x].b = dylib as i32; ND[n].e = x as i32;
	} else {
		if (fl & F_EXPORT) != 0 { let x = mk(N_EXT, st); ND[x].a = cn as i32; ND[n].e = x as i32; }
		{ let q_ = pblock("function body"); ND[n].c = q_ as i32; }
	}
	ND[n].fl = fl as u16;
	set_end(n);
	n
}
fn ptop() {
	let st = P;
	CURNS = FILENS0;
	let k = tk();
	if k == K_NAMESPACE { nx(); FILENS0 = ident("namespace declaration"); CURNS = FILENS0; ex(T_SEMI, "namespace declaration"); return; }
	if k == K_IMPORT {
		nx();
		let n = mk(N_IMPORT, st);
		if is(T_DOT) { ND[n].fl = 1; }
		var path byte[>..] = [];
		path.append(nm(ident("import")));
		while is(T_DOT) { path.push('/'); path.append(nm(ident("import"))); }
		{ let q_ = intern(path); ND[n].s = q_ as i32; }
		if at_from() || at_word(NAME_FROM) { nx(); if tk() != T_STR { perr("expected the package's source, a string, after from"); } ND[n].a = P as i32; nx(); }
		ex(T_SEMI, "import");
		TOP.push(n as i32);
		return;
	}
	if at_inline() || at_checkfree() || at_lut() { TOP.push(pfn(false, -1, -1) as i32); return; }
	if k == K_STRUCT { TOP.push(pstruct() as i32); return; }
	if k == K_ENUM { TOP.push(penum() as i32); return; }
	if k == K_TYPE { nx(); let n = mk(N_ALIAS, st); { let q_ = declname("type alias"); ND[n].s = q_ as i32; } ND[n].a = CURNS as i32; ex(T_ASSIGN, "type alias"); { let q_ = ptype(); ND[n].b = q_ as i32; } ex(T_SEMI, "type alias"); TOP.push(n as i32); return; }
	if k == K_EXTERN {
		nx();
		var cs = -1;
		if tk() == T_STR { cs = P; nx(); }
		if tk() == T_LC {
			if cs < 0 { perr("an extern block names the library it binds from: extern \"lib\" {"); }
			nx();
			while tk() != T_RC && tk() != T_EOF { TOP.push(pfn(false, -1, cs) as i32); }
			ex(T_RC, "extern block");
			return;
		}
		P--;
		if cs >= 0 { P--; }
		TOP.push(pfn(false, -1, -1) as i32);
		return;
	}
	if k == K_RECURSIVE || k == K_FN || k == K_THREADFN || k == K_EXPORT || k == K_SIMD { TOP.push(pfn(false, -1, -1) as i32); return; }
	if k == K_REUSABLE || k == K_LET || k == K_VAR || k == K_CONST { let v = pvdecl(true); ex(T_SEMI, "global declaration"); TOP.push(v as i32); return; }
	var m byte[>..] = []; format(m, "top-level declaration expected, found '", cur_text(), "'"); perr(m);
}
fn parse_init() {
	lex_init();
	if NAME_FROM < 0 { NAME_FROM = intern("from"); NAME_INLINE = intern("inline"); NAME_CHECKFREE = intern("checkfree"); NAME_LUT = intern("lut"); NAME_UNDER = intern("_"); NAME_UPTO = intern("upto"); NAME_FIELDS = intern("fields"); NAME_TYPES = intern("types"); NAME_VARIANTS = intern("variants"); NAME_STD = intern("std"); }
}
fn parse_file(path const byte[:]) bool {
	parse_init();
	let t0 = TK.len;
	if !lex_file(path) { PERR.append(LERR); return false; }
	P = t0;
	FILENS0 = -1;
	while tk() != T_EOF && PERR.len == 0 { ptop(); }
	FILENS.push(FILENS0 as i32);
	PERR.len == 0
}
