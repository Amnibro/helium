is_pscal(d int) bool:
	k := TY[d].k; k == TY_INT || k == TY_VARINT || k == TY_ILIT || k == TY_BOOL || isf(d)
var FMTT i32[>..<]; var FMTN i32[>..<]; var FDONE int
var EQT i32[>..<]; var EQN i32[>..<]; var EDONE int
var HDEF byte[>..<]
hdef(k const byte[:]) int:
	i ~= 0; while i < HDEF.len { j ~= i; while HDEF[j] != '\n' { j++ } l := HDEF[i..j]; if l.len > k.len && l[..k.len] == k && l[k.len] == '=' { v ~= 0; for c l[k.len + 1..] { v = v * 10 + (c - '0') } return v } i = j + 1 } -1
rtsetp(g const byte[:], k int): d := lookup(intern(g), -1, D_GLOBAL); if d < 0 { return } lea_rip(RCX, 3, gslot(d)); lea_rip(RAX, k, 0); st(RAX, RCX, 0, 8);
rtset(g const byte[:], v int): if v < 0 { return } d := lookup(intern(g), -1, D_GLOBAL); if d < 0 { return } lea_rip(RCX, 3, gslot(d)); mov_ri(RAX, v); st(RAX, RCX, 0, 8);
var TWT i32[>..<]; var TWN i32[>..<]; TDONE ~= 0; TGN ~= -1
tw_fn(inst int) int:
	for i TWT.len { if TWT[i] == inst { return TWN[i] } } nf := NFS.len; NFS.push(NFn{0, 0, 0, 0, -1}); FOFF.push(0); TWT.push(inst); TWN.push(nf); if TGN < 0 { TGN = NFS.len; NFS.push(NFn{0, 0, 0, 0, -1}); FOFF.push(0) } nf
drain() bool:
	while WDONE < WORK.len || FDONE < FMTT.len || EDONE < EQT.len || TDONE < TWT.len { if WDONE < WORK.len { lower_fn(WORK[WDONE]); WDONE++ } else { if FDONE < FMTT.len { lower_fmt(FDONE); FDONE++ } else { if EDONE < EQT.len { lower_eq(EDONE); EDONE++ } else { lower_tw(TDONE); TDONE++ } } } if LERR.len > 0 { return false } } true
lsyn_begin() int:
	CUR = GLOBI; CURI = -1; AOWN = GLOBI; NV = 0; SB = 0; LSLOT.clear(); i0 := IR.len; RETV = nv(); RETV2 = nv(); RETL = nlbl(); ir(I_IMM, 3, RETV, -1, -1, 0); i0
lsyn_end(nf int, i0 int): ir(I_LBL, 3, -1, -1, -1, RETL); ir(I_RET, 3, -1, RETV, -1, 0); NFS[nf].i0 = i0; NFS[nf].i1 = IR.len; NFS[nf].nv = NV; NFS[nf].sb = SB
recursive lower_tw(k int):
	inst := TWT[k]; i0 := lsyn_begin()
	r := nv(); ir(I_PARAM, 3, r, -1, -1, 0); pk := ldw(r, 48, 3)
	args i32[>..<] ~= []; rt := FI_[inst].ret
	if rt >= 0 && is_agg(rt): q := nv(); ir(I_SLOT, 8, q, -1, -1, slot(tsz(rt), tal(rt))); args.push(q)
	w ~= 0
