use ir
use opt
use gen
use flt
var LSLOT i32[>..<]
var NFI i32[>..<]
var WORK i32[>..<]
var LBRK i32[>..<]; var LCNT i32[>..<]
var LERR byte[>..]
var SOFF i64[>..<]; var SSZ i64[>..<]; var SAL i64[>..<]
var GOFF i32[>..<]
var RETV int; var RETL int; var CUR int
lerr(n int, m const byte[:]): if LERR.len > 0 { return } x := TK[if n >= 0 { max(ND[n].t as int, 0) } else { 0 }]; LERR.append(nm(FILES[x.f].name)); format(LERR, ":", x.line, ": error: native backend: ", m);
locs(n int) int:
	x := TK[max(ND[n].t as int, 0)]; b byte[>..] ~= []; b.append(nm(FILES[x.f].name)); format(b, ":", x.line); loc_id(b[..])
recursive tsz(t int) int:
	k := TY[t].k
	if k == TY_INT: return 1 << ((TY[t].s as int) & 3)
	if k == TY_BOOL: return 1
	if k == TY_FLT: return TY[t].s
	if k == TY_REF || k == TY_FNV || k == TY_NULL: return if TY[t].c >= 0 && TY[t].c != 8 { 1 << ((TY[t].c as int) & 3) } else { 8 }
	if k == TY_SLICE || k == TY_STRLIT: return 16
	if k == TY_STRUCT: slay(TY[t].a); return SSZ[TY[t].a] as int
	if k == TY_ARR: e := TY[t].a; if is_fix(t) { return tsz(e) * TY[t].b as int } if is_lim(t) { return lco(t) + tsz(e) * TY[t].b as int } if is_res(t) { return 48 } return 8
	if k == TY_ILIT { return 8 } if k == TY_FLIT: return 8
	if k == TY_MULTI: n := TY[t].n; return moff(t, n - 1) + tsz(mel(t, n - 1))
	if k == TY_ENUM: ei := TY[t].a; if etag_only(ei) { return ENI[ei].tagsz } mx ~= 0; for i ENI[ei].vnum { si := vsi(ei, i); if si >= 0 { mx = max(mx, tsz(t_struct(si))) } } return epoff(ei) + mx
	if k == TY_VARIANT: si := vsi(TY[t].a, TY[t].c); return if si >= 0 { tsz(t_struct(si)) } else { ENI[TY[t].a].tagsz as int }
	8
ssi(d int) int:
	k := TY[d].k; if k == TY_STRUCT:
		TY[d].a as int
	else:
		if k == TY_VARIANT:
			vsi(TY[d].a, TY[d].c)
		else:
			-1
vsi(ei int, i int) int:
	v := ENV[ENI[ei].v0 + i]; if v.si >= 0 && !STI[v.si].zero:
		v.si as int
	else:
		-1
etag_only(ei int) bool:
	ei_layout(ei); for i ENI[ei].vnum { if vsi(ei, i) >= 0 { return false } } true
recursive epal(ei int) int:
	a ~= ENI[ei].tagsz; for i ENI[ei].vnum { si := vsi(ei, i); if si >= 0 { a = max(a, tal(t_struct(si))) } } a
recursive epoff(ei int) int:
	ENI[ei].tagsz as int
lcw(d int) int:
	lim_lenstore(TY[d].b)
lco(d int) int:
	1 << (lcw(d) & 3)
mel(t int, i int) int:
	TYL[TY[t].l + i] as int
recursive moff(t int, i int) int:
	o ~= 0; for j i { o += tsz(mel(t, j)) } o
recursive tal(t int) int:
	k := TY[t].k
	if k == TY_STRUCT: slay(TY[t].a); return SAL[TY[t].a] as int
	if k == TY_ARR && is_fix(t): return tal(TY[t].a)
	if k == TY_ARR || k == TY_SLICE || k == TY_STRLIT: return 8
	if k == TY_MULTI: a ~= 1; for j TY[t].n { a = max(a, tal(mel(t, j))) } return a
	if k == TY_ENUM: ei := TY[t].a; ei_layout(ei); if etag_only(ei) { return ENI[ei].tagsz } return epal(ei)
	if k == TY_VARIANT: si := vsi(TY[t].a, TY[t].c); return if si >= 0 { tal(t_struct(si)) } else { 1 }
	min(tsz(t), 8)
recursive slay(si int):
	while SSZ.len < STI.len: SSZ.push(-1); SAL.push(1)
	while SOFF.len < SFI.len: SOFF.push(0)
	if SSZ[si] >= 0: return
	o ~= 0; a ~= 1
	for j STI[si].fnum: fi := STI[si].f0 as int + j; ft := SFI[fi].ty; if ft < 0 { continue } fa := tal(ft); SOFF[fi] = o; o += tsz(ft); a = max(a, fa)
	SSZ[si] = o; SAL[si] = a
foff(si int, j int) int:
	slay(si); SOFF[STI[si].f0 + j] as int
wof(t int) int:
	k := TY[t].k; if k == TY_ENUM || k == TY_VARIANT && vsi(TY[t].a, TY[t].c) < 0 { return if ENI[TY[t].a].tagsz == 1 { 4 } else { 5 } } if k == TY_INT { return TY[t].s } if k == TY_FLT { return if TY[t].s == 4 { 10 } else { 11 } } if k == TY_FLIT { return 11 } if k == TY_BOOL { return 4 } if k == TY_ILIT { return 3 } 3
is_scal(t int) bool:
	k := TY[t].k; k == TY_INT || k == TY_VARINT || k == TY_BOOL || k == TY_FLT || k == TY_FLIT || k == TY_REF || k == TY_ILIT || k == TY_NULL || k == TY_FNV || k == TY_ENUM && etag_only(TY[t].a) || k == TY_VARIANT && vsi(TY[t].a, TY[t].c) < 0 || k == TY_ARR && is_vimg(t)
is_pair(t int) bool:
	k := TY[t].k; k == TY_SLICE || k == TY_STRLIT
nf_of(i int) int:
	while NFI.len < FI_.len { NFI.push(-1) } if NFI[i] < 0 { NFI[i] = NFS.len; NFS.push(NFn{0, 0, 0, 0, i}); FOFF.push(0); WORK.push(i) } NFI[i] as int
lslot(v int) int:
	while LSLOT.len < LVS.len { LSLOT.push(-1) } if LSLOT[v] < 0 { t := LVS[v].ty; LSLOT[v] = slot(tsz(t), tal(t)) } LSLOT[v] as int
gslot(d int) int:
	while GOFF.len < GLT.len { GOFF.push(-1) } if GOFF[d] < 0 { t := GLT[d]; BSS = al(BSS, tal(t)); GOFF[d] = BSS; BSS += tsz(t) } GOFF[d] as int
var CAPSL i32[>..<]
CURI ~= -1; LRF ~= -1; var LRVO i32[>..<]; var LRDO i32[>..<]
bss(sz int, a int) int:
	BSS = al(BSS, max(a, 1)); o := BSS; BSS += max(sz, 1); o
lrflag() int:
	if LRF < 0 { LRF = bss(8, 8) } d := nv(); ir(I_GADDR, 8, d, -1, -1, LRF); d
lrval(f0 int) int:
	f := lrkey(f0); while LRVO.len <= f { LRVO.push(-1) } rt := FI_[f0].ret; if LRVO[f] < 0 { LRVO[f] = bss(if rt >= 0 && rt != T_VOID { tsz(rt) } else { 8 }, if rt >= 0 && rt != T_VOID { tal(rt) } else { 8 }) } d := nv(); ir(I_GADDR, 8, d, -1, -1, LRVO[f]); d
lrrel(f0 int) bool: rt := FI_[f0].ret as int; rt >= 0 && is_agg(rt) && has_rel(rt)
lrdst(f0 int) int: f := lrkey(f0); while LRDO.len <= f { LRDO.push(-1) } if LRDO[f] < 0 { LRDO[f] = bss(8, 8) } d := nv(); ir(I_GADDR, 8, d, -1, -1, LRDO[f]); d
lrcheck():
	fl := ldw(lrflag(), 0, 3); lok := nlbl(); ir(I_BZ, 3, -1, fl, -1, lok)
	if CURI >= 0 && lrtg(CURI):
		lno := nlbl(); ir(I_BZ, 3, -1, lcmp(fl, imm(lrkey(CURI) + 1), CC_E), -1, lno); stw(lrflag(), 0, imm(0), 3); rt := FI_[CURI].ret; va := lrval(CURI)
		if rt >= 0 && rt != T_VOID:
			if is_agg(rt) && !lrrel(CURI): ir(I_COPY, 3, RETV, va, imm(tsz(rt)), 0)
			else:
				if is_pair(rt): ir(I_MOV, 3, RETV, ldw(va, 0, 3), -1, 0); ir(I_MOV, 3, RETV2, ldw(va, 8, 3), -1, 0) else: ir(I_MOV, 3, RETV, ldw(va, 0, wof(rt)), -1, 0)
		drop_to(0); ir(I_JMP, 3, -1, -1, -1, RETL); ir(I_LBL, 3, -1, -1, -1, lno)
	rt0 := if CURI >= 0 { FI_[CURI].ret as int } else { -1 }; if rt0 >= 0 && is_vimg(rt0): ir(I_MOV, 3, RETV, imm(0), -1, 0)
	drop_to(0); ir(I_JMP, 3, -1, -1, -1, RETL); ir(I_LBL, 3, -1, -1, -1, lok);
lvaddr(v int) int:
	d := nv(); if LVS[v].cfn != CUR && CFBD == 0 { while CAPSL.len < LVS.len { CAPSL.push(-1) } if CAPSL[v] < 0 { lerr(-1, "captured variable without a capture slot"); return d } ir(I_SLOT, 8, d, -1, -1, CAPSL[v]); return ldw(d, 0, 3) } ir(I_SLOT, 8, d, -1, -1, lslot(v)); d
gctab(d int):
	g := DC[d].node; x := ND[g]; t := GLT[d]
	if x.fl & V_VAR != 0 || x.b < 0 || TY[t].k != TY_ARR || !is_fix(t): return
	e := TY[t].a; iv := kid(x.b, 0); z := tsz(e); nel := TY[t].b as int
	if ND[iv].k as int != N_ARR || ND[iv].n != nel || !is_scal(e) || is_vimg(e) || TY[e].k == TY_REF: return
	by byte[>..] ~= []
	for j nel:
		q := kid(iv, j); v ~= 0
		if isf(e): if ND[q].k as int != N_FLT { return } b := flt_bits(tok_text(ND[q].t)); v = (if wof(e) == 10 { d2f_bits(b) } else { b }) as! int
		else:
			if ND[q].k as int == N_TRUE: v = 1
			else:
				if ND[q].k as int != N_FALSE: c, ok := kint(q); if !ok { return } v = c
		for k z: by.push((v >> 8 * k & 255) as! byte)
	GCS.push(gslot(d)); GCN.push(by.len); GCP.push(GCB.len); for c by: GCB.push(c)
mut_hook(t int) bool:
	hk := hook_of(t); if hk < 0 { return false } pt := ptype_of(hk, 1); TY[pt].k == TY_REF && TY[pt].fl & RF_CONST == 0
gconst(d int, st int) int, bool:
	g := DC[d].node; x := ND[g]; t := GLT[d]
	if x.fl & V_VAR != 0 || x.b < 0 || !is_scal(t) || is_vimg(t) || TY[t].k == TY_REF || mut_hook(t): return 0, false
	iv := kid(x.b, 0); ik := ND[iv].k
	if isf(t): if ik != N_FLT || !isf(st) || wof(st) != wof(t) { return 0, false } b := flt_bits(tok_text(ND[iv].t)); return (if wof(t) == 10 { d2f_bits(b) } else { b }) as! int, true
	if isf(st): return 0, false
	if ik == N_TRUE { return 1, true } if ik == N_FALSE: return 0, true
	if !klit(iv) || !all_int(iv): return 0, false
	v, ok := ceval(iv, ns_of(g)); return v as int, ok
var CROD i32[>..]
vaddr(n int) int:
	d := nv(); r := rk(n)
	if r == R_LOCAL: return lvaddr(rv(n))
	if r == R_GLOBAL: ir(I_GADDR, 8, d, -1, -1, gslot(rv(n)) - (DA.len - DA.len)); return d
	if r == R_CONST: ci := rv(n); while CROD.len <= ci { CROD.push(-1) } if CROD[ci] < 0 { v, u, ok := cval(n); b byte[..8] ~= []; for i 8 { b.push((v >> ((i * 8) as i64) & 255) as! byte) } CROD[ci] = rodata(b[..]) } ir(I_RADDR, 8, d, -1, -1, CROD[ci]); return d
	m byte[>..] ~= []; format(m, "unsupported variable ", r); lerr(n, m[..]); d
ldw(a int, off int, w int) int:
	d := nv(); ir(I_LD, w, d, a, -1, off); d
stw(a int, off int, v int, w int): ir(I_ST, w, -1, a, v, off);
bin(o int, w int, a int, b int, l int) int:
	d := nv(); irl(I_BIN, w, d, a, b, o, l); d
addi(a int, v int) int:
	if v == 0:
		a
	else:
		bin(B_ADD, 3, a, imm(v), -1)
recursive laddr(n int) int:
	x := ND[n]; k := x.k
	if rel_of(n) >= 0: return rel_load(rel_slot(n), rel_of(n))
	if k == N_ID: t := if rk(n) == R_LOCAL { LVS[rv(n)].ty as int } else { if rk(n) == R_GLOBAL { GLT[rv(n)] as int } else { at(n) } }; if TY[t].k == TY_REF && TY[t].c < 0 { return ldw(vaddr(n), 0, 3) } return vaddr(n)
	if k == N_DOT && rk(n) == R_FIELD:
		bt := at(x.a); d := deref(bt); b := if TY[bt].k == TY_REF { lptr(x.a) } else { laddr(x.a) }
		if ssi(d) < 0: lerr(n, "field of a non-struct"); return b
		fa := addi(b, foff(ssi(d), rv(n))); ft := at(n); if TY[ft].k == TY_REF && TY[ft].c < 0 { return ldw(fa, 0, 3) } return fa
	if k == N_IDX: ea := lidx(n); et := at(n); return if et >= 0 && TY[et].k == TY_REF && TY[et].c < 0 { ldw(ea, 0, 3) } else { ea }
	if k == N_UN && x.op as int == T_MUL: return lx(x.a)
	if k == N_UN && x.op as int == T_AND: return laddr(x.a)
	t := fin(n)
	if TY[t].k == TY_REF: st := atc(n); if st < 0 || TY[st].k != TY_REF && TY[st].k != TY_NULL { if k == N_IF || k == N_BLOCK || k == N_EBLOCK || k == N_LOOP || k == N_MATCH { q := nv(); ir(I_SLOT, 8, q, -1, -1, slot(8, 8)); lsink(n, q, t); return ldw(q, 0, 3) } bm byte[>..] ~= []; format(bm, "this branch reference natively (kind ", k, ", resolved ", rk(n), ")"); lerr(n, bm[..]); return imm(0) } return lx(n)
	s := slot(tsz(t), tal(t)); d := nv(); ir(I_SLOT, 8, d, -1, -1, s); lstore(d, n, t); tmp_drop(d, t); d
recursive lidx(n int) int:
	x := ND[n]; a := x.a; bt := at(a); d := deref(bt); e := TY[d].a; es := tsz(e)
	if is_seq(d): lerr(n, "an array of variable-size elements is sequential: iterate it instead of indexing"); return imm(0)
	base ~= -1; len ~= -1; sl := TY[d].k == TY_SLICE || TY[d].k == TY_STRLIT || is_vimg(d)
	if !sl && !is_fix(d) && !is_lim(d) && !is_res(d): lerr(n, "indexing this array kind"); return lx(x.b)
	b := if sl { p, q := lsl(a); base = p; len = q; -1 } else { laddr(a) }
	i := lx(x.b)
	if is_fix(d): base = b; len = imm(TY[d].b as int)
	else:
		if is_lim(d) && !sl: len = ldw(b, 0, lcw(d)); base = addi(b, lco(d))
		else:
			if is_res(d) && !sl: base = ldw(b, 0, 3); len = ldw(b, 8, 3)
	irl(I_BCHK, 3, -1, i, len, 0, locs(n))
	bin(B_ADD, 3, base, bin(B_MUL, 3, i, imm(es), -1), -1)
boob(ok int, i int, len int, n int): l := nlbl(); ir(I_BNZ, 3, -1, ok, -1, l); s0 := ARGL.len; ARGL.push(i); ARGL.push(len); lc := locs(n); r1 := nv(); ir(I_RADDR, 8, r1, -1, -1, LOCS[2 * lc]); ARGL.push(r1); ARGL.push(imm(LOCS[2 * lc + 1])); ir(I_CALL, 3, -1, s0, 4, rt_fn("rt_oob")); ir(I_LBL, 3, -1, -1, -1, l);
rt_fn(name const byte[:]) int:
	d := lookup(intern(name), -1, D_FN); if d < 0 { return -1 } for f, i FI_ { if f.node == DC[d].node && f.st == 2 { return nf_of(i) } } -1
CFBD ~= 0
recursive lcfb(n int, mode int) int, int:
	c := CFBS[rv(n)]
	if c.k == 1: s := nm(c.a); r := nv(); ir(I_RADDR, 8, r, -1, -1, rodata(s)); return r, imm(s.len)
	ft := fin(n); sa := AOWN; AOWN = c.b; e := c.a; o := cv(e); set_cv(e, ft); CFBD += 1
	p ~= 0; q ~= 0; if mode == 1: p1, q1 := lsl(e); p = p1; q = q1 else: p = lx(e); q = PAIR2
	CFBD -= 1; set_cv(e, o); AOWN = sa; return p, q
is_cfb(n int) bool:
	ND[n].k as int == N_ID && rk(n) == R_CFB
recursive lsl(n int) int, int:
	if is_cfb(n): return lcfb(n, 1)
	t := at(n); c := cv(n); k := ND[n].k; if k == N_UN && ND[n].op as int == T_AND { return lsl(ND[n].a) } if t >= 0 && is_fix(deref(t)) && is_seq(deref(t)) && k != N_ARR: d := deref(t); a := if is_lplace(n) || TY[t].k == TY_REF { laddr(n) } else { ltmp(n, d) }; return lsqof(a, TY[d].b as int, TY[d].a), imm(TY[d].b as int)
	qf := if k == N_ARR { alit(deref(fin(n)), n) } else { -1 }; qt := if qf >= 0 && (TY[qf].k == TY_ARR || TY[qf].k == TY_SLICE) { qf } else { if t >= 0 { alit(deref(t), n) } else { -1 } }; if qt >= 0 && is_seq(qt) && k == N_ARR: h := lsqimg(n, TY[qt].a, 8, 0); return addi(h, 8), ldw(h, 0, 3)
	if k == N_STR || TY[t].k == TY_STRLIT && k != N_IF && k != N_BLOCK && k != N_EBLOCK && k != N_MATCH && k != N_LOOP && k != N_CALL: s := tok_str_lit(n); p := nv(); ir(I_RADDR, 8, p, -1, -1, rodata(s[..])); return p, imm(s.len)
	ft := if c >= 0 { c } else { t }
	d := deref(t)
	if k == N_SLICE: return lslice(n)
	if is_vimg(d) && k != N_STR && k != N_ARR: return vdat(vptr_of(n), d)
	if k == N_CALL: d := lcall(n); ct := atc(n); if TY[ct].k == TY_MULTI { m0 := deref(mel(ct, 0)); if TY[m0].k == TY_ARR && is_fix(m0) && !is_vimg(m0) { return d, imm(TY[m0].b as int) } return ldw(d, 0, 3), ldw(d, 8, 3) } dct := deref(ct); if rk(n) == R_BLOCK && TY[dct].k == TY_ARR && is_fix(dct) && !is_vimg(dct) { q := nv(); ir(I_SLOT, 8, q, -1, -1, slot(tsz(dct), tal(dct))); ir(I_COPY, 3, q, d, imm(tsz(dct)), 0); return lsl_at(q, dct) } if is_agg(ct) || TY[ct].k == TY_REF && TY[ct].c < 0 && (TY[deref(ct)].k == TY_ARR || TY[deref(ct)].k == TY_SLICE) { return lsl_at(d, deref(ct)) } return d, PAIR2
	if (k == N_IF || k == N_BLOCK || k == N_EBLOCK || k == N_LOOP || k == N_MATCH) && TY[t].k == TY_REF && TY[deref(t)].k == TY_ARR && !is_vimg(deref(t)) && !is_seq(deref(t)): a := nv(); ir(I_SLOT, 8, a, -1, -1, slot(16, 8)); lsink(n, a, t_slice(TY[deref(t)].a, false)); return ldw(a, 0, 3), ldw(a, 8, 3)
	if (k == N_IF || k == N_BLOCK || k == N_EBLOCK || k == N_LOOP || k == N_MATCH) && TY[t].k == TY_ARR && !is_vimg(t): q := nv(); ir(I_SLOT, 8, q, -1, -1, slot(tsz(t), tal(t))); lsink(n, q, t); tmp_drop(q, t); return lsl_at(q, t)
	if k == N_IF || k == N_BLOCK || k == N_EBLOCK || k == N_LOOP || k == N_MATCH: a := nv(); ir(I_SLOT, 8, a, -1, -1, slot(16, 8)); lsink(n, a, if TY[t].k == TY_STRLIT { TT_STR } else { t }); return ldw(a, 0, 3), ldw(a, 8, 3)
	if k == N_ARR:
		ct := fin(n); at0 := if TY[ct].k == TY_ARR { ct } else { if TY[t].k == TY_ARR { t } else { -1 } }; if at0 >= 0: ft := if is_fix(at0) || is_lim(at0) || is_res(at0) { at0 } else { t_arr(TY[at0].a, A_FIXED, ND[n].n, -1) }; q := nv(); ir(I_SLOT, 8, q, -1, -1, slot(tsz(ft), tal(ft))); lstore(q, n, ft); tmp_drop(q, ft); return lsl_at(q, ft)
	if !is_lplace(n) && TY[t].k != TY_REF && k != N_AS: m byte[>..] ~= []; format(m, "slice from expression kind ", k, " resolved ", rk(n)); lerr(n, m[..]); return imm(0), imm(0)
	if TY[d].k == TY_SLICE: a := laddr(n); return ldw(a, 0, 3), ldw(a, 8, 3)
	if is_fix(d): return laddr(n), imm(TY[d].b as int)
	if is_lim(d): a := laddr(n); return addi(a, lco(d)), ldw(a, 0, lcw(d))
	if is_res(d): a := laddr(n); return ldw(a, 0, 3), ldw(a, 8, 3)
	m byte[>..] ~= []; format(m, "unsupported slice source ", k, " type kind ", TY[d].k); lerr(n, m[..]); return imm(0), imm(0)
recursive lslice(n int) int, int:
	x := ND[n]; a := x.a; if is_seq(deref(at(a))) && (x.b >= 0 || x.c >= 0) { lerr(n, "a range of an array of variable-size elements natively") } p, len := lsl(a); es := tsz(TY[deref(at(a))].a)
	lo0 := if x.b >= 0 { lx(x.b) } else { imm(0) }; hi0 := if x.c >= 0 { lx(x.c) } else { len }
	lo := if x.fl & 1 != 0 { bin(B_SUB, 3, len, lo0, -1) } else { lo0 }; hi := if x.fl & 2 != 0 { bin(B_SUB, 3, len, hi0, -1) } else { hi0 }
