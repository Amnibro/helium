	ir(I_LBL, 3, -1, -1, -1, RETL); ir(I_RET, 3, -1, -1, -1, 0)
	NFS[nf].i0 = i0; NFS[nf].i1 = IR.len; NFS[nf].nv = NV; NFS[nf].sb = SB
recursive lfmt(c int, top bool):
	t := fin(c); d := deref(t); k := TY[d].k
	if TY[t].k == TY_REF && TY[t].fl & RF_OPT != 0 && TY[t].c < 0 && !(k == TY_ARR && !is_fix(d) && !is_lim(d) || k == TY_SLICE): q := nv(); ir(I_SLOT, 8, q, -1, -1, slot(8, 8)); stw(q, 0, lx(c), 3); VTOP = true; lfmt_a(q, t); VTOP = false; return
	hk := if ND[c].k as int == N_STR { -1 } else { fmt_hook(if TY[d].k == TY_VARINT { T_I64 } else { d }) }
	if hk >= 0 && k == TY_VARIANT: ed := deref(ptype_of(hk, 1)); q := nv(); ir(I_SLOT, 8, q, -1, -1, slot(tsz(ed), tal(ed))); lstore(q, c, ed); lhook(hk, q, true, ed); return
	if hk >= 0: if TY[t].k == TY_REF { lhook(hk, lx(c), true, d); } else { if is_scal(d) && !is_lplace(c) { lhook(hk, lx(c), false, d); } else { lhook(hk, laddr(c), true, d); } } return
	if k == TY_STRLIT || is_byte_arr(d): p, q := lsl(c); rtcall(if top { "rt_ps" } else { "rt_pq" }, [p as i32, q as i32]); return
	if is_pscal(d): v := if TY[t].k == TY_REF { ldw(lx(c), 0, wof(d)) } else { lx(c) }; lscal_out(v, d); return
	if k == TY_SLICE || k == TY_ARR && is_res(d) && TY[t].k != TY_REF && !is_lplace(c): p, q := lsl(c); s := nv(); ir(I_SLOT, 8, s, -1, -1, slot(16, 8)); stw(s, 0, p, 3); stw(s, 8, q, 3); s0 := ARGL.len; ARGL.push(s); ir(I_CALL, 3, -1, s0, 1, fmt_fn(if k == TY_SLICE { d } else { t_slice(TY[d].a, false) })); return
	a := if TY[t].k == TY_REF { lx(c) } else { laddr(c) }
	s0 := ARGL.len; ARGL.push(a); ir(I_CALL, 3, -1, s0, 1, fmt_fn(d));
recursive lstmt(n int):
	if LERR.len > 0 || dead(n): return
	th := STMP.len; sb := SBRD; SBRD = BRD; lstmt1(n); SBRD = sb; i ~= STMP.len; while i > th { i -= 2; ldrop(tmpa(STMP[i]), STMP[i + 1]) } STMP.resize(th);
LTR ~= -1
recursive lstmt1(n int):
	if LTR < 0 { e byte[>..] ~= []; LTR = if env("HC_LTRACE", e) { 1 } else { 0 } } if LTR == 1: tk0 := TK[max(ND[n].t as int, 0)]; print("lstmt ", nm(FILES[tk0.f].name), ":", tk0.line, " kind ", ND[n].k)
	x := ND[n]; k := x.k as int
	if k == N_VDECL: lvdecl(n); return
	if k == N_ASSIGN: lassign(n); return
	if k == N_INCDEC: a := x.a as int; t := deref(at(a)); p := laddr(a); v := ldw(p, 0, wof(t)); r := arith(if x.op as int == T_INC { T_PLUS } else { T_MINUS }, t, v, imm(1), n); stw(p, 0, r, wof(t)); return
	if k == N_FN: return
	if k == N_IF: lbranch(n, -1); return
	if k == N_WHILE: l0 := nlbl(); l1 := nlbl(); LOOPH.push(DROPS.len as i32); LCH.push(DROPS.len as i32); LBRK.push(l1 as i32); LCNT.push(l0 as i32); LRV.push(-1); ir(I_LBL, 3, -1, -1, -1, l0); lcond(x.a as int, l1, true); lblk(x.b as int, -1); ir(I_JMP, 3, -1, -1, -1, l0); ir(I_LBL, 3, -1, -1, -1, l1); LOOPH.pop(); LCH.pop(); LBRK.pop(); LCNT.pop(); LRV.pop(); return
	if k == N_LOOP: lbranch(n, -1); return
	if k == N_FOR: lfor(n); return
	if k == N_BLOCK: lblk(n, -1); return
	if k == N_CFOR: sa := AOWN; for inst cf_insts(n) { AOWN = inst as int; lstmt(ND[n].c as int); AOWN = sa } return
	if k == N_RET && ax(n) >= 0 && ax(n) != CURI:
		lt := ax(n); rt0 := FI_[lt].ret as int; va := if lrrel(lt) { ldw(lrdst(lt), 0, 3) } else { lrval(lt) }
		if x.n > 1:
			for i x.n: c := kid(n, i); lstore(addi(va, moff(rt0, i)), c, mel(rt0, i)); lmove_src(c)
		else:
