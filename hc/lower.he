eq_fn(t int) int:
	for i EQT.len { if EQT[i] == t { return EQN[i] } } nf := NFS.len; NFS.push(NFn{0, 0, 0, 0, -1}); FOFF.push(0); EQT.push(t); EQN.push(nf); nf
plain_bytes(t int) bool:
	k := TY[t].k; if k == TY_INT || k == TY_BOOL { return true } if k == TY_ARR && is_fix(t) { return plain_bytes(TY[t].a) } if k == TY_STRUCT && !is_vst(t) { si := TY[t].a; o ~= 0; for j STI[si].fnum { ft := SFI[STI[si].f0 as int + j].ty; if ft < 0 { continue } if !plain_bytes(ft) || foff(si, j) != o { return false } o += tsz(ft) } return o == tsz(t) } false
recursive leq_a(pa int, pb int, t int) int:
	if isf(t): d := nv(); ir(I_FCMP, wof(t), d, ldw(pa, 0, wof(t)), ldw(pb, 0, wof(t)), 0); return d
	if is_scal(t) && !is_vimg(t): w := if is_rel(t) { rw(t) } else { if TY[t].k == TY_REF || TY[t].k == TY_FNV { 3 } else { wof(t) } }; return lcmp(ldw(pa, 0, w), ldw(pb, 0, w), CC_E)
	if plain_bytes(t) && tsz(t) <= 32: r ~= -1; o ~= 0; z := tsz(t); while o < z { q := if z - o >= 8 { 8 } else { if z - o >= 4 { 4 } else { if z - o >= 2 { 2 } else { 1 } } }; w := if q == 8 { 3 } else { if q == 4 { 6 } else { if q == 2 { 5 } else { 4 } } }; e := lcmp(ldw(pa, o, w), ldw(pb, o, w), CC_E); r = if r < 0 { e } else { bin(B_AND, 3, r, e, -1) }; o += q } return if r < 0 { imm(1) } else { r }
	if plain_bytes(t): return rtcall("rt_memeq", [pa as i32, imm(tsz(t)) as i32, pb as i32, imm(tsz(t)) as i32])
	s0 := ARGL.len; ARGL.push(pa); ARGL.push(pb); d := nv(); ir(I_CALL, 3, d, s0, 2, eq_fn(t)); d
lower_eq(fi int):
	t := EQT[fi]; nf := EQN[fi]
	CUR = GLOBI; CURI = -1; AOWN = GLOBI; NV = 0; SB = 0; LSLOT.clear()
	i0 := IR.len; RETV = nv(); RETV2 = nv(); RETL = nlbl(); ir(I_IMM, 3, RETV, -1, -1, 0)
	a := nv(); ir(I_PARAM, 3, a, -1, -1, 0); b := nv(); ir(I_PARAM, 3, b, -1, -1, 1)
	x := TY[t]; k := x.k
	if k == TY_STRUCT || k == TY_VARIANT:
		si := ssi(t); if si >= 0:
			for j STI[si].fnum: ft := SFI[STI[si].f0 as int + j].ty; if ft < 0 { continue } ir(I_BZ, 3, -1, leq_a(addi(a, foff(si, j)), addi(b, foff(si, j)), ft), -1, RETL)
	if k == TY_MULTI:
		for j x.n: ir(I_BZ, 3, -1, leq_a(addi(a, moff(t, j)), addi(b, moff(t, j)), mel(t, j)), -1, RETL)
	if k == TY_ENUM:
		ei := x.a; ta := ldw(a, 0, wof(t)); ir(I_BZ, 3, -1, lcmp(ta, ldw(b, 0, wof(t)), CC_E), -1, RETL); for i ENI[ei].vnum: si := vsi(ei, i); if si < 0 { continue } ln := nlbl(); ir(I_BZ, 3, -1, lcmp(ta, imm(i), CC_E), -1, ln); ir(I_BZ, 3, -1, leq_a(addi(a, epoff(ei)), addi(b, epoff(ei)), t_struct(si)), -1, RETL); ir(I_LBL, 3, -1, -1, -1, ln)
	if k == TY_ARR || k == TY_SLICE || k == TY_STRLIT:
		e := if k == TY_STRLIT { T_U8 } else { x.a as int }; es := tsz(e); pa, na := lsl_at(a, t); pb, nb := lsl_at(b, t)
		ir(I_BZ, 3, -1, lcmp(na, nb, CC_E), -1, RETL)
		if sq(t): da := nv(); ir(I_SLOT, 8, da, -1, -1, slot(max(es, 1), tal(e))); db := nv(); ir(I_SLOT, 8, db, -1, -1, slot(max(es, 1), tal(e))); qa := nv(); ir(I_MOV, 3, qa, pa, -1, 0); qb := nv(); ir(I_MOV, 3, qb, pb, -1, 0); kv, lt, le := lloop(na); za := lunflat(da, qa, e); zb := lunflat(db, qb, e); ir(I_BZ, 3, -1, leq_a(da, db, e), -1, RETL); ir(I_MOV, 3, qa, bin(B_ADD, 3, qa, za, -1), -1, 0); ir(I_MOV, 3, qb, bin(B_ADD, 3, qb, zb, -1), -1, 0); lloop_end(kv, lt, le)
		else:
