	NFS[nf].i0 = i0; NFS[nf].i1 = IR.len; NFS[nf].nv = NV; NFS[nf].sb = SB
fmt_fn(t int) int:
	for i FMTT.len { if FMTT[i] == t { return FMTN[i] } } nf := NFS.len; NFS.push(NFn{0, 0, 0, 0, -1}); FOFF.push(0); FMTT.push(t); FMTN.push(nf); nf
VTOP ~= false
recursive lfmt_a(a int, t int):
	d := deref(t); k := TY[d].k
	if TY[t].k == TY_REF: p := if TY[t].c >= 0 { rel_load(a, t) } else { ldw(a, 0, 3) }; l1 := nlbl(); l2 := nlbl(); ir(I_BZ, 3, -1, p, -1, l1); pd := if TY[t].c >= 0 { TY[t].a as int } else { d }; vh := if VTOP && TY[pd].k == TY_VARINT { fmt_hook(T_I64) } else { -1 }; VTOP = false; if vh >= 0 { lhook(vh, p, true, pd); } else { lfmt_a(p, pd); } ir(I_JMP, 3, -1, -1, -1, l2); ir(I_LBL, 3, -1, -1, -1, l1); rtps("null", false); ir(I_LBL, 3, -1, -1, -1, l2); return
	hk := fmt_hook(d); if hk >= 0: lhook(hk, a, true, d); return
	if is_byte_arr(d) || k == TY_STRLIT: p, q := lsl_at(a, d); rtcall("rt_pq", [p as i32, q as i32]); return
	if is_pscal(d): lscal_out(ldw(a, 0, wof(d)), d); return
	s0 := ARGL.len; ARGL.push(a); ir(I_CALL, 3, -1, s0, 1, fmt_fn(d));
lsl_at(a int, d int) int, int: if is_vimg(d) { return vdat(ldw(a, 0, 3), d) } if is_fix(d) { return a, imm(TY[d].b as int) } if is_lim(d) { return addi(a, lco(d)), ldw(a, 0, lcw(d)) } return ldw(a, 0, 3), ldw(a, 8, 3)
lower_fmt(fi int):
	t := FMTT[fi]; nf := FMTN[fi]
	CUR = GLOBI; CURI = -1; AOWN = GLOBI; NV = 0; SB = 0; LSLOT.clear()
	i0 := IR.len; RETV = nv(); RETV2 = nv(); RETL = nlbl()
	a0 := nv(); ir(I_PARAM, 3, a0, -1, -1, 0)
	x := TY[t]; k := x.k; a := if (k == TY_ENUM || k == TY_VARIANT) && tsz(t) > 0 && !has_rel(t) { q := nv(); ir(I_SLOT, 8, q, -1, -1, slot(tsz(t), tal(t))); ir(I_COPY, 3, q, a0, imm(tsz(t)), 0); q } else { a0 }
	if k == TY_ENUM || k == TY_VARIANT:
		ei := x.a; only := k == TY_ENUM && etag_only(ei); tg := if k == TY_ENUM { ldw(a, 0, wof(t)) } else { imm(x.c) }; lend := nlbl()
		for i ENI[ei].vnum:
			if k == TY_VARIANT && i != x.c as int { continue } ln := nlbl(); ir(I_BZ, 3, -1, lcmp(tg, imm(i), CC_E), -1, ln); v := ENV[ENI[ei].v0 as int + i]; si := vsi(ei, i)
			if v.si >= 0 && STI[v.si].fnum > 0: pa := if k == TY_ENUM { addi(a, epoff(ei)) } else { a }; rtps(nm(v.name), false); rtps(" { ", false); first ~= true; for j if si >= 0 { STI[si].fnum as int } else { 0 } { f := SFI[STI[si].f0 + j]; if f.ty < 0 { continue } if !first { rtps(", ", false) } first = false; lfmt_a(addi(pa, foff(si, j)), f.ty) } rtps(" }", false)
			else: b byte[>..] ~= []; b.append(nm(ENI[ei].name)); b.push('.'); b.append(nm(v.name)); rtps(b[..], false)
			ir(I_JMP, 3, -1, -1, -1, lend); ir(I_LBL, 3, -1, -1, -1, ln)
		ir(I_LBL, 3, -1, -1, -1, lend)
	else:
		if k == TY_STRUCT: si := x.a; rtps(ty_name(t)[..], false); rtps(" { ", false); first ~= true; for j STI[si].fnum { f := SFI[STI[si].f0 as int + j]; if f.ty < 0 { continue } if !first { rtps(", ", false) } first = false; lfmt_a(addi(a, foff(si, j)), f.ty) } rtps(" }", false)
		else:
			if k == TY_ARR || k == TY_SLICE:
				e := x.a; es := tsz(e); isq := sq(t)
				p, c := lsl_at(a, t); rtps("[", false); q := nv(); ir(I_MOV, 3, q, p, -1, 0); ds := if isq { u := nv(); ir(I_SLOT, 8, u, -1, -1, slot(max(es, 1), tal(e))); u } else { -1 }
				kv := nv(); ir(I_MOV, 3, kv, imm(0), -1, 0); l0 := nlbl(); l1 := nlbl(); ls := nlbl(); ir(I_LBL, 3, -1, -1, -1, l0); cc := nv(); ir(I_CMP, 3, cc, kv, c, CC_L); ir(I_BZ, 3, -1, cc, -1, l1)
				ir(I_BZ, 3, -1, kv, -1, ls); rtps(", ", false); ir(I_LBL, 3, -1, -1, -1, ls)
				if isq { z := lunflat(ds, q, e); lfmt_a(ds, e); ir(I_MOV, 3, q, bin(B_ADD, 3, q, z, -1), -1, 0); } else { lfmt_a(bin(B_ADD, 3, p, bin(B_MUL, 3, kv, imm(es), -1), -1), e); } ir(I_MOV, 3, kv, bin(B_ADD, 3, kv, imm(1), -1), -1, 0); ir(I_JMP, 3, -1, -1, -1, l0); ir(I_LBL, 3, -1, -1, -1, l1)
				rtps("]", false)
			else:
