import os;
import gfx.codec_png;
import uikit;

fn save(path const byte[:]) {
	var buf byte[>..] = [];
	codec_png::encode(uikit::PW, uikit::PH, 4, uikit::PIX[..], buf);
	if !write_file(path, buf) { print("write failed ", path); abort("genre write"); }
	print("wrote ", path, " ", buf.len);
}

fn font_path(i int, out byte[>..]&) {
	out.clear();
	if i >= 20 { out.append("hc/lib/uikit/fonts/"); } else { out.append("hc/lib/uikit/fonts/catalog/"); }
	out.append(uikit::font_file(i));
}

fn screen_caption(s int) const byte[:] {
	if s == 0 { return "Title"; }
	if s == 1 { return "Pause"; }
	if s == 2 { return "Settings"; }
	if s == 3 { return "HUD"; }
	if s == 4 { return "Bag"; }
	if s == 5 { return "Map"; }
	"Results"
}

fn shape_for(v int) {
	uikit::catalog_set(2 + v * 40);
	uikit::THEME.pixel = 0;
	if v == 0 {
		uikit::THEME.radius = 8.0; uikit::THEME.border_w = 1.0; uikit::THEME.family = uikit::FAM_FLAT; uikit::THEME.shadow = 1; uikit::THEME.glass = 0;
	} else if v == 1 {
		uikit::THEME.radius = 0.0; uikit::THEME.border_w = 3.0; uikit::THEME.family = uikit::FAM_BRUTAL; uikit::THEME.shadow = 2; uikit::THEME.glass = 0;
	} else if v == 2 {
		uikit::THEME.radius = 16.0; uikit::THEME.border_w = 0.0; uikit::THEME.family = uikit::FAM_FLAT; uikit::THEME.shadow = 1; uikit::THEME.glass = 1;
	} else if v == 3 {
		uikit::THEME.radius = 4.0; uikit::THEME.border_w = 2.0; uikit::THEME.family = uikit::FAM_FANTASY; uikit::THEME.shadow = 0; uikit::THEME.glass = 0;
	} else {
		uikit::THEME.radius = 6.0; uikit::THEME.border_w = 1.0; uikit::THEME.family = uikit::FAM_NEON; uikit::THEME.shadow = 3; uikit::THEME.glass = 0;
	}
}

fn centered_kind(k int) bool {
	k == uikit::K_BUTTON || k == uikit::K_FAB || k == uikit::K_BADGE || k == uikit::K_CHIP || k == uikit::K_TAG || k == uikit::K_TOAST || k == uikit::K_DAMAGE || k == uikit::K_MSG
}

fn check_align(g int, col int, ox int, oy int) int {
	var bad = 0;
	var worst_b f32 = 0.0;
	var worst_a f32 = 0.0;
	for i in uikit::N.len {
		if !uikit::shown(i) || uikit::KIDS[i].len > 0 { continue; }
		let x = uikit::N[i].x as int;
		let y = uikit::N[i].y as int;
		let w = uikit::N[i].w as int;
		let h = uikit::N[i].h as int;
		if x % 4 != 0 || y % 4 != 0 || w % 4 != 0 || h % 4 != 0 {
			print("grid ", uikit::genre_slug(g), " col ", col, " ", x, " ", y, " ", w, " ", h);
			bad += 1;
		}
		let rx = x - ox;
		let ry = y - oy;
		if rx < 0 || ry < 0 { bad += 1; }
		if centered_kind(uikit::N[i].kind) && uikit::N[i].str_i >= 0 {
			let s = uikit::s_text(uikit::N[i].str_i);
			let sz = uikit::label_size(i);
			let top = (h - uikit::font_scale(sz) * 7) / 2;
			let bx, by = uikit::label_shift(w as f32, h as f32, s, sz, 10, top as f32);
			let ax, ay = uikit::label_shift(w as f32, h as f32, s, sz, -1, -1.0);
			let bold = if bx > by { bx } else { by };
			let anew = if ax > ay { ax } else { ay };
			if bold > worst_b { worst_b = bold; print("before ", uikit::genre_slug(g), " ", s, " x ", bx, " y ", by); }
			if anew > worst_a { worst_a = anew; }
			if ax > 1.0 || ay > 1.0 {
				print("center ", uikit::genre_slug(g), " ", s, " x ", ax, " y ", ay);
				bad += 1;
			}
		}
	}
	if col == 0 { print("worst before ", worst_b, " after ", worst_a, " ", uikit::genre_slug(g)); }
	for i in uikit::N.len {
		if uikit::N[i].dir != uikit::DIR_ROW || uikit::KIDS[i].len < 2 { continue; }
		var prev = -1000;
		var seen = 0;
		let kn = uikit::KIDS[i].len;
		for a in kn - 1 {
			let c0 = uikit::KIDS[i][a];
			let c1 = uikit::KIDS[i][a + 1];
			let gap = (uikit::N[c1].x - uikit::N[c0].x - uikit::N[c0].w) as int;
			if gap % 4 != 0 || (seen != 0 && gap != prev) {
				print("gap ", uikit::genre_slug(g), " ", gap, " vs ", prev);
				bad += 1;
			}
			prev = gap;
			seen = 1;
		}
	}
	let ierr = uikit::icon_center_err(40, 24);
	if ierr > 1.0 { print("icon center ", ierr); bad += 1; }
	bad
}

fn paint_genre(g int) {
	var dir byte[>..] = [];
	dir.append("docs/ui-gallery/");
	dir.append(uikit::genre_slug(g));
	make_dir(dir[..]);
	if g < 24 {
		uikit::canvas(1296, 760);
		uikit::fill_rect(0, 0, 1296, 760, 0x101218, 255);
		for v in 5 {
			let x = 8 + v * 256;
			shape_for(v);
			uikit::reset();
			let root = uikit::flex(-1, uikit::DIR_COL);
			uikit::build_genre(root, g, v);
			uikit::layout_root(root, x as f32, 8.0, 248.0, 740.0);
			let leaves = uikit::leaf_count();
			let need = uikit::min_leaves(g);
			let bad = check_align(g, v, x, 8);
			let ov = uikit::overlap_count();
			let cl = uikit::text_clip_count();
			if leaves < need || bad != 0 || ov != 0 || cl != 0 {
				print("fail ", uikit::genre_slug(g), " col ", v, " leaves ", leaves, "/", need, " align ", bad, " ov ", ov, " cl ", cl);
				abort("content");
			}
			uikit::paint_roots();
		}
	} else {
		uikit::canvas(2568, 720);
		uikit::fill_rect(0, 0, 2568, 720, 0xF4F4F8, 255);
		for v in 5 {
			let x = 8 + v * 512;
			shape_for(v);
			uikit::reset();
			let root = uikit::flex(-1, uikit::DIR_COL);
			uikit::build_genre(root, g, v);
			uikit::layout_root(root, x as f32, 8.0, 496.0, 700.0);
			let leaves = uikit::leaf_count();
			let need = uikit::min_leaves(g);
			let bad = check_align(g, v, x, 8);
			if leaves < need || bad != 0 || uikit::overlap_count() != 0 || uikit::text_clip_count() != 0 {
				print("fail app ", uikit::genre_slug(g), " ", v, " leaves ", leaves, "/", need);
				abort("content");
			}
			uikit::paint_roots();
		}
	}
	var path byte[>..] = [];
	path.append(dir[..]);
	path.append("/sheet.png");
	save(path[..]);
}

fn paint_icons() {
	make_dir("docs/ui-gallery/icons");
	uikit::canvas(1240, 920);
	uikit::fill_rect(0, 0, 1240, 920, 0x12141A, 255);
	for i in uikit::icon_count() {
		let x = (i % 25) * 48 + 10;
		let y = (i / 25) * 44 + 8;
		uikit::icon_draw(i, x, y, 32, 0xE8EEF6);
	}
	save("docs/ui-gallery/icons/sheet.png");
}

fn paint_effects_on(path const byte[:], bg u32, label u32, ink u32) {
	uikit::canvas(1400, 840);
	uikit::fill_rect(0, 0, 1400, 840, bg, 255);
	var name byte[>..] = [];
	for i in uikit::fx_count() {
		let col = i % 10;
		let row = i / 10;
		let x = 16 + col * 136;
		let y = 16 + row * 80;
		uikit::fx_copy(i, name);
		uikit::draw_centered(x, y, 136, 16, name[..], 11.0, label, 0);
		let tw = uikit::text_advance("Agate", 28.0);
		let asc, desc = uikit::em_box(28.0);
		let bx = (x as f32 + (136.0 - tw) / 2.0 + 0.5) as int;
		let base = ((y + 16) as f32 + (56.0 - asc - desc) / 2.0 + asc + 0.5) as int;
		uikit::fx_draw(i, bx, base, "Agate", 28.0, ink);
	}
	save(path);
}

fn paint_effects() {
	make_dir("docs/ui-gallery/text");
	paint_effects_on("docs/ui-gallery/text/effects-light.png", 0xF7F7F5, 0x3F3F46, 0x111111);
	paint_effects_on("docs/ui-gallery/text/effects-dark.png", 0x12141A, 0xD0D4DC, 0xF8FAFC);
	paint_effects_on("docs/ui-gallery/text/effects.png", 0xF7F7F5, 0x3F3F46, 0x111111);
}

fn paint_styles() {
	make_dir("docs/ui-gallery/widgets");
	uikit::theme_set(0, 0);
	uikit::canvas(1680, 520);
	uikit::fill_rect(0, 0, 1680, 520, uikit::THEME.bg, 255);
	for row in 6 {
		for i in uikit::style_count() {
			uikit::reset();
			let root = uikit::flex(-1, uikit::DIR_COL);
			if row == 0 { let b = uikit::button(root, "Go", i); uikit::set_px(b, 64.0, 28.0); }
			else if row == 1 { let f = uikit::text_field(root, "Name", i); uikit::set_px(f, 72.0, 28.0); }
			else if row == 2 { let t = uikit::toggle(root, "On", 1, i); uikit::set_px(t, 72.0, 28.0); }
			else if row == 3 { let s = uikit::slider(root, 0.55, i); uikit::set_px(s, 72.0, 24.0); }
			else if row == 4 { let c = uikit::card(root, "Card", i); uikit::set_px(c, 72.0, 40.0); }
			else { let b = uikit::badge(root, "New", i); uikit::set_px(b, 56.0, 24.0); }
			uikit::layout_root(root, (8 + i * 82) as f32, (36 + row * 78) as f32, 76.0, 64.0);
			let ov = uikit::overlap_count();
			let cl = uikit::text_clip_count();
			if ov != 0 || cl != 0 { print("style clip ", row, " ", i); abort("styles"); }
			uikit::paint_roots();
		}
	}
	save("docs/ui-gallery/widgets/styles.png");
}

fn paint_fonts() {
	make_dir("docs/ui-gallery/fonts");
	uikit::theme_set(0, 1);
	uikit::canvas(1100, 980);
	uikit::fill_rect(0, 0, 1100, 980, 0xF7F7F5, 255);
	var path byte[>..] = [];
	var loaded = 0;
	for i in uikit::pair_count() {
		let y = 16 + i * 32;
		let body = uikit::pair_body(i);
		let accent = uikit::pair_accent(i);
		font_path(body, path);
		let ok = uikit::sample_open(path[..]);
		if ok { loaded += 1; }
		uikit::draw_text(16, y, uikit::font_file(body), 12.0, 0x222222, 0, -1);
		uikit::draw_text(360, y, uikit::font_file(accent), 12.0, 0x555555, 0, -1);
		if ok {
			var pen = 760;
			let word = "Hamburge";
			var k = 0;
			while k < word.len {
				let cp = word[k] as int;
				let w, h = uikit::sample_glyph(cp, 22.0);
				for py in h {
					for px in w {
						let a = uikit::sample_alpha(px, py);
						if a > 0 { uikit::put(pen + px, y + py + 18, 0x111111, a); }
					}
				}
				pen += w + 1;
				k += 1;
			}
		}
	}
	print("font pairs drawn ", uikit::pair_count(), " loaded ", loaded);
	save("docs/ui-gallery/fonts/pairings.png");
}

fn be_at(b const byte[:], o int) int {
	(b[o] as int) << 24 | (b[o + 1] as int) << 16 | (b[o + 2] as int) << 8 | b[o + 3] as int
}

fn find_chunk(png const byte[:], a int, b int, c int, d int) int, int {
	var o = 8;
	while o + 12 <= png.len {
		let n = be_at(png, o);
		if png[o + 4] == a as! byte && png[o + 5] == b as! byte && png[o + 6] == c as! byte && png[o + 7] == d as! byte {
			return o + 8, n;
		}
		o += 12 + n;
	}
	return -1, 0;
}

fn push_be(out byte[>..]&, v int) {
	out.push((v >> 24) as! byte);
	out.push((v >> 16) as! byte);
	out.push((v >> 8) as! byte);
	out.push(v as! byte);
}

fn save_apng(path const byte[:], w int, h int, frames byte[>..][>..]&) {
	var first byte[>..] = [];
	codec_png::encode(w, h, 4, frames[0][..], first);
	let ih, ihn = find_chunk(first[..], 73, 72, 68, 82);
	if ih < 0 { abort("apng ihdr"); }
	var out byte[>..] = [];
	for i in 8 { out.push(first[i]); }
	codec_png::put_chunk(out, "IHDR", first[ih..ih + ihn]);
	var actl byte[>..] = [];
	push_be(actl, frames.len);
	push_be(actl, 0);
	codec_png::put_chunk(out, "acTL", actl[..]);
	var seq = 0;
	for f in frames.len {
		var png byte[>..] = [];
		if f == 0 { png.append(first[..]); } else { codec_png::encode(w, h, 4, frames[f][..], png); }
		let id, idn = find_chunk(png[..], 73, 68, 65, 84);
		if id < 0 { abort("apng idat"); }
		var fc byte[>..] = [];
		push_be(fc, seq);
		seq += 1;
		push_be(fc, w);
		push_be(fc, h);
		push_be(fc, 0);
		push_be(fc, 0);
		fc.push(0); fc.push(8); fc.push(0); fc.push(100);
		fc.push(0); fc.push(0);
		codec_png::put_chunk(out, "fcTL", fc[..]);
		if f == 0 {
			codec_png::put_chunk(out, "IDAT", png[id..id + idn]);
		} else {
			var fd byte[>..] = [];
			push_be(fd, seq);
			seq += 1;
			fd.append(png[id..id + idn]);
			codec_png::put_chunk(out, "fdAT", fd[..]);
		}
	}
	var empty byte[>..] = [];
	codec_png::put_chunk(out, "IEND", empty[..]);
	if !write_file(path, out[..]) { abort("apng write"); }
	print("wrote ", path, " ", out.len);
}

fn paint_motion() {
	let fw = 420;
	let fh = 180;
	let n = 8;
	var frames byte[>..][>..] = [];
	for f in n {
		uikit::canvas(fw, fh);
		uikit::fill_rect(0, 0, fw, fh, 0x12141A, 255);
		uikit::theme_set(0, 0);
		uikit::reset();
		let root = uikit::flex(-1, uikit::DIR_COL);
		let b = uikit::button(root, "Go", 0);
		uikit::set_px(b, 88.0, 32.0);
		uikit::layout_root(root, 16.0, (64 - f * 4) as f32, 100.0, 40.0);
		uikit::ripple_at(b, uikit::N[b].x + 20.0, uikit::N[b].y + 16.0);
		uikit::RIP[b] = 0.2 + f as f32 * 0.12;
		uikit::paint_roots();
		uikit::draw_text(130, 36, "The gate", 18.0, 0xF8FAFC, 0, f + 1);
		uikit::fill_rect(16 + f * 22, 110, 110, 28, uikit::THEME.accent, 255);
		uikit::draw_text(24 + f * 22, 116, "Saved", 14.0, 0xFFFFFF, 0, -1);
		uikit::fill_rect(150, 128, 220, 12, 0x2A3142, 255);
		uikit::fill_rect(150, 128, 30 + f * 20, 12, 0x7C6BF2, 255);
		uikit::fill_rect(150 + f * 18, 128, 18, 12, 0xFFFFFF, 120);
		var snap byte[>..] = [];
		snap.append(uikit::PIX[..]);
		frames.push(copy(snap));
	}
	save_apng("docs/ui-gallery/motion.apng", fw, fh, frames);
}

fn write_index() {
	var out byte[>..] = [];
	out.append("# UI gallery index\n\n");
	format(out, "Catalog themes: ", uikit::catalog_count(), "\n");
	format(out, "Curated themes: ", uikit::theme_count(), "\n");
	format(out, "Genres: ", uikit::genre_count(), " (", uikit::game_genre_count(), " game, ", uikit::genre_count() - uikit::game_genre_count(), " app)\n");
	format(out, "Each sheet: 5 layout variations. Game columns include the 57dbc71a kit (boss, buffs, bars, minimap, inventory, quest, cooldowns, radial or chart, dialogue, damage, Play/Map/Bag) plus genre extras. Leaf count must be at least that commit.\n");
	format(out, "Icons: ", uikit::icon_count(), "\n");
	format(out, "Text effects: ", uikit::fx_count(), "\n");
	format(out, "Widget styles: ", uikit::style_count(), "\n");
	format(out, "Font files in the pairing set: ", uikit::font_file_count(), "\n");
	format(out, "Font pairings: ", uikit::pair_count(), "\n\n");
	out.append("## Genres\n\n");
	for g in uikit::genre_count() {
		format(out, "- `", uikit::genre_slug(g), "/sheet.png` — ", uikit::genre_name(g), " (ref: ", uikit::genre_ref(g), ")\n");
	}
	out.append("\n## Other sheets\n\n");
	out.append("- `icons/sheet.png`\n- `text/effects-light.png`\n- `text/effects-dark.png`\n- `widgets/styles.png`\n- `fonts/pairings.png`\n- `motion.apng`\n");
	out.append("\n## Still weak\n\n");
	out.append("- Glow and backdrop rectangles are clipped to the widget. `overlap_count` also counts `note_deco` bounds, so a slab painted across another control fails the check.\n");
	out.append("- Game sheets are seven different screens, but pause/settings still share a short menu, and every map uses the same compass painter.\n");
	out.append("- The 500 icons are unique 5x5 silhouettes, not 500 named pictograms (no separate sword, potion, and folder metaphors).\n");
	out.append("- Widget styles are 20 frames on six controls (button, field, toggle, slider, card, badge), not 20 treatments of every chart and table.\n");
	out.append("- `motion.apng` is eight frames (spring, ripple, typewriter, toast, shimmer). It is not a full transition system.\n");
	out.append("- `ui.he` and `gfx/hud` still need SDL3, which this machine does not have.\n");
	if !write_file("docs/ui-gallery/INDEX.md", out[..]) { abort("index write"); }
}

fn main() {
	uikit::set_scale(1.0);
	paint_icons();
	paint_effects();
	paint_styles();
	paint_fonts();
	paint_motion();
	for g in uikit::genre_count() { paint_genre(g); }
	write_index();
	print("genres done");
}
