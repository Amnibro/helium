import os;
import gfx.codec_png;
import uikit;
import text;

fn save(path const byte[:]) {
	var buf byte[>..] = [];
	codec_png::encode(uikit::PW, uikit::PH, 4, uikit::PIX[..], buf);
	if !write_file(path, buf) { print("write failed ", path); abort("gallery write"); }
	print("wrote ", path, " ", buf.len);
}

fn begin(w int, h int, bg u32) {
	let sw = (w as f32 * uikit::SCALE) as int;
	let sh = (h as f32 * uikit::SCALE) as int;
	uikit::canvas(sw, sh);
	uikit::fill_rect(0, 0, sw, sh, bg, 255);
}

fn cell_form(x f32, y f32, w f32, h f32) {
	if uikit::THEME.glass != 0 {
		let sx = (x * uikit::SCALE) as int;
		let sy = (y * uikit::SCALE) as int;
		let sh = (h * uikit::SCALE) as int;
		uikit::fill_rect(sx, sy, 64, sh, 0x7C5CFF, 255);
		uikit::fill_rect(sx + 200, sy, 140, sh, 0xF2C14E, 255);
	}
	uikit::reset();
	let root = uikit::flex(-1, uikit::DIR_COL);
	uikit::set_pad(root, 8.0);
	uikit::set_gap(root, 6.0);
	uikit::button(root, "Save", 0);
	uikit::text_field(root, "Name", 2);
	uikit::toggle(root, "On", 1, 0);
	uikit::slider(root, 0.6, 0);
	uikit::layout_root(root, x, y, w, h);
	uikit::paint_roots();
}

fn themes() {
	begin(980, 640, 0x101218);
	for f in 7 {
		for v in 5 {
			uikit::theme_set(f, v);
			let x = 16 + v * 190;
			let y = 16 + f * 88;
			uikit::reset();
			let root = uikit::stack(-1);
			let b = uikit::button(root, uikit::variant_name(f, v), 0);
			uikit::set_px(b, 160.0, 36.0);
			uikit::layout_root(root, x as f32, y as f32, 170.0, 48.0);
			uikit::paint_roots();
			uikit::draw_text((x as f32 * uikit::SCALE) as int, ((y + 52) as f32 * uikit::SCALE) as int, uikit::family_name(f), 12.0 * uikit::SCALE, 0xD0D4DC, 0, -1);
		}
	}
	save("docs/ui-gallery/themes.png");
}

fn buttons() {
	uikit::theme_set(0, 0);
	begin(900, 520, uikit::THEME.bg);
	uikit::reset();
	let root = uikit::flex(-1, uikit::DIR_COL);
	uikit::set_gap(root, 10.0);
	let row = uikit::flex(root, uikit::DIR_ROW);
	uikit::set_gap(row, 8.0);
	for look in 6 { uikit::button(row, "Button", look); }
	let row2 = uikit::flex(root, uikit::DIR_ROW);
	for look in 6 { uikit::icon_button(row2, look, look); }
	let row3 = uikit::flex(root, uikit::DIR_ROW);
	for look in 6 { uikit::fab(row3, "New", look); }
	let row4 = uikit::flex(root, uikit::DIR_ROW);
	for look in 6 { uikit::toggle(row4, "Switch", look % 2, look); }
	let row5 = uikit::flex(root, uikit::DIR_ROW);
	for look in 6 { uikit::checkbox(row5, "Check", 1, look); }
	let row6 = uikit::flex(root, uikit::DIR_ROW);
	for look in 6 { uikit::radio(row6, "Radio", 1, if look == 0 { 1 } else { 0 }, look); }
	let row7 = uikit::flex(root, uikit::DIR_ROW);
	for look in 6 { let s = uikit::slider(row7, 0.35 + look as f32 * 0.1, look); uikit::set_px(s, 120.0, 28.0); }
	uikit::layout_root(root, 16.0, 16.0, 860.0, 480.0);
	uikit::paint_roots();
	save("docs/ui-gallery/buttons.png");
}

fn inputs() {
	uikit::theme_set(0, 2);
	begin(900, 560, uikit::THEME.bg);
	uikit::reset();
	let root = uikit::flex(-1, uikit::DIR_COL);
	let row = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::text_field(row, "Field", look); }
	let rowb = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { let a = uikit::text_area(rowb, "Notes", look); uikit::set_px(a, 140.0, 64.0); }
	let rowc = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::dropdown(rowc, "Select", look); }
	let rowd = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::combobox(rowd, "Search", look); }
	let rowe = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::date_picker(rowe, 2026, 11, 13, look); }
	let rowf = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::time_picker(rowf, 15, 42, look); }
	let rowg = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { let c = uikit::color_picker(rowg, 0x3B6FE2, look); uikit::set_px(c, 150.0, 40.0); }
	let rowh = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { let s = uikit::stepper(rowh, 3.0 + look as f32, look); uikit::set_px(s, 120.0, 36.0); }
	uikit::layout_root(root, 12.0, 12.0, 870.0, 530.0);
	uikit::paint_roots();
	save("docs/ui-gallery/inputs.png");
}

fn overlays() {
	uikit::theme_set(1, 0);
	begin(900, 520, uikit::THEME.bg);
	uikit::fill_rect(80, 40, 240, 120, uikit::THEME.accent, 50);
	uikit::reset();
	let root = uikit::flex(-1, uikit::DIR_COL);
	let m = uikit::modal(root, "Confirm delete", 1, 0);
	uikit::set_px(m, 280.0, 120.0);
	let d = uikit::drawer(root, "Filters", 1, 2);
	uikit::set_px(d, 280.0, 72.0);
	let row = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::toast(row, "Saved", look); }
	let rowb = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::tooltip(rowb, "Hint", look); }
	let rowc = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::popover(rowc, "Details", 1, look); }
	let rowd = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::message_bar(rowd, "Update ready", look); }
	uikit::layout_root(root, 16.0, 16.0, 860.0, 480.0);
	uikit::paint_roots();
	save("docs/ui-gallery/overlays.png");
}

fn data() {
	uikit::theme_set(0, 3);
	begin(900, 520, uikit::THEME.bg);
	uikit::reset();
	let root = uikit::flex(-1, uikit::DIR_ROW);
	uikit::set_gap(root, 16.0);
	let tb = uikit::table(root, 4, 2, 0);
	uikit::set_px(tb, 280.0, 140.0);
	uikit::table_set(tb, 0, 0, "Ada"); uikit::table_set(tb, 0, 1, "12");
	uikit::table_set(tb, 1, 0, "Bea"); uikit::table_set(tb, 1, 1, "9");
	uikit::table_set(tb, 2, 0, "Cal"); uikit::table_set(tb, 2, 1, "4");
	uikit::table_set(tb, 3, 0, "Dee"); uikit::table_set(tb, 3, 1, "7");
	let vl = uikit::virtual_list(root, 40, 1);
	uikit::set_px(vl, 180.0, 160.0);
	uikit::N[vl].val = 0.0;
	let col = uikit::flex(root, uikit::DIR_COL);
	let tabs = uikit::tabs(col, 0);
	uikit::button(tabs, "All", 0);
	uikit::button(tabs, "Open", 2);
	uikit::accordion(col, "Details", 1, 1);
	uikit::tree_node(col, "World", 1, 2);
	let mn = uikit::menu(col, 0);
	uikit::button(mn, "Open", 0);
	uikit::button(mn, "Rename", 2);
	uikit::pagination(col, 2, 8, 0);
	uikit::layout_root(root, 16.0, 16.0, 860.0, 480.0);
	uikit::paint_roots();
	save("docs/ui-gallery/data.png");
}

fn content() {
	uikit::theme_set(4, 2);
	begin(900, 480, uikit::THEME.bg);
	uikit::reset();
	let root = uikit::flex(-1, uikit::DIR_COL);
	let row = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::badge(row, "New", look); }
	let rowb = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::chip(rowb, "Tag", look); }
	let rowc = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { uikit::avatar(rowc, "AR", look); }
	let rowd = uikit::flex(root, uikit::DIR_ROW);
	for look in 5 { let c = uikit::card(rowd, "Card", look); uikit::set_px(c, 140.0, 80.0); }
	uikit::breadcrumbs(root, "Home / Library / Text", 0);
	uikit::rating(root, 4, 0);
	uikit::progress(root, 0.66, 0);
	uikit::layout_root(root, 16.0, 16.0, 860.0, 440.0);
	uikit::paint_roots();
	save("docs/ui-gallery/content.png");
}

fn textpage() {
	uikit::theme_set(0, 1);
	begin(900, 640, uikit::THEME.bg);
	uikit::reset();
	let root = uikit::flex(-1, uikit::DIR_COL);
	uikit::set_gap(root, 4.0);
	for p in text::preset_count() {
		uikit::label(root, text::preset_name(p), p);
	}
	let italic = uikit::label(root, "Italic sample", 5);
	uikit::N[italic].flags = uikit::N[italic].flags | 256;
	uikit::layout_root(root, 16.0, 12.0, 420.0, 700.0);
	uikit::paint_roots();
	uikit::reset();
	let col = uikit::flex(-1, uikit::DIR_COL);
	for e in text::effect_count() {
		let id = uikit::label(col, text::effect_name(e), 4);
		uikit::set_effect(id, e);
		if e == 6 { uikit::N[id].i0 = 10; }
	}
	uikit::layout_root(col, 320.0, 12.0, 280.0, 600.0);
	uikit::paint_roots();
	save("docs/ui-gallery/text.png");
}

fn hud() {
	uikit::theme_set(2, 0);
	begin(960, 780, uikit::THEME.bg);
	uikit::reset();
	let root = uikit::flex(-1, uikit::DIR_COL);
	let row = uikit::flex(root, uikit::DIR_ROW);
	for look in 6 { let h = uikit::health_bar(row, 0.25 + look as f32 * 0.12, look); uikit::set_px(h, 120.0, 18.0); }
	let rowb = uikit::flex(root, uikit::DIR_ROW);
	for look in 6 { let h = uikit::mana_bar(rowb, 0.8 - look as f32 * 0.1, look); uikit::set_px(h, 120.0, 18.0); }
	let rowc = uikit::flex(root, uikit::DIR_ROW);
	uikit::minimap(rowc, 0);
	uikit::inventory(rowc, 4, 3, 1);
	uikit::radial(rowc, 6, 2, 4);
	let rowd = uikit::flex(root, uikit::DIR_ROW);
	for look in 4 { let d = uikit::dialogue(rowd, "The gate is open.", if look == 3 { 40 } else { 4 + look * 4 }, look); uikit::set_px(d, 210.0, 64.0); }
	let rowe = uikit::flex(root, uikit::DIR_ROW);
	for look in 6 { uikit::damage_number(rowe, "128", look); }
	uikit::layout_root(root, 12.0, 12.0, 920.0, 740.0);
	uikit::paint_roots();
	save("docs/ui-gallery/hud.png");
}

fn families() {
	begin(980, 1400, 0x0E1014);
	for f in 7 {
		for v in 5 {
			uikit::theme_set(f, v);
			cell_form((12 + v * 192) as f32, (12 + f * 196) as f32, 180.0, 184.0);
		}
	}
	save("docs/ui-gallery/families.png");
}

fn motion() {
	let fw = 420;
	let fh = 200;
	let frames = 8;
	uikit::canvas(fw * frames * 2, fh * 2);
	uikit::fill_rect(0, 0, fw * frames * 2, fh * 2, 0x12141A, 255);
	var vel f32 = 0.0;
	var pos f32 = 0.0;
	for f in frames {
		uikit::theme_set(0, 0);
		uikit::reset();
		let root = uikit::flex(-1, uikit::DIR_COL);
		let b = uikit::button(root, "Ripple", 0);
		uikit::set_px(b, 160.0, 44.0);
		let d = uikit::dialogue(root, "The gate is open.", f + 1, 0);
		uikit::set_px(d, 280.0, 64.0);
		pos = uikit::spring_step(pos, vel, 1.0 as f32, 0.08 as f32);
		uikit::layout_root(root, 16.0 + f as f32 * fw as f32, 24.0 + (1.0 - pos) * 30.0, 380.0, 160.0);
		uikit::ripple_at(b, uikit::N[b].x + 20.0, uikit::N[b].y + 20.0);
		uikit::RIP[b] = 0.15 + f as f32 * 0.12;
		uikit::paint_roots();
	}
	save("docs/ui-gallery/motion.png");
}

fn main() {
	uikit::set_scale(2.0);
	themes();
	buttons();
	inputs();
	overlays();
	data();
	content();
	textpage();
	hud();
	families();
	motion();
	print("gallery done");
}
