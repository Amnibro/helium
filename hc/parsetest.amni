import os;
import parse;
fn main() {
	var line byte[>..] = [];
	var nf = 0; var bad = 0;
	while read_line(line) {
		PERR.clear(); LERR.clear();
		if !parse_file(trim(line)) { bad++; print(PERR); }
		nf++;
		line.clear();
	}
	print(nf, " files, ", bad, " failed, ", TK.len, " tokens, ", ND.len, " nodes, ", TOP.len, " decls");
}
