use os
use decl
struct Sv { key i32, val i32 }
var SCV Sv[>..]
var PERRS byte[>..]
sc_known(k const byte[:]) bool:
	for w ["c_sources", "c_include", "c_defines", "c_flags_cc", "c_flags_msvc", "c_libs", "cmake_target", "cmake_options", "dylibs", "main_thread_only", "exclude", "output"] { if k == w { return true } for sfx ["_windows", "_linux", "_macos"] { if k.len == w.len + sfx.len && k[..w.len] == w && k[w.len..] == sfx { return true } } } false
sc_base(k const byte[:]) byte[>..]:
	b byte[>..] ~= []; b.append(k); if k.len > 6 && k[^6..] == "_linux" { b.resize(k.len - 6) } b
sc_vals(k const byte[:]) byte[:][>..]:
	r byte[:][>..] ~= []; for v SCV { if nm(v.key) == k { r.push(nm(v.val)) } } r
sc_parse(path const byte[:], t const byte[:]) bool:
	i ~= 0; key ~= -1; lst ~= false
	bad(m const byte[:]) bool:
		format(PERRS, path, ": ", m); false
	loop:
		while i < t.len && (t[i] == ' ' || t[i] == '\t' || t[i] == '\r' || t[i] == '\n'): i++
		if i + 1 < t.len && t[i] == '/' && t[i + 1] == '/': while i < t.len && t[i] != '\n' { i++ } continue
		if i >= t.len: return key < 0 || bad("the file ends inside an entry")
		c u8 := t[i]
		if key < 0: s := i; while i < t.len && (t[i] >= 'a' && t[i] <= 'z' || t[i] >= 'A' && t[i] <= 'Z' || t[i] >= '0' && t[i] <= '9' || t[i] == '_') { i++ } if i == s { return bad("expected a key") } k := t[s..i]; if !sc_known(k) { m byte[>..] ~= []; format(m, "unknown key ", k, "; the keys are c_sources, c_include, c_defines, c_flags_cc, c_flags_msvc, c_libs, cmake_target, cmake_options, dylibs, main_thread_only, exclude and output"); return bad(m[..]) } bk := sc_base(k); key = if k.len > 8 && (k[^8..] == "_windows" || k[^6..] == "_macos") { -2 } else { intern(bk[..]) }; while i < t.len && (t[i] == ' ' || t[i] == '\t') { i++ } if i >= t.len || t[i] != '=' { return bad("expected = after a key") } i++; continue
		if c == ';' && !lst: key = -1; i++; continue
		if c == '[' && !lst: lst = true; i++; continue
		if c == ']' && lst: lst = false; i++; continue
		if c == ',' && lst: i++; continue
		if c == '"': v byte[>..] ~= []; i++; while i < t.len && t[i] != '"' { if t[i] == '\\' && i + 1 < t.len { i++ } v.push(t[i]); i++ } i++; if key >= 0 { SCV.push(Sv{key, intern(v[..])}) } continue
		s := i; while i < t.len && t[i] != ';' && t[i] != ',' && t[i] != ']' && t[i] != ' ' && t[i] != '\n' { i++ } if i == s { return bad("unexpected character") } if key >= 0: SCV.push(Sv{key, intern(t[s..i])})
q(b byte[>..]&, s const byte[:]): b.append(" '"); for c s { if c == '\'' { b.append("'\\''"); } else { b.push(c); } } b.push('\'');
newer(a const byte[:], t int) bool:
	m := file_mtime(a); m < 0 || m > t
locked(cmd const byte[:], dir const byte[:]) byte[>..]:
	b byte[>..] ~= []; b.append("{ flock 9 && "); b.append(cmd); b.append("; } 9>"); l byte[>..] ~= []; l.append(dir); l.append("/build.lock"); q(b, l[..]); b
run_ok(cmd const byte[:], log const byte[:], what const byte[:], dir const byte[:]) bool:
	if run_command(locked(cmd, dir)[..]) == 0: return true
	lg byte[>..] ~= []; read_file(log, lg); nl ~= 0; j ~= lg.len; while j > 0 && nl < 20:
		j--; if lg[j] == '\n': nl++
	format(PERRS, what, " failed; its log is ", log, "\n", lg[j..]); false
pkg_syms(k int) byte[>..]:
	b byte[>..] ~= []; ns byte[:][>..] ~= []
	for d DC:
		n := d.node; if d.k as int == D_FN && ND[n].fl & F_EXTERN != 0 && node_file(n) < FPKG.len && FPKG[node_file(n)] == k:
			x := ND[n].e; if x < 0 || ND[x].b < 0:
				sy := if x >= 0 && ND[x].a >= 0 { tok_str(ND[x].a) } else { nm(ND[n].s) }; if sy.len > 0 && sy[0] != '!' && !ns.contains(sy): ns.push(sy)
	for sy ns { format(b, sy, "\n") } b
build_pkg(k int) bool:
	name := nm(PKS[k].name); root byte[>..] ~= []; root.append(nm(PKS[k].root))
	sc byte[>..] ~= []; sc.append(root[..]); sc.push('/'); sc.append(name); sc.append(".build")
	if !file_exists(sc[..]): return true
	txt byte[>..] ~= []; read_file(sc[..], txt); SCV.clear(); if !sc_parse(sc[..], txt[..]): return false
	for v sc_vals("main_thread_only"):
		if v == "true": PKS[k].mt = true
	srcs := sc_vals("c_sources"); ct := sc_vals("cmake_target")
	if srcs.len == 0 && ct.len == 0: return true
	out byte[>..] ~= goose_home(); out.append("/build/hc/"); out.append(nm(PKS[k].key))
	so byte[>..] ~= []; so.append(out[..]); so.append("/lib"); so.append(name); so.append(".so")
	st := file_mtime(so[..]); stale ~= st < 0 || newer(sc[..], st)
	for s srcs:
		p byte[>..] ~= []; p.append(root[..]); p.push('/'); p.append(s); if newer(p[..], st): stale = true
	sl byte[>..] ~= []; sl.append(out[..]); sl.append("/hc_syms.list"); os byte[>..] ~= []; read_file(sl[..], os); sy := pkg_syms(k); mst := stale; p0 ~= 0; for c, ci sy:
		if c == '\n': hit ~= false; q0 ~= 0; for d, di os { if d == '\n' { if os[q0..di] == sy[p0..ci] { hit = true } q0 = di + 1 } } if !hit && ct.len > 0 { stale = true } p0 = ci + 1
	PKS[k].so = intern(so[..])
	if !stale: return true
	mk byte[>..] ~= []; mk.append("mkdir -p"); q(mk, out[..]); if run_command(mk[..]) != 0: format(PERRS, "cannot make ", out[..]); return false
	log byte[>..] ~= []; log.append(out[..]); log.append("/build.log")
	cmd byte[>..] ~= []
	if ct.len == 0:
		cmd.append("cd"); q(cmd, root[..]); cmd.append(" && nice -n 19 cc -O2 -fPIC -shared -w")
		for s sc_vals("c_include"): cmd.append(" -I"); q(cmd, s)
		for s sc_vals("c_defines"): cmd.append(" -D"); q(cmd, s)
		for s sc_vals("c_flags_cc"): q(cmd, s)
		for s srcs: q(cmd, s)
		tmp byte[>..] ~= []; tmp.append(so[..]); tmp.append(".tmp")
		cmd.append(" -o"); q(cmd, tmp[..])
		for s sc_vals("c_libs"): cmd.append(" -l"); q(cmd, s)
		cmd.append(" -lm >"); q(cmd, log[..]); cmd.append(" 2>&1 && mv"); q(cmd, tmp[..]); q(cmd, so[..])
		what byte[>..] ~= []; format(what, "building the C part of the package ", name)
		return run_ok(cmd[..], log[..], what[..], out[..])
	w byte[>..] ~= []; format(w, "cmake_minimum_required(VERSION 3.20)\nproject(hc_pkg_", name, " C)\ninclude(CheckLanguage)\ncheck_language(CXX)\nif(CMAKE_CXX_COMPILER)\nenable_language(CXX)\nendif()\nset(CMAKE_POSITION_INDEPENDENT_CODE ON)\nadd_subdirectory(\"", root[..], "\" pkg EXCLUDE_FROM_ALL)\nif(NOT TARGET ", ct[0], ")\nmessage(FATAL_ERROR \"the package ", name, "'s sidecar names the CMake target ", ct[0], ", which ", root[..], "/CMakeLists.txt does not define\")\nendif()\nadd_library(hc_", name, " SHARED \"", out[..], "/hc_syms.c\")\ntarget_link_libraries(hc_", name, " PRIVATE ", ct[0], ")\nset_target_properties(hc_", name, " PROPERTIES OUTPUT_NAME ", name, " LIBRARY_OUTPUT_DIRECTORY \"", out[..], "/stage\")\n")
	wd byte[>..] ~= []; wd.append(out[..]); wd.append("/wrapper"); wf byte[>..] ~= []; wf.append(wd[..]); wf.append("/CMakeLists.txt")
	mf byte[>..] ~= []; format(mf, sl[..], ".", random_seed(), ".mine"); if !write_file(mf[..], sy[..]): format(PERRS, "cannot write ", mf[..]); return false
	old byte[>..] ~= []; read_file(wf[..], old); mk.clear(); mk.append("mkdir -p"); q(mk, wd[..]); run_command(mk[..]); if old[..] != w[..] && !write_file(wf[..], w[..]): format(PERRS, "cannot write ", wf[..]); return false
	bd byte[>..] ~= []; bd.append(out[..]); bd.append("/cmake")
	sc0 byte[>..] ~= []; sc0.append(out[..]); sc0.append("/hc_syms.c"); nf byte[>..] ~= []; nf.append(sl[..]); nf.append(".new")
	cmd.append("touch"); q(cmd, sl[..]); cmd.append(" && sort -u"); q(cmd, sl[..]); q(cmd, mf[..]); cmd.append(" >"); q(cmd, nf[..]); cmd.append("; rm -f"); q(cmd, mf[..]); cmd.append("; if [ "); cmd.append(if mst { "1" } else { "0" }); cmd.append(" = 0 ] && cmp -s"); q(cmd, nf[..]); q(cmd, sl[..]); cmd.append(" && [ -f"); q(cmd, so[..]); cmd.append(" ]; then rm -f"); q(cmd, nf[..]); cmd.append("; exit 0; fi; mv"); q(cmd, nf[..]); q(cmd, sl[..]); cmd.append(" && awk '{ print \"void \" $0 \"(void);\"; s = s \", (void *)\" $0 } END { print \"__attribute__((used)) void *const hc_syms[] = { 0\" s \" };\" }'"); q(cmd, sl[..]); cmd.append(" >"); q(cmd, sc0[..]); cmd.append(" || exit 1; ")
	cmd.append("command -v cmake >/dev/null || { echo 'cannot find cmake on PATH, needed to build the C part of the package "); cmd.append(name); cmd.append("; install CMake 3.20 or later' >"); q(cmd, log[..]); cmd.append("; exit 1; }; cmake -S"); q(cmd, wd[..]); cmd.append(" -B"); q(cmd, bd[..]); cmd.append(" -DCMAKE_BUILD_TYPE=Release")
	if run_command("command -v ninja >/dev/null") == 0: cmd.append(" -G Ninja")
	for s sc_vals("cmake_options"): cmd.append(" -D"); q(cmd, s)
	cmd.append(" >"); q(cmd, log[..]); cmd.append(" 2>&1 && nice -n 19 cmake --build"); q(cmd, bd[..]); cmd.append(" --target hc_"); cmd.append(name); cmd.append(" -j 7 >>"); q(cmd, log[..]); cmd.append(" 2>&1 && cp"); stg byte[>..] ~= []; stg.append(out[..]); stg.append("/stage/lib"); stg.append(name); stg.append(".so"); q(cmd, stg[..]); tmp byte[>..] ~= []; tmp.append(so[..]); tmp.append(".tmp"); q(cmd, tmp[..]); cmd.append(" && mv"); q(cmd, tmp[..]); q(cmd, so[..])
	what byte[>..] ~= []; format(what, "building the C part of the package ", name, " (CMake target ", ct[0], ")")
	run_ok(cmd[..], log[..], what[..], out[..])
struct Shb { node i32, off i32, n i32 }
var SHB byte[>..]; var SHN Shb[>..]
shader_blob(n int) const byte[:]:
	for e SHN { if e.node == n { return SHB[(e.off as int)..e.off + e.n] } } ""
shader_tool(err byte[>..]&) byte[>..]:
	t byte[>..] ~= goose_home(); t.append("/build/hc/shaderc"); exe byte[>..] ~= []; exe.append(t[..]); exe.append("/hc-shaderc")
	sd byte[>..] ~= []; sd.append(LIBDIR[..]); sd.append("/../shaderc"); sc byte[>..] ~= []; sc.append(sd[..]); sc.append("/hc_shaderc.c"); sc2 byte[>..] ~= []; sc2.append(sd[..]); sc2.append("/shaderc.c")
	m := file_mtime(exe[..]); if m >= 0 && !newer(sc[..], m) && !newer(sc2[..], m): return exe
	cmd byte[>..] ~= []; cmd.append("mkdir -p"); q(cmd, t[..]); cmd.append(" && nice -n 19 cc -O2 -w -I"); q(cmd, sd[..]); cmd.append(" -I"); cs byte[>..] ~= []; cs.append(LIBDIR[..]); cs.append("/../../third_party/cute_spirv"); q(cmd, cs[..]); q(cmd, sc[..]); cmd.append(" -o"); tmp byte[>..] ~= []; tmp.append(exe[..]); tmp.append(".tmp"); q(cmd, tmp[..]); cmd.append(" -lm 2>&1 && mv"); q(cmd, tmp[..]); q(cmd, exe[..])
	mk0 byte[>..] ~= []; mk0.append("mkdir -p"); q(mk0, t[..]); run_command(mk0[..])
	if run_command(locked(cmd[..], t[..])[..]) != 0 { err.append("cannot build the shader compiler from "); err.append(sc[..]); exe.clear() } exe
shader_compile(n int, stage int, path const byte[:], src const byte[:], err byte[>..]&) bool:
	key byte[>..] ~= []; format(key, stage, "\n", path, "\n"); key.append(src); h := hash(key[..])
	d byte[>..] ~= goose_home(); d.append("/build/hc/shaderc/cache"); bf byte[>..] ~= []; format(bf, d[..], "/", h, ".blob")
	blob byte[>..] ~= []
	if !read_file(bf[..], blob):
		exe := shader_tool(err); if exe.len == 0: return false
		mk byte[>..] ~= []; mk.append("mkdir -p"); q(mk, d[..]); run_command(mk[..])
		u := random_seed(); sf byte[>..] ~= []; format(sf, d[..], "/", h, "-", u, ".src"); ef byte[>..] ~= []; format(ef, d[..], "/", h, "-", u, ".err"); tb byte[>..] ~= []; format(tb, d[..], "/", h, "-", u, ".tmp")
		if !write_file(sf[..], src): err.append("cannot write "); err.append(sf[..]); return false
		cmd byte[>..] ~= []; cmd.append("[ -f"); q(cmd, bf[..]); cmd.append(" ] ||"); q(cmd, exe[..]); format(cmd, " ", stage); q(cmd, path); q(cmd, sf[..]); q(cmd, tb[..]); cmd.append(" 2>"); q(cmd, ef[..]); cmd.append(" && mv"); q(cmd, tb[..]); q(cmd, bf[..])
		ok := run_command(locked(cmd[..], d[..])[..]) == 0; delete_file(sf[..]); delete_file(tb[..])
		if !ok: read_file(ef[..], err); delete_file(ef[..]); while err.len > 0 && err[err.len - 1] == '\n' { err.pop() } if err.len == 0 { err.append("shader compilation failed") } return false
		delete_file(ef[..]); if !read_file(bf[..], blob): err.append("cannot read "); err.append(bf[..]); return false
	SHN.push(Shb{n, SHB.len, blob.len}); SHB.append(blob[..]); true
fstem(f int) const byte[:]:
	s := nm(FILES[f].name); a ~= 0; e ~= s.len; for c, i s { if c == '/' { a = i + 1 } } for c, i s[a..] { if c == '.' { e = a + i } } s[a..e]
thread_check() bool:
	for t, ti FI_:
		if t.node >= 0 && ND[t.node].fl & F_THREAD != 0:
			seen i32[>..] ~= [ti as i32]; q ~= 0
			while q < seen.len:
				cr := seen[q]; q++
				for e CEDGES:
					if e.caller == cr && !seen.contains(e.callee):
						c := e.callee; seen.push(e.callee)
						f := node_file(FI_[c].node); k := if f < FPKG.len { FPKG[f] as int } else { -1 }
						if is_ext(c) && k >= 0 && PKS[k].mt:
							n ~= -1; sa := AOWN; AOWN = cr; for x (FI_[cr].lo as int)..FI_[cr].hi as int { if n < 0 && ND[x].k as int == N_CALL && rk(x) == R_FN && rv(x) == c { n = x } } AOWN = sa
							format(PERRS, nm(FILES[node_file(max(n, FI_[c].node))].name), ":", TK[ND[max(n, FI_[c].node)].t].line, ": error: ", fstem(f), " runs on the main thread only: ", nm(FI_[c].name), " is reached from thread_fn ", nm(t.name)); return false
	true
build_packages() bool:
	for k PKS.len { if !build_pkg(k) { return false } } thread_check()
