		if ND[kid(n, j)].k as int == N_ID && rk(kid(n, j)) == R_LOCAL && ppar(rv(kid(n, j))) && ptgt(act) != -1: padp(ptgt(act), pidx(rv(kid(n, j))), q[3 * x + 2] as int)
		if !PCH || !rr.contains(act as i32): continue
		tn byte[>..] ~= []; pidn(act, tn)
		m byte[>..] ~= []; m.append("cannot call "); m.append(nm(ND[fq].s)); m.append(": it shrinks "); m.append(tn); m.append(" while "); m.append(nm(q[3 * x + 2] as int)); m.append(" is still used, and "); m.append(nm(q[3 * x + 2] as int)); m.append(" may refer into "); m.append(tn); m.append(" (§5.2)"); cerr(n, m[..])
recursive psz(e int, m byte[>..]&) int:
	if e < 0: return -1
