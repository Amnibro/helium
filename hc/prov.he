pcwadd(f int, x int, y int, t int): while PCW.len <= f { PCW.push([]) } q := PCW[f]; for i in 0..(q.len / 3) { if q[3 * i] == x as i32 && q[3 * i + 1] == y as i32 && q[3 * i + 2] == t as i32 { return } } PCW[f].push(x as i32); PCW[f].push(y as i32); PCW[f].push(t as i32)
