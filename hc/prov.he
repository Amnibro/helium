ndel(k int): c := ncp(); NNS.clear(); for x c { if x as int != k { NNS.push(x) } }
nrep(k int) bool: !NSUM && NSIL == 0 && nopt(k) && !NNS.contains(k as i32) && (k < 0 && !NFV || k >= 0 && (LVS[k].cfn == PI as i32 || pown(k)))
ncap(k int) bool: k >= 0 && LVS[k].cfn != PI as i32 && !pown(k)
