		if ub && tg != -1 && pp < 0 && v < PVRS.len: for r PVRS[v] { if r >= 0 && ppar(r as int) && (isrs(LVS[r].ty as int) || hold(pdr(LVS[r].ty as int))) { pp = r as int } }
		pr := pp >= 0
