cbm(v int) bool: d := LVS[v].node as int; d >= 0 && ND[d].k as int == N_ARM && ND[d].fl & 2 == 0 && ND[d].s as int == LVS[v].name as int
hkp(h int, c bool) bool: h >= 0 && h < NPW.len && FI_[h].pn > 1 && ((if c { NPC[h] } else { NPW[h] }) >> 1) & 1 != 0 && !tpc(ND[kid(FI_[h].node as int, 1)].a as int)
