nnull(e int) bool: k := nkey(e); if k > -9999 && nopt(k) { return !NNS.contains(k as i32) } ND[e].k as int == N_NULL || at(e) > 0 && TY[at(e)].k as int == TY_REF && TY[at(e)].fl & RF_OPT != 0 || at(e) > 0 && TY[at(e)].k as int == TY_NULL
