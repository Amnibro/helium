use calls
struct Pv { d i32, v i32, m i64 }
var PDEP i32[>..]
var PBD i32[>..]
var PBV i32[>..]
var PBM i64[>..]
var PRM i64[>..]
var SHR i64[>..]
var SHG (i32[>..])[>..]
var PPR (i32[>..])[>..]
var PCL i32[>..]
var PCG i32[>..]
var PMK i32[>..]
var PTL i32[>..]
var PVRS (i32[>..])[>..]
var PBN i32[>..]
var PBS i32[>..]
var PBJ i32[>..]
var PLP i32[>..]
var PBK i32[>..]
PVK ~= 1
PCH ~= false
PI ~= -1
pnone() Pv: Pv{-9, -1, 0}
ptemp() Pv: Pv{(2 * PVK + 1) as i32, -1, 0}
pmerge(a Pv, b Pv) Pv: Pv{if a.d >= b.d { a.d } else { b.d }, if a.d >= b.d { a.v } else { b.v }, a.m | b.m}
recursive hold(t int) bool:
	if t < 0: return false
	x := TY[t]; k := x.k as int
	if isrs(t): return true
	if k == TY_STRUCT: si := x.a as int; for j STI[si].fnum { if hold(SFI[STI[si].f0 as int + j].ty as int) { return true } } return false
	if k == TY_ARR: return hold(x.a as int)
	false
isrs(t int) bool: t >= 0 && (TY[t].k == TY_SLICE || TY[t].k == TY_REF && TY[t].c < 0 && TY[t].fl & RF_OPT == 0)
pgrow(v int): while PDEP.len <= v { PDEP.push(-1); PBD.push(-9); PBV.push(-1); PBM.push(0); PVRS.push([]); PBN.push(-1) }
pbset(v int, p Pv, mg bool, nd int):
	pgrow(v); q := if mg { pmerge(Pv{PBD[v], PBV[v], PBM[v]}, p) } else { p }; PBD[v] = q.d; PBV[v] = q.v; PBM[v] = q.m
	if !mg: PVRS[v].clear()
	if p.v != -1 && !PVRS[v].contains(p.v): PVRS[v].push(p.v); PBN[v] = nd as i32
pdep(v int) int: pgrow(v); if LVS[v].cfn != PI as i32 { 0 } else if PDEP[v] < 0 { 2 } else { PDEP[v] as int }
pbind(v int) Pv:
	pgrow(v); l := LVS[v]
	if l.fl & LV_PARAM != 0 || l.cfn != PI as i32: Pv{0, v as i32, if l.cfn != PI as i32 { 0 } else { (1 as i64) << min(pidx(v), 30) }}
	else: Pv{PBD[v], PBV[v], PBM[v]}
pidx(v int) int: nd := FI_[PI].node as int; for j ND[nd].n { if rv(kid(nd, j)) == v { return j } } 62
recursive pl(n int) Pv:
	k := ND[n].k as int; if at(n) < 0 && rk(n) == R_NONE { return pnone() }
	if k == N_ID:
		r := rk(n); if r == R_GLOBAL { return Pv{-2, (-3 - rv(n)) as i32, 0} } if r == R_CONST { return Pv{-2, -1, 0} } if r != R_LOCAL { return ptemp() }
		v := rv(n); l := LVS[v]
		if rref(l.ty as int) || l.fl & LV_FOR != 0: return pbind(v)
		if l.fl & LV_PARAM != 0: return Pv{2, v as i32, 0}
		return Pv{pdep(v) as i32, v as i32, 0}
	if k == N_DOT || k == N_IDX || k == N_SLICE:
		rw := fraw(n); if rw >= 0 && (TY[rw].k as int == TY_REF && TY[rw].c >= 0 || has_rel(rw)) { return pnone() }
		bt := at(ND[n].a as int); if isrs(bt) || rw >= 0 && rref(rw) { return pv(ND[n].a as int) } return pl(ND[n].a as int)
	if k == N_AS || k == N_UN && ND[n].op as int == T_AND: return pl(ND[n].a as int)
	if k == N_STR: return Pv{-2, -1, 0}
	if k == N_NULL: return pnone()
	if k == N_CALL: ct := if rk(n) == R_FN { FI_[rv(n)].ret as int } else { at(n) }; return if ct >= 0 && TY[ct].k as int == TY_REF { if rk(n) == R_FN { pvcall(n) } else { pnone() } } else { ptemp() }
	if k == N_IF: return pmerge(plb(ND[n].b as int), plb(ND[n].c as int))
	if k == N_BLOCK: return plb(n)
	if k == N_EBLOCK: return plb(ND[n].a as int)
	if k == N_MATCH: r ~= pnone(); for j ND[n].n { r = pmerge(r, plb(ND[kid(n, j)].b as int)) } return r
	ptemp()
pdr(t int) int: if t < 0 { 0 } else { deref(t) }
rref(t int) bool: t >= 0 && TY[t].k as int == TY_REF && TY[t].c < 0
fraw(n int) int:
	k := ND[n].k as int; bt := pdr(at(ND[n].a as int)); if bt < 0 { return -1 }
	if k == N_DOT && rk(n) == R_FIELD && TY[bt].k as int == TY_STRUCT { SFI[STI[TY[bt].a].f0 as int + rv(n)].ty as int } else if k == N_IDX && (TY[bt].k as int == TY_ARR || TY[bt].k as int == TY_SLICE) { TY[bt].a as int } else { -1 }
recursive pvin(t int, e int) Pv:
	if t < 0 || e < 0: return pva(e)
	k := TY[t].k as int
	if rref(t) || k == TY_SLICE && !isrs(at(e)): return pl(e)
	if k == TY_ARR && ND[e].k as int == N_ARR: r ~= pnone(); for j ND[e].n { r = pmerge(r, pvin(TY[t].a as int, kid(e, j))) } return r
	pva(e)
recursive pstrip(e int) int: if ND[e].k as int == N_SLICE { pstrip(ND[e].a as int) } else { e }
pdiv(e int) bool: k := ND[e].k as int; t := at(e); k == N_RET || k == N_BREAK || k == N_CONT || t < 0 || TY[t].k as int == TY_VOID
plb(b int) Pv:
	if b < 0: return pnone()
	if ND[b].k as int == N_BLOCK: return if ND[b].a >= 0 && !pdiv(ND[b].a as int) { pl(ND[b].a as int) } else { pnone() }
	pl(b)
recursive pv(n int) Pv:
	if n < 0: return pnone()
	k := ND[n].k as int; t := at(n)
	if k == N_ID:
		r := rk(n); if r == R_GLOBAL { return Pv{-2, -1, 0} } if r != R_LOCAL { return pnone() }
		v := rv(n); l := LVS[v]
		if rref(l.ty as int): return if l.fl & LV_PARAM != 0 && l.cfn == PI as i32 { Pv{0, v as i32, (1 as i64) << (min(pidx(v), 30) + 31)} } else { pnone() }
		if isrs(l.ty as int) || hold(l.ty as int): return pbind(v)
		return pnone()
	if k == N_STR || k == N_NULL: return if k == N_STR { Pv{-2, -1, 0} } else { pnone() }
	if k == N_UN && ND[n].op as int == T_AND: return pl(ND[n].a as int)
	if k == N_AS: return pv(ND[n].a as int)
	if k == N_SLICE: bt := at(ND[n].a as int); if isrs(bt) { return pv(ND[n].a as int) } return pl(ND[n].a as int)
	if k == N_DOT || k == N_IDX: bt := at(ND[n].a as int); if isrs(bt) || isrs(t) || hold(t) { return pv(ND[n].a as int) } return pnone()
	if k == N_IF: return pmerge(pvb(ND[n].b as int), pvb(ND[n].c as int))
	if k == N_BLOCK: return pvb(n)
	if k == N_EBLOCK: return pvb(ND[n].a as int)
	if k == N_MATCH: r ~= pnone(); for j ND[n].n { r = pmerge(r, pvb(ND[kid(n, j)].b as int)) } return r
	if k == N_CALL: return if rk(n) == R_FN && rref(FI_[rv(n)].ret as int) { pnone() } else { pvcall(n) }
	if k == N_ARR || k == N_SLIT: r ~= pnone(); for j ND[n].n { c := kid(n, j); r = pmerge(r, pva(if ND[c].k as int == N_FI { ND[c].a as int } else { c })) } return r
	pnone()
pva(n int) Pv: if n < 0 { return pnone() } t := at(n); if isrs(t) || hold(t) { pv(n) } else { pnone() }
pvb(b int) Pv:
	if b < 0: return pnone()
	if ND[b].k as int == N_BLOCK: return if ND[b].a >= 0 && !pdiv(ND[b].a as int) { pv(ND[b].a as int) } else { pnone() }
	pv(b)
pvcall(n int) Pv:
	if rk(n) != R_FN: return pnone()
	ci := rv(n); m := if ci < PRM.len { PRM[ci] } else { (-1) as i64 }
	r ~= pnone(); fq := FI_[ci].node as int; nk := ND[n].n as int
	for j nk:
		b := min(j, 30); if ((m >> b) & 1) == 0 && ((m >> (b + 31)) & 1) == 0 { continue }
		a := kid(n, j); pt := if j < ND[fq].n as int { ptype_of(ci, j) } else { -1 }
		if (m >> b) & 1 != 0: r = pmerge(r, pvin(pt, a))
		if (m >> (b + 31)) & 1 != 0: r = pmerge(r, pva(a))
	r
pdst(n int) Pv:
	k := ND[n].k as int
	if k == N_ID:
		r := rk(n); if r == R_GLOBAL { return Pv{-2, -1, 0} } if r != R_LOCAL { return pnone() }
		v := rv(n); l := LVS[v]; if l.fl & LV_PARAM != 0 && !isrs(l.ty as int) { return Pv{2, v as i32, 0} } if l.fl & LV_PARAM != 0 { return Pv{0, v as i32, 0} }
		return Pv{pdep(v) as i32, v as i32, 0}
	if k == N_DOT || k == N_IDX: bt := at(ND[n].a as int); if isrs(bt) { return pv(ND[n].a as int) } return pdst(ND[n].a as int)
	pnone()
prel(a int) bool:
	if ND[a].k as int != N_DOT || rk(a) != R_FIELD: return false
	bt := pdr(at(ND[a].a as int)); if bt < 0 || TY[bt].k as int != TY_STRUCT { return false } r := SFI[STI[TY[bt].a].f0 as int + rv(a)].ty as int
	TY[r].k as int == TY_REF && TY[r].c >= 0 || has_rel(r)
pwhat(t int, m byte[>..]&, blk bool): m.append(if !isrs(t) { if blk { "holds references" } else { "a value holding references" } } else if TY[t].k as int == TY_SLICE { if blk { "is a slice" } else { "a slice" } } else { if blk { "is a reference" } else { "a reference" } })
pbchk(e int, v int, t int, p Pv):
	if !PCH || p.d <= (2 * PVK) as i32 || p.d < 1: return
	m byte[>..] ~= []; m.append("binding "); m.append(nm(LVS[v].name)); m.append(" to "); pwhat(t, m, false)
	if p.v < 0 { m.append(" rooted at a temporary, which does not outlive it (§9.2): a temporary lasts until the end of its statement, so bind it to a variable of its own first") } else { m.append(" rooted at "); pname(p, m); m.append(", which does not outlive it (§9.2)") } cerr(e, m[..])
pblkchk(e int, t int):
	if !PCH || t < 0: return
	t0 := at(e); if !isrs(t) || TY[t].k as int != TY_REF { if t0 < 0 || !isrs(t0) && !hold(t0) { return } t = t0 }
	p := pvin(t, e); dd := 2 * (PVK - 1) + (if p.v < 0 { 1 } else { 0 }); if p.d <= dd as i32 || p.d < 1 { return }
	m byte[>..] ~= []; m.append("the block's value "); pwhat(t, m, true)
	if p.v < 0:
		m.append(" rooted at a temporary, which does not outlive it (§9.2): a temporary lasts until the end of its statement, or of the block whose final expression made it; make the value in a variable before the statement")
		if TY[t].k as int == TY_SLICE: m.append(", or, where every branch makes a new array of one type, slice the whole construct: `(if c { a } else { b })[..]`"); if TY[t].a as int == T_U8 { m.append("; for byte-string branches (including mixed literals and builders), declare an explicitly owned result: `let text: u8[>..] = if c { a } else { b };`") }
	else: m.append(" rooted at "); pname(p, m); m.append(", which does not outlive it (§9.2)")
	cerr(e, m[..])
pname(p Pv, m byte[>..]&): if p.v < 0 { m.append("<temporary>") } else { m.append(nm(LVS[p.v].name)) }
pstore(n int, src Pv, dst Pv):
	if !PCH || src.d < -1 || src.d == 0 || dst.d < -2: return
	if src.d > dst.d && !(dst.d == 0 && src.d == 0): m byte[>..] ~= []; m.append("storing a reference rooted at "); pname(src, m); m.append(", which does not outlive the destination (§9.2)"); cerr(n, m[..])
pret(n int, e int):
	if e < 0: return
	t := at(e); rt := FI_[PI].ret as int; if !isrs(rt) && !hold(rt): return
	p := pvin(rt, e)
	PRM[PI] = PRM[PI] | p.m
	if !PCH || p.d < 1: return
	m byte[>..] ~= []; if p.v < 0 { m.append("returning a reference into a temporary") } else { m.append("returning a reference rooted in "); pname(p, m); m.append(", which dies with this function (§9.2)") } cerr(e, m[..])
recursive pvstmt(n int):
	if n < 0: return
	k := ND[n].k as int
	if k == N_VDECL:
		if ND[n].b >= 0: for j ND[ND[n].b].n { pvexpr(kid(ND[n].b as int, j)) }
		if ND[n].n != 1 || rk(n) != R_LOCAL: return
		v := rv(n); pgrow(v); PDEP[v] = (2 * PVK) as i32; if ND[n].b < 0 { pbset(v, pnone(), false, n); return } i0 := kid(ND[n].b as int, 0); if ND[i0].k as int == N_DOT && rk(i0) == R_MEMBER && rv(i0) == 1 { ma := pid(ND[i0].a as int); if ma != -1 && pcnt(ma) == 0 { pcnt(v); PTL.push(v as i32); PMK[v] = ma as i32 } } dt := LVS[v].ty as int; if !rref(dt) && !isrs(dt) && !hold(dt) { return }
		e := kid(ND[n].b as int, 0); p := pvin(dt, e); if ND[n].a >= 0 { pstore(e, p, Pv{(2 * PVK) as i32, v as i32, 0}) } else { pbchk(e, v, dt, p) } pbset(v, p, false, e)
		return
	if k == N_ASSIGN:
		pvexpr(ND[n].a as int); pvexpr(ND[n].b as int)
		a := ND[n].a as int; b := ND[n].b as int; o := ND[n].op as int; if a >= 0 && o == T_ASSIGN && ND[a].k as int == N_ID { pshrink(n, a, -1) }
		if a < 0 || b < 0 || o != T_ASSIGN && o != T_DOTASSIGN || prel(a) { return } t := at(a); if t < 0 { return }
		rb := o == T_DOTASSIGN && TY[t].k == TY_REF && TY[t].c < 0 || o == T_ASSIGN && TY[t].k == TY_SLICE
		if rb:
			p := if TY[t].k as int == TY_REF || !isrs(at(b)) { pl(b) } else { pv(b) }
			if ND[a].k as int == N_ID && rk(a) == R_LOCAL: v := rv(a); pstore(b, p, Pv{pdep(v) as i32, v as i32, 0}); pbset(v, p, true, b); return
			pstore(b, p, pdst(a)); return
		vt := if TY[t].k == TY_REF && TY[t].c < 0 { TY[t].a as int } else { t }
		if !isrs(vt) && !hold(vt): return
		pstore(b, pvin(vt, b), if vt != t { pv(a) } else { pdst(a) })
		return
	if k == N_RET:
		for j ND[n].n { pvexpr(kid(n, j)) } if ND[n].n == 1 && ND[n].s < 0 { pret(n, kid(n, 0)) }
		return
	pvexpr(n)
recursive pblk(b int, ret bool):
	if b < 0: return
	PVK++; PBS.push(b as i32); PBJ.push(0); for j ND[b].n { PBJ[PBJ.len - 1] = j as i32; pvstmt(kid(b, j)) } PBJ[PBJ.len - 1] = ND[b].n; if ret && ND[b].a >= 0 && ND[ND[b].a].k as int == N_BLOCK { pblk(ND[b].a as int, true) } else if ND[b].a >= 0 { pvexpr(ND[b].a as int); if !pdiv(ND[b].a as int) { if ret { pret(b, ND[b].a as int) } else { pblkchk(ND[b].a as int, at(b)) } } } PBS.pop(); PBJ.pop(); PVK--
recursive pvexpr(n int):
	if n < 0: return
	k := ND[n].k as int
	if k == N_BLOCK: pblk(n, false); return
	if k == N_EBLOCK: PBK.push(n as i32); pblk(ND[n].a as int, false); PBK.pop(); return
	if k == N_LOOP: PLP.push(n as i32); PBK.push(n as i32); pblk(ND[n].a as int, false); PLP.pop(); PBK.pop(); return
	if k == N_IF: pvexpr(ND[n].a as int); pvexpr(ND[n].b as int); pvexpr(ND[n].c as int); return
	if k == N_WHILE: pvexpr(ND[n].a as int); PLP.push(n as i32); PBK.push(n as i32); pblk(ND[n].b as int, false); PLP.pop(); PBK.pop(); return
	if k == N_FOR:
		pvexpr(ND[n].a as int); pvexpr(ND[n].b as int)
		if rk(n) == R_LOCAL && ND[n].a >= 0: v := rv(n); it := ND[n].a as int; et := if LVS[v].fl & LV_REF != 0 { pdr(LVS[v].ty as int) } else { LVS[v].ty as int }; p := if isrs(at(it)) || isrs(et) || hold(et) { pv(it) } else { pl(it) }; pbset(v, p, false, n)
		PLP.push(n as i32); PBK.push(n as i32); pblk(ND[n].d as int, false); PLP.pop(); PBK.pop(); return
	if k == N_MATCH: pvexpr(ND[n].a as int); for j ND[n].n { pvexpr(ND[kid(n, j)].b as int) } return
	if k == N_ASSIGN || k == N_VDECL || k == N_RET: pvstmt(n); return
	if k == N_CALL:
		for j ND[n].n { pvexpr(kid(n, j)) }
		c := ND[n].a as int; b := rv(n)
		if rk(n) == R_BUILTIN && c >= 0 && ND[c].k as int == N_DOT && (b == B_CLEAR || b == B_POP || b == B_POPN || b == B_RESIZE): pshrink(n, ND[c].a as int, b)
		if rk(n) == R_BUILTIN && c >= 0 && ND[c].k as int == N_DOT && (b == B_PUSH || b == B_APPEND): a := pid(ND[c].a as int); if a != -1 && pcnt(a) >= 0 { pcset(a, pcnt(a) + 1) }
		if rk(n) == R_FN: pcallshr(n)
		if rk(n) != R_BUILTIN || b != B_PUSH && b != B_APPEND || c < 0 || ND[c].k as int != N_DOT || ND[n].n < 1 { return }
		o := ND[c].a as int; et := TY[pdr(at(o))].a as int; if et < 0 || !isrs(et) && !hold(et) { return } e := kid(n, 0)
		s0 := pstrip(e); p := if b == B_PUSH { pvin(et, e) } else if TY[pdr(at(s0))].k as int == TY_SLICE && (rref(et) || hold(et)) { pnone() } else { pva(s0) }
		if ND[o].k as int == N_ID && rk(o) == R_LOCAL && !isrs(LVS[rv(o)].ty as int): v := rv(o); pstore(e, p, Pv{pdep(v) as i32, v as i32, 0}); pbset(v, p, true, e); return
		pstore(e, p, pdst(o))
pel(b int, p int) int: if p < ND[b].n as int { kid(b, p) } else if p == ND[b].n as int { ND[b].a as int } else { -1 }
ptend(t0 int) int:
	d ~= 0; t ~= t0; k0 := TK[t0].k as int; bl := k0 == T_LC || k0 == T_LP || k0 == T_LB
	while t < TK.len:
		k := TK[t].k as int
		if k == T_LP || k == T_LB || k == T_LC: d += 1
		else if k == T_RP || k == T_RB || k == T_RC: { if d == 0 { return t } d -= 1; if d == 0 && bl { return t } }
		else if k == T_SEMI && d == 0 && !bl: return t
		t += 1
	t
pvbody(l int) int: k := ND[l].k as int; if k == N_WHILE { ND[l].b as int } else if k == N_FOR { ND[l].d as int } else { ND[l].a as int }
pcut() int, int, bool:
	i ~= PBS.len - 1
	while i >= 0:
		b := PBS[i] as int
		for p in (PBJ[i] as int + 1)..(ND[b].n as int + 1):
			e := pel(b, p); if e < 0 { continue } k := ND[e].k as int; ce := ptend(ND[e].t as int)
			if k == N_RET: return ce, 1 << 40, false
			if k == N_BREAK || k == N_CONT: bt := if PBK.len > 0 { PBK[PBK.len - 1] as int } else { -1 }; return ce, if bt >= 0 { ptend(ND[pvbody(bt)].t as int) } else { 1 << 40 }, k == N_CONT
		i -= 1
	return 1 << 40, 1 << 40, true
pid(o int) int:
	if ND[o].k as int == N_UN && ND[o].op as int == T_AND: return pid(ND[o].a as int)
	if ND[o].k as int != N_ID: return -1
	r := rk(o); t := if r == R_LOCAL { LVS[rv(o)].ty as int } else if r == R_GLOBAL { global_type(rv(o)) } else { -1 }; t = pdr(t)
	if t <= 0 || TY[t].k as int != TY_ARR || TY[t].s as int != A_GROW && TY[t].s as int != A_GS: return -1
	if r == R_LOCAL { rv(o) } else { -3 - rv(o) }
pidn(a int, m byte[>..]&): m.append(if a >= 0 { nm(LVS[a].name) } else { nm(DC[-3 - a].name) })
pcnt(a int) int: if a >= 0 { while PCL.len <= a { PCL.push(0); PMK.push(-9) } PCL[a] as int } else { while PCG.len <= -3 - a { PCG.push(0) } PCG[-3 - a] as int }
pcset0(a int): if a >= 0 { PCL[a] = 0; PMK[a] = -9 } else { PCG[-3 - a] = 0 }
pcset(a int, c int): pcnt(a); PTL.push(a as i32); if a >= 0 { PCL[a] = c as i32 } else { PCG[-3 - a] = c as i32 }
ppar(a int) bool: a >= 0 && LVS[a].fl & LV_PARAM != 0 && LVS[a].cfn == PI as i32
ptgt(a int) int: if a < -1 { a } else if ppar(a) { pidx(a) } else { -1 }
padp(tg int, p int, nmi int): q := PPR[PI]; for x in 0..(q.len / 3) { if q[3 * x] == tg as i32 && q[3 * x + 1] == p as i32 { return } } PPR[PI].push(tg as i32); PPR[PI].push(p as i32); PPR[PI].push(nmi as i32)
plive(st int, v int, lp int, cut int, rs int) bool:
	fq := FI_[PI].node as int; j ~= fq + 1; e := NEND[fq] as int; dt := ND[LVS[v].node].t as int
	while j < e:
