	else: w := if PBN[bv] >= 0 { TK[ND[PBN[bv]].t] } else { TK[ND[n].t] }; m.append(if vi == 1 { "a reference to a slice that may point into it" } else if vi == 2 { "a reference to what may hold a reference or slice into it" } else { "a reference into it" }); m.append(" was stored there at "); m.append(nm(FILES[w.f].name)); format(m, ":", w.line, " (§5.1)")
	cerr(n, m[..])
pshrink(n int, o int, b int):
