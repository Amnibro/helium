recursive pexs(e int, m byte[>..]&) bool:
	k := ND[e].k as int
	if k == N_ID: m.append(nm(ND[e].s)); return true
	if k == N_DOT && rk(e) == R_FIELD: if !pexs(ND[e].a as int, m) { return false } m.push('.'); m.append(nm(ND[e].s)); return true
