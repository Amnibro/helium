			dt := ND[l.node].t as int; b := if v < PLB.len { PLB[v] as int } else { -1 }
			if l.fl & (LV_PARAM | LV_BLKP) != 0 || dt < t && b >= 0 && t <= ptend(ND[b].t as int): m.append("array size "); m.append(nm(ND[e].s)); m.append(" names a local variable, not a constant"); return e
