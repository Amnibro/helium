use calls
struct Pv { d i32, v i32, m i64 }
var PDEP i32[>..]
var PBD i32[>..]
var PBV i32[>..]
var PBM i64[>..]
var PRM i64[>..]
var SHR i64[>..]
var PSG i64[>..]
var CGE i32[>..]
var PFT (i32[>..])[>..]
var CYR (u64[>..])[>..]
var CTH i64[>..]
var SHG (i32[>..])[>..]
var PPR (i32[>..])[>..]
var PCL i32[>..]
var PCG i32[>..]
var PMK i32[>..]
var PTL i32[>..]
var PVRS (i32[>..])[>..]
var PBN i32[>..]
var PBS i32[>..]
var PBJ i32[>..]
var PLP i32[>..]
var PBK i32[>..]
var PLB i32[>..]
PVK ~= 1
PCH ~= false
PI ~= -1
pnone() Pv: Pv{-9, -1, 0}
ptemp() Pv: Pv{(2 * PVK + 1) as i32, -1, 0}
pmerge(a Pv, b Pv) Pv: Pv{if a.d >= b.d { a.d } else { b.d }, if a.d >= b.d { a.v } else { b.v }, a.m | b.m}
recursive hold(t int) bool:
	if t < 0: return false
	x := TY[t]; k := x.k as int
	if isrs(t): return true
	if k == TY_STRUCT: si := x.a as int; for j STI[si].fnum { if hold(SFI[STI[si].f0 as int + j].ty as int) { return true } } return false
	if k == TY_ARR: return hold(x.a as int)
	false
isrs(t int) bool: t >= 0 && (TY[t].k == TY_SLICE || TY[t].k == TY_REF && TY[t].c < 0 && TY[t].fl & RF_OPT == 0)
pgrow(v int): while PDEP.len <= v { PDEP.push(-1); PBD.push(-9); PBV.push(-1); PBM.push(0); PVRS.push([]); PBN.push(-1) }
pbset(v int, p Pv, mg bool, nd int):
	pgrow(v); q := if mg { pmerge(Pv{PBD[v], PBV[v], PBM[v]}, p) } else { p }; PBD[v] = q.d; PBV[v] = q.v; PBM[v] = q.m
	if !mg: PVRS[v].clear()
	if p.v != -1 && !PVRS[v].contains(p.v): PVRS[v].push(p.v); PBN[v] = nd as i32
pdep(v int) int: pgrow(v); if LVS[v].cfn != PI as i32 { 0 } else if PDEP[v] < 0 { 2 } else { PDEP[v] as int }
pown(v int) bool: if LVS[v].fl & LV_BLKP != 0 { pidx(v) != 62 } else { LVS[v].cfn == PI as i32 }
pbind(v int) Pv:
	pgrow(v); l := LVS[v]
	if l.fl & (LV_PARAM | LV_BLKP) != 0 || l.cfn != PI as i32: Pv{0, v as i32, if !pown(v) { 0 } else { (1 as i64) << min(pidx(v), 30) }}
	else: Pv{PBD[v], PBV[v], PBM[v]}
pidx(v int) int: nd := FI_[PI].node as int; for j ND[nd].n { if rv(kid(nd, j)) == v { return j } } if ND[nd].k as int == N_FUNVAL && rk(nd) == R_LOCAL && rv(nd) == v { 0 } else { 62 }
recursive pl(n int) Pv:
	k := ND[n].k as int; if at(n) < 0 && rk(n) == R_NONE { return pnone() }
	if k == N_ID:
		r := rk(n); if r == R_GLOBAL { return if TY[global_type(rv(n))].k as int == TY_REF { pnone() } else { Pv{-2, (-3 - rv(n)) as i32, 0} } } if r == R_CONST { return Pv{-2, -1, 0} } if r != R_LOCAL { return ptemp() }
		v := rv(n); l := LVS[v]
		if rref(l.ty as int) || l.fl & LV_FOR != 0: return pbind(v)
		if l.fl & (LV_PARAM | LV_BLKP) != 0: return Pv{2, v as i32, 0}
		return Pv{pdep(v) as i32, v as i32, 0}
	if k == N_DOT || k == N_IDX || k == N_SLICE:
		rw := fraw(n); if rw >= 0 && (TY[rw].k as int == TY_REF && TY[rw].c >= 0 || has_rel(rw)) { return pnone() }
		bt := at(ND[n].a as int); if rw >= 0 && rref(rw) && !isrs(bt) { q := pv(ND[n].a as int); return if q.v >= 0 && !pcanh(LVS[q.v].ty as int, pdr(rw)) { pnone() } else { q } } if isrs(bt) || rw >= 0 && rref(rw) { return pv(ND[n].a as int) } return pl(ND[n].a as int)
	if k == N_AS || k == N_UN && ND[n].op as int == T_AND: return pl(ND[n].a as int)
	if k == N_STR: return Pv{-2, -1, 0}
	if k == N_NULL: return pnone()
	if k == N_CALL: ct := if rk(n) == R_FN { FI_[rv(n)].ret as int } else { at(n) }; return if ct >= 0 && TY[ct].k as int == TY_REF { if rk(n) == R_FN { pvcall(n) } else { pnone() } } else { ptemp() }
	if k == N_IF: return pmerge(plb(ND[n].b as int), plb(ND[n].c as int))
	if k == N_BLOCK: return plb(n)
	if k == N_EBLOCK: return plb(ND[n].a as int)
	if k == N_MATCH: r ~= pnone(); for j ND[n].n { r = pmerge(r, plb(ND[kid(n, j)].b as int)) } return r
	ptemp()
pdr(t int) int: if t < 0 { 0 } else { deref(t) }
rref(t int) bool: t >= 0 && TY[t].k as int == TY_REF && TY[t].c < 0
fraw(n int) int:
	k := ND[n].k as int; bt := pdr(at(ND[n].a as int)); if bt < 0 { return -1 }
	if k == N_DOT && rk(n) == R_FIELD && TY[bt].k as int == TY_STRUCT { SFI[STI[TY[bt].a].f0 as int + rv(n)].ty as int } else if k == N_IDX && (TY[bt].k as int == TY_ARR || TY[bt].k as int == TY_SLICE) { TY[bt].a as int } else { -1 }
recursive pvin(t int, e int) Pv:
	if t < 0 || e < 0: return pva(e)
	k := TY[t].k as int
	if rref(t) || k == TY_SLICE && !isrs(at(e)): return pl(e)
	if k == TY_ARR && ND[e].k as int == N_ARR: r ~= pnone(); for j ND[e].n { r = pmerge(r, pvin(TY[t].a as int, kid(e, j))) } return r
	pva(e)
recursive pstrip(e int) int: if ND[e].k as int == N_SLICE { pstrip(ND[e].a as int) } else { e }
pdiv(e int) bool: k := ND[e].k as int; t := at(e); k == N_RET || k == N_BREAK || k == N_CONT || t < 0 || TY[t].k as int == TY_VOID
plb(b int) Pv:
	if b < 0: return pnone()
	if ND[b].k as int == N_BLOCK: return if ND[b].a >= 0 && !pdiv(ND[b].a as int) { pl(ND[b].a as int) } else { pnone() }
	pl(b)
recursive pv(n int) Pv:
	if n < 0: return pnone()
	k := ND[n].k as int; t := at(n)
	if k == N_ID:
		r := rk(n); if r == R_GLOBAL { return Pv{-2, -1, 0} } if r != R_LOCAL { return pnone() }
		v := rv(n); l := LVS[v]
		if rref(l.ty as int): return if l.fl & (LV_PARAM | LV_BLKP) != 0 && l.cfn == PI as i32 { Pv{0, v as i32, (1 as i64) << (min(pidx(v), 30) + 31)} } else { pnone() }
		if isrs(l.ty as int) || hold(l.ty as int): return pbind(v)
		return pnone()
	if k == N_STR || k == N_NULL: return if k == N_STR { Pv{-2, -1, 0} } else { pnone() }
	if k == N_UN && ND[n].op as int == T_AND: return pl(ND[n].a as int)
	if k == N_AS: return pv(ND[n].a as int)
	if k == N_SLICE: bt := at(ND[n].a as int); if isrs(bt) { return pv(ND[n].a as int) } return pl(ND[n].a as int)
	if k == N_DOT || k == N_IDX: bt := at(ND[n].a as int); if isrs(bt) || isrs(t) || hold(t) { return pv(ND[n].a as int) } return pnone()
	if k == N_IF: return pmerge(pvbt(ND[n].b as int, t), pvbt(ND[n].c as int, t))
	if k == N_BLOCK: return pvbt(n, t)
	if k == N_EBLOCK: return pvbt(ND[n].a as int, t)
	if k == N_MATCH: r ~= pnone(); for j ND[n].n { r = pmerge(r, pvbt(ND[kid(n, j)].b as int, t)) } return r
	if k == N_CALL: return if rk(n) == R_FN && rref(FI_[rv(n)].ret as int) { pnone() } else { pvcall(n) }
	if k == N_SLIT && t > 0 && TY[t].k as int == TY_STRUCT: si := TY[t].a as int; r ~= pnone(); for j ND[n].n { c := kid(n, j); fi := if ND[c].k as int == N_FI { sfield(si, ND[c].s as int) } else { j }; ft := if fi >= 0 && fi < STI[si].fnum as int { SFI[STI[si].f0 as int + fi].ty as int } else { -1 }; r = pmerge(r, pvin(ft, if ND[c].k as int == N_FI { ND[c].a as int } else { c })) } return r
	if k == N_ARR || k == N_SLIT: r ~= pnone(); for j ND[n].n { c := kid(n, j); r = pmerge(r, pva(if ND[c].k as int == N_FI { ND[c].a as int } else { c })) } return r
	pnone()
pva(n int) Pv: if n < 0 { return pnone() } t := at(n); if isrs(t) || hold(t) { pv(n) } else { pnone() }
recursive pvbt(b int, t int) Pv:
	if b < 0: return pnone()
	if ND[b].k as int == N_BLOCK: return if ND[b].a >= 0 && !pdiv(ND[b].a as int) { pvin(t, ND[b].a as int) } else { pnone() }
	pvin(t, b)
pvb(b int) Pv:
	if b < 0: return pnone()
	if ND[b].k as int == N_BLOCK: return if ND[b].a >= 0 && !pdiv(ND[b].a as int) { pv(ND[b].a as int) } else { pnone() }
	pv(b)
pvcall(n int) Pv:
	if rk(n) != R_FN && rk(n) != R_BLOCK || rv(n) < 0: return pnone()
	ci := rv(n); m := if ci < PRM.len { PRM[ci] } else { (-1) as i64 }
	r ~= pnone(); fq := FI_[ci].node as int; nk := ND[n].n as int
	for j nk:
		b := min(j, 30); if ((m >> b) & 1) == 0 && ((m >> (b + 31)) & 1) == 0 { continue }
		a := kid(n, j); pt := if j < ND[fq].n as int { ptype_of(ci, j) } else { -1 }
		if (m >> b) & 1 != 0: r = pmerge(r, pvin(pt, a))
		if (m >> (b + 31)) & 1 != 0: r = pmerge(r, pva(a))
	r
pdst(n int) Pv:
	k := ND[n].k as int
	if k == N_ID:
		r := rk(n); if r == R_GLOBAL { return Pv{-2, (-3 - rv(n)) as i32, 0} } if r != R_LOCAL { return pnone() }
		v := rv(n); l := LVS[v]; if l.fl & (LV_PARAM | LV_BLKP) != 0 && !isrs(l.ty as int) { return Pv{2, v as i32, 0} } if l.fl & (LV_PARAM | LV_BLKP) != 0 { return Pv{0, v as i32, 0} }
		return Pv{pdep(v) as i32, v as i32, 0}
	if k == N_DOT || k == N_IDX: bt := at(ND[n].a as int); if isrs(bt) { return pv(ND[n].a as int) } return pdst(ND[n].a as int)
	pnone()
prel(a int) bool:
	if ND[a].k as int != N_DOT || rk(a) != R_FIELD: return false
	bt := pdr(at(ND[a].a as int)); if bt < 0 || TY[bt].k as int != TY_STRUCT { return false } r := SFI[STI[TY[bt].a].f0 as int + rv(a)].ty as int
	TY[r].k as int == TY_REF && TY[r].c >= 0 || has_rel(r)
pwhat(t int, m byte[>..]&, blk bool): m.append(if !isrs(t) { if blk { "holds references" } else { "a value holding references" } } else if TY[t].k as int == TY_SLICE { if blk { "is a slice" } else { "a slice" } } else { if blk { "is a reference" } else { "a reference" } })
pbchk(e int, v int, t int, p Pv):
	if !PCH || p.d <= (2 * PVK) as i32 || p.d < 1: return
	m byte[>..] ~= []; m.append("binding "); m.append(nm(LVS[v].name)); m.append(" to "); pwhat(t, m, false)
	if p.v < 0 { m.append(" rooted at a temporary, which does not outlive it (§9.2): a temporary lasts until the end of its statement, so bind it to a variable of its own first") } else { m.append(" rooted at "); pname(p, m); m.append(", which does not outlive it (§9.2)") } cerr(e, m[..])
pblkchk(e int, t int):
	if !PCH || t < 0: return
	t0 := at(e); if !isrs(t) || TY[t].k as int != TY_REF { if t0 < 0 || !isrs(t0) && !hold(t0) { return } t = t0 }
	p := pvin(t, e); dd := 2 * (PVK - 1) + (if p.v < 0 { 1 } else { 0 }); if p.d <= dd as i32 || p.d < 1 { return }
	m byte[>..] ~= []; m.append("the block's value "); pwhat(t, m, true)
	if p.v < 0:
		m.append(" rooted at a temporary, which does not outlive it (§9.2): a temporary lasts until the end of its statement, or of the block whose final expression made it; make the value in a variable before the statement")
		if TY[t].k as int == TY_SLICE: m.append(", or, where every branch makes a new array of one type, slice the whole construct: `(if c { a } else { b })[..]`"); if TY[t].a as int == T_U8 { m.append("; for byte-string branches (including mixed literals and builders), declare an explicitly owned result: `let text: u8[>..] = if c { a } else { b };`") }
	else: m.append(" rooted at "); pname(p, m); m.append(", which does not outlive it (§9.2)")
	cerr(e, m[..])
pname(p Pv, m byte[>..]&): if p.v < 0 { m.append("<temporary>") } else { m.append(nm(LVS[p.v].name)) }
pgsid(v int) bool: t := if v >= 0 { LVS[v].ty as int } else if v <= -3 { global_type(-3 - v) } else { -1 }; t = pdr(t); t > 0 && TY[t].k as int == TY_ARR && TY[t].s as int == A_GS
pnst(n int, p Pv, t int):
	c := if isrs(t) || rref(t) { t } else { pcomp(t) }
	if !PCH || !pgsid(p.v as int) || p.v >= 0 && LVS[p.v].fl & (LV_PARAM | LV_BLKP) != 0 || c >= 0 && rref(c) && TY[pdr(c)].k as int == TY_ARR: return
	m byte[>..] ~= []; m.append("storing a reference into "); pidn(p.v as int, m); m.append(", which holds a grow-shrink array: such a reference lives in a variable, is passed down or returned, and is never stored (§5.2)"); cerr(n, m[..])
prel1(ft int, val int, dst Pv, rt bool):
	if !PCH || ft < 0 || TY[ft].k as int != TY_REF || TY[ft].c < 0 || val < 0 || ND[val].k as int == N_NULL || ND[val].k as int == N_SELF: return
	q := pl(val); if q.v == -1 && !(rt && q.d >= 1) || q.d == 0 || q.v >= 0 && LVS[q.v].fl & (LV_PARAM | LV_BLKP) != 0 { return } pd := TY[ft].b as int; m byte[>..] ~= []
	if pd >= 0: { if q.v != (-3 - pd) as i32 { m.append("a relative reference in "); m.append(nm(DC[pd].name)); m.append(" must point into "); m.append(nm(DC[pd].name)); m.append(" (§3.9)") } }
	else if rt && q.d >= 1 || !rt && dst.v != -1 && q.v != dst.v: m.append("a relative reference must point within the same root as its location (§3.9)")
	if m.len > 0: cerr(val, m[..])
recursive prels(e int, dst Pv, rt bool):
	if e < 0: return
	k := ND[e].k as int; t := at(e)
	if k == N_SLIT && t > 0 && TY[t].k as int == TY_STRUCT: si := TY[t].a as int; for j ND[e].n { c := kid(e, j); fi := if ND[c].k as int == N_FI { sfield(si, ND[c].s as int) } else { j }; ft := if fi >= 0 && fi < STI[si].fnum as int { SFI[STI[si].f0 as int + fi].ty as int } else { -1 }; vv := if ND[c].k as int == N_FI { ND[c].a as int } else { c }; prel1(ft, vv, dst, rt); pcopy(vv, decode_rel(ft)); prc(vv, ft, -1); prels(vv, dst, rt) }
	if k == N_ARR: for j ND[e].n { if t > 0 && TY[t].k as int == TY_ARR { prc(kid(e, j), TY[t].a as int, -1) } prels(kid(e, j), dst, rt) }
pcyc(a int, b int) bool: a < CYR.len && b < CYR.len && CYR[a].len > 0 && CYR[b].len > 0 && (CYR[a][b >> 6] >> (b & 63)) & 1 != 0 && (CYR[b][a >> 6] >> (a & 63)) & 1 != 0
pcycles():
	n := FI_.len; w := (n + 63) >> 6; CYR.clear(); for _ n { CYR.push([]) } CTH.clear(); CTH.resize(n, -1)
	ad (i32[>..])[>..] ~= []; for _ n { ad.push([]) } e ~= 0
	while e < CGE.len: ad[CGE[e]].push(CGE[e + 1]); e += 3 + CGE[e + 2] as int
	for i n:
		if ad[i].len == 0: continue
		r u64[>..] ~= []; r.resize(w, 0); st i32[>..] ~= []; for x ad[i] { st.push(x) }
		while st.len > 0: x := st.pop() as int; if (r[x >> 6] >> (x & 63)) & 1 != 0 { continue } r[x >> 6] = r[x >> 6] | (1 as u64) << (x & 63); for y ad[x] { st.push(y) }
		CYR[i] = r
	for _ 7:
		ch ~= false; e = 0
		while e < CGE.len:
			c := CGE[e] as int; i := CGE[e + 1] as int; na := CGE[e + 2] as int
			if pcyc(c, i): for j in 0..na { pa := CGE[e + 3 + j] as int; if j < 62 && (CTH[i] >> j) & 1 != 0 && (pa < 0 || (CTH[c] >> min(pa, 62)) & 1 == 0) { CTH[i] = CTH[i] & ~((1 as i64) << j); ch = true } }
			e += 3 + na
		if !ch: break
recursive pbase(e int) int: k := ND[e].k as int; if k == N_ID { return if rk(e) == R_LOCAL { rv(e) } else { -1 } } if k == N_IDX || k == N_DOT || k == N_SLICE { return pbase(ND[e].a as int) } -1
pheld(a int, p Pv, nd int): k := ND[a].k as int; if k != N_IDX && k != N_DOT || p.v == -1 { return } x := pbase(a); if x >= 0 && LVS[x].cfn == PI as i32 { pbset(x, p, true, nd) }
pstore(n int, src Pv, dst Pv):
	if PCH && dst.v <= -3 && src.v != -1 && src.v != dst.v: GST.push(src.v); GST.push(dst.v); GST.push(n as i32)
	if src.d == 0 && dst.d == -2 && src.m != 0: PSG[PI] = PSG[PI] | src.m
	if PCH && src.d == 0 && (dst.d == 0 || dst.d == -2) && src.v >= 0 && ppar(src.v as int) && pcyc(PI, PI) && (CTH[PI] >> min(pidx(src.v as int), 62)) & 1 == 0: cerr(n, "references may only be passed down, not stored, inside a recursive cycle (§7.8)"); return
	if !PCH || src.d < -1 || src.d == 0 || dst.d < -2: return
	if src.d > dst.d && !(dst.d == 0 && src.d == 0): m byte[>..] ~= []; m.append("storing a reference rooted at "); pname(src, m); m.append(", which does not outlive the destination (§9.2)"); cerr(n, m[..])
pret(n int, e int):
	if e < 0: return
	t := at(e); rt := FI_[PI].ret as int; if !(ND[e].k as int == N_ID && rk(e) == R_LOCAL && !is_fixed(rt) && LVS[rv(e)].cfn == PI as i32) { prc(e, rt, -1) } if !isrs(rt) && !hold(rt): return
	p := pvin(rt, e)
	PRM[PI] = PRM[PI] | p.m
	if !PCH || p.d < 1 || ND[FI_[PI].node].k as int == N_FUNVAL: return
	m byte[>..] ~= []; if p.v < 0 { m.append("returning a reference into a temporary") } else { m.append("returning a reference rooted in "); pname(p, m); m.append(", which dies with this function (§9.2)") } cerr(e, m[..])
recursive pvstmt(n int):
	if n < 0: return
	k := ND[n].k as int
	if k == N_VDECL:
		if ND[n].b >= 0: for j ND[ND[n].b].n { pvexpr(kid(ND[n].b as int, j)) }
		if ND[n].n != 1 || rk(n) != R_LOCAL: return
		if ND[n].b >= 0 && ND[n].n == 1 && rk(n) == R_LOCAL: { i1 := kid(ND[n].b as int, 0); k1 := ND[i1].k as int; dt1 := LVS[rv(n)].ty as int; prc(i1, if ND[n].a < 0 && TY[dt1].k as int == TY_REF && TY[dt1].c < 0 && prcl(i1) && pdeq(n) >= 0 { TY[dt1].a as int } else { dt1 }, n); if ND[n].a >= 0 { pctail(i1, dt1) } else if k1 == N_IF || k1 == N_BLOCK || k1 == N_EBLOCK || k1 == N_MATCH { pctail(i1, dt1) } }
		v := rv(n); pgrow(v); while PLB.len <= v { PLB.push(-1) } PLB[v] = if PBS.len > 0 { PBS[PBS.len - 1] } else { -1 }; PDEP[v] = (2 * PVK) as i32; if ND[n].b < 0 { pbset(v, pnone(), false, n); return } i0 := kid(ND[n].b as int, 0); if ND[i0].k as int == N_DOT && rk(i0) == R_MEMBER && rv(i0) == 1 { ma := pid(ND[i0].a as int); if ma != -1 && pcnt(ma) == 0 { pcnt(v); PTL.push(v as i32); PMK[v] = ma as i32 } } dt := LVS[v].ty as int; if !rref(dt) && !isrs(dt) && !hold(dt) { return }
		e := kid(ND[n].b as int, 0); prels(e, Pv{(2 * PVK) as i32, v as i32, 0}, false); p := pvin(dt, e); if ND[n].a >= 0 { pstore(e, p, Pv{(2 * PVK) as i32, v as i32, 0}) } else { pbchk(e, v, dt, p) } if !isrs(dt) { pnst(e, p, dt) } pbset(v, p, false, e)
		return
	if k == N_ASSIGN:
		pvexpr(ND[n].a as int); pvexpr(ND[n].b as int)
		a := ND[n].a as int; b := ND[n].b as int; o := ND[n].op as int; if a >= 0 && o == T_ASSIGN && ND[a].k as int == N_ID { pshrink(n, a, -1) } if a >= 0 && b >= 0 && o == T_ASSIGN { pcopy(b, at(a)); prc(b, at(a), -1) }
		if a >= 0 && b >= 0 && prel(a) && ND[a].k as int == N_DOT: prel1(fraw(a), b, pdst(ND[a].a as int), false)
		if a >= 0 && b >= 0: prels(b, pdst(a), false)
