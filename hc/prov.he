	if b == B_POP || b == B_POPN: pshr(n, a, if b == B_POP { "pop" } else { "pop_n" }, 0, c <= 0); if c > 0 { pcset(a, if b == B_POP { c - 1 } else { 0 }) } return
	x := if ND[n].n > 0 { kid(n, 0) } else { -1 }; ok := c >= 0 && x >= 0 && ND[x].k as int == N_ID && rk(x) == R_LOCAL && rv(x) < PMK.len && PMK[rv(x)] == a as i32
	pshr(n, a, "resize", 0, !ok); if ok { pcset(a, 0) }
recursive proots(e int, r i32[>..]&):
	k := ND[e].k as int; if k == N_SLICE || k == N_UN && ND[e].op as int == T_AND { proots(ND[e].a as int, r) }
	if k == N_ID && rk(e) == R_LOCAL: v := rv(e); r.push(v as i32); if v < PVRS.len { for x PVRS[v] { r.push(x) } } return
	p := pva(e); if p.v != -1 { r.push(p.v) } q := pl(e); if q.v != -1 { r.push(q.v) }
pcallsg(n int):
	ci := rv(n); if ci >= PSG.len || PSG[ci] == 0: return
	for j ND[n].n:
		if j > 30: break
		a := kid(n, j); pt := if j < FI_[ci].pn as int { ptype_of(ci, j) } else if ci < PFT.len && j < PFT[ci].len { PFT[ci][j] as int } else { -1 }; r ~= pnone()
		if (PSG[ci] >> j) & 1 != 0: r = pmerge(r, pvin(pt, a))
