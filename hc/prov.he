prcl(e int) bool: if ND[e].k as int != N_CALL || rk(e) != R_FN { return false } r := FI_[rv(e)].ret as int; r >= 0 && TY[r].k as int == TY_REF && TY[r].c < 0 && TY[r].fl & RF_OPT == 0
