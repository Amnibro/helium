		if rk(n) == R_BUILTIN && c >= 0 && ND[c].k as int == N_DOT && b == B_PUSH && ND[n].n > 0: pcopy(kid(n, 0), TY[pdr(at(ND[c].a as int))].a as int); prc(kid(n, 0), TY[pdr(at(ND[c].a as int))].a as int, -1)
