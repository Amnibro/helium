		if flt_fma(x, sc, -f) < 0.0: f -= 1.0
		t := flt_fma(x, sc, -(f + 0.5))
		if t > 0.0 || t == 0.0 && f % 2.0 != 0.0: f += 1.0
	else: f = flt_floor(x * sc + 0.5)
	s := f as! int; i := sc as int
	format_uint(out, (s / i) as uint, 10, 0, ' ')
