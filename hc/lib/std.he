heap_pop<A>(xs A&): heap_pop(xs) { a, b => a < b }
heap_pop<A, F>(xs A&): top := elem(xs, 0); sift_hole(xs) { a, b => F(a, b) }; xs.resize(xs.len - 1); return top
sift_hole<T, F>(xs T[:]):
