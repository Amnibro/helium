is_space(c byte) bool: c == ' ' || c == '\t' || c == '\n' || c == '\r'
isdigit(c byte) bool: c >= '0' && c <= '9'
isupper(c byte) bool: c >= 'A' && c <= 'Z'
islower(c byte) bool: c >= 'a' && c <= 'z'
