		format_uint(out, (ip as int) as uint, 10, 0, ' '); if decimals > 0 { out.push('.'); format_uint(out, (g as int) as uint, 10, dz, '0'); for i (decimals - dz) { out.push('0') } } return
	f ~= flt_floor(x * sc)
