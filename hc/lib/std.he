min<T>(a T, b T) T: if b < a { b } else { a }
max<T>(a T, b T) T: if a < b { b } else { a }
clamp<T>(x T, lo T, hi T) T: if x < lo { lo } else if hi < x { hi } else { x }
abs<T>(x T) T: if x < 0 { -x } else { x }
abs(x f32) f32: max(x, -x)
abs(x real) real: max(x, -x)
rem<T>(a T, b T) T: if b < 0 && ~b == 0 { 0 } else { a - (a / b) * b }
div_euclid<T>(a T, b T) T: q T := a / b; if rem(a, b) >= 0 { q } else if b > 0 { q - 1 } else { q + 1 }
sign<T>(x T) T: if x < 0 { -1 } else if 0 < x { 1 } else { 0 }
sign(x f32) f32: if x < 0.0 { -1.0 } else if 0.0 < x { 1.0 } else { 0.0 }
sign(x real) real: if x < 0.0 { -1.0 } else if 0.0 < x { 1.0 } else { 0.0 }
lerp(a f32, b f32, t f32) f32: a + (b - a) * t
lerp(a real, b real, t real) real: a + (b - a) * t
next_pow2(x int) int:
	p ~= 1; while p < x { p *= 2 }
	p
extern popcount(x uint) int = "hr_popcount"; extern clz(x uint) int = "hr_clz"; extern ctz(x uint) int = "hr_ctz"
swap<T>(a T&, b T&): t T := a; a = b; b = t
extern pow(x real, y real) real = "hr_pow"; extern pow(x f32, y f32) f32 = "hr_powf"
pow(b int, e int) int: r ~= 1; x ~= b; k ~= e; while k > 0 { if k & 1 == 1 { r *= x }; x *= x; k >>= 1 }; r
to_int<T>(x T) int: x as int
to_int(s byte[:]) int: v, ok := parse_int(trim(s)); v
to_int(c byte) int: if c >= '0' && c <= '9' { c - '0' } else { c as int }
to_real<T>(x T) real: x as real
to_real(s byte[:]) real: v, ok := parse_flt(trim(s)); v
to_real(s const byte[>..]&) real: to_real(s[..])
to_int(s const byte[>..]&) int: to_int(s[..])
HASH_K uint := 11400714819323198485
hash_mix(x uint) uint: h := x * HASH_K; h ^ (h >> 32)
hash(x i8) uint: hash_mix(x as! uint)
hash(x i16) uint: hash_mix(x as! uint)
hash(x i32) uint: hash_mix(x as! uint)
hash(x int) uint: hash_mix(x as! uint)
hash(x byte) uint: hash_mix(x)
hash(x u16) uint: hash_mix(x)
hash(x u32) uint: hash_mix(x)
hash(x uint) uint: hash_mix(x)
hash(x bool) uint: hash_mix(if x { 1 } else { 2 })
hash(x f32) uint: hash_mix((x * 65536.0) as! uint)
hash(x real) uint: hash_mix((x * 65536.0) as! uint)
hash_le(s byte[:], i int, n int) uint:
	v uint ~= 0; for k n { v |= (s[i + k] as uint) << (8 * k) }
	v
hash_mixw(h uint, w uint) uint: x := (h ^ w) * HASH_K; (x << 29) | (x >> 35)
hash_fin(h0 uint) uint: h := (h0 ^ (h0 >> 32)) * 15485907386658061715; h ^ (h >> 32)
hash(s byte[:]) uint:
	n := s.len
	if n > 24: return hash_lanes(s)
	h ~= (n as! uint) * HASH_K; w uint ~= 0
	if n > 8:
		i ~= 0; while i < n - 8 { h = hash_mixw(h, hash_le(s, i, 8)); i += 8 }
		w = hash_le(s, n - 8, 8)
	else if n >= 4: w = hash_le(s, 0, 4) | hash_le(s, n - 4, 4) << 32
	else if n > 0: w = s[0] | (s[n >> 1] as uint) << 8 | (s[n - 1] as uint) << 16
	hash_fin((h ^ w) * HASH_K)
hash_lanes(s byte[:]) uint:
	n := s.len; h ~= (n as! uint) * HASH_K; g ~= h ^ 0x9E3779B97F4A7C15; i ~= 0
	while i < n - 24: h = hash_mixw(h, hash_le(s, i, 8)); g = hash_mixw(g, hash_le(s, i + 8, 8)); i += 16
	h = h ^ ((g << 31) | (g >> 33))
	while i < n - 8: h = hash_mixw(h, hash_le(s, i, 8)); i += 8
	hash_fin((h ^ hash_le(s, n - 8, 8)) * HASH_K)
hash_combine(seed uint, h uint) uint: seed ^ (h + HASH_K + (seed << 6) + (seed >> 2))
struct rng { s uint }
rand_u64(r rng&) uint:
	r.s = r.s + HASH_K; z ~= r.s
	z = (z ^ (z >> 30)) * 13787848793156543929; z = (z ^ (z >> 27)) * 10723151780598845931
	z ^ (z >> 31)
rand_int(r rng&, n int) int: (rand_u64(r) % n as uint) as int
rand_flt(r rng&) real: (rand_u64(r) >> 11) * (1.0 / 9007199254740992.0)
shuffle<T>(xs T[:], r rng&): i ~= xs.len - 1; while i > 0 { swap_at(xs, i, rand_int(r, i + 1)); i -= 1 }
swap_at<T>(xs T[:], i int, j int): t T := xs[i]; xs[i] .= xs[j]; xs[j] .= t
each_rev<T, F>(xs T[:]): i ~= xs.len; while i > 0 { i -= 1; F(xs[i]) }
each_chunk<T, F>(xs T[:], n int): i ~= 0; k ~= 0; while i < xs.len { e := min(i + n, xs.len); F(xs[i..e], k); i = e; k += 1 }
find<T, F>(xs T[:]) T?:
	for &x xs { if F(x) { return x } }
	null
find_index<T, F>(xs T[:]) int:
	for x, i xs { if F(x) { return i } }
	-1
position<T>(xs T[:], v T) int:
	for x, i xs { if x == v { return i } }
	-1
contains<T>(xs T[:], v T) bool: position(xs, v) >= 0
contains(s byte[:], sub byte[:]) bool: find(s, sub) >= 0
range(n int) int[>..]: o int[>..] ~= []; for i n { o.push(i) }; o
range(a int, b int) int[>..]: o int[>..] ~= []; for i a..b { o.push(i) }; o
inline pyrcount(a int, b int, s int) int: if s > 0 { if b > a { (b - a + s - 1) / s } else { 0 } } else { if a > b { (a - b - s - 1) / (0 - s) } else { 0 } }
range(a int, b int, s int) int[>..]: o int[>..] ~= []; i ~= a; while s > 0 && i < b || s < 0 && i > b { o.push(i); i += s }; o
any(xs bool[:]) bool: for x in xs { if x { return true } }; false
all(xs bool[:]) bool: for x in xs { if !x { return false } }; true
any<T, F>(xs T[:]) bool:
	for x xs { if F(x) { return true } }
	false
all<T, F>(xs T[:]) bool:
	for x xs { if !F(x) { return false } }
	true
count(s byte[:], sub byte[:]) int: n ~= 0; i ~= 0; while sub.len > 0 && i + sub.len <= s.len { if s[i..i + sub.len] == sub { n += 1; i += sub.len } else { i += 1 } }; n
count<T, F>(xs T[:]) int:
	n ~= 0; for x xs { if F(x) { n += 1 } }
	n
min<T>(xs T[:]) T:
	assert(xs.len > 0); m T ~= xs[0]; for x xs { if x < m { m = x } }
	m
min<T, F>(xs T[:]) T:
	assert(xs.len > 0); m T ~= xs[0]; for x xs { if F(x, m) { m = x } }
	m
max<T>(xs T[:]) T:
	assert(xs.len > 0); m T ~= xs[0]; for x xs { if m < x { m = x } }
	m
max<T, F>(xs T[:]) T:
	assert(xs.len > 0); m T ~= xs[0]; for x xs { if F(m, x) { m = x } }
	m
min_by<T, F>(xs T[:]) int:
	if xs.len == 0: return -1
	b ~= 0; bk ~= F(xs[0]); for x, i xs { k := F(x); if k < bk { bk = k; b = i } }
	b
max_by<T, F>(xs T[:]) int:
	if xs.len == 0: return -1
	b ~= 0; bk ~= F(xs[0]); for x, i xs { k := F(x); if bk < k { bk = k; b = i } }
	b
last<T>(xs T[:]) T&: assert(xs.len > 0); xs[xs.len - 1]
lower_bound<T, F>(xs T[:]) int:
	lo ~= 0; hi ~= xs.len; while lo < hi { m := lo + (hi - lo) / 2; if F(xs[m]) { lo = m + 1 } else { hi = m } }
	lo
binary_search<T>(xs T[:], v T) int, bool: lo := lower_bound(xs) { it < v }; return lo, lo < xs.len && xs[lo] == v
find<T>(xs T[:], v T) int: position(xs, v)
index<T>(xs T[:], v T) int: position(xs, v)
index<T>(xs T[:], sub T[:]) int: find(xs, sub)
count<T>(xs T[:], v T) int: n ~= 0; for x in xs { if x == v { n += 1 } }; n
find<T>(xs T[:], sub T[:]) int:
	if sub.len == 0: return 0
	for i xs.len - sub.len + 1 { if xs[i] == sub[0] && xs[i..i + sub.len] == sub { return i } }
	-1
rfind<T>(xs T[:], sub T[:]) int:
	if sub.len == 0: return xs.len
	i ~= xs.len - sub.len; while i >= 0 { if xs[i] == sub[0] && xs[i..i + sub.len] == sub { return i }; i -= 1 }
	-1
starts_with<T>(xs T[:], p T[:]) bool: p.len <= xs.len && xs[..p.len] == p
ends_with<T>(xs T[:], p T[:]) bool: p.len <= xs.len && xs[xs.len - p.len..] == p
struct ByteSet { members bool[256], kind byte, invert bool, bytes byte[3], lo byte[16], hi byte[16] }
byte_set(members bool[256]) ByteSet:
	s ~= ByteSet{members, 5, false, [0; 3], [0; 16], [0; 16]}; n ~= 0
	for b 256:
		if members[b]:
			n += 1; bit := (1 << ((b >> 4) & 7)) as byte
			if b < 128 { s.lo[b & 15] |= bit } else { s.hi[b & 15] |= bit }
	inv := n > 128; k ~= 0; first ~= 0; last ~= 0
	for b 256: if members[b] != inv { if k == 0 { first = b }; if k < 3 { s.bytes[k] = b }; last = b; k += 1 }
	if k <= 3: s.kind = k; s.invert = inv; for j k..3 { s.bytes[j] = s.bytes[0] }
	else if last - first + 1 == k: s.kind = 4; s.invert = inv; s.bytes[0] = first; s.bytes[1] = last - first
	s
byte_set(bytes byte[:]) ByteSet: m bool[256] ~= [false; 256]; for b bytes { m[b] = true }; byte_set(m)
extern find_any(s const byte[:], set const ByteSet&) int = "hr_find_any"
extern match16(s const byte[:], i int, w int) int = "hr_match16"
extern match32(s const byte[:], i int, w int) int = "hr_match32"
extern match_set32(s const byte[:], i int, set const ByteSet&) int = "hr_match_set32"
extern simd256() bool = "hr_simd256"
extern byte_set_pair(s const byte[:], a const ByteSet&, d int, b const ByteSet&) int = "hr_find_pair"
find_pair(s byte[:], a const ByteSet&, d int, b const ByteSet&) int: assert(d >= 0); byte_set_pair(s, a, d, b)
map<T, F>(xs T[:]):
	o ~= []; for x xs { o.push(F(x)) }
	o
filter<T, F>(xs T[:]) T[>..]:
	o T[>..] ~= []; for x xs { if F(x) { o.push(copy(x)) } }
	o
fold<T, A, F>(xs T[:], acc A) A:
	a A ~= acc; for x xs { a = F(a, x) }
	a
sum<T>(xs T[:]) T:
	s T ~= default<T>(); for x xs { s += x }
	s
concat<T>(a T[:], b T[:]) T[>..]: o T[>..] ~= []; o.append(a); o.append(b); o
fill<T>(xs T[:], v T): for i xs.len { xs[i] .= v }
copy_into<T>(dst T[:], src T[:]): assert(dst.len == src.len); for i dst.len { dst[i] .= src[i] }
reverse<T>(xs T[:]): i ~= 0; j ~= xs.len - 1; while i < j { swap_at(xs, i, j); i += 1; j -= 1 }
extend<T>(xs T[>..]&, ys T[:]): xs.append(ys)
pyfmt(x int) byte[>..]: str(x)
pyfmt(x real) byte[>..]: str(x)
pyfmt(s byte[:]) byte[>..]: str(s)
pyfmt(c byte) byte[>..]: o byte[>..] ~= []; o.push(c); o
pyfmt(b bool) byte[>..]: str(if b { "True" } else { "False" })
pyrepr<T>(x T) byte[>..]: pyfmt(x)
pyrepr(s byte[:]) byte[>..]: o byte[>..] ~= ['\'']; o.append(s); o.push('\''); o
pyrepr(s byte[>..]) byte[>..]: pyrepr(s[..])
pyfmt<T>(xs T[:]) byte[>..]: o byte[>..] ~= ['[']; for x, i in xs { if i > 0 { o.append(", ") } o.append(pyrepr(x)) }; o.push(']'); o
concat(a byte[:], b byte[:]) byte[>..]: o byte[>..] ~= []; o.append(a); o.append(b); o
concat(a byte, b byte[:]) byte[>..]: o byte[>..] ~= [a]; o.append(b); o
concat(a byte[:], b byte) byte[>..]: o byte[>..] ~= []; o.append(a); o.push(b); o
concat(a byte, b byte) byte[>..]: o byte[>..] ~= [a, b]; o
struct tuple2<A, B> { f0 A, f1 B }
struct tuple3<A, B, C> { f0 A, f1 B, f2 C }
struct tuple4<A, B, C, D> { f0 A, f1 B, f2 C, f3 D }
hash<A, B>(t tuple2<A, B>) uint: hash_mixw(hash(t.f0), hash(t.f1))
hash<A, B, C>(t tuple3<A, B, C>) uint: hash_mixw(hash_mixw(hash(t.f0), hash(t.f1)), hash(t.f2))
hash<A, B, C, D>(t tuple4<A, B, C, D>) uint: hash_mixw(hash_mixw(hash_mixw(hash(t.f0), hash(t.f1)), hash(t.f2)), hash(t.f3))
tuple_lt<A, B>(a tuple2<A, B>, b tuple2<A, B>) bool: a.f0 < b.f0 || a.f0 == b.f0 && a.f1 < b.f1
tuple_lt<A, B, C>(a tuple3<A, B, C>, b tuple3<A, B, C>) bool: a.f0 < b.f0 || a.f0 == b.f0 && (a.f1 < b.f1 || a.f1 == b.f1 && a.f2 < b.f2)
tuple_lt<A, B, C, D>(a tuple4<A, B, C, D>, b tuple4<A, B, C, D>) bool: a.f0 < b.f0 || a.f0 == b.f0 && (a.f1 < b.f1 || a.f1 == b.f1 && (a.f2 < b.f2 || a.f2 == b.f2 && a.f3 < b.f3))
pyfmt<A, B>(t tuple2<A, B>) byte[>..]: str("(", pyrepr(t.f0), ", ", pyrepr(t.f1), ")")
pyfmt<A, B, C>(t tuple3<A, B, C>) byte[>..]: str("(", pyrepr(t.f0), ", ", pyrepr(t.f1), ", ", pyrepr(t.f2), ")")
zip<A, B>(a A[:], b B[:]) tuple2<A, B>[>..]: o tuple2<A, B>[>..] ~= []; for i in 0..min(a.len, b.len) { o.push(tuple2<A, B> { a[i], b[i] }) }; o
truediv(a int, b int) real: real(a) / real(b)
truediv(a real, b real) real: a / b
truediv(a int, b real) real: real(a) / b
truediv(a real, b int) real: a / real(b)
truthy(b bool) bool: b
truthy(x int) bool: x != 0
truthy(x real) bool: x != 0.0
truthy<T>(xs T[:]) bool: xs.len > 0
list<T>(xs T[:]) T[>..]: o T[>..] ~= []; o.append(xs); o
list(xs const byte[:][:]) byte[>..][>..]: o byte[>..][>..] ~= []; for x in xs { o.push(str(x)) }; o
pop_at<T>(xs T[>..]&) T: xs.pop()
pop_at<T>(xs T[>..]&, i int) T: remove_at(xs, i)
pop_front<T>(xs T[>..]&) T: remove_at(xs, 0)
push_front<T>(xs T[>..]&, v T): insert_at(xs, 0, v)
remove_value<T>(xs T[>..]&, v T): i := position(xs, v); if i >= 0 { remove_at(xs, i) }
ifloor(x real) int: f := flt_floor(x); int(f)
iceil(x real) int: f := flt_floor(x); int(if f < x { f + 1.0 } else { f })
pyround(x int) int: x
pyround(x real) int: f := flt_floor(x); d := x - f; n := int(f); if d > 0.5 || d == 0.5 && n % 2 != 0 { n + 1 } else { n }
pyround(x real, nd int) real: p ~= 1.0; for i in 0..nd { p *= 10.0 }; real(pyround(x * p)) / p
pydivmod(a int, b int) tuple2<int, int>: tuple2<int, int> { floor_div(a, b), a - b * floor_div(a, b) }
min<T>(a T, b T, c T) T: min(min(a, b), c)
max<T>(a T, b T, c T) T: max(max(a, b), c)
min<T>(a T, b T, c T, d T) T: min(min(a, b), min(c, d))
max<T>(a T, b T, c T, d T) T: max(max(a, b), max(c, d))
contains(s byte[:], c byte) bool: for x in s { if x == c { return true } }; false
find(s byte[:], t byte[:], start int) int: r := find(s[start..], t); if r < 0 { -1 } else { r + start }
to_int(s byte[:], base int) int: v ~= 0; for c in trim(s) { d := if c >= '0' && c <= '9' { c - '0' } else { if c >= 'a' && c <= 'z' { c - 'a' + 10 } else { c - 'A' + 10 } }; v = v * base + d }; v
pow(b int, e int, m int) int: r ~= 1; x ~= b % m; k ~= e; while k > 0 { if k & 1 != 0 { r = r * x % m } x = x * x % m; k >>= 1 }; r
INF := 1.7976931348623157e308 * 10.0
EULER := 2.718281828459045
STR_ascii_lowercase := "abcdefghijklmnopqrstuvwxyz"
STR_ascii_uppercase := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
STR_ascii_letters := "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
STR_digits := "0123456789"
extend(s byte[>..]&, c int): s.push(c as byte)
title(s byte[:]) byte[>..]: o byte[>..] ~= []; p ~= false; for c in s { o.push(if isalpha(c) { if p { lower(c) } else { upper(c) } } else { c }); p = isalpha(c) }; o
capitalize(s byte[:]) byte[>..]: o byte[>..] ~= []; for c, i in s { o.push(if i == 0 { upper(c) } else { lower(c) }) }; o
median<T>(xs T[:]) real: s := sorted(xs); n := s.len; if n % 2 == 1 { real(s[n / 2]) } else { (real(s[n / 2 - 1]) + real(s[n / 2])) / 2.0 }
mean<T>(xs T[:]) real: t ~= 0.0; for x in xs { t += real(x) }; t / real(xs.len)
prod<T>(xs T[:]) T: p ~= 1 as T; for x in xs { p *= x }; p
factorial(n int) int: p ~= 1; for i in 2..n + 1 { p *= i }; p
comb(n int, k int) int: if k < 0 || k > n { return 0 } r ~= 1; for i in 0..min(k, n - k) { r = r * (n - i) / (i + 1) }; r
perm(n int, k int) int: if k < 0 || k > n { return 0 } r ~= 1; for i in 0..k { r *= n - i }; r
isqrt(n int) int: if n < 2 { return n } x ~= n; y ~= (x + 1) / 2; while y < x { x = y; y = (x + n / x) / 2 }; x
pyb(n int, b int, p const byte[:]) byte[>..]: o byte[>..] ~= []; if n < 0 { o.push('-') } o.append(p); o.append(to_base(abs(n), b)); o
bin(n int) byte[>..]: pyb(n, 2, "0b")
oct(n int) byte[>..]: pyb(n, 8, "0o")
hex(n int) byte[>..]: pyb(n, 16, "0x")
reversed<T>(xs T[:]) T[>..]: o T[>..] ~= []; o.append(xs); reverse(o); o
sorted<T>(xs T[:]) T[>..]: o T[>..] ~= []; o.append(xs); sort(o); o
sorted<T, F>(xs T[:]) T[>..]: o T[>..] ~= []; o.append(xs); sort(o) { a, b => F(a, b) }; o
inline floor_div(a int, b int) int: if b > 0 { (a - a % b) / b } else { q := a / b; if a % b != 0 && a > 0 { q - 1 } else { q } }
floor_div(a real, b real) real: flt_floor(a / b)
gcd(a int, b int) int: x ~= abs(a); y ~= abs(b); while y != 0 { t := x % y; x = y; y = t }; x
lcm(a int, b int) int: if a == 0 || b == 0 { 0 } else { abs(a / gcd(a, b) * b) }
to_lower(s byte[:]): for &c s { if c >= 'A' && c <= 'Z' { c += 32 } }
to_upper(s byte[:]): for &c s { if c >= 'a' && c <= 'z' { c -= 32 } }
sort_insertion<T, F>(v T[:]):
	for i 1..v.len:
		x T := v[i]; j ~= i
		while j > 0:
			y T := v[j - 1]
			if !F(x, y): break
			v[j] .= y; j -= 1
		v[j] .= x
sort_run<T, F>(v T[:]) int:
	if v.len < 2: return v.len
	e ~= 2
	if F(v[1], v[0]):
		while e < v.len && F(v[e], v[e - 1]): e += 1
		reverse(v[..e])
	else: while e < v.len && !F(v[e], v[e - 1]): e += 1
	e
sort_median3<T, F>(v T[:], a int, b int, c int) int: x := F(v[a], v[b]); if x != F(v[a], v[c]) { a } else if F(v[b], v[c]) != x { c } else { b }
sort_m3<T, F>(v T[:], a int, m int) int: sort_median3(v, a, a + m * 4, a + m * 7) { x, y => F(x, y) }
sort_pivot<T, F>(v T[:]) int:
	n8 := v.len / 8
	if v.len < 128: return sort_median3(v, 0, n8 * 4, n8 * 7) { x, y => F(x, y) }
	m8 := n8 / 8
	sort_median3(v, sort_m3(v, 0, m8) { x, y => F(x, y) }, sort_m3(v, n8 * 4, m8) { x, y => F(x, y) }, sort_m3(v, n8 * 7, m8) { x, y => F(x, y) }) { x, y => F(x, y) }
sort_partition<T, F>(v T[:]) int:
	p T := v[0]; lt ~= 1
	for i 1..v.len: x T := v[i]; v[i] .= v[lt]; v[lt] .= x; if F(x, p) { lt += 1 }
	lt - 1
sort_heap<T, F>(v T[:]):
	i ~= v.len / 2
	while i > 0: i -= 1; sift_down(v, i) { a, b => F(b, a) }
	e ~= v.len
	while e > 1: e -= 1; swap_at(v, 0, e); sift_down(v[..e], 0) { a, b => F(b, a) }
sort<T>(xs T[:]): sort(xs) { a, b => a < b }
sort<T, F>(xs T[:]):
	n := xs.len
