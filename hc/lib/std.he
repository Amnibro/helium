		v |= ((b & 0x7f) as uint) << sh
		if b < 0x80: return v as int, i + 1
		sh += 7
	return 0, 0
extern flt_floor(x real) real = "floor"; extern flt_fma(x real, y real, z real) real = "fma"
format_flt(out byte[>..]&, v real, decimals int):
