flt_digit(c byte) bool: c - '0' < 10
parse_flt(s byte[:]) real, bool:
	i ~= 0; neg ~= false
	if s.len > 0 && (s[0] == '-' || s[0] == '+'): neg = s[0] == '-'; i = 1
	st := i; m uint ~= 0
	while i < s.len && flt_digit(s[i]): m = m * 10 + (s[i] - '0'); i += 1
