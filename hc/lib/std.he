parse_int(s byte[:], base int = 10) int, bool:
	i ~= 0; neg ~= false
	if s.len > 0 && (s[0] == '-' || s[0] == '+'): neg = s[0] == '-'; i = 1
	if i >= s.len: return 0, false
	mn := -9223372036854775807 - 1; v ~= 0
	while i < s.len:
		c := s[i]; d := if c >= '0' && c <= '9' { c - '0' } else if c >= 'a' && c <= 'z' { c - 'a' + 10 } else if c >= 'A' && c <= 'Z' { c - 'A' + 10 } else { -1 }
		if d < 0 || d >= base || v < (mn + d) / base: return 0, false
		v = v * base - d; i += 1
	if !neg: if v == mn { return 0, false }; v = -v
	return v, true
