# std: the library every Helium program sees without importing it.
# Sections, in order: scalars, hashing, slices, array edits, sorting, heaps,
# strings, characters, numbers in and out, random numbers, byte sets, tuples,
# and the helpers the Python dialect lowers to.

INF := 1.0e308 * 10.0
EULER := 2.718281828459045

# ---- scalars

extern popcount(x uint) int = "hr_popcount"
extern clz(x uint) int = "hr_clz"
extern ctz(x uint) int = "hr_ctz"
extern pow(x real, y real) real = "hr_pow"
extern pow(x f32, y f32) f32 = "hr_powf"
extern std_fabs(x real) real = "fabs"
extern std_fabsf(x f32) f32 = "fabsf"
extern std_floor(x real) real = "floor"
extern std_ceil(x real) real = "ceil"
extern std_round(x real) real = "round"
extern std_bits(x real) uint = "hr_f64_bits"
extern float_dec(v real, e int&) uint = "hr_float_dec"
extern store_u64le(s byte[:], at int, v uint) = "hr_store_u64le"
extern load_u64le(s const byte[:], at int) uint = "hr_load_u64le"
extern std_from_bits(b uint) real = "hr_f64_from_bits"

min<T>(a T, b T) T: if b < a { b } else { a }
max<T>(a T, b T) T: if a < b { b } else { a }
min<T>(a T, b T, c T) T: min(min(a, b), c)
max<T>(a T, b T, c T) T: max(max(a, b), c)
min<T>(a T, b T, c T, d T) T: min(min(a, b), min(c, d))
max<T>(a T, b T, c T, d T) T: max(max(a, b), max(c, d))
clamp<T>(x T, lo T, hi T) T:
	if x < lo: return lo
	if hi < x: return hi
	x
# (for floats this keeps the sign of -0.0, which is not below zero)
abs<T>(x T) T: if x < 0 { 0 - x } else { x }
sign<T>(x T) T:
	if x > 0: return 1
	if x < 0: return -1
	0
sign(x real) real:
	if x > 0.0: return 1.0
	if x < 0.0: return -1.0
	x
sign(x f32) f32:
	if x > 0.0: return 1.0
	if x < 0.0: return -1.0
	x
lerp(a real, b real, t real) real: a + (b - a) * t
lerp(a f32, b f32, t f32) f32: a + (b - a) * t
# (a typed local owns a copy; an untyped one would alias)
swap<T>(a T&, b T&):
	keep T := a
	a = b
	b = keep
# remainder that takes the sign of a (Helium's % is Euclidean)
rem<T>(a T, b T) T: a - a / b * b
# quotient rounded so that the remainder is never negative
div_euclid<T>(a T, b T) T:
	q := a / b
	if a - q * b >= 0: return q
	if b > 0 { q - 1 } else { q + 1 }
# smallest power of two that is at least x (1 for x <= 1)
next_pow2(x int) int:
	p ~= 1
	while p < x: p = p * 2
	p
pow(b int, e int) int:
	acc ~= 1; base ~= b; k ~= e
	while k > 0:
		if k & 1 == 1: acc = acc * base
		base = base * base
		k = k >> 1
	acc
pow(b int, e int, m int) int:
	acc ~= 1 % m; base ~= b % m; k ~= e
	while k > 0:
		if k & 1 == 1: acc = acc * base % m
		base = base * base % m
		k = k >> 1
	acc
# floor of the square root, for n >= 0
isqrt(n int) int:
	if n < 2: return n
	r ~= n; nx ~= (r + 1) / 2
	while nx < r:
		r = nx
		nx = (r + n / r) / 2
	r
gcd(a int, b int) int:
	x ~= abs(a); y ~= abs(b)
	while y != 0:
		t := x % y
		x = y
		y = t
	x
lcm(a int, b int) int: if a == 0 || b == 0 { 0 } else { abs(a / gcd(a, b) * b) }
factorial(n int) int:
	f ~= 1
	for i 2..n + 1: f = f * i
	f
perm(n int, k int) int:
	if k < 0 || k > n: return 0
	f ~= 1
	for i k: f = f * (n - i)
	f
comb(n int, k int) int:
	if k < 0 || k > n: return 0
	kk := min(k, n - k)
	f ~= 1
	for i kk: f = f * (n - i) / (i + 1)
	f
ifloor(x real) int: std_floor(x) as int
iceil(x real) int: std_ceil(x) as int

# ---- hashing

# a 64-bit finalizer: every input bit reaches every output bit
hash_mix(x uint) uint:
	h ~= x ^ x >> 31
	h = h * 0x7fb5d329728ea185
	h = h ^ h >> 27
	h = h * 0x81dadef4bc2dd44d
	h ^ h >> 33
hash_combine(seed uint, h uint) uint: hash_mix(seed * 0x100000001b3 ^ h)
hash(x int) uint: hash_mix(x as! uint)
hash(x uint) uint: hash_mix(x)
hash(x i32) uint: hash_mix(x as! uint)
hash(x u32) uint: hash_mix(x as uint)
hash(x i16) uint: hash_mix(x as! uint)
hash(x u16) uint: hash_mix(x as uint)
hash(x i8) uint: hash_mix(x as! uint)
hash(x byte) uint: hash_mix(x as uint)
hash(x bool) uint: hash_mix(if x { 1 } else { 0 })
hash(x real) uint: hash_mix(if x == 0.0 { 0 } else { std_bits(x) })
hash(x f32) uint: hash(x as real)
# strings: eight bytes per round, then the tail, then the length
hash(s byte[:]) uint:
	h ~= 0x2545f4914f6cdd1d as uint
	i ~= 0
	while i + 8 <= s.len:
		w ~= 0 as uint
		for k 8: w = w | (s[i + k] as uint) << (8 * k)
		h = hash_mix(h ^ w) + 0x632be59bd9b4e019
		i += 8
	w ~= 0 as uint
	for k s.len - i: w = w | (s[i + k] as uint) << (8 * k)
	hash_mix(h ^ w ^ (s.len as uint) << 56)
hash<A, B>(t tuple2<A, B>) uint: hash_combine(hash(t.f0), hash(t.f1))
hash<A, B, C>(t tuple3<A, B, C>) uint: hash_combine(hash_combine(hash(t.f0), hash(t.f1)), hash(t.f2))
hash<A, B, C, D>(t tuple4<A, B, C, D>) uint: hash_combine(hash_combine(hash_combine(hash(t.f0), hash(t.f1)), hash(t.f2)), hash(t.f3))

# ---- slices: searching, testing, folding

contains<T>(xs T[:], v T) bool:
	for x xs: if x == v { return true }
	false
contains(s byte[:], sub byte[:]) bool: find(s, sub) >= 0
# position of the first element equal to v, or -1
find<T>(xs T[:], v T) int:
	for x, i xs: if x == v { return i }
	-1
# position of the first run equal to sub, or -1
find<T>(xs T[:], sub T[:]) int:
	if sub.len == 0: return 0
	at ~= 0
	while at + sub.len <= xs.len:
		if xs[at] == sub[0] && xs[at..at + sub.len] == sub: return at
		at += 1
	-1
find(s byte[:], t byte[:], start int) int:
	from := clamp(start, 0, s.len)
	r := find(s[from..], t)
	if r < 0 { -1 } else { r + from }
# the first element the block accepts
find<T, F>(xs T[:]) T?:
	for &x xs: if F(x) { return x }
	null
rfind<T>(xs T[:], sub T[:]) int:
	at ~= xs.len - sub.len
	while at >= 0:
		if xs[at..at + sub.len] == sub: return at
		at -= 1
	-1
index<T>(xs T[:], v T) int: find(xs, v)
index<T>(xs T[:], sub T[:]) int: find(xs, sub)
position<T>(xs T[:], v T) int: find(xs, v)
find_index<T, F>(xs T[:]) int:
	for x, i xs: if F(x) { return i }
	-1
any<T, F>(xs T[:]) bool:
	for x xs: if F(x) { return true }
	false
all<T, F>(xs T[:]) bool:
	for x xs: if !F(x) { return false }
	true
any(xs bool[:]) bool:
	for x xs: if x { return true }
	false
all(xs bool[:]) bool:
	for x xs: if !x { return false }
	true
count<T>(xs T[:], v T) int:
	n ~= 0
	for x xs: if x == v { n += 1 }
	n
count<T, F>(xs T[:]) int:
	n ~= 0
	for x xs: if F(x) { n += 1 }
	n
# non-overlapping occurrences of sub
count(s byte[:], sub byte[:]) int:
	if sub.len == 0: return s.len + 1
	n ~= 0; at ~= 0
	while at + sub.len <= s.len:
		if s[at..at + sub.len] == sub { n += 1; at += sub.len } else { at += 1 }
	n
min<T>(xs T[:]) T:
	best ~= xs[0]
	for x xs: if x < best { best = x }
	best
max<T>(xs T[:]) T:
	best ~= xs[0]
	for x xs: if best < x { best = x }
	best
# with a block a, b => true when a orders before b
min<T, F>(xs T[:]) T:
	best ~= xs[0]
	for x xs: if F(x, best) { best = x }
	best
max<T, F>(xs T[:]) T:
	best ~= xs[0]
	for x xs: if F(best, x) { best = x }
	best
# index of the element with the smallest (largest) key; the block gives the key
min_by<T, F>(xs T[:]) int:
	if xs.len == 0: return -1
	at ~= 0
	for i 1..xs.len: if F(xs[i]) < F(xs[at]) { at = i }
	at
max_by<T, F>(xs T[:]) int:
	if xs.len == 0: return -1
	at ~= 0
	for i 1..xs.len: if F(xs[at]) < F(xs[i]) { at = i }
	at
last<T>(xs T[:]) T&: xs[xs.len - 1]
elem<T>(xs T[:], i int) T: xs[i]
# first index where the block turns false, for a block true on a prefix
lower_bound<T, F>(xs T[:]) int:
	lo ~= 0; hi ~= xs.len
	while lo < hi:
		mid := lo + (hi - lo) / 2
		if F(xs[mid]) { lo = mid + 1 } else { hi = mid }
	lo
# in a sorted slice: where v is or would go, and whether it is there
binary_search<T>(xs T[:], v T) int, bool:
	lo ~= 0; hi ~= xs.len
	while lo < hi:
		mid := lo + (hi - lo) / 2
		if xs[mid] < v { lo = mid + 1 } else { hi = mid }
	return lo, lo < xs.len && xs[lo] == v
starts_with<T>(xs T[:], p T[:]) bool: p.len <= xs.len && xs[..p.len] == p
ends_with<T>(xs T[:], p T[:]) bool: p.len <= xs.len && xs[xs.len - p.len..] == p
startswith(s byte[:], p byte[:]) bool: starts_with(s, p)
endswith(s byte[:], p byte[:]) bool: ends_with(s, p)
each_rev<T, F>(xs T[:]):
	i ~= xs.len
	while i > 0:
		i -= 1
		F(xs[i])
# calls the block with consecutive pieces of n elements (the last may be shorter)
each_chunk<T, F>(xs T[:], n int):
	at ~= 0
	while at < xs.len:
		e := min(at + n, xs.len)
		F(xs[at..e])
		at = e
map<T, F>(xs T[:]):
	out ~= []
	for x xs: out.push(F(x))
	out
filter<T, F>(xs T[:]) T[>..]:
	out T[>..] ~= []
	for x xs: if F(x) { out.push(x) }
	out
fold<T, A, F>(xs T[:], acc A) A:
	r ~= acc
	for x xs: r = F(r, x)
	r
sum<T>(xs T[:]) T:
	t ~= default<T>()
	for x xs: t = t + x
	t
prod<T>(xs T[:]) T:
	t ~= default<T>() + 1
	for x xs: t = t * x
	t
mean<T>(xs T[:]) real:
	t ~= 0.0
	for x xs: t = t + x as real
	t / xs.len as real
median<T>(xs T[:]) real:
	s := sorted(xs)
	h := s.len / 2
	if s.len % 2 == 1 { s[h] as real } else { (s[h - 1] as real + s[h] as real) / 2.0 }
concat<T>(a T[:], b T[:]) T[>..]:
	out T[>..] ~= []
	out.append(a)
	out.append(b)
	out
fill<T>(xs T[:], v T): for &x xs { x = v }
copy_into<T>(dst T[:], src T[:]): for i min(dst.len, src.len) { dst[i] = src[i] }
reverse<T>(xs T[:]):
	i ~= 0; j ~= xs.len - 1
	while i < j:
		swap_at(xs, i, j)
		i += 1
		j -= 1
reversed<T>(xs T[:]) T[>..]:
	out T[>..] ~= []
	each_rev(xs) { out.push(it) }
	out
# elements move with .= (rebinding), so owned elements are not copied twice
swap_at<T>(xs T[:], i int, j int):
	keep T := xs[j]
	xs[j] .= xs[i]
	xs[i] .= keep
# an owned copy of xs[i]
taken<T>(xs T[:], i int) T:
	v T := xs[i]
	v
list<T>(xs T[:]) T[>..]:
	out T[>..] ~= []
	out.append(xs)
	out
# a list of string slices becomes a list of owned strings
list(xs const byte[:][:]) byte[>..][>..]:
	out byte[>..][>..] ~= []
	for x xs: out.push(str(x))
	out
zip<A, B>(a A[:], b B[:]) tuple2<A, B>[>..]:
	out tuple2<A, B>[>..] ~= []
	for i min(a.len, b.len): out.push(tuple2<A, B>{a[i], b[i]})
	out

# ---- array edits (growable arrays, passed by reference)

push_n<A, T>(xs A&, v T, n int): for i n { xs.push(v) }
extend<T>(xs T[>..]&, ys T[:]): xs.append(ys)
extend(s byte[>..]&, c int): s.push(c as! byte)
insert_at<A, T>(xs A&, i int, v T):
	xs.push(v)
	held := taken(xs[..], xs.len - 1)
	k ~= xs.len - 1
	while k > i:
		xs[k] .= xs[k - 1]
		k -= 1
	xs[i] .= held
# removes element i, closing the gap, and returns it
remove_at<A>(xs A&, i int):
	gone := taken(xs[..], i)
	for k i..xs.len - 1: xs[k] .= xs[k + 1]
	xs.resize(xs.len - 1)
	return gone
# removes element i by moving the last element into its place; returns it
swap_remove<A>(xs A&, i int):
	gone := taken(xs[..], i)
	xs[i] .= xs[xs.len - 1]
	xs.resize(xs.len - 1)
	return gone
pop_at<T>(xs T[>..]&, i int) T: remove_at(xs, i)
pop_at<T>(xs T[>..]&) T: xs.pop()
pop_front<T>(xs T[>..]&) T: pop_at(xs, 0)
push_front<T>(xs T[>..]&, v T): insert_at(xs, 0, v)
remove_value<T>(xs T[>..]&, v T):
	i := find(xs[..], v)
	if i >= 0: remove_at(xs, i)
# keeps the elements the block accepts, in order
retain<A, F>(xs A&):
	kept ~= 0
	for k xs.len:
		if F(xs[k]):
			if kept != k: xs[kept] .= xs[k]
			kept += 1
	xs.resize(kept)
# drops elements equal to the one before them
dedup<A>(xs A&):
	if xs.len < 2: return
	kept ~= 1
	for k 1..xs.len:
		if !(xs[k] == xs[kept - 1]):
			if kept != k: xs[kept] .= xs[k]
			kept += 1
	xs.resize(kept)

# ---- sorting
# sort: quicksort on the middle-of-three value down to short ranges, which a
# final insertion pass finishes; ranges wait on a fixed stack, larger first,
# so it never holds more than 64 of them. Not stable.

sort<T, F>(xs T[:]):
	if xs.len > 12:
		pend int[128] ~= [0; 128]
		top ~= 0
		lo ~= 0; hi ~= xs.len
		while true:
			while hi - lo > 12:
				mid := lo + (hi - lo - 1) / 2
				# order xs[lo], xs[mid], xs[hi - 1]
				if F(xs[mid], xs[lo]): swap_at(xs, mid, lo)
				if F(xs[hi - 1], xs[mid]):
					swap_at(xs, hi - 1, mid)
					if F(xs[mid], xs[lo]): swap_at(xs, mid, lo)
				pv T := xs[mid]
				i ~= lo - 1; j ~= hi
				while true:
					i += 1
					while F(xs[i], pv): i += 1
					j -= 1
					while F(pv, xs[j]): j -= 1
					if i >= j: break
					swap_at(xs, i, j)
				# [lo, j] and [j + 1, hi): wait on the larger, keep going on the smaller
				if j + 1 - lo > hi - j - 1:
					pend[top] = lo; pend[top + 1] = j + 1; top += 2
					lo = j + 1
				else:
					pend[top] = j + 1; pend[top + 1] = hi; top += 2
					hi = j + 1
			if top == 0: break
			top -= 2
			lo = pend[top]; hi = pend[top + 1]
	for k 1..xs.len:
		v T := xs[k]
		m ~= k
		while m > 0 && F(v, xs[m - 1]):
			xs[m] .= xs[m - 1]
			m -= 1
		xs[m] .= v
sort<T>(xs T[:]): sort(xs) { a, b => a < b }
# Fixed-width integer keys sort by value, not by comparison: an LSD radix
# sort on bytes. One read counts every byte position, a position whose bytes
# are all the same is skipped, and each other one is a single stable pass
# through a scratch copy. Signed keys flip their top bit so negatives come
# first. Short ranges use the comparison sort above.
radix_key(k u64, d int, top int) int:
	b := ((k >> (d * 8) as! u64) & 255) as! int
	if d == top { b ^ 128 } else { b }
radix_sort<T>(xs T[:], nb int, sgn bool):
	n := xs.len
	if n <= 256 { sort(xs) { a, b => a < b }; return }
	top := if sgn { nb - 1 } else { -1 }
	cnt int[>..] ~= []; cnt.resize(nb * 256, 0)
	for x xs:
		k := x as! u64
		for d nb: cnt[d * 256 + radix_key(k, d, top)] += 1
	tmp T[>..] ~= []
	tmp.append(xs)
	src T[:] ~= xs; dst T[:] ~= tmp[..]; moved ~= false
	ofs int[256] ~= [0; 256]
	for d nb:
		c := d * 256
		if cnt[c + radix_key(src[0] as! u64, d, top)] == n: continue
		o ~= 0
		for b 256 { ofs[b] = o; o += cnt[c + b] }
		for x src:
			b := radix_key(x as! u64, d, top)
			dst[ofs[b]] = x; ofs[b] += 1
		t := src; src = dst; dst = t; moved = !moved
	if moved: for i n { xs[i] = src[i] }
sort(xs u8[:]): radix_sort(xs, 1, false)
sort(xs i8[:]): radix_sort(xs, 1, true)
sort(xs u16[:]): radix_sort(xs, 2, false)
sort(xs i16[:]): radix_sort(xs, 2, true)
sort(xs u32[:]): radix_sort(xs, 4, false)
sort(xs i32[:]): radix_sort(xs, 4, true)
sort(xs u64[:]): radix_sort(xs, 8, false)
sort(xs i64[:]): radix_sort(xs, 8, true)
# stable_sort: merges runs of doubling width through one scratch copy
stable_sort<T, F>(xs T[:]):
	n := xs.len
	if n < 2: return
	tmp T[>..] ~= []
	tmp.append(xs)
	w ~= 1
	while w < n:
		at ~= 0
		while at < n:
			mid := min(at + w, n); e := min(at + 2 * w, n)
			a ~= at; b ~= mid; o ~= at
			while a < mid && b < e:
				if F(xs[b], xs[a]) { tmp[o] = xs[b]; b += 1 } else { tmp[o] = xs[a]; a += 1 }
				o += 1
			while a < mid { tmp[o] = xs[a]; a += 1; o += 1 }
			while b < e { tmp[o] = xs[b]; b += 1; o += 1 }
			at = e
		for i n: xs[i] = tmp[i]
		w = w * 2
stable_sort<T>(xs T[:]): stable_sort(xs) { a, b => a < b }
sorted<T>(xs T[:]) T[>..]:
	out T[>..] ~= []
	out.append(xs)
	sort(out[..])
	out
sorted<T, F>(xs T[:]) T[>..]:
	out T[>..] ~= []
	out.append(xs)
	sort(out[..]) { a, b => F(a, b) }
	out

# ---- recurrences and tables: each value is computed once
# seq: x0 = a0, x1 = a1, x(k) = F(x(k - 2), x(k - 1)); returns x(n) after
# n - 1 steps (seq(n, 0, 1) { a, b => a + b } is fib(n)). The one-start form
# steps x(k) = F(x(k - 1)).
seq<T, F>(n int, a0 T, a1 T) T:
	if n <= 0: return a0
	a ~= a0; b ~= a1
	for k 1..n:
		c := F(a, b); a = b; b = c
	b
seq<T, F>(n int, a0 T) T:
	a ~= a0
	for k n: a = F(a)
	a
# tab: fills a table once from a pure index function: out[i] = F(i), or
# out[i * m + j] = F(i, j) for the two-index form, row by row.
tab<F>(n int):
	out ~= []
	for i n: out.push(F(i))
	out
tab<F>(n int, m int):
	out ~= []
	for i n:
		for j m: out.push(F(i, j))
	out
# each_sum: out[i] = F(i, 0) + F(i, 1) + ... + F(i, m - 1), added from zero
# in j order, so it is bit-identical to the nested loop even for reals. The
# rows run eight at a time, each with its own sum, so the eight additions in
# flight are independent.
each_sum<T, F>(out T[:], m int):
	n := out.len; i ~= 0
	while i + 8 <= n:
		s0 ~= default<T>(); s1 ~= s0; s2 ~= s0; s3 ~= s0; s4 ~= s0; s5 ~= s0; s6 ~= s0; s7 ~= s0
		for j m:
			s0 = s0 + F(i, j); s1 = s1 + F(i + 1, j); s2 = s2 + F(i + 2, j); s3 = s3 + F(i + 3, j)
			s4 = s4 + F(i + 4, j); s5 = s5 + F(i + 5, j); s6 = s6 + F(i + 6, j); s7 = s7 + F(i + 7, j)
		out[i] = s0; out[i + 1] = s1; out[i + 2] = s2; out[i + 3] = s3
		out[i + 4] = s4; out[i + 5] = s5; out[i + 6] = s6; out[i + 7] = s7
		i += 8
	while i < n:
		s ~= default<T>()
		for j m: s = s + F(i, j)
		out[i] = s
		i += 1
# counter: the start of a count; hc lowers a local collection that is only
# pushed and measured to one (x.push(v) becomes x++, x.len becomes x).
counter() int: 0

# ---- binary heaps: xs[0] is the element the order puts first
# (the smallest without a block). The block is a, b => a before b.

heap_up<T, F>(xs T[:], at int):
	c ~= at
	while c > 0:
		p := (c - 1) / 2
		if !F(xs[c], xs[p]): return
		swap_at(xs, c, p)
		c = p
heap_down<T, F>(xs T[:], at int):
	p ~= at
	while true:
		l := 2 * p + 1
		if l >= xs.len: return
		best ~= l
		if l + 1 < xs.len && F(xs[l + 1], xs[l]): best = l + 1
		if !F(xs[best], xs[p]): return
		swap_at(xs, best, p)
		p = best
heap_push<A, T, F>(xs A&, v T):
	xs.push(v)
	heap_up(xs[..], xs.len - 1) { a, b => F(a, b) }
heap_push<A, T>(xs A&, v T): heap_push(xs, v) { a, b => a < b }
# removes and returns xs[0]
heap_pop<A, F>(xs A&):
	first := taken(xs[..], 0)
	xs[0] .= xs[xs.len - 1]
	xs.resize(xs.len - 1)
	heap_down(xs[..], 0) { a, b => F(a, b) }
	return first
heap_pop<A>(xs A&): heap_pop(xs) { a, b => a < b }
make_heap<A, F>(xs A&):
	i ~= xs.len / 2
	while i > 0:
		i -= 1
		heap_down(xs[..], i) { a, b => F(a, b) }
make_heap<A>(xs A&): make_heap(xs) { a, b => a < b }

# ---- characters

is_space(c byte) bool: c == ' ' || c >= 9 && c <= 13
isspace(c byte) bool: is_space(c)
isdigit(c byte) bool: c >= '0' && c <= '9'
islower(c byte) bool: c >= 'a' && c <= 'z'
isupper(c byte) bool: c >= 'A' && c <= 'Z'
isalpha(c byte) bool: islower(c) || isupper(c)
isalnum(c byte) bool: isalpha(c) || isdigit(c)
isdigit(s byte[:]) bool:
	for c s: if !isdigit(c) { return false }
	s.len > 0
isalpha(s byte[:]) bool:
	for c s: if !isalpha(c) { return false }
	s.len > 0
# true when s has a cased letter and none of the opposite case
islower(s byte[:]) bool:
	lo ~= false
	for c s:
		if isupper(c): return false
		if islower(c): lo = true
	lo
isupper(s byte[:]) bool:
	up ~= false
	for c s:
		if islower(c): return false
		if isupper(c): up = true
	up
lower(c byte) byte: if isupper(c) { c + 32 } else { c }
upper(c byte) byte: if islower(c) { c - 32 } else { c }
ord(c byte) int: c as int
ord(c int) int: c
ord(s byte[:]) int: if s.len > 0 { s[0] as int } else { 0 }
chr(n int) byte[>..]:
	out byte[>..] ~= []
	push_utf8(out, n)
	out
to_int(c byte) int: c as int

# ---- strings

trim_start(s byte[:]) byte[:]:
	a ~= 0
	while a < s.len && is_space(s[a]): a += 1
	s[a..]
trim_end(s byte[:]) byte[:]:
	e ~= s.len
	while e > 0 && is_space(s[e - 1]): e -= 1
	s[..e]
trim(s byte[:]) byte[:]: trim_end(trim_start(s))
strip(s byte[:]) byte[:]: trim(s)
lstrip(s byte[:]) byte[:]: trim_start(s)
rstrip(s byte[:]) byte[:]: trim_end(s)
each_split<F>(s byte[:], sep byte):
	from ~= 0
	for c, i s:
		if c == sep:
			F(s[from..i])
			from = i + 1
	F(s[from..])
each_split<F>(s byte[:], sep byte[:]):
	from ~= 0; at ~= 0
	while sep.len > 0 && at + sep.len <= s.len:
		if s[at..at + sep.len] == sep { F(s[from..at]); at += sep.len; from = at } else { at += 1 }
	F(s[from..])
each_word<F>(s byte[:]):
	at ~= 0
	while at < s.len:
		while at < s.len && is_space(s[at]): at += 1
		b := at
		while at + 8 <= s.len:
			w := load_u64le(s, at)
			q := w ^ 0x2020202020202020
			x := w & 0x7F7F7F7F7F7F7F7F
			if ((q - 0x0101010101010101) & ~q | 0x8D8D8D8D8D8D8D8D - x & ~w & x + 0x7777777777777777) & 0x8080808080808080 != 0: break
			at += 8
		while at < s.len && !is_space(s[at]): at += 1
		if at > b: F(s[b..at])
split(s byte[:], sep byte) const byte[:][>..]:
	out const byte[:][>..] ~= []
	each_split(s, sep) { out.push(it) }
	out
split(s byte[:], sep byte[:]) const byte[:][>..]:
	out const byte[:][>..] ~= []
	each_split(s, sep) { out.push(it) }
	out
words(s byte[:]) const byte[:][>..]:
	out const byte[:][>..] ~= []
	each_word(s) { out.push(it) }
	out
split(s byte[:]) const byte[:][>..]: words(s)
join<T>(out byte[>..]&, parts T[:], sep byte[:]):
	for p, i parts:
		if i > 0: out.append(sep)
		out.append(p)
join<T>(sep byte[:], parts T[:]) byte[>..]:
	out byte[>..] ~= []
	join(out, parts, sep)
	out
join<T>(sep int, parts T[:]) byte[>..]:
	s byte[1] ~= [sep as! byte]
	join(s[..], parts)
join(sep byte[:], parts byte[:]) byte[>..]:
	out byte[>..] ~= []
	for c, i parts:
		if i > 0: out.append(sep)
		out.push(c)
	out
join(sep int, parts byte[:]) byte[>..]:
	s byte[1] ~= [sep as! byte]
	join(s[..], parts)
# negative, zero or positive as a sorts before, with, or after b
compare(a byte[:], b byte[:]) int:
	for i min(a.len, b.len):
		if a[i] != b[i]: return a[i] as int - b[i] as int
	a.len - b.len
to_lower(s byte[:]): for &c s { c = lower(c) }
to_upper(s byte[:]): for &c s { c = upper(c) }
lower(s byte[:]) byte[>..]:
	out byte[>..] ~= []
	for c s: out.push(lower(c))
	out
upper(s byte[:]) byte[>..]:
	out byte[>..] ~= []
	for c s: out.push(upper(c))
	out
capitalize(s byte[:]) byte[>..]:
	out byte[>..] ~= []
	for c, i s: out.push(if i == 0 { upper(c) } else { lower(c) })
	out
title(s byte[:]) byte[>..]:
	out byte[>..] ~= []
	prev ~= false
	for c s:
		out.push(if prev { lower(c) } else { upper(c) })
		prev = isalpha(c)
	out
format_replaced(out byte[>..]&, s byte[:], old byte[:], with byte[:]):
	at ~= 0
	while at < s.len:
		if old.len > 0 && at + old.len <= s.len && s[at..at + old.len] == old { out.append(with); at += old.len } else { out.push(s[at]); at += 1 }
replace(s byte[:], old byte[:], with byte[:]) byte[>..]:
	out byte[>..] ~= []
	format_replaced(out, s, old, with)
	out
replace(s byte[:], old int, with int) byte[>..]:
	out byte[>..] ~= []
	for c s: out.push(if c as int == old { with as! byte } else { c })
	out
repeat(s byte[:], n int) byte[>..]:
	out byte[>..] ~= []
	for i n: out.append(s)
	out
concat(a byte[:], b byte[:]) byte[>..]:
	out byte[>..] ~= []
	out.append(a); out.append(b)
	out
concat(a byte, b byte[:]) byte[>..]:
	out byte[>..] ~= [a]
	out.append(b)
	out
concat(a byte[:], b byte) byte[>..]:
	out byte[>..] ~= []
	out.append(a); out.push(b)
	out
concat(a byte, b byte) byte[>..]:
	out byte[>..] ~= [a, b]
	out
ljust(s byte[:], w int, f byte = ' ') byte[>..]:
	out byte[>..] ~= []
	out.append(s)
	while out.len < w: out.push(f)
	out
rjust(s byte[:], w int, f byte = ' ') byte[>..]:
	out byte[>..] ~= []
	for i w - s.len: out.push(f)
	out.append(s)
	out
center(s byte[:], w int, f byte = ' ') byte[>..]:
	out byte[>..] ~= []
	room := max(w - s.len, 0)
	left := room / 2 + (room & w & 1)
	for i left: out.push(f)
	out.append(s)
	for i room - left: out.push(f)
	out
# zero padding that keeps a leading sign in front
zfill(s byte[:], w int) byte[>..]:
	out byte[>..] ~= []
	signed := s.len > 0 && (s[0] == '-' || s[0] == '+')
	if signed: out.push(s[0])
	for i w - s.len: out.push('0')
	out.append(if signed { s[1..] } else { s })
	out

# ---- UTF-8

push_utf8(out byte[>..]&, cp int):
	if cp < 0x80:
		out.push(cp as! byte)
	elif cp < 0x800:
		out.push((0xC0 | cp >> 6) as! byte); out.push((0x80 | cp & 0x3F) as! byte)
	elif cp < 0x10000:
		out.push((0xE0 | cp >> 12) as! byte); out.push((0x80 | cp >> 6 & 0x3F) as! byte); out.push((0x80 | cp & 0x3F) as! byte)
	else:
		out.push((0xF0 | cp >> 18) as! byte); out.push((0x80 | cp >> 12 & 0x3F) as! byte); out.push((0x80 | cp >> 6 & 0x3F) as! byte); out.push((0x80 | cp & 0x3F) as! byte)
# how many bytes the sequence starting at s[i] takes (1 for a stray byte)
utf8_cont(s byte[:], i int) int:
	c := s[i]
	n := if c < 0xC0 { 1 } else { if c < 0xE0 { 2 } else { if c < 0xF0 { 3 } else { 4 } } }
	if i + n > s.len: return 1
	for k 1..n: if s[i + k] & 0xC0 != 0x80 { return 1 }
	n
# calls the block with each code point
each_utf8<F>(s byte[:]):
	i ~= 0
	while i < s.len:
		n := utf8_cont(s, i)
		c := s[i] as int
		cp ~= if n == 1 { c } else { if n == 2 { c & 0x1F } else { if n == 3 { c & 0x0F } else { c & 0x07 } } }
		for k 1..n: cp = cp << 6 | (s[i + k] as int) & 0x3F
		F(cp)
		i += n

# ---- numbers in

digit_value(c byte) int:
	if c >= '0' && c <= '9': return (c - '0') as int
	if c >= 'a' && c <= 'z': return (c - 'a') as int + 10
	if c >= 'A' && c <= 'Z': return (c - 'A') as int + 10
	99
# the whole of s as an integer in base 2..36, with an optional sign;
# false (and 0) when anything else is there or the value does not fit
parse_int(s byte[:], base int = 10) int, bool:
	at ~= 0; neg ~= false
	if at < s.len && (s[at] == '-' || s[at] == '+'):
		neg = s[at] == '-'
		at += 1
	if at >= s.len: return 0, false
	v ~= 0 as uint
	lim := if neg { 0x8000000000000000 as uint } else { 0x7fffffffffffffff as uint }
	while at < s.len:
		d := digit_value(s[at])
		if d >= base: return 0, false
		if v > (lim - d as uint) / base as uint: return 0, false
		v = v * base as uint + d as uint
		at += 1
	# -2^63 has no positive twin, so it comes straight from its bits
	r := if !neg { v as! int } else if v == lim { lim as! int } else { 0 - v as! int }
	return r, true
to_int(s byte[:]) int:
	v, ok := parse_int(trim(s))
	v
to_int(s byte[:], base int) int:
	v, ok := parse_int(trim(s), base)
	v
to_int(s const byte[>..]&) int: to_int(s[..])
to_int<T>(x T) int: x as int
flt_digit(c byte) bool: c >= '0' && c <= '9'

# Decimal to binary for the cases the fast path cannot do exactly: the
# digits become a big integer (base 2^32 limbs, low first), the power of ten
# lands on the numerator or the denominator, and a bitwise long division
# yields 64 quotient bits plus a sticky bit, rounded to nearest even.
big_mul_add(a uint[>..]&, m uint, add uint):
	carry ~= add
	for &l a:
		t := l * m + carry
		l = t & 0xffffffff
		carry = t >> 32
	if carry != 0: a.push(carry)
big_bits(a uint[>..]&) int:
	i ~= a.len - 1
	while i >= 0 && a[i] == 0: i -= 1
	if i < 0: return 0
	32 * i + 64 - clz(a[i])
big_shl(a uint[>..]&, n int):
	if n <= 0: return
	words := n / 32; bits := n % 32
	if bits > 0: big_mul_add(a, 1 << bits as uint, 0)
	if words > 0:
		old := a.len
		a.resize(old + words, 0)
		k ~= old - 1
		while k >= 0:
			a[k + words] = a[k]
			k -= 1
		for z words: a[z] = 0
big_less(a uint[>..]&, b uint[>..]&) bool:
	n := max(a.len, b.len)
	k ~= n - 1
	while k >= 0:
		x := if k < a.len { a[k] } else { 0 as uint }
		y := if k < b.len { b[k] } else { 0 as uint }
		if x != y: return x < y
		k -= 1
	false
big_sub(a uint[>..]&, b uint[>..]&):
	borrow ~= 0 as uint
	for k a.len:
		y := if k < b.len { b[k] } else { 0 as uint }
		t := a[k] - y - borrow
		borrow = if a[k] < y + borrow || y + borrow < y { 1 } else { 0 }
		a[k] = t & 0xffffffff
big_zero(a uint[>..]&) bool:
	for l a: if l != 0 { return false }
	true
# 2^e2 * q, with sticky set when bits below q were not zero, as the nearest double
round_bits(q uint, e2 int, sticky bool) real:
	e := e2 + 63
	if e > 1023: return INF
	drop ~= 11
	if e < -1022: drop = 11 + (-1022 - e)
	if drop > 64: return 0.0
	m ~= 0 as uint; low ~= 0 as uint; half ~= 0 as uint
	if drop == 64:
		low = q; half = 0x8000000000000000
	else:
		m = q >> drop as uint; low = q & ((1 as uint << drop as uint) - 1); half = 1 as uint << (drop - 1) as uint
	if low > half || low == half && (sticky || m & 1 == 1): m += 1
	if e < -1022: return std_from_bits(m)
	if m == 1 as uint << 53:
		m = m >> 1
		if e + 1 > 1023: return INF
		return std_from_bits(((e + 1 + 1023) as uint) << 52 | m & 0xfffffffffffff)
	std_from_bits(((e + 1023) as uint) << 52 | m & 0xfffffffffffff)
slow_decimal(digits byte[:], e10 int) real:
	num uint[>..] ~= [0]
	for c digits: big_mul_add(num, 10, (c - '0') as uint)
	if big_zero(num): return 0.0
	den uint[>..] ~= [1]
	for i abs(e10): big_mul_add(if e10 > 0 { num } else { den }, 10, 0)
	# lands the quotient in [2^62, 2^64); one more bit if it came out short
	sh ~= 63 - (big_bits(num) - big_bits(den))
	q ~= 0 as uint; sticky ~= false
	for attempt 2:
		n2 uint[>..] ~= []; n2.append(num[..])
		d2 uint[>..] ~= []; d2.append(den[..])
		if sh > 0 { big_shl(n2, sh) } else { big_shl(d2, -sh) }
		# quotient bits from high to low
		nb := big_bits(n2) - big_bits(d2)
		big_shl(d2, max(nb, 0))
		q = 0
		k ~= max(nb, 0)
		while k >= 0:
			q = q << 1
			if !big_less(n2, d2) { big_sub(n2, d2); q = q | 1 }
			if k > 0: big_shr1(d2)
			k -= 1
		sticky = !big_zero(n2)
		if q >> 63 == 1: break
		sh += 1
	round_bits(q, -sh, sticky)
big_shr1(a uint[>..]&):
	for k a.len:
		hi := if k + 1 < a.len { a[k + 1] & 1 } else { 0 as uint }
		a[k] = a[k] >> 1 | hi << 31
POW10 := [1.0, 10.0, 100.0, 1.0e3, 1.0e4, 1.0e5, 1.0e6, 1.0e7, 1.0e8, 1.0e9, 1.0e10, 1.0e11, 1.0e12, 1.0e13, 1.0e14, 1.0e15, 1.0e16, 1.0e17, 1.0e18, 1.0e19, 1.0e20, 1.0e21, 1.0e22]
# a decimal or "inf"/"nan" with optional sign and exponent; the whole of s
parse_flt(s byte[:]) real, bool:
	at ~= 0; neg ~= false
	if at < s.len && (s[at] == '-' || s[at] == '+'):
		neg = s[at] == '-'
		at += 1
	rest := lower(s[at..])
	if rest == "inf" || rest == "infinity": return if neg { -INF } else { INF }, true
	if rest == "nan": return INF - INF, true
	digits byte[>..] ~= []
	e10 ~= 0; seen ~= false
	while at < s.len && flt_digit(s[at]):
		if digits.len > 0 || s[at] != '0': digits.push(s[at])
		seen = true; at += 1
	if at < s.len && s[at] == '.':
		at += 1
		while at < s.len && flt_digit(s[at]):
			if digits.len > 0 || s[at] != '0' { digits.push(s[at]) }
			e10 -= 1; seen = true; at += 1
	if !seen: return 0.0, false
	if at < s.len && (s[at] == 'e' || s[at] == 'E'):
		at += 1
		eneg ~= false
		if at < s.len && (s[at] == '-' || s[at] == '+') { eneg = s[at] == '-'; at += 1 }
		if at >= s.len || !flt_digit(s[at]): return 0.0, false
		ev ~= 0
		while at < s.len && flt_digit(s[at]):
			if ev < 100000: ev = ev * 10 + (s[at] - '0') as int
			at += 1
		e10 += if eneg { -ev } else { ev }
	if at != s.len: return 0.0, false
	# trailing zeros move into the exponent
	while digits.len > 0 && digits[digits.len - 1] == '0':
		digits.pop_n(1)
		e10 += 1
	v ~= 0.0
	if digits.len == 0:
		v = 0.0
	elif digits.len + e10 > 310:
		v = INF
	elif digits.len + e10 < -326:
		v = 0.0
	elif digits.len <= 15 && e10 >= -22 && e10 <= 22:
		m ~= 0
		for c digits: m = m * 10 + (c - '0') as int
		v = if e10 >= 0 { m as real * POW10[e10] } else { m as real / POW10[-e10] }
	else:
		v = slow_decimal(digits[..], e10)
	return if neg { -v } else { v }, true
to_real(s byte[:]) real:
	v, ok := parse_flt(trim(s))
	v
to_real(s const byte[>..]&) real: to_real(s[..])
to_real<T>(x T) real: x as real
# unsigned LEB128 at the start of s: the value and how many bytes it took
parse_uleb(s byte[:]) int, int:
	v ~= 0 as uint; shift ~= 0; at ~= 0
	while at < s.len:
		b := s[at]
		at += 1
		if shift < 64: v = v | ((b & 0x7F) as uint) << shift as uint
		shift += 7
		if b & 0x80 == 0: return v as! int, at
	return v as! int, at

# ---- numbers out

DIGITS := "0123456789abcdefghijklmnopqrstuvwxyz"
format_uint<B>(out B&, v uint, base int = 10, width int = 0, padc byte = ' '):
	tmp byte[..64] ~= []
	x ~= v
	b := base as uint
	while true:
		tmp.push(DIGITS[(x % b) as int])
		x = x / b
		if x == 0: break
	for i width - tmp.len: out.push(padc)
	k ~= tmp.len
	while k > 0:
		k -= 1
		out.push(tmp[k])
format_int<B>(out B&, v int, base int = 10, width int = 0, padc byte = ' '):
	mag := if v < 0 { 0 - v as! uint } else { v as uint }
	if v >= 0: format_uint(out, mag, base, width, padc); return
	if padc == '0':
		out.push('-')
		format_uint(out, mag, base, width - 1, padc)
		return
	tmp byte[..72] ~= ['-']
	format_uint(tmp, mag, base)
	for i width - tmp.len: out.push(padc)
	out.append(tmp[..])
format_uleb(out byte[>..]&, v int):
	x ~= v as! uint
	while x >= 0x80:
		out.push((x & 0x7F | 0x80) as! byte)
		x = x >> 7
	out.push(x as! byte)
to_base(n int, b int) byte[>..]:
	out byte[>..] ~= []
	format_int(out, n, b)
	out
pyb(n int, b int, p const byte[:]) byte[>..]:
	out byte[>..] ~= []
	if n < 0: out.push('-')
	out.append(p)
	format_uint(out, if n < 0 { 0 - n as! uint } else { n as uint }, b)
	out
# b as lowercase hex, two digits a byte
hexw(t uint) uint:
	s := t & 0xFF | (t & 0xFF00) << 8 | (t & 0xFF0000) << 16 | (t & 0xFF000000) << 24
	n := s >> 4 & 0x000F000F000F000F | (s & 0x000F000F000F000F) << 8
	n + 0x3030303030303030 + ((n + 0x0606060606060606) >> 4 & 0x0101010101010101) * 39
hex_encode(out byte[>..]&, b const byte[:]):
	o ~= out.len
	out.resize(o + 2 * b.len + 16, 0)
	i ~= 0
	while i + 8 <= b.len:
		w := load_u64le(b, i)
		store_u64le(out, o, hexw(w & 0xFFFFFFFF))
		store_u64le(out, o + 8, hexw(w >> 32))
		i += 8
		o += 16
	while i < b.len:
		store_u64le(out, o, hexw(b[i] as uint))
		i += 1
		o += 2
	out.resize(o)
# hex digits (either case) to bytes; false, with out unchanged, on an odd
# length or a non-hex character
hex_decode(s const byte[:], out byte[>..]&) bool:
	if s.len % 2 != 0: return false
	st := out.len
	o ~= st
	out.resize(st + s.len / 2 + 8, 0)
	i ~= 0
	while i + 8 <= s.len:
		l := load_u64le(s, i) | 0x2020202020202020
		x := l & 0x7F7F7F7F7F7F7F7F
		d := (0xB9B9B9B9B9B9B9B9 - x & ~l & x + 0x5050505050505050 | 0xE6E6E6E6E6E6E6E6 - x & ~l & x + 0x1F1F1F1F1F1F1F1F) & 0x8080808080808080
		if d != 0x8080808080808080:
			out.resize(st)
			return false
		v := (l & 0x0F0F0F0F0F0F0F0F) + (l >> 6 & 0x0101010101010101) * 9
		p := (v & 0x00FF00FF00FF00FF) << 4 | v >> 8 & 0x00FF00FF00FF00FF
		q := (p | p >> 8) & 0x0000FFFF0000FFFF
		store_u64le(out, o, (q | q >> 16) & 0xFFFFFFFF)
		i += 8
		o += 4
	while i < s.len:
		h := hexd(s[i])
		g := hexd(s[i + 1])
		if h < 0 || g < 0:
			out.resize(st)
			return false
		out[o] = (h * 16 + g) as byte
		i += 2
		o += 1
	out.resize(o)
	true
hexd(c byte) int: if c >= '0' && c <= '9' { (c - '0') as int } else if c >= 'a' && c <= 'f' { (c - 'a') as int + 10 } else if c >= 'A' && c <= 'F' { (c - 'A') as int + 10 } else { -1 }
hex(n int) byte[>..]: pyb(n, 16, "0x")
oct(n int) byte[>..]: pyb(n, 8, "0o")
bin(n int) byte[>..]: pyb(n, 2, "0b")
# divides a by k in place and returns the remainder
big_div_small(a uint[>..]&, k uint) uint:
	r ~= 0 as uint
	i ~= a.len - 1
	while i >= 0:
		cur := r << 32 | a[i]
		a[i] = cur / k
		r = cur % k
		i -= 1
	r
# v with exactly `decimals` digits after the point. Exact: the double is
# m * 2^e2, so v * 10^d is computed as a big integer and rounded half to
# even once (away from zero with away, as JavaScript's toFixed does); a
# negative count prints the shortest form instead
format_flt(out byte[>..]&, v real, decimals int, away bool = false):
	if v != v: out.append("nan"); return
	if v - v != 0.0: out.append(if v < 0.0 { "-inf" } else { "inf" }); return
	if decimals < 0: format(out, v); return
	bits := std_bits(v)
	ex := (bits >> 52 & 0x7ff) as int
	m ~= bits & 0xfffffffffffff
	e2 ~= -1074
	if ex != 0 { m = m | 1 << 52; e2 = ex - 1075 }
	n uint[>..] ~= [m & 0xffffffff, m >> 32]
	for i decimals: big_mul_add(n, 10, 0)
	if e2 >= 0:
		big_shl(n, e2)
	else:
		half ~= false; sticky ~= false
		for i -e2:
			sticky = sticky || half
			half = n[0] & 1 == 1
			big_shr1(n)
		if half && (sticky || away || n[0] & 1 == 1): big_mul_add(n, 1, 1)
	rev byte[>..] ~= []
	while true:
		rev.push(DIGITS[big_div_small(n, 10) as int])
		if big_zero(n): break
	while rev.len < decimals + 1: rev.push('0')
	if bits >> 63 == 1: out.push('-')
	k ~= rev.len
	while k > 0:
		if k == decimals: out.push('.')
		k -= 1
		out.push(rev[k])
fmt(x real, d int, away bool = false) byte[>..]:
	out byte[>..] ~= []
	format_flt(out, x, d, away)
	out
# an f-string field of width w with no alignment given: x is the value
# and t its text; strings go left, everything else right, as in Python
fstr_w(x byte[:], t byte[:], w int) byte[>..]: ljust(t, w)
fstr_w<T>(x T, t byte[:], w int) byte[>..]: rjust(t, w)

# ---- random numbers (splitmix64: a counter run through a mixer)

struct rng { s uint }
rand_u64(r rng&) uint:
	r.s = r.s + 0x9e3779b97f4a7c15
	z ~= r.s
	z = (z ^ z >> 30) * 0xbf58476d1ce4e5b9
	z = (z ^ z >> 27) * 0x94d049bb133111eb
	z ^ z >> 31
# uniform in 0..n, n > 0
rand_int(r rng&, n int) int:
	lim := n as uint
	cut := (0 as uint - lim) % lim
	while true:
		x := rand_u64(r)
		if x >= cut: return (x % lim) as int
	0
# uniform in [0, 1)
rand_flt(r rng&) real: (rand_u64(r) >> 11) as real * (1.0 / 9007199254740992.0)
shuffle<T>(xs T[:], r rng&):
	i ~= xs.len
	while i > 1:
		j := rand_int(r, i)
		i -= 1
		swap_at(xs, i, j)

extern simd256() bool = "hr_simd256"

# ---- byte sets: membership for each of the 256 byte values

struct ByteSet { members bool[256] }
byte_set(bytes byte[:]) ByteSet:
	s ~= ByteSet{[false; 256]}
	for c bytes: s.members[c] = true
	s
byte_set(members bool[256]) ByteSet: ByteSet{members}
# first position in s holding a member, or -1
find_any(s byte[:], set const ByteSet&) int:
	for c, i s: if set.members[c] { return i }
	-1
# first i with s[i] in a and s[i + d] in b, or -1
byte_set_pair(s byte[:], a const ByteSet&, d int, b const ByteSet&) int:
	i ~= 0
	while i + d < s.len:
		if a.members[s[i]] && b.members[s[i + d]]: return i
		i += 1
	-1
find_pair(s byte[:], a const ByteSet&, d int, b const ByteSet&) int: byte_set_pair(s, a, d, b)
# bit k set when s[i + k] equals one of the bytes packed in w: the low byte,
# then the next two unless bit 24 (one byte) or bit 25 (two bytes) is set
match16(s byte[:], i int, w int) int:
	n := if w >> 24 & 1 != 0 { 1 } else { if w >> 25 & 1 != 0 { 2 } else { 3 } }
	r ~= 0
	for k 16:
		c := s[i + k] as int
		hit ~= false
		for q n: hit = hit || c == w >> (8 * q) & 255
		if hit: r = r | 1 << k
	r
match32(s byte[:], i int, w int) int: match16(s, i, w) | match16(s, i + 16, w) << 16
match_set32(s byte[:], i int, set const ByteSet&) int:
	r ~= 0
	for k 32: if set.members[s[i + k]] { r = r | 1 << k }
	r

# ---- tuples (the Python dialect's tuple types; the compiler knows f0..f3)

struct tuple2<A, B> { f0 A, f1 B }
struct tuple3<A, B, C> { f0 A, f1 B, f2 C }
struct tuple4<A, B, C, D> { f0 A, f1 B, f2 C, f3 D }
tuple_lt<A, B>(a tuple2<A, B>, b tuple2<A, B>) bool:
	if a.f0 == b.f0 { a.f1 < b.f1 } else { a.f0 < b.f0 }
tuple_lt<A, B, C>(a tuple3<A, B, C>, b tuple3<A, B, C>) bool:
	if !(a.f0 == b.f0): return a.f0 < b.f0
	if !(a.f1 == b.f1): return a.f1 < b.f1
	a.f2 < b.f2
tuple_lt<A, B, C, D>(a tuple4<A, B, C, D>, b tuple4<A, B, C, D>) bool:
	if !(a.f0 == b.f0): return a.f0 < b.f0
	if !(a.f1 == b.f1): return a.f1 < b.f1
	if !(a.f2 == b.f2): return a.f2 < b.f2
	a.f3 < b.f3

# ---- Python dialect helpers

range(n int) int[>..]: range(0, n, 1)
range(a int, b int) int[>..]: range(a, b, 1)
range(a int, b int, s int) int[>..]:
	out int[>..] ~= []
	i ~= a
	while s > 0 && i < b || s < 0 && i > b:
		out.push(i)
		i += s
	out
truediv(a int, b int) real: a as real / b as real
truediv(a int, b real) real: a as real / b
truediv(a real, b int) real: a / b as real
truediv(a real, b real) real: a / b
floor_div(a real, b real) real: std_floor(a / b)
truthy(b bool) bool: b
truthy(x int) bool: x != 0
truthy(x real) bool: x != 0.0
truthy<T>(xs T[:]) bool: xs.len > 0
# Python's // and divmod round the quotient down (Helium's / truncates)
floor_div(a int, b int) int:
	q := a / b
	if q * b != a && (a < 0) != (b < 0) { q - 1 } else { q }
pydivmod(a int, b int) tuple2<int, int>:
	q := floor_div(a, b)
	tuple2<int, int>{q, a - q * b}
# round half to even, as Python's round does
pyround(x int) int: x
pyround(x real) int:
	f := std_floor(x)
	d := x - f
	if d > 0.5 || d == 0.5 && std_fabs(f - 2.0 * std_floor(f / 2.0)) == 1.0: return f as int + 1
	f as int
pyround(x real, nd int) real:
	scale ~= 1.0
	for i abs(nd): scale = scale * 10.0
	y := if nd >= 0 { x * scale } else { x / scale }
	f := std_floor(y)
	d := y - f
	r := if d > 0.5 || d == 0.5 && std_fabs(f - 2.0 * std_floor(f / 2.0)) == 1.0 { f + 1.0 } else { f }
	if nd >= 0 { r / scale } else { r * scale }
# str() of a value, the way Python prints it
pyfmt(x int) byte[>..]: str(x)
pyfmt(b bool) byte[>..]: str(if b { "True" } else { "False" })
pyfmt(c byte) byte[>..]: str(c as int)
pyfmt(s byte[:]) byte[>..]: str(s)
pyfmt(x real) byte[>..]:
	if x != x: return str("nan")
	if x - x != 0.0: return str(if x < 0.0 { "-inf" } else { "inf" })
	out byte[>..] ~= []
	format(out, x)
	if find(out[..], '.') < 0 && find(out[..], 'e') < 0 && find(out[..], 'n') < 0: out.append(".0")
	out
pyfmt<T>(xs T[:]) byte[>..]:
	out byte[>..] ~= ['[']
	for x, i xs:
		if i > 0: out.append(", ")
		out.append(pyrepr(x))
	out.push(']')
	out
pyfmt<A, B>(t tuple2<A, B>) byte[>..]: str("(", pyrepr(t.f0), ", ", pyrepr(t.f1), ")")
pyfmt<A, B, C>(t tuple3<A, B, C>) byte[>..]: str("(", pyrepr(t.f0), ", ", pyrepr(t.f1), ", ", pyrepr(t.f2), ")")
# repr(): strings get quotes, everything else prints as str() would
pyrepr(s byte[:]) byte[>..]:
	q := if contains(s, '\'') && !contains(s, '"') { '"' } else { '\'' }
	out byte[>..] ~= [q]
	for c s:
		if c == q || c == '\\' { out.push('\\'); out.push(c) }
		elif c == '\n' { out.append("\\n") }
		elif c == '\t' { out.append("\\t") }
		elif c == '\r' { out.append("\\r") }
		else { out.push(c) }
	out.push(q)
	out
pyrepr(s byte[>..]) byte[>..]: pyrepr(s[..])
pyrepr<T>(x T) byte[>..]: pyfmt(x)
# the string module's constants
STR_ascii_lowercase := "abcdefghijklmnopqrstuvwxyz"
STR_ascii_uppercase := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
STR_ascii_letters := str(STR_ascii_lowercase, STR_ascii_uppercase)
STR_digits := "0123456789"
# bisect: insertion points in a sorted slice, before or after equal values
bisect_left<T>(xs T[:], v T) int:
	lo ~= 0; hi ~= xs.len
	while lo < hi:
		m := (lo + hi) / 2
		if xs[m] < v { lo = m + 1 } else { hi = m }
	lo
bisect_right<T>(xs T[:], v T) int:
	lo ~= 0; hi ~= xs.len
	while lo < hi:
		m := (lo + hi) / 2
		if v < xs[m] { hi = m } else { lo = m + 1 }
	lo
bisect<T>(xs T[:], v T) int: bisect_right(xs, v)
