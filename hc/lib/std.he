islower(s byte[:]) bool: u ~= false; for c in s { if isupper(c) { return false }; if islower(c) { u = true } }; u
ord(c byte) int: c
ord(c int) int: c
ord(s byte[:]) int: s[0]
chr(n int) byte[>..]: o byte[>..] ~= []; o.push(n as byte); o
trim_start(s byte[:]) byte[:]: i ~= 0; while i < s.len && is_space(s[i]) { i += 1 }; s[i..]
trim_end(s byte[:]) byte[:]: e ~= s.len; while e > 0 && is_space(s[e - 1]) { e -= 1 }; s[..e]
trim(s byte[:]) byte[:]: trim_end(trim_start(s))
