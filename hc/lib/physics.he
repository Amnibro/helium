upper_suspension_limit(j WheelJoint) f32: jf(j.joint, phx::J_WHEEL, "upper_suspension_limit") { s => s.wh.usl }
set_suspension_limits(j WheelJoint, lo f32, hi f32): r_set_suspension_limits_WheelJoint(j, lo, hi); i, x := hj(j, "set_suspension_limits"); if i >= 0 { h := &phx::jsim(WS[i], x).wh; if lo != h.lsl || hi != h.usl { h.lsl = lo; h.usl = hi; h.lsi = 0.0; h.usi = 0.0 } }
enable_spin_motor(j WheelJoint, f bool): r_enable_spin_motor_WheelJoint(j, f); i, x := hj(j, "enable_spin_motor"); if i >= 0 { h := &phx::jsim(WS[i], x).wh; if f != h.spin { h.spi = 0.0 } h.spin = f }
