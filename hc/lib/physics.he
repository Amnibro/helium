enable_suspension(j WheelJoint, f bool): r_enable_suspension_WheelJoint(j, f); i, x := hj(j, "enable_suspension"); if i >= 0 { h := &phx::jsim(WS[i], x).wh; if f != h.sspring { h.sspring = f; h.ssi = 0.0 } }
