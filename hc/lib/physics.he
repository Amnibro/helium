restitution(s Shape) f32: i, x := si(s, "restitution"); if i >= 0 { WS[i].shapes[x].mats[0].rest } else { 0.0 }
set_surface_material(s Shape, m SurfaceMaterial): r_set_surface_material_Shape(s, m); i, x := si(s, "set_surface_material"); if i >= 0 { WS[i].shapes[x].mats[0] = mat_of(m) }
surface_material(s Shape) SurfaceMaterial: i, x := si(s, "surface_material"); if i >= 0 { smat(WS[i].shapes[x].mats[0]) } else { SurfaceMaterial{0.0, 0.0, 0.0, Z3, 0, 0} }
mesh_material_count(s Shape) int: i, x := si(s, "mesh_material_count"); if i >= 0 { WS[i].shapes[x].mats.len } else { 0 }
mmok(i int, x int, k int, fnm const byte[:]) bool: n := WS[i].shapes[x].mats.len; if k >= 0 && k < n { true } else { misuse(str("physics::", fnm, ": material ", k, " of ", n)) }
set_mesh_material(s Shape, m SurfaceMaterial, k int): r_set_mesh_material_Shape(s, m, k); i, x := si(s, "set_mesh_material"); if i >= 0 && mmok(i, x, k, "set_mesh_material") { WS[i].shapes[x].mats[k] = mat_of(m) }
mesh_material(s Shape, k int) SurfaceMaterial: i, x := si(s, "mesh_material"); if i >= 0 && mmok(i, x, k, "mesh_material") { smat(WS[i].shapes[x].mats[k]) } else { SurfaceMaterial{0.0, 0.0, 0.0, Z3, 0, 0} }
shape_filter(s Shape) Filter: i, x := si(s, "filter"); if i < 0 { return Filter{0, 0, 0} } f := WS[i].shapes[x].filter; Filter{f.cat, f.mask, f.group as i32}
set_shape_filter(s Shape, f Filter, inv bool):
	r_set_shape_filter_Shape(s, f, inv)
	i, x := si(s, "set_filter")
	if i < 0: return
