set_friction(s Shape, f f32): r_set_friction_Shape(s, f); i, x := si(s, "set_friction"); if i >= 0 { WS[i].shapes[x].mats[0].fr = f }
friction(s Shape) f32: i, x := si(s, "friction"); if i >= 0 { WS[i].shapes[x].mats[0].fr } else { 0.0 }
