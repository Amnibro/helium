g_Shape(r RRd&) Shape: k := g_i32(r) as int; p := &PD[CP]; if k >= 0 && k < p.shapes.len { p.shapes[k] } else { Shape{0} }
g_Joint(r RRd&) Joint: k := g_i32(r) as int; p := &PD[CP]; if k >= 0 && k < p.joints.len { p.joints[k] } else { Joint{0} }
