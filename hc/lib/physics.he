spring_damping_ratio(j DistanceJoint) f32: jf(j.joint, phx::J_DISTANCE, "spring_damping_ratio") { s => s.d.dr }
enable_limit(j DistanceJoint, f bool): r_enable_limit_DistanceJoint(j, f); i, x := dj(j, "enable_limit"); if i >= 0 { d := &phx::jsim(WS[i], x).d; d.limit = f }
