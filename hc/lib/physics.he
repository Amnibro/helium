rec_step(i int, ts f32, sub int): if rbeg(i, OP_STEP) { put(ts); put(sub as i32); rend() }
rec_post(i int): if rbeg(i, OP_HASH) { put(whash(i)); put(bounds(wof(i))); rend() }
stop_rec(i int): if rbeg(i, OP_END) { rend(); WREC[i] = -1; RON -= 1 }
