set_length_range(j DistanceJoint, lo f32, hi f32): r_set_length_range_DistanceJoint(j, lo, hi); i, x := dj(j, "set_length_range"); if i >= 0 { d := &phx::jsim(WS[i], x).d; a := phx::fclamp(lo, phx::slop(), phx::huge()); b := phx::fclamp(hi, phx::slop(), phx::huge()); d.minl = min(a, b); d.maxl = max(a, b); d.imp = 0.0; d.limp = 0.0; d.uimp = 0.0 }
min_length(j DistanceJoint) f32: jf(j.joint, phx::J_DISTANCE, "min_length") { s => s.d.minl }
max_length(j DistanceJoint) f32: jf(j.joint, phx::J_DISTANCE, "max_length") { s => s.d.maxl }
current_length(j DistanceJoint) f32: i, x := dj(j, "current_length"); if i >= 0 { phx::vlen(phx::jdp(WS[i], phx::jsim(WS[i], x))) } else { 0.0 }
enable_motor(j DistanceJoint, f bool): r_enable_motor_DistanceJoint(j, f); i, x := dj(j, "enable_motor"); if i >= 0 { d := &phx::jsim(WS[i], x).d; if f != d.motor { d.motor = f; d.mimp = 0.0 } }
motor_enabled(j DistanceJoint) bool: jb(j.joint, phx::J_DISTANCE, "motor_enabled") { s => s.d.motor }
