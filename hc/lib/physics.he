rec_body(i int, b int): r := rw(i); if r >= 0 { insert(RD[r].bm, xid(i, b, WS[i].bodies[b].gen), RD[r].nb); RD[r].nb += 1 }
rec_shape(i int, s int): r := rw(i); if r >= 0 { insert(RD[r].sm, xid(i, s, WS[i].shapes[s].gen), RD[r].ns); RD[r].ns += 1 }
rec_joint(i int, j int): r := rw(i); if r >= 0 { insert(RD[r].jm, xid(i, j, WS[i].joints[j].gen), RD[r].nj); RD[r].nj += 1 }
