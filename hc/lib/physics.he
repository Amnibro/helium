	PD[s] = pd; Player{gid(GP, s)}
pone(k int) int:
	p := &PD[k]; op := p.data[p.pos] as int; rr ~= RRd{p.data[p.pos + 1..p.pos + 5], 0}; n := g_u32(rr) as int; s := p.pos + 5; p.pos = s + n
	r ~= RRd{p.data[s..s + n], 0}; CP = k; RPL = true
	if op == OP_STEP { ts := g_f32(r); sb := g_i32(r); step(PD[k].w, ts, sb as int) } else if op == OP_HASH { if g_uint(r) != whash(PD[k].wi) { PD[k].div = true } } else if op != OP_END { rexec(op, r) }
	RPL = false; op
pmark(k int, op int, st bool&):
	if op == OP_STEP: PD[k].pre = false; PD[k].frame += 1; st = true
	if op == OP_HASH && PD[k].df < 0 && PD[k].div: PD[k].df = PD[k].frame
pstep(k int) bool:
	PD[k].pre = false
	if PD[k].end: return false
	st ~= false
	loop:
		p := &PD[k]
		if p.pos >= p.data.len: p.end = true; return st
		op := p.data[p.pos] as int
		if st && op != OP_HASH: return true
		if op == OP_END: p.pos = p.data.len; p.end = true; return st
		pmark(k, pone(k), st)
psub(k int):
	if PD[k].end: return
	st ~= false; hc ~= false
	loop:
		p := &PD[k]
		if p.pos >= p.data.len: p.end = true; p.pre = false; return
		op := p.data[p.pos] as int
		if st && op != OP_HASH: return
		if !p.pre && hc && op == OP_STEP: p.pre = true; return
		if op == OP_END: p.pos = p.data.len; p.end = true; p.pre = false; return
		pone(k)
		if op == OP_CREATE_BODY: hc = true
		pmark(k, op, st)
prestart(k int):
	pclean(k); p := &PD[k]; d ~= p.def; d.workers = p.workers as i32; WS[p.wi] = wnew(d, p.wi); WS[p.wi].crecycle = p.crec; WS[p.wi].warm = p.warm
	p.pos = p.hdr; p.frame = 0; p.df = -1; p.div = false; p.end = false; p.pre = false
destroy(p Player): k := pget(p, "destroy"); if k < 0 { return } pclean(k); destroy(PD[k].w); gfree(GP, k); PD[k] = PlayD{..}
is_valid(p Player) bool: gix(GP, p.id) >= 0
step(p Player) bool: k := pget(p, "step"); k >= 0 && pstep(k)
sub_step(p Player): k := pget(p, "sub_step"); if k >= 0 { psub(k) }
at_pre_step(p Player) bool: k := pget(p, "at_pre_step"); k >= 0 && PD[k].pre
restart(p Player): k := pget(p, "restart"); if k >= 0 { prestart(k) }
seek(p Player, f int):
	k := pget(p, "seek")
	if k < 0: return
	if f < 0 || f > PD[k].frames: misuse(str("physics::seek: frame ", f, " of a recording of ", PD[k].frames)); return
	if f < PD[k].frame || PD[k].pre: prestart(k)
	n ~= 0
	while PD[k].frame < f && pstep(k): n += 1
world(p Player) World: k := pget(p, "world"); if k >= 0 { PD[k].w } else { World{0} }
frame(p Player) int: k := pget(p, "frame"); if k >= 0 { PD[k].frame } else { 0 }
frame_count(p Player) int: k := pget(p, "frame_count"); if k >= 0 { PD[k].frames } else { 0 }
at_end(p Player) bool: k := pget(p, "at_end"); k < 0 || PD[k].end
diverged(p Player) bool: k := pget(p, "diverged"); k >= 0 && PD[k].div
diverge_frame(p Player) int: k := pget(p, "diverge_frame"); if k >= 0 { PD[k].df } else { -1 }
body_count(p Player) int: k := pget(p, "body_count"); if k >= 0 { PD[k].bodies.len } else { 0 }
body(p Player, n int) Body:
	k := pget(p, "body")
	if k < 0: return Body{0}
	if n < 0 || n >= PD[k].bodies.len: misuse(str("physics::body: body ", n, " of ", PD[k].bodies.len, " recorded")); return Body{0}
	PD[k].bodies[n]
info(p Player) PlayerInfo: k := pget(p, "info"); if k < 0 { return default<PlayerInfo>() } x := &PD[k]; PlayerInfo{x.frames as i32, x.workers as i32, x.dt, x.sub as i32, x.ls, x.bounds}
set_worker_count(p Player, n int): k := pget(p, "set_worker_count"); if k >= 0 { PD[k].workers = nworkers(n); WS[PD[k].wi].workers = PD[k].workers }
validate_replay(r Recording, workers int) bool:
	k := gget(GR, r.id, "validate_replay")
	if k < 0: return false
	if RD[k].buf.len == 0: return fail("the recording is empty")
	p := create_player(r, workers)
	if p.id == 0: return fail("the replay did not reproduce the recording")
	x := gix(GP, p.id)
	n ~= 0
	while pstep(x): n += 1
	ok := !PD[x].div; destroy(p)
	ok || fail("the replay did not reproduce the recording")
quat_axis_angle(axis float3, angle f32) Quat:
	a := ::normalize(axis)
	s := sin(angle * 0.5)
	Quat{a.x * s, a.y * s, a.z * s, cos(angle * 0.5)}
normalize(q Quat) Quat:
	l := sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
	Quat{q.x / l, q.y / l, q.z / l, q.w / l}
conjugate(q Quat) Quat: Quat{-q.x, -q.y, -q.z, q.w}
mul(a Quat, b Quat) Quat:
	Quat{a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y, a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x, a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w, a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z}
rotate(q Quat, v float3) float3:
	u := float3{q.x, q.y, q.z}
	t := cross(u, v) * float3{2.0, 2.0, 2.0}
	v + t * float3{q.w, q.w, q.w} + cross(u, t)
inv_rotate(q Quat, v float3) float3: rotate(conjugate(q), v)
rotation_matrix(q Quat) Mat3:
	Mat3{cx: rotate(q, float3{1.0, 0.0, 0.0}), cy: rotate(q, float3{0.0, 1.0, 0.0}), cz: rotate(q, float3{0.0, 0.0, 1.0})}
transform_point(t Transform, p float3) float3: rotate(t.q, p) + t.p
inv_transform_point(t Transform, p float3) float3: inv_rotate(t.q, p - t.p)
mul(a Transform, b Transform) Transform:
	Transform{p: transform_point(a, b.p), q: mul(a.q, b.q)}
inv_mul(a Transform, b Transform) Transform:
	Transform{p: inv_rotate(a.q, b.p - a.p), q: mul(conjugate(a.q), b.q)}
local_frame(b Body, world_frame Transform) Transform: inv_mul(transform(b), world_frame)
joint_def(a Body, b Body, frame Transform) JointDef:
	JointDef{body_a: a, body_b: b, frame_a: local_frame(a, frame), frame_b: local_frame(b, frame)}
joint_def(a Body, b Body, anchor float3) JointDef:
	joint_def(a, b, Transform{p: anchor, q: quat_identity})
