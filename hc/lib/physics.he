sflag(s Shape, fl int, on bool, fnm const byte[:]): i, x := si(s, fnm); if i >= 0 { WS[i].shapes[x].flags = if on { WS[i].shapes[x].flags | fl } else { WS[i].shapes[x].flags & ~fl } }
shas(s Shape, fl int, fnm const byte[:]) bool: i, x := si(s, fnm); i >= 0 && WS[i].shapes[x].flags & fl != 0
enable_sensor_events(s Shape, f bool): r_enable_sensor_events_Shape(s, f); sflag(s, phx::SF_SENSOR_EV, f, "enable_sensor_events")
sensor_events_enabled(s Shape) bool: shas(s, phx::SF_SENSOR_EV, "sensor_events_enabled")
