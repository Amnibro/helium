use os
var WS phx::World[>..] = []
var WGEN int[>..] = []
var WMAX = 0
var ERR byte[>..] = []
var MIS = 0
Z3 := float3{0.0, 0.0, 0.0}
fail(m const byte[:]) bool: ERR.clear(); ERR.append(m[..min(m.len, 1023)]); false
misuse(m const byte[:]) bool:
	fail(m)
	if RPL: return false
	MIS += 1
	if MIS <= 8: write_stderr(str("physics: ", ERR, "\n"))
	false
available() bool: true
misuse_count() int: MIS
error() byte[>..]: t byte[>..] ~= []; t.append(ERR[..]); t
check(): if MIS > 0 { abort(str("physics: ", error())) }
bad(fnm const byte[:], what const byte[:], nul bool) bool: misuse(if nul { str("physics::", fnm, ": a null ", what) } else { str("physics::", fnm, ": a ", what, " that was destroyed, or never created") })
gfmt(x f32) byte[>..]:
	o byte[>..] ~= []; v := x as real
	if v != v: o.append("nan"); return o
	if v < 0.0 || v == 0.0 && 1.0 / v < 0.0: o.push('-')
	a := abs(v)
	if a == 0.0: o.push('0'); return o
	if a > 1.7976931348623157e308: o.append("inf"); return o
	e ~= floor(log10(a)) as int; m ~= round(a / pow(10.0, (e - 5) as real))
	if m >= 1000000.0: e += 1; m = round(a / pow(10.0, (e - 5) as real))
	d byte[>..] ~= []; format_int(d, m as int, 10, 6, '0'); k ~= 6; while k > 1 && d[k - 1] == '0' { k -= 1 }
	if e < -4 || e >= 6:
		o.push(d[0]); if k > 1 { o.push('.'); o.append(d[1..k]) } o.push('e'); o.push(if e < 0 { '-' } else { '+' }); format_int(o, abs(e), 10, 2, '0'); return o
	if e >= 0 { o.append(d[..min(e + 1, 6)]); if k > e + 1 { o.push('.'); o.append(d[e + 1..k]) } } else { o.append("0."); for i -e - 1 { o.push('0') } o.append(d[..k]) }
	o
wix(id u32) int: i := (id >> 16) as int - 1; if id != 0 && i >= 0 && i < WS.len && WS[i].in_use && WGEN[i] == (id & 0xFFFF) as int { i } else { -1 }
wi(w World, fnm const byte[:]) int: i := wix(w.id); if i < 0 { bad(fnm, "world", w.id == 0) } i
wof(i int) World: World{(((i + 1) << 16) | WGEN[i]) as u32}
hix(id uint) int: ((id >> 16) & 0xFFFF) as int
xid(wi int, x int, g int) uint: ((x + 1) as uint << 32) | (wi as uint << 16) | (g & 0xFFFF) as uint
bdx(id uint) int, int:
	wi := hix(id); b := (id >> 32) as int - 1
	if id != 0 && wi < WS.len && WS[wi].in_use && b >= 0 && b < WS[wi].bodies.len && WS[wi].bodies[b].set != -1 && WS[wi].bodies[b].gen & 0xFFFF == (id & 0xFFFF) as int: return wi, b
	return -1, -1
bi(b Body, fnm const byte[:]) int, int: wi, x := bdx(b.id); if wi < 0 { bad(fnm, "body", b.id == 0) } return wi, x
bof(wi int, b int) Body: Body{xid(wi, b, WS[wi].bodies[b].gen)}
sdx(id uint) int, int:
	wi := hix(id); s := (id >> 32) as int - 1
	if id != 0 && wi < WS.len && WS[wi].in_use && s >= 0 && s < WS[wi].shapes.len && WS[wi].shapes[s].id != -1 && WS[wi].shapes[s].gen & 0xFFFF == (id & 0xFFFF) as int: return wi, s
	return -1, -1
si(s Shape, fnm const byte[:]) int, int: wi, x := sdx(s.id); if wi < 0 { bad(fnm, "shape", s.id == 0) } return wi, x
sof(wi int, s int) Shape: Shape{xid(wi, s, WS[wi].shapes[s].gen)}
jdx(id uint) int, int:
	wi := hix(id); j := (id >> 32) as int - 1
	if id != 0 && wi < WS.len && WS[wi].in_use && j >= 0 && j < WS[wi].joints.len && WS[wi].joints[j].jid != -1 && WS[wi].joints[j].gen & 0xFFFF == (id & 0xFFFF) as int: return wi, j
	return -1, -1
ji(j Joint, fnm const byte[:]) int, int: wi, x := jdx(j.id); if wi < 0 { bad(fnm, "joint", j.id == 0) } return wi, x
jof(wi int, j int) Joint: Joint{xid(wi, j, WS[wi].joints[j].gen)}
version() Version: Version{0, 2, 0}
byte_count() int:
	n ~= 0
	for w WS: if w.in_use { n += 4096 + 200 * w.bodies.len + 300 * w.shapes.len + 220 * w.contacts.len + 400 * w.joints.len + 64 * w.islands.len }
	for k GH.live.len: if GH.live[k] != 0 { n += phx::hull_bytes(HL[k]) }
	for k GM.live.len: if GM.live[k] != 0 { n += phx::mesh_bytes(phx::G_MESH[k]) }
	for k GF.live.len: if GF.live[k] != 0 { n += phx::hf_bytes(phx::G_HF[k]) }
	for k GC.live.len: if GC.live[k] != 0 { n += phx::G_CPD[k].bytes }
	n
set_length_units_per_meter(u f32):
	if !(u > 0.0) || u > 3.4028235e38: misuse(str("physics::set_length_units_per_meter: ", gfmt(u), " units")); return
	phx::LUPM = u
length_units_per_meter() f32: phx::LUPM
world_count() int: n ~= 0; for w WS { if w.in_use { n += 1 } } n
max_world_count() int: WMAX
default_world_def() WorldDef: WorldDef{}
default_body_def() BodyDef: BodyDef{}
default_shape_def() ShapeDef: ShapeDef{}
default_surface_material() SurfaceMaterial: SurfaceMaterial{}
default_filter() Filter: Filter{}
default_query_filter() QueryFilter: QueryFilter{}
default_explosion_def() ExplosionDef: ExplosionDef{}
default_distance_joint_def() DistanceJointDef: DistanceJointDef{}
default_filter_joint_def() FilterJointDef: FilterJointDef{}
default_motor_joint_def() MotorJointDef: MotorJointDef{}
default_parallel_joint_def() ParallelJointDef: ParallelJointDef{}
default_prismatic_joint_def() PrismaticJointDef: PrismaticJointDef{}
default_revolute_joint_def() RevoluteJointDef: RevoluteJointDef{}
default_spherical_joint_def() SphericalJointDef: SphericalJointDef{}
default_weld_joint_def() WeldJointDef: WeldJointDef{}
default_wheel_joint_def() WheelJointDef: WheelJointDef{}
mixok(r int, fnm const byte[:]) bool: if r >= 0 && r <= 5 { true } else { misuse(str("physics::", fnm, ": no mixing rule ", r)) }
nworkers(n int) int: max(1, min(n, 32))
create_world(d WorldDef) World:
	if !mixok(d.friction_mixing, "create_world") || !mixok(d.restitution_mixing, "create_world"): return World{0}
	n := world_count()
	if n >= 128: fail("too many worlds: Box3D keeps at most 128 at once"); return World{0}
	i ~= 0; while i < WS.len && WS[i].in_use: i += 1
	if i == WS.len { WS.push(wnew(d, i)); WGEN.push(0) } else { WS[i] = wnew(d, i) }
	WMAX = max(WMAX, n + 1); wof(i)
create_world() World: create_world(WorldDef{})
wnew(d WorldDef, i int) phx::World:
	c := d.capacity
	nw ~= phx::new_world(d.gravity, d.restitution_threshold, d.hit_event_threshold, d.contact_speed, d.contact_hertz, d.contact_damping_ratio, d.maximum_linear_speed, d.enable_sleep, d.enable_continuous, nworkers(d.workers), phx::Cap5{c.static_shapes, c.dynamic_shapes, c.static_bodies, c.dynamic_bodies, c.contacts})
	nw.fmix = d.friction_mixing; nw.rmix = d.restitution_mixing; nw.ud = d.user_data; nw.wid = i; nw
destroy(w World):
	check(); i := wi(w, "destroy")
	if i < 0: return
	stop_rec(i); WS[i] = phx::World{..}; WGEN[i] = (WGEN[i] + 1) & 0xFFFF; sweep()
is_valid(w World) bool: wix(w.id) >= 0
step(w World, ts f32, sub int):
	i := wi(w, "step")
	if i >= 0:
		if !(ts >= 0.0) || ts > 3.4028235e38 { misuse(str("physics::step: a time step of ", gfmt(ts))) } else if sub < 1 || sub > 1000 { misuse(str("physics::step: ", sub, " sub-steps")) } else { rec_step(i, ts, sub); phx::world_step(WS[i], ts, sub as int); rec_post(i) }
	check()
bounds(w World) AABB:
	i := wi(w, "bounds"); r ~= AABB{Z3, Z3}; h ~= false
	if i < 0: return r
	for t WS[i].bp.tr: if t.pcount > 0 { b := phx::tree_root_box(t); r = if h { AABB{phx::vmin(r.lower, b.lower), phx::vmax(r.upper, b.upper)} } else { b }; h = true }
	r
enable_sleeping(w World, f bool):
	r_enable_sleeping_World(w, f)
	i := wi(w, "enable_sleeping")
	if i < 0 || f == WS[i].sleep: return
	WS[i].sleep = f
	if !f: for k 3..WS[i].sets.len { if WS[i].sets[k].sims.len > 0 { phx::wake_set(WS[i], k) } }
sleeping_enabled(w World) bool: i := wi(w, "sleeping_enabled"); i >= 0 && WS[i].sleep
enable_continuous(w World, f bool): r_enable_continuous_World(w, f); i := wi(w, "enable_continuous"); if i >= 0 { WS[i].continuous = f }
continuous_enabled(w World) bool: i := wi(w, "continuous_enabled"); i >= 0 && WS[i].continuous
clampf(v f32) f32: if v > 0.0 { min(v, 3.4028235e38) } else { 0.0 }
set_restitution_threshold(w World, v f32): r_set_restitution_threshold_World(w, v); i := wi(w, "set_restitution_threshold"); if i >= 0 { WS[i].rest_th = clampf(v) }
restitution_threshold(w World) f32: i := wi(w, "restitution_threshold"); if i >= 0 { WS[i].rest_th } else { 0.0 }
set_hit_event_threshold(w World, v f32): r_set_hit_event_threshold_World(w, v); i := wi(w, "set_hit_event_threshold"); if i >= 0 { WS[i].hit_th = clampf(v) }
hit_event_threshold(w World) f32: i := wi(w, "hit_event_threshold"); if i >= 0 { WS[i].hit_th } else { 0.0 }
set_gravity(w World, g float3): r_set_gravity_World(w, g); i := wi(w, "set_gravity"); if i >= 0 { WS[i].gravity = g }
gravity(w World) float3: i := wi(w, "gravity"); if i >= 0 { WS[i].gravity } else { Z3 }
explode(w World, d ExplosionDef): r_explode_World(w, d); i := wi(w, "explode"); if i >= 0 { phx::explode(WS[i], d.position, d.radius, d.falloff, d.impulse_per_area, d.mask_bits) }
set_contact_tuning(w World, hz f32, dr f32, ps f32): r_set_contact_tuning_World(w, hz, dr, ps); i := wi(w, "set_contact_tuning"); if i >= 0 { WS[i].chz = clampf(hz); WS[i].cdr = clampf(dr); WS[i].cspeed = clampf(ps) }
set_contact_recycle_distance(w World, d f32): r_set_contact_recycle_distance_World(w, d); i := wi(w, "set_contact_recycle_distance"); if i >= 0 { WS[i].crecycle = clampf(d) }
contact_recycle_distance(w World) f32: i := wi(w, "contact_recycle_distance"); if i >= 0 { WS[i].crecycle } else { 0.0 }
set_maximum_linear_speed(w World, s f32): r_set_maximum_linear_speed_World(w, s); i := wi(w, "set_maximum_linear_speed"); if i >= 0 { WS[i].max_speed = s }
maximum_linear_speed(w World) f32: i := wi(w, "maximum_linear_speed"); if i >= 0 { WS[i].max_speed } else { 0.0 }
enable_warm_starting(w World, f bool): r_enable_warm_starting_World(w, f); i := wi(w, "enable_warm_starting"); if i >= 0 { WS[i].warm = f }
warm_starting_enabled(w World) bool: i := wi(w, "warm_starting_enabled"); i >= 0 && WS[i].warm
awake_body_count(w World) int: i := wi(w, "awake_body_count"); if i >= 0 { WS[i].sets[phx::SET_AWAKE].sims.len } else { 0 }
profile(w World) Profile: wi(w, "profile"); default<Profile>()
counters(w World) Counters:
	r ~= default<Counters>(); i := wi(w, "counters")
	if i < 0: return r
	x := &WS[i]; r.body_count = phx::id_count(x.bpool) as i32; r.shape_count = phx::id_count(x.spool) as i32; r.contact_count = phx::id_count(x.cpool) as i32; r.joint_count = phx::id_count(x.jpool) as i32; r.island_count = phx::id_count(x.ipool) as i32
	r.static_tree_height = phx::tree_height(x.bp.tr[0]) as i32; r.tree_height = max(phx::tree_height(x.bp.tr[1]), phx::tree_height(x.bp.tr[2])) as i32; r.sat_call_count = x.sat_calls as i32; r.sat_cache_hit_count = x.sat_hits as i32; r.byte_count = byte_count() as i32; r.recycled_contact_count = x.recycled as i32
	for k 8: r.manifold_counts[k] = x.mcounts[k] as i32
	for k 24: c := &x.colors[k]; n := c.convex.len + c.contacts.len; r.color_counts[k] = (n + c.jsims.len) as i32; r.awake_contact_count += n as i32
	r.awake_contact_count += x.sets[phx::SET_AWAKE].cidx.len as i32; r
max_capacity(w World) Capacity: i := wi(w, "max_capacity"); if i < 0 { return Capacity{} } c := WS[i].maxcap; Capacity{c.ss as i32, c.ds as i32, c.sb as i32, c.db as i32, c.c as i32}
set_user_data(w World, d uint): i := wi(w, "set_user_data"); if i >= 0 { WS[i].ud = d }
user_data(w World) uint: i := wi(w, "user_data"); if i >= 0 { WS[i].ud } else { 0 }
set_friction_mixing(w World, r int): r_set_friction_mixing_World(w, r); i := wi(w, "set_friction_mixing"); if i >= 0 && mixok(r, "set_friction_mixing") { WS[i].fmix = r }
set_restitution_mixing(w World, r int): r_set_restitution_mixing_World(w, r); i := wi(w, "set_restitution_mixing"); if i >= 0 && mixok(r, "set_restitution_mixing") { WS[i].rmix = r }
set_worker_count(w World, n int): i := wi(w, "set_worker_count"); if i >= 0 { WS[i].workers = nworkers(n) }
worker_count(w World) int: i := wi(w, "worker_count"); if i >= 0 { WS[i].workers } else { 0 }
XI3 := Transform{float3{0.0, 0.0, 0.0}, Quat{0.0, 0.0, 0.0, 1.0}}
M30 := Mat3{Z3, Z3, Z3}
btype_ok(t int, fnm const byte[:]) bool: if t >= 0 && t <= 2 { true } else { misuse(str("physics::", fnm, ": no body type ", t, " (STATIC, KINEMATIC or DYNAMIC)")) }
lockbits(m MotionLocks) int: (if m.linear_x { 1 } else { 0 }) | (if m.linear_y { 2 } else { 0 }) | (if m.linear_z { 4 } else { 0 }) | (if m.angular_x { 8 } else { 0 }) | (if m.angular_y { 16 } else { 0 }) | (if m.angular_z { 32 } else { 0 })
create_body(w World, d BodyDef) Body:
	r_create_body_World(w, d)
	i := wi(w, "create_body")
	if i < 0 || !btype_ok(d.body_type, "create_body"): return Body{0}
	e ~= phx::BDef{..}; e.ty = d.body_type; e.p = d.position; e.q = d.rotation; e.v = d.linear_velocity; e.w = d.angular_velocity; e.ld = d.linear_damping; e.ad = d.angular_damping; e.gs = d.gravity_scale; e.sth = d.sleep_threshold; e.safety = d.safety_factor
	e.locks = lockbits(d.motion_locks); e.sleep = d.enable_sleep; e.awake = d.is_awake; e.bullet = d.is_bullet; e.enabled = d.is_enabled; e.fast_rot = d.allow_fast_rotation; e.recycle = d.enable_contact_recycling; e.ud = d.user_data
	b := phx::create_body(WS[i], e); rec_body(i, b); bof(i, b)
destroy(b Body): r_destroy_Body(b); i, x := bi(b, "destroy"); if i >= 0 { phx::destroy_body(WS[i], x); sweep() }
is_valid(b Body) bool: i, x := bdx(b.id); i >= 0
body_type(b Body) i32: i, x := bi(b, "body_type"); if i >= 0 { WS[i].bodies[x].ty as i32 } else { 0 }
set_type(b Body, t int): r_set_type_Body(b, t); i, x := bi(b, "set_type"); if i >= 0 && btype_ok(t, "set_type") { phx::set_body_type(WS[i], x, t) }
set_name(b Body, n const byte[:]): i, x := bi(b, "set_name"); if i >= 0 { WS[i].bodies[x].name.clear(); WS[i].bodies[x].name.append(n) }
name(b Body) byte[>..]: i, x := bi(b, "name"); r byte[>..] ~= []; if i >= 0 { r.append(WS[i].bodies[x].name[..]) } r
set_user_data(b Body, d uint): i, x := bi(b, "set_user_data"); if i >= 0 { WS[i].bodies[x].ud = d }
user_data(b Body) uint: i, x := bi(b, "user_data"); if i >= 0 { WS[i].bodies[x].ud } else { 0 }
transform(b Body) Transform: i, x := bi(b, "transform"); if i >= 0 { phx::body_xf(WS[i], x) } else { XI3 }
position(b Body) float3: i, x := bi(b, "position"); if i >= 0 { phx::body_xf(WS[i], x).p } else { Z3 }
rotation(b Body) Quat: i, x := bi(b, "rotation"); if i >= 0 { phx::body_xf(WS[i], x).q } else { quat_identity }
transforms(bs const Body[:], out Transform[:]):
	if bs.len != out.len: misuse(str("physics::transforms: ", bs.len, " bodies into ", out.len, " transforms")); return
	rep ~= false
	for b, k bs:
		i, x := bdx(b.id)
		if i >= 0 { out[k] = phx::body_xf(WS[i], x) } else { out[k] = XI3; if !rep { misuse(str("physics::transforms: body ", k, " was destroyed, or never created")); rep = true } }
set_transform(b Body, p float3, q Quat): r_set_transform_Body(b, p, q); i, x := bi(b, "set_transform"); if i >= 0 { phx::set_body_xf(WS[i], x, p, q) }
local_point(b Body, p float3) float3: i, x := bi(b, "local_point"); if i >= 0 { phx::xipt(phx::body_xf(WS[i], x), p) } else { Z3 }
world_point(b Body, p float3) float3: i, x := bi(b, "world_point"); if i >= 0 { phx::xpt(phx::body_xf(WS[i], x), p) } else { Z3 }
local_vector(b Body, v float3) float3: i, x := bi(b, "local_vector"); if i >= 0 { phx::irot(phx::body_xf(WS[i], x).q, v) } else { Z3 }
world_vector(b Body, v float3) float3: i, x := bi(b, "world_vector"); if i >= 0 { phx::rot(phx::body_xf(WS[i], x).q, v) } else { Z3 }
linear_velocity(b Body) float3: i, x := bi(b, "linear_velocity"); if i >= 0 { phx::lin_vel(WS[i], x) } else { Z3 }
angular_velocity(b Body) float3: i, x := bi(b, "angular_velocity"); if i >= 0 { phx::ang_vel(WS[i], x) } else { Z3 }
set_linear_velocity(b Body, v float3): r_set_linear_velocity_Body(b, v); i, x := bi(b, "set_linear_velocity"); if i >= 0 { phx::set_lin_vel(WS[i], x, v) }
set_angular_velocity(b Body, v float3): r_set_angular_velocity_Body(b, v); i, x := bi(b, "set_angular_velocity"); if i >= 0 { phx::set_ang_vel(WS[i], x, v) }
set_target_transform(b Body, t Transform, ts f32, wake bool):
	r_set_target_transform_Body(b, t, ts, wake)
	i, x := bi(b, "set_target_transform")
	if i < 0: return
	if !(ts > 0.0) { misuse(str("physics::set_target_transform: a time step of ", gfmt(ts))) } else { phx::set_target_xf(WS[i], x, t, ts, wake) }
local_point_velocity(b Body, p float3) float3: i, x := bi(b, "local_point_velocity"); if i >= 0 { phx::local_point_vel(WS[i], x, p) } else { Z3 }
world_point_velocity(b Body, p float3) float3: i, x := bi(b, "world_point_velocity"); if i >= 0 { phx::world_point_vel(WS[i], x, p) } else { Z3 }
apply_force(b Body, f float3, p float3, wake bool): r_apply_force_Body(b, f, p, wake); i, x := bi(b, "apply_force"); if i >= 0 { phx::apply_force(WS[i], x, f, p, wake) }
apply_force_to_center(b Body, f float3, wake bool): r_apply_force_to_center_Body(b, f, wake); i, x := bi(b, "apply_force_to_center"); if i >= 0 { phx::apply_force_center(WS[i], x, f, wake) }
apply_torque(b Body, t float3, wake bool): r_apply_torque_Body(b, t, wake); i, x := bi(b, "apply_torque"); if i >= 0 { phx::apply_torque(WS[i], x, t, wake) }
apply_linear_impulse(b Body, m float3, p float3, wake bool): r_apply_linear_impulse_Body(b, m, p, wake); i, x := bi(b, "apply_linear_impulse"); if i >= 0 { phx::apply_impulse(WS[i], x, m, p, wake) }
apply_linear_impulse_to_center(b Body, m float3, wake bool): r_apply_linear_impulse_to_center_Body(b, m, wake); i, x := bi(b, "apply_linear_impulse_to_center"); if i >= 0 { phx::apply_impulse_center(WS[i], x, m, wake) }
apply_angular_impulse(b Body, m float3, wake bool): r_apply_angular_impulse_Body(b, m, wake); i, x := bi(b, "apply_angular_impulse"); if i >= 0 { phx::apply_ang_impulse(WS[i], x, m, wake) }
mass(b Body) f32: i, x := bi(b, "mass"); if i >= 0 { WS[i].bodies[x].mass } else { 0.0 }
rotational_inertia(b Body) Mat3: i, x := bi(b, "rotational_inertia"); if i >= 0 { WS[i].bodies[x].inertia } else { M30 }
inverse_mass(b Body) f32: i, x := bi(b, "inverse_mass"); if i >= 0 { phx::bsim(WS[i], x).im } else { 0.0 }
world_inverse_inertia(b Body) Mat3: i, x := bi(b, "world_inverse_inertia"); if i >= 0 { phx::bsim(WS[i], x).iiw } else { M30 }
local_center(b Body) float3: i, x := bi(b, "local_center"); if i >= 0 { phx::bsim(WS[i], x).lc } else { Z3 }
world_center(b Body) float3: i, x := bi(b, "world_center"); if i >= 0 { phx::bsim(WS[i], x).c } else { Z3 }
set_mass_data(b Body, d MassData):
	r_set_mass_data_Body(b, d)
	i, x := bi(b, "set_mass_data")
	if i < 0: return
	if WS[i].bodies[x].ty != phx::BODY_DYNAMIC { misuse("physics::set_mass_data: only a dynamic body has a mass") } else if !(d.mass > 0.0) || d.mass > 3.4028235e38 { misuse(str("physics::set_mass_data: a mass of ", gfmt(d.mass))) } else { phx::set_mass_data(WS[i], x, d) }
mass_data(b Body) MassData: i, x := bi(b, "mass_data"); if i >= 0 { MassData{WS[i].bodies[x].mass, phx::bsim(WS[i], x).lc, WS[i].bodies[x].inertia} } else { MassData{0.0, Z3, M30} }
apply_mass_from_shapes(b Body): r_apply_mass_from_shapes_Body(b); i, x := bi(b, "apply_mass_from_shapes"); if i >= 0 { phx::update_mass(WS[i], x) }
set_linear_damping(b Body, d f32): r_set_linear_damping_Body(b, d); i, x := bi(b, "set_linear_damping"); if i >= 0 { phx::bsim(WS[i], x).ld = d }
linear_damping(b Body) f32: i, x := bi(b, "linear_damping"); if i >= 0 { phx::bsim(WS[i], x).ld } else { 0.0 }
set_angular_damping(b Body, d f32): r_set_angular_damping_Body(b, d); i, x := bi(b, "set_angular_damping"); if i >= 0 { phx::bsim(WS[i], x).ad = d }
angular_damping(b Body) f32: i, x := bi(b, "angular_damping"); if i >= 0 { phx::bsim(WS[i], x).ad } else { 0.0 }
set_gravity_scale(b Body, s f32): r_set_gravity_scale_Body(b, s); i, x := bi(b, "set_gravity_scale"); if i >= 0 { phx::bsim(WS[i], x).gs = s }
gravity_scale(b Body) f32: i, x := bi(b, "gravity_scale"); if i >= 0 { phx::bsim(WS[i], x).gs } else { 0.0 }
is_awake(b Body) bool: i, x := bi(b, "is_awake"); i >= 0 && WS[i].bodies[x].set == phx::SET_AWAKE
set_awake(b Body, a bool): r_set_awake_Body(b, a); i, x := bi(b, "set_awake"); if i >= 0 { phx::set_awake(WS[i], x, a) }
enable_sleep(b Body, f bool): r_enable_sleep_Body(b, f); i, x := bi(b, "enable_sleep"); if i >= 0 { phx::enable_sleep(WS[i], x, f) }
sleep_enabled(b Body) bool: i, x := bi(b, "sleep_enabled"); i >= 0 && WS[i].bodies[x].flags & phx::BF_SLEEP != 0
set_sleep_threshold(b Body, t f32): r_set_sleep_threshold_Body(b, t); i, x := bi(b, "set_sleep_threshold"); if i >= 0 { WS[i].bodies[x].sth = t }
sleep_threshold(b Body) f32: i, x := bi(b, "sleep_threshold"); if i >= 0 { WS[i].bodies[x].sth } else { 0.0 }
set_safety_factor(b Body, f f32): r_set_safety_factor_Body(b, f); i, x := bi(b, "set_safety_factor"); if i >= 0 { WS[i].bodies[x].safety = f }
safety_factor(b Body) f32: i, x := bi(b, "safety_factor"); if i >= 0 { WS[i].bodies[x].safety } else { 0.0 }
is_enabled(b Body) bool: i, x := bi(b, "is_enabled"); i >= 0 && WS[i].bodies[x].set != phx::SET_DISABLED
disable(b Body): r_disable_Body(b); i, x := bi(b, "disable"); if i >= 0 { phx::disable_body(WS[i], x) }
enable(b Body): i, x := bi(b, "enable"); if i >= 0 { phx::enable_body(WS[i], x) }
set_motion_locks(b Body, m MotionLocks): r_set_motion_locks_Body(b, m); i, x := bi(b, "set_motion_locks"); if i >= 0 { phx::set_locks(WS[i], x, lockbits(m)) }
motion_locks(b Body) MotionLocks: i, x := bi(b, "motion_locks"); f := if i >= 0 { WS[i].bodies[x].flags } else { 0 }; MotionLocks{f & 1 != 0, f & 2 != 0, f & 4 != 0, f & 8 != 0, f & 16 != 0, f & 32 != 0}
bflag(b Body, fl int, on bool, fnm const byte[:]): i, x := bi(b, fnm); if i >= 0 { phx::set_body_flag(WS[i], x, fl, on) }
bhas(b Body, fl int, fnm const byte[:]) bool: i, x := bi(b, fnm); i >= 0 && WS[i].bodies[x].flags & fl != 0
set_bullet(b Body, f bool): r_set_bullet_Body(b, f); bflag(b, phx::BF_BULLET, f, "set_bullet")
is_bullet(b Body) bool: bhas(b, phx::BF_BULLET, "is_bullet")
allow_fast_rotation(b Body, f bool): bflag(b, phx::BF_FAST_ROT, f, "allow_fast_rotation")
fast_rotation_allowed(b Body) bool: bhas(b, phx::BF_FAST_ROT, "fast_rotation_allowed")
enable_contact_recycling(b Body, f bool): r_enable_contact_recycling_Body(b, f); bflag(b, phx::BF_RECYCLE, f, "enable_contact_recycling")
contact_recycling_enabled(b Body) bool: bhas(b, phx::BF_RECYCLE, "contact_recycling_enabled")
enable_hit_events(b Body, f bool): r_enable_hit_events_Body(b, f); i, x := bi(b, "enable_hit_events"); if i >= 0 { phx::enable_hit_events(WS[i], x, f) }
world(b Body) World: i, x := bi(b, "world"); if i >= 0 { wof(i) } else { World{0} }
shape_count(b Body) int: i, x := bi(b, "shape_count"); if i >= 0 { WS[i].bodies[x].scount } else { 0 }
shapes(b Body) Shape[>..]: i, x := bi(b, "shapes"); r Shape[>..] ~= []; if i >= 0 { for s phx::slist(WS[i], x) { r.push(sof(i, s)) } } r
joint_count(b Body) int: i, x := bi(b, "joint_count"); if i >= 0 { WS[i].bodies[x].jcount } else { 0 }
joints(b Body) Joint[>..]: i, x := bi(b, "joints"); r Joint[>..] ~= []; if i >= 0 { for j phx::jlist(WS[i], x) { r.push(jof(i, j)) } } r
aabb(b Body) AABB:
	i, x := bi(b, "aabb")
	if i < 0: return AABB{Z3, Z3}
	ss := phx::slist(WS[i], x)
	if ss.len == 0: p := phx::body_xf(WS[i], x).p; return AABB{p, p}
	r ~= WS[i].shapes[ss[0]].aabb; for s ss { a := WS[i].shapes[s].aabb; r = AABB{phx::vmin(r.lower, a.lower), phx::vmax(r.upper, a.upper)} } r
min_extent(b Body) f32: i, x := bi(b, "min_extent"); if i >= 0 { phx::bsim(WS[i], x).minx } else { 0.0 }
max_extent(b Body) float3: i, x := bi(b, "max_extent"); if i >= 0 { phx::bsim(WS[i], x).maxx } else { Z3 }
max_extent_origin(b Body) float3: i, x := bi(b, "max_extent_origin"); if i >= 0 { s := phx::bsim(WS[i], x); s.maxx + phx::vabs(s.lc) } else { Z3 }
mat_of(m SurfaceMaterial) phx::Mat: phx::Mat{m.friction, m.restitution, m.rolling_resistance, m.tangent_velocity, m.user_material_id, m.custom_color}
smat(m phx::Mat) SurfaceMaterial: SurfaceMaterial{m.fr, m.rest, m.roll, m.tv, m.uid, m.color}
sdef_of(d ShapeDef) phx::SDef:
	e ~= phx::SDef{..}; e.base = mat_of(d.material); e.den = d.density; e.filter = phx::Filter3{d.filter.category_bits, d.filter.mask_bits, d.filter.group_index as int}; e.sensor = d.is_sensor; e.sensor_ev = d.enable_sensor_events; e.contact_ev = d.enable_contact_events
	e.hit_ev = d.enable_hit_events; e.invoke = d.invoke_contact_creation; e.update_mass = d.update_body_mass; e.speculative = d.enable_speculative_contact; e.exs = d.explosion_scale; e.ud = d.user_data; e
fin3(v float3) bool: v.x - v.x == 0.0 && v.y - v.y == 0.0 && v.z - v.z == 0.0
sstart(b Body, d ShapeDef, fnm const byte[:]) int, int:
	i, x := bi(b, fnm)
	if i < 0: return -1, -1
	if !(d.density >= 0.0) || d.density > 3.4028235e38: misuse(str("physics::", fnm, ": a density of ", gfmt(d.density))); return -1, -1
	if !(d.material.friction >= 0.0) || !(d.material.restitution >= 0.0): misuse(str("physics::", fnm, ": a friction of ", gfmt(d.material.friction), " and a restitution of ", gfmt(d.material.restitution))); return -1, -1
	return i, x
radok(r f32, fnm const byte[:]) bool: if r >= 0.0 && r <= 3.4028235e38 { true } else { misuse(str("physics::", fnm, ": a radius of ", gfmt(r))) }
scaleok(s float3, fnm const byte[:]) bool: if fin3(s) && s.x != 0.0 && s.y != 0.0 && s.z != 0.0 { true } else { misuse(str("physics::", fnm, ": a scale of ", gfmt(s.x), ", ", gfmt(s.y), ", ", gfmt(s.z))) }
staticok(i int, x int, fnm const byte[:], what const byte[:]) bool: if WS[i].bodies[x].ty == phx::BODY_STATIC { true } else { misuse(str("physics::", fnm, ": ", what, " shapes go on static bodies only")) }
mkshape(i int, s int) Shape: if s < 0 { Shape{0} } else { rec_shape(i, s); sof(i, s) }
create_sphere_shape(b Body, d ShapeDef, s Sphere) Shape: r_create_sphere_shape_Body(b, d, s); i, x := sstart(b, d, "create_sphere_shape"); if i < 0 || !radok(s.radius, "create_sphere_shape") { return Shape{0} } e ~= sdef_of(d); mkshape(i, phx::create_sphere_shape(WS[i], x, e, s))
create_capsule_shape(b Body, d ShapeDef, c Capsule) Shape: r_create_capsule_shape_Body(b, d, c); i, x := sstart(b, d, "create_capsule_shape"); if i < 0 || !radok(c.radius, "create_capsule_shape") { return Shape{0} } e ~= sdef_of(d); mkshape(i, phx::create_capsule_shape(WS[i], x, e, c))
create_box_shape(b Body, d ShapeDef, h float3, f Transform) Shape:
	r_create_box_shape_Body(b, d, h, f)
	i, x := sstart(b, d, "create_box_shape")
	if i < 0: return Shape{0}
	if !fin3(h) || !(h.x > 0.0) || !(h.y > 0.0) || !(h.z > 0.0): misuse(str("physics::create_box_shape: half extents of ", gfmt(h.x), ", ", gfmt(h.y), ", ", gfmt(h.z))); return Shape{0}
	e ~= sdef_of(d); hd ~= phx::box_hull(h.x, h.y, h.z, f); mkshape(i, phx::create_hull_shape(WS[i], x, e, hd))
create_box_shape(b Body, d ShapeDef, h float3) Shape: create_box_shape(b, d, h, transform_identity)
create_hull_shape(b Body, d ShapeDef, h Hull) Shape: r_create_hull_shape_Body(b, d, h); i, x := sstart(b, d, "create_hull_shape"); if i < 0 { return Shape{0} } k := gget(GH, h.id, "create_hull_shape"); if k < 0 { return Shape{0} } e ~= sdef_of(d); mkshape(i, phx::create_hull_shape(WS[i], x, e, HL[k]))
create_transformed_hull_shape(b Body, d ShapeDef, h Hull, t Transform, sc float3) Shape:
	r_create_transformed_hull_shape_Body(b, d, h, t, sc)
	i, x := sstart(b, d, "create_transformed_hull_shape")
	if i < 0: return Shape{0}
	k := gget(GH, h.id, "create_transformed_hull_shape")
	if k < 0 || !scaleok(sc, "create_transformed_hull_shape"): return Shape{0}
	hd, ok := phx::clone_xform_hull(HL[k], t, sc)
	if !ok: fail("the transformed hull is degenerate"); return Shape{0}
	e ~= sdef_of(d); mkshape(i, phx::create_hull_shape(WS[i], x, e, hd))
matsok(ms const SurfaceMaterial[:], e phx::SDef&, fnm const byte[:]) bool:
	if ms.len > 255: return misuse(str("physics::", fnm, ": ", ms.len, " materials (at most 255)"))
	for m ms: e.mats.push(mat_of(m))
	true
create_mesh_shape(b Body, d ShapeDef, m Mesh, sc float3, ms const SurfaceMaterial[:]) Shape:
