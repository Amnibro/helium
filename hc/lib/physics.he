struct Counters { body_count i32, shape_count i32, contact_count i32, joint_count i32, island_count i32, stack_used i32, arena_capacity i32, static_tree_height i32, tree_height i32, sat_call_count i32, sat_cache_hit_count i32, byte_count i32, task_count i32, color_counts i32[24], manifold_counts i32[8], awake_contact_count i32, recycled_contact_count i32, distance_iterations i32, push_back_iterations i32, root_iterations i32 }
