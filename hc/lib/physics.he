destroy(s Shape, upd bool): r_destroy_Shape(s, upd); i, x := si(s, "destroy"); if i >= 0 { phx::destroy_shape(WS[i], x, upd); sweep() }
destroy(s Shape): destroy(s, true)
is_valid(s Shape) bool: i, x := sdx(s.id); i >= 0
shape_type(s Shape) i32: i, x := si(s, "shape_type"); if i >= 0 { WS[i].shapes[x].ty as i32 } else { 0 }
body(s Shape) Body: i, x := si(s, "body"); if i >= 0 { bof(i, WS[i].shapes[x].bid) } else { Body{0} }
world(s Shape) World: i, x := si(s, "world"); if i >= 0 { wof(i) } else { World{0} }
is_sensor(s Shape) bool: i, x := si(s, "is_sensor"); i >= 0 && WS[i].shapes[x].sensor != -1
