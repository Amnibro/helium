size(r Recording) int: k := gget(GR, r.id, "size"); if k >= 0 { RD[k].buf.len } else { 0 }
bytes(r Recording) byte[>..]: k := gget(GR, r.id, "bytes"); o byte[>..] ~= []; if k >= 0 { o.append(RD[k].buf[..]) } o
