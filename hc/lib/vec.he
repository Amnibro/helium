use math
struct vec2<T> { x T, y T }
struct vec3<T> { x T, y T, z T }
struct vec4<T> { x T, y T, z T, w T }
type float2 = vec2<f32>; type float3 = vec3<f32>; type float4 = vec4<f32>
type double2 = vec2<real>; type double3 = vec3<real>; type double4 = vec4<real>
type int2 = vec2<i32>; type int3 = vec3<i32>; type int4 = vec4<i32>
float2_0 := float2{0.0, 0.0}; float2_1 := float2{1.0, 1.0}; float3_0 := float3{0.0, 0.0, 0.0}; float3_1 := float3{1.0, 1.0, 1.0}; float4_0 := float4{0.0, 0.0, 0.0, 0.0}; float4_1 := float4{1.0, 1.0, 1.0, 1.0}
double2_0 := double2{0.0, 0.0}; double2_1 := double2{1.0, 1.0}; double3_0 := double3{0.0, 0.0, 0.0}; double3_1 := double3{1.0, 1.0, 1.0}; double4_0 := double4{0.0, 0.0, 0.0, 0.0}; double4_1 := double4{1.0, 1.0, 1.0, 1.0}
int2_0 := int2{0, 0}; int2_1 := int2{1, 1}; int3_0 := int3{0, 0, 0}; int3_1 := int3{1, 1, 1}; int4_0 := int4{0, 0, 0, 0}; int4_1 := int4{1, 1, 1, 1}
dot<T>(a vec2<T>, b vec2<T>) T: a.x * b.x + a.y * b.y
dot<T>(a vec3<T>, b vec3<T>) T: a.x * b.x + a.y * b.y + a.z * b.z
dot<T>(a vec4<T>, b vec4<T>) T: a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
cross<T>(a vec3<T>, b vec3<T>) vec3<T>: vec3<T>{a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x}
length_sq<T>(v vec2<T>) T: dot(v, v)
length_sq<T>(v vec3<T>) T: dot(v, v)
length_sq<T>(v vec4<T>) T: dot(v, v)
length<T>(v vec2<T>) T: sqrt(length_sq(v))
length<T>(v vec3<T>) T: sqrt(length_sq(v))
length<T>(v vec4<T>) T: sqrt(length_sq(v))
normalize<T>(v vec2<T>) vec2<T>: v / length(v)
normalize<T>(v vec3<T>) vec3<T>: v / length(v)
normalize<T>(v vec4<T>) vec4<T>: v / length(v)
distance<T>(a vec2<T>, b vec2<T>) T: length(a - b)
distance<T>(a vec3<T>, b vec3<T>) T: length(a - b)
distance<T>(a vec4<T>, b vec4<T>) T: length(a - b)
lerp<T>(a vec2<T>, b vec2<T>, t T) vec2<T>: a + (b - a) * t
lerp<T>(a vec3<T>, b vec3<T>, t T) vec3<T>: a + (b - a) * t
lerp<T>(a vec4<T>, b vec4<T>, t T) vec4<T>: a + (b - a) * t
xy<T>(v vec3<T>) vec2<T>: vec2<T>{v.x, v.y}
xy<T>(v vec4<T>) vec2<T>: vec2<T>{v.x, v.y}
xyz<T>(v vec4<T>) vec3<T>: vec3<T>{v.x, v.y, v.z}
