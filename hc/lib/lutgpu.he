		if LOG: nf ~= 0; fl := ffi::bytes(fa, n * 4); for i n { if g32(fl[..], i * 4) != 0 { nf++ } } write_stderr(str("gpu fill ", n, " entries (", nf, " left to the CPU): device ", ((t1 - t0) * 1000.0) as! int, " ms, pipeline ", ((t2 - t1) * 1000.0) as! int, " ms, run ", ((clock() - t2) * 1000.0) as! int, " ms\n"))
