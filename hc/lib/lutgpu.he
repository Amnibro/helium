		cbi := zb(32); p32(cbi, 0, 40); p64(cbi, 16, cp); p32(cbi, 28, 1); if vk_acb(DEV, pt(cbi[..]), pt(o[..])) != 0 { break } cb := g64(o[..], 0)
		cbl := zb(8); p64(cbl, 0, cb); dl := zb(8); p64(dl, 0, ds); bgi := zb(32); p32(bgi, 0, 42); p32(bgi, 16, 1); si := zb(72); p32(si, 0, 4); p32(si, 40, 1); p64(si, 48, pt(cbl[..]))
