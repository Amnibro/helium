pt(b const byte[:]) uint: ffi::ptr(b)
init() bool:
	if STATE != 0: return STATE == 1
	STATE = 2; want byte[>..] ~= []; env("HELIUM_GPU", want); LOG = env_set("HELIUM_GPU_LOG"); if want[..] == "off": return false
	c_setenv(pt("MESA_VK_IGNORE_CONFORMANCE_WARNING\0"), pt("1\0"), 0); nm := "helium\0"; app := zb(48); p64(app, 16, pt(nm)); p32(app, 24, 1); p64(app, 32, pt(nm)); p32(app, 40, 1); p32(app, 44, 1 << 22 | 1 << 12)
