		w := zb(128); for k 2 { p32(w, k * 64, 35); p64(w, k * 64 + 16, ds); p32(w, k * 64 + 24, k); p32(w, k * 64 + 32, 1); p32(w, k * 64 + 36, 7); p64(w, k * 64 + 48, pt(bi[..]) + (k * 24) as uint) }
		vk_uds(DEV, 2, pt(w[..]), 0, 0)
