# json: writing JSON text, a pull reader, and a small document tree.
namespace json
use std

# ---- writing

HEXCHARS := "0123456789abcdef"

# s with the escapes JSON needs: quote, backslash and control bytes
format_escaped(out byte[>..]&, s byte[:]):
	i ~= 0
	while i < s.len:
		j ~= i
		while j < s.len && s[j] >= 0x20 && s[j] != '"' && s[j] != '\\': j += 1
		if j > i: out.append(s[i..j])
		if j >= s.len: return
		c := s[j]
		i = j + 1
		if c == '"': out.append("\\\"")
		else if c == '\\': out.append("\\\\")
		else if c == '\n': out.append("\\n")
		else if c == '\r': out.append("\\r")
		else if c == '\t': out.append("\\t")
		else if c == 8: out.append("\\b")
		else if c == 12: out.append("\\f")
		else if c < 0x20:
			out.append("\\u00")
			out.push(HEXCHARS[(c >> 4) as int])
			out.push(HEXCHARS[(c & 15) as int])
format_string(out byte[>..]&, s byte[:]):
	out.push('"')
	format_escaped(out, s)
	out.push('"')
# a member name and its colon
format_key(out byte[>..]&, key byte[:]):
	format_string(out, key)
	out.push(':')
format_bool(out byte[>..]&, b bool): out.append(if b { "true" } else { "false" })
format_null(out byte[>..]&): out.append("null")
format_int(out byte[>..]&, v int): format(out, v)

# the shortest digits that read back as v (no sign, no zeros at the end)
# and the power of ten after the first of them: v = d.ddd * 10^e
DIG2 := "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"
digits_of(v real, digits byte[>..]&) int:
	digits.clear()
	x ~= 0
	m ~= float_dec(v, x)
	if m == 0:
		digits.push('0')
		return 0
	var t byte[24]
	k ~= 24
	while m >= 100:
		q := m / 100
		r := (m - q * 100) as int
		k -= 2
		t[k] = DIG2[2 * r]
		t[k + 1] = DIG2[2 * r + 1]
		m = q
	if m >= 10:
		k -= 2
		t[k] = DIG2[2 * m as int]
		t[k + 1] = DIG2[2 * m as int + 1]
	else:
		k -= 1
		t[k] = (48 + m as int) as byte
	e := 24
	while t[e - 1] == '0': e -= 1
	digits.append(t[k..e])
	x + 23 - k

# a finite number in its shortest exact form: plain decimals for 1e-5 up to
# 1e16, with ".0" on whole values, and d.ddde<n> outside that range (d.ddde+<n>
# for positive n with plus_exp, as serde_json writes it). JSON has
# no NaN or infinity, so those come out as null
strip_zeros(m0 u64, x int&) u64:
	r0 := m0 * 0xCCCCCCCCCCCCCCCD
	if (r0 >> 1 | r0 << 63) > 1844674407370955161: return m0
	m ~= m0
	r ~= m * 0xE4A4D1417CD9A041
	r = r >> 16 | r << 48
	if r <= 1844: m = r; x += 16
	r = m * 0xC767074B22E90E21
	r = r >> 8 | r << 56
	if r <= 184467440737: m = r; x += 8
	r = m * 0xD288CE703AFB7E91
	r = r >> 4 | r << 60
	if r <= 1844674407370955: m = r; x += 4
	r = m * 0x8F5C28F5C28F5C29
	r = r >> 2 | r << 62
	if r <= 184467440737095516: m = r; x += 2
	r = m * 0xCCCCCCCCCCCCCCCD
	r = r >> 1 | r << 63
	if r <= 1844674407370955161: m = r; x += 1
	m
P10D u64[20] := [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000, 10000000000, 100000000000, 1000000000000, 10000000000000, 100000000000000, 1000000000000000, 10000000000000000, 100000000000000000, 1000000000000000000, 10000000000000000000]
dlen17(v u64) int:
	b := 64 - clz(v)
	n := (b * 1233) >> 12
	n + (if v >= P10D[n] { 1 } else { 0 })
swar8(x u64) u64:
	v := x / 10000 | (x % 10000) << 32
	q := (v * 10486 >> 20) & 0x7F0000007F
	v2 := q | (v - q * 100) << 16
	t := (v2 * 103 >> 10) & 0xF000F000F000F
	(t | (v2 - t * 10) << 8) + 0x3030303030303030
format_number(out byte[>..]&, v real, plus_exp bool = false):
	if v != v || v - v != 0.0:
		out.append("null")
		return
	neg := std_bits(v) >> 63 == 1
	if v == 0.0:
		out.append(if neg { "-0.0" } else { "0.0" })
		return
	x ~= 0
	m ~= float_dec(v, x)
	m = strip_zeros(m, x)
	nd := dlen17(m)
	e := x + nd - 1
	var o byte[64]
	if nd <= 8:
		store_u64le(o, 32, swar8(m))
	else:
		hi := m / 100000000
		h1 := hi / 100000000
		store_u64le(o, 24, swar8(hi - h1 * 100000000))
		store_u64le(o, 32, swar8(m - hi * 100000000))
		o[23] = (48 + h1 as int) as byte
	a ~= 40 - nd
	z ~= 40
	if e < -5 || e >= 16:
		a -= 1
		o[a] = o[a + 1]
		if nd > 1 { o[a + 1] = '.' } else { z = a + 1 }
		o[z] = 'e'
		z += 1
		ae ~= e
		if e < 0:
			o[z] = '-'
			z += 1
			ae = -e
		else if plus_exp:
			o[z] = '+'
			z += 1
		if ae >= 100:
			o[z] = (48 + ae / 100) as byte
			z += 1
		if ae >= 10:
			o[z] = (48 + ae / 10 % 10) as byte
			z += 1
		o[z] = (48 + ae % 10) as byte
		z += 1
	else if e < 0:
		for j -1 - e:
			a -= 1
			o[a] = '0'
		a -= 2
		o[a] = '0'
		o[a + 1] = '.'
	else if nd <= e + 1:
		store_u64le(o, 40, 0x3030303030303030)
		store_u64le(o, 48, 0x3030303030303030)
		z += e + 1 - nd
		o[z] = '.'
		o[z + 1] = '0'
		z += 2
	else:
		for j e + 1: o[a - 1 + j] = o[a + j]
		a -= 1
		o[a + e + 1] = '.'
	if neg:
		a -= 1
		o[a] = '-'
	out.append(o[a..z])

# ---- reading, one value at a time
#
#   r ~= json::reader(text)
#   json::each_member(r) { key => if key == "n" { n = json::read_int(r) } else { json::skip_value(r) } }
#   if !json::finish(r): print(json::message(r))
#
# The first problem is kept with its byte offset; after it every read
# returns a zero value and the loops end.

struct Reader { text const byte[:], pos int = 0, error byte[>..] = [], error_at int = -1, key byte[>..] = [] }

reader(text const byte[:]) Reader: Reader{text: text}
ok(r Reader&) bool: r.error_at < 0
fail(r Reader&, what const byte[:]):
	if r.error_at < 0:
		r.error.append(what)
		r.error_at = r.pos
	r.pos = r.text.len
message(r Reader&) byte[>..]: str("json: ", r.error[..], " at byte ", r.error_at)
white(c byte) bool: c == ' ' || c == '\t' || c == '\n' || c == '\r'
# the next byte that is not white space, or 0 at the end
peek(r Reader&) byte:
	while r.pos < r.text.len && white(r.text[r.pos]): r.pos += 1
	if r.pos < r.text.len { r.text[r.pos] } else { 0 }
# true when the text held one value and nothing after it
finish(r Reader&) bool:
	if ok(r) && peek(r) != 0: fail(r, "text after the value")
	ok(r)
expect(r Reader&, c byte) bool:
	if peek(r) != c:
		m byte[>..] ~= []
		m.append("expected '")
		m.push(c)
		m.push('\'')
		fail(r, m[..])
		return false
	r.pos += 1
	true
literal(r Reader&, word const byte[:]) bool:
	peek(r)
	if r.pos + word.len <= r.text.len && r.text[r.pos..r.pos + word.len] == word:
		r.pos += word.len
		return true
	fail(r, "expected a value")
	false

# the extent of a number at r.pos by the JSON grammar; the end and whether
# it had a fraction or exponent, or -1 when there is no number
number_end(r Reader&) int, bool:
	t := r.text
	i ~= r.pos
	if i < t.len && t[i] == '-': i += 1
	if i >= t.len || t[i] < '0' || t[i] > '9': return -1, false
	if t[i] == '0':
		i += 1
	else:
		while i < t.len && t[i] >= '0' && t[i] <= '9': i += 1
	real_form ~= false
	if i < t.len && t[i] == '.':
		i += 1
		real_form = true
		if i >= t.len || t[i] < '0' || t[i] > '9': return -1, false
		while i < t.len && t[i] >= '0' && t[i] <= '9': i += 1
	if i < t.len && (t[i] == 'e' || t[i] == 'E'):
		i += 1
		real_form = true
		if i < t.len && (t[i] == '+' || t[i] == '-'): i += 1
		if i >= t.len || t[i] < '0' || t[i] > '9': return -1, false
		while i < t.len && t[i] >= '0' && t[i] <= '9': i += 1
	return i, real_form

read_number(r Reader&) real:
	peek(r)
	e, fr := number_end(r)
	if e < 0:
		fail(r, "expected a number")
		return 0.0
	v, good := parse_flt(r.text[r.pos..e])
	r.pos = e
	v
# a number written as a whole value that fits in an int
read_int(r Reader&) int:
	peek(r)
	e, fr := number_end(r)
	if e < 0 || fr:
		fail(r, "expected an integer")
		return 0
	v, good := parse_int(r.text[r.pos..e])
	if !good:
		fail(r, "integer out of range")
		return 0
	r.pos = e
	v
read_bool(r Reader&) bool:
	c := peek(r)
	if c == 't': return literal(r, "true")
	if c == 'f': literal(r, "false"); return false
	fail(r, "expected true or false")
	false
read_null(r Reader&) bool: literal(r, "null")

hex4(t byte[:], at int) int:
	if at + 4 > t.len: return -1
	v ~= 0
	for k 4:
		c := t[at + k]
		d := if c >= '0' && c <= '9' { (c - '0') as int } else if c >= 'a' && c <= 'f' { (c - 'a') as int + 10 } else if c >= 'A' && c <= 'F' { (c - 'A') as int + 10 } else { -1 }
		if d < 0: return -1
		v = v * 16 + d
	v

# decodes the string at r.pos into into (cleared first); false on a problem
decode(r Reader&, into byte[>..]&) bool:
	into.clear()
	if !expect(r, '"'): return false
	t := r.text
	while true:
		if r.pos >= t.len:
			fail(r, "unclosed string")
			return false
		c := t[r.pos]
		if c == '"':
			r.pos += 1
			return true
		if c < 0x20:
			fail(r, "control byte in a string")
			return false
		if c != '\\':
			into.push(c)
			r.pos += 1
			continue
		if r.pos + 1 >= t.len:
			fail(r, "unclosed string")
			return false
		e := t[r.pos + 1]
		r.pos += 2
		if e == '"' || e == '\\' || e == '/': into.push(e)
		else if e == 'n': into.push('\n')
		else if e == 't': into.push('\t')
		else if e == 'r': into.push('\r')
		else if e == 'b': into.push(8)
		else if e == 'f': into.push(12)
		else if e == 'u':
			cp ~= hex4(t, r.pos)
			if cp < 0:
				fail(r, "bad \\u escape")
				return false
			r.pos += 4
			if cp >= 0xD800 && cp < 0xDC00 && r.pos + 1 < t.len && t[r.pos] == '\\' && t[r.pos + 1] == 'u':
				lo := hex4(t, r.pos + 2)
				if lo >= 0xDC00 && lo < 0xE000:
					cp = 0x10000 + (cp - 0xD800) * 0x400 + (lo - 0xDC00)
					r.pos += 6
			push_utf8(into, cp)
		else:
			fail(r, "bad escape")
			return false
	false

# the string at r.pos, decoded into scratch
read_string(r Reader&, scratch byte[>..]&) const byte[:]:
	decode(r, scratch)
	scratch[..]

# calls the block with each member name of an object; the block reads or
# skips the value
each_member<F>(r Reader&):
	if !expect(r, '{'): return
	if peek(r) == '}':
		r.pos += 1
		return
	name byte[>..] ~= []
	while ok(r):
		if !decode(r, name) || !expect(r, ':'): return
		at := r.pos
		F(name[..])
		if r.pos == at && ok(r): skip_value(r)
		c := peek(r)
		r.pos += 1
		if c == '}': return
		if c != ',':
			r.pos -= 1
			fail(r, "expected ',' or '}'")
# calls the block for each element of an array; the block reads or skips it
each_element<F>(r Reader&):
	if !expect(r, '['): return
	if peek(r) == ']':
		r.pos += 1
		return
	while ok(r):
		at := r.pos
		F()
		if r.pos == at && ok(r): skip_value(r)
		c := peek(r)
		r.pos += 1
		if c == ']': return
		if c != ',':
			r.pos -= 1
			fail(r, "expected ',' or ']'")

# steps over one value of any kind; returns whether the reader is still fine
skip_value(r Reader&) bool:
	c := peek(r)
	scratch byte[>..] ~= []
	if c == '{': each_member(r) { k => skip_value(r) }
	else if c == '[': each_element(r) { skip_value(r) }
	else if c == '"': decode(r, scratch)
	else if c == 't' || c == 'f': read_bool(r)
	else if c == 'n': read_null(r)
	else if c == '-' || c >= '0' && c <= '9': read_number(r)
	else: fail(r, "expected a value")
	ok(r)

# ---- a whole document as a tree
#
# Nodes live in one array and point at each other by index (-1 for none):
# an array or object points at its first child, and every child at the
# next one. Object members carry their names.

K_NULL := 0
K_BOOL := 1
K_INT := 2
K_NUM := 3
K_STR := 4
K_ARR := 5
K_OBJ := 6
struct Node { kind int = 0, num real = 0.0, whole int = 0, text byte[>..] = [], name byte[>..] = [], first int = -1, next int = -1, count int = 0 }
struct Doc { nodes Node[>..] = [] }

add_node(d Doc&, kind int) int:
	d.nodes.push(Node{kind: kind})
	d.nodes.len - 1

# links child after prev under parent; returns the child
attach(d Doc&, parent int, prev int, child int) int:
	if prev < 0 { d.nodes[parent].first = child } else { d.nodes[prev].next = child }
	d.nodes[parent].count += 1
	child

value(r Reader&, d Doc&, depth int) int:
	if depth > 500:
		fail(r, "nested too deeply")
		return -1
	c := peek(r)
	if c == '{':
		n := add_node(d, K_OBJ)
		last ~= -1
		each_member(r) { key => k := value(r, d, depth + 1); if k >= 0 { d.nodes[k].name.append(key); last = attach(d, n, last, k) } }
		return n
	if c == '[':
		n := add_node(d, K_ARR)
		last ~= -1
		each_element(r) { k := value(r, d, depth + 1); if k >= 0 { last = attach(d, n, last, k) } }
		return n
	if c == '"':
		n := add_node(d, K_STR)
		s byte[>..] ~= []
		decode(r, s)
		d.nodes[n].text.append(s[..])
		return n
	if c == 't' || c == 'f':
		n := add_node(d, K_BOOL)
		d.nodes[n].whole = if read_bool(r) { 1 } else { 0 }
		return n
	if c == 'n':
		read_null(r)
		return add_node(d, K_NULL)
	peek(r)
	start := r.pos
	e, fr := number_end(r)
	if e < 0:
		fail(r, "expected a value")
		return -1
	if !fr:
		v, fits := parse_int(r.text[start..e])
		if fits:
			r.pos = e
			n := add_node(d, K_INT)
			d.nodes[n].whole = v
			d.nodes[n].num = v as real
			return n
	n := add_node(d, K_NUM)
	d.nodes[n].num = read_number(r)
	n

# parses text into d (cleared first): the root index and "" or -1 and why
parse(text const byte[:], d Doc&) int, byte[>..]:
	d.nodes.clear()
	r ~= reader(text)
	root := value(r, d, 0)
	if !finish(r): return -1, message(r)
	return root, []

# the member of object n named key, or -1
member(d Doc&, n int, key byte[:]) int:
	if n < 0 || d.nodes[n].kind != K_OBJ: return -1
	c ~= d.nodes[n].first
	while c >= 0:
		if d.nodes[c].name == key: return c
		c = d.nodes[c].next
	-1
# element k of array n, or -1
element(d Doc&, n int, k int) int:
	if n < 0 || d.nodes[n].kind != K_ARR: return -1
	c ~= d.nodes[n].first
	i ~= 0
	while c >= 0 && i < k:
		c = d.nodes[c].next
		i += 1
	c
name_of(d Doc&, c int) const byte[:]: if c < 0 { "" } else { d.nodes[c].name[..] }
count(d Doc&, n int) int: if n < 0 { 0 } else { d.nodes[n].count }
# calls the block with each child of n
each<F>(d Doc&, n int):
	c ~= if n < 0 { -1 } else { d.nodes[n].first }
	while c >= 0:
		F(c)
		c = d.nodes[c].next
kind(d Doc&, n int) int: if n < 0 { -1 } else { d.nodes[n].kind }
as_f64(d Doc&, n int) real, bool:
	k := kind(d, n)
	if k == K_NUM || k == K_INT: return d.nodes[n].num, true
	return 0.0, false
as_i64(d Doc&, n int) int, bool:
	if kind(d, n) == K_INT: return d.nodes[n].whole, true
	return 0, false
as_bool(d Doc&, n int) bool, bool:
	if kind(d, n) == K_BOOL: return d.nodes[n].whole == 1, true
	return false, false
as_string(d Doc&, n int) const byte[:], bool:
	if kind(d, n) == K_STR: return d.nodes[n].text[..], true
	return "", false
is_null(d Doc&, n int) bool: kind(d, n) == K_NULL

# writes node n back out as compact JSON
format_node(out byte[>..]&, d Doc&, n int) int:
	k := kind(d, n)
	if k == K_OBJ || k == K_ARR:
		out.push(if k == K_OBJ { '{' } else { '[' })
		c ~= d.nodes[n].first
		while c >= 0:
			if c != d.nodes[n].first: out.push(',')
			if k == K_OBJ: format_key(out, d.nodes[c].name[..])
			format_node(out, d, c)
			c = d.nodes[c].next
		out.push(if k == K_OBJ { '}' } else { ']' })
	else if k == K_STR: format_string(out, d.nodes[n].text[..])
	else if k == K_INT: format(out, d.nodes[n].whole)
	else if k == K_NUM: format_number(out, d.nodes[n].num)
	else if k == K_BOOL: format_bool(out, d.nodes[n].whole == 1)
	else: format_null(out)
	out.len
