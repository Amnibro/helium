namespace crypto
use std
SHA1 := 1
SHA256 := 2
SHA384 := 3
SHA512 := 4
K256 u32[64] := [0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5, 0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5, 0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3, 0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174, 0xE49B69C1, 0xEFBE4786, 0xFC19DC6, 0x240CA1CC, 0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA, 0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7, 0xC6E00BF3, 0xD5A79147, 0x6CA6351, 0x14292967, 0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13, 0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85, 0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3, 0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070, 0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5, 0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3, 0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208, 0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2]
K512 u64[80] := [0x428A2F98D728AE22, 0x7137449123EF65CD, 0xB5C0FBCFEC4D3B2F, 0xE9B5DBA58189DBBC, 0x3956C25BF348B538, 0x59F111F1B605D019, 0x923F82A4AF194F9B, 0xAB1C5ED5DA6D8118, 0xD807AA98A3030242, 0x12835B0145706FBE, 0x243185BE4EE4B28C, 0x550C7DC3D5FFB4E2, 0x72BE5D74F27B896F, 0x80DEB1FE3B1696B1, 0x9BDC06A725C71235, 0xC19BF174CF692694, 0xE49B69C19EF14AD2, 0xEFBE4786384F25E3, 0xFC19DC68B8CD5B5, 0x240CA1CC77AC9C65, 0x2DE92C6F592B0275, 0x4A7484AA6EA6E483, 0x5CB0A9DCBD41FBD4, 0x76F988DA831153B5, 0x983E5152EE66DFAB, 0xA831C66D2DB43210, 0xB00327C898FB213F, 0xBF597FC7BEEF0EE4, 0xC6E00BF33DA88FC2, 0xD5A79147930AA725, 0x6CA6351E003826F, 0x142929670A0E6E70, 0x27B70A8546D22FFC, 0x2E1B21385C26C926, 0x4D2C6DFC5AC42AED, 0x53380D139D95B3DF, 0x650A73548BAF63DE, 0x766A0ABB3C77B2A8, 0x81C2C92E47EDAEE6, 0x92722C851482353B, 0xA2BFE8A14CF10364, 0xA81A664BBC423001, 0xC24B8B70D0F89791, 0xC76C51A30654BE30, 0xD192E819D6EF5218, 0xD69906245565A910, 0xF40E35855771202A, 0x106AA07032BBD1B8, 0x19A4C116B8D2D0C8, 0x1E376C085141AB53, 0x2748774CDF8EEB99, 0x34B0BCB5E19B48A8, 0x391C0CB3C5C95A63, 0x4ED8AA4AE3418ACB, 0x5B9CCA4F7763E373, 0x682E6FF3D6B2B8A3, 0x748F82EE5DEFB2FC, 0x78A5636F43172F60, 0x84C87814A1F0AB72, 0x8CC702081A6439EC, 0x90BEFFFA23631E28, 0xA4506CEBDE82BDE9, 0xBEF9A3F7B2C67915, 0xC67178F2E372532B, 0xCA273ECEEA26619C, 0xD186B8C721C0C207, 0xEADA7DD6CDE0EB1E, 0xF57D4F7FEE6ED178, 0x6F067AA72176FBA, 0xA637DC5A2C898A6, 0x113F9804BEF90DAE, 0x1B710B35131C471B, 0x28DB77F523047D84, 0x32CAAB7B40C72493, 0x3C9EBE0A15C9BEBC, 0x431D67C49C100D4C, 0x4CC5D4BECB3E42B6, 0x597F299CFC657E2A, 0x5FCB6FAB3AD6FAEC, 0x6C44198C4A475817]
IV256 u32[8] := [0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19]
IV384 u64[8] := [0xCBBB9D5DC1059ED8, 0x629A292A367CD507, 0x9159015A3070DD17, 0x152FECD8F70E5939, 0x67332667FFC00B31, 0x8EB44A8768581511, 0xDB0C2E0D64F98FA7, 0x47B5481DBEFA4FA4]
IV512 u64[8] := [0x6A09E667F3BCC908, 0xBB67AE8584CAA73B, 0x3C6EF372FE94F82B, 0xA54FF53A5F1D36F1, 0x510E527FADE682D1, 0x9B05688C2B3E6C1F, 0x1F83D9ABFB41BD6B, 0x5BE0CD19137E2179]
IV1 u32[5] := [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0]
struct Hash { kind int = 0, a u32[8] = [0; 8], b u64[8] = [0; 8], buf byte[>..] = [], n u64 = 0 }
hash_size(kind int) int: if kind == SHA1 { 20 } else if kind == SHA256 { 32 } else if kind == SHA384 { 48 } else if kind == SHA512 { 64 } else { 0 }
block_size(kind int) int: if kind == SHA384 || kind == SHA512 { 128 } else { 64 }
r32(x u32, n int) u32: (x >> n) | (x << (32 - n))
r64(x u64, n int) u64: (x >> n) | (x << (64 - n))
be32(p const byte[:], j int) u32: (p[j] as u32) << 24 | (p[j + 1] as u32) << 16 | (p[j + 2] as u32) << 8 | p[j + 3] as u32
be64(p const byte[:], j int) u64: (be32(p, j) as u64) << 32 | be32(p, j + 4) as u64
hash_new(kind int) Hash:
	h ~= Hash{kind: kind}
	if kind == SHA1: for i 5 { h.a[i] = IV1[i] }
	else if kind == SHA256: for i 8 { h.a[i] = IV256[i] }
	else if kind == SHA384: for i 8 { h.b[i] = IV384[i] }
	else: for i 8 { h.b[i] = IV512[i] }
	h
c1(h Hash&, p const byte[:], o int):
	w u32[80] ~= [0; 80]
	for i 16: w[i] = be32(p, o + 4 * i)
	for i 16..80: w[i] = r32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 31)
	a u32 ~= h.a[0]; b u32 ~= h.a[1]; c u32 ~= h.a[2]; d u32 ~= h.a[3]; e u32 ~= h.a[4]
	for i 80:
		f u32 := if i < 20 { (b & c) | ((b ^ 0xFFFFFFFF) & d) } else if i < 40 || i >= 60 { b ^ c ^ d } else { (b & c) | (b & d) | (c & d) }
		k u32 := if i < 20 { 0x5A827999 } else if i < 40 { 0x6ED9EBA1 } else if i < 60 { 0x8F1BBCDC } else { 0xCA62C1D6 }
		t u32 := r32(a, 27) + f + e + k + w[i]; e = d; d = c; c = r32(b, 2); b = a; a = t
	h.a[0] += a; h.a[1] += b; h.a[2] += c; h.a[3] += d; h.a[4] += e
c256(h Hash&, p const byte[:], o int):
	w u32[64] ~= [0; 64]
	for i 16: w[i] = be32(p, o + 4 * i)
	for i 16..64: x u32 := w[i - 15]; y u32 := w[i - 2]; w[i] = w[i - 16] + (r32(x, 7) ^ r32(x, 18) ^ (x >> 3)) + w[i - 7] + (r32(y, 17) ^ r32(y, 19) ^ (y >> 10))
	a u32 ~= h.a[0]; b u32 ~= h.a[1]; c u32 ~= h.a[2]; d u32 ~= h.a[3]; e u32 ~= h.a[4]; f u32 ~= h.a[5]; g u32 ~= h.a[6]; k u32 ~= h.a[7]
	for i 64:
		t1 u32 := k + (r32(e, 6) ^ r32(e, 11) ^ r32(e, 25)) + ((e & f) ^ ((e ^ 0xFFFFFFFF) & g)) + K256[i] + w[i]; t2 u32 := (r32(a, 2) ^ r32(a, 13) ^ r32(a, 22)) + ((a & b) ^ (a & c) ^ (b & c))
		k = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2
	h.a[0] += a; h.a[1] += b; h.a[2] += c; h.a[3] += d; h.a[4] += e; h.a[5] += f; h.a[6] += g; h.a[7] += k
c512(h Hash&, p const byte[:], o int):
	w u64[80] ~= [0; 80]
	for i 16: w[i] = be64(p, o + 8 * i)
	for i 16..80: x := w[i - 15]; y := w[i - 2]; w[i] = w[i - 16] + (r64(x, 1) ^ r64(x, 8) ^ (x >> 7)) + w[i - 7] + (r64(y, 19) ^ r64(y, 61) ^ (y >> 6))
	a ~= h.b[0]; b ~= h.b[1]; c ~= h.b[2]; d ~= h.b[3]; e ~= h.b[4]; f ~= h.b[5]; g ~= h.b[6]; k ~= h.b[7]
	for i 80:
		t1 := k + (r64(e, 14) ^ r64(e, 18) ^ r64(e, 41)) + ((e & f) ^ ((e ^ 0xFFFFFFFFFFFFFFFF) & g)) + K512[i] + w[i]; t2 := (r64(a, 28) ^ r64(a, 34) ^ r64(a, 39)) + ((a & b) ^ (a & c) ^ (b & c))
		k = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2
	h.b[0] += a; h.b[1] += b; h.b[2] += c; h.b[3] += d; h.b[4] += e; h.b[5] += f; h.b[6] += g; h.b[7] += k
comp(h Hash&, p const byte[:], o int): if h.kind == SHA1 { c1(h, p, o) } else if h.kind == SHA256 { c256(h, p, o) } else { c512(h, p, o) }
hash_update(h Hash&, d const byte[:]):
	bs := block_size(h.kind); h.n += d.len as u64; i ~= 0
	if h.buf.len > 0:
		t := min(bs - h.buf.len, d.len); h.buf.append(d[..t]); i = t
		if h.buf.len < bs: return
		b := h.buf; comp(h, b[..], 0); h.buf.clear()
	while i + bs <= d.len: comp(h, d, i); i += bs
	h.buf.append(d[i..])
hash_final(h0 const Hash&) byte[>..]:
	h ~= copy(h0); bs := block_size(h.kind); ll := if bs == 128 { 16 } else { 8 }; bits := h.n << 3; p byte[>..] ~= [0x80]
	while (h.buf.len + p.len + ll) % bs != 0: p.push(0)
	for i ll: p.push(if i < ll - 8 { 0 } else { (bits >> ((ll - 1 - i) * 8)) as! byte })
	hash_update(h, p[..]); o byte[>..] ~= []; n := hash_size(h.kind)
	for i n: o.push(if bs == 128 { (h.b[i >> 3] >> ((7 - (i & 7)) * 8)) as! byte } else { (h.a[i >> 2] >> ((3 - (i & 3)) * 8)) as! byte })
	o
digest(kind int, d const byte[:]) byte[>..]: h ~= hash_new(kind); hash_update(h, d); hash_final(h)
sha1(d const byte[:]) byte[>..]: digest(SHA1, d)
sha256(d const byte[:]) byte[>..]: digest(SHA256, d)
sha384(d const byte[:]) byte[>..]: digest(SHA384, d)
sha512(d const byte[:]) byte[>..]: digest(SHA512, d)
hmac(kind int, key const byte[:], msg const byte[:]) byte[>..]:
	bs := block_size(kind); k byte[>..] ~= []
	if key.len > bs { k.append(digest(kind, key)[..]) } else { k.append(key) }
	k.resize(bs, 0); ip byte[>..] ~= []; op byte[>..] ~= []
	for i bs: ip.push(k[i] ^ 0x36); op.push(k[i] ^ 0x5C)
	hi ~= hash_new(kind); hash_update(hi, ip[..]); hash_update(hi, msg); ih := hash_final(hi)
	ho ~= hash_new(kind); hash_update(ho, op[..]); hash_update(ho, ih[..]); hash_final(ho)
hkdf_extract(kind int, salt const byte[:], ikm const byte[:]) byte[>..]:
	if salt.len > 0: return hmac(kind, salt, ikm)
	z byte[>..] ~= []; z.resize(hash_size(kind), 0); hmac(kind, z[..], ikm)
hkdf_expand(kind int, prk const byte[:], info const byte[:], n int) byte[>..], bool:
	out byte[>..] ~= []
	if n < 0 || n > 255 * hash_size(kind): return out, false
	t byte[>..] ~= []; c ~= 1
	while out.len < n:
		m byte[>..] ~= []; m.append(t[..]); m.append(info); m.push(c as! byte); t = hmac(kind, prk, m[..]); out.append(t[..]); c += 1
	out.resize(n, 0)
	return out, true
hkdf(kind int, ikm const byte[:], salt const byte[:], info const byte[:], n int) byte[>..], bool: hkdf_expand(kind, hkdf_extract(kind, salt, ikm)[..], info, n)
ct_eq(a const byte[:], b const byte[:]) bool:
	if a.len != b.len: return false
	d ~= 0 as byte
	for i a.len: d |= a[i] ^ b[i]
	d == 0
hmac_states(kind int, key const byte[:]) Hash, Hash:
	bs := block_size(kind); k byte[>..] ~= []
	if key.len > bs { k.append(digest(kind, key)[..]) } else { k.append(key) }
	k.resize(bs, 0); ip byte[>..] ~= []; op byte[>..] ~= []
	for i bs: ip.push(k[i] ^ 0x36); op.push(k[i] ^ 0x5C)
	hi ~= hash_new(kind); hash_update(hi, ip[..]); ho ~= hash_new(kind); hash_update(ho, op[..])
	return hi, ho
hmac_with(hi const Hash&, ho const Hash&, m const byte[:]) byte[>..]: a ~= copy(hi); hash_update(a, m); x := hash_final(a); b ~= copy(ho); hash_update(b, x); hash_final(b)
pbkdf2(kind int, pw const byte[:], salt const byte[:], iters int, n int) byte[>..], bool:
	out byte[>..] ~= []
	if iters < 1 || n < 1 || hash_size(kind) == 0: return out, false
	hi, ho := hmac_states(kind, pw); i ~= 1
	while out.len < n:
		m byte[>..] ~= []; m.append(salt); for k 4 { m.push((i >> (24 - 8 * k)) as! byte) }
		u ~= hmac_with(hi, ho, m); t ~= copy(u)
		for j 1..iters: u = hmac_with(hi, ho, u); for b t.len { t[b] ^= u[b] }
		out.append(t[..]); i += 1
	out.resize(n, 0)
	return out, true
