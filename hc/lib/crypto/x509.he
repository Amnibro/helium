namespace crypto
use std
use base64
use crypto.hash
use crypto.rsa
use crypto.ecc
use crypto.c25519
use crypto.rand
X509_OK := 0
X509_UNTRUSTED := 1
X509_BAD_NAME := 2
X509_EXPIRED := 3
X509_BAD := 4
KEY_RSA := 1
KEY_EC := 2
KEY_ED25519 := 3
struct Der { tag int = -1, i int = 0, s int = 0, n int = 0, e int = 0 }
struct Cert { raw byte[>..] = [], tbs byte[>..] = [], salg byte[>..] = [], sparams byte[>..] = [], sig byte[>..] = [], issuer byte[>..] = [], subject byte[>..] = [], nb int = 0, na int = 0, kalg int = 0, kcurve int = 0, kpub byte[>..] = [], rn byte[>..] = [], re byte[>..] = [], spki byte[>..] = [], ca bool = false, plen int = -1, ku int = -1, server bool = true, dns byte[>..][>..] = [], ips byte[>..][>..] = [], crit bool = false }
der_at(d const byte[:], i int, lim int) Der:
	bad := Der{}
	if i + 2 > lim || d[i] & 0x1F == 0x1F: return bad
	l ~= d[i + 1] as int; s ~= i + 2
	if l >= 0x80:
		nb := l & 0x7F
		if nb == 0 || nb > 3 || s + nb > lim || d[s] == 0: return bad
		l = 0
		for k nb: l = l << 8 | d[s + k] as int
		if l < 0x80: return bad
		s += nb
	if s + l > lim: return bad
	Der{d[i] as int, i, s, l, s + l}
kids(d const byte[:], p Der) Der[>..], bool:
	o Der[>..] ~= []; i ~= p.s
	while i < p.e:
		k := der_at(d, i, p.e)
		if k.tag < 0: return o, false
		o.push(k); i = k.e
	return o, true
oid_is(d const byte[:], k Der, hx const byte[:]) bool: if k.tag != 6 { false } else { want byte[>..] ~= []; hex_decode(hx, want); d[k.s..k.e] == want[..] }
civil_days(y0 int, m int, d int) int:
	y := if m <= 2 { y0 - 1 } else { y0 }; era := y / 400; yoe := y - era * 400; mp := if m > 2 { m - 3 } else { m + 9 }; doy := (153 * mp + 2) / 5 + d - 1
	era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468
dig(d const byte[:], i int, n int) int: v ~= 0; for k n { c := d[i + k]; if c < '0' || c > '9' { return -1 } v = v * 10 + (c - '0') as int } v
der_time(d const byte[:], k Der) int:
	t := d[k.s..k.e]; g := k.tag == 0x18; yl := if g { 4 } else { 2 }
	if !(k.tag == 0x17 || g) || t.len != yl + 11 || t[t.len - 1] != 'Z': return -1
	y0 := dig(t, 0, yl); y := if g { y0 } else if y0 >= 50 { 1900 + y0 } else { 2000 + y0 }; mo := dig(t, yl, 2); dd := dig(t, yl + 2, 2); hh := dig(t, yl + 4, 2); mi := dig(t, yl + 6, 2); ss := dig(t, yl + 8, 2)
	if y0 < 0 || mo < 1 || mo > 12 || dd < 1 || dd > 31 || hh < 0 || hh > 23 || mi < 0 || mi > 59 || ss < 0 || ss > 60: return -1
	civil_days(y, mo, dd) * 86400 + hh * 3600 + mi * 60 + ss
uint_bytes(d const byte[:], k Der) byte[>..]: o byte[>..] ~= []; v := d[k.s..k.e]; i ~= 0; while i + 1 < v.len && v[i] == 0 { i += 1 } o.append(v[i..]); o
spki_parse(c Cert&, d const byte[:], sp Der) bool:
	ks, ok := kids(d, sp)
	if !ok || ks.len != 2 || ks[0].tag != 0x30 || ks[1].tag != 3 || ks[1].n < 2 || d[ks[1].s] != 0: return false
	al, ok2 := kids(d, ks[0])
	if !ok2 || al.len < 1: return false
	key := Der{3, ks[1].i, ks[1].s + 1, ks[1].n - 1, ks[1].e}
	if oid_is(d, al[0], "2a864886f70d010101"):
		rk := der_at(d, key.s, key.e); rv, ok3 := kids(d, rk)
		if rk.tag != 0x30 || !ok3 || rv.len != 2 || rv[0].tag != 2 || rv[1].tag != 2: return false
		c.kalg = KEY_RSA; c.rn = uint_bytes(d, rv[0]); c.re = uint_bytes(d, rv[1]); return true
	if oid_is(d, al[0], "2a8648ce3d0201") && al.len == 2:
		c.kcurve = if oid_is(d, al[1], "2a8648ce3d030107") { P256 } else if oid_is(d, al[1], "2b81040022") { P384 } else { 0 }
		c.kalg = KEY_EC; c.kpub.append(d[key.s..key.e]); return true
	if oid_is(d, al[0], "2b6570") && key.n == 32: c.kalg = KEY_ED25519; c.kpub.append(d[key.s..key.e]); return true
	false
ext_parse(c Cert&, d const byte[:], ex Der) bool:
	es, ok := kids(d, ex)
	if !ok: return false
	for e es:
		f, ok2 := kids(d, e)
		if !ok2 || f.len < 2 || f[0].tag != 6: return false
		crit := f.len == 3 && f[1].tag == 1 && f[1].n == 1 && d[f[1].s] != 0; v := f[f.len - 1]
		if v.tag != 4: return false
		inner := der_at(d, v.s, v.e)
		if inner.tag < 0 || inner.e != v.e: return false
		if oid_is(d, f[0], "551d13"):
			b, ok3 := kids(d, inner)
			if !ok3: return false
			for x b: if x.tag == 1 && x.n == 1 { c.ca = d[x.s] != 0 } else if x.tag == 2 && x.n <= 2 { c.plen = uint_bytes(d, x)[0] as int }
		else if oid_is(d, f[0], "551d0f"):
			if inner.tag != 3 || inner.n < 2: return false
			c.ku = (d[inner.s + 1] as int) << 8 | (if inner.n > 2 { d[inner.s + 2] as int } else { 0 })
		else if oid_is(d, f[0], "551d25"):
			b, ok3 := kids(d, inner)
			if !ok3: return false
			c.server = false
			for x b: if oid_is(d, x, "2b06010505070301") || oid_is(d, x, "551d2500") { c.server = true }
		else if oid_is(d, f[0], "551d11"):
			b, ok3 := kids(d, inner)
			if !ok3: return false
			for x b: if x.tag == 0x82 { s byte[>..] ~= []; for ch d[x.s..x.e] { s.push(if ch >= 'A' && ch <= 'Z' { ch + 32 } else { ch }) } c.dns.push(s) } else if x.tag == 0x87 { s byte[>..] ~= []; s.append(d[x.s..x.e]); c.ips.push(s) }
		else if crit: c.crit = true
	true
x509_parse(d const byte[:]) Cert, bool:
	c ~= Cert{}; top := der_at(d, 0, d.len)
	if top.tag != 0x30 || top.e != d.len: return c, false
	t, ok := kids(d, top)
	if !ok || t.len != 3 || t[0].tag != 0x30 || t[1].tag != 0x30 || t[2].tag != 3 || t[2].n < 1 || d[t[2].s] != 0: return c, false
	c.raw.append(d); c.tbs.append(d[t[0].i..t[0].e]); c.sig.append(d[t[2].s + 1..t[2].e])
	al, ok2 := kids(d, t[1])
	if !ok2 || al.len < 1 || al[0].tag != 6: return c, false
	c.salg.append(d[al[0].s..al[0].e])
	if al.len > 1: c.sparams.append(d[al[1].i..al[1].e])
	f, ok3 := kids(d, t[0])
	if !ok3: return c, false
	i ~= if f.len > 0 && f[0].tag == 0xA0 { 1 } else { 0 }
	if f.len < i + 6 || f[i].tag != 2 || f[i + 1].tag != 0x30 || d[f[i + 1].i..f[i + 1].e] != d[t[1].i..t[1].e] || f[i + 2].tag != 0x30 || f[i + 3].tag != 0x30 || f[i + 4].tag != 0x30 || f[i + 5].tag != 0x30: return c, false
	c.issuer.append(d[f[i + 2].i..f[i + 2].e]); c.subject.append(d[f[i + 4].i..f[i + 4].e]); c.spki.append(d[f[i + 5].i..f[i + 5].e])
	vt, ok4 := kids(d, f[i + 3])
	if !ok4 || vt.len != 2: return c, false
	c.nb = der_time(d, vt[0]); c.na = der_time(d, vt[1])
	if c.nb < 0 || c.na < 0 || !spki_parse(c, d, f[i + 5]): return c, false
	for k i + 6..f.len:
		if f[k].tag == 0xA3:
			ex := der_at(d, f[k].s, f[k].e)
			if ex.tag != 0x30 || ex.e != f[k].e || !ext_parse(c, d, ex): return c, false
	return c, true
x509_pem(pem const byte[:]) Cert[>..]:
	out Cert[>..] ~= []; b := "-----BEGIN CERTIFICATE-----"; e := "-----END CERTIFICATE-----"; i ~= 0
	loop:
		s := find(pem[i..], b)
		if s < 0: break
		a := i + s + b.len; t := find(pem[a..], e)
		if t < 0: break
		body byte[>..] ~= []
		for ch pem[a..a + t]: if ch != '\n' && ch != '\r' && ch != ' ' { body.push(ch) }
		der byte[>..] ~= []
		if base64::decode(der, body[..]): c, ok := x509_parse(der[..]); if ok { out.push(c) }
		i = a + t + e.len
	out
alg_hash(d const byte[:], k Der) int: if oid_is(d, k, "608648016503040201") { SHA256 } else if oid_is(d, k, "608648016503040202") { SHA384 } else if oid_is(d, k, "608648016503040203") { SHA512 } else { 0 }
pss_kind(d const byte[:]) int, int, int:
	top := der_at(d, 0, d.len); ks, ok := kids(d, top); hk ~= SHA1; mk ~= SHA1; sl ~= 20
	if top.tag != 0x30 || !ok: return 0, 0, 0
	for k ks:
		inner := der_at(d, k.s, k.e); a, ok2 := kids(d, inner)
		if k.tag == 0xA0:
			if !ok2 || a.len < 1: return 0, 0, 0
			hk = alg_hash(d, a[0])
		else if k.tag == 0xA1:
			if !ok2 || a.len < 2: return 0, 0, 0
			m, ok3 := kids(d, a[1])
			if !ok3 || m.len < 1: return 0, 0, 0
			mk = alg_hash(d, m[0])
		else if k.tag == 0xA2 && inner.tag == 2 && inner.n <= 2:
			sl = 0
			for ch d[inner.s..inner.e]: sl = sl << 8 | ch as int
	return hk, mk, sl
sig_ok(salg const byte[:], sparams const byte[:], tbs const byte[:], sig const byte[:], k const Cert&) bool:
	o := Der{6, 0, 0, salg.len, salg.len}
	rk := if oid_is(salg, o, "2a864886f70d01010b") { SHA256 } else if oid_is(salg, o, "2a864886f70d01010c") { SHA384 } else if oid_is(salg, o, "2a864886f70d01010d") { SHA512 } else { 0 }
	if rk != 0: return k.kalg == KEY_RSA && rsa_pkcs1_verify(rk, k.rn, k.re, tbs, sig)
	ek := if oid_is(salg, o, "2a8648ce3d040302") { SHA256 } else if oid_is(salg, o, "2a8648ce3d040303") { SHA384 } else if oid_is(salg, o, "2a8648ce3d040304") { SHA512 } else { 0 }
	if ek != 0: return k.kalg == KEY_EC && k.kcurve != 0 && ecdsa_verify_der(k.kcurve, ek, k.kpub, tbs, sig)
	if oid_is(salg, o, "2a864886f70d01010a"):
		hk, mk, sl := pss_kind(sparams)
		return k.kalg == KEY_RSA && hk >= SHA256 && mk >= SHA256 && rsa_pss_verify(hk, mk, sl, k.rn, k.re, tbs, sig)
	if oid_is(salg, o, "2b6570"): return k.kalg == KEY_ED25519 && ed25519_verify(k.kpub, tbs, sig)
	false
signed_by(c const Cert&, k const Cert&) bool: c.issuer[..] == k.subject[..] && sig_ok(c.salg[..], c.sparams[..], c.tbs[..], c.sig[..], k)
ipv4(h const byte[:]) byte[>..]:
	o byte[>..] ~= []; v ~= -1; dots ~= 0
	for ch h:
		if ch == '.' { if v < 0 { return [] } o.push(v as! byte); v = -1; dots += 1 } else if ch >= '0' && ch <= '9' { v = (if v < 0 { 0 } else { v }) * 10 + (ch - '0') as int; if v > 255 { return [] } } else { return [] }
	if v < 0 || dots != 3: return []
	o.push(v as! byte); o
name_ok(c const Cert&, host0 const byte[:]) bool:
	h byte[>..] ~= []
	for ch host0: h.push(if ch >= 'A' && ch <= 'Z' { ch + 32 } else { ch })
	ip := ipv4(h[..])
	if ip.len == 4: for x c.ips { if x[..] == ip[..] { return true } } return false
	for n c.dns:
		if n[..] == h[..]: return true
		if n.len > 2 && n[0] == '*' && n[1] == '.':
			dot := find(h[..], ".")
			if dot > 0 && h[dot..] == n[1..] && find(n[2..], "*") < 0: return true
	false
x509_verify(chain const Cert[:], host const byte[:], now int, roots const Cert[:]) int:
	if chain.len == 0: return X509_BAD
	cur ~= 0; expired ~= false; depth ~= 0
	if !chain[0].server: return X509_BAD
	loop:
		let c .= chain[cur]
		if c.crit: return X509_BAD
		if now < c.nb || now > c.na: expired = true
		for r roots:
			if c.raw[..] == r.raw[..] || signed_by(c, r): return if expired { X509_EXPIRED } else if name_ok(chain[0], host) { X509_OK } else { X509_BAD_NAME }
		nx ~= -1
		for k 1..chain.len:
			let p .= chain[k]
			if nx < 0 && k != cur && p.ca && (p.ku < 0 || p.ku & 0x400 != 0) && p.server && (p.plen < 0 || p.plen >= depth) && signed_by(c, p): nx = k
		if nx < 0 || depth >= 8: return X509_UNTRUSTED
		cur = nx; depth += 1
der_tlv(tag int, body const byte[:]) byte[>..]:
	o byte[>..] ~= [tag as! byte]; n := body.len; k := if n < 0x80 { 0 } else if n < 0x100 { 1 } else if n < 0x10000 { 2 } else { 3 }
	if k > 0: o.push((0x80 | k) as! byte)
	for i max(k, 1): o.push(((n >> (8 * (max(k, 1) - 1 - i))) & 255) as! byte)
	o.append(body); o
x509_date(t int) byte[>..]:
	z := t / 86400 + 719468; era := z / 146097; doe := z - era * 146097; yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365; doy := doe - (365 * yoe + yoe / 4 - yoe / 100); mp := (5 * doy + 2) / 153
	d := doy - (153 * mp + 2) / 5 + 1; m := if mp < 10 { mp + 3 } else { mp - 9 }; y := yoe + era * 400 + (if m <= 2 { 1 } else { 0 }); s := t % 86400; g := y >= 2050 || y < 1950; o byte[>..] ~= []
	v int[7] := [if g { y / 100 } else { -1 }, y % 100, m, d, s / 3600, s / 60 % 60, s % 60]
	for x v: if x >= 0 { o.push((48 + x / 10) as! byte); o.push((48 + x % 10) as! byte) }
	o.push('Z'); der_tlv(if g { 0x18 } else { 0x17 }, o[..])
x509_self_signed(name const byte[:], priv const byte[:], from int, days int) byte[>..], bool:
	e byte[>..] ~= []; pub, ok := ec_public(P256, priv)
	if !ok: return e, false
	alg := hexb("300a06082a8648ce3d040302"); cn ~= hexb("0603550403"); cn.append(der_tlv(0x0C, name)[..]); nm := der_tlv(0x30, der_tlv(0x31, der_tlv(0x30, cn[..])[..])[..])
	val ~= x509_date(from); val.append(x509_date(from + days * 86400)[..]); bits byte[>..] ~= [0]; bits.append(pub[..]); sp ~= hexb("301306072a8648ce3d020106082a8648ce3d030107"); sp.append(der_tlv(3, bits[..])[..])
	ip := ipv4(name); gn := if ip.len == 4 { der_tlv(0x87, ip[..]) } else { der_tlv(0x82, name) }; san ~= hexb("0603551d11"); san.append(der_tlv(4, der_tlv(0x30, gn[..])[..])[..])
	ser ~= random_bytes(16); ser[0] = (ser[0] & 0x7F) | 0x40
	tbs ~= hexb("a003020102"); tbs.append(der_tlv(2, ser[..])[..]); tbs.append(alg[..]); tbs.append(nm[..]); tbs.append(der_tlv(0x30, val[..])[..]); tbs.append(nm[..]); tbs.append(der_tlv(0x30, sp[..])[..])
	tbs.append(der_tlv(0xA3, der_tlv(0x30, der_tlv(0x30, san[..])[..])[..])[..]); t := der_tlv(0x30, tbs[..]); sig, ok2 := ecdsa_sign_der(P256, SHA256, priv, t[..])
	if !ok2: return e, false
	sb byte[>..] ~= [0]; sb.append(sig[..]); c ~= copy(t); c.append(alg[..]); c.append(der_tlv(3, sb[..])[..]); return der_tlv(0x30, c[..]), true
pkcs8_ec(priv const byte[:]) byte[>..], bool:
	e byte[>..] ~= []; id := if priv.len == 48 { P384 } else { P256 }; pub, ok := ec_public(id, priv)
	if !ok: return e, false
	bits byte[>..] ~= [0]; bits.append(pub[..]); k ~= hexb("020101"); k.append(der_tlv(4, priv)[..]); k.append(der_tlv(0xA1, der_tlv(3, bits[..])[..])[..])
	o ~= hexb(if id == P384 { "020100301006072a8648ce3d020106052b81040022" } else { "020100301306072a8648ce3d020106082a8648ce3d030107" }); o.append(der_tlv(4, der_tlv(0x30, k[..])[..])[..]); return der_tlv(0x30, o[..]), true
pkcs8_ec_parse(d const byte[:]) byte[>..], int:
	e byte[>..] ~= []; top := der_at(d, 0, d.len); t, ok := kids(d, top)
	if top.tag != 0x30 || !ok || t.len < 3: return e, 0
	sec := t[1].tag == 4 && t[2].tag == 0xA0; al, ok2 := kids(d, t[1]); sk := der_at(d, t[2].s, t[2].e); f, ok3 := kids(d, sk)
	if !sec && (t[1].tag != 0x30 || t[2].tag != 4 || !ok2 || al.len != 2 || !oid_is(d, al[0], "2a8648ce3d0201") || sk.tag != 0x30 || !ok3 || f.len < 2 || f[1].tag != 4): return e, 0
	k := if sec { t[1] } else { f[1] }; o := if sec { sk } else { al[1] }; id := if oid_is(d, o, "2a8648ce3d030107") { P256 } else if oid_is(d, o, "2b81040022") { P384 } else { 0 }
	if id == 0 || k.n != (if id == P256 { 32 } else { 48 }): return e, 0
	e.append(d[k.s..k.e]); return e, id
