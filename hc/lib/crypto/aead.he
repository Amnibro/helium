namespace crypto
use std
use crypto.hash
AES_GCM := 1
CHACHA20_POLY1305 := 2
XCHACHA20_POLY1305 := 3
SBOX byte[256] := [0x63, 0x7C, 0x77, 0x7B, 0xF2, 0x6B, 0x6F, 0xC5, 0x30, 0x01, 0x67, 0x2B, 0xFE, 0xD7, 0xAB, 0x76, 0xCA, 0x82, 0xC9, 0x7D, 0xFA, 0x59, 0x47, 0xF0, 0xAD, 0xD4, 0xA2, 0xAF, 0x9C, 0xA4, 0x72, 0xC0, 0xB7, 0xFD, 0x93, 0x26, 0x36, 0x3F, 0xF7, 0xCC, 0x34, 0xA5, 0xE5, 0xF1, 0x71, 0xD8, 0x31, 0x15, 0x04, 0xC7, 0x23, 0xC3, 0x18, 0x96, 0x05, 0x9A, 0x07, 0x12, 0x80, 0xE2, 0xEB, 0x27, 0xB2, 0x75, 0x09, 0x83, 0x2C, 0x1A, 0x1B, 0x6E, 0x5A, 0xA0, 0x52, 0x3B, 0xD6, 0xB3, 0x29, 0xE3, 0x2F, 0x84, 0x53, 0xD1, 0x00, 0xED, 0x20, 0xFC, 0xB1, 0x5B, 0x6A, 0xCB, 0xBE, 0x39, 0x4A, 0x4C, 0x58, 0xCF, 0xD0, 0xEF, 0xAA, 0xFB, 0x43, 0x4D, 0x33, 0x85, 0x45, 0xF9, 0x02, 0x7F, 0x50, 0x3C, 0x9F, 0xA8, 0x51, 0xA3, 0x40, 0x8F, 0x92, 0x9D, 0x38, 0xF5, 0xBC, 0xB6, 0xDA, 0x21, 0x10, 0xFF, 0xF3, 0xD2, 0xCD, 0x0C, 0x13, 0xEC, 0x5F, 0x97, 0x44, 0x17, 0xC4, 0xA7, 0x7E, 0x3D, 0x64, 0x5D, 0x19, 0x73, 0x60, 0x81, 0x4F, 0xDC, 0x22, 0x2A, 0x90, 0x88, 0x46, 0xEE, 0xB8, 0x14, 0xDE, 0x5E, 0x0B, 0xDB, 0xE0, 0x32, 0x3A, 0x0A, 0x49, 0x06, 0x24, 0x5C, 0xC2, 0xD3, 0xAC, 0x62, 0x91, 0x95, 0xE4, 0x79, 0xE7, 0xC8, 0x37, 0x6D, 0x8D, 0xD5, 0x4E, 0xA9, 0x6C, 0x56, 0xF4, 0xEA, 0x65, 0x7A, 0xAE, 0x08, 0xBA, 0x78, 0x25, 0x2E, 0x1C, 0xA6, 0xB4, 0xC6, 0xE8, 0xDD, 0x74, 0x1F, 0x4B, 0xBD, 0x8B, 0x8A, 0x70, 0x3E, 0xB5, 0x66, 0x48, 0x03, 0xF6, 0x0E, 0x61, 0x35, 0x57, 0xB9, 0x86, 0xC1, 0x1D, 0x9E, 0xE1, 0xF8, 0x98, 0x11, 0x69, 0xD9, 0x8E, 0x94, 0x9B, 0x1E, 0x87, 0xE9, 0xCE, 0x55, 0x28, 0xDF, 0x8C, 0xA1, 0x89, 0x0D, 0xBF, 0xE6, 0x42, 0x68, 0x41, 0x99, 0x2D, 0x0F, 0xB0, 0x54, 0xBB, 0x16]
struct Aes { nr int = 0, rk byte[240] = [0; 240] }
le32(p const byte[:], j int) u32: p[j] as u32 | (p[j + 1] as u32) << 8 | (p[j + 2] as u32) << 16 | (p[j + 3] as u32) << 24
put32(o byte[>..]&, v u32): o.push(v as! byte); o.push((v >> 8) as! byte); o.push((v >> 16) as! byte); o.push((v >> 24) as! byte)
put64(o byte[>..]&, v u64): for i 8 { o.push((v >> (8 * i)) as! byte) }
rl(x u32, n int) u32: (x << n) | (x >> (32 - n))
qr(x u32[16]&, a int, b int, c int, d int):
	x[a] += x[b]; x[d] = rl(x[d] ^ x[a], 16); x[c] += x[d]; x[b] = rl(x[b] ^ x[c], 12); x[a] += x[b]; x[d] = rl(x[d] ^ x[a], 8); x[c] += x[d]; x[b] = rl(x[b] ^ x[c], 7)
rounds(x u32[16]&): for i 10 { qr(x, 0, 4, 8, 12); qr(x, 1, 5, 9, 13); qr(x, 2, 6, 10, 14); qr(x, 3, 7, 11, 15); qr(x, 0, 5, 10, 15); qr(x, 1, 6, 11, 12); qr(x, 2, 7, 8, 13); qr(x, 3, 4, 9, 14) }
cc_state(key const byte[:], n const byte[:], ctr u32) u32[16]:
	s u32[16] ~= [0; 16]; s[0] = 0x61707865; s[1] = 0x3320646E; s[2] = 0x79622D32; s[3] = 0x6B206574
	for i 8: s[4 + i] = le32(key, 4 * i)
	if n.len == 16 { for i 4 { s[12 + i] = le32(n, 4 * i) } } else { s[12] = ctr; for i 3 { s[13 + i] = le32(n, 4 * i) } }
	s
chacha20(key const byte[:], nonce const byte[:], ctr u32, d const byte[:]) byte[>..]:
	s ~= cc_state(key, nonce, ctr); o byte[>..] ~= []; ks byte[>..] ~= []; i ~= 0
	while i < d.len:
		x u32[16] ~= s; rounds(x); ks.clear()
		for j 16: v u32 := x[j] + s[j]; put32(ks, v)
		n := min(64, d.len - i)
		for j n: o.push(d[i + j] ^ ks[j])
		s[12] += 1; i += 64
	o
hchacha20(key const byte[:], n16 const byte[:]) byte[>..]:
	x ~= cc_state(key, n16, 0); rounds(x); o byte[>..] ~= []
	for j 4: put32(o, x[j])
	for j 4: put32(o, x[12 + j])
	o
poly1305(key const byte[:], m const byte[:]) byte[>..]:
	mq u64 := 0x3FFFFFF; r0 u64 := (le32(key, 0) as u64) & 0x3FFFFFF; r1 u64 := ((le32(key, 3) >> 2) as u64) & 0x3FFFF03; r2 u64 := ((le32(key, 6) >> 4) as u64) & 0x3FFC0FF; r3 u64 := ((le32(key, 9) >> 6) as u64) & 0x3F03FFF; r4 u64 := ((le32(key, 12) >> 8) as u64) & 0xFFFFF
	s1 := r1 * 5; s2 := r2 * 5; s3 := r3 * 5; s4 := r4 * 5; h0 u64 ~= 0; h1 u64 ~= 0; h2 u64 ~= 0; h3 u64 ~= 0; h4 u64 ~= 0; i ~= 0; b byte[17] ~= [0; 17]
	while i < m.len:
		n := min(16, m.len - i); hb u64 ~= 1 << 24
		for j 17: b[j] = if j < n { m[i + j] } else { 0 }
		if n < 16: b[n] = 1; hb = 0
		h0 += (le32(b[..], 0) as u64) & mq; h1 += ((le32(b[..], 3) >> 2) as u64) & mq; h2 += ((le32(b[..], 6) >> 4) as u64) & mq; h3 += ((le32(b[..], 9) >> 6) as u64) & mq; h4 += (le32(b[..], 12) >> 8) as u64 | hb
		d0 := h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1; d1 ~= h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2; d2 ~= h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3; d3 ~= h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4; d4 ~= h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
		c ~= d0 >> 26; h0 = d0 & mq; d1 += c; c = d1 >> 26; h1 = d1 & mq; d2 += c; c = d2 >> 26; h2 = d2 & mq; d3 += c; c = d3 >> 26; h3 = d3 & mq; d4 += c; c = d4 >> 26; h4 = d4 & mq; h0 += c * 5; c = h0 >> 26; h0 &= mq; h1 += c
		i += 16
	c ~= h1 >> 26; h1 &= mq; h2 += c; c = h2 >> 26; h2 &= mq; h3 += c; c = h3 >> 26; h3 &= mq; h4 += c; c = h4 >> 26; h4 &= mq; h0 += c * 5; c = h0 >> 26; h0 &= mq; h1 += c
	g0 ~= h0 + 5; c = g0 >> 26; g0 &= mq; g1 ~= h1 + c; c = g1 >> 26; g1 &= mq; g2 ~= h2 + c; c = g2 >> 26; g2 &= mq; g3 ~= h3 + c; c = g3 >> 26; g3 &= mq; g4 := h4 + c - (1 << 26)
	mk := (g4 >> 63) - 1; nm := mk ^ 0xFFFFFFFFFFFFFFFF
	h0 = (h0 & nm) | (g0 & mk); h1 = (h1 & nm) | (g1 & mk); h2 = (h2 & nm) | (g2 & mk); h3 = (h3 & nm) | (g3 & mk); h4 = (h4 & nm) | (g4 & mk)
	w0 := (h0 | (h1 << 26)) & 0xFFFFFFFF; w1 := ((h1 >> 6) | (h2 << 20)) & 0xFFFFFFFF; w2 := ((h2 >> 12) | (h3 << 14)) & 0xFFFFFFFF; w3 := ((h3 >> 18) | (h4 << 8)) & 0xFFFFFFFF
	f ~= w0 + le32(key, 16) as u64; o byte[>..] ~= []; put32(o, f as! u32)
	f = w1 + le32(key, 20) as u64 + (f >> 32); put32(o, f as! u32)
	f = w2 + le32(key, 24) as u64 + (f >> 32); put32(o, f as! u32)
	f = w3 + le32(key, 28) as u64 + (f >> 32); put32(o, f as! u32)
	o
pad16(o byte[>..]&): while o.len % 16 != 0 { o.push(0) }
cp_tag(key const byte[:], nonce const byte[:], aad const byte[:], ct const byte[:]) byte[>..]:
	z byte[>..] ~= []; z.resize(32, 0); otk := chacha20(key, nonce, 0, z[..]); m byte[>..] ~= []
	m.append(aad); pad16(m); m.append(ct); pad16(m); put64(m, aad.len as u64); put64(m, ct.len as u64); poly1305(otk[..], m[..])
xt(b byte) byte: (b << 1) ^ (0x1B & (0 - (b >> 7)))
aes_key(key const byte[:]) Aes:
	nk := key.len / 4; a ~= Aes{nr: nk + 6}; rc byte ~= 1; t byte[4] ~= [0; 4]
	for j key.len: a.rk[j] = key[j]
	for i nk..4 * (a.nr + 1):
		for j 4: t[j] = a.rk[4 * (i - 1) + j]
		if i % nk == 0: u byte := t[0]; t[0] = SBOX[t[1]] ^ rc; t[1] = SBOX[t[2]]; t[2] = SBOX[t[3]]; t[3] = SBOX[u]; rc = xt(rc)
		else if nk > 6 && i % nk == 4: for j 4 { t[j] = SBOX[t[j]] }
		for j 4: a.rk[4 * i + j] = a.rk[4 * (i - nk) + j] ^ t[j]
	a
aes_block(a const Aes&, inp const byte[:], o byte[16]&):
	s byte[16] ~= [0; 16]; u byte[16] ~= [0; 16]
	for j 16: s[j] = inp[j] ^ a.rk[j]
	for r 1..a.nr + 1:
		for c 4: for k 4 { u[4 * c + k] = SBOX[s[4 * ((c + k) % 4) + k]] }
		if r != a.nr:
			for c 4:
				a0 byte := u[4 * c]; a1 byte := u[4 * c + 1]; a2 byte := u[4 * c + 2]; a3 byte := u[4 * c + 3]; t byte := a0 ^ a1 ^ a2 ^ a3
				u[4 * c] = a0 ^ t ^ xt(a0 ^ a1); u[4 * c + 1] = a1 ^ t ^ xt(a1 ^ a2); u[4 * c + 2] = a2 ^ t ^ xt(a2 ^ a3); u[4 * c + 3] = a3 ^ t ^ xt(a3 ^ a0)
		for j 16: s[j] = u[j] ^ a.rk[16 * r + j]
	o = s
be64b(p const byte[:], j int) u64: v u64 ~= 0; for k 8 { v = v << 8 | p[j + k] as u64 } v
gmul(xh u64, xl u64, yh u64, yl u64) u64, u64:
	zh u64 ~= 0; zl u64 ~= 0; vh ~= yh; vl ~= yl
	for i 128:
		bit := if i < 64 { (xh >> (63 - i)) & 1 } else { (xl >> (127 - i)) & 1 }; m := 0 - bit; zh ^= vh & m; zl ^= vl & m
		lb := vl & 1; vl = (vl >> 1) | (vh << 63); vh = (vh >> 1) ^ (0xE100000000000000 & (0 - lb))
	return zh, zl
ghash(hh u64, hl u64, a const byte[:], c const byte[:]) byte[>..]:
	yh u64 ~= 0; yl u64 ~= 0; blk byte[>..] ~= []
	for part 2:
		d := if part == 0 { a } else { c }; i ~= 0
		while i < d.len:
			blk.clear(); n := min(16, d.len - i); blk.append(d[i..i + n]); blk.resize(16, 0)
			ph, pl := gmul(yh ^ be64b(blk[..], 0), yl ^ be64b(blk[..], 8), hh, hl); yh = ph; yl = pl; i += 16
	lh, ll := gmul(yh ^ ((a.len as u64) << 3), yl ^ ((c.len as u64) << 3), hh, hl); o byte[>..] ~= []
	for k 8: o.push((lh >> (56 - 8 * k)) as! byte)
	for k 8: o.push((ll >> (56 - 8 * k)) as! byte)
	o
gcm_core(key const byte[:], iv const byte[:], aad const byte[:], d const byte[:], enc bool) byte[>..], byte[>..]:
	a := aes_key(key); z byte[16] ~= [0; 16]; hb byte[16] ~= [0; 16]; aes_block(a, z[..], hb); hh := be64b(hb[..], 0); hl := be64b(hb[..], 8); j0 byte[>..] ~= []
	if iv.len == 12 { j0.append(iv); j0.append([0 as byte, 0, 0, 1][..]) } else { e byte[>..] ~= []; j0 = ghash(hh, hl, e[..], iv) }
	ctr byte[16] ~= [0; 16]; ks byte[16] ~= [0; 16]; o byte[>..] ~= []; i ~= 0
	for k 16: ctr[k] = j0[k]
	while i < d.len:
		cv u32 ~= (ctr[12] as u32) << 24 | (ctr[13] as u32) << 16 | (ctr[14] as u32) << 8 | ctr[15] as u32; cv += 1; ctr[12] = (cv >> 24) as! byte; ctr[13] = (cv >> 16) as! byte; ctr[14] = (cv >> 8) as! byte; ctr[15] = cv as! byte
		aes_block(a, ctr[..], ks); n := min(16, d.len - i)
		for k n: o.push(d[i + k] ^ ks[k])
		i += 16
	s := ghash(hh, hl, aad, if enc { o[..] } else { d }); aes_block(a, j0[..], ks); tag byte[>..] ~= []
	for k 16: tag.push(s[k] ^ ks[k])
	return o, tag
aead_ok(alg int, key const byte[:], nonce const byte[:]) bool:
	if alg == AES_GCM: return (key.len == 16 || key.len == 24 || key.len == 32) && nonce.len > 0
	key.len == 32 && nonce.len == (if alg == XCHACHA20_POLY1305 { 24 } else { 12 })
cp_keys(alg int, key const byte[:], nonce const byte[:]) byte[>..], byte[>..]:
	k byte[>..] ~= []; n byte[>..] ~= []
	if alg == XCHACHA20_POLY1305 { k = hchacha20(key, nonce[..16]); n.append([0 as byte, 0, 0, 0][..]); n.append(nonce[16..24]) } else { k.append(key); n.append(nonce) }
	return k, n
aead_seal(alg int, key const byte[:], nonce const byte[:], aad const byte[:], pt const byte[:]) byte[>..], bool:
	e byte[>..] ~= []
	if !aead_ok(alg, key, nonce): return e, false
	if alg == AES_GCM: o, t := gcm_core(key, nonce, aad, pt, true); r ~= copy(o); r.append(t[..]); return r, true
	k, n := cp_keys(alg, key, nonce); o ~= chacha20(k[..], n[..], 1, pt); t := cp_tag(k[..], n[..], aad, o[..]); o.append(t[..])
	return o, true
aead_open(alg int, key const byte[:], nonce const byte[:], aad const byte[:], ct const byte[:]) byte[>..], bool:
	e byte[>..] ~= []
	if !aead_ok(alg, key, nonce) || ct.len < 16: return e, false
	body := ct[..ct.len - 16]; tag := ct[ct.len - 16..]
	if alg == AES_GCM:
		o, t := gcm_core(key, nonce, aad, body, false)
		if !ct_eq(t[..], tag): return e, false
		return o, true
	k, n := cp_keys(alg, key, nonce)
	if !ct_eq(cp_tag(k[..], n[..], aad, body)[..], tag): return e, false
	return chacha20(k[..], n[..], 1, body), true
