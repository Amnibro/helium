}
fn peek32() int {
	var v = 0;
	let nbytes = bend >> 3;
	for i in 5 {
		let p = (bp >> 3) + i;
		if p < nbytes { v |= (pkt[pbase + p] as int) << (8 * i); }
	}
	(v >> (bp & 7)) & 0xFFFFFFFF
}
fn bits(n int) int {
	if bp + n > bend {
		eop = true;
		bp = bend;
		return 0;
	}
	let v = peek32() & ((1 << n) - 1);
	bp += n;
	v
}
fn ilog(x int) int {
	var r = 0;
	var v = x;
	while v > 0 { r++; v = v >> 1; }
	r
}
fn unpack(x int) real {
	var m = x & 0x1FFFFF;
	if (x & 0x80000000) != 0 { m = -m; }
	let e = (x >> 21) & 1023;
