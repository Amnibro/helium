	for i in d {
		p *= r;
		if p > n { return false; }
	}
	true
}
fn book(b int) bool {
	if bits(24) != 0x564342 { return fail("bad codebook sync"); }
	let dim = bits(16);
	let n = bits(24);
	if dim < 1 || n < 1 { return fail("bad codebook size"); }
	let lo = clen.len;
	if bits(1) == 0 {
		let sparse = bits(1);
		for i in n {
			if eop { return fail("setup header ends early"); }
			if sparse != 0 && bits(1) == 0 { clen.push(0); } else { clen.push(bits(5) + 1); }
		}
	} else {
		var cl = bits(5) + 1;
		var filled = 0;
		while filled < n {
			if eop { return fail("setup header ends early"); }
			let cnt = bits(ilog(n - filled));
			if filled + cnt > n { return fail("bad codebook lengths"); }
			for i in cnt { clen.push(cl); }
			filled += cnt;
			cl++;
		}
	}
	for i in n {
		if clen[lo + i] > 32 { return fail("bad codebook lengths"); }
	}
	let co = ccode.len;
	let fo = cfast.len;
	for i in 1024 { cfast.push(0); }
	let lg = clong.len;
	var nl = 0;
