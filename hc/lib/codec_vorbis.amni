	}
	if eop { return fail("setup header ends early"); }
	cb_dim.push(dim);
	cb_n.push(n);
	cb_len.push(lo);
	cb_code.push(co);
	cb_fast.push(fo);
	cb_long.push(lg);
	cb_nlong.push(nl);
	cb_vq.push(vo);
	true
}
fn decode_entry(b int) int {
	let v = peek32();
	let f = cfast[cb_fast[b] + (v & 1023)];
	if f > 0 {
		let l = clen[cb_len[b] + f - 1];
		if bp + l > bend {
			eop = true;
			return -1;
		}
		bp += l;
		return f - 1;
	}
	let lg = cb_long[b];
	for i in cb_nlong[b] {
		let e = clong[lg + i];
		let l = clen[cb_len[b] + e];
		if (v & ((1 << l) - 1)) == ccode[cb_code[b] + e] {
			if bp + l > bend {
				eop = true;
				return -1;
			}
			bp += l;
			return e;
		}
	}
	eop = true;
	return -1;
}
var fl_np int[>..];
var fl_pc int[>..];
var fl_mult int[>..];
var fl_x int[>..];
var fl_nx int[>..];
var fpc int[>..];
var fx int[>..];
var fsort int[>..];
var flo int[>..];
var fhi int[>..];
var fcdim int[>..];
var fcsub int[>..];
var fcmaster int[>..];
var fcbook int[>..];
fn floor(f int) bool {
	let typ = bits(16);
	if typ == 0 { return fail("floor type 0 is not supported"); }
	if typ != 1 { return fail("bad floor type"); }
	let np = bits(5);
	let pco = fpc.len;
	var maxc = -1;
	for i in np {
		let c = bits(4);
		fpc.push(c);
		if c > maxc { maxc = c; }
	}
	while fcdim.len < (f + 1) * 16 {
		fcdim.push(0);
		fcsub.push(0);
		fcmaster.push(0);
	}
	while fcbook.len < (f + 1) * 128 { fcbook.push(-1); }
	for c in 0..(maxc + 1) {
		let k = f * 16 + c;
		fcdim[k] = bits(3) + 1;
		let sbits = bits(2);
		fcsub[k] = sbits;
		if sbits > 0 {
			let mb = bits(8);
			if mb >= cb_n.len { return fail("bad book number"); }
			fcmaster[k] = mb;
		}
		for j in (1 << sbits) {
			let bk = bits(8) - 1;
			if bk >= cb_n.len { return fail("bad book number"); }
			fcbook[k * 8 + j] = bk;
		}
	}
	let mult = bits(2) + 1;
	let rb = bits(4);
	let xo = fx.len;
	fx.push(0);
	fx.push(1 << rb);
	for p in np {
		let c = fpc[pco + p];
		for j in fcdim[f * 16 + c] { fx.push(bits(rb)); }
	}
	let nx = fx.len - xo;
	if nx > 65 { return fail("floor has too many points"); }
	for i in nx {
		for j in i {
			if fx[xo + i] == fx[xo + j] { return fail("bad floor points"); }
		}
	}
	for i in nx { fsort.push(i); }
	for i in 1..nx {
		let v = fsort[xo + i];
		var j = i - 1;
		while j >= 0 && fx[xo + fsort[xo + j]] > fx[xo + v] {
			fsort[xo + j + 1] = fsort[xo + j];
			j--;
		}
		fsort[xo + j + 1] = v;
	}
	for i in nx {
		var lw = 0;
		var hg = 1;
		if i >= 2 {
			var bl = -1;
			var bh = -1;
			let xi = fx[xo + i];
			for j in i {
				let xj = fx[xo + j];
				if xj < xi && (bl < 0 || xj > fx[xo + bl]) { bl = j; }
				if xj > xi && (bh < 0 || xj < fx[xo + bh]) { bh = j; }
			}
			lw = bl;
			hg = bh;
		}
		flo.push(lw);
		fhi.push(hg);
	}
	fl_np.push(np);
	fl_pc.push(pco);
	fl_mult.push(mult);
	fl_x.push(xo);
	fl_nx.push(nx);
	true
}
var fy int[>..];
var fused bool[>..];
fn floor_read(f int, ch int) {
	while fy.len < (ch + 1) * 72 { fy.push(0); }
	while fused.len <= ch { fused.push(false); }
	if bits(1) == 0 {
		fused[ch] = false;
		return;
	}
	let mult = fl_mult[f];
	let rng = if mult == 1 { 256 } else if mult == 2 { 128 } else if mult == 3 { 86 } else { 64 };
	let base = ch * 72;
	fy[base] = bits(ilog(rng - 1));
	fy[base + 1] = bits(ilog(rng - 1));
	var i = 2;
	for p in fl_np[f] {
		let c = fpc[fl_pc[f] + p];
		let k = f * 16 + c;
		let cbits = fcsub[k];
		let csub = (1 << cbits) - 1;
		var cval = 0;
		if cbits > 0 { cval = decode_entry(fcmaster[k]); }
		for j in fcdim[k] {
			let bk = fcbook[k * 8 + (cval & csub)];
			cval = cval >> cbits;
			if bk != -1 { fy[base + i] = decode_entry(bk); } else { fy[base + i] = 0; }
			i++;
		}
	}
	fused[ch] = !eop;
}
fn render_point(x0 int, y0 int, x1 int, y1 int, x int) int {
	let dy = y1 - y0;
	let off = abs(dy) * (x - x0) / (x1 - x0);
	if dy < 0 { y0 - off } else { y0 + off }
}
fn render_line(x0 int, y0 int, x1 int, y1 int, out f32[>..]&, at int, n int) {
	let dy = y1 - y0;
	let adx = x1 - x0;
	let base = dy / adx;
	let sy = if dy < 0 { base - 1 } else { base + 1 };
	let ady = abs(dy) - abs(base) * adx;
	var y = y0;
	var err = 0;
	var x = x0;
	if x0 < x1 && x0 < n { out[at + x0] = INVDB[clamp(y, 0, 255)]; }
	x++;
	while x < x1 && x < n {
		err += ady;
		if err >= adx {
			err -= adx;
			y += sy;
		} else {
			y += base;
		}
		out[at + x] = INVDB[clamp(y, 0, 255)];
		x++;
	}
}
fn floor_curve(f int, ch int, n2 int, out f32[>..]&, at int) {
	let mult = fl_mult[f];
	let rng = if mult == 1 { 256 } else if mult == 2 { 128 } else if mult == 3 { 86 } else { 64 };
	let xo = fl_x[f];
	let nx = fl_nx[f];
	let base = ch * 72;
	var fin int[72] = [0; 72];
	var stp bool[72] = [false; 72];
	stp[0] = true;
	stp[1] = true;
	fin[0] = fy[base];
	fin[1] = fy[base + 1];
	for i in 2..nx {
		let lw = flo[xo + i];
		let hg = fhi[xo + i];
		let pred = render_point(fx[xo + lw], fin[lw], fx[xo + hg], fin[hg], fx[xo + i]);
		let val = fy[base + i];
		let highroom = rng - pred;
		let lowroom = pred;
		let room = 2 * (if highroom < lowroom { highroom } else { lowroom });
		if val != 0 {
			stp[lw] = true;
			stp[hg] = true;
			stp[i] = true;
			if val >= room {
				fin[i] = if highroom > lowroom { val - lowroom + pred } else { pred - val + highroom - 1 };
			} else {
				fin[i] = if val % 2 == 1 { pred - (val + 1) / 2 } else { pred + val / 2 };
			}
		} else {
			fin[i] = pred;
		}
	}
	var lx = 0;
	var ly = fin[fsort[xo]] * mult;
	var hx = 0;
	var hy = 0;
	for s in 1..nx {
		let idx = fsort[xo + s];
		if stp[idx] {
			hy = fin[idx] * mult;
			hx = fx[xo + idx];
			render_line(lx, ly, hx, hy, out, at, n2);
			lx = hx;
			ly = hy;
		}
	}
	if hx < n2 { render_line(hx, hy, n2, hy, out, at, n2); }
}
var rs_type int[>..];
var rs_begin int[>..];
var rs_end int[>..];
var rs_psize int[>..];
var rs_ncls int[>..];
var rs_book int[>..];
var rs_books int[>..];
fn residue(r int) bool {
	let typ = bits(16);
	if typ > 2 { return fail("bad residue type"); }
	let bg = bits(24);
	let en = bits(24);
	let ps = bits(24) + 1;
	let nc = bits(6) + 1;
	let cb = bits(8);
	if cb >= cb_n.len { return fail("bad book number"); }
	var casc int[64] = [0; 64];
	for c in nc {
		var cs = bits(3);
		if bits(1) != 0 { cs += bits(5) * 8; }
		casc[c] = cs;
	}
	while rs_books.len < (r + 1) * 512 { rs_books.push(-1); }
	for c in nc {
		for j in 8 {
			if ((casc[c] >> j) & 1) != 0 {
				let bk = bits(8);
				if bk >= cb_n.len { return fail("bad book number"); }
				rs_books[(r * 64 + c) * 8 + j] = bk;
			}
		}
	}
	rs_type.push(typ);
	rs_begin.push(bg);
	rs_end.push(en);
	rs_psize.push(ps);
	rs_ncls.push(nc);
	rs_book.push(cb);
	true
}
var chans int = 0;
var mp_sub int[>..];
var mp_ncp int[>..];
var mp_cp int[>..];
var cmag int[>..];
var cang int[>..];
var mux int[>..];
var smfloor int[>..];
var smres int[>..];
fn mapping(m int) bool {
	if bits(16) != 0 { return fail("bad mapping type"); }
	var sub = 1;
	if bits(1) != 0 { sub = bits(4) + 1; }
	var ncp = 0;
	let cpo = cmag.len;
	if bits(1) != 0 {
		ncp = bits(8) + 1;
		let cbn = ilog(chans - 1);
		for i in ncp {
			let mg = bits(cbn);
			let an = bits(cbn);
			if mg == an || mg >= chans || an >= chans { return fail("bad channel coupling"); }
			cmag.push(mg);
			cang.push(an);
		}
	}
	if bits(2) != 0 { return fail("bad mapping type"); }
	while mux.len < (m + 1) * 255 { mux.push(0); }
	if sub > 1 {
		for ch in chans {
			let mx = bits(4);
			if mx >= sub { return fail("bad mapping submap"); }
			mux[m * 255 + ch] = mx;
		}
	}
	while smfloor.len < (m + 1) * 16 {
		smfloor.push(0);
		smres.push(0);
	}
	for s in sub {
		bits(8);
		let fl = bits(8);
		let rs = bits(8);
		if fl >= fl_np.len || rs >= rs_type.len { return fail("bad mapping floor or residue"); }
		smfloor[m * 16 + s] = fl;
		smres[m * 16 + s] = rs;
	}
	mp_sub.push(sub);
	mp_ncp.push(ncp);
	mp_cp.push(cpo);
	true
}
var md_block int[>..];
var md_map int[>..];
fn mode(i int) bool {
	let bf = bits(1);
	let wt = bits(16);
	let tt = bits(16);
	if wt != 0 || tt != 0 { return fail("bad mode"); }
	let mp = bits(8);
	if mp >= mp_sub.len { return fail("bad mode"); }
	md_block.push(bf);
	md_map.push(mp);
	true
}
var rate int = 0;
var bs0 int = 0;
var bs1 int = 0;
var nmodes int = 0;
fn pb(k int, i int) int { pkt[pk_at[k] + i] as int }
fn vtag(k int) bool {
	pk_len[k] >= 7 && pb(k, 1) == 118 && pb(k, 2) == 111 && pb(k, 3) == 114 && pb(k, 4) == 98 && pb(k, 5) == 105 && pb(k, 6) == 115
}
fn headers() bool {
	cb_dim.clear();
	cb_n.clear();
	cb_len.clear();
	cb_code.clear();
	cb_fast.clear();
	cb_long.clear();
	cb_nlong.clear();
	cb_vq.clear();
	clen.clear();
	ccode.clear();
	cfast.clear();
	clong.clear();
	cvq.clear();
	fl_np.clear();
	fl_pc.clear();
	fl_mult.clear();
	fl_x.clear();
	fl_nx.clear();
	fpc.clear();
	fx.clear();
	fsort.clear();
	flo.clear();
	fhi.clear();
	fcdim.clear();
	fcsub.clear();
	fcmaster.clear();
	fcbook.clear();
	rs_type.clear();
	rs_begin.clear();
	rs_end.clear();
	rs_psize.clear();
	rs_ncls.clear();
	rs_book.clear();
	rs_books.clear();
	mp_sub.clear();
	mp_ncp.clear();
	mp_cp.clear();
	cmag.clear();
	cang.clear();
	mux.clear();
	smfloor.clear();
	smres.clear();
	md_block.clear();
	md_map.clear();
	if pk_len[0] < 30 || !vtag(0) || pb(0, 0) != 1 { return fail("not a Vorbis stream"); }
	let ver = pb(0, 7) | (pb(0, 8) << 8) | (pb(0, 9) << 16) | (pb(0, 10) << 24);
	if ver != 0 { return fail("not a Vorbis stream"); }
	chans = pb(0, 11);
	if chans == 0 { return fail("bad identification header"); }
	rate = pb(0, 12) | (pb(0, 13) << 8) | (pb(0, 14) << 16) | (pb(0, 15) << 24);
	if rate == 0 { return fail("bad identification header"); }
	let bb = pb(0, 28);
	bs0 = 1 << (bb & 15);
	bs1 = 1 << (bb >> 4);
	if bs0 < 64 || bs0 > 8192 || bs1 < 64 || bs1 > 8192 || bs0 > bs1 { return fail("bad block sizes"); }
	if (pb(0, 29) & 1) != 1 { return fail("bad identification header"); }
	if !vtag(1) || pb(1, 0) != 3 { return fail("bad comment header"); }
	if !vtag(2) || pb(2, 0) != 5 { return fail("bad setup header"); }
	bstart(2, 7);
	let nb = bits(8) + 1;
	for i in nb {
		if !book(i) { return false; }
	}
	let nt = bits(6) + 1;
	for i in nt {
		if bits(16) != 0 { return fail("bad setup header"); }
	}
	let nf = bits(6) + 1;
	for i in nf {
		if !floor(i) { return false; }
	}
	let nr = bits(6) + 1;
	for i in nr {
		if !residue(i) { return false; }
	}
	let nm = bits(6) + 1;
	for i in nm {
		if !mapping(i) { return false; }
	}
	nmodes = bits(6) + 1;
	for i in nmodes {
		if !mode(i) { return false; }
	}
	if bits(1) != 1 || eop { return fail("bad setup header"); }
	true
}
var win0 f32[>..];
var win1 f32[>..];
fn slope(n int) f32[>..] {
	var r f32[>..] = [];
	let h = n / 2;
	for i in h {
		let s = sin(PI * 0.5 * (((i as real) + 0.5) / (h as real)));
		r.push(sin(PI * 0.5 * s * s) as f32);
	}
	r
}
var fre f32[>..];
var fim f32[>..];
var wcs f32[>..];
var wsn f32[>..];
fn fft(re f32[>..]&, im f32[>..]&, n int) {
	var j = 0;
	for i in 1..n {
		var bt = n >> 1;
		while (j & bt) != 0 {
			j = j ^ bt;
			bt = bt >> 1;
		}
		j = j ^ bt;
		if i < j {
			let t = re[i];
			re[i] = re[j];
			re[j] = t;
			let u = im[i];
			im[i] = im[j];
			im[j] = u;
		}
	}
	var sp = 2;
	while sp <= n {
		let half = sp / 2;
		for k in half {
			let ang = TAU * (k as real) / (sp as real);
			let wr = cos(ang) as f32;
			let wi = (-sin(ang)) as f32;
			var i = k;
			while i < n {
				let b = i + half;
				let tr = re[b] * wr - im[b] * wi;
				let ti = re[b] * wi + im[b] * wr;
				re[b] = re[i] - tr;
				im[b] = im[i] - ti;
				re[i] = re[i] + tr;
				im[i] = im[i] + ti;
				i += sp;
			}
		}
		sp = sp * 2;
	}
}
fn imdct(x const f32[:], xat int, n int, out f32[>..]&) {
	while out.len < n { out.push(0.0); }
	let m = n / 2;
	let h = m / 2;
	let q = m / 4;
	while fre.len < h {
		fre.push(0.0);
		fim.push(0.0);
	}
	while wcs.len < h {
		wcs.push(0.0);
		wsn.push(0.0);
	}
	for k in h {
		let w = PI / (m as real) * ((k as real) + 0.125);
		let c = cos(w);
		let s = sin(w);
		wcs[k] = c as f32;
		wsn[k] = s as f32;
		let ev = x[xat + 2 * k] as real;
		let od = -(x[xat + m - 1 - 2 * k] as real);
		fre[k] = (od * s - ev * c) as f32;
		fim[k] = (od * c + ev * s) as f32;
	}
	fft(fre, fim, h);
	for k in h {
		let vr = wcs[k] * fre[k] + wsn[k] * fim[k];
		let vi = wsn[k] * fre[k] - wcs[k] * fim[k];
		if k < q {
			let fi = 2 * k;
			let ri = h - 1 - 2 * k;
			out[ri] = -vi;
			out[h + fi] = vi;
			out[2 * h + ri] = vr;
			out[3 * h + fi] = vr;
		} else {
			let fi = 2 * (k - q);
			let ri = h - 1 - fi;
			out[fi] = -vr;
			out[h + ri] = vr;
			out[2 * h + fi] = vi;
			out[3 * h + ri] = vi;
		}
	}
}
fn imdct_into(x const f32[:], out f32[>..]&) {
	imdct(x, 0, x.len * 2, out);
}
var dnd bool[>..];
var rv f32[>..];
var rtmp f32[>..];
var rcls int[>..];
var rvec int[>..];
var to_tmp bool = false;
fn tadd(i int, v f32) {
	if to_tmp {
		if i < rtmp.len { rtmp[i] = rtmp[i] + v; }
	} else {
		if i < rv.len { rv[i] = rv[i] + v; }
	}
}
fn decode_part(bk int, fmt int, v int, off int, psize int) bool {
	let d = cb_dim[bk];
	let vo = cb_vq[bk];
	if vo < 0 { return false; }
	let base = rvec[v];
	if fmt == 0 {
		let n = psize / d;
		for j in n {
			let e = decode_entry(bk);
			if e == -1 { return false; }
			for k in d { tadd(base + off + j + k * n, cvq[vo + e * d + k]); }
		}
	} else {
		var i = 0;
		while i < psize {
			let e = decode_entry(bk);
			if e == -1 { return false; }
			for k in d { tadd(base + off + i + k, cvq[vo + e * d + k]); }
			i += d;
		}
	}
	true
}
fn res_decode(r int, fmt int, nvec int, size int) {
	let bgn = if rs_begin[r] < size { rs_begin[r] } else { size };
	let fin = if rs_end[r] < size { rs_end[r] } else { size };
	let psize = rs_psize[r];
	let cbk = rs_book[r];
	let cw = cb_dim[cbk];
	let ncls = rs_ncls[r];
	let parts = (fin - bgn) / psize;
	if parts <= 0 { return; }
	while rcls.len < nvec * (parts + cw) { rcls.push(0); }
	for ps in 8 {
		var p = 0;
		while p < parts {
			if ps == 0 {
				for v in nvec {
					var temp = decode_entry(cbk);
					if temp == -1 { return; }
					for i in cw {
						let ii = cw - 1 - i;
						rcls[v * (parts + cw) + ii + p] = temp % ncls;
						temp = temp / ncls;
					}
				}
			}
			var i = 0;
			while i < cw && p < parts {
				for v in nvec {
					let cl = rcls[v * (parts + cw) + p];
					let bk = rs_books[(r * 64 + cl) * 8 + ps];
					if bk != -1 {
						if !decode_part(bk, fmt, v, bgn + p * psize, psize) { return; }
					}
				}
				p++;
				i++;
			}
		}
	}
}
fn residue_read(r int, chs const int[:], n2 int) {
	let nch = chs.len;
	let typ = rs_type[r];
	let half1 = bs1 / 2;
	let fmt = if typ == 0 { 0 } else { 1 };
	rvec.clear();
	if typ == 2 {
		var all = true;
		for c in chs {
			if !dnd[c] { all = false; }
		}
		if all { return; }
		let size = nch * n2;
		rtmp.clear();
		for i in size { rtmp.push(0.0); }
		rvec.push(0);
		to_tmp = true;
		res_decode(r, fmt, 1, size);
		to_tmp = false;
		for i in size { rv[chs[i % nch] * half1 + i / nch] = rtmp[i]; }
	} else {
		for c in chs {
			if !dnd[c] { rvec.push(c * half1); }
		}
		if rvec.len == 0 { return; }
		to_tmp = false;
		res_decode(r, fmt, rvec.len, n2);
	}
}
var flr f32[>..];
var ibuf f32[>..];
var ovl f32[>..];
var prev int = 0;
fn clamp1(v f32) f32 { if v > 1.0 { 1.0 } else if v < -1.0 { -1.0 } else { v } }
fn wv(big bool, i int) f32 { if big { win1[i] } else { win0[i] } }
fn packet(k int, out f32[>..]&) int {
	if pk_len[k] == 0 { return 0; }
	bstart(k, 0);
	if bits(1) != 0 { return 0; }
	let md = bits(ilog(nmodes - 1));
	if md >= nmodes { return 0; }
	let bf = md_block[md];
	let n = if bf == 1 { bs1 } else { bs0 };
	if bf == 1 { bits(2); }
	let n2 = n / 2;
	let mp = md_map[md];
	let half1 = bs1 / 2;
	let chn = chans;
	let need = chn * half1;
	while flr.len < need { flr.push(0.0); }
	while rv.len < need { rv.push(0.0); }
	while ovl.len < need { ovl.push(0.0); }
	while dnd.len < chn { dnd.push(false); }
	for ch in chn {
		let fl = smfloor[mp * 16 + mux[mp * 255 + ch]];
		floor_read(fl, ch);
		dnd[ch] = !fused[ch];
		if fused[ch] {
			floor_curve(fl, ch, n2, flr, ch * half1);
		} else {
			for i in n2 { flr[ch * half1 + i] = 0.0; }
		}
	}
	let ncp = mp_ncp[mp];
	let cpo = mp_cp[mp];
	for s in ncp {
		let mg = cmag[cpo + s];
		let an = cang[cpo + s];
		if dnd[mg] != dnd[an] {
			dnd[mg] = false;
			dnd[an] = false;
		}
	}
	for ch in chn {
		for i in n2 { rv[ch * half1 + i] = 0.0; }
	}
	for s in mp_sub[mp] {
		var cs int[>..] = [];
		for ch in chn {
			if mux[mp * 255 + ch] == s { cs.push(ch); }
		}
		residue_read(smres[mp * 16 + s], cs, n2);
	}
	for st in ncp {
		let s = ncp - 1 - st;
		let mg = cmag[cpo + s];
		let an = cang[cpo + s];
		for i in n2 {
			let m = rv[mg * half1 + i];
			let a = rv[an * half1 + i];
			var nm = m;
			var na = a;
			if m > 0.0 {
				if a > 0.0 {
					nm = m;
					na = m - a;
				} else {
					nm = m + a;
					na = m;
				}
			} else {
				if a > 0.0 {
					nm = m;
					na = m + a;
				} else {
					nm = m - a;
					na = m;
				}
			}
			rv[mg * half1 + i] = nm;
			rv[an * half1 + i] = na;
		}
	}
	for ch in chn {
		if !dnd[ch] {
			for i in n2 { flr[ch * half1 + i] = flr[ch * half1 + i] * rv[ch * half1 + i]; }
		}
	}
	var frames f32[>..] = [];
	let fc = if prev != 0 { prev / 4 + n / 4 } else { 0 };
	for i in fc * chn { frames.push(0.0); }
	for ch in chn {
		imdct(flr, ch * half1, n, ibuf);
		let ob = ch * half1;
		if prev != 0 {
			if prev == n {
				let big = (n == bs1);
				for i in n2 {
					frames[i * chn + ch] = clamp1(ovl[ob + i] * wv(big, n2 - 1 - i) + ibuf[i] * wv(big, i));
				}
			} else if prev == bs1 {
				let start = (bs1 - bs0) / 4;
				let h0 = bs0 / 2;
				for i in start { frames[i * chn + ch] = clamp1(ovl[ob + i]); }
				for i in h0 {
					frames[(start + i) * chn + ch] = clamp1(ovl[ob + start + i] * win0[h0 - 1 - i] + ibuf[i] * win0[i]);
				}
			} else {
				let start = (bs1 - bs0) / 4;
				let h0 = bs0 / 2;
				for i in h0 {
					frames[i * chn + ch] = clamp1(ovl[ob + i] * win0[h0 - 1 - i] + ibuf[start + i] * win0[i]);
				}
				var j = h0;
				while start + j < half1 {
					frames[j * chn + ch] = clamp1(ibuf[start + j]);
					j++;
				}
			}
		}
		for i in n2 { ovl[ob + i] = ibuf[n2 + i]; }
	}
	prev = n;
	if fc > 0 { out.append(frames); }
	fc
}
fn decode(data const byte[:], pcm f32[>..]&) int, int, bool {
	pcm.clear();
	src.clear();
	src.append(data);
	if !pages() { return 0, 0, false; }
	if !headers() { return 0, 0, false; }
	prev = 0;
	win0 = slope(bs0);
	win1 = slope(bs1);
	ovl.clear();
	var total = 0;
	var skip = 0;
	var first_gran = 0;
	var seen = false;
	var last_g = -1;
	var have_last = false;
	for k in 3..pk_at.len {
		let c = packet(k, pcm);
		total += c;
		let g = pk_gran[k];
		if g != -1 {
			if !seen {
				seen = true;
				if !pk_last[k] && total > g {
					skip = total - g;
					first_gran = 0;
				} else {
					first_gran = if g - total > 0 { g - total } else { 0 };
				}
			}
			last_g = g;
			have_last = true;
		}
	}
	let ch = chans;
	let nfr = pcm.len / ch;
	if skip > nfr { skip = nfr; }
	var keep = nfr - skip;
	if have_last {
		let lim = last_g - first_gran;
		if lim >= 0 && lim < keep { keep = lim; }
	}
	if skip > 0 {
		for i in keep * ch { pcm[i] = pcm[skip * ch + i]; }
	}
	pcm.resize(keep * ch, 0.0);
	return chans, rate, true;
}
fn is_vorbis(b const byte[:]) bool {
	b.len >= 35 && b[0] == 79 && b[1] == 103 && b[2] == 103 && b[3] == 83 && b[28] == 1 && b[29] == 118 && b[30] == 111 && b[31] == 114 && b[32] == 98 && b[33] == 105 && b[34] == 115
}
