	var first = true;
	for e in n {
		let l = clen[lo + e];
		if l == 0 {
			ccode.push(0);
			continue;
		}
		var res = 0;
		if first {
			first = false;
			for i in 1..(l + 1) { avail[i] = 1 << (32 - i); }
		} else {
			var z = l;
			while z > 0 && avail[z] == 0 { z--; }
			if z == 0 { return fail("bad codebook lengths"); }
			res = avail[z];
			avail[z] = 0;
			var y = l;
			while y > z {
				avail[y] = res + (1 << (32 - y));
				y--;
			}
		}
		var rv = 0;
		for k in 32 {
			if ((res >> k) & 1) != 0 { rv |= 1 << (31 - k); }
		}
		let c = rv & ((1 << l) - 1);
		ccode.push(c);
		if l <= 10 {
			let st = 1 << l;
			var s = c;
			while s < 1024 {
				cfast[fo + s] = e + 1;
				s += st;
			}
		} else {
			clong.push(e);
			nl++;
		}
	}
	var vo = -1;
	let typ = bits(4);
	if typ == 1 || typ == 2 {
		let mn = unpack(bits(32)) as f32;
		let dl = unpack(bits(32)) as f32;
		let vb = bits(4) + 1;
		let seq = bits(1);
		var r = 1;
		var lv = 0;
		if typ == 1 {
			r = pow(n as real, 1.0 / (dim as real)) as int;
			if r < 1 { r = 1; }
			while pow_fits(r + 1, dim, n) { r++; }
			while r > 1 && !pow_fits(r, dim, n) { r--; }
			lv = r;
		} else {
			lv = n * dim;
		}
		var mult int[>..] = [];
		for i in lv {
			if eop { return fail("setup header ends early"); }
			mult.push(bits(vb));
		}
		vo = cvq.len;
		for e in n {
