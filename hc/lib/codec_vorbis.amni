var src byte[>..];
fn fail(reason const byte[:]) bool {
	why.clear();
	why.append(reason);
	false
}
fn error() const byte[:] { why }
fn sb(at int) int { src[at] as int }
var pkt byte[>..];
var pk_at int[>..];
var pk_len int[>..];
var pk_gran int[>..];
var pk_last bool[>..];
var cur byte[>..];
fn pages() bool {
	pkt.clear();
	pk_at.clear();
	pk_len.clear();
	pk_gran.clear();
	pk_last.clear();
	cur.clear();
	let n = src.len;
	var at = 0;
	var serial = -1;
	var pstart = 0;
	while at + 27 <= n {
		if sb(at) != 79 || sb(at + 1) != 103 || sb(at + 2) != 103 || sb(at + 3) != 83 { break; }
		if sb(at + 4) != 0 { break; }
		let flags = sb(at + 5);
		var g = 0;
		for i in 8 { g |= sb(at + 6 + i) << (8 * i); }
		let ser = sb(at + 14) | (sb(at + 15) << 8) | (sb(at + 16) << 16) | (sb(at + 17) << 24);
		let nseg = sb(at + 26);
		if at + 27 + nseg > n { break; }
		var body = 0;
		for i in nseg { body += sb(at + 27 + i); }
		let bstart = at + 27 + nseg;
		if bstart + body > n { break; }
		if serial < 0 { serial = ser; }
		var used = false;
		if ser == serial {
			used = true;
			pstart = pk_at.len;
			var bo = bstart;
			var lastfin = -1;
			for i in nseg {
				let l = sb(at + 27 + i);
				cur.append(src[bo..bo + l]);
				bo += l;
				if l < 255 {
					pk_at.push(pkt.len);
					pk_len.push(cur.len);
					pkt.append(cur);
					pk_gran.push(-1);
					pk_last.push(false);
					cur.clear();
					lastfin = pk_at.len - 1;
				}
			}
			if lastfin >= 0 && g != -1 { pk_gran[lastfin] = g; }
		}
		at = bstart + body;
		if used && (flags & 4) != 0 { break; }
	}
	for i in pstart..pk_at.len { pk_last[i] = true; }
	if pk_at.len == 0 { return fail("no Ogg pages"); }
	if pk_at.len < 3 { return fail("too few Vorbis headers"); }
	true
}
var bp int = 0;
var bend int = 0;
var pbase int = 0;
var eop bool = false;
fn bstart(k int, skip int) {
	pbase = pk_at[k];
	bend = pk_len[k] * 8;
