import std;
struct dictionary_slot<K, V> { key K, val V, tag u32 }
struct dictionary<K, V> { count int = 0, slots dictionary_slot<K, V>[>..<] = [] }
fn dict_tag(h uint) u32 { (h as! u32) | 2147483648 }
fn dict_probe<K, V>(d dictionary<K, V>&, key K) int {
	if d.count == 0 { return -1; }
	let h = hash(key);
	let tag = dict_tag(h);
	let mask = d.slots.len - 1;
	var i = (h & (mask as uint)) as int;
	loop {
		let t = d.slots[i].tag;
		if t == tag {
			if d.slots[i].key == key { return i; }
		} else if t == 0 {
			return -1;
		}
		i = (i + 1) & mask;
	}
}
fn dict_slot<K, V>(d dictionary<K, V>&, key K, h uint) int {
	let tag = dict_tag(h);
	let mask = d.slots.len - 1;
	var i = (h & (mask as uint)) as int;
	loop {
		let t = d.slots[i].tag;
		if t == tag {
			if d.slots[i].key == key { return i; }
		} else if t == 0 {
			return i;
		}
		i = (i + 1) & mask;
	}
}
fn dict_room<K, V>(d dictionary<K, V>&) {
	if d.slots.len == 0 {
		dict_grow(d, 8);
	} else if (d.count + 1) * 3 > d.slots.len * 2 {
		dict_grow(d, d.slots.len * 2);
	}
}
fn dict_grow<K, V>(d dictionary<K, V>&, cap int) {
	let old = d.slots.len;
	d.slots.resize(cap, dictionary_slot<K, V> { default<K>(), default<V>(), 0 });
	if d.count == 0 { return; }
	let mask = cap - 1;
	var s = 0;
	while d.slots[s].tag != 0 { s += 1; }
	for k in 1..old {
		var p = s + k;
		if p >= old { p -= old; }
		let t = d.slots[p].tag;
		if t != 0 {
			var q = (t as int) & mask;
			if mask >= 2147483648 { q = (hash(d.slots[p].key) & (mask as uint)) as int; }
			let e = d.slots[p];
			d.slots[p].tag = 0;
			while d.slots[q].tag != 0 { q = (q + 1) & mask; }
			d.slots[q] = e;
		}
	}
}
fn get<K, V>(d dictionary<K, V>&, key K) V? {
	let i = dict_probe(d, key);
	if i < 0 { return null; }
	return d.slots[i].val;
}
fn contains<K, V>(d dictionary<K, V>&, key K) bool { dict_probe(d, key) >= 0 }
fn insert<K, V>(d dictionary<K, V>&, key K, val V) bool {
	dict_room(d);
	let h = hash(key);
	let i = dict_slot(d, key, h);
	if d.slots[i].tag != 0 {
		d.slots[i] = dictionary_slot<K, V> { d.slots[i].key, val, d.slots[i].tag };
		return false;
	}
	d.slots[i] = dictionary_slot<K, V> { key, val, dict_tag(h) };
	d.count += 1;
	return true;
}
fn get_or_insert<K, V>(d dictionary<K, V>&, key K, v0 V) V& {
	dict_room(d);
	let h = hash(key);
	let i = dict_slot(d, key, h);
	if d.slots[i].tag == 0 {
		d.slots[i] = dictionary_slot<K, V> { key, v0, dict_tag(h) };
		d.count += 1;
	}
	return d.slots[i].val;
}
fn update<K, V, F>(d dictionary<K, V>&, key K, v0 V) {
	dict_room(d);
	let h = hash(key);
	let i = dict_slot(d, key, h);
	if d.slots[i].tag == 0 {
		d.slots[i] = dictionary_slot<K, V> { key, v0, dict_tag(h) };
		d.count += 1;
	}
	F(&d.slots[i].val);
}
fn remove<K, V>(d dictionary<K, V>&, key K) bool {
	var i = dict_probe(d, key);
	if i < 0 { return false; }
	let mask = d.slots.len - 1;
	var j = i;
	loop {
		j = (j + 1) & mask;
		let t = d.slots[j].tag;
		if t == 0 { break; }
		var h = (t as int) & mask;
		if mask >= 2147483648 { h = (hash(d.slots[j].key) & (mask as uint)) as int; }
		if ((j - h) & mask) >= ((j - i) & mask) {
			d.slots[i] = d.slots[j];
			i = j;
		}
	}
	d.slots[i] = dictionary_slot<K, V> { default<K>(), default<V>(), 0 };
	d.count -= 1;
	return true;
}
fn clear<K, V>(d dictionary<K, V>&) {
	for &s in d.slots { s.tag = 0; }
	d.count = 0;
}
fn reserve<K, V>(d dictionary<K, V>&, n int) {
	let need = max(next_pow2((n * 3 + 1) / 2), 8);
	if need > d.slots.len { dict_grow(d, need); }
}
fn each<K, V, F>(d dictionary<K, V>&) {
	for &s in d.slots { if s.tag != 0 { F(s.key, &s.val); } }
}
