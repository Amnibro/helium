namespace js
use json
use math
num_str(x real) byte[>..]:
	out byte[>..] ~= []
	if is_nan(x): out.append("NaN"); return out
	if x == 0.0: out.append("0"); return out
	if is_inf(x):
		if x < 0.0: out.append("-Infinity") else: out.append("Infinity")
		return out
	if x < 0.0: out.push('-')
	digits byte[>..] ~= []
	e := json::digits_of(fabs(x), digits)
	k := digits.len
	n := e + 1
	if n >= 1 && n <= 21:
		if k <= n:
			out.append(digits)
			for i n - k: out.push('0')
		else:
			out.append(digits[..n])
			out.push('.')
			out.append(digits[n..])
	else if n >= -5 && n <= 0:
		out.append("0.")
		for i -n: out.push('0')
		out.append(digits)
	else:
		out.push(digits[0])
		if k > 1:
			out.push('.')
			out.append(digits[1..])
		out.push('e')
		m := n - 1
		if m < 0: out.push('-'); m = -m else: out.push('+')
		format(out, m)
	return out
to_fixed(x real, digits int) byte[>..]:
	if is_nan(x):
		out byte[>..] ~= []
		out.append("NaN")
		return out
	if fabs(x) >= 1e21: return num_str(x)
	out byte[>..] ~= []
	if x < 0.0: out.push('-')
	format_flt(out, fabs(x), digits, true)
	return out
locale_string(x real, max_digits int) byte[>..]:
	out byte[>..] ~= []
	if is_nan(x): out.append("NaN"); return out
	if is_inf(x):
		if x < 0.0: out.append("-∞") else: out.append("∞")
		return out
	neg := x < 0.0 || (x == 0.0 && 1.0 / x < 0.0)
	digits byte[>..] ~= []
	e ~= 0
	if x == 0.0: digits.push('0') else: e = json::digits_of(fabs(x), digits)
	n := e + 1
	k := digits.len
	ds byte[>..<] ~= []
	p ~= 0
	if n <= 0:
		for i 1 - n: ds.push('0')
		ds.append(digits)
		p = 1
	else:
		ds.append(digits)
		for i n - k: ds.push('0')
		p = n
	keep := p + max_digits
	if ds.len > keep:
		up := ds[keep] >= '5'
		ds.resize(keep, 0)
		if up:
			i ~= keep - 1
			while i >= 0:
				if ds[i] == '9': ds[i] = '0'; i -= 1 else: ds[i] = ds[i] + 1; break
			if i < 0: ds.insert_at(0, '1'); p += 1
	fe ~= ds.len
	while fe > p && ds[fe - 1] == '0': fe -= 1
	if neg: out.push('-')
	for i p:
		if i > 0 && (p - i) % 3 == 0: out.push(',')
		out.push(ds[i])
	if fe > p:
		out.push('.')
		for i p..fe: out.push(ds[i])
	return out
fixed_locale(x real, digits int, or_zero bool = false) byte[>..]:
	if digits >= 0 && digits <= 15:
		w, f, ok := fixed_parts(fabs(x), digits, true)
		if ok && w < json::P10D[15 - digits]:
			buf byte[32] ~= [0; 32]
			at ~= 32
			ff ~= f
			nd ~= digits
			while nd > 0 && ff % 10 == 0: ff /= 10; nd -= 1
			for i nd: at -= 1; buf[at] = (48 + ff % 10) as byte; ff /= 10
			if nd > 0: at -= 1; buf[at] = '.'
			ww ~= w
			c ~= 0
			if ww == 0: at -= 1; buf[at] = '0'
			while ww > 0:
				if c > 0 && c % 3 == 0: at -= 1; buf[at] = ','
				at -= 1
				buf[at] = (48 + ww % 10) as byte
				ww /= 10
				c += 1
			if x < 0.0 && !(or_zero && w == 0 && f == 0): at -= 1; buf[at] = '-'
			res byte[>..] ~= []
			res.append(buf[at..])
			return res
	s := to_fixed(x, digits)
	pv, pok := parse_flt(s)
	v ~= pv
	if is_inf(x): v = x
	if or_zero && (is_nan(v) || v == 0.0): v = 0.0
	return locale_string(v, digits)
