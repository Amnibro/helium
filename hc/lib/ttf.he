	c ~= Cs{}; d := f.d[..]; bad ~= true
	if g < 0 || g >= ru16(d, f.cs): return c.vs
	p0, n0 := ix_item(d, f.cs, g); p ~= p0; e ~= p0 + n0; s f32[48] ~= [0.0; 48]; sp ~= 0; rp int[10] ~= [0; 10]; re int[10] ~= [0; 10]; rh ~= 0
	hdr ~= true; mb ~= 0; subs ~= f.sub; hs ~= false
	while p < e:
		b0 := d[p] as int; p += 1; i ~= 0; clr ~= true
		if b0 == 28 || b0 >= 32:
			if sp >= 48: break
			if b0 == 255 { v := ru32(d, p); p += 4; s[sp] = (if v >= 0x80000000 { v - 0x100000000 } else { v }) as f32 / 65536.0 } else { v, np := dnum(d, p - 1); p = np; s[sp] = v as f32 }
			sp += 1; clr = false
		else if b0 == 19 || b0 == 20:
			if hdr: mb += sp / 2
			hdr = false; p += (mb + 7) / 8
		else if b0 == 1 || b0 == 3 || b0 == 18 || b0 == 23: mb += sp / 2
		else if b0 == 21:
			hdr = false
			if sp < 2: break
			cmove(c, s[sp - 2], s[sp - 1])
		else if b0 == 4 || b0 == 22:
			hdr = false
			if sp < 1: break
			if b0 == 4 { cmove(c, 0.0, s[sp - 1]) } else { cmove(c, s[sp - 1], 0.0) }
		else if b0 == 5:
			if sp < 2: break
			while i + 1 < sp: cline(c, s[i], s[i + 1]); i += 2
		else if b0 == 6 || b0 == 7:
			if sp < 1: break
			h ~= b0 == 6
			while i < sp: if h { cline(c, s[i], 0.0) } else { cline(c, 0.0, s[i]) } h = !h; i += 1
		else if b0 == 30 || b0 == 31:
			if sp < 4: break
			h ~= b0 == 31
			while i + 3 < sp:
				l := if sp - i == 5 { s[i + 4] } else { 0.0 }
				if h { ccurve(c, s[i], 0.0, s[i + 1], s[i + 2], l, s[i + 3]) } else { ccurve(c, 0.0, s[i], s[i + 1], s[i + 2], s[i + 3], l) }
				h = !h; i += 4
		else if b0 == 8:
			if sp < 6: break
			while i + 5 < sp: ccurve(c, s[i], s[i + 1], s[i + 2], s[i + 3], s[i + 4], s[i + 5]); i += 6
		else if b0 == 24:
			if sp < 8: break
			while i + 5 < sp - 2: ccurve(c, s[i], s[i + 1], s[i + 2], s[i + 3], s[i + 4], s[i + 5]); i += 6
			if i + 1 >= sp: break
			cline(c, s[i], s[i + 1])
		else if b0 == 25:
			if sp < 8: break
			while i + 1 < sp - 6: cline(c, s[i], s[i + 1]); i += 2
			if i + 5 >= sp: break
			ccurve(c, s[i], s[i + 1], s[i + 2], s[i + 3], s[i + 4], s[i + 5])
		else if b0 == 26 || b0 == 27:
			if sp < 4: break
			q ~= 0.0 as f32
			if sp & 1 != 0: q = s[i]; i += 1
			while i + 3 < sp:
				if b0 == 27 { ccurve(c, s[i], q, s[i + 1], s[i + 2], s[i + 3], 0.0) } else { ccurve(c, q, s[i], s[i + 1], s[i + 2], 0.0, s[i + 3]) }
				q = 0.0; i += 4
		else if b0 == 10 || b0 == 29:
			if b0 == 10 && !hs: hs = true; if f.fds != 0 { subs = cid_subrs(f, g) }
			if sp < 1 || rh >= 10: break
			sp -= 1; rp[rh] = p; re[rh] = e; rh += 1
			sa, sn := subr(d, if b0 == 10 { subs } else { f.gsb }, s[sp] as int)
			if sn == 0: break
			p = sa; e = sa + sn; clr = false
		else if b0 == 11:
			if rh <= 0: break
			rh -= 1; p = rp[rh]; e = re[rh]; clr = false
		else if b0 == 14: cclose(c); bad = false; break
		else if b0 == 12:
			b1 := d[p] as int; p += 1
			if b1 == 34:
				if sp < 7: break
				ccurve(c, s[0], 0.0, s[1], s[2], s[3], 0.0); ccurve(c, s[4], 0.0, s[5], -s[2], s[6], 0.0)
			else if b1 == 35:
				if sp < 13: break
				ccurve(c, s[0], s[1], s[2], s[3], s[4], s[5]); ccurve(c, s[6], s[7], s[8], s[9], s[10], s[11])
			else if b1 == 36:
				if sp < 9: break
				ccurve(c, s[0], s[1], s[2], s[3], s[4], 0.0); ccurve(c, s[5], 0.0, s[6], s[7], s[8], -(s[1] + s[3] + s[7]))
			else if b1 == 37:
				if sp < 11: break
				dx := s[0] + s[2] + s[4] + s[6] + s[8]; dy := s[1] + s[3] + s[5] + s[7] + s[9]; ax := if dx < 0.0 { -dx } else { dx }; ay := if dy < 0.0 { -dy } else { dy }
				ccurve(c, s[0], s[1], s[2], s[3], s[4], s[5]); ccurve(c, s[6], s[7], s[8], s[9], if ax > ay { s[10] } else { -dx }, if ax > ay { -dy } else { s[10] })
			else: break
		else: break
		if clr: sp = 0
	if bad: c.vs.clear()
	c.vs
cff_box(f Info&, g int, b B4&) bool:
	vs := cff_shape(f, g)
	if vs.len == 0: return false
	b = B4{vs[0].x, vs[0].y, vs[0].x, vs[0].y}
	for v vs:
		b.x0 = min(b.x0, v.x); b.y0 = min(b.y0, v.y); b.x1 = max(b.x1, v.x); b.y1 = max(b.y1, v.y)
		if v.t == 4: b.x0 = min(b.x0, min(v.cx, v.cx1)); b.y0 = min(b.y0, min(v.cy, v.cy1)); b.x1 = max(b.x1, max(v.cx, v.cx1)); b.y1 = max(b.y1, max(v.cy, v.cy1))
	true
