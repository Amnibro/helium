extern fn sys3(n int, a int, b int, c int) int = "!sys3";
extern fn ptr(s const byte[:]) int = "!ptr";
extern fn sys6(n int, a int, b int, c int, d int, e int, f int) int = "!sys6";
extern fn mld(a int) int = "!ld8";
extern fn mst(a int, v int) = "!st8";
extern fn mcopy(d int, s int, n int) = "!copy";
struct RtV { b int, n int, top int, fl int, fln int, flc int }
let RT_RSZ = 1 << 34;
var RT_FREE int[4096];
var RT_NFREE int;
var RT_OB byte[65536];
var RT_ON int;
var RT_EB byte[512];
var RT_EN int;
fn rt_write(fd int, s const byte[:]) { var o = 0; while o < s.len { let w = sys3(1, fd, ptr(s[o..]), s.len - o); if w <= 0 { return; } o += w; } }
fn rt_flush() { if RT_ON > 0 { rt_write(1, RT_OB[..RT_ON]); RT_ON = 0; } }
fn rt_ps(s const byte[:]) { for c in s { if RT_ON == 65536 { rt_flush(); } RT_OB[RT_ON] = c; RT_ON += 1; } }
fn rt_digits(b byte[24]&, u u64) int { var v = u; var i = 24; loop { i -= 1; b[i] = (48 + v % 10) as byte; v = v / 10; if v == 0 { break; } } i }
fn rt_pu(u u64) { var b byte[24]; let i = rt_digits(b, u); rt_ps(b[i..]); }
fn rt_pi(v int) { var u = v as! u64; if v < 0 { rt_ps("-"); u = 0 - u; } rt_pu(u); }
fn rt_pb(b bool) { if b { rt_ps("true"); } else { rt_ps("false"); } }
fn rt_nl() { rt_ps("\n"); }
fn rt_exit(c int) { rt_flush(); sys3(60, c, 0, 0); }
fn rt_es(s const byte[:]) { for c in s { if RT_EN < 512 { RT_EB[RT_EN] = c; RT_EN += 1; } } }
fn rt_eu(u u64) { var b byte[24]; let i = rt_digits(b, u); rt_es(b[i..]); }
fn rt_ei(v int) { var u = v as! u64; if v < 0 { rt_es("-"); u = 0 - u; } rt_eu(u); }
fn rt_fail(loc const byte[:]) { rt_es(" ("); rt_es(loc); rt_es(")\n"); rt_flush(); rt_write(2, RT_EB[..RT_EN]); sys3(60, 1, 0, 0); }
fn rt_die(k int, loc const byte[:]) { rt_es("helium runtime error: "); if k == 1 { rt_es("integer overflow"); } if k == 2 { rt_es("division by zero"); } if k == 4 { rt_es("cast changes the value"); } if k == 5 { rt_es("array grew past 16 GiB"); } if k == 6 { rt_es("assertion failed"); } rt_fail(loc); }
fn rt_oob(i int, n int, loc const byte[:]) { rt_es("helium runtime error: index "); rt_ei(i); rt_es(" out of bounds (length "); rt_ei(n); rt_es(")"); rt_fail(loc); }
fn rt_take() int { if RT_NFREE > 0 { RT_NFREE -= 1; return RT_FREE[RT_NFREE]; } let p = sys6(9, 0, RT_RSZ + 65536, 3, 0x4022, -1, 0); if p < 0 && p > -4096 { rt_es("helium runtime error: out of address space\n"); rt_write(2, RT_EB[..RT_EN]); sys3(60, 1, 0, 0); } sys3(10, p + RT_RSZ, 65536, 0); p }
fn rt_give(b int, used int) { if b == 0 { return; } if used > (1 << 20) { sys3(28, b + 65536, (used - 65536 + 4095) & -4096, 4); } if RT_NFREE < 4096 { RT_FREE[RT_NFREE] = b; RT_NFREE += 1; } else { sys3(11, b, RT_RSZ + 65536, 0); } }
fn rt_grow(v RtV&, k int, esz int) int { if v.b == 0 { v.b = rt_take(); } let p = v.b + v.n * esz; v.n += k; if v.n * esz > RT_RSZ { rt_die(5, "push"); } p }
fn rt_rdrop(v RtV&) { rt_give(v.b, v.n * 64); v.b = 0; v.n = 0; v.top = 0; v.fl = 0; v.fln = 0; v.flc = 0; }
fn rt_rfrom(v RtV&, p int, n int, esz int) { v.b = 0; v.n = 0; v.top = 0; v.fl = 0; v.fln = 0; v.flc = 0; if n > 0 { let d = rt_grow(v, n, esz); mcopy(d, p, n * esz); } }
fn rt_pop(v RtV&, loc const byte[:]) { if v.n == 0 { rt_es("helium runtime error: pop of an empty array"); rt_fail(loc); } v.n -= 1; }
fn rt_abort(m const byte[:], loc const byte[:]) { rt_es("helium runtime error: "); rt_es(m); rt_fail(loc); }
