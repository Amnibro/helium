	while ex > ey { let i = ux - uy; if (i >> 63) == 0 { if i == 0 { return sx << 63; } ux = i; } ux = ux << 1; ex -= 1; }
	let i = ux - uy; if (i >> 63) == 0 { if i == 0 { return sx << 63; } ux = i; }
	while (ux >> 52) == 0 { ux = ux << 1; ex -= 1; }
