	if k >= 0 && rect_ok(bounds, fw) && float_ok(timer, fw, "a timer of") && hover_delay(CT[k], bounds, timer, CT[k].st.window.tooltip_delay, clicked, true): tip_text(CT[k], cstr(text), CT[k].st.window.tooltip_origin, CT[k].st.window.tooltip_offset)
menubar_begin(c Context):
	fw := "ui::menubar_begin"; k := pan_ctx(c, fw); if k < 0: return
	let u .= CT[k]; let l .= u.ps[lpi(u)]
	if l.at_y != l.bounds.y: misuse(str(fw, ": a menu bar is the first thing in its window or group, before any row or widget")); return
	if !push_scope(u, SC_MENUBAR, true, fw) || l.flags & (WIN_HIDDEN | WIN_MINIMIZED) != 0: return
	l.menu.x = l.at_x; l.menu.y = l.at_y + l.row.height; l.menu.w = l.bounds.w; l.menu.sx = pget(u, l.ox); l.menu.sy = pget(u, l.oy); pset(u, l.oy, 0)
menubar_end(c Context):
	fw := "ui::menubar_end"; k := pan_ctx(c, fw); if k < 0 || !expect_scope(CT[k], SC_MENUBAR, fw): return
	let u .= CT[k]; let l .= u.ps[lpi(u)]
	if l.flags & (WIN_HIDDEN | WIN_MINIMIZED) == 0:
		l.menu.h = l.at_y - l.menu.y; l.menu.h += l.row.height + u.st.window.spacing.y; l.bounds.y += l.menu.h; l.bounds.h -= l.menu.h
		pset(u, l.ox, l.menu.sx); pset(u, l.oy, l.menu.sy); l.at_y = l.bounds.y - l.row.height; l.clip.y = l.bounds.y; l.clip.h = l.bounds.h; push_scissor_b(u, u.current, l.clip)
	pop_scope(u)
mbeg(c Context, fw const byte[:], how int, id const byte[:], t const byte[:], align int, img Image, sym int, size float2) bool:
	k := pop_ctx(c, fw); if k < 0 || !vec_ok(size, fw) || (how == 2 || how == 4) && !symbol_ok(sym, fw): return false
	n := tlen(t, fw); opened(CT[k], menu_go(CT[k], how, cstr(id), t[..n], align as u32, img, sym, size), SC_MENU, fw)
