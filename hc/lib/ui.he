ck_StyleWindowHeader(s StyleWindowHeader&) bool: ki(s.normal.kind, "normal") && ki(s.hover.kind, "hover") && ki(s.active.kind, "active") && ck_StyleButton(s.close_button) && ck_StyleButton(s.minimize_button) && kf(s.close_symbol >= 0 && s.close_symbol < 22, "close_symbol") && kf(s.minimize_symbol >= 0 && s.minimize_symbol < 22, "minimize_symbol") && kf(s.maximize_symbol >= 0 && s.maximize_symbol < 22, "maximize_symbol") && kf(s.align >= 0 && s.align <= 1, "align") && kf(fin(s.padding.x) && fin(s.padding.y), "padding") && kf(fin(s.label_padding.x) && fin(s.label_padding.y), "label_padding") && kf(fin(s.spacing.x) && fin(s.spacing.y), "spacing")
