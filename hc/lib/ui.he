	h.close_button = btn(t[2], t[2], t[2], NOCOL, t[2], t[0], 0.0, 0.0, 0.0); h.minimize_button = h.close_button
	w.background = t[1]; w.fixed_background = ic(t[1]); w.border_color = t[3]; w.popup_border_color = t[3]; w.combo_border_color = t[3]; w.contextual_border_color = t[3]; w.menu_border_color = t[3]; w.group_border_color = t[3]; w.tooltip_border_color = t[3]; w.scaler = ic(t[0])
	w.rounding = 0.0; w.spacing = v2(4.0, 4.0); w.scrollbar_size = v2(10.0, 10.0); w.min_size = v2(64.0, 64.0); w.combo_border = 1.0; w.contextual_border = 1.0; w.menu_border = 1.0; w.group_border = 1.0; w.tooltip_border = 1.0; w.popup_border = 1.0; w.border = 2.0; w.min_row_height_padding = 8.0
	w.padding = v2(4.0, 4.0); w.group_padding = v2(4.0, 4.0); w.popup_padding = v2(4.0, 4.0); w.combo_padding = v2(4.0, 4.0); w.contextual_padding = v2(4.0, 4.0); w.menu_padding = v2(4.0, 4.0); w.tooltip_padding = v2(4.0, 4.0); w.tooltip_origin = 0; w.tooltip_offset = v2(12.0, 12.0); w.tooltip_delay = 0.5
cbget(u UC&, bi int) CB: if bi < 0 { u.ov } else { u.ws[bi].buf }
cbset(u UC&, bi int, b CB): if bi < 0 { u.ov = b } else { u.ws[bi].buf = b }
cpush(u UC&, bi int, kind i32) int:
	n := u.cm.len; u.cm.push(Cm{Command{kind: kind, ..}, n + 1})
	b ~= cbget(u, bi); b.last = n; b.end = n + 1; cbset(u, bi, b); n
clipped(u UC&, bi int, r Rect) bool: b := cbget(u, bi); b.uc && !risect(r, b.clip)
clipped_img(u UC&, bi int, r Rect) bool: b := cbget(u, bi); b.uc && (b.clip.w == 0.0 || b.clip.h == 0.0 || !risect(r, b.clip))
clipped_tri(u UC&, bi int, x0 f32, y0 f32, x1 f32, y1 f32, x2 f32, y2 f32) bool: b := cbget(u, bi); b.uc && !inbox(x0, y0, b.clip) && !inbox(x1, y1, b.clip) && !inbox(x2, y2, b.clip)
set_xywh(c Command&, r Rect): c.x = s16(r.x); c.y = s16(r.y); c.w = us16(mx(0.0, r.w)); c.h = us16(mx(0.0, r.h))
push_scissor_b(u UC&, bi int, r Rect):
	b ~= cbget(u, bi); b.clip = r; cbset(u, bi, b)
	n := cpush(u, bi, COMMAND_SCISSOR); set_xywh(u.cm[n].c, r)
stroke_line_b(u UC&, bi int, x0 f32, y0 f32, x1 f32, y1 f32, t f32, col Color):
	if t <= 0.0: return
	n := cpush(u, bi, COMMAND_LINE); let c .= u.cm[n].c
	c.line_thickness = us16(t); c.points[0] = int2{s16(x0), s16(y0)}; c.points[1] = int2{s16(x1), s16(y1)}; c.color = col
stroke_curve_b(u UC&, bi int, ax f32, ay f32, c0x f32, c0y f32, c1x f32, c1y f32, bx f32, by f32, t f32, col Color):
	if col.a == 0 || t <= 0.0: return
	n := cpush(u, bi, COMMAND_CURVE); let c .= u.cm[n].c
	c.line_thickness = us16(t); c.points[0] = int2{s16(ax), s16(ay)}; c.points[1] = int2{s16(c0x), s16(c0y)}; c.points[2] = int2{s16(c1x), s16(c1y)}; c.points[3] = int2{s16(bx), s16(by)}; c.color = col
stroke_rect_b(u UC&, bi int, r Rect, ro f32, t f32, col Color):
	if col.a == 0 || r.w == 0.0 || r.h == 0.0 || t <= 0.0 || clipped(u, bi, r): return
	n := cpush(u, bi, COMMAND_RECT); let c .= u.cm[n].c
	c.rounding = us16(ro); c.line_thickness = us16(t); set_xywh(c, r); c.color = col
fill_rect_b(u UC&, bi int, r Rect, ro f32, col Color):
	if col.a == 0 || r.w == 0.0 || r.h == 0.0 || clipped(u, bi, r): return
	n := cpush(u, bi, COMMAND_RECT_FILLED); let c .= u.cm[n].c
	c.rounding = us16(ro); set_xywh(c, r); c.color = col
fill_rect_multi_color_b(u UC&, bi int, r Rect, l Color, tp Color, rt Color, bt Color):
	if r.w == 0.0 || r.h == 0.0 || clipped(u, bi, r): return
	n := cpush(u, bi, COMMAND_RECT_MULTI_COLOR); let c .= u.cm[n].c
	set_xywh(c, r); c.left = l; c.top = tp; c.right = rt; c.bottom = bt
stroke_circle_b(u UC&, bi int, r Rect, t f32, col Color):
	if r.w == 0.0 || r.h == 0.0 || t <= 0.0 || clipped(u, bi, r): return
	n := cpush(u, bi, COMMAND_CIRCLE); let c .= u.cm[n].c
	c.line_thickness = us16(t); set_xywh(c, r); c.color = col
fill_circle_b(u UC&, bi int, r Rect, col Color):
	if col.a == 0 || r.w == 0.0 || r.h == 0.0 || clipped(u, bi, r): return
	n := cpush(u, bi, COMMAND_CIRCLE_FILLED); let c .= u.cm[n].c
	set_xywh(c, r); c.color = col
stroke_arc_b(u UC&, bi int, cx f32, cy f32, rad f32, a0 f32, a1 f32, t f32, col Color):
	if col.a == 0 || t <= 0.0: return
	n := cpush(u, bi, COMMAND_ARC); let c .= u.cm[n].c
	c.line_thickness = us16(t); c.x = s16(cx); c.y = s16(cy); c.w = us16(rad); c.a_min = a0; c.a_max = a1; c.color = col
fill_arc_b(u UC&, bi int, cx f32, cy f32, rad f32, a0 f32, a1 f32, col Color):
	if col.a == 0: return
	n := cpush(u, bi, COMMAND_ARC_FILLED); let c .= u.cm[n].c
	c.x = s16(cx); c.y = s16(cy); c.w = us16(rad); c.a_min = a0; c.a_max = a1; c.color = col
stroke_triangle_b(u UC&, bi int, x0 f32, y0 f32, x1 f32, y1 f32, x2 f32, y2 f32, t f32, col Color):
	if col.a == 0 || t <= 0.0 || clipped_tri(u, bi, x0, y0, x1, y1, x2, y2): return
	n := cpush(u, bi, COMMAND_TRIANGLE); let c .= u.cm[n].c
	c.line_thickness = us16(t); c.points[0] = int2{s16(x0), s16(y0)}; c.points[1] = int2{s16(x1), s16(y1)}; c.points[2] = int2{s16(x2), s16(y2)}; c.color = col
fill_triangle_b(u UC&, bi int, x0 f32, y0 f32, x1 f32, y1 f32, x2 f32, y2 f32, col Color):
	if col.a == 0 || clipped_tri(u, bi, x0, y0, x1, y1, x2, y2): return
	n := cpush(u, bi, COMMAND_TRIANGLE_FILLED); let c .= u.cm[n].c
	c.points[0] = int2{s16(x0), s16(y0)}; c.points[1] = int2{s16(x1), s16(y1)}; c.points[2] = int2{s16(x2), s16(y2)}; c.color = col
poly_b(u UC&, bi int, kind i32, pts const float2[:], t f32, col Color):
	if col.a == 0 || kind != COMMAND_POLYGON_FILLED && t <= 0.0: return
	n := cpush(u, bi, kind); f := u.pt.len
	for p pts: u.pt.push(int2{s16(p.x), s16(p.y)})
	let c .= u.cm[n].c; c.color = col; c.first = f as i32; c.count = us16(pts.len as f32); c.line_thickness = if kind == COMMAND_POLYGON_FILLED { 0 } else { us16(t) }
draw_image_b(u UC&, bi int, r Rect, img Image, col Color):
	if clipped_img(u, bi, r): return
	n := cpush(u, bi, COMMAND_IMAGE); let c .= u.cm[n].c
	set_xywh(c, r); c.image = img; c.color = col
draw_nine_slice_b(u UC&, bi int, r Rect, s NineSlice, col Color):
	rg := s.img.region; rx := rg[0] as int; ry := rg[1] as int; rw := rg[2] as int; rh := rg[3] as int; l := s.l as int; t := s.t as int; rr := s.r as int; b := s.b as int
	im ~= Image{s.img.texture, s.img.w, s.img.h, [rg[0], rg[1], s.l, s.t]}
	draw_image_b(u, bi, Rect{r.x, r.y, l as f32, t as f32}, im, col)
	rects := [Rect{r.x + l as f32, r.y, r.w - l as f32 - rr as f32, t as f32}, Rect{r.x + r.w - rr as f32, r.y, rr as f32, t as f32}, Rect{r.x, r.y + t as f32, l as f32, r.h - t as f32 - b as f32}, Rect{r.x + l as f32, r.y + t as f32, r.w - l as f32 - rr as f32, r.h - t as f32 - b as f32}, Rect{r.x + r.w - rr as f32, r.y + t as f32, rr as f32, r.h - t as f32 - b as f32}, Rect{r.x, r.y + r.h - b as f32, l as f32, b as f32}, Rect{r.x + l as f32, r.y + r.h - b as f32, r.w - l as f32 - rr as f32, b as f32}, Rect{r.x + r.w - rr as f32, r.y + r.h - b as f32, rr as f32, b as f32}]
	regs := [[rx + l, ry, rw - l - rr, t], [rx + rw - rr, ry, rr, t], [rx, ry + t, l, rh - t - b], [rx + l, ry + t, rw - l - rr, rh - t - b], [rx + rw - rr, ry + t, rr, rh - t - b], [rx, ry + rh - b, l, b], [rx + l, ry + rh - b, rw - l - rr, b], [rx + rw - rr, ry + rh - b, rr, b]]
	for i 8: im.region = [regs[i][0] as! u16, regs[i][1] as! u16, regs[i][2] as! u16, regs[i][3] as! u16]; draw_image_b(u, bi, rects[i], im, col)
draw_text_b(u UC&, bi int, r Rect, s const byte[:], fid u32, bg Color, fg Color):
	if s.len == 0 || bg.a == 0 && fg.a == 0 || clipped_img(u, bi, r): return
	ln ~= s.len; tw := fwid(fid, s)
	if tw > r.w: g ~= 0; w ~= tw; ln = text_clamp(fid, s, r.w, g, w, [])
	if ln == 0: return
	n := cpush(u, bi, COMMAND_TEXT); f := u.tx.len; u.tx.append(s[..ln])
	let c .= u.cm[n].c; c.x = s16(r.x); c.y = s16(r.y); c.w = us16(r.w); c.h = us16(r.h); c.background = bg; c.color = fg; c.font = Font{fid}; c.count = ln as i32; c.first = f as i32; c.height = fht(fid)
widget_text(u UC&, bi int, b0 Rect, s const byte[:], tp float2, bg Color, fg Color, a0 u32, fid u32):
	b ~= b0; b.h = mx(b.h, 2.0 * tp.y); fh := fht(fid)
	tw := fwid(fid, s) + 2.0 * tp.x; a ~= a0
	if a & 7 == 0: a |= 1
	if a & 56 == 0: a |= 8
	l ~= Rect{0.0, 0.0, 0.0, 0.0}
	if a & 1 != 0: l.x = b.x + tp.x; l.w = mx(0.0, b.w - 2.0 * tp.x)
	else if a & 2 != 0:
		l.w = mx(1.0, 2.0 * tp.x + tw); l.x = b.x + tp.x + ((b.w - 2.0 * tp.x) - l.w) / 2.0; l.x = mx(b.x + tp.x, l.x); l.w = mn(b.x + b.w, l.x + l.w)
		if l.w >= l.x: l.w -= l.x
	else if a & 4 != 0: l.x = mx(b.x + tp.x, (b.x + b.w) - (2.0 * tp.x + tw)); l.w = tw + 2.0 * tp.x
	if a & 8 != 0: l.y = b.y + tp.y; l.h = mn(fh, b.h - 2.0 * tp.y)
	else if a & 16 != 0: l.y = b.y + b.h / 2.0 - fh / 2.0; l.h = mx(b.h / 2.0, b.h - (b.h / 2.0 + fh / 2.0))
	else if a & 32 != 0: l.y = b.y + b.h - fh; l.h = fh
	draw_text_b(u, bi, l, s, fid, bg, fg)
reset_min_row_height(u UC&):
	if u.current < 0 || u.ws[u.current].lay < 0: return
	let p .= u.ps[u.ws[u.current].lay]; p.row.min_height = fht(u.font) + u.st.text.padding.y * 2.0 + u.st.window.min_row_height_padding * 2.0
pan_padding(s Style&, ty u32) float2: if ty == PAN_GROUP { s.window.group_padding } else if ty == PAN_POPUP { s.window.popup_padding } else if ty == PAN_CONTEXTUAL { s.window.contextual_padding } else if ty == PAN_COMBO { s.window.combo_padding } else if ty == PAN_MENU || ty == PAN_TOOLTIP { s.window.menu_padding } else { s.window.padding }
pan_border(s Style&, fl u32, ty u32) f32: if fl & 1 == 0 { 0.0 } else if ty == PAN_GROUP { s.window.group_border } else if ty == PAN_POPUP { s.window.popup_border } else if ty == PAN_CONTEXTUAL { s.window.contextual_border } else if ty == PAN_COMBO { s.window.combo_border } else if ty == PAN_MENU || ty == PAN_TOOLTIP { s.window.menu_border } else { s.window.border }
pan_border_color(s Style&, ty u32) Color: if ty == PAN_GROUP { s.window.group_border_color } else if ty == PAN_POPUP { s.window.popup_border_color } else if ty == PAN_CONTEXTUAL { s.window.contextual_border_color } else if ty == PAN_COMBO { s.window.combo_border_color } else if ty == PAN_MENU || ty == PAN_TOOLTIP { s.window.menu_border_color } else { s.window.border_color }
is_sub(ty u32) bool: ty & PAN_SUB != 0
is_nonblock(ty u32) bool: ty & PAN_NONBLOCK != 0
has_header(fl u32, title bool) bool: (fl & 24 != 0 || fl & 64 != 0) && fl & WIN_HIDDEN == 0 && title
pget(u UC&, p Ptr) u32: if p.k == 1 { if p.b == 0 { u.ws[p.a].sx } else { u.ws[p.a].sy } } else if p.k == 2 { u.ts[p.a].values[p.b] } else if p.k == 3 { if p.b == 0 { u.sc[p.a].sx } else { u.sc[p.a].sy } } else { 0 }
pset(u UC&, p Ptr, v u32):
	if p.k == 1: if p.b == 0 { u.ws[p.a].sx = v } else { u.ws[p.a].sy = v }
	else if p.k == 2: u.ts[p.a].values[p.b] = v
	else if p.k == 3: if p.b == 0 { u.sc[p.a].sx = v } else { u.sc[p.a].sy = v }
new_panel(u UC&) int:
	if u.pfree.len > 0: i := u.pfree.pop(); u.ps[i] = Pan{..}; return i
	u.ps.push(Pan{..}); u.ps.len - 1
new_window(u UC&) int:
	i ~= u.ws.len
	if u.wfree.len > 0: i = u.wfree.pop(); u.ws[i] = Win{..}
	else: u.ws.push(Win{..})
	u.ws[i].seq = u.seq; i
free_table(u UC&, t int): u.ts[t] = Tbl{..}; u.tfree.push(t)
remove_table(u UC&, w int, t int):
	let wi .= u.ws[w]; let tb .= u.ts[t]
	if wi.tables == t: wi.tables = tb.next
	if tb.next >= 0: u.ts[tb.next].prev = tb.prev
	if tb.prev >= 0: u.ts[tb.prev].next = tb.next
	tb.next = -1; tb.prev = -1
