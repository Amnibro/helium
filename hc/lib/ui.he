		it = u.ws[it].next
	-1
win_find(u UC&, name const byte[:]) int: n := cstr(name); find_window(u, murmur(n, 64), n)
insert_window(u UC&, w int, back bool):
	it ~= u.begin
	while it >= 0: if it == w { return } it = u.ws[it].next
	if u.begin < 0: u.ws[w].next = -1; u.ws[w].prev = -1; u.begin = w; u.end = w; u.count = 1; return
	if back:
		e := u.end; u.ws[e].flags |= WIN_ROM; u.ws[e].next = w; u.ws[w].prev = e; u.ws[w].next = -1; u.end = w; u.active = w; u.ws[w].flags &= ~WIN_ROM
	else:
		u.ws[u.begin].prev = w; u.ws[w].next = u.begin; u.ws[w].prev = -1; u.begin = w; u.ws[w].flags &= ~WIN_ROM
	u.count += 1
remove_window(u UC&, w int):
	let wi .= u.ws[w]
	if w == u.begin || w == u.end:
		if w == u.begin: u.begin = wi.next; if wi.next >= 0 { u.ws[wi.next].prev = -1 }
		if w == u.end: u.end = wi.prev; if wi.prev >= 0 { u.ws[wi.prev].next = -1 }
	else:
		if wi.next >= 0: u.ws[wi.next].prev = wi.prev
		if wi.prev >= 0: u.ws[wi.prev].next = wi.next
	if w == u.active || u.active < 0: u.active = u.end; if u.end >= 0 { u.ws[u.end].flags &= ~WIN_ROM }
	u.ws[w].next = -1; u.ws[w].prev = -1; u.count -= 1
start_buffer(u UC&, bi int): b ~= cbget(u, bi); n := u.cm.len; b.begin = n; b.end = n; b.last = n; b.clip = NULL_RECT; cbset(u, bi, b)
finish(u UC&, w int):
	u.ws[w].buf.end = u.cm.len
