	if l.flags & WIN_REMOVE_ROM != 0: l.flags &= ~WIN_ROM; l.flags &= ~WIN_REMOVE_ROM
	wn.flags = l.flags
	let pr .= wn.prop
	if pr.active != 0 && pr.old != pr.seq && pr.active == pr.prev: wn.prop = Prop{..}
	else: pr.old = pr.seq; pr.prev = pr.active; pr.seq = 0
	let ed .= wn.ed
	if ed.active != 0 && ed.old != ed.seq && ed.active == ed.prev: wn.ed = Ed{..}
	else: ed.old = ed.seq; ed.prev = ed.active; ed.seq = 0
	let po .= wn.pop
	if po.active_con != 0 && po.con_old != po.con_count: po.con_count = 0; po.con_old = 0; po.active_con = 0
	else: po.con_old = po.con_count; po.con_count = 0
	po.combo_count = 0
win_is_hovered(u UC&) bool:
	if u.current < 0 || u.ws[u.current].flags & WIN_HIDDEN != 0: return false
	b ~= u.ws[u.current].bounds
	if u.ws[u.current].flags & WIN_MINIMIZED != 0: b.h = u.ps[u.ws[u.current].lay].header_height
	i_hover(u.inp, b)
begin_titled_nk(u UC&, name const byte[:], title const byte[:], bounds Rect, flags u32) bool:
	if u.current >= 0: return false
	let s .= u.st; hash u32 := murmur(name, 64); w ~= find_window(u, hash, name)
	if w < 0:
		w = new_window(u); insert_window(u, w, flags & 256 == 0)
		let wn .= u.ws[w]; wn.buf.begin = u.cm.len; wn.buf.end = u.cm.len; wn.buf.last = u.cm.len; wn.buf.uc = true
		wn.flags = flags; wn.bounds = bounds; wn.name = hash; wn.ns.clear(); wn.ns.append(name[..min(name.len, 63)]); wn.pop.win = -1; wn.wdis = false
		if u.active < 0: u.active = w
	else:
		let wn .= u.ws[w]; wn.flags &= ~(2047 as u32); wn.flags |= flags
		if wn.flags & 6 == 0: wn.bounds = bounds
		wn.seq = u.seq
		if u.active < 0 && wn.flags & WIN_HIDDEN == 0: u.active = w; u.end = w
	if u.ws[w].flags & WIN_HIDDEN != 0: u.current = w; u.ws[w].lay = -1; return false
	start_buffer(u, w)
	if u.ws[w].flags & NO_INPUT_U == 0:
		h := fht(u.font) + 2.0 * s.window.header.padding.y + 2.0 * s.window.header.label_padding.y
		wb := if u.ws[w].flags & WIN_MINIMIZED == 0 { u.ws[w].bounds } else { Rect{u.ws[w].bounds.x, u.ws[w].bounds.y, u.ws[w].bounds.w, h} }
		inpanel := i_click_down_in(u.inp, 0, wb, true) && u.inp.mb[0].clicked != 0
		ishov := i_hover(u.inp, wb); it ~= w
		if w != u.active && ishov && !u.inp.mb[0].down:
			it = u.ws[w].next
			while it >= 0:
				ib := if u.ws[it].flags & WIN_MINIMIZED == 0 { u.ws[it].bounds } else { Rect{u.ws[it].bounds.x, u.ws[it].bounds.y, u.ws[it].bounds.w, h} }
				if risect(wb, ib) && u.ws[it].flags & WIN_HIDDEN == 0: break
				pw := u.ws[it].pop.win
				if pw >= 0 && u.ws[it].pop.active && u.ws[it].flags & WIN_HIDDEN == 0 && isect(u.ws[w].bounds.x, wb.y, wb.w, wb.h, u.ws[pw].bounds): break
				it = u.ws[it].next
		if it >= 0 && inpanel && w != u.end:
			it = u.ws[w].next
			while it >= 0:
				ib := if u.ws[it].flags & WIN_MINIMIZED == 0 { u.ws[it].bounds } else { Rect{u.ws[it].bounds.x, u.ws[it].bounds.y, u.ws[it].bounds.w, h} }
				if inbox(u.inp.pos.x, u.inp.pos.y, ib) && u.ws[it].flags & WIN_HIDDEN == 0: break
				pw := u.ws[it].pop.win
				if pw >= 0 && u.ws[it].pop.active && u.ws[it].flags & WIN_HIDDEN == 0 && risect(wb, u.ws[pw].bounds): break
				it = u.ws[it].next
		if it >= 0 && u.ws[w].flags & WIN_ROM == 0 && u.ws[w].flags & 256 != 0:
			u.ws[w].flags |= WIN_ROM; u.ws[it].flags &= ~WIN_ROM; u.active = it
			if u.ws[it].flags & 256 == 0: remove_window(u, it); insert_window(u, it, true)
		else:
			if it < 0 && u.end != w:
				if u.ws[w].flags & 256 == 0: remove_window(u, w); insert_window(u, w, true)
				u.ws[w].flags &= ~WIN_ROM; u.active = w
			if u.end != w && u.ws[w].flags & 256 == 0: u.ws[w].flags |= WIN_ROM
	u.ws[w].lay = new_panel(u); u.current = w
	ret := panel_begin(u, title, true, PAN_WINDOW)
	let l .= u.ps[u.ws[w].lay]; l.ox = Ptr{1, w, 0}; l.oy = Ptr{1, w, 1}
	ret
end_nk(u UC&):
	if u.current < 0: return
	pi := u.ws[u.current].lay
	if pi < 0 || u.ps[pi].ty == PAN_WINDOW && u.ws[u.current].flags & WIN_HIDDEN != 0: u.current = -1; return
	panel_end(u); u.pfree.push(pi); u.current = -1
clear_nk(u UC&):
	u.cm.clear(); u.pt.clear(); u.tx.clear(); u.build = false; u.lws = 0; u.cact = u.curs[0]; u.ov = CB{..}
	it ~= u.begin
	while it >= 0:
		let wi .= u.ws[it]
		if wi.flags & WIN_MINIMIZED != 0 && wi.flags & WIN_CLOSED == 0 && wi.seq == u.seq: it = wi.next; continue
		if wi.flags & (WIN_HIDDEN | WIN_CLOSED) != 0 && it == u.active:
			u.active = wi.prev; u.end = wi.prev
			if u.end < 0: u.begin = -1
			if u.active >= 0: u.ws[u.active].flags &= ~WIN_ROM
		if wi.pop.win >= 0 && u.ws[wi.pop.win].seq != u.seq: free_window(u, wi.pop.win); u.ws[it].pop.win = -1
		t ~= u.ws[it].tables
		while t >= 0:
			n := u.ts[t].next
			if u.ts[t].seq != u.seq:
				remove_table(u, it, t); u.ts[t].seq = 0; u.ts[t].size = 0; free_table(u, t)
				if t == u.ws[it].tables: u.ws[it].tables = n
			t = n
		if u.ws[it].seq != u.seq || u.ws[it].flags & WIN_CLOSED != 0:
			nx := u.ws[it].next; remove_window(u, it); free_window(u, it); it = nx
		else: it = u.ws[it].next
	u.seq += 1
build_nk(u UC&):
	if u.cact < 0: u.cact = u.curs[0]
	if u.cact >= 0 && !u.inp.grabbed && u.cvis:
		u.ov = CB{0, 0, 0, NULL_RECT, false}; start_buffer(u, -1); cu := u.cursors[u.cact]
		draw_image_b(u, -1, Rect{u.inp.pos.x - cu.offset.x, u.inp.pos.y - cu.offset.y, cu.size.x, cu.size.y}, cu.img, Color{255, 255, 255, 255})
		u.ov.end = u.cm.len
	it ~= u.begin; cmd ~= -1
	while it >= 0:
		nx ~= u.ws[it].next; let b .= u.ws[it].buf
		if !(b.last == b.begin || u.ws[it].flags & WIN_HIDDEN != 0 || u.ws[it].seq != u.seq):
			cmd = b.last
			while nx >= 0 && (u.ws[nx].buf.last == u.ws[nx].buf.begin || u.ws[nx].flags & WIN_HIDDEN != 0 || u.ws[nx].seq != u.seq): nx = u.ws[nx].next
			if nx >= 0: u.cm[cmd].nx = u.ws[nx].buf.begin
		it = nx
	it = u.begin
	while it >= 0:
		nx := u.ws[it].next
		if u.ws[it].pop.buf.active: u.cm[cmd].nx = u.ws[it].pop.buf.begin; cmd = u.ws[it].pop.buf.last; u.ws[it].pop.buf.active = false
		it = nx
	if cmd >= 0: u.cm[cmd].nx = if u.ov.end != u.ov.begin { u.ov.begin } else { u.cm.len }
first_cmd(u UC&) int:
	if u.count == 0: return -1
	if !u.build: build_nk(u); u.build = true
	it ~= u.begin
	while it >= 0 && (u.ws[it].buf.begin == u.ws[it].buf.end || u.ws[it].flags & WIN_HIDDEN != 0 || u.ws[it].seq != u.seq): it = u.ws[it].next
	if it < 0 { -1 } else { u.ws[it].buf.begin }
next_cmd(u UC&, c int) int: if u.count == 0 || u.cm[c].nx >= u.cm.len { -1 } else { u.cm[c].nx }
end_frame(u UC&): clear_nk(u); u.drawn = false; u.converted = false; u.ratios.clear()
flags_ok(f int, fw const byte[:]) bool: f & ~2047 == 0 || misuse(str(fw, ": flags ", f, " are not a combination of the WINDOW_* flags"))
rect_ok(r Rect, fw const byte[:]) bool: fin(r.x) && fin(r.y) && fin(r.w) && fin(r.h) || misuse(str(fw, ": a rectangle of ", pg(r.x as real), ", ", pg(r.y as real), ", ", pg(r.w as real), ", ", pg(r.h as real)))
vec_ok(v float2, fw const byte[:]) bool: fin(v.x) && fin(v.y) || misuse(str(fw, ": a size or position of ", pg(v.x as real), ", ", pg(v.y as real)))
ui_begin(c Context, name0 const byte[:], title0 const byte[:], bounds Rect, flags int, fw const byte[:]) bool:
	k := ctx_get(c, fw); if k < 0: return false
	let u .= CT[k]
	if u.in_input: return misuse(str(fw, " between ui::input_begin and ui::input_end"))
	s := top_scope(u)
	if s >= 0: return misuse(str(fw, " inside the ", if u.sc[s].kind == SC_WINDOW { "window" } else { "panel" }, " begun by ", u.sc[s].by, ": windows do not nest"))
	if !flags_ok(flags, fw) || !rect_ok(bounds, fw): return false
	n := cstr(name0); w := win_find(u, n)
	if w >= 0 && u.ws[w].seq == u.seq: return misuse(str(fw, ": the window \"", n, "\" was begun already this frame (a window's name must be unique in a frame)"))
	nf u32 ~= flags as u32
	if flags & 1024 != 0: nf |= WIN_ROM
	else if w >= 0 && u.ws[w].flags & NO_INPUT_U != 0: u.ws[w].flags &= ~WIN_ROM
	open := begin_titled_nk(u, n, cstr(title0), bounds, nf)
	push_scope(u, SC_WINDOW, open, fw); u.drawn = true; open
begin(c Context, title const byte[:], bounds Rect, flags int) bool: ui_begin(c, title, title, bounds, flags, "ui::begin")
begin_titled(c Context, name const byte[:], title const byte[:], bounds Rect, flags int) bool: ui_begin(c, name, title, bounds, flags, "ui::begin_titled")
end(c Context):
	k := ctx_get(c, "ui::end"); if k < 0: return
	let u .= CT[k]
	if u.in_input: misuse("ui::end between ui::input_begin and ui::input_end"); return
	if !expect_scope(u, SC_WINDOW, "ui::end"): return
	end_nk(u); pop_scope(u)
win_ctx(c Context, fw const byte[:]) int: k := ctx_get(c, fw); if k < 0 || !in_window(CT[k], fw) { -1 } else { k }
window_find(c Context, name const byte[:]) bool: k := ctx_get(c, "ui::window_find"); k >= 0 && win_find(CT[k], name) >= 0
window_get_bounds(c Context) Rect: k := win_ctx(c, "ui::window_get_bounds"); if k < 0 { Rect{0.0, 0.0, 0.0, 0.0} } else { CT[k].ws[CT[k].current].bounds }
window_get_position(c Context) float2: k := win_ctx(c, "ui::window_get_position"); if k < 0 { v2(0.0, 0.0) } else { b := CT[k].ws[CT[k].current].bounds; v2(b.x, b.y) }
window_get_size(c Context) float2: k := win_ctx(c, "ui::window_get_size"); if k < 0 { v2(0.0, 0.0) } else { b := CT[k].ws[CT[k].current].bounds; v2(b.w, b.h) }
window_get_width(c Context) f32: k := win_ctx(c, "ui::window_get_width"); if k < 0 { 0.0 } else { CT[k].ws[CT[k].current].bounds.w }
window_get_height(c Context) f32: k := win_ctx(c, "ui::window_get_height"); if k < 0 { 0.0 } else { CT[k].ws[CT[k].current].bounds.h }
laid_out(c Context, fw const byte[:]) int:
	k := ctx_get(c, fw); if k < 0 || !in_window(CT[k], fw): return -1
	if CT[k].ws[CT[k].current].lay >= 0: return k
	misuse(str(fw, ": the window is hidden, so it has no contents to ask about")); -1
cur_clip(k int) Rect: CT[k].ps[CT[k].ws[CT[k].current].lay].clip
window_get_content_region(c Context) Rect: k := laid_out(c, "ui::window_get_content_region"); if k < 0 { Rect{0.0, 0.0, 0.0, 0.0} } else { cur_clip(k) }
window_get_content_region_min(c Context) float2: k := laid_out(c, "ui::window_get_content_region_min"); if k < 0 { v2(0.0, 0.0) } else { r := cur_clip(k); v2(r.x, r.y) }
window_get_content_region_max(c Context) float2: k := laid_out(c, "ui::window_get_content_region_max"); if k < 0 { v2(0.0, 0.0) } else { r := cur_clip(k); v2(r.x + r.w, r.y + r.h) }
window_get_content_region_size(c Context) float2: k := laid_out(c, "ui::window_get_content_region_size"); if k < 0 { v2(0.0, 0.0) } else { r := cur_clip(k); v2(r.w, r.h) }
window_get_scroll(c Context) Scroll: k := win_ctx(c, "ui::window_get_scroll"); if k < 0 { Scroll{0, 0} } else { Scroll{CT[k].ws[CT[k].current].sx, CT[k].ws[CT[k].current].sy} }
window_has_focus(c Context) bool: k := laid_out(c, "ui::window_has_focus"); k >= 0 && CT[k].current == CT[k].active
window_is_hovered(c Context) bool: k := laid_out(c, "ui::window_is_hovered"); k >= 0 && win_is_hovered(CT[k])
named(c Context, name const byte[:], fw const byte[:], w int&) int: k := ctx_get(c, fw); w = if k < 0 { -1 } else { win_find(CT[k], name) }; k
window_is_collapsed(c Context, name const byte[:]) bool: w ~= -1; k := named(c, name, "ui::window_is_collapsed", w); k >= 0 && w >= 0 && CT[k].ws[w].flags & WIN_MINIMIZED != 0
window_is_closed(c Context, name const byte[:]) bool: w ~= -1; k := named(c, name, "ui::window_is_closed", w); k < 0 || w < 0 || CT[k].ws[w].flags & WIN_CLOSED != 0
window_is_hidden(c Context, name const byte[:]) bool: w ~= -1; k := named(c, name, "ui::window_is_hidden", w); k < 0 || w < 0 || CT[k].ws[w].flags & WIN_HIDDEN != 0
window_is_active(c Context, name const byte[:]) bool: w ~= -1; k := named(c, name, "ui::window_is_active", w); k >= 0 && w >= 0 && w == CT[k].active
any_hovered(u UC&) bool:
	it ~= u.begin
	while it >= 0:
		let w .= u.ws[it]
		if w.flags & WIN_HIDDEN == 0:
			if w.pop.active && w.pop.win >= 0 && i_hover(u.inp, u.ws[w.pop.win].bounds): return true
			if w.flags & WIN_MINIMIZED != 0:
				hd ~= w.bounds; hd.h = fht(u.font) + 2.0 * u.st.window.header.padding.y
				if i_hover(u.inp, hd): return true
			else if i_hover(u.inp, w.bounds): return true
		it = w.next
	false
window_is_any_hovered(c Context) bool: k := ctx_get(c, "ui::window_is_any_hovered"); k >= 0 && any_hovered(CT[k])
item_is_any_active(c Context) bool: k := ctx_get(c, "ui::item_is_any_active"); k >= 0 && (any_hovered(CT[k]) || CT[k].lws & 2 != 0)
over_window(u UC&, p float2) bool:
	it ~= u.begin
	while it >= 0:
		let w .= u.ws[it]; nx := w.next
		if w.flags & WIN_HIDDEN == 0 && win_current(u, it):
			r ~= w.bounds
			if w.flags & WIN_MINIMIZED != 0: r.h = fht(u.font) + 2.0 * u.st.window.header.padding.y
			inn ~= w.flags & NO_INPUT_U == 0 && p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h
			if w.pop.active && w.pop.win >= 0 && u.ws[w.pop.win].flags & NO_INPUT_U == 0: q := u.ws[w.pop.win].bounds; inn = inn || p.x >= q.x && p.x < q.x + q.w && p.y >= q.y && p.y < q.y + q.h
			if inn: return true
		it = nx
	false
wants_mouse(c Context) bool:
	k := ctx_get(c, "ui::wants_mouse"); if k < 0: return false
	let u .= CT[k]; held ~= false
	for b 6:
		if u.inp.mb[b].down:
			if over_window(u, u.inp.mb[b].pos): return true
			held = true
	!held && over_window(u, u.inp.pos)
window_set_bounds(c Context, name const byte[:], bounds Rect): w ~= -1; k := named(c, name, "ui::window_set_bounds", w); if k >= 0 && rect_ok(bounds, "ui::window_set_bounds") && w >= 0 { CT[k].ws[w].bounds = bounds }
window_set_position(c Context, name const byte[:], pos float2): w ~= -1; k := named(c, name, "ui::window_set_position", w); if k >= 0 && vec_ok(pos, "ui::window_set_position") && w >= 0 { CT[k].ws[w].bounds.x = pos.x; CT[k].ws[w].bounds.y = pos.y }
window_set_size(c Context, name const byte[:], size float2): w ~= -1; k := named(c, name, "ui::window_set_size", w); if k >= 0 && vec_ok(size, "ui::window_set_size") && w >= 0 { CT[k].ws[w].bounds.w = size.x; CT[k].ws[w].bounds.h = size.y }
window_set_focus(c Context, name const byte[:]):
	w ~= -1; k := named(c, name, "ui::window_set_focus", w); if k < 0: return
	let u .= CT[k]
	if w >= 0 && u.end != w: remove_window(u, w); insert_window(u, w, true)
	u.active = w
uclamp(v int) u32: if v < 0 { 0 } else if v > 4294967295 { 4294967295 } else { v as u32 }
window_set_scroll(c Context, x int, y int): k := win_ctx(c, "ui::window_set_scroll"); if k >= 0 { CT[k].ws[CT[k].current].sx = uclamp(x); CT[k].ws[CT[k].current].sy = uclamp(y) }
window_close(c Context, name const byte[:]):
	w ~= -1; k := named(c, name, "ui::window_close", w); if k < 0: return
	if w >= 0 && w == CT[k].current: misuse(str("ui::window_close: \"", cstr(name), "\" is the window being built; close it after ui::end")); return
	if w >= 0: CT[k].ws[w].flags |= WIN_HIDDEN | WIN_CLOSED
window_collapse(c Context, name const byte[:], state int):
	w ~= -1; k := named(c, name, "ui::window_collapse", w)
	if k >= 0 && enum_ok(state, 2, "ui::window_collapse", "MINIMIZED, MAXIMIZED") && w >= 0: CT[k].ws[w].flags = if state == 0 { CT[k].ws[w].flags | WIN_MINIMIZED } else { CT[k].ws[w].flags & ~WIN_MINIMIZED }
window_collapse_if(c Context, name const byte[:], state int, cond bool):
	w ~= -1; k := named(c, name, "ui::window_collapse_if", w)
	if k >= 0 && enum_ok(state, 2, "ui::window_collapse_if", "MINIMIZED, MAXIMIZED") && cond && w >= 0: CT[k].ws[w].flags = if state == 0 { CT[k].ws[w].flags | WIN_MINIMIZED } else { CT[k].ws[w].flags & ~WIN_MINIMIZED }
window_show(c Context, name const byte[:], state int):
	w ~= -1; k := named(c, name, "ui::window_show", w)
	if k >= 0 && enum_ok(state, 2, "ui::window_show", "HIDDEN, SHOWN") && w >= 0: CT[k].ws[w].flags = if state == 0 { CT[k].ws[w].flags | WIN_HIDDEN } else { CT[k].ws[w].flags & ~WIN_HIDDEN }
window_show_if(c Context, name const byte[:], state int, cond bool):
	w ~= -1; k := named(c, name, "ui::window_show_if", w)
	if k >= 0 && enum_ok(state, 2, "ui::window_show_if", "HIDDEN, SHOWN") && cond && w >= 0: CT[k].ws[w].flags = if state == 0 { CT[k].ws[w].flags | WIN_HIDDEN } else { CT[k].ws[w].flags & ~WIN_HIDDEN }
canvas(c Context, fw const byte[:]) int: k := ctx_get(c, fw); if k < 0 || !in_panel(CT[k], fw) { -1 } else { k }
coord_ok(v f32) bool: fin(v) && v > -32768.0 && v < 32768.0
coords_ok(fw const byte[:], v const f32[:]) bool:
	for x v: if !coord_ok(x) { return misuse(str(fw, ": a coordinate or size of ", pg(x as real), ", where it is from -32768 to 32767")) }
	true
thick_ok(t f32, fw const byte[:]) bool: fin(t) && t >= 0.0 && t < 65536.0 || misuse(str(fw, ": a line ", pg(t as real), " thick"))
rcoords_ok(r Rect, fw const byte[:]) bool: coords_ok(fw, [r.x, r.y, r.w, r.h])
points_ok(p const float2[:], fw const byte[:]) bool:
	if p.len > 65535: return misuse(str(fw, ": ", p.len, " points, of at most 65535"))
	for q p: if !coord_ok(q.x) { return coords_ok(fw, [q.x]) } if !coord_ok(q.y) { return coords_ok(fw, [q.y]) }
	true
stroke_line(c Context, x0 f32, y0 f32, x1 f32, y1 f32, line_thickness f32, color Color):
	k := canvas(c, "ui::stroke_line")
	if k >= 0 && coords_ok("ui::stroke_line", [x0, y0, x1, y1]) && thick_ok(line_thickness, "ui::stroke_line"): stroke_line_b(CT[k], CT[k].current, x0, y0, x1, y1, line_thickness, color)
stroke_curve(c Context, ax f32, ay f32, ctrl0x f32, ctrl0y f32, ctrl1x f32, ctrl1y f32, bx f32, by f32, line_thickness f32, color Color):
