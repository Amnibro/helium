stroke_rect(c Context, r Rect, rounding f32, line_thickness f32, color Color):
	k := canvas(c, "ui::stroke_rect")
	if k >= 0 && rcoords_ok(r, "ui::stroke_rect") && thick_ok(rounding, "ui::stroke_rect") && thick_ok(line_thickness, "ui::stroke_rect"): stroke_rect_b(CT[k], CT[k].current, r, rounding, line_thickness, color)
stroke_circle(c Context, r Rect, line_thickness f32, color Color):
	k := canvas(c, "ui::stroke_circle")
	if k >= 0 && rcoords_ok(r, "ui::stroke_circle") && thick_ok(line_thickness, "ui::stroke_circle"): stroke_circle_b(CT[k], CT[k].current, r, line_thickness, color)
arc_ok(cx f32, cy f32, rad f32, a0 f32, a1 f32, fw const byte[:]) bool:
	if !coords_ok(fw, [cx, cy, rad]): return false
	rad >= 0.0 && fin(a0) && fin(a1) || misuse(str(fw, ": an arc of radius ", pg(rad as real), " from ", pg(a0 as real), " to ", pg(a1 as real)))
stroke_arc(c Context, cx f32, cy f32, radius f32, a_min f32, a_max f32, line_thickness f32, color Color):
	k := canvas(c, "ui::stroke_arc")
