LD_FIX := 0
LD_ROW := 1
LD_FREE := 2
LD_DYN := 3
LS_FIX := 4
LS_ROW := 5
LS_FREE := 6
LS_ST := 7
L_TPL := 8
lpi(u UC&) int: u.ws[u.current].lay
float_ok(f f32, fw const byte[:], what const byte[:]) bool: fin(f) || misuse(str(fw, ": ", what, " ", pg(f as real)))
iflr(x f32) int: (x as! i32 - (if x < 0.0 { 1 } else { 0 })) as int
icel(x f32) int: t := x as! i32; if x >= 0.0 { if x > t as f32 { t as int + 1 } else { t as int } } else { if x - t as f32 > 0.0 { t as int + 1 } else { t as int } }
rndf(x f32) f32: if x >= 0.0 { iflr(x + 0.5) as f32 } else { icel(x - 0.5) as f32 }
frac(x f32) f32: x - (rndf(x) as! i32) as f32
usable(s Style&, total f32, cols i32) f32: total - (if cols - 1 > 0 { cols - 1 } else { 0 }) as f32 * s.window.spacing.x
panel_layout(u UC&, w int, height f32, cols i32):
	let l .= u.ps[u.ws[w].lay]; sp := u.st.window.spacing
	l.row.index = 0; l.at_y += l.row.height; l.row.columns = cols
	l.row.height = if height == 0.0 { mx(height, l.row.min_height) + sp.y } else { height + sp.y }
	l.row.item_offset = 0.0
	if l.flags & WIN_DYNAMIC != 0: fill_rect_b(u, w, Rect{u.ws[w].bounds.x, l.at_y - 1.0, u.ws[w].bounds.w, l.row.height + 1.0}, 0.0, u.st.window.background)
row_layout(u UC&, dynamic bool, height f32, cols i32, width i32):
	panel_layout(u, u.current, height, cols); let r .= u.ps[lpi(u)].row
	r.ty = if dynamic { LD_FIX } else { LS_FIX }; r.ratio = -1; r.filled = 0.0; r.item_offset = 0.0; r.item_width = width as f32
alloc_row(u UC&): l := lpi(u); panel_layout(u, u.current, u.ps[l].row.height - u.st.window.spacing.y, u.ps[l].row.columns)
widget_space(u UC&, b Rect&, modify bool):
	let l .= u.ps[lpi(u)]; sp := u.st.window.spacing; ps := usable(u.st, l.bounds.w, l.row.columns); t := l.row.ty
	io ~= 0.0 as f32; iw ~= 0.0 as f32; isp ~= 0.0 as f32; ox := pget(u, l.ox) as f32; oy := pget(u, l.oy) as f32; ix := l.row.index as f32
	if t == LD_FREE || t == LS_FREE:
		it := l.row.item
		if t == LD_FREE: b.x = l.at_x + l.bounds.w * it.x - ox; b.y = l.at_y + l.row.height * it.y - oy; b.w = l.bounds.w * it.w + frac(b.x); b.h = l.row.height * it.h + frac(b.y); return
		b.x = l.at_x + it.x; b.w = it.w
		if b.x + b.w > l.max_x && modify: l.max_x = b.x + b.w
		b.x -= ox; b.y = l.at_y + it.y - oy; b.h = it.h; return
	if t == LD_FIX: w := mx(1.0, ps) / l.row.columns as f32; io = ix * w; iw = w + frac(io); isp = ix * sp.x
	else if t == LD_ROW:
		w := l.row.item_width * ps; io = l.row.item_offset; iw = w + frac(io)
		if modify: l.row.item_offset += w + sp.x; l.row.filled += l.row.item_width; l.row.index = 0
	else if t == LD_DYN:
		rv := u.ratios[l.row.ratio + l.row.index as int]; ra := if rv < 0.0 { l.row.item_width } else { rv }; w := ra * ps; isp = ix * sp.x; io = l.row.item_offset; iw = w + frac(io)
		if modify: l.row.item_offset += w; l.row.filled += ra
	else if t == LS_FIX: iw = l.row.item_width; io = ix * iw; isp = ix * sp.x
	else if t == LS_ROW: iw = l.row.item_width; io = l.row.item_offset; isp = ix * sp.x; if modify { l.row.item_offset += iw }
	else if t == LS_ST: isp = ix * sp.x; iw = u.ratios[l.row.ratio + l.row.index as int]; io = l.row.item_offset; if modify { l.row.item_offset += iw }
	else if t == L_TPL: w := l.row.templates[l.row.index]; io = l.row.item_offset; iw = w + frac(io); isp = ix * sp.x; if modify { l.row.item_offset += w }
	b.w = iw; b.h = l.row.height - sp.y; b.y = l.at_y - oy; b.x = l.at_x + io + isp
	if b.x + b.w > l.max_x && modify: l.max_x = b.x + b.w
	b.x -= ox
alloc_space(u UC&) Rect:
	b ~= Rect{0.0, 0.0, 0.0, 0.0}; l := lpi(u)
	if u.ps[l].row.index >= u.ps[l].row.columns: alloc_row(u)
	widget_space(u, b, true); u.ps[l].row.index += 1; b
layout_peek(u UC&) Rect:
	b ~= Rect{0.0, 0.0, 0.0, 0.0}; let l .= u.ps[lpi(u)]; y := l.at_y; ix := l.row.index
	if l.row.index >= l.row.columns: l.at_y += l.row.height; l.row.index = 0
	widget_space(u, b, false)
	if l.row.index == 0: b.x -= l.row.item_offset
	l.at_y = y; l.row.index = ix; b
new_row(u UC&, fw const byte[:]) bool:
	if !in_panel(u, fw): return false
	k := u.sc[top_scope(u)].kind
	k != SC_ROW && k != SC_SPACE || expect_scope(u, SC_WINDOW, fw)
row_height_ok(h f32, fw const byte[:]) bool: fin(h) && h >= 0.0 || misuse(str(fw, ": a row ", pg(h as real), " high"))
cols_ok(n int, fw const byte[:]) bool: n >= 1 && n <= 1024 || misuse(str(fw, ": ", n, " columns (1 to 1024)"))
pan_ctx(c Context, fw const byte[:]) int: k := ctx_get(c, fw); if k < 0 || !in_panel(CT[k], fw) { -1 } else { k }
rule_horizontal(c Context, color Color, rounding bool):
	k := pan_ctx(c, "ui::rule_horizontal"); if k < 0: return
	b ~= Rect{0.0, 0.0, 0.0, 0.0}; if widget(CT[k], b) == 0: return
	fill_rect_b(CT[k], CT[k].current, b, if rounding && b.h > 1.5 { b.h / 2.0 } else { 0.0 }, color)
layout_set_min_row_height(c Context, height f32): k := pan_ctx(c, "ui::layout_set_min_row_height"); if k >= 0 && row_height_ok(height, "ui::layout_set_min_row_height") { CT[k].ps[lpi(CT[k])].row.min_height = height }
layout_reset_min_row_height(c Context): k := pan_ctx(c, "ui::layout_reset_min_row_height"); if k >= 0 { reset_min_row_height(CT[k]) }
layout_widget_bounds(c Context) Rect:
	k := pan_ctx(c, "ui::layout_widget_bounds"); if k < 0: return Rect{0.0, 0.0, 0.0, 0.0}
	l := CT[k].ps[lpi(CT[k])]; Rect{l.at_x, l.at_y, l.bounds.w - mx(l.at_x - l.bounds.x, 0.0), l.row.height}
layout_ratio_from_pixel(c Context, pixel_width f32) f32:
	k := pan_ctx(c, "ui::layout_ratio_from_pixel"); if k < 0 || !float_ok(pixel_width, "ui::layout_ratio_from_pixel", "a width of"): return 0.0
	mx(mn(pixel_width / CT[k].ws[CT[k].current].bounds.x, 1.0), 0.0)
layout_row_dynamic(c Context, height f32, cols int):
	k := ctx_get(c, "ui::layout_row_dynamic"); if k < 0: return
	if new_row(CT[k], "ui::layout_row_dynamic") && row_height_ok(height, "ui::layout_row_dynamic") && cols_ok(cols, "ui::layout_row_dynamic"): row_layout(CT[k], true, height, cols as i32, 0)
layout_row_static(c Context, height f32, item_width int, cols int):
	k := ctx_get(c, "ui::layout_row_static"); if k < 0: return
	if new_row(CT[k], "ui::layout_row_static") && row_height_ok(height, "ui::layout_row_static") && cols_ok(cols, "ui::layout_row_static"): row_layout(CT[k], false, height, cols as i32, iclamp(item_width) as i32)
fmt_ok(f int, fw const byte[:]) bool: enum_ok(f, 2, fw, "DYNAMIC, STATIC")
layout_row_begin(c Context, format int, row_height f32, cols int):
	k := ctx_get(c, "ui::layout_row_begin"); if k < 0: return
	let u .= CT[k]; fw := "ui::layout_row_begin"
	if !new_row(u, fw) || !fmt_ok(format, fw) || !row_height_ok(row_height, fw) || !cols_ok(cols, fw) || !push_scope(u, SC_ROW, true, fw): return
	panel_layout(u, u.current, row_height, cols as i32); let r .= u.ps[lpi(u)].row
	r.ty = if format == 0 { LD_ROW } else { LS_ROW }; r.ratio = -1; r.filled = 0.0; r.item_width = 0.0; r.item_offset = 0.0; r.columns = cols as i32
layout_row_push(c Context, value f32):
	k := pan_ctx(c, "ui::layout_row_push"); if k < 0 || !expect_scope(CT[k], SC_ROW, "ui::layout_row_push") || !float_ok(value, "ui::layout_row_push", "a width or ratio of"): return
	let r .= CT[k].ps[lpi(CT[k])].row
	if r.ty != LS_ROW && r.ty != LD_ROW: return
	if r.ty == LD_ROW:
		if value + r.filled > 1.0: return
		r.item_width = if value > 0.0 { sat(value) } else { 1.0 - r.filled }
	else: r.item_width = value
layout_row_end(c Context):
	k := pan_ctx(c, "ui::layout_row_end"); if k < 0 || !expect_scope(CT[k], SC_ROW, "ui::layout_row_end"): return
	let r .= CT[k].ps[lpi(CT[k])].row
	if r.ty == LS_ROW || r.ty == LD_ROW: r.item_width = 0.0; r.item_offset = 0.0
	pop_scope(CT[k])
layout_row(c Context, format int, height f32, ratios const f32[:]):
	k := ctx_get(c, "ui::layout_row"); if k < 0: return
	let u .= CT[k]; fw := "ui::layout_row"
	if !new_row(u, fw) || !fmt_ok(format, fw) || !row_height_ok(height, fw) || !cols_ok(ratios.len, fw): return
	for x ratios: if !float_ok(x, fw, "a ratio or width of") { return }
	ri := u.ratios.len; u.ratios.append(ratios)
	panel_layout(u, u.current, height, ratios.len as i32); let r .= u.ps[lpi(u)].row; r.ratio = ri
	if format == 0:
		s ~= 0.0 as f32; nu ~= 0
		for x ratios: if x < 0.0 { nu += 1 } else { s += x }
		s = sat(1.0 - s); r.ty = LD_DYN; r.item_width = if s > 0.0 && nu > 0 { s / nu as f32 } else { 0.0 }
	else: r.ty = LS_ST; r.item_width = 0.0
	r.item_offset = 0.0; r.filled = 0.0
layout_row_template_begin(c Context, row_height f32):
	k := ctx_get(c, "ui::layout_row_template_begin"); if k < 0: return
	let u .= CT[k]; fw := "ui::layout_row_template_begin"
	if !new_row(u, fw) || !row_height_ok(row_height, fw) || !push_scope(u, SC_TEMPLATE, true, fw): return
	panel_layout(u, u.current, row_height, 1); let r .= u.ps[lpi(u)].row
	r.ty = L_TPL; r.columns = 0; r.ratio = -1; r.item_width = 0.0; r.item_height = 0.0; r.item_offset = 0.0; r.filled = 0.0; r.item = Rect{0.0, 0.0, 0.0, 0.0}
tpl_ok(c Context, fw const byte[:]) int:
	k := ctx_get(c, fw); if k < 0 || !in_window(CT[k], fw) || !expect_scope(CT[k], SC_TEMPLATE, fw): return -1
	if CT[k].ps[lpi(CT[k])].row.columns >= 16: misuse(str(fw, ": a row template has at most 16 columns")); return -1
	k
tpl_put(k int, v f32): let r .= CT[k].ps[lpi(CT[k])].row; if r.ty == L_TPL && r.columns < 16 { r.templates[r.columns] = v; r.columns += 1 }
layout_row_template_push_dynamic(c Context): k := tpl_ok(c, "ui::layout_row_template_push_dynamic"); if k >= 0 { tpl_put(k, -1.0) }
layout_row_template_push_variable(c Context, min_width f32): k := tpl_ok(c, "ui::layout_row_template_push_variable"); if k >= 0 && float_ok(min_width, "ui::layout_row_template_push_variable", "a width of") { tpl_put(k, -min_width) }
