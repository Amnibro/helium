draw_image(c Context, r Rect, img Image, color Color):
	k := canvas(c, "ui::draw_image")
	if k >= 0 && rcoords_ok(r, "ui::draw_image"): draw_image_b(CT[k], CT[k].current, r, img, color)
draw_nine_slice(c Context, r Rect, slice NineSlice, color Color):
	k := canvas(c, "ui::draw_nine_slice")
	if k >= 0 && rcoords_ok(r, "ui::draw_nine_slice"): draw_nine_slice_b(CT[k], CT[k].current, r, slice, color)
draw_text(c Context, r Rect, text const byte[:], font Font, background Color, foreground Color):
	k := canvas(c, "ui::draw_text")
