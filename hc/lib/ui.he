tgl(t const Color[:], pd f32) StyleToggle: StyleToggle{normal: ic(t[7]), hover: ic(t[8]), active: ic(t[8]), border_color: NOCOL, cursor_normal: ic(t[9]), cursor_hover: ic(t[9]), text_normal: t[0], text_hover: t[0], text_active: t[0], text_background: t[1], padding: v2(pd, pd), touch_padding: v2(0.0, 0.0), spacing: 4.0, border: 0.0, color_factor: 1.0, disabled_factor: 0.5, ..}
