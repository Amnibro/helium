tooltip(c Context, text const byte[:]): k := pop_ctx(c, "ui::tooltip"); if k >= 0 { tip_text(CT[k], cstr(text), CT[k].st.window.tooltip_origin, CT[k].st.window.tooltip_offset) }
tooltip_offset(c Context, text const byte[:], position int, offset float2): fw := "ui::tooltip_offset"; k := pop_ctx(c, fw); if k >= 0 && tip_pos_ok(position, offset, fw) { tip_text(CT[k], cstr(text), position, offset) }
tooltip_begin(c Context, width f32) bool: fw := "ui::tooltip_begin"; k := pop_ctx(c, fw); k >= 0 && float_ok(width, fw, "a width of") && opened(CT[k], tip_begin(CT[k], width, CT[k].st.window.tooltip_origin, CT[k].st.window.tooltip_offset), SC_TOOLTIP, fw)
tooltip_begin_offset(c Context, width f32, position int, offset float2) bool: fw := "ui::tooltip_begin_offset"; k := pop_ctx(c, fw); k >= 0 && float_ok(width, fw, "a width of") && tip_pos_ok(position, offset, fw) && opened(CT[k], tip_begin(CT[k], width, position, offset), SC_TOOLTIP, fw)
tooltip_end(c Context): k := ender(c, SC_TOOLTIP, "ui::tooltip_end"); if k >= 0 { tip_end(CT[k]); pop_scope(CT[k]) }
do_tooltip(c Context, text const byte[:], bounds Rect): fw := "ui::do_tooltip"; k := pop_ctx(c, fw); if k >= 0 && rect_ok(bounds, fw) && i_hover(CT[k].inp, bounds) { tip_text(CT[k], cstr(text), CT[k].st.window.tooltip_origin, CT[k].st.window.tooltip_offset) }
do_tooltip_delay(c Context, text const byte[:], bounds Rect, timer f32&):
	fw := "ui::do_tooltip_delay"; k := pop_ctx(c, fw); ck ~= false
	if k >= 0 && rect_ok(bounds, fw) && float_ok(timer, fw, "a timer of") && hover_delay(CT[k], bounds, timer, CT[k].st.window.tooltip_delay, ck, false): tip_text(CT[k], cstr(text), CT[k].st.window.tooltip_origin, CT[k].st.window.tooltip_offset)
