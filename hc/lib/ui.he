	tb.tab_minimize_button = btn(t[27], t[27], t[27], NOCOL, t[27], t[0], 2.0, 0.0, 0.0); tb.tab_maximize_button = tb.tab_minimize_button
	tb.node_minimize_button = btn(t[1], t[1], t[1], NOCOL, t[27], t[0], 2.0, 0.0, 0.0); tb.node_maximize_button = tb.node_minimize_button
	let w .= s.window; let h .= w.header
