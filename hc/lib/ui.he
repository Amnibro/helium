	if k >= 0 && rcoords_ok(r, "ui::push_scissor"): push_scissor_b(CT[k], CT[k].current, r)
font_atlas_of(fid u32) u32: k := fidx(fid); if k < 0 { 0 } else { FNT[k].atl }
atlas_in_use(id u32) bool:
	for i CT.len:
		if i < TCTX.live.len && TCTX.live[i]:
			let u .= CT[i]
			if u.atlas == id: return true
			if font_atlas_of(u.font) == id: return true
			for f u.fstk: if font_atlas_of(f) == id { return true }
	false
setup(u UC&, fid u32):
	u.st = Style{..}; style_from(u.st, DEFAULT_COLORS[..]); u.seq = 1; u.font = fid; u.cact = -1; u.cvis = false; u.begin = -1; u.end = -1; u.active = -1; u.current = -1
	for i 7: u.curs[i] = -1
create_context(font Font) Context:
	k := font_get(font, "ui::create_context"); if k < 0: return Context{0}
	if !ATL[gfx::ix(FNT[k].atl)].baked: misuse("ui::create_context: the font's atlas is not baked yet (ui::bake it first)"); return Context{0}
	if TCTX.what.len == 0: gfx::tclear(TCTX, "context")
	id u32 := gfx::tadd(TCTX); i := gfx::ix(id)
	gfx::put(CT, i, UC{..}); let u .= CT[i]; setup(u, font.id); u.atlas = FNT[k].atl; u.scale = 1.0; u.id = id
	Context{id}
own_context(src int, data const byte[:], height f32, fw const byte[:]) Context:
	a := create_font_atlas(); if a.id == 0: return Context{0}
	f := add_font(a, src, data, height, FontConfig{}, [], fw)
	c := if f.id != 0 && bake(a, 1.0) { create_context(f) } else { Context{0} }
	k := gfx::tfind(TCTX, c.id)
	if k < 0: destroy(a); return Context{0}
	CT[k].owns = true; c
create(font_height f32) Context: own_context(0, [], font_height, "ui::create")
create_from_file(path const byte[:], font_height f32) Context: own_context(2, path, font_height, "ui::create_from_file")
create_from_memory(ttf const byte[:], font_height f32) Context: own_context(1, ttf, font_height, "ui::create_from_memory")
context_atlas(c Context) FontAtlas: k := ctx_get(c, "ui::context_atlas"); if k < 0 { FontAtlas{0} } else { FontAtlas{CT[k].atlas} }
destroy_raw(c Context):
	k := ctx_get(c, "ui::destroy"); if k < 0: return
	gfx::trem(TCTX, c.id); own := CT[k].owns; aid u32 := CT[k].atlas; CT[k] = UC{..}
	if own:
		ai := gfx::tfind(TATL, aid)
		if ai >= 0 && !atlas_in_use(aid): free_atlas(ai, aid)
is_valid(c Context) bool: if TCTX.what.len == 0 { gfx::tclear(TCTX, "context") } gfx::tfind(TCTX, c.id) >= 0
clear(c Context): k := ctx_get(c, "ui::clear"); if k >= 0 && outside(CT[k], "ui::clear") { end_frame(CT[k]) }
set_delta_time(c Context, seconds f32):
	k := ctx_get(c, "ui::set_delta_time"); if k < 0: return
	if !fin(seconds) || seconds < 0.0: misuse(str("ui::set_delta_time: ", pg(seconds as real), " seconds")); return
	CT[k].dt = seconds
delta_time(c Context) f32: k := ctx_get(c, "ui::delta_time"); if k < 0 { 0.0 } else { CT[k].dt }
font(c Context) Font: k := ctx_get(c, "ui::font"); if k < 0 { Font{0} } else { Font{CT[k].font} }
set_clipboard(c Context, text const byte[:]):
	k := ctx_get(c, "ui::set_clipboard"); if k < 0: return
	n := tlen(text, "ui::set_clipboard"); CT[k].paste.clear(); CT[k].paste.append(text[..n])
copied_into(c Context, out byte[:]) int:
	k := ctx_get(c, "ui::copied"); if k < 0: return -1
	if !CT[k].copied: return -1
	if out.len >= CT[k].copy.len: CT[k].copied = false
	copy_out(CT[k].copy[..], out)
null_texture(c Context) u32:
	k := ctx_get(c, "ui::null_texture"); if k < 0: return 0
	ai := gfx::tfind(TATL, CT[k].atlas); if ai < 0 { 0 } else { ATL[ai].tex }
set_scale(c Context, scale f32) bool:
	k := ctx_get(c, "ui::set_scale"); if k < 0: return false
	if !outside(CT[k], "ui::set_scale") || !scale_ok(scale, "ui::set_scale"): return false
	if CT[k].owns && !bake(FontAtlas{CT[k].atlas}, scale): return false
	CT[k].scale = scale; true
scale(c Context) f32: k := ctx_get(c, "ui::scale"); if k < 0 { 1.0 } else { CT[k].scale }
walk(u UC&, out Command[:], pts int2[:], tx byte[:], np int&, nt int&) int:
	n ~= 0; np = 0; nt = 0; c ~= first_cmd(u)
	while c >= 0:
		g ~= u.cm[c].c; ki := g.kind
		if ki >= COMMAND_POLYGON && ki <= COMMAND_POLYLINE:
			f := g.first as int; g.first = np as i32
			for i g.count: if np < pts.len { pts[np] = u.pt[f + i] } np += 1
		else if ki == COMMAND_TEXT:
			f := g.first as int; g.first = nt as i32
			for i g.count: if nt < tx.len { tx[nt] = u.tx[f + i] } nt += 1
		if n < out.len: out[n] = g
		n += 1; c = next_cmd(u, c)
	n
commands_into(c Context, out Command[:]) int:
	k := ctx_get(c, "ui::commands"); if k < 0 || !outside(CT[k], "ui::commands"): return 0
	np ~= 0; nt ~= 0; walk(CT[k], out, [], [], np, nt)
command_points_into(c Context, out int2[:]) int:
	k := ctx_get(c, "ui::command_points"); if k < 0 || !outside(CT[k], "ui::command_points"): return 0
	np ~= 0; nt ~= 0; walk(CT[k], [], out, [], np, nt); np
command_text_into(c Context, out byte[:]) int:
	k := ctx_get(c, "ui::command_text"); if k < 0 || !outside(CT[k], "ui::command_text"): return 0
	np ~= 0; nt ~= 0; walk(CT[k], [], [], out, np, nt); nt
struct CF { r f32, g f32, b f32, a f32 }
struct DLC { n u32, clip Rect, tex u32 }
struct DLS { cfg ConvertConfig, null_tex u32, nuv float2, clip Rect, cmds DLC[>..], path float2[>..], circ float2[12] }
var DL = DLS{..}
nk_sin(x f32) f32: S0 + x * (S1 + x * (S2 + x * (S3 + x * (S4 + x * (S5 + x * (S6 + x * S7))))))
nk_cos(x f32) f32: C0 + x * (C1 + x * (C2 + x * (C3 + x * (C4 + x * (C5 + x * (C6 + x * (C7 + x * C8)))))))
inv_sqrt(n f32) f32: x2 := n * 0.5; f := gfx::fbits(0x5f375A84 - (gfx::f32b(n) >> 1)); f * (1.5 - x2 * f * f)
sat(x f32) f32: m := if 1.0 < x { 1.0 as f32 } else { x }; if 0.0 < m { m } else { 0.0 }
cfv(c Color) CF: CF{c.r as f32 * INV255, c.g as f32 * INV255, c.b as f32 * INV255, c.a as f32 * INV255}
cb8(x f32) byte: (sat(sat(x)) * 255.0) as! u8
vtx(u UC&, p float2, uv float2, c CF): u.vx.push(Vertex{p, uv, Color{cb8(c.r), cb8(c.g), cb8(c.b), cb8(c.a)}})
galpha(a byte) byte: (a as f32 * DL.cfg.global_alpha) as! u8
dl_push_cmd(clip Rect, tex u32): DL.cmds.push(DLC{0, clip, tex}); DL.clip = clip
dl_add_clip(r Rect):
	if DL.cmds.len == 0: dl_push_cmd(r, DL.null_tex); return
	let p .= DL.cmds[DL.cmds.len - 1]
	if p.n == 0: p.clip = r
	dl_push_cmd(r, DL.cmds[DL.cmds.len - 1].tex)
dl_push_image(tex u32):
	if DL.cmds.len == 0: dl_push_cmd(NULL_RECT, tex); return
	let p .= DL.cmds[DL.cmds.len - 1]
	if p.n == 0: p.tex = tex
	else if p.tex != tex: dl_push_cmd(DL.cmds[DL.cmds.len - 1].clip, tex)
dl_elems(u UC&, ids const u32[:]): u.ixs.append(ids); DL.cmds[DL.cmds.len - 1].n += ids.len as! u32
line_to(p float2):
	if DL.cmds.len == 0: dl_add_clip(NULL_RECT)
	if DL.cmds[DL.cmds.len - 1].tex != DL.null_tex: dl_push_image(DL.null_tex)
	DL.path.push(p)
vadd(a float2, b float2) float2: float2{a.x + b.x, a.y + b.y}
vsub(a float2, b float2) float2: float2{a.x - b.x, a.y - b.y}
vmul(a float2, s f32) float2: float2{a.x * s, a.y * s}
nrm(d0 float2) float2:
	l ~= d0.x * d0.x + d0.y * d0.y
	l = if l != 0.0 { inv_sqrt(l) } else { 1.0 }
	vmul(d0, l)
dmf(a float2, b float2) float2:
	dm ~= vmul(vadd(a, b), 0.5); d2 := dm.x * dm.x + dm.y * dm.y
	if d2 > EPS6: sc := mn(100.0, 1.0 / d2); dm = vmul(dm, sc)
	dm
stroke_poly(u UC&, pts const float2[:], col0 Color, closed bool, th f32, aa bool):
	pc := pts.len; if pc < 2: return
	c0 ~= col0; c0.a = galpha(c0.a); cnt := if closed { pc } else { pc - 1 }; thick := th > 1.0
	c0.a = galpha(c0.a); col := cfv(c0); ct := CF{col.r, col.g, col.b, 0.0}; uv := DL.nuv
	if aa:
		ix := u.vx.len; ids u32[>..] ~= []
		nm float2[>..] ~= []; nm.resize(pc, float2{0.0, 0.0}); tp float2[>..] ~= []; tp.resize(pc * (if thick { 4 } else { 2 }), float2{0.0, 0.0})
		for i1 cnt: i2 := if i1 + 1 == pc { 0 } else { i1 + 1 }; d := nrm(vsub(pts[i2], pts[i1])); nm[i1] = float2{d.y, -d.x}
		if !closed: nm[pc - 1] = nm[pc - 2]
		if !thick:
			if !closed:
				tp[0] = vadd(pts[0], vmul(nm[0], 1.0)); tp[1] = vsub(pts[0], vmul(nm[0], 1.0)); d := vmul(nm[pc - 1], 1.0)
				tp[(pc - 1) * 2] = vadd(pts[pc - 1], d); tp[(pc - 1) * 2 + 1] = vsub(pts[pc - 1], d)
			x1 ~= ix
			for i1 cnt:
				i2 := if i1 + 1 == pc { 0 } else { i1 + 1 }; x2 := if i1 + 1 == pc { ix } else { x1 + 3 }
				dm := vmul(dmf(nm[i1], nm[i2]), 1.0)
				tp[i2 * 2] = vadd(pts[i2], dm); tp[i2 * 2 + 1] = vsub(pts[i2], dm)
				for v [x2, x1, x1 + 2, x1 + 2, x2 + 2, x2, x2 + 1, x1 + 1, x1, x1, x2, x2 + 1]: ids.push(v as! u32)
				x1 = x2
			for i pc: vtx(u, pts[i], uv, col); vtx(u, tp[i * 2], uv, ct); vtx(u, tp[i * 2 + 1], uv, ct)
		else:
			hi := (th - 1.0) * 0.5
			if !closed:
				d1 ~= vmul(nm[0], hi + 1.0); d2 ~= vmul(nm[0], hi)
				tp[0] = vadd(pts[0], d1); tp[1] = vadd(pts[0], d2); tp[2] = vsub(pts[0], d2); tp[3] = vsub(pts[0], d1)
				d1 = vmul(nm[pc - 1], hi + 1.0); d2 = vmul(nm[pc - 1], hi); e := (pc - 1) * 4
				tp[e] = vadd(pts[pc - 1], d1); tp[e + 1] = vadd(pts[pc - 1], d2); tp[e + 2] = vsub(pts[pc - 1], d2); tp[e + 3] = vsub(pts[pc - 1], d1)
			x1 ~= ix
			for i1 cnt:
				i2 := if i1 + 1 == pc { 0 } else { i1 + 1 }; x2 := if i1 + 1 == pc { ix } else { x1 + 4 }
				dm := dmf(nm[i1], nm[i2]); dmo := vmul(dm, hi + 1.0); dmi := vmul(dm, hi)
				tp[i2 * 4] = vadd(pts[i2], dmo); tp[i2 * 4 + 1] = vadd(pts[i2], dmi); tp[i2 * 4 + 2] = vsub(pts[i2], dmi); tp[i2 * 4 + 3] = vsub(pts[i2], dmo)
				for v [x2 + 1, x1 + 1, x1 + 2, x1 + 2, x2 + 2, x2 + 1, x2 + 1, x1 + 1, x1, x1, x2, x2 + 1, x2 + 2, x1 + 2, x1 + 3, x1 + 3, x2 + 3, x2 + 2]: ids.push(v as! u32)
				x1 = x2
			for i pc: vtx(u, tp[i * 4], uv, ct); vtx(u, tp[i * 4 + 1], uv, col); vtx(u, tp[i * 4 + 2], uv, col); vtx(u, tp[i * 4 + 3], uv, ct)
		dl_elems(u, ids[..])
	else:
		ix ~= u.vx.len; ids u32[>..] ~= []
		for i1 cnt:
			i2 := if i1 + 1 == pc { 0 } else { i1 + 1 }; p1 := pts[i1]; p2 := pts[i2]; d := nrm(vsub(p2, p1))
			dx := d.x * (th * 0.5); dy := d.y * (th * 0.5)
			vtx(u, float2{p1.x + dy, p1.y - dx}, uv, col); vtx(u, float2{p2.x + dy, p2.y - dx}, uv, col); vtx(u, float2{p2.x - dy, p2.y + dx}, uv, col); vtx(u, float2{p1.x - dy, p1.y + dx}, uv, col)
			for v [ix, ix + 1, ix + 2, ix, ix + 2, ix + 3]: ids.push(v as! u32)
			ix += 4
		dl_elems(u, ids[..])
fill_poly(u UC&, pts const float2[:], col0 Color, aa bool):
	pc := pts.len; if pc < 3: return
	c0 ~= col0; c0.a = galpha(c0.a); col := cfv(c0); ct := CF{col.r, col.g, col.b, 0.0}; uv := DL.nuv
	ix := u.vx.len; ids u32[>..] ~= []
	if aa:
		vin := ix; vout := ix + 1
		for i 2..pc: ids.push(vin as! u32); ids.push((vin + ((i - 1) << 1)) as! u32); ids.push((vin + (i << 1)) as! u32)
		nm float2[>..] ~= []; nm.resize(pc, float2{0.0, 0.0}); i0 ~= pc - 1
		for i1 pc: d := nrm(vsub(pts[i1], pts[i0])); nm[i0] = float2{d.y, -d.x}; i0 = i1
		i0 = pc - 1
		for i1 pc:
			dm0 ~= vmul(vadd(nm[i0], nm[i1]), 0.5); d2 := dm0.x * dm0.x + dm0.y * dm0.y
			if d2 > EPS6: sc := mn(1.0 / d2, 100.0); dm0 = vmul(dm0, sc)
			dm := vmul(dm0, 0.5)
			vtx(u, vsub(pts[i1], dm), uv, col); vtx(u, vadd(pts[i1], dm), uv, ct)
			for v [vin + (i1 << 1), vin + (i0 << 1), vout + (i0 << 1), vout + (i0 << 1), vout + (i1 << 1), vin + (i1 << 1)]: ids.push(v as! u32)
			i0 = i1
	else:
		for p pts: vtx(u, p, uv, col)
		for i 2..pc: ids.push(ix as! u32); ids.push((ix + i - 1) as! u32); ids.push((ix + i) as! u32)
	dl_elems(u, ids[..])
path_fill(u UC&, col Color): fill_poly(u, DL.path[..], col, DL.cfg.shape_aa); DL.path.clear()
path_stroke(u UC&, col Color, closed bool, th f32): stroke_poly(u, DL.path[..], col, closed, th, DL.cfg.line_aa); DL.path.clear()
arc_fast(c float2, r f32, a0 int, a1 int):
	if a0 <= a1: for a a0..a1 + 1 { q := DL.circ[a % 12]; line_to(float2{c.x + q.x * r, c.y + q.y * r}) }
arc_to(c float2, r f32, a0 f32, a1 f32, segs int):
	if r == 0.0: return
	da := (a1 - a0) / segs as f32; sd := nk_sin(da); cd := nk_cos(da); cx ~= nk_cos(a0) * r; cy ~= nk_sin(a0) * r
	for i segs + 1: line_to(float2{c.x + cx, c.y + cy}); nx := cx * cd - cy * sd; ny := cy * cd + cx * sd; cx = nx; cy = ny
rect_to(a float2, b float2, ro f32):
	r ~= ro; r = mn(r, if b.x - a.x < 0.0 { -(b.x - a.x) } else { b.x - a.x }); r = mn(r, if b.y - a.y < 0.0 { -(b.y - a.y) } else { b.y - a.y })
	if r == 0.0: line_to(a); line_to(float2{b.x, a.y}); line_to(b); line_to(float2{a.x, b.y}); return
	arc_fast(float2{a.x + r, a.y + r}, r, 6, 9); arc_fast(float2{b.x - r, a.y + r}, r, 9, 12); arc_fast(float2{b.x - r, b.y - r}, r, 0, 3); arc_fast(float2{a.x + r, b.y - r}, r, 3, 6)
curve_to(p2 float2, p3 float2, p4 float2, ns0 int):
	if DL.path.len == 0: return
	ns := max(ns0, 1); p1 := DL.path[DL.path.len - 1]; ts := 1.0 / ns as f32
	for i 1..ns + 1:
		t := ts * i as f32; w := 1.0 - t; w1 := w * w * w; w2 := 3.0 * w * w * t; w3 := 3.0 * w * t * t; w4 := t * t * t
		line_to(float2{w1 * p1.x + w2 * p2.x + w3 * p3.x + w4 * p4.x, w1 * p1.y + w2 * p2.y + w3 * p3.y + w4 * p4.y})
rect_uv(u UC&, a float2, c float2, uva float2, uvc float2, col0 Color):
	col := cfv(col0); ix := u.vx.len
	dl_elems(u, [ix as! u32, (ix + 1) as! u32, (ix + 2) as! u32, ix as! u32, (ix + 2) as! u32, (ix + 3) as! u32])
	vtx(u, a, uva, col); vtx(u, float2{c.x, a.y}, float2{uvc.x, uva.y}, col); vtx(u, c, uvc, col); vtx(u, float2{a.x, c.y}, float2{uva.x, uvc.y}, col)
add_text(u UC&, fid u32, r Rect, t const byte[:], fh f32, fg0 Color):
	if t.len == 0 || !risect(r, DL.clip): return
	k := fidx(fid); let a .= ATL[gfx::ix(FNT[k].atl)]; let f .= a.af[FNT[k].fi]
	dl_push_image(a.tex)
	tb byte[>..] ~= []; tb.append(t); tb.push(0)
	x ~= r.x; tl ~= 0; cp ~= 0; nx ~= 0; gl ~= utf_decode(tb[..], 0, t.len, cp)
	if gl == 0: return
	fg ~= fg0; fg.a = galpha(fg.a); sc := fh / f.height
	while tl < t.len && gl != 0:
		if cp == 0xFFFD: break
		ng := utf_decode(tb[..], tl + gl, min(t.len - tl, tb.len - tl - gl), nx)
		g := a.gl[find_in(a, f, cp as u32)]
		gx := x + g.x0 * sc; gy := r.y + g.y0 * sc
		rect_uv(u, float2{gx, gy}, float2{gx + (g.x1 - g.x0) * sc, gy + (g.y1 - g.y0) * sc}, float2{g.u0, g.v0}, float2{g.u1, g.v1}, fg)
		tl += gl; x += g.xadvance * sc; gl = ng; cp = nx
add_image(u UC&, img Image, r Rect, col Color):
	dl_push_image(img.texture)
	if !(img.w == 0 && img.h == 0):
		u0 := float2{img.region[0] as f32 / img.w as f32, img.region[1] as f32 / img.h as f32}
		u1 := float2{(img.region[0] as int + img.region[2] as int) as f32 / img.w as f32, (img.region[1] as int + img.region[3] as int) as f32 / img.h as f32}
		rect_uv(u, float2{r.x, r.y}, float2{r.x + r.w, r.y + r.h}, u0, u1, col)
	else: rect_uv(u, float2{r.x, r.y}, float2{r.x + r.w, r.y + r.h}, float2{0.0, 0.0}, float2{1.0, 1.0}, col)
cxy(c Command) Rect: Rect{c.x as f32, c.y as f32, c.w as f32, c.h as f32}
cpt(p int2) float2: float2{p.x as f32, p.y as f32}
convert_cmds(u UC&):
	cg := DL.cfg; c ~= first_cmd(u)
	while c >= 0:
		m := u.cm[c].c; ki := m.kind
		if ki == COMMAND_SCISSOR: dl_add_clip(cxy(m))
		else if ki == COMMAND_LINE:
			if m.color.a != 0:
				if cg.line_aa: line_to(cpt(m.points[0])); line_to(cpt(m.points[1]))
				else: line_to(vsub(cpt(m.points[0]), float2{0.5, 0.5})); line_to(vsub(cpt(m.points[1]), float2{0.5, 0.5}))
				path_stroke(u, m.color, false, m.line_thickness as f32)
		else if ki == COMMAND_CURVE:
			if m.color.a != 0: line_to(cpt(m.points[0])); curve_to(cpt(m.points[1]), cpt(m.points[2]), cpt(m.points[3]), cg.curve_segment_count as int); path_stroke(u, m.color, false, m.line_thickness as f32)
		else if ki == COMMAND_RECT || ki == COMMAND_RECT_FILLED:
			if m.color.a != 0:
				r := cxy(m)
				if cg.line_aa: rect_to(float2{r.x, r.y}, float2{r.x + r.w, r.y + r.h}, m.rounding as f32)
				else: rect_to(float2{r.x - 0.5, r.y - 0.5}, float2{r.x + r.w, r.y + r.h}, m.rounding as f32)
				if ki == COMMAND_RECT: path_stroke(u, m.color, true, m.line_thickness as f32)
				else: path_fill(u, m.color)
		else if ki == COMMAND_RECT_MULTI_COLOR:
			r := cxy(m); l := cfv(m.left); rt := cfv(m.right); tp := cfv(m.top); bt := cfv(m.bottom)
			dl_push_image(DL.null_tex); ix := u.vx.len
			dl_elems(u, [ix as! u32, (ix + 1) as! u32, (ix + 2) as! u32, ix as! u32, (ix + 2) as! u32, (ix + 3) as! u32])
			vtx(u, float2{r.x, r.y}, DL.nuv, l); vtx(u, float2{r.x + r.w, r.y}, DL.nuv, tp); vtx(u, float2{r.x + r.w, r.y + r.h}, DL.nuv, rt); vtx(u, float2{r.x, r.y + r.h}, DL.nuv, bt)
		else if ki == COMMAND_CIRCLE || ki == COMMAND_CIRCLE_FILLED:
			if m.color.a != 0:
				sg := cg.circle_segment_count as int; ce := float2{m.x as f32 + m.w as f32 / 2.0, m.y as f32 + m.h as f32 / 2.0}
				amax := NKPI * 2.0 * (sg as f32 - 1.0) / sg as f32
				arc_to(ce, m.w as f32 / 2.0, 0.0, amax, sg)
				if ki == COMMAND_CIRCLE: path_stroke(u, m.color, true, m.line_thickness as f32)
				else: path_fill(u, m.color)
		else if ki == COMMAND_ARC || ki == COMMAND_ARC_FILLED:
			ce := float2{m.x as f32, m.y as f32}; line_to(ce); arc_to(ce, m.w as f32, m.a_min, m.a_max, cg.arc_segment_count as int)
			if ki == COMMAND_ARC: path_stroke(u, m.color, true, m.line_thickness as f32)
			else: path_fill(u, m.color)
		else if ki == COMMAND_TRIANGLE || ki == COMMAND_TRIANGLE_FILLED:
			if m.color.a != 0:
				line_to(cpt(m.points[0])); line_to(cpt(m.points[1])); line_to(cpt(m.points[2]))
				if ki == COMMAND_TRIANGLE: path_stroke(u, m.color, true, m.line_thickness as f32)
				else: path_fill(u, m.color)
		else if ki == COMMAND_POLYGON || ki == COMMAND_POLYGON_FILLED || ki == COMMAND_POLYLINE:
			for i m.count: line_to(cpt(u.pt[m.first as int + i]))
			if ki == COMMAND_POLYGON_FILLED: path_fill(u, m.color)
			else: path_stroke(u, m.color, ki == COMMAND_POLYGON, m.line_thickness as f32)
		else if ki == COMMAND_TEXT: f0 := m.first as int; f1 := f0 + m.count as int; add_text(u, m.font.id, cxy(m), u.tx[f0..f1], m.height, m.color)
		else if ki == COMMAND_IMAGE: add_image(u, m.image, cxy(m), m.color)
		c = next_cmd(u, c)
circle_init(): for i 12 { a := (i as f32 / 12.0) * 2.0 * NKPI; DL.circ[i] = float2{nk_cos(a), nk_sin(a)} }
convert_raw(c Context, config const ConvertConfig&) int:
	k := ctx_get(c, "ui::convert"); if k < 0: return CONVERT_INVALID_PARAM
	let u .= CT[k]
	if !outside(u, "ui::convert"): return CONVERT_INVALID_PARAM
	g := config
	if !(g.global_alpha >= 0.0 && g.global_alpha <= 1.0) || g.circle_segment_count < 3 || g.arc_segment_count < 3 || g.curve_segment_count < 3 || g.circle_segment_count > 1024 || g.arc_segment_count > 1024 || g.curve_segment_count > 1024:
		misuse(str("ui::convert: a global alpha of ", pg(g.global_alpha as real), " (0 to 1) and segment counts of ", g.circle_segment_count, ", ", g.arc_segment_count, ", ", g.curve_segment_count, " (3 to 1024)")); return CONVERT_INVALID_PARAM
	ai := gfx::tfind(TATL, u.atlas)
	DL.cfg = g; DL.null_tex = ATL[ai].tex; DL.nuv = ATL[ai].nuv; DL.clip = NULL_RECT; DL.cmds.clear(); DL.path.clear(); circle_init()
	u.vx.clear(); u.ixs.clear(); u.dc.clear()
	convert_cmds(u)
	if u.scale != 1.0: for i u.vx.len { u.vx[i].pos = float2{u.vx[i].pos.x * u.scale, u.vx[i].pos.y * u.scale} }
	for d DL.cmds: if d.n != 0 { u.dc.push(DrawCommand{d.n, Rect{d.clip.x * u.scale, d.clip.y * u.scale, d.clip.w * u.scale, d.clip.h * u.scale}, d.tex}) }
	u.converted = true; CONVERT_SUCCESS
vertices_into(c Context, out Vertex[:]) int: k := ctx_get(c, "ui::vertices"); if k < 0 || !CT[k].converted { 0 } else { copy_out(CT[k].vx[..], out) }
indices_into(c Context, out u32[:]) int: k := ctx_get(c, "ui::indices"); if k < 0 || !CT[k].converted { 0 } else { copy_out(CT[k].ixs[..], out) }
draw_commands_into(c Context, out DrawCommand[:]) int: k := ctx_get(c, "ui::draw_commands"); if k < 0 || !CT[k].converted { 0 } else { copy_out(CT[k].dc[..], out) }
S0 := gfx::fbits(0x0C780258)
S1 := gfx::fbits(0x3F801C6E)
S2 := gfx::fbits(0xBC46B2E5)
S3 := gfx::fbits(0xBE0D6486)
S4 := gfx::fbits(0xBCDB0412)
S5 := gfx::fbits(0x3CAA6A57)
S6 := gfx::fbits(0xBB473A13)
S7 := gfx::fbits(0x3910F359)
C0 := gfx::fbits(0x3F7FFD61)
C1 := gfx::fbits(0x3AA47B71)
C2 := gfx::fbits(0xBF01A908)
C3 := gfx::fbits(0x3C540BB7)
C4 := gfx::fbits(0x3CEAD9F6)
C5 := gfx::fbits(0x3BF19642)
C6 := gfx::fbits(0xBB7C6287)
C7 := gfx::fbits(0x39F77236)
C8 := gfx::fbits(0xB79D821B)
NKPI := gfx::fbits(0x40490FDB)
EPS6 := gfx::fbits(0x358637BD)
INV255 := gfx::fbits(0x3B808081)
var SFW byte[>..] = []
kf(ok bool, n const byte[:]) bool: ok || misuse(str(SFW, ": the style's ", n, " is not a value it can have"))
ki(k i32, n const byte[:]) bool: kf(k >= 0 && k <= 2, n)
ci(i StyleItem) StyleItem: if i.kind == 0 { StyleItem{kind: 0, color: i.color} } else if i.kind == 1 { StyleItem{kind: 1, img: i.img} } else { StyleItem{kind: i.kind, img: i.img, l: i.l, t: i.t, r: i.r, b: i.b} }
style(c Context) Style: k := ctx_get(c, "ui::style"); if k < 0 { Style{..} } else { CT[k].st }
style_ok(s Style&, fw const byte[:]) bool: SFW.clear(); SFW.append(fw); ck_Style(s)
style_in(u UC&, s const Style&): t ~= s; cn_Style(t); u.st = t
set_style(c Context, s const Style&):
	k := ctx_get(c, "ui::set_style"); if k < 0: return
	t ~= s; if style_ok(t, "ui::set_style") { style_in(CT[k], t) }
push_style(c Context, s const Style&) bool:
	k := ctx_get(c, "ui::push_style"); if k < 0: return false
	t ~= s; if !style_ok(t, "ui::push_style"): return false
	CT[k].styles.push(CT[k].st); style_in(CT[k], t); true
pop_style(c Context) bool:
	k := ctx_get(c, "ui::pop_style"); if k < 0: return false
	if CT[k].styles.len == 0: return misuse("ui::pop_style with no style pushed")
	CT[k].st = CT[k].styles.pop(); true
style_default(c Context): k := ctx_get(c, "ui::style_default"); if k >= 0 { style_from(CT[k].st, DEFAULT_COLORS[..]) }
style_from_table(c Context, table const Color[:]):
	k := ctx_get(c, "ui::style_from_table"); if k < 0: return
	if table.len != 32: misuse(str("ui::style_from_table: a table of ", table.len, " colors, where it has one per COLOR_* (32)")); return
	style_from(CT[k].st, table)
default_color_table_into(out Color[:]) int: copy_out(DEFAULT_COLORS[..], out)
style_get_color_by_name_into(color int, out byte[:]) int:
	if !enum_ok(color, 32, "ui::style_get_color_by_name", "COLOR_*"): return 0
	copy_out(COLOR_NAMES[color][..], out)
style_font_ok(h Font, fw const byte[:]) bool:
	k := font_get(h, fw); if k < 0: return false
	if !ATL[gfx::ix(FNT[k].atl)].baked: return misuse(str(fw, ": the font's atlas is not baked yet"))
	true
style_set_font(c Context, font Font):
	k := ctx_get(c, "ui::style_set_font"); if k < 0 || !style_font_ok(font, "ui::style_set_font"): return
	let u .= CT[k]; u.font = font.id; u.fstk.clear()
	if u.current >= 0: reset_min_row_height(u)
	if !u.owns: u.atlas = FNT[font_get(font, "ui::style_set_font")].atl
style_push_font(c Context, font Font) bool:
	k := ctx_get(c, "ui::style_push_font"); if k < 0 || !style_font_ok(font, "ui::style_push_font"): return false
	if CT[k].fstk.len >= 8: return misuse("ui::style_push_font: 8 fonts pushed and not popped")
	CT[k].fstk.push(CT[k].font); CT[k].font = font.id; true
style_pop_font(c Context) bool:
	k := ctx_get(c, "ui::style_pop_font"); if k < 0: return false
	if CT[k].fstk.len < 1: return misuse("ui::style_pop_font with no font pushed")
	CT[k].font = CT[k].fstk.pop(); true
cursor_ok(g Cursor, fw const byte[:]) bool: fin(g.size.x) && fin(g.size.y) && fin(g.offset.x) && fin(g.offset.y) || misuse(str(fw, ": a cursor ", pg(g.size.x as real), " x ", pg(g.size.y as real), " with its hot spot at ", pg(g.offset.x as real), ", ", pg(g.offset.y as real)))
style_load_cursor(c Context, cursor int, image Cursor):
	k := ctx_get(c, "ui::style_load_cursor"); if k < 0: return
	if !enum_ok(cursor, 7, "ui::style_load_cursor", "CURSOR_*") || !cursor_ok(image, "ui::style_load_cursor"): return
	CT[k].cursors[cursor] = image; CT[k].curs[cursor] = cursor
style_load_all_cursors(c Context, cursors const Cursor[:]):
	k := ctx_get(c, "ui::style_load_all_cursors"); if k < 0: return
	if cursors.len != 7: misuse(str("ui::style_load_all_cursors: ", cursors.len, " cursors, where there is one per CURSOR_* (7)")); return
	for g cursors: if !cursor_ok(g, "ui::style_load_all_cursors") { return }
	for i 7: CT[k].cursors[i] = cursors[i]; CT[k].curs[i] = i
	CT[k].cvis = true
style_set_cursor(c Context, cursor int) bool:
	k := ctx_get(c, "ui::style_set_cursor"); if k < 0 || !enum_ok(cursor, 7, "ui::style_set_cursor", "CURSOR_*"): return false
	if CT[k].curs[cursor] < 0: return false
	CT[k].cact = CT[k].curs[cursor]; true
style_show_cursor(c Context): k := ctx_get(c, "ui::style_show_cursor"); if k >= 0 { CT[k].cvis = true }
style_hide_cursor(c Context): k := ctx_get(c, "ui::style_hide_cursor"); if k >= 0 { CT[k].cvis = false }
c255(v int) byte: if v < 0 { 0 } else if v > 255 { 255 } else { v as byte }
f255(x f32) byte: (sat(x) * 255.0) as! u8
rgb(r int, g int, b int) Color: Color{c255(iclamp(r)), c255(iclamp(g)), c255(iclamp(b)), 255}
rgba(r int, g int, b int, a int) Color: Color{c255(iclamp(r)), c255(iclamp(g)), c255(iclamp(b)), c255(iclamp(a))}
rgba_u32(v u32) Color: Color{(v & 0xFF) as byte, ((v >> 8) & 0xFF) as byte, ((v >> 16) & 0xFF) as byte, ((v >> 24) & 0xFF) as byte}
rgb_f(r f32, g f32, b f32) Color: Color{f255(r), f255(g), f255(b), 255}
rgba_f(r f32, g f32, b f32, a f32) Color: Color{f255(r), f255(g), f255(b), f255(a)}
rgb_cf(c Colorf) Color: rgb_f(c.r, c.g, c.b)
rgba_cf(c Colorf) Color: rgba_f(c.r, c.g, c.b, c.a)
hexv(p const byte[:], at int) int:
	i ~= 0
	for k 2: ch := p[at + k] as int; i = (i << 4) + (if ch >= 'a' && ch <= 'f' { ch - 'a' + 10 } else if ch >= 'A' && ch <= 'F' { ch - 'A' + 10 } else { ch - '0' })
	i
hex_ok(t const byte[:], digits int, fw const byte[:]) int:
	skip := if t.len > 0 && t[0] == '#' { 1 } else { 0 }; ok ~= t.len - skip == digits
	for i skip..t.len: if ok { ch := t[i]; ok = ch >= '0' && ch <= '9' || ch >= 'a' && ch <= 'f' || ch >= 'A' && ch <= 'F' }
	if !ok: misuse(str(fw, ": \"", t[..min(t.len, 64)], "\" is not ", digits, " hexadecimal digits, after an optional #")); return -1
	skip
rgb_hex(text const byte[:]) Color: s := hex_ok(text, 6, "ui::rgb_hex"); if s < 0 { Color{0, 0, 0, 255} } else { Color{hexv(text, s) as byte, hexv(text, s + 2) as byte, hexv(text, s + 4) as byte, 255} }
rgba_hex(text const byte[:]) Color: s := hex_ok(text, 8, "ui::rgba_hex"); if s < 0 { Color{0, 0, 0, 255} } else { Color{hexv(text, s) as byte, hexv(text, s + 2) as byte, hexv(text, s + 4) as byte, hexv(text, s + 6) as byte} }
rgb_factor(c Color, factor f32) Color:
	if !(factor >= 0.0 && factor <= 1.0): misuse(str("ui::rgb_factor: a factor of ", pg(factor as real), " (0 to 1)")); return c
	if factor == 1.0: return c
	Color{(c.r as f32 * factor) as! u8, (c.g as f32 * factor) as! u8, (c.b as f32 * factor) as! u8, c.a}
hsva_colorf(h0 f32, s f32, v f32, a f32) Colorf:
	if s <= 0.0: return Colorf{v, v, v, a}
	h := h0 / (60.0 / 360.0); i := h as! i32; f := h - i as f32
	p := v * (1.0 - s); q := v * (1.0 - s * f); t := v * (1.0 - s * (1.0 - f))
	if i == 1: return Colorf{q, v, p, a}
	if i == 2: return Colorf{p, v, t, a}
	if i == 3: return Colorf{p, q, v, a}
	if i == 4: return Colorf{t, p, v, a}
	if i == 5: return Colorf{v, p, q, a}
	Colorf{v, t, p, a}
hsva_f(h f32, s f32, v f32, a f32) Color: c := hsva_colorf(h, s, v, a); rgba_f(c.r, c.g, c.b, c.a)
hsv_f(h f32, s f32, v f32) Color: hsva_f(h, s, v, 1.0)
h255(x int) f32: c255(iclamp(x)) as f32 / 255.0
hsva(h int, s int, v int, a int) Color: hsva_f(h255(h), h255(s), h255(v), h255(a))
hsv(h int, s int, v int) Color: hsva(h, s, v, 255)
colorf_hsva_f(c0 Colorf) float4:
	c ~= c0; k ~= 0.0 as f32
	if c.g < c.b: t := c.g; c.g = c.b; c.b = t; k = -1.0
	if c.r < c.g: t := c.r; c.r = c.g; c.g = t; k = -2.0 / 6.0 - k
	ch := c.r - (if c.g < c.b { c.g } else { c.b }); EPS := gfx::fbits(0x1E3CE508)
	hh := k + (c.g - c.b) / (6.0 * ch + EPS)
	float4{if hh < 0.0 { -hh } else { hh }, ch / (c.r + EPS), c.r, c.a}
color_cf(c Color) Colorf: Colorf{c.r as f32 * INV255, c.g as f32 * INV255, c.b as f32 * INV255, c.a as f32 * INV255}
color_u32(c Color) u32: (c.r as u32) | ((c.g as u32) << 8) | ((c.b as u32) << 16) | ((c.a as u32) << 24)
hx(i int) byte: (if i <= 9 { '0' as int + i } else { 'A' as int - 10 + i }) as byte
color_hex_rgba_into(c Color, out byte[:]) int: copy_out([hx((c.r >> 4) as int), hx((c.r & 15) as int), hx((c.g >> 4) as int), hx((c.g & 15) as int), hx((c.b >> 4) as int), hx((c.b & 15) as int), hx((c.a >> 4) as int), hx((c.a & 15) as int)], out)
color_hex_rgb_into(c Color, out byte[:]) int: copy_out([hx((c.r >> 4) as int), hx((c.r & 15) as int), hx((c.g >> 4) as int), hx((c.g & 15) as int), hx((c.b >> 4) as int), hx((c.b & 15) as int)], out)
