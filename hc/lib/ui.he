struct CSlot { ty int, color Color, hl Color, mn f32, mx f32, range f32, count int, last float2, index int, markers bool }
struct Chart { slot int, x f32, y f32, w f32, h f32, slots CSlot[4] }
fabs(a f32) f32: if a < 0.0 { -a } else { a }
chart_slot(u UC&, ty int, col Color, hl Color, n int, a f32, b f32):
	let ch .= u.ps[lpi(u)].chart
	if ch.slot >= 4: return
	st := u.st.chart; let s .= ch.slots[ch.slot]; ch.slot += 1
	s.ty = ty; s.count = n; s.color = rgb_factor(col, st.color_factor); s.hl = hl; s.mn = mn(a, b); s.mx = mx(a, b); s.range = s.mx - s.mn; s.markers = st.show_markers
chart_start(u UC&, ty int, col Color, hl Color, n int, a f32, b f32) bool:
	bd ~= Rect{0.0, 0.0, 0.0, 0.0}; ok := widget(u, bd) != 0; u.ps[lpi(u)].chart = Chart{..}
	if !ok: return false
	st := u.st.chart; let ch .= u.ps[lpi(u)].chart
	ch.x = bd.x + st.padding.x; ch.y = bd.y + st.padding.y; ch.w = bd.w - 2.0 * st.padding.x; ch.h = bd.h - 2.0 * st.padding.y; ch.w = mx(ch.w, 2.0 * st.padding.x); ch.h = mx(ch.h, 2.0 * st.padding.y)
	chart_slot(u, ty, col, hl, n, a, b); bg := st.background; bi := u.current
	if bg.kind == 1: draw_image_b(u, bi, bd, bg.img, rgb_factor(WHITE, st.color_factor))
	else if bg.kind == 2: draw_nine_slice_b(u, bi, bd, NineSlice{bg.img, bg.l, bg.t, bg.r, bg.b}, rgb_factor(WHITE, st.color_factor))
	else: fill_rect_b(u, bi, bd, st.rounding, rgb_factor(st.border_color, st.color_factor)); fill_rect_b(u, bi, padr(bd, float2{st.border, st.border}), st.rounding, rgb_factor(bg.color, st.color_factor))
	true
chart_line(u UC&, g Chart&, v f32, sl int) int:
	hin := !u.ws[u.current].wdis; let i .= u.inp; rom := u.ps[lpi(u)].flags & WIN_ROM != 0; let s .= g.slots[sl]; bi := u.current
	step := g.w / s.count as f32; ra := (v - s.mn) / (s.mx - s.mn); r ~= 0
	if s.index == 0:
		s.last.x = g.x; s.last.y = (g.y + g.h) - ra * g.h; b := Rect{s.last.x - 2.0, s.last.y - 2.0, 4.0, 4.0}; col ~= s.color
		if !rom && hin && inbox(i.pos.x, i.pos.y, Rect{s.last.x - 3.0, s.last.y - 3.0, 6.0, 6.0}):
			r = if i_hover(i, b) { 1 } else { 0 }; r |= if i.mb[0].down && i.mb[0].clicked != 0 { 2 } else { 0 }; col = s.hl
		if s.markers: fill_rect_b(u, bi, b, 0.0, col)
		s.index += 1; return r
	col ~= s.color; cx := g.x + step * s.index as f32; cy := (g.y + g.h) - ra * g.h
	stroke_line_b(u, bi, s.last.x, s.last.y, cx, cy, 1.0, col)
	if !rom && hin && i_hover(i, Rect{cx - 3.0, cy - 3.0, 6.0, 6.0}): r = 1 | (if !i.mb[0].down && i.mb[0].clicked != 0 { 2 } else { 0 }); col = s.hl
	if s.markers: fill_rect_b(u, bi, Rect{cx - 2.0, cy - 2.0, 4.0, 4.0}, 0.0, col)
	s.last.x = cx; s.last.y = cy; s.index += 1; r
chart_col(u UC&, g Chart&, v f32, sl int) int:
	let s .= g.slots[sl]
	if s.index >= s.count: return 0
	hin := !u.ws[u.current].wdis; let i .= u.inp; rom := u.ps[lpi(u)].flags & WIN_ROM != 0; it ~= Rect{0.0, 0.0, 0.0, 0.0}; r ~= 0
	if s.count != 0: it.w = (g.w - (s.count - 1) as f32) / s.count as f32
	col ~= s.color; it.h = g.h * fabs(v / s.range)
	if v >= 0.0: it.y = (g.y + g.h) - g.h * ((v + fabs(s.mn)) / fabs(s.range))
	else: it.y = g.y + g.h * fabs((v - s.mx) / s.range) - it.h
	it.x = g.x + s.index as f32 * it.w; it.x = it.x + s.index as f32
	if !rom && hin && inbox(i.pos.x, i.pos.y, it): r = 1 | (if !i.mb[0].down && i.mb[0].clicked != 0 { 2 } else { 0 }); col = s.hl
	fill_rect_b(u, u.current, it, 0.0, col); s.index += 1; r
chart_put(u UC&, v f32, sl int) int:
	if sl >= 4 || sl >= u.ps[lpi(u)].chart.slot: return 0
	let g .= u.ps[lpi(u)].chart
	if g.slots[sl].ty == 0 { chart_line(u, g, v, sl) } else if g.slots[sl].ty == 1 { chart_col(u, g, v, sl) } else { 0 }
chart_ok(ty int, n int, a f32, b f32, fw const byte[:]) bool:
	if !enum_ok(ty, 2, fw, "CHART_LINES, CHART_COLUMN"): return false
	if n < 0 || n > 2147483647: return misuse(str(fw, ": ", n, " values"))
	fin(a) && fin(b) && a != b || misuse(str(fw, ": values from ", pg(a as real), " to ", pg(b as real), ", where the range must not be empty"))
chart_begin_colored(c Context, chart_type int, color Color, active Color, count int, min f32, max f32) bool:
	fw := "ui::chart_begin_colored"; k := wid_ctx(c, fw); k >= 0 && chart_ok(chart_type, count, min, max, fw) && chart_start(CT[k], chart_type, color, active, count, min, max) && push_scope(CT[k], SC_CHART, true, fw)
chart_begin(c Context, chart_type int, count int, min f32, max f32) bool:
	fw := "ui::chart_begin"; k := wid_ctx(c, fw); k >= 0 && chart_ok(chart_type, count, min, max, fw) && chart_start(CT[k], chart_type, CT[k].st.chart.color, CT[k].st.chart.selected_color, count, min, max) && push_scope(CT[k], SC_CHART, true, fw)
slot_ok(u UC&, fw const byte[:]) bool: in_panel(u, fw) && expect_scope(u, SC_CHART, fw) && (u.ps[lpi(u)].chart.slot < 4 || misuse(str(fw, ": a chart has at most 4 slots")))
chart_add_slot(c Context, chart_type int, count int, min f32, max f32):
	fw := "ui::chart_add_slot"; k := ctx_get(c, fw)
	if k >= 0 && slot_ok(CT[k], fw) && chart_ok(chart_type, count, min, max, fw): chart_slot(CT[k], chart_type, CT[k].st.chart.color, CT[k].st.chart.selected_color, count, min, max)
chart_add_slot_colored(c Context, chart_type int, color Color, active Color, count int, min f32, max f32):
	fw := "ui::chart_add_slot_colored"; k := ctx_get(c, fw)
	if k >= 0 && slot_ok(CT[k], fw) && chart_ok(chart_type, count, min, max, fw): chart_slot(CT[k], chart_type, color, active, count, min, max)
chart_push_slot(c Context, value f32, slot int) int:
	fw := "ui::chart_push_slot"; k := pan_ctx(c, fw); if k < 0 || !expect_scope(CT[k], SC_CHART, fw) || !float_ok(value, fw, "a value of"): return 0
	n := CT[k].ps[lpi(CT[k])].chart.slot
	if slot < 0 || slot >= n: misuse(str(fw, ": slot ", slot, " of a chart with ", n)); return 0
	chart_put(CT[k], value, slot)
chart_push(c Context, value f32) int: chart_push_slot(c, value, 0)
chart_end(c Context):
	k := pan_ctx(c, "ui::chart_end"); if k < 0 || !expect_scope(CT[k], SC_CHART, "ui::chart_end"): return
	CT[k].ps[lpi(CT[k])].chart = Chart{..}; pop_scope(CT[k])
plot(c Context, chart_type int, values const f32[:]):
	k := wid_ctx(c, "ui::plot"); if k < 0 || !enum_ok(chart_type, 2, "ui::plot", "CHART_LINES, CHART_COLUMN") || values.len == 0: return
	if values.len > 2147483647: misuse(str("ui::plot: ", values.len, " values")); return
	lo ~= values[0]; hi ~= values[0]
	for v values:
		if !float_ok(v, "ui::plot", "a value of"): return
		lo = if v < lo { v } else { lo }; hi = if v > hi { v } else { hi }
	if hi == lo: hi = lo + 1.0
	let u .= CT[k]
	if chart_start(u, chart_type, u.st.chart.color, u.st.chart.selected_color, values.len, lo, hi):
		for v values: chart_put(u, v, 0)
		u.ps[lpi(u)].chart = Chart{..}
new_table(u UC&) int:
	t ~= 0
	if u.tfree.len > 0: t = u.tfree.pop(); u.ts[t] = Tbl{..}
	else: u.ts.push(Tbl{..}); t = u.ts.len - 1
	u.ts[t].keys.resize(69, 0); u.ts[t].values.resize(69, 0); t
find_value(u UC&, w int, h u32) Ptr:
	it ~= u.ws[w].tables
	while it >= 0:
		for i u.ts[it].size: if u.ts[it].keys[i] == h { u.ts[it].seq = u.ws[w].seq; return Ptr{2, it, i as int} }
		it = u.ts[it].next
	Ptr{0, 0, 0}
add_value(u UC&, w int, h u32, v u32) Ptr:
	if u.ws[w].tables < 0 || u.ts[u.ws[w].tables].size >= 69:
		t := new_table(u); f := u.ws[w].tables; u.ts[t].next = f; u.ts[t].prev = -1; u.ts[t].size = 0
		if f >= 0 { u.ts[f].prev = t; u.ws[w].tcount += 1 } else { u.ws[w].tcount = 1 }
		u.ws[w].tables = t
	b := u.ws[w].tables; n := u.ts[b].size as int; u.ts[b].seq = u.ws[w].seq; u.ts[b].keys[n] = h; u.ts[b].values[n] = v; u.ts[b].size += 1; Ptr{2, b, n}
grp_offsets(u UC&, id const byte[:], ox Ptr&, oy Ptr&, addy bool) bool:
	w := u.current; h u32 := murmur(id, PAN_GROUP); ox = find_value(u, w, h)
	if ox.k == 0: ox = add_value(u, w, h, 0); oy = add_value(u, w, h + 1, 0); return true
	oy = find_value(u, w, h + 1)
	if oy.k != 0: return true
	if !addy: return false
	oy = add_value(u, w, h + 1, 0); pset(u, ox, 0); true
grp_begin(u UC&, ox Ptr, oy Ptr, title const byte[:], fl0 u32) u32:
	w := u.current; b := alloc_space(u); fl ~= fl0
	if !risect(u.ps[u.ws[w].lay].clip, b) && fl & 2 == 0: return 0
	if u.ws[w].flags & WIN_ROM != 0: fl |= WIN_ROM
	t := new_window(u); u.ws[t].bounds = b; u.ws[t].flags = fl; u.ws[t].sx = pget(u, ox); u.ws[t].sy = pget(u, oy); u.ws[t].buf = u.ws[w].buf; u.ws[t].lay = new_panel(u); u.current = t
	panel_begin(u, if fl & 64 != 0 { title } else { "" }, fl & 64 != 0, PAN_GROUP)
	g := u.ws[t].lay; u.ws[w].buf = u.ws[t].buf; u.ws[w].buf.clip = u.ps[g].clip; u.ps[g].ox = ox; u.ps[g].oy = oy; u.ps[g].parent = u.ws[w].lay; u.ws[w].lay = g; u.current = w; u.wfree.push(t)
	f := u.ps[g].flags
	if f & (WIN_CLOSED | WIN_MINIMIZED) == 0: return 1
	grp_end(u); if f & WIN_CLOSED != 0 { WIN_CLOSED } else { WIN_MINIMIZED }
grp_end(u UC&):
	w := u.current; g := u.ws[w].lay; par := u.ps[g].parent; pp := pan_padding(u.st, PAN_GROUP); gl := u.ps[g]
	pb ~= Rect{gl.bounds.x - pp.x, gl.bounds.y - (gl.header_height + gl.menu.h), gl.bounds.w + 2.0 * pp.x, gl.bounds.h + gl.header_height + gl.menu.h}
	if gl.flags & 1 != 0: pb.x -= gl.border; pb.y -= gl.border; pb.w += 2.0 * gl.border; pb.h += 2.0 * gl.border
	if gl.flags & 32 == 0: pb.w += u.st.window.scrollbar_size.x; pb.h += u.st.window.scrollbar_size.y
	t := new_window(u); u.ws[t].bounds = pb; u.ws[t].sx = pget(u, gl.ox); u.ws[t].sy = pget(u, gl.oy); u.ws[t].flags = gl.flags; u.ws[t].buf = u.ws[w].buf; u.ws[t].lay = g; u.ws[t].parent = w; u.current = t
	push_scissor_b(u, t, unify(u.ps[par].clip, pb.x, pb.y, pb.x + pb.w, pb.y + pb.h + pp.x)); end_nk(u)
	u.ws[w].buf = u.ws[t].buf; push_scissor_b(u, w, u.ps[par].clip); u.current = w; u.ws[w].lay = par; u.wfree.push(t)
grp_titled(u UC&, id const byte[:], title const byte[:], fl u32) u32:
	ox ~= Ptr{0, 0, 0}; oy ~= Ptr{0, 0, 0}; grp_offsets(u, id, ox, oy, true); grp_begin(u, ox, oy, title, fl)
group_begin(c Context, title const byte[:], flags int) bool:
	fw := "ui::group_begin"; k := pan_ctx(c, fw); if k < 0 || !flags_ok(flags, fw): return false
	t := cstr(title); grp_titled(CT[k], t, t, flags as u32) == 1 && push_scope(CT[k], SC_GROUP, true, fw)
group_begin_titled(c Context, id const byte[:], title const byte[:], flags int) bool:
	fw := "ui::group_begin_titled"; k := pan_ctx(c, fw); if k < 0 || !flags_ok(flags, fw): return false
