value_color_byte(c Context, prefix const byte[:], color Color): value_w(c, "ui::value_color_byte", prefix, str("(", color.r, ", ", color.g, ", ", color.b, ", ", color.a, ")"))
value_color_float(c Context, prefix const byte[:], color Color): s := 1.0 / 255.0; value_w(c, "ui::value_color_float", prefix, str("(", fixed(color.r as real * s, 2), ", ", fixed(color.g as real * s, 2), ", ", fixed(color.b as real * s, 2), ", ", fixed(color.a as real * s, 2), ")"))
value_color_hex(c Context, prefix const byte[:], color Color): h byte[8] ~= [0; 8]; color_hex_rgba_into(color, h[..]); value_w(c, "ui::value_color_hex", prefix, h[..])
tri_dir(r0 Rect, px f32, py f32, d int) float2[3]:
	r ~= r0; r.w = mx(2.0 * px, r.w); r.h = mx(2.0 * py, r.h); r.w = r.w - 2.0 * px; r.h = r.h - 2.0 * py; r.x = r.x + px; r.y = r.y + py; wh := r.w / 2.0; hh := r.h / 2.0
	if d == 0: return [float2{r.x + wh, r.y}, float2{r.x + r.w, r.y + r.h}, float2{r.x, r.y + r.h}]
	if d == 1: return [float2{r.x, r.y}, float2{r.x + r.w, r.y + hh}, float2{r.x, r.y + r.h}]
	if d == 2: return [float2{r.x, r.y}, float2{r.x + r.w, r.y}, float2{r.x + wh, r.y + r.h}]
	[float2{r.x, r.y + hh}, float2{r.x + r.w, r.y}, float2{r.x + r.w, r.y + r.h}]
triangle_from_direction_into(r Rect, pad_x f32, pad_y f32, direction int, out float2[:]):
	if out.len != 3: misuse(str("ui::triangle_from_direction: ", out.len, " points out, where a triangle has 3")); return
	if !enum_ok(direction, 4, "ui::triangle_from_direction", "UP, RIGHT, DOWN, LEFT"): return
	p := tri_dir(r, pad_x, pad_y, direction); for i 3: out[i] = p[i]
murmur_hash(key const byte[:], seed u32) u32: murmur(key[..tlen(key, "ui::murmur_hash")], seed)
draw_symbol(u UC&, bi int, ty int, c Rect, bg Color, fg Color, bw0 f32, fid u32):
	bw := if bw0 <= 0.0 { 1.0 as f32 } else { bw0 }
	if ty == 1: px := c.w * 0.2; py := c.h * 0.2; x0 := c.x + px; y0 := c.y + py; x1 := c.x + c.w - px; y1 := c.y + c.h - py; stroke_line_b(u, bi, x0, y0, x1, y1, bw, fg); stroke_line_b(u, bi, x1, y0, x0, y1, bw, fg)
	else if ty == 2 || ty == 11 || ty == 12: widget_text(u, bi, c, if ty == 2 { "_" } else if ty == 11 { "+" } else { "-" }, NOPAD, bg, fg, 18, fid)
	else if ty == 5 || ty == 6: fill_rect_b(u, bi, c, 0.0, fg); if ty == 6 { fill_rect_b(u, bi, shrink(c, bw), 0.0, bg) }
	else if ty == 3 || ty == 4: fill_circle_b(u, bi, c, fg); if ty == 4 { fill_circle_b(u, bi, shrink(c, bw), bg) }
	else if ty >= 7 && ty <= 10: p := tri_dir(c, 0.0, 0.0, if ty == 10 { 1 } else if ty == 9 { 3 } else if ty == 7 { 0 } else { 2 }); fill_triangle_b(u, bi, p[0].x, p[0].y, p[1].x, p[1].y, p[2].x, p[2].y, fg)
	else if ty >= 13 && ty <= 16: p := tri_dir(c, 0.0, 0.0, if ty == 16 { 1 } else if ty == 15 { 3 } else if ty == 13 { 0 } else { 2 }); stroke_triangle_b(u, bi, p[0].x, p[0].y, p[1].x, p[1].y, p[2].x, p[2].y, bw, fg)
	else if ty >= 17 && ty <= 20:
		p := if ty == 18 { [float2{c.x, c.y}, float2{c.x + c.w, c.y + c.h * 0.5}, float2{c.x, c.y + c.h}] } else if ty == 20 { [float2{c.x + c.w, c.y}, float2{c.x, c.y + c.h * 0.5}, float2{c.x + c.w, c.y + c.h}] } else if ty == 17 { [float2{c.x, c.y + c.h}, float2{c.x + c.w * 0.5, c.y}, float2{c.x + c.w, c.y + c.h}] } else { [float2{c.x, c.y}, float2{c.x + c.w * 0.5, c.y + c.h}, float2{c.x + c.w, c.y}] }
		stroke_line_b(u, bi, p[0].x, p[0].y, p[1].x, p[1].y, bw, fg); stroke_line_b(u, bi, p[1].x, p[1].y, p[2].x, p[2].y, bw, fg)
	else if ty == 21: y2 := c.y + c.h * 0.5; y3 := c.y + c.h - bw; x1 := c.x + c.w; stroke_line_b(u, bi, c.x, c.y, x1, c.y, bw, fg); stroke_line_b(u, bi, c.x, y2, x1, y2, bw, fg); stroke_line_b(u, bi, c.x, y3, x1, y3, bw, fg)
st_reset(s u32&): s = if s & WS_MOD != 0 { WS_INACTIVE | WS_MOD } else { WS_INACTIVE }
button_behavior(u UC&, s u32&, r Rect, hin bool, beh i32) bool:
	ret ~= false; st_reset(s)
	if !hin: return false
	let i .= u.inp
	if i_hover(i, r):
		s = WS_HOVER | WS_MOD
		if i_down(i, 0): s = WS_ACTIVED | WS_MOD
		if i_click_in(i, 0, r): ret = if beh != 0 { i_down(i, 0) } else { i_pressed(i, 0) }
	if s & WS_HOVER != 0 && !i_prev_hover(i, r): s |= WS_ENTERED
	else if i_prev_hover(i, r): s |= WS_LEFT
	ret
draw_item(u UC&, bi int, b Rect, it StyleItem, ro f32, bw f32, bc Color, f f32):
	if it.kind == 1: draw_image_b(u, bi, b, it.img, rgb_factor(WHITE, f))
	else if it.kind == 2: draw_nine_slice_b(u, bi, b, NineSlice{it.img, it.l, it.t, it.r, it.b}, rgb_factor(WHITE, f))
	else: fill_rect_b(u, bi, b, ro, rgb_factor(it.color, f)); stroke_rect_b(u, bi, b, ro, bw, rgb_factor(bc, f))
draw_button(u UC&, bi int, b Rect, s u32, st StyleButton&) StyleItem:
	bg := if s & WS_HOVER != 0 { st.hover } else if s & WS_ACTIVED != 0 { st.active } else { st.normal }
	draw_item(u, bi, b, bg, st.rounding, st.border, st.border_color, st.color_factor_background); bg
do_button(u UC&, s u32&, r Rect, st StyleButton&, hin bool, beh i32, c Rect&) bool:
	q := st.padding.x + st.border + st.rounding; p := st.padding.y + st.border + st.rounding
	c = Rect{r.x + q, r.y + p, r.w - 2.0 * q, r.h - 2.0 * p}
	button_behavior(u, s, Rect{r.x - st.touch_padding.x, r.y - st.touch_padding.y, r.w + 2.0 * st.touch_padding.x, r.h + 2.0 * st.touch_padding.y}, hin, beh)
btn_fg(s u32, st StyleButton&) Color: rgb_factor(if s & WS_HOVER != 0 { st.text_hover } else if s & WS_ACTIVED != 0 { st.text_active } else { st.text_normal }, st.color_factor_text)
btn_bg(bg StyleItem, st StyleButton&) Color: if bg.kind == 0 { bg.color } else { st.text_background }
do_button_text(u UC&, s u32&, bi int, b Rect, t const byte[:], a u32, beh i32, st StyleButton&, hin bool) bool:
	c ~= NULL_RECT; ret := do_button(u, s, b, st, hin, beh, c); bg := draw_button(u, bi, b, s, st)
	widget_text(u, bi, c, t, NOPAD, btn_bg(bg, st), btn_fg(s, st), a, u.font); ret
do_button_symbol(u UC&, s u32&, bi int, b Rect, sym int, beh i32, st StyleButton&, hin bool) bool:
	c ~= NULL_RECT; ret := do_button(u, s, b, st, hin, beh, c); bg := draw_button(u, bi, b, s, st)
	draw_symbol(u, bi, sym, c, btn_bg(bg, st), btn_fg(s, st), st.border, u.font); ret
do_button_image(u UC&, s u32&, bi int, b Rect, img Image, beh i32, st StyleButton&, hin bool) bool:
	c ~= NULL_RECT; ret := do_button(u, s, b, st, hin, beh, c); ip := st.image_padding
	c.x += ip.x; c.y += ip.y; c.w -= 2.0 * ip.x; c.h -= 2.0 * ip.y
	draw_button(u, bi, b, s, st); draw_image_b(u, bi, c, img, rgb_factor(WHITE, st.color_factor_background)); ret
do_button_text_symbol(u UC&, s u32&, bi int, b Rect, sym int, t const byte[:], a u32, beh i32, st StyleButton&, hin bool) bool:
	c ~= NULL_RECT; ret := do_button(u, s, b, st, hin, beh, c); fh := fht(u.font)
	tri ~= Rect{0.0, c.y + c.h / 2.0 - fh / 2.0, fh, fh}
	tri.x = if a & 1 != 0 { mx((c.x + c.w) - (2.0 * st.padding.x + tri.w), 0.0) } else { c.x + 2.0 * st.padding.x }
	bg := draw_button(u, bi, b, s, st); fg := btn_fg(s, st)
	draw_symbol(u, bi, sym, tri, st.text_background, fg, st.border, u.font); widget_text(u, bi, c, t, NOPAD, btn_bg(bg, st), fg, 18, u.font); ret
do_button_text_image(u UC&, s u32&, bi int, b Rect, img Image, t const byte[:], a u32, beh i32, st StyleButton&, hin bool) bool:
	c ~= NULL_RECT; ret := do_button(u, s, b, st, hin, beh, c)
	ic ~= Rect{0.0, b.y + st.padding.y, b.h - 2.0 * st.padding.y, b.h - 2.0 * st.padding.y}
	ic.x = if a & 1 != 0 { mx((b.x + b.w) - (2.0 * st.padding.x + ic.w), 0.0) } else { b.x + 2.0 * st.padding.x }
	ip := st.image_padding; ic.x += ip.x; ic.y += ip.y; ic.w -= 2.0 * ip.x; ic.h -= 2.0 * ip.y
	bg := draw_button(u, bi, b, s, st); widget_text(u, bi, c, t, NOPAD, btn_bg(bg, st), btn_fg(s, st), 18, u.font); draw_image_b(u, bi, ic, img, rgb_factor(WHITE, st.color_factor_background)); ret
header_button(u UC&, w int, r Rect, sym int, close bool, hin bool) bool: ws ~= 0 as u32; do_button_symbol(u, ws, w, r, sym, 0, if close { u.st.window.header.close_button } else { u.st.window.header.minimize_button }, hin)
btn_place(c Context, fw const byte[:], b Rect&, hin bool&) int:
	k := wid_ctx(c, fw); if k < 0: return -1
	st := widget(CT[k], b); if st == 0: return -1
	hin = win_in(CT[k], st); k
bstyle(u UC&, g const StyleButton&, fw const byte[:], o StyleButton&) bool:
	t ~= g; SFW.clear(); SFW.append(fw); if !ck_StyleButton(t): return false
	cn_StyleButton(t); o = t; true
button_label(c Context, text const byte[:]) bool: b ~= NULL_RECT; hin ~= false; k := btn_place(c, "ui::button_label", b, hin); k >= 0 && do_button_text(CT[k], CT[k].lws, CT[k].current, b, text[..tlen(text, "ui::button_label")], CT[k].st.button.text_alignment, CT[k].bb, CT[k].st.button, hin)
button_color(c Context, color Color) bool:
	b ~= NULL_RECT; hin ~= false; k := btn_place(c, "ui::button_color", b, hin); if k < 0: return false
	let u .= CT[k]; bt ~= u.st.button; ci := style_item_color(color); bt.normal = ci; bt.hover = ci; bt.active = ci
	cc ~= NULL_RECT; ret := do_button(u, u.lws, b, bt, hin, u.bb, cc); draw_button(u, u.current, b, u.lws, bt); ret
button_symbol(c Context, symbol int) bool: b ~= NULL_RECT; hin ~= false; k := wid_ctx(c, "ui::button_symbol"); k >= 0 && symbol_ok(symbol, "ui::button_symbol") && btn_at(k, b, hin) && do_button_symbol(CT[k], CT[k].lws, CT[k].current, b, symbol, CT[k].bb, CT[k].st.button, hin)
btn_at(k int, b Rect&, hin bool&) bool: st := widget(CT[k], b); hin = win_in(CT[k], st); st != 0
button_image(c Context, img Image) bool: b ~= NULL_RECT; hin ~= false; k := btn_place(c, "ui::button_image", b, hin); k >= 0 && do_button_image(CT[k], CT[k].lws, CT[k].current, b, img, CT[k].bb, CT[k].st.button, hin)
button_symbol_label(c Context, symbol int, text const byte[:], align int) bool: b ~= NULL_RECT; hin ~= false; k := wid_ctx(c, "ui::button_symbol_label"); k >= 0 && symbol_ok(symbol, "ui::button_symbol_label") && btn_at(k, b, hin) && do_button_text_symbol(CT[k], CT[k].lws, CT[k].current, b, symbol, text[..tlen(text, "ui::button_symbol_label")], align as u32, CT[k].bb, CT[k].st.button, hin)
button_image_label(c Context, img Image, text const byte[:], align int) bool: b ~= NULL_RECT; hin ~= false; k := btn_place(c, "ui::button_image_label", b, hin); k >= 0 && do_button_text_image(CT[k], CT[k].lws, CT[k].current, b, img, text[..tlen(text, "ui::button_image_label")], align as u32, CT[k].bb, CT[k].st.button, hin)
button_label_styled(c Context, style const StyleButton&, text const byte[:]) bool: b ~= NULL_RECT; hin ~= false; s ~= StyleButton{..}; k := wid_ctx(c, "ui::button_label_styled"); k >= 0 && bstyle(CT[k], style, "ui::button_label_styled", s) && btn_at(k, b, hin) && do_button_text(CT[k], CT[k].lws, CT[k].current, b, text[..tlen(text, "ui::button_label_styled")], s.text_alignment, CT[k].bb, s, hin)
button_symbol_styled(c Context, style const StyleButton&, symbol int) bool: b ~= NULL_RECT; hin ~= false; s ~= StyleButton{..}; k := wid_ctx(c, "ui::button_symbol_styled"); k >= 0 && symbol_ok(symbol, "ui::button_symbol_styled") && bstyle(CT[k], style, "ui::button_symbol_styled", s) && btn_at(k, b, hin) && do_button_symbol(CT[k], CT[k].lws, CT[k].current, b, symbol, CT[k].bb, s, hin)
button_image_styled(c Context, style const StyleButton&, img Image) bool: b ~= NULL_RECT; hin ~= false; s ~= StyleButton{..}; k := wid_ctx(c, "ui::button_image_styled"); k >= 0 && bstyle(CT[k], style, "ui::button_image_styled", s) && btn_at(k, b, hin) && do_button_image(CT[k], CT[k].lws, CT[k].current, b, img, CT[k].bb, s, hin)
button_symbol_label_styled(c Context, style const StyleButton&, symbol int, text const byte[:], align int) bool: b ~= NULL_RECT; hin ~= false; s ~= StyleButton{..}; k := wid_ctx(c, "ui::button_symbol_label_styled"); k >= 0 && symbol_ok(symbol, "ui::button_symbol_label_styled") && bstyle(CT[k], style, "ui::button_symbol_label_styled", s) && btn_at(k, b, hin) && do_button_text_symbol(CT[k], CT[k].lws, CT[k].current, b, symbol, text[..tlen(text, "ui::button_symbol_label_styled")], align as u32, CT[k].bb, s, hin)
button_image_label_styled(c Context, style const StyleButton&, img Image, text const byte[:], align int) bool: b ~= NULL_RECT; hin ~= false; s ~= StyleButton{..}; k := wid_ctx(c, "ui::button_image_label_styled"); k >= 0 && bstyle(CT[k], style, "ui::button_image_label_styled", s) && btn_at(k, b, hin) && do_button_text_image(CT[k], CT[k].lws, CT[k].current, b, img, text[..tlen(text, "ui::button_image_label_styled")], align as u32, CT[k].bb, s, hin)
beh_ok(b int, fw const byte[:]) bool: enum_ok(b, 2, fw, "BUTTON_DEFAULT, BUTTON_REPEATER")
button_set_behavior(c Context, behavior int): k := ctx_get(c, "ui::button_set_behavior"); if k >= 0 && beh_ok(behavior, "ui::button_set_behavior") { CT[k].bb = behavior as i32 }
button_push_behavior(c Context, behavior int) bool:
	k := ctx_get(c, "ui::button_push_behavior"); if k < 0 || !beh_ok(behavior, "ui::button_push_behavior"): return false
	if CT[k].bbstk.len >= 8: return misuse("ui::button_push_behavior: 8 pushed and not popped")
	CT[k].bbstk.push(CT[k].bb); CT[k].bb = behavior as i32; true
button_pop_behavior(c Context) bool:
	k := ctx_get(c, "ui::button_pop_behavior"); if k < 0: return false
	if CT[k].bbstk.len < 1: return misuse("ui::button_pop_behavior with none pushed")
	CT[k].bb = CT[k].bbstk.pop(); true
clampf(lo f32, v f32, hi f32) f32: mx(mn(v, hi), lo)
sb_behavior(u UC&, s u32&, hin bool, hs bool, sc Rect, cur Rect, e0 Rect, e1 Rect, off0 f32, tgt f32, step f32, vert bool) f32:
	ws ~= 0 as u32; st_reset(s); off ~= off0
	if !hin: return off
	let i .= u.inp; lmd := i.mb[0].down; lmc := i.mb[0].clicked; inc := i_click_down_in(i, 0, cur, true)
	if i_hover(i, sc): s = WS_HOVER | WS_MOD
	sd := if vert { i.sd.y } else { i.sd.x }
	if lmd && inc && lmc == 0:
		s = WS_ACTIVED | WS_MOD
		if vert: off = clampf(0.0, off + (i.delta.y / sc.h) * tgt, tgt - sc.h); i.mb[0].pos.y = sc.y + (off / tgt) * sc.h + cur.h / 2.0
		else: off = clampf(0.0, off + (i.delta.x / sc.w) * tgt, tgt - sc.w); i.mb[0].pos.x = sc.x + (off / tgt) * sc.w + cur.w / 2.0
	else if i_key_pressed(i, 29) && vert && hs || button_behavior(u, ws, e0, true, 0): off = mx(0.0, off - (if vert { sc.h } else { sc.w }))
	else if i_key_pressed(i, 28) && vert && hs || button_behavior(u, ws, e1, true, 0): off = if vert { mn(off + sc.h, tgt - sc.h) } else { mn(off + sc.w, tgt - sc.w) }
	else if hs:
		if sd < 0.0 || sd > 0.0: off = off + step * -sd; off = clampf(0.0, off, if vert { tgt - sc.h } else { tgt - sc.w })
		else if i_key_pressed(i, 26): if vert { off = 0.0 }
		else if i_key_pressed(i, 27): if vert { off = tgt - sc.h }
	if s & WS_HOVER != 0 && !i_prev_hover(i, sc): s |= WS_ENTERED
	else if i_prev_hover(i, sc): s |= WS_LEFT
	off
sb_item(u UC&, bi int, b Rect, it StyleItem, ro f32, bw f32, bc Color):
	if it.kind == 1: draw_image_b(u, bi, b, it.img, WHITE)
	else if it.kind == 2: draw_nine_slice_b(u, bi, b, NineSlice{it.img, it.l, it.t, it.r, it.b}, WHITE)
	else: fill_rect_b(u, bi, b, ro, it.color); stroke_rect_b(u, bi, b, ro, bw, bc)
draw_scrollbar(u UC&, bi int, s u32, st StyleScrollbar&, b Rect, c Rect):
	act := s & WS_ACTIVED != 0; hov := s & WS_HOVER != 0
	sb_item(u, bi, b, if act { st.active } else if hov { st.hover } else { st.normal }, st.rounding, st.border, st.border_color)
	sb_item(u, bi, c, if act { st.cursor_active } else if hov { st.cursor_hover } else { st.cursor_normal }, st.rounding_cursor, st.border_cursor, st.cursor_border_color)
do_scrollbar(u UC&, s u32&, bi int, sc0 Rect, hs bool, off0 f32, tgt f32, step f32, binc f32, st StyleScrollbar&, hin bool, vert bool) f32:
	sc ~= sc0; off ~= off0
	if vert: sc.w = mx(sc.w, 1.0); sc.h = mx(sc.h, 0.0); if tgt <= sc.h { return 0.0 }
	else: sc.h = mx(sc.h, 1.0); sc.w = mx(sc.w, 2.0 * sc.h); if tgt <= sc.w { return 0.0 }
	ss ~= 0.0 as f32
	if st.show_buttons:
		ws ~= 0 as u32; ss = mn(step, binc)
		if vert:
			bt ~= Rect{sc.x, sc.y, sc.w, sc.w}; sh := mx(sc.h - 2.0 * bt.h, 0.0)
			if do_button_symbol(u, ws, bi, bt, st.dec_symbol as int, 1, st.dec_button, hin): off = off - ss
			bt.y = sc.y + sc.h - bt.h
			if do_button_symbol(u, ws, bi, bt, st.inc_symbol as int, 1, st.inc_button, hin): off = off + ss
			sc.y = sc.y + bt.h; sc.h = sh
		else:
			bt ~= Rect{sc.x, sc.y, sc.h, sc.h}; sw := sc.w - 2.0 * bt.w
			if do_button_symbol(u, ws, bi, bt, st.dec_symbol as int, 1, st.dec_button, hin): off = off - ss
			bt.x = sc.x + sc.w - bt.w
			if do_button_symbol(u, ws, bi, bt, st.inc_symbol as int, 1, st.inc_button, hin): off = off + ss
			sc.x = sc.x + bt.w; sc.w = sw
	cur ~= Rect{0.0, 0.0, 0.0, 0.0}; e0 ~= cur; e1 ~= cur; so ~= 0.0 as f32
	if vert:
		ss = mn(step, sc.h); so = clampf(0.0, off, tgt - sc.h); ra := sc.h / tgt; of := so / tgt
		cur.h = mx(ra * sc.h - (2.0 * st.border + 2.0 * st.padding.y), 0.0); cur.y = sc.y + of * sc.h + st.border + st.padding.y; cur.w = sc.w - (2.0 * st.border + 2.0 * st.padding.x); cur.x = sc.x + st.border + st.padding.x
		e0 = Rect{sc.x, sc.y, sc.w, mx(cur.y - sc.y, 0.0)}; e1 = Rect{sc.x, cur.y + cur.h, sc.w, mx((sc.y + sc.h) - (cur.y + cur.h), 0.0)}
		so = sb_behavior(u, s, hin, hs, sc, cur, e0, e1, so, tgt, ss, true); cur.y = sc.y + (so / tgt) * sc.h + st.border_cursor + st.padding.y
	else:
		ss = mn(step, sc.w); so = clampf(0.0, off, tgt - sc.w); ra := sc.w / tgt; of := so / tgt
		cur.w = ra * sc.w - (2.0 * st.border + 2.0 * st.padding.x); cur.x = sc.x + of * sc.w + st.border + st.padding.x; cur.h = sc.h - (2.0 * st.border + 2.0 * st.padding.y); cur.y = sc.y + st.border + st.padding.y
		e0 = Rect{sc.x, sc.y, cur.x - sc.x, sc.h}; e1 = Rect{cur.x + cur.w, sc.y, (sc.x + sc.w) - (cur.x + cur.w), sc.h}
		so = sb_behavior(u, s, hin, hs, sc, cur, e0, e1, so, tgt, ss, false); cur.x = sc.x + (so / tgt) * sc.w
	draw_scrollbar(u, bi, s, st, sc, cur); so
panel_scrollbars(u UC&, w int, pi int, hin bool, sbs float2, pp float2):
	let l .= u.ps[pi]; hs ~= false
	if is_sub(l.ty):
		rw ~= w; rp ~= pi
		while u.ps[rp].parent >= 0: rp = u.ps[rp].parent
		while u.ws[rw].parent >= 0: rw = u.ws[rw].parent
		if rw == u.active && l.has_scrolling != 0 && hin && i_hover(u.inp, l.bounds) && risect(l.bounds, u.ps[rp].clip):
			q ~= pi
			while u.ps[q].parent >= 0: u.ps[q].has_scrolling = 0; q = u.ps[q].parent
			u.ps[q].has_scrolling = 0; hs = true
	else:
		hs = w == u.active && l.has_scrolling != 0
		u.ws[w].scrolled = if hin && (u.inp.sd.y > 0.0 || u.inp.sd.x > 0.0) && hs { 1 } else { 0 }
	st ~= 0 as u32; sc ~= Rect{l.bounds.x + l.bounds.w + pp.x, l.bounds.y, sbs.x, l.bounds.h}
	so := do_scrollbar(u, st, w, sc, hs, pget(u, l.oy) as f32, (l.at_y - sc.y) as! i32 as f32, sc.h * 0.10, sc.h * 0.01, u.st.scrollv, hin, true)
	pset(u, l.oy, so as! u32)
	if hin && hs: u.inp.sd.y = 0.0
	st = 0; sc = Rect{l.bounds.x, l.bounds.y + l.bounds.h, l.bounds.w, sbs.y}
	sx := do_scrollbar(u, st, w, sc, hs, pget(u, l.ox) as f32, (l.max_x - sc.x) as! i32 as f32, l.max_x * 0.05, l.max_x * 0.005, u.st.scrollh, hin, false)
	pset(u, l.ox, sx as! u32)
panel_scaler(u UC&, w int, pi int, sbs float2, pp float2):
	let l .= u.ps[pi]; let wn .= u.ws[w]; it := u.st.window.scaler
	sc ~= Rect{0.0, l.bounds.y + l.bounds.h, sbs.x, sbs.y}
	sc.x = if l.flags & 512 != 0 { l.bounds.x - pp.x * 0.5 } else { l.bounds.x + l.bounds.w + pp.x }
	if l.flags & 32 != 0: sc.x -= sc.w
	if it.kind == 1: draw_image_b(u, w, sc, it.img, WHITE)
	else:
		col := if it.kind == 2 { rgba_u32(it.img.texture) } else { it.color }
		if l.flags & 512 != 0: fill_triangle_b(u, w, sc.x, sc.y, sc.x, sc.y + sc.h, sc.x + sc.w, sc.y + sc.h, col)
		else: fill_triangle_b(u, w, sc.x + sc.w, sc.y, sc.x + sc.w, sc.y + sc.h, sc.x, sc.y + sc.h, col)
	if wn.flags & WIN_ROM != 0: return
	ms := u.st.window.min_size; let i .= u.inp
	if i.mb[0].down && i_click_down_in(i, 0, sc, true):
		dx ~= i.delta.x
		if l.flags & 512 != 0: dx = -dx; wn.bounds.x += i.delta.x
		if wn.bounds.w + dx >= ms.x && (dx < 0.0 || dx > 0.0 && i.pos.x >= sc.x): wn.bounds.w = wn.bounds.w + dx; sc.x += i.delta.x
		if l.flags & WIN_DYNAMIC == 0 && ms.y < wn.bounds.h + i.delta.y && (i.delta.y < 0.0 || i.delta.y > 0.0 && i.pos.y >= sc.y): wn.bounds.h = wn.bounds.h + i.delta.y; sc.y += i.delta.y
		u.cact = u.curs[6]; i.mb[0].pos.x = sc.x + sc.w / 2.0; i.mb[0].pos.y = sc.y + sc.h / 2.0
link_bounds(u UC&, b0 Rect, s const byte[:], tp float2, a0 u32, gw f32&) Rect:
	b ~= b0; fh := fht(u.font); b.h = mx(b.h, 2.0 * tp.y); gw = fwid(u.font, s); tw := gw + 2.0 * tp.x; a ~= a0
	if a & 7 == 0: a |= 1
	if a & 56 == 0: a |= 8
	l ~= Rect{0.0, 0.0, 0.0, 0.0}
	if a & 1 != 0: l.x = b.x + tp.x; l.w = mx(0.0, b.w - 2.0 * tp.x)
	else if a & 2 != 0:
		l.w = mx(1.0, 2.0 * tp.x + tw); l.x = b.x + tp.x + ((b.w - 2.0 * tp.x) - l.w) / 2.0; l.x = mx(b.x + tp.x, l.x); l.w = mn(b.x + b.w, l.x + l.w)
		if l.w >= l.x: l.w -= l.x
	else: l.x = mx(b.x + tp.x, (b.x + b.w) - (2.0 * tp.x + tw)); l.w = tw + 2.0 * tp.x
	if a & 8 != 0: l.y = b.y + tp.y; l.h = mn(fh, b.h - 2.0 * tp.y)
	else if a & 16 != 0: l.y = b.y + b.h / 2.0 - fh / 2.0; l.h = mx(b.h / 2.0, b.h - (b.h / 2.0 + fh / 2.0))
	else: l.y = b.y + b.h - fh; l.h = fh
	l
do_link(u UC&, s u32&, bi int, b Rect, t const byte[:], a u32, st StyleLink&, hin bool, bg Color) bool:
	gw ~= 0.0 as f32; l := link_bounds(u, b, t, st.padding, a, gw); fh := fht(u.font); tp := st.touch_padding
	tc ~= Rect{l.x - tp.x, l.y - tp.y, mn(gw, l.w) + 2.0 * tp.x, fh + 2.0 * tp.y}
	if tc.x < b.x: tc.w -= b.x - tc.x; tc.x = b.x
	if tc.y < b.y: tc.h -= b.y - tc.y; tc.y = b.y
	if tc.x + tc.w > b.x + b.w: tc.w = mx(0.0, b.x + b.w - tc.x)
	if tc.y + tc.h > b.y + b.h: tc.h = mx(0.0, b.y + b.h - tc.y)
	ret := button_behavior(u, s, tc, hin, 0)
	col := rgb_factor(if s & WS_HOVER != 0 { st.text_hover } else if s & WS_ACTIVED != 0 { st.text_active } else { st.text_normal }, st.color_factor)
	widget_text(u, bi, b, t, st.padding, bg, col, a, u.font)
	ul := st.underline == 2 || st.underline == 1 && s & (WS_HOVER | WS_ACTIVED) != 0
	if ul && st.underline_thickness > 0.0:
		g2 ~= 0.0 as f32; lb := link_bounds(u, b, t, st.padding, a, g2); x0 := lb.x; x1 := lb.x + mn(g2, lb.w); y := lb.y + fh - st.underline_thickness
		if x1 > x0: stroke_line_b(u, bi, x0, y, x1, y, st.underline_thickness, col)
	ret
link_at(k int, st StyleLink&, t const byte[:], align int, b Rect&, hin bool&) bool: btn_at(k, b, hin) && do_link(CT[k], CT[k].lws, CT[k].current, b, t, align as u32, st, hin, CT[k].st.window.background)
