cn_StyleSelectable(s StyleSelectable&): s.normal = ci(s.normal); s.hover = ci(s.hover); s.pressed = ci(s.pressed); s.normal_active = ci(s.normal_active); s.hover_active = ci(s.hover_active); s.pressed_active = ci(s.pressed_active)
