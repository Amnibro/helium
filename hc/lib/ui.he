	if k >= 0 && rcoords_ok(r, "ui::fill_circle"): fill_circle_b(CT[k], CT[k].current, r, color)
fill_arc(c Context, cx f32, cy f32, radius f32, a_min f32, a_max f32, color Color):
	k := canvas(c, "ui::fill_arc")
	if k >= 0 && arc_ok(cx, cy, radius, a_min, a_max, "ui::fill_arc"): fill_arc_b(CT[k], CT[k].current, cx, cy, radius, a_min, a_max, color)
fill_triangle(c Context, x0 f32, y0 f32, x1 f32, y1 f32, x2 f32, y2 f32, color Color):
