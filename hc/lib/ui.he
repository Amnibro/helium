pv_i(v i32, a i32, b i32, s i32) PV: p ~= PV{..}; p.i = v; p.imn = a; p.imx = b; p.ist = s; p
pv_f(v f32, a f32, b f32, s f32) PV: p ~= PV{..}; p.k = 1; p.f = v; p.fmn = a; p.fmx = b; p.fst = s; p
