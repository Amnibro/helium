group_end(c Context):
	k := ctx_get(c, "ui::group_end"); if k < 0 || !in_window(CT[k], "ui::group_end") || !expect_scope(CT[k], SC_GROUP, "ui::group_end"): return
	grp_end(CT[k]); pop_scope(CT[k])
group_scrolled_begin(c Context, offset Scroll, title const byte[:], flags int) bool:
	fw := "ui::group_scrolled_begin"; k := pan_ctx(c, fw); if k < 0 || !flags_ok(flags, fw) || !push_scope(CT[k], SC_GROUP_SCROLLED, true, fw): return false
	let u .= CT[k]; s := top_scope(u); u.sc[s].sx = offset.x; u.sc[s].sy = offset.y
	if grp_begin(u, Ptr{3, s, 0}, Ptr{3, s, 1}, cstr(title), flags as u32) == 1: return true
	pop_scope(u); false
group_scrolled_end(c Context) Scroll:
	fw := "ui::group_scrolled_end"; k := ctx_get(c, fw); if k < 0 || !in_window(CT[k], fw) || !expect_scope(CT[k], SC_GROUP_SCROLLED, fw): return Scroll{0, 0}
	let u .= CT[k]; grp_end(u); s := top_scope(u); o := Scroll{u.sc[s].sx, u.sc[s].sy}; pop_scope(u); o
group_get_scroll(c Context, id const byte[:]) Scroll:
	k := pan_ctx(c, "ui::group_get_scroll"); if k < 0: return Scroll{0, 0}
	ox ~= Ptr{0, 0, 0}; oy ~= Ptr{0, 0, 0}; grp_offsets(CT[k], cstr(id), ox, oy, true); Scroll{pget(CT[k], ox), pget(CT[k], oy)}
group_set_scroll(c Context, id const byte[:], x int, y int):
	k := pan_ctx(c, "ui::group_set_scroll"); if k < 0: return
	ox ~= Ptr{0, 0, 0}; oy ~= Ptr{0, 0, 0}
	if grp_offsets(CT[k], cstr(id), ox, oy, false): pset(CT[k], ox, uclamp(x)); pset(CT[k], oy, uclamp(y))
list_view_begin_into(c Context, out ListView&, id const byte[:], flags int, row_height int, row_count int) bool:
	fw := "ui::list_view_begin"; out = ListView{0, 0, 0}; k := pan_ctx(c, fw); if k < 0 || !flags_ok(flags, fw): return false
	if row_height < 1 || row_height > 65536 || row_count < 0 || row_count > 2147483647 / row_height: misuse(str(fw, ": ", row_count, " rows ", row_height, " high")); return false
	let u .= CT[k]
	if !push_scope(u, SC_LIST_VIEW, true, fw): return false
	s := top_scope(u); ox ~= Ptr{0, 0, 0}; oy ~= Ptr{0, 0, 0}; t := cstr(id); rh := row_height + max(0, (u.st.window.spacing.y as! i32) as int)
	if !grp_offsets(u, t, ox, oy, false): pop_scope(u); return false
	sv u32 := pget(u, oy); u.sc[s].lv_sv = sv; u.sc[s].lv_ptr = oy; pset(u, oy, 0)
	r := grp_begin(u, ox, oy, t, flags as u32); l := u.ps[lpi(u)]; u.sc[s].lv_th = rh * max(row_count, 1)
	bg := ((mx(sv as f32 / rh as f32, 0.0)) as! i32) as int; n := min(max(icel(l.clip.h / rh as f32), 0), row_count - bg)
	u.sc[s].view = ListView{bg, bg + n, n}
	if r != 1: pop_scope(u); return false
	out = u.sc[s].view; true
list_view_end(c Context):
	fw := "ui::list_view_end"; k := ctx_get(c, fw); if k < 0 || !in_window(CT[k], fw) || !expect_scope(CT[k], SC_LIST_VIEW, fw): return
	let u .= CT[k]; s := top_scope(u); p := u.sc[s].lv_ptr; l := lpi(u)
	u.ps[l].at_y = u.ps[l].bounds.y + u.sc[s].lv_th as f32; pset(u, p, pget(u, p) + u.sc[s].lv_sv); grp_end(u); pop_scope(u)
tree_draw(u UC&, ty int, img Image, hi bool, title const byte[:], st int&, el bool, sel bool&) bool:
	fh := fht(u.font); rh := fh + 2.0 * u.st.tab.padding.y; isp := u.st.window.spacing; tb := u.st.tab
	u.ps[lpi(u)].row.min_height = rh; row_layout(u, true, rh, 1, 0); reset_min_row_height(u)
	hd ~= Rect{0.0, 0.0, 0.0, 0.0}; wst := widget(u, hd); bi := u.current; f := tb.color_factor
	if ty == 1:
		bg := tb.background
		if bg.kind == 1: draw_image_b(u, bi, hd, bg.img, rgb_factor(WHITE, f))
		else if bg.kind == 2: draw_nine_slice_b(u, bi, hd, NineSlice{bg.img, bg.l, bg.t, bg.r, bg.b}, rgb_factor(WHITE, f))
		else: fill_rect_b(u, bi, hd, 0.0, rgb_factor(tb.border_color, f)); fill_rect_b(u, bi, shrink(hd, tb.border), tb.rounding, rgb_factor(bg.color, f))
	hin := u.ps[lpi(u)].flags & WIN_ROM == 0 && wst == 1; ws ~= 0 as u32
	if !el && button_behavior(u, ws, hd, hin, 0): st = if st == 1 { 0 } else { 1 }
	mx0 := st == 1; sym := if mx0 { tb.sym_maximize } else { tb.sym_minimize }
	bt ~= if mx0 { if ty == 1 { tb.tab_maximize_button } else { tb.node_maximize_button } } else { if ty == 1 { tb.tab_minimize_button } else { tb.node_minimize_button } }
	sy ~= Rect{hd.x + tb.padding.x, hd.y + tb.padding.y, fh, fh}
	if do_button_symbol(u, ws, bi, sy, sym as int, 0, bt, el && hin) && el: st = if st == 1 { 0 } else { 1 }
	if !el && hi: sy.x = sy.x + sy.w + 4.0 * isp.x; draw_image_b(u, bi, sy, img, WHITE); sy.w = fh + tb.spacing.x
	hd.w = mx(hd.w, sy.w + isp.x); lw := hd.w - (sy.w + isp.y + tb.indent)
	if el: dm ~= 0 as u32; do_selectable(u, dm, bi, Rect{sy.x + sy.w + isp.x, sy.y, mn(lw, fwid(u.font, title) + 2.0 * u.st.selectable.padding.x), fh}, title, 17, sel, if hi { 1 } else { 0 }, img, 0, u.st.selectable, hin)
	else: widget_text(u, bi, Rect{sy.x + sy.w + isp.x, sy.y, lw, fh}, title, v2(0.0, 0.0), u.st.window.background, rgb_factor(tb.text, f), 17, u.font)
	if st != 1: return false
	let l .= u.ps[lpi(u)]; l.at_x = hd.x + pget(u, l.ox) as f32 + tb.indent; l.bounds.w = mx(l.bounds.w, tb.indent); l.bounds.w -= tb.indent + u.st.window.padding.x; l.row.tree_depth += 1; true
tree_ok(u UC&, ty int, st int, fw const byte[:]) bool: new_row(u, fw) && enum_ok(ty, 2, fw, "TREE_NODE, TREE_TAB") && enum_ok(st, 2, fw, "MINIMIZED, MAXIMIZED")
tree_go(c Context, ty int, img Image, hi bool, title const byte[:], ist int, hash const byte[:], seed int, sel bool&, el bool, fw const byte[:]) bool:
	k := ctx_get(c, fw); if k < 0 || !tree_ok(CT[k], ty, ist, fw): return false
	let u .= CT[k]; t := cstr(title); h u32 := if hash.len > 0 { murmur(hash[..tlen(hash, fw)], seed as u32) } else { murmur(t, seed as u32) }
	p ~= find_value(u, u.current, h)
	if p.k == 0: p = add_value(u, u.current, h, ist as u32)
	st ~= pget(u, p) as int; r := tree_draw(u, ty, img, hi, t, st, el, sel); pset(u, p, st as u32)
	r && push_scope(u, if el { SC_TREE_ELEMENT } else { SC_TREE }, true, fw)
tree_push_hashed(c Context, tree_type int, title const byte[:], initial_state int, hash const byte[:], seed int) bool: s ~= false; tree_go(c, tree_type, Image{}, false, title, initial_state, hash, seed, s, false, "ui::tree_push_hashed")
tree_image_push_hashed(c Context, tree_type int, img Image, title const byte[:], initial_state int, hash const byte[:], seed int) bool: s ~= false; tree_go(c, tree_type, img, true, title, initial_state, hash, seed, s, false, "ui::tree_image_push_hashed")
tree_element_push_hashed(c Context, tree_type int, title const byte[:], initial_state int, selected bool&, hash const byte[:], seed int) bool: tree_go(c, tree_type, Image{}, false, title, initial_state, hash, seed, selected, true, "ui::tree_element_push_hashed")
tree_element_image_push_hashed(c Context, tree_type int, img Image, title const byte[:], initial_state int, selected bool&, hash const byte[:], seed int) bool: tree_go(c, tree_type, img, true, title, initial_state, hash, seed, selected, true, "ui::tree_element_image_push_hashed")
tree_st(c Context, ty int, img Image, hi bool, title const byte[:], state int&, fw const byte[:]) bool:
	k := ctx_get(c, fw); if k < 0 || !tree_ok(CT[k], ty, state, fw): return false
	s ~= false; st ~= state; r := tree_draw(CT[k], ty, img, hi, cstr(title), st, false, s); state = st; r && push_scope(CT[k], SC_TREE_STATE, true, fw)
tree_state_push(c Context, tree_type int, title const byte[:], state int&) bool: tree_st(c, tree_type, Image{}, false, title, state, "ui::tree_state_push")
tree_state_image_push(c Context, tree_type int, img Image, title const byte[:], state int&) bool: tree_st(c, tree_type, img, true, title, state, "ui::tree_state_image_push")
tree_end(c Context, kind int, fw const byte[:]):
	k := pan_ctx(c, fw); if k < 0 || !expect_scope(CT[k], kind, fw): return
	let u .= CT[k]; let l .= u.ps[lpi(u)]; l.at_x -= u.st.tab.indent + pget(u, l.ox) as f32; l.bounds.w += u.st.tab.indent + u.st.window.padding.x; l.row.tree_depth -= 1; pop_scope(u)
tree_pop(c Context): tree_end(c, SC_TREE, "ui::tree_pop")
tree_state_pop(c Context): tree_end(c, SC_TREE_STATE, "ui::tree_state_pop")
tree_element_pop(c Context): tree_end(c, SC_TREE_ELEMENT, "ui::tree_element_pop")
NOIMG := Image{..}
inside(u UC&, kind int, fw const byte[:]) bool:
	if !in_panel(u, fw): return false
	i ~= u.sc.len - 1
	while i >= 0 && u.sc[i].kind != kind && u.sc[i].kind > SC_TOOLTIP: i -= 1
	i >= 0 && u.sc[i].kind == kind || expect_scope(u, kind, fw)
popup_ok(u UC&, fw const byte[:]) bool: in_panel(u, fw) && popup_allowed(u, fw)
opened(u UC&, r bool, kind int, fw const byte[:]) bool: r && push_scope(u, kind, true, fw)
root_rom(u UC&, w int, set u32, clr u32):
	p ~= u.ws[w].lay
	while p >= 0: u.ps[p].flags = (u.ps[p].flags | set) & ~clr; p = u.ps[p].parent
start_popup(u UC&, w int): b := u.ws[w].buf; u.ws[w].pop.buf = PB{b.end, b.last, b.end, b.end, true}
finish_popup(u UC&, w int): u.ws[w].pop.buf.last = u.ws[w].buf.last; u.ws[w].pop.buf.end = u.ws[w].buf.end
pop_offsets(u UC&, w int, p int): pl := u.ws[p].lay; u.ps[pl].ox = Ptr{1, p, 0}; u.ps[pl].oy = Ptr{1, p, 1}; u.ps[pl].parent = u.ws[w].lay
popup_begin_nk(u UC&, ty int, title const byte[:], fl u32, r0 Rect) bool:
	w := u.current; th u32 := murmur(title, PAN_POPUP)
	if u.ws[w].pop.win < 0: p := new_window(u); u.ws[p].parent = w; u.ws[w].pop.win = p; u.ws[w].pop.active = false; u.ws[w].pop.ty = PAN_POPUP
	p := u.ws[w].pop.win
	if u.ws[w].pop.name != th:
		if u.ws[w].pop.active: return false
		u.ws[p] = Win{..}; u.ws[w].pop.name = th; u.ws[w].pop.active = true; u.ws[w].pop.ty = PAN_POPUP
	u.current = p; cl := u.ps[u.ws[w].lay].clip; lay := new_panel(u)
	u.ws[p].parent = w; u.ws[p].bounds = Rect{r0.x + cl.x, r0.y + cl.y, r0.w, r0.h}; u.ws[p].seq = u.seq; u.ws[p].lay = lay; u.ws[p].flags = fl | 1 | (if ty == 1 { WIN_DYNAMIC } else { 0 })
	u.ws[p].buf = u.ws[w].buf; start_popup(u, w); n := u.cm.len; push_scissor_b(u, p, NULL_RECT)
	if panel_begin(u, title, true, PAN_POPUP): root_rom(u, w, WIN_ROM, WIN_REMOVE_ROM); u.ws[w].pop.active = true; pop_offsets(u, w, p); return true
	root_rom(u, w, WIN_REMOVE_ROM, 0); u.ws[w].pop.buf.active = false; u.ws[w].pop.active = false
	while u.cm.len > n: u.cm.pop()
	u.current = w; u.pfree.push(u.ws[p].lay); u.ws[p].lay = -1; false
nonblock_begin(u UC&, fl u32, body Rect, hd Rect, ty u32) bool:
	w := u.current; act ~= true
	if u.ws[w].pop.win < 0: p := new_window(u); u.ws[p].parent = w; u.ws[w].pop.win = p; u.ws[w].pop.ty = ty
	else: act = !(i_pressed(u.inp, 0) && (!i_hover(u.inp, body) || i_hover(u.inp, hd)))
	u.ws[w].pop.header = hd
	if !act: root_rom(u, w, WIN_REMOVE_ROM, 0); u.ws[w].pop.buf.active = false; return false
	p := u.ws[w].pop.win; lay := new_panel(u)
	u.ws[p].bounds = body; u.ws[p].parent = w; u.ws[p].lay = lay; u.ws[p].flags = fl | 1 | WIN_DYNAMIC; u.ws[p].seq = u.seq; u.ws[w].pop.active = true
	start_popup(u, w); u.ws[p].buf = u.ws[w].buf; push_scissor_b(u, p, NULL_RECT); u.current = p
	panel_begin(u, "", false, ty); u.ws[w].buf = u.ws[p].buf; pop_offsets(u, w, p); root_rom(u, w, WIN_ROM, 0); true
popup_close_nk(u UC&): u.ws[u.current].flags |= WIN_HIDDEN
popup_end_nk(u UC&):
	p := u.current; w := u.ws[p].parent; if w < 0 || u.ws[p].lay < 0: return
	if u.ws[p].flags & WIN_HIDDEN != 0: root_rom(u, w, WIN_REMOVE_ROM, 0); u.ws[w].pop.active = false
	push_scissor_b(u, p, NULL_RECT); end_nk(u); u.ws[w].buf = u.ws[p].buf; finish_popup(u, w); u.current = w; push_scissor_b(u, w, u.ps[u.ws[w].lay].clip)
ctx_begin(u UC&, fl u32, sz float2, tb Rect) bool:
	w := u.current; u.ws[w].pop.con_count += 1
	if u.current != u.active || u.ws[w].wdis: return false
	p := u.ws[w].pop.win; open := p >= 0 && u.ws[w].pop.ty == PAN_CONTEXTUAL; clk := i_mouse_clicked(u.inp, 2, tb)
	if u.ws[w].pop.active_con != 0 && u.ws[w].pop.con_count != u.ws[w].pop.active_con: return false
	if !open && u.ws[w].pop.active_con != 0: u.ws[w].pop.active_con = 0
	if !open && !clk: return false
	u.ws[w].pop.active_con = u.ws[w].pop.con_count
	b := if clk { Rect{u.inp.pos.x, u.inp.pos.y, sz.x, sz.y} } else { Rect{u.ws[p].bounds.x, u.ws[p].bounds.y, sz.x, sz.y} }
	r := nonblock_begin(u, fl | 32, b, Rect{-1.0, -1.0, 0.0, 0.0}, PAN_CONTEXTUAL)
	if r: u.ws[w].pop.ty = PAN_CONTEXTUAL
	else: u.ws[w].pop.active_con = 0; u.ws[w].pop.ty = 0; if u.ws[w].pop.win >= 0 { u.ws[u.ws[w].pop.win].flags = 0 }
	r
ctx_item(u UC&, how int, t const byte[:], img Image, sym int, a u32) bool:
	b ~= NULL_RECT; s := widget(u, b); if s == 0: return false
	hin := !(s == 2 || u.ps[lpi(u)].flags & WIN_ROM != 0)
	hit := if how == 0 { do_button_text(u, u.lws, u.current, b, t, a, 0, u.st.contextual_button, hin) } else if how == 1 { do_button_text_image(u, u.lws, u.current, b, img, t, a, 0, u.st.contextual_button, hin) } else { do_button_text_symbol(u, u.lws, u.current, b, sym, t, a, 0, u.st.contextual_button, hin) }
	if hit: popup_close_nk(u)
	hit
ctx_end(u UC&):
	p := u.current; pl := u.ws[p].lay; l := u.ps[pl]
	if l.flags & WIN_DYNAMIC != 0:
		bd ~= Rect{0.0, 0.0, 0.0, 0.0}
		if l.at_y < l.bounds.y + l.bounds.h: pp := pan_padding(u.st, l.ty); bd = l.bounds; bd.y = l.at_y + l.footer_height + l.border + pp.y + l.row.height; bd.h = l.bounds.y + l.bounds.h - bd.y
		if i_pressed(u.inp, 0) && i_hover(u.inp, bd): u.ws[p].flags |= WIN_HIDDEN
	if u.ws[p].flags & WIN_HIDDEN != 0: u.ws[p].seq = 0
	popup_end_nk(u)
draw_btn_sym(u UC&, bi int, b Rect, c Rect, s u32, st StyleButton&, sym int): bg := draw_button(u, bi, b, s, st); draw_symbol(u, bi, sym, c, btn_bg(bg, st), btn_fg(s, st), st.border, u.font)
combo_open(u UC&, w int, sz float2, clk bool, hd Rect) bool:
	p := u.ws[w].pop.win; body := Rect{hd.x, hd.y + hd.h - u.st.window.combo_border, sz.x, sz.y}
	h := u.ws[w].pop.combo_count; u.ws[w].pop.combo_count += 1
	open := p >= 0; act := open && u.ws[w].pop.name == h && u.ws[w].pop.ty == PAN_COMBO
	if clk && open && !act || open && !act || !open && !act && !clk: return false
	if !nonblock_begin(u, 0, body, if clk && open { Rect{0.0, 0.0, 0.0, 0.0} } else { hd }, PAN_COMBO): return false
	u.ws[w].pop.ty = PAN_COMBO; u.ws[w].pop.name = h; true
combo_go(u UC&, how int, t const byte[:], col Color, symbol int, img Image, sz float2) bool:
	w := u.current; hd ~= NULL_RECT; s := widget(u, hd); if s == 0: return false
	hin := !(u.ps[lpi(u)].flags & WIN_ROM != 0 || s == 3 || s == 2); clk := button_behavior(u, u.lws, hd, hin, 0)
	cs := u.st.combo; ac := u.lws & WS_ACTIVED != 0; hv := u.lws & WS_HOVER != 0
	bgi := if ac { cs.active } else if hv { cs.hover } else { cs.normal }
	tc := rgb_factor(if ac { cs.label_active } else if hv { cs.label_hover } else { cs.label_normal }, cs.color_factor)
	sc := rgb_factor(if ac { cs.symbol_active } else if hv { cs.symbol_hover } else if how == 2 { cs.symbol_hover } else { cs.symbol_normal }, cs.color_factor)
	tbg ~= Color{0, 0, 0, 0}; wf := rgb_factor(WHITE, cs.color_factor)
	if bgi.kind == STYLE_ITEM_IMAGE: draw_image_b(u, w, hd, bgi.img, wf)
	else if bgi.kind == STYLE_ITEM_NINE_SLICE: draw_nine_slice_b(u, w, hd, NineSlice{bgi.img, bgi.l, bgi.t, bgi.r, bgi.b}, wf)
	else: tbg = bgi.color; fill_rect_b(u, w, hd, cs.rounding, rgb_factor(bgi.color, cs.color_factor)); stroke_rect_b(u, w, hd, cs.rounding, cs.border, rgb_factor(cs.border_color, cs.color_factor))
	sym := if hv { cs.sym_hover } else if clk { cs.sym_active } else { cs.sym_normal }; dbs := sym != 0; cp := cs.content_padding; bp := cs.button.padding
	bw := hd.h - 2.0 * cs.button_padding.y; bt := Rect{hd.x + hd.w - hd.h - (if how == 2 || how == 4 { cs.button_padding.y } else { cs.button_padding.x }), hd.y + cs.button_padding.y, bw, bw}
	ct := Rect{bt.x + bp.x, bt.y + bp.y, bt.w - 2.0 * bp.x, bt.h - 2.0 * bp.y}
	if how == 0:
		lw := if dbs { bt.x - (cp.x + cs.spacing.x) - (hd.x + cp.x) } else { hd.w - 2.0 * cp.x }
		widget_text(u, w, Rect{hd.x + cp.x, hd.y + cp.y, lw, hd.h - 2.0 * cp.y}, t, NOPAD, tbg, tc, 17, u.font)
		if dbs: draw_btn_sym(u, w, bt, ct, u.lws, cs.button, sym)
	else if how == 1:
		bx := hd.x + 2.0 * cp.x; fill_rect_b(u, w, Rect{bx, hd.y + 2.0 * cp.y, if dbs { bt.x - (cp.x + cs.spacing.x) - bx } else { hd.w - 4.0 * cp.x }, hd.h - 4.0 * cp.y}, 0.0, rgb_factor(col, cs.color_factor))
		if dbs: draw_btn_sym(u, w, bt, ct, u.lws, cs.button, sym)
	else if how == 2 || how == 4:
		bx := hd.x + cp.x; bd := Rect{bx, hd.y + cp.y, if dbs || how == 2 { bt.x - cp.y - bx } else { hd.w - 2.0 * cp.x }, hd.h - 2.0 * cp.y}
		if how == 2: draw_symbol(u, w, symbol, bd, tbg, sc, cs.border, u.font); draw_btn_sym(u, w, bd, ct, u.lws, cs.button, sym)
		else: draw_image_b(u, w, bd, img, wf); if dbs { draw_btn_sym(u, w, bd, ct, u.lws, cs.button, sym) }
	else:
		if how == 3 || dbs: draw_btn_sym(u, w, bt, ct, u.lws, cs.button, sym)
		ih := hd.h - 2.0 * cp.y; im := Rect{hd.x + cp.x, hd.y + cp.y, ih, ih}
		if how == 3 { draw_symbol(u, w, symbol, im, tbg, sc, cs.border, u.font) } else { draw_image_b(u, w, im, img, wf) }
		lx := im.x + im.w + cs.spacing.x + cp.x; lw := if how == 3 || dbs { bt.x - cp.x - lx } else { hd.x + hd.w - cp.x - lx }
		widget_text(u, w, Rect{lx, hd.y + cp.y, lw, hd.h - 2.0 * cp.y}, t, NOPAD, tbg, tc, 17, u.font)
	combo_open(u, w, sz, clk, hd)
item_end(s const byte[:], at int, sep int) int:
	e ~= at
	while e < s.len && s[e] != 0 && s[e] as int != sep: e += 1
	e
combo_sep(u UC&, items const byte[:], sep int, sel0 int, count int, ih int, sz0 float2) int:
	sel ~= sel0; sz ~= sz0; sz.y = mn(sz.y, count as f32 * ih as f32 + count as f32 * u.st.window.spacing.y + pan_padding(u.st, PAN_COMBO).y + 2.0 * u.st.window.combo_border)
	st ~= 0; e ~= item_end(items, 0, sep); i ~= 0
	while i < sel: st = e + 1; e = item_end(items, st, sep); i += 1
	if combo_go(u, 0, items[st..e], NOCOL, 0, NOIMG, sz):
		row_layout(u, true, ih as f32, 1, 0); st = 0
		for j count: e = item_end(items, st, sep); if ctx_item(u, 0, items[st..e], NOIMG, 0, 17) { sel = j } st = e + 1
		ctx_end(u)
	sel
items_ok(items const byte[:], sep int, sel int, count int, ih int, fw const byte[:]) bool:
	if sep < 0 || sep > 127: return misuse(str(fw, ": a separator ", sep, ", where it is an ASCII character"))
	have ~= 1; for ch items: if ch == 0 || ch as int == sep { have += 1 }
	if count < 1 || count > have: return misuse(str(fw, ": ", count, " items, where the string holds ", have))
	if sel < 0 || sel >= count: return misuse(str(fw, ": item ", sel, " selected, of ", count))
	ih >= 1 && ih <= 65536 || misuse(str(fw, ": items ", ih, " high"))
menu_open(u UC&, w int, id const byte[:], clk bool, hd Rect, sz float2) bool:
	h := murmur(id, PAN_MENU); p := u.ws[w].pop.win; open := p >= 0; act := open && u.ws[w].pop.name == h && u.ws[w].pop.ty == PAN_MENU
	if clk && open && !act || open && !act || !open && !act && !clk: return false
	if !nonblock_begin(u, 32, Rect{hd.x, hd.y + hd.h, sz.x, sz.y}, hd, PAN_MENU): return false
	u.ws[w].pop.ty = PAN_MENU; u.ws[w].pop.name = h; true
menu_go(u UC&, how int, id const byte[:], t const byte[:], a u32, img Image, sym int, sz float2) bool:
	w := u.current; hd ~= NULL_RECT; s := widget(u, hd); if s == 0: return false
	hin := !(s == 2 || s == 3 || (if how == 0 { u.ws[w].flags } else { u.ps[lpi(u)].flags }) & WIN_ROM != 0)
	clk := if how == 0 { do_button_text(u, u.lws, w, hd, t, a, 0, u.st.menu_button, hin) } else if how == 1 { do_button_image(u, u.lws, w, hd, img, 0, u.st.menu_button, hin) } else if how == 2 { do_button_symbol(u, u.lws, w, hd, sym, 0, u.st.menu_button, hin) } else if how == 3 { do_button_text_image(u, u.lws, w, hd, img, t, a, 0, u.st.menu_button, hin) } else { do_button_text_symbol(u, u.lws, w, hd, sym, t, a, 0, u.st.menu_button, hin) }
	menu_open(u, w, id, clk, hd, sz)
tip_begin(u UC&, wd f32, pos int, off float2) bool:
	w := u.current; if u.ws[w].pop.win >= 0 && u.ws[w].pop.ty & PAN_NONBLOCK != 0: return false
	l := u.ps[u.ws[w].lay]; tw := icel(wd); th := mx(l.row.min_height, fht(u.font) + 2.0 * u.st.window.padding.y) as! i32 as int
	x := iflr(u.inp.pos.x + 1.0) - (l.clip.x as! i32) as int + (off.x as! i32) as int - (if pos == 1 || pos == 4 || pos == 7 { tw / 2 } else if pos == 2 || pos == 5 || pos == 8 { tw } else { 0 })
	y := iflr(u.inp.pos.y + 1.0) - (l.clip.y as! i32) as int + (off.y as! i32) as int - (if pos >= 3 && pos <= 5 { th / 2 } else if pos >= 6 && pos <= 8 { th } else { 0 })
	r := popup_begin_nk(u, 1, "__##Tooltip##__", 33, Rect{x as f32, y as f32, tw as f32, 16384.0})
	if r: u.ps[u.ws[w].lay].flags &= ~WIN_ROM
	u.ws[w].pop.ty = PAN_TOOLTIP; u.ps[u.ws[u.current].lay].ty = PAN_TOOLTIP; r
tip_end(u UC&): u.ws[u.current].seq -= 1; popup_close_nk(u); popup_end_nk(u)
tip_text(u UC&, t const byte[:], pos int, off float2):
	tw := fwid(u.font, t) + 2.0 * u.st.window.popup_padding.x + 2.0 * u.st.window.popup_border
	if tip_begin(u, tw, pos, off): row_layout(u, true, fht(u.font) + 2.0 * u.st.window.padding.y, 1, 0); text_colored(u, t, 17, u.st.text.color); tip_end(u)
hover_delay(u UC&, r Rect, t f32&, d f32, clicked bool&, ck bool) bool:
	if ck && clicked:
		if !i_moved(u.inp): return false
		clicked = false; t = 0.0
	if inbox(u.inp.pos.x, u.inp.pos.y, r):
		if t >= d: return true
		if !i_moved(u.inp): t += u.dt; return t >= d
		t = 0.0
	else if inbox(u.inp.prev.x, u.inp.prev.y, r): t = 0.0
	false
tip_pos_ok(pos int, off float2, fw const byte[:]) bool: enum_ok(pos, 9, fw, "tooltip position (TOP_LEFT ... BOTTOM_RIGHT)") && vec_ok(off, fw)
popup_begin(c Context, popup_type int, title const byte[:], flags int, rect Rect) bool:
	fw := "ui::popup_begin"; k := ctx_get(c, fw); if k < 0: return false
	let u .= CT[k]; popup_ok(u, fw) && enum_ok(popup_type, 2, fw, "POPUP_STATIC, POPUP_DYNAMIC") && flags_ok(flags, fw) && rect_ok(rect, fw) && opened(u, popup_begin_nk(u, popup_type, cstr(title), flags as u32, rect), SC_POPUP, fw)
closer(c Context, kind int, fw const byte[:]): k := ctx_get(c, fw); if k >= 0 && inside(CT[k], kind, fw) { popup_close_nk(CT[k]) }
ender(c Context, kind int, fw const byte[:]) int: k := ctx_get(c, fw); if k >= 0 && in_window(CT[k], fw) && expect_scope(CT[k], kind, fw) { k } else { -1 }
popup_close(c Context): closer(c, SC_POPUP, "ui::popup_close")
popup_end(c Context): k := ender(c, SC_POPUP, "ui::popup_end"); if k >= 0 { popup_end_nk(CT[k]); pop_scope(CT[k]) }
popup_get_scroll(c Context) Scroll:
	fw := "ui::popup_get_scroll"; k := ctx_get(c, fw); if k < 0 || !inside(CT[k], SC_POPUP, fw): return Scroll{0, 0}
	Scroll{CT[k].ws[CT[k].current].sx, CT[k].ws[CT[k].current].sy}
popup_set_scroll(c Context, x int, y int):
	fw := "ui::popup_set_scroll"; k := ctx_get(c, fw); if k < 0 || !inside(CT[k], SC_POPUP, fw): return
	let w .= CT[k].ws[CT[k].current]; w.sx = (if x < 0 { 0 } else if x > 4294967295 { 4294967295 } else { x }) as u32; w.sy = (if y < 0 { 0 } else if y > 4294967295 { 4294967295 } else { y }) as u32
combo_separator(c Context, items const byte[:], separator int, selected int, count int, item_height int, size float2) int:
	fw := "ui::combo_separator"; k := ctx_get(c, fw); if k < 0: return selected
	let u .= CT[k]; if !popup_ok(u, fw) || !vec_ok(size, fw) || !items_ok(items, separator, selected, count, item_height, fw): return selected
	combo_sep(u, items, separator, selected, count, item_height, size)
combobox_separator(c Context, items const byte[:], separator int, selected int&, count int, item_height int, size float2) bool:
	fw := "ui::combobox_separator"; k := ctx_get(c, fw); if k < 0: return false
	let u .= CT[k]; if !popup_ok(u, fw) || !vec_ok(size, fw) || !items_ok(items, separator, selected, count, item_height, fw): return false
	t := selected; selected = combo_sep(u, items, separator, selected, count, item_height, size); t != selected
cbeg(c Context, fw const byte[:], how int, t const byte[:], col Color, symbol int, img Image, size float2) bool:
	k := ctx_get(c, fw); if k < 0: return false
	let u .= CT[k]; popup_ok(u, fw) && (how != 2 && how != 3 || symbol_ok(symbol, fw)) && vec_ok(size, fw) && opened(u, combo_go(u, how, t[..tlen(t, fw)], col, symbol, img, size), SC_COMBO, fw)
combo_begin_label(c Context, selected const byte[:], size float2) bool: cbeg(c, "ui::combo_begin_label", 0, selected, NOCOL, 0, NOIMG, size)
combo_begin_color(c Context, color Color, size float2) bool: cbeg(c, "ui::combo_begin_color", 1, "", color, 0, NOIMG, size)
combo_begin_symbol(c Context, symbol int, size float2) bool: cbeg(c, "ui::combo_begin_symbol", 2, "", NOCOL, symbol, NOIMG, size)
combo_begin_symbol_label(c Context, selected const byte[:], symbol int, size float2) bool: cbeg(c, "ui::combo_begin_symbol_label", 3, selected, NOCOL, symbol, NOIMG, size)
combo_begin_image(c Context, img Image, size float2) bool: cbeg(c, "ui::combo_begin_image", 4, "", NOCOL, 0, img, size)
combo_begin_image_label(c Context, selected const byte[:], img Image, size float2) bool: cbeg(c, "ui::combo_begin_image_label", 5, selected, NOCOL, 0, img, size)
pitem(c Context, kind int, fw const byte[:], how int, t const byte[:], img Image, sym int, align int) bool:
	k := ctx_get(c, fw); k >= 0 && inside(CT[k], kind, fw) && (how != 2 || symbol_ok(sym, fw)) && ctx_item(CT[k], how, t[..tlen(t, fw)], img, sym, align as u32)
