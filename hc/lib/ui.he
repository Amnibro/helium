fixed(x real, d int) byte[>..]: o byte[>..] ~= []; if x == 0.0 && 1.0 / x < 0.0 { o.push('-') } format_flt(o, x, d); o
value_bool(c Context, prefix const byte[:], value bool): value_w(c, "ui::value_bool", prefix, if value { "true" } else { "false" })
value_int(c Context, prefix const byte[:], value int): value_w(c, "ui::value_int", prefix, str(value))
value_uint(c Context, prefix const byte[:], value uint): value_w(c, "ui::value_uint", prefix, str(value))
