hidden_wh(u UC&, w Win&) Rect: if w.flags & WIN_MINIMIZED == 0 { w.bounds } else { Rect{w.bounds.x, w.bounds.y, w.bounds.w, fht(u.font) + 2.0 * u.st.window.header.padding.y + 2.0 * u.st.window.header.label_padding.y} }
panel_begin(u UC&, title const byte[:], has_title bool, ty u32) bool:
	if u.current < 0 || u.ws[u.current].lay < 0: return false
	w := u.current; pi := u.ws[w].lay; u.ps[pi] = Pan{..}
	if u.ws[w].flags & (WIN_HIDDEN | WIN_CLOSED) != 0: u.ps[pi].ty = ty; return false
	let s .= u.st; hin := u.ws[w].flags & NO_INPUT_U == 0; fh := fht(u.font)
	sbs := s.window.scrollbar_size; pp := pan_padding(s, ty)
	if u.ws[w].flags & 2 != 0 && u.ws[w].flags & WIN_ROM == 0 && hin:
		hd ~= Rect{u.ws[w].bounds.x, u.ws[w].bounds.y, u.ws[w].bounds.w, 0.0}
		hd.h = if has_header(u.ws[w].flags, has_title) { fh + 2.0 * s.window.header.padding.y + 2.0 * s.window.header.label_padding.y } else { pp.y }
		let i .= u.inp; ld := i.mb[0].down; lc := i.mb[0].clicked; lin := i_click_down_in(i, 0, hd, true)
		if ld && lin && lc == 0:
			u.ws[w].bounds.x += i.delta.x; u.ws[w].bounds.y += i.delta.y; i.mb[0].pos.x += i.delta.x; i.mb[0].pos.y += i.delta.y; u.cact = u.curs[2]
	let l .= u.ps[pi]; let wn .= u.ws[w]
	l.ty = ty; l.flags = wn.flags; l.bounds = wn.bounds; l.bounds.x += pp.x; l.bounds.w -= 2.0 * pp.x
	if wn.flags & 1 != 0: l.border = pan_border(s, wn.flags, ty); l.bounds = shrink(l.bounds, l.border)
	else: l.border = 0.0
	l.at_y = l.bounds.y; l.at_x = l.bounds.x; l.max_x = 0.0; l.header_height = 0.0; l.footer_height = 0.0
	reset_min_row_height(u)
	l.row.index = 0; l.row.columns = 0; l.row.ratio = -1; l.row.item_width = 0.0; l.row.tree_depth = 0; l.row.height = pp.y; l.has_scrolling = 1
	if wn.flags & 32 == 0: l.bounds.w -= sbs.x
	if !is_nonblock(ty):
		l.footer_height = 0.0
		if wn.flags & 32 == 0 || wn.flags & 4 != 0: l.footer_height = sbs.y
		l.bounds.h -= l.footer_height
	if has_header(wn.flags, has_title):
		hd ~= Rect{wn.bounds.x, wn.bounds.y, wn.bounds.w, fh + 2.0 * s.window.header.padding.y}
		hd.h += 2.0 * s.window.header.label_padding.y
		l.header_height = hd.h; l.bounds.y += hd.h; l.bounds.h -= hd.h; l.at_y += hd.h
		bgi ~= s.window.header.normal; tc ~= s.window.header.label_normal
		if u.active == w: bgi = s.window.header.active; tc = s.window.header.label_active
		else if i_hover(u.inp, hd): bgi = s.window.header.hover; tc = s.window.header.label_hover
		hd.h += 1.0; tbg ~= NOCOL
		if bgi.kind == STYLE_ITEM_IMAGE: draw_image_b(u, w, hd, bgi.img, Color{255, 255, 255, 255})
		else if bgi.kind == STYLE_ITEM_NINE_SLICE: draw_nine_slice_b(u, w, hd, NineSlice{bgi.img, bgi.l, bgi.t, bgi.r, bgi.b}, Color{255, 255, 255, 255})
		else: tbg = bgi.color; fill_rect_b(u, w, hd, 0.0, bgi.color)
		bt ~= Rect{0.0, hd.y + s.window.header.padding.y, 0.0, hd.h - 2.0 * s.window.header.padding.y}; bt.w = bt.h
		if wn.flags & 8 != 0:
			if s.window.header.align == 1: bt.x = (hd.w + hd.x) - (bt.w + s.window.header.padding.x); hd.w -= bt.w + s.window.header.spacing.x + s.window.header.padding.x
			else: bt.x = hd.x + s.window.header.padding.x; hd.x += bt.w + s.window.header.spacing.x + s.window.header.padding.x
			if header_button(u, w, bt, s.window.header.close_symbol, true, hin) && wn.flags & WIN_ROM == 0: l.flags |= WIN_HIDDEN; l.flags &= ~WIN_MINIMIZED
		if wn.flags & 16 != 0:
			if s.window.header.align == 1:
				bt.x = (hd.w + hd.x) - bt.w
				if wn.flags & 8 == 0: bt.x -= s.window.header.padding.x; hd.w -= s.window.header.padding.x
				hd.w -= bt.w + s.window.header.spacing.x
			else: bt.x = hd.x; hd.x += bt.w + s.window.header.spacing.x + s.window.header.padding.x
			sym := if l.flags & WIN_MINIMIZED != 0 { s.window.header.maximize_symbol } else { s.window.header.minimize_symbol }
			if header_button(u, w, bt, sym, false, hin) && wn.flags & WIN_ROM == 0: l.flags = if l.flags & WIN_MINIMIZED != 0 { l.flags & ~WIN_MINIMIZED } else { l.flags | WIN_MINIMIZED }
		t := fwid(u.font, title); lb ~= Rect{hd.x + s.window.header.padding.x + s.window.header.label_padding.x, hd.y + s.window.header.label_padding.y, 0.0, fh + 2.0 * s.window.header.label_padding.y}
		lb.w = t + 2.0 * s.window.header.spacing.x; lb.w = mx(mn(lb.w, hd.x + hd.w - lb.x), 0.0)
		widget_text(u, w, lb, title, v2(0.0, 0.0), tbg, tc, 17, u.font)
	if l.flags & WIN_MINIMIZED == 0 && l.flags & WIN_DYNAMIC == 0:
		bd := Rect{wn.bounds.x, wn.bounds.y + l.header_height, wn.bounds.w, wn.bounds.h - l.header_height}
		fb := s.window.fixed_background
		if fb.kind == STYLE_ITEM_IMAGE: draw_image_b(u, w, bd, fb.img, Color{255, 255, 255, 255})
		else if fb.kind == STYLE_ITEM_NINE_SLICE: draw_nine_slice_b(u, w, bd, NineSlice{fb.img, fb.l, fb.t, fb.r, fb.b}, Color{255, 255, 255, 255})
		else: fill_rect_b(u, w, bd, s.window.rounding, fb.color)
	l.clip = l.bounds; cl := unify(wn.buf.clip, l.clip.x, l.clip.y, l.clip.x + l.clip.w, l.clip.y + l.clip.h)
	push_scissor_b(u, w, cl); u.ps[pi].clip = cl
	u.ps[pi].flags & WIN_HIDDEN == 0 && u.ps[pi].flags & WIN_MINIMIZED == 0
NO_INPUT_U u32 := 1024
panel_end(u UC&):
	if u.current < 0 || u.ws[u.current].lay < 0: return
	w := u.current; pi := u.ws[w].lay; let s .= u.st
	hin := u.ps[pi].flags & (WIN_ROM | NO_INPUT_U) == 0
	if !is_sub(u.ps[pi].ty): push_scissor_b(u, w, NULL_RECT)
	sbs := s.window.scrollbar_size; pp := pan_padding(s, u.ps[pi].ty)
	let l .= u.ps[pi]; let wn .= u.ws[w]
	l.at_y += l.row.height
	if l.flags & WIN_DYNAMIC != 0 && l.flags & WIN_MINIMIZED == 0:
		if l.at_y < l.bounds.y + l.bounds.h: l.bounds.h = l.at_y - l.bounds.y
		fill_rect_b(u, w, Rect{wn.bounds.x, l.bounds.y, wn.bounds.w, pp.y}, 0.0, s.window.background)
		fill_rect_b(u, w, Rect{wn.bounds.x, l.bounds.y, pp.x + l.border, l.bounds.h}, 0.0, s.window.background)
		es ~= Rect{l.bounds.x + l.bounds.w, l.bounds.y, pp.x + l.border, l.bounds.h}
		if pget(u, l.oy) == 0 && l.flags & 32 == 0: es.w += sbs.x
		fill_rect_b(u, w, es, 0.0, s.window.background)
		if l.footer_height > 0.0: fill_rect_b(u, w, Rect{wn.bounds.x, l.bounds.y + l.bounds.h, wn.bounds.w, l.footer_height}, 0.0, s.window.background)
	if l.flags & 32 == 0 && l.flags & WIN_MINIMIZED == 0 && wn.sht < 4.0: panel_scrollbars(u, w, pi, hin, sbs, pp)
	if wn.flags & 128 != 0:
		hi := i_moved(u.inp) || u.inp.sd.y != 0.0; wh := win_is_hovered(u); aa := u.lws & 2 != 0
		if !hi && wh || !wh && !aa: wn.sht += u.dt
		else: wn.sht = 0.0
	else: wn.sht = 0.0
	if l.flags & 1 != 0:
		bc := pan_border_color(s, l.ty)
		py := if l.flags & WIN_MINIMIZED != 0 { s.window.border + wn.bounds.y + l.header_height } else if l.flags & WIN_DYNAMIC != 0 { l.bounds.y + l.bounds.h + l.footer_height } else { wn.bounds.y + wn.bounds.h }
		b ~= wn.bounds; b.h = py - wn.bounds.y
		stroke_rect_b(u, w, b, s.window.rounding, l.border, bc)
	if l.flags & 4 != 0 && hin && l.flags & WIN_MINIMIZED == 0: panel_scaler(u, w, pi, sbs, pp)
	if !is_sub(l.ty):
		if l.flags & WIN_HIDDEN != 0: wn.buf.begin = 0; wn.buf.end = 0; wn.buf.last = 0; wn.buf.clip = NULL_RECT
