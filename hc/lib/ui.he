sch(s const byte[:], i int) int: if i < s.len { (if s[i] >= 128 { s[i] as int - 256 } else { s[i] as int }) } else { 0 }
recursive sm_here(r const byte[:], ri int, t const byte[:], ti int) bool:
	c := sch(r, ri)
	if c == 0: return true
	if sch(r, ri + 1) == '*': return sm_star(c, r, ri + 2, t, ti)
	if c == '$' && sch(r, ri + 1) == 0: return sch(t, ti) == 0
	sch(t, ti) != 0 && (c == '.' || c == sch(t, ti)) && sm_here(r, ri + 1, t, ti + 1)
recursive sm_star(c int, r const byte[:], ri int, t const byte[:], ti0 int) bool:
	ti ~= ti0
	while true:
		if sm_here(r, ri, t, ti): return true
		x := sch(t, ti)
