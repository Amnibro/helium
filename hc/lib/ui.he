strmatch_fuzzy_text_into(text const byte[:], pattern const byte[:], score int&) bool:
	n := tlen(text, "ui::strmatch_fuzzy_text"); st := asc_lower(text[..n]); pt := asc_lower(cstr(pattern)); score = 0
	if n == 0: return false
	sc ~= 0; pi ~= 0; pm ~= false; ps ~= true; bl ~= -1; bls ~= 0
	for si n:
		pc := sch(pt, pi); c := sch(st, si); nm := pc != 0 && fz_lo(pc) == fz_lo(c); rm := bl >= 0 && fz_up(sch(st, bl)) == fz_up(c)
