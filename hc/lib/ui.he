PAN_COMBO u32 := 32
PAN_MENU u32 := 64
PAN_TOOLTIP u32 := 128
PAN_NONBLOCK u32 := 240
PAN_SUB u32 := 246
SC_WINDOW := 0
SC_GROUP := 1
SC_GROUP_SCROLLED := 2
SC_LIST_VIEW := 3
SC_POPUP := 4
SC_COMBO := 5
SC_CONTEXTUAL := 6
SC_MENU := 7
SC_TOOLTIP := 8
SC_MENUBAR := 9
SC_TREE := 10
SC_TREE_STATE := 11
SC_TREE_ELEMENT := 12
SC_CHART := 13
SC_ROW := 14
SC_TEMPLATE := 15
SC_SPACE := 16
SC_DISABLED := 17
SCOPE_NAMES := ["window", "group", "scrolled group", "list view", "popup", "combo box", "contextual menu", "menu", "tooltip", "menu bar", "tree node", "tree node", "tree element", "chart", "layout row", "row template", "layout space", "disabled run of widgets"]
SCOPE_ENDS := ["ui::end", "ui::group_end", "ui::group_scrolled_end", "ui::list_view_end", "ui::popup_end", "ui::combo_end", "ui::contextual_end", "ui::menu_end", "ui::tooltip_end", "ui::menubar_end", "ui::tree_pop", "ui::tree_state_pop", "ui::tree_element_pop", "ui::chart_end", "ui::layout_row_end", "ui::layout_row_template_end", "ui::layout_space_end", "ui::widget_disable_end"]
NULL_RECT := Rect{-8192.0, -8192.0, 16384.0, 16384.0}
struct MB { down bool, clicked u32, pos float2 }
struct KY { down bool, clicked u32 }
struct Inp { mb MB[6], pos float2, prev float2, delta float2, sd float2, grab bool, grabbed bool, ungrab bool, keys KY[30], text byte[256], tl int }
struct CB { begin int, end int, last int, clip Rect, uc bool }
struct PB { begin int, parent int, last int, end int, active bool }
struct Pop { win int = -1, ty u32, buf PB, name u32, active bool, combo_count u32, con_count u32, con_old u32, active_con u32, header Rect }
struct Ed { name u32, seq u32, old u32, active i32, prev i32, cursor i32, sel_start i32, sel_end i32, sx u32, sy u32, mode byte, single_line byte }
struct Prop { active i32, prev i32, buffer byte[64], length i32, cursor i32, select_start i32, select_end i32, name u32, seq u32, old u32, state i32, prev_state i32, prev_name u32, prev_buffer byte[64], prev_length i32 }
struct Ptr { k int, a int, b int }
struct Row { ty i32, index i32, height f32, min_height f32, columns i32, ratio int = -1, item_width f32, item_height f32, item_offset f32, filled f32, item Rect, tree_depth i32, templates f32[16] }
struct Menu { x f32, y f32, w f32, h f32, sx u32, sy u32 }
struct Pan { ty u32, flags u32, bounds Rect, ox Ptr, oy Ptr, at_x f32, at_y f32, max_x f32, footer_height f32, header_height f32, border f32, has_scrolling u32, clip Rect, menu Menu, row Row, chart Chart, parent int = -1 }
struct Tbl { seq u32, size u32, keys u32[>..], values u32[>..], next int = -1, prev int = -1 }
struct Win { seq u32, name u32, ns byte[>..], flags u32, bounds Rect, sx u32, sy u32, buf CB, lay int = -1, sht f32, prop Prop, pop Pop, ed Ed, scrolled u32, wdis bool, tables int = -1, tcount u32, next int = -1, prev int = -1, parent int = -1 }
struct Cm { c Command, nx int }
struct Scope { kind int, open bool, by byte[>..], sx u32, sy u32, view ListView, lv_sv u32, lv_ptr Ptr, lv_th int }
struct UC { id u32, atlas u32, owns bool, scale f32, sc Scope[>..], in_input bool, drawn bool, converted bool, vx Vertex[>..], ixs u32[>..], dc DrawCommand[>..], ratios f32[>..], paste byte[>..], copy byte[>..], copied bool, cursors Cursor[7], styles Style[>..], inp Inp, st Style, font u32, curs int[7], cact int, cvis bool, dt f32, seq u32, build bool, lws u32, bb i32, fstk u32[>..], bbstk i32[>..], begin int, end int, active int, current int, count u32, ov CB, ws Win[>..], wfree int[>..], ps Pan[>..], pfree int[>..], ts Tbl[>..], tfree int[>..], cm Cm[>..], pt int2[>..], tx byte[>..], te TE }
var TCTX = gfx::Tab{[], [], [], []}
var CT UC[>..] = []
mx(a f32, b f32) f32: if a < b { b } else { a }
mn(a f32, b f32) f32: if a < b { a } else { b }
s16(f f32) i32: (f as! i16) as i32
us16(f f32) i32: (f as! u16) as i32
btw(x f32, a f32, b f32) bool: a <= x && x < b
inbox(px f32, py f32, r Rect) bool: btw(px, r.x, r.x + r.w) && btw(py, r.y, r.y + r.h)
isect(x0 f32, y0 f32, w0 f32, h0 f32, r Rect) bool: r.x < x0 + w0 && x0 < r.x + r.w && r.y < y0 + h0 && y0 < r.y + r.h
risect(a Rect, r Rect) bool: isect(a.x, a.y, a.w, a.h, r)
shrink(r0 Rect, a f32) Rect: w := mx(r0.w, 2.0 * a); h := mx(r0.h, 2.0 * a); Rect{r0.x + a, r0.y + a, w - 2.0 * a, h - 2.0 * a}
padr(r0 Rect, p float2) Rect: w := mx(r0.w, 2.0 * p.x); h := mx(r0.h, 2.0 * p.y); Rect{r0.x + p.x, r0.y + p.y, w - 2.0 * p.x, h - 2.0 * p.y}
unify(a Rect, x0 f32, y0 f32, x1 f32, y1 f32) Rect: x := mx(a.x, x0); y := mx(a.y, y0); Rect{x, y, mx(0.0, mn(a.x + a.w, x1) - x), mx(0.0, mn(a.y + a.h, y1) - y)}
cstr(s const byte[:]) const byte[:]:
	for c, i s: if c == 0 { return s[..i] }
	s
MC1 u32 := 0xcc9e2d51
MC2 u32 := 0x1b873593
MC3 u32 := 0xe6546b64
MC4 u32 := 0x85ebca6b
MC5 u32 := 0xc2b2ae35
rotl(x u32, r int) u32: (x << r) | (x >> (32 - r))
murmur(key const byte[:], seed u32) u32:
	h u32 ~= seed; nb := key.len / 4
	for i nb:
		k u32 ~= (key[i * 4] as u32) | ((key[i * 4 + 1] as u32) << 8) | ((key[i * 4 + 2] as u32) << 16) | ((key[i * 4 + 3] as u32) << 24)
		k *= MC1; k = rotl(k, 15); k *= MC2; h ^= k; h = rotl(h, 13); h = h * (5 as u32) + MC3
	t := nb * 4; r := key.len & 3; k u32 ~= 0
	if r == 3: k ^= (key[t + 2] as u32) << 16
	if r >= 2: k ^= (key[t + 1] as u32) << 8
	if r >= 1: k ^= key[t] as u32; k *= MC1; k = rotl(k, 15); k *= MC2; h ^= k
	h ^= key.len as! u32; h ^= h >> 16; h *= MC4; h ^= h >> 13; h *= MC5; h ^= h >> 16; h
stricmpn(a const byte[:], b const byte[:], n0 int) int:
	n ~= n0; i ~= 0
	loop:
		c1 := if i < a.len { a[i] as int } else { 0 }; c2 := if i < b.len { b[i] as int } else { 0 }; i += 1
		if n == 0: return 0
		n -= 1; d ~= c1 - c2
		while d != 0:
			if c1 <= 'Z' && c1 >= 'A': d += 32; if d == 0 { break }
			if c2 <= 'Z' && c2 >= 'A': d -= 32; if d == 0 { break }
			return if d >= 0 { 1 } else { -1 }
		if c1 == 0: return 0
	0
fidx(fid u32) int: gfx::tfind(TFNT, fid)
fht(fid u32) f32: k := fidx(fid); ATL[gfx::ix(FNT[k].atl)].af[FNT[k].fi].hh
fwid(fid u32, t const byte[:]) f32: k := fidx(fid); let a .= ATL[gfx::ix(FNT[k].atl)]; let f .= a.af[FNT[k].fi]; nk_text_width(a, f, f.hh, t)
text_clamp(fid u32, t const byte[:], space f32, glyphs int&, twid f32&, seps const u32[:]) int:
	lw ~= 0.0 as f32; u ~= 0; w ~= 0.0 as f32; ln ~= 0; g ~= 0; sl ~= 0; sg ~= 0; sw ~= 0.0 as f32
	gl ~= utf_decode(t, 0, t.len, u)
	while gl != 0 && w < space && ln < t.len:
		ln += gl; s := fwid(fid, t[..ln]); hit ~= false
		for sp seps: if !hit && u as u32 == sp { sw = w; lw = w; sg = g + 1; sl = ln; hit = true }
		if !hit: lw = w; sw = w; sg = g + 1
		w = s; gl = utf_decode(t, ln, t.len - ln, u); g += 1
	if ln >= t.len: glyphs = g; twid = lw; return ln
	glyphs = sg; twid = sw; if sl == 0 { ln } else { sl }
ctx_get(c Context, fw const byte[:]) int: if TCTX.what.len == 0 { gfx::tclear(TCTX, "context") } tg(TCTX, c.id, fw)
top_scope(u UC&) int: u.sc.len - 1
push_scope(u UC&, kind int, open bool, fw const byte[:]) bool:
	if u.sc.len == 64: return misuse(str(fw, ": 64 things begun and not yet ended"))
	u.sc.push(Scope{kind, open, str(fw), 0, 0, ListView{0, 0, 0}, 0, Ptr{0, 0, 0}, 0}); true
expect_scope(u UC&, kind int, fw const byte[:]) bool:
	s := top_scope(u); if s >= 0 && u.sc[s].kind == kind: return true
	open ~= false; for x u.sc { open = open || x.kind == kind }
	if !open: return misuse(str(fw, " with no ", SCOPE_NAMES[kind], " begun"))
	misuse(str(fw, ": the ", SCOPE_NAMES[u.sc[s].kind], " begun by ", u.sc[s].by, " is still open, and ", SCOPE_ENDS[u.sc[s].kind], " ends it"))
pop_scope(u UC&): if u.sc.len > 0 { u.sc.pop() }
outside(u UC&, fw const byte[:]) bool:
	if u.in_input: return misuse(str(fw, " between ui::input_begin and ui::input_end"))
	s := top_scope(u); if s >= 0: return misuse(str(fw, " while the ", SCOPE_NAMES[u.sc[s].kind], " begun by ", u.sc[s].by, " is open (", SCOPE_ENDS[u.sc[s].kind], " ends it)"))
	true
in_input(u UC&, fw const byte[:]) bool: u.in_input || misuse(str(fw, " outside input: input goes between ui::input_begin and ui::input_end"))
panel_scope(u UC&) int:
	i ~= u.sc.len - 1
	while i >= 0: if u.sc[i].kind <= SC_TOOLTIP { return i } i -= 1
	-1
in_window(u UC&, fw const byte[:]) bool:
	if u.in_input: return misuse(str(fw, " between ui::input_begin and ui::input_end"))
	if panel_scope(u) < 0 || u.current < 0: return misuse(str(fw, " outside a window: it goes between ui::begin and ui::end"))
	true
in_panel(u UC&, fw const byte[:]) bool:
	if !in_window(u, fw): return false
	p := panel_scope(u)
	if !u.sc[p].open || u.ws[u.current].lay < 0: return misuse(str(fw, " in a window that is not open: ui::begin returned false, so only ui::end may follow"))
	if u.sc[top_scope(u)].kind == SC_TEMPLATE: return misuse(str(fw, " inside a row template: ui::layout_row_template_end ends it first"))
	true
popup_allowed(u UC&, fw const byte[:]) bool:
	p := panel_scope(u)
	if p >= 0 && u.sc[p].kind >= SC_POPUP && u.sc[p].kind <= SC_TOOLTIP: return misuse(str(fw, " inside the ", SCOPE_NAMES[u.sc[p].kind], " begun by ", u.sc[p].by, ": popups, combo boxes, menus and tooltips cannot open inside one another"))
	true
win_current(u UC&, w int) bool: !u.drawn || u.ws[w].seq == u.seq
iclamp(v int) int: if v < -2147483648 { -2147483648 } else if v > 2147483647 { 2147483647 } else { v }
enum_ok(v int, n int, fw const byte[:], what const byte[:]) bool: v >= 0 && v < n || misuse(str(fw, ": ", v, " is not one of the ", what, " constants"))
symbol_ok(s int, fw const byte[:]) bool: enum_ok(s, 22, fw, "SYMBOL_*")
button_ok(b int, fw const byte[:]) bool: enum_ok(b, 6, fw, "BUTTON_* mouse button")
key_ok(k int, fw const byte[:]) bool: enum_ok(k, 30, fw, "KEY_*")
tlen(t const byte[:], fw const byte[:]) int:
	if t.len <= 0x3FFFFFFF: return t.len
	misuse(str(fw, ": a string of ", t.len, " bytes")); 0
nk_input_begin(u UC&):
	let i .= u.inp
	for b 6: i.mb[b].clicked = 0
	i.tl = 0; i.sd = float2{0.0, 0.0}; i.prev = i.pos; i.delta = float2{0.0, 0.0}
	for k 30: i.keys[k].clicked = 0
nk_input_end(u UC&):
	let i .= u.inp
	if i.grab: i.grab = false
	if i.ungrab: i.grabbed = false; i.ungrab = false; i.grab = false
utf_encode(cp u32, out byte[>..]&):
	c := if cp >= 0x10FFFF || cp >= 0xD800 && cp < 0xDFFF { 0xFFFD as u32 } else { cp }
	if c <= 0x7F: out.push(c as byte); return
	if c <= 0x7FF: out.push((0xC0 | (c >> 6)) as byte); out.push((0x80 | (c & 0x3F)) as byte); return
	if c <= 0xFFFF: out.push((0xE0 | (c >> 12)) as byte); out.push((0x80 | ((c >> 6) & 0x3F)) as byte); out.push((0x80 | (c & 0x3F)) as byte); return
	out.push((0xF0 | (c >> 18)) as byte); out.push((0x80 | ((c >> 12) & 0x3F)) as byte); out.push((0x80 | ((c >> 6) & 0x3F)) as byte); out.push((0x80 | (c & 0x3F)) as byte)
nk_input_glyph(u UC&, g const byte[:]):
	let i .= u.inp; cp ~= 0; ln := utf_decode(g, 0, 4, cp)
	if ln != 0 && i.tl + ln < 256:
		e byte[>..] ~= []; utf_encode(cp as u32, e)
		if e.len <= 256 - i.tl: for k e.len { i.text[i.tl + k] = e[k] }
		i.tl += ln
input_begin_raw(c Context):
	k := ctx_get(c, "ui::input_begin"); if k < 0: return
	let u .= CT[k]
	if u.in_input: misuse("ui::input_begin twice, without ui::input_end"); return
	if !outside(u, "ui::input_begin"): return
	if u.drawn: end_frame(u)
	nk_input_begin(u); u.in_input = true
inp_ctx(c Context, fw const byte[:]) int:
	k := ctx_get(c, fw); if k < 0: return -1
	if !in_input(CT[k], fw): return -1
	k
input_motion(c Context, x int, y int):
	k := inp_ctx(c, "ui::input_motion"); if k < 0: return
	let u .= CT[k]; let i .= u.inp
	i.pos = float2{x as f32 / u.scale, y as f32 / u.scale}; i.delta = float2{i.pos.x - i.prev.x, i.pos.y - i.prev.y}
input_key(c Context, key int, down bool):
	k := inp_ctx(c, "ui::input_key"); if k < 0: return
	if key_ok(key, "ui::input_key"): let y .= CT[k].inp.keys[key]; y.clicked += 1; y.down = down
input_button(c Context, button int, x int, y int, down bool):
	k := inp_ctx(c, "ui::input_button"); if k < 0: return
	if !button_ok(button, "ui::input_button"): return
	let u .= CT[k]; let b .= u.inp.mb[button]
	if b.down == down: return
	b.pos = float2{x as f32 / u.scale, y as f32 / u.scale}; b.down = down; b.clicked += 1; u.inp.delta = float2{0.0, 0.0}
input_scroll(c Context, amount float2):
	k := inp_ctx(c, "ui::input_scroll"); if k < 0: return
	if !fin(amount.x) || !fin(amount.y): misuse(str("ui::input_scroll: a scroll of ", pg(amount.x as real), ", ", pg(amount.y as real))); return
	let i .= CT[k].inp; i.sd = float2{i.sd.x + amount.x, i.sd.y + amount.y}
input_char(c Context, ch byte):
	k := inp_ctx(c, "ui::input_char"); if k < 0: return
	nk_input_glyph(CT[k], [ch, 0, 0, 0])
input_glyph(c Context, utf8 const byte[:]):
	k := inp_ctx(c, "ui::input_glyph"); if k < 0: return
	if utf8.len < 1 || utf8.len > 4: misuse(str("ui::input_glyph: ", utf8.len, " bytes, where a glyph is 1 to 4")); return
	g byte[4] ~= [0; 4]; for b, j utf8 { g[j] = b }
	nk_input_glyph(CT[k], g[..])
input_unicode(c Context, rune u32):
	k := inp_ctx(c, "ui::input_unicode"); if k < 0: return
	e byte[>..] ~= []; utf_encode(rune, e); while e.len < 4 { e.push(0) }
	nk_input_glyph(CT[k], e[..])
input_end(c Context):
	k := inp_ctx(c, "ui::input_end"); if k < 0: return
	nk_input_end(CT[k]); CT[k].in_input = false
input_mouse(c Context) Mouse:
	k := ctx_get(c, "ui::input_mouse"); if k < 0: return Mouse{..}
	let i .= CT[k].inp; Mouse{i.pos, i.prev, i.delta, i.sd, i.grab, i.grabbed, i.ungrab}
i_click(i Inp&, b int) bool: i.mb[b].clicked != 0 && !i.mb[b].down
i_click_in(i Inp&, b int, r Rect) bool: inbox(i.mb[b].pos.x, i.mb[b].pos.y, r)
i_click_down_in(i Inp&, b int, r Rect, down bool) bool: i_click_in(i, b, r) && i.mb[b].down == down
i_is_click_in(i Inp&, b int, r Rect) bool: i_click_down_in(i, b, r, false) && i.mb[b].clicked != 0
i_is_click_down_in(i Inp&, b int, r Rect, down bool) bool: i_click_down_in(i, b, r, down) && i.mb[b].clicked != 0
i_any_click_in(i Inp&, r Rect) bool:
	d ~= false; for b 6 { d = d || i_is_click_in(i, b, r) }
	d
i_hover(i Inp&, r Rect) bool: inbox(i.pos.x, i.pos.y, r)
i_prev_hover(i Inp&, r Rect) bool: inbox(i.prev.x, i.prev.y, r)
i_moved(i Inp&) bool: i.delta.x != 0.0 || i.delta.y != 0.0
i_hover_still(i Inp&, r Rect) bool: i_hover(i, r) && !i_moved(i)
i_mouse_clicked(i Inp&, b int, r Rect) bool: i_hover(i, r) && i_is_click_in(i, b, r)
i_down(i Inp&, b int) bool: i.mb[b].down
i_pressed(i Inp&, b int) bool: i.mb[b].down && i.mb[b].clicked != 0
i_released(i Inp&, b int) bool: !i.mb[b].down && i.mb[b].clicked != 0
i_key_pressed(i Inp&, k int) bool: let y .= i.keys[k]; y.down && y.clicked != 0 || !y.down && y.clicked >= 2
i_key_released(i Inp&, k int) bool: let y .= i.keys[k]; !y.down && y.clicked != 0 || y.down && y.clicked >= 2
q_ctx(c Context, fw const byte[:]) int: ctx_get(c, fw)
input_has_mouse_click(c Context, button int) bool: k := q_ctx(c, "ui::input_has_mouse_click"); k >= 0 && button_ok(button, "ui::input_has_mouse_click") && i_click(CT[k].inp, button)
input_has_mouse_click_in_rect(c Context, button int, r Rect) bool: k := q_ctx(c, "ui::input_has_mouse_click_in_rect"); k >= 0 && button_ok(button, "ui::input_has_mouse_click_in_rect") && i_click_in(CT[k].inp, button, r)
input_has_mouse_click_in_button_rect(c Context, button int, r Rect) bool: k := q_ctx(c, "ui::input_has_mouse_click_in_button_rect"); k >= 0 && button_ok(button, "ui::input_has_mouse_click_in_button_rect") && i_click_in(CT[k].inp, button, r)
input_has_mouse_click_down_in_rect(c Context, button int, r Rect, down bool) bool: k := q_ctx(c, "ui::input_has_mouse_click_down_in_rect"); k >= 0 && button_ok(button, "ui::input_has_mouse_click_down_in_rect") && i_click_down_in(CT[k].inp, button, r, down)
input_is_mouse_click_in_rect(c Context, button int, r Rect) bool: k := q_ctx(c, "ui::input_is_mouse_click_in_rect"); k >= 0 && button_ok(button, "ui::input_is_mouse_click_in_rect") && i_is_click_in(CT[k].inp, button, r)
input_is_mouse_click_down_in_rect(c Context, button int, r Rect, down bool) bool: k := q_ctx(c, "ui::input_is_mouse_click_down_in_rect"); k >= 0 && button_ok(button, "ui::input_is_mouse_click_down_in_rect") && i_is_click_down_in(CT[k].inp, button, r, down)
input_any_mouse_click_in_rect(c Context, r Rect) bool: k := q_ctx(c, "ui::input_any_mouse_click_in_rect"); k >= 0 && i_any_click_in(CT[k].inp, r)
input_is_mouse_prev_hovering_rect(c Context, r Rect) bool: k := q_ctx(c, "ui::input_is_mouse_prev_hovering_rect"); k >= 0 && i_prev_hover(CT[k].inp, r)
input_is_mouse_hovering_rect(c Context, r Rect) bool: k := q_ctx(c, "ui::input_is_mouse_hovering_rect"); k >= 0 && i_hover(CT[k].inp, r)
input_is_mouse_hovering_still_rect(c Context, r Rect) bool: k := q_ctx(c, "ui::input_is_mouse_hovering_still_rect"); k >= 0 && i_hover_still(CT[k].inp, r)
timer_ok(t f32, d f32, fw const byte[:]) bool: fin(t) && fin(d) || misuse(str(fw, ": a timer of ", pg(t as real), " with a delay of ", pg(d as real)))
hover_delay(u UC&, r Rect, t f32&, d f32) bool:
	let i .= u.inp
	if i_hover(i, r): t += u.dt; return t >= d
	if i_prev_hover(i, r): t = 0.0
	false
hover_still_delay(u UC&, r Rect, t f32&, d f32) bool:
	let i .= u.inp
	if i_hover(i, r):
		if t >= d: return true
		if !i_moved(i): t += u.dt; return t >= d
		t = 0.0
	else if i_prev_hover(i, r): t = 0.0
	false
input_is_mouse_hovering_delay_rect(c Context, r Rect, timer f32&, delay f32) bool: k := ctx_get(c, "ui::input_is_mouse_hovering_delay_rect"); k >= 0 && timer_ok(timer, delay, "ui::input_is_mouse_hovering_delay_rect") && hover_delay(CT[k], r, timer, delay)
input_is_mouse_hovering_still_delay_rect(c Context, r Rect, timer f32&, delay f32) bool: k := ctx_get(c, "ui::input_is_mouse_hovering_still_delay_rect"); k >= 0 && timer_ok(timer, delay, "ui::input_is_mouse_hovering_still_delay_rect") && hover_still_delay(CT[k], r, timer, delay)
input_is_mouse_hovering_still_delay_clicked_rect(c Context, r Rect, timer f32&, delay f32, clicked bool&) bool:
	fw := "ui::input_is_mouse_hovering_still_delay_clicked_rect"; k := ctx_get(c, fw); if k < 0 || !timer_ok(timer, delay, fw): return false
	if clicked:
		if !i_moved(CT[k].inp): return false
		clicked = false; timer = 0.0
	hover_still_delay(CT[k], r, timer, delay)
input_is_mouse_moved(c Context) bool: k := q_ctx(c, "ui::input_is_mouse_moved"); k >= 0 && i_moved(CT[k].inp)
input_mouse_clicked(c Context, button int, r Rect) bool: k := q_ctx(c, "ui::input_mouse_clicked"); k >= 0 && button_ok(button, "ui::input_mouse_clicked") && i_mouse_clicked(CT[k].inp, button, r)
input_is_mouse_down(c Context, button int) bool: k := q_ctx(c, "ui::input_is_mouse_down"); k >= 0 && button_ok(button, "ui::input_is_mouse_down") && i_down(CT[k].inp, button)
input_is_mouse_pressed(c Context, button int) bool: k := q_ctx(c, "ui::input_is_mouse_pressed"); k >= 0 && button_ok(button, "ui::input_is_mouse_pressed") && i_pressed(CT[k].inp, button)
input_is_mouse_released(c Context, button int) bool: k := q_ctx(c, "ui::input_is_mouse_released"); k >= 0 && button_ok(button, "ui::input_is_mouse_released") && i_released(CT[k].inp, button)
input_is_key_pressed(c Context, key int) bool: k := q_ctx(c, "ui::input_is_key_pressed"); k >= 0 && key_ok(key, "ui::input_is_key_pressed") && i_key_pressed(CT[k].inp, key)
input_is_key_released(c Context, key int) bool: k := q_ctx(c, "ui::input_is_key_released"); k >= 0 && key_ok(key, "ui::input_is_key_released") && i_key_released(CT[k].inp, key)
input_is_key_down(c Context, key int) bool: k := q_ctx(c, "ui::input_is_key_down"); k >= 0 && key_ok(key, "ui::input_is_key_down") && CT[k].inp.keys[key].down
DEFAULT_COLORS := [Color{175, 175, 175, 255}, Color{45, 45, 45, 255}, Color{40, 40, 40, 255}, Color{65, 65, 65, 255}, Color{50, 50, 50, 255}, Color{40, 40, 40, 255}, Color{35, 35, 35, 255}, Color{100, 100, 100, 255}, Color{120, 120, 120, 255}, Color{45, 45, 45, 255}, Color{45, 45, 45, 255}, Color{35, 35, 35, 255}, Color{38, 38, 38, 255}, Color{100, 100, 100, 255}, Color{120, 120, 120, 255}, Color{150, 150, 150, 255}, Color{38, 38, 38, 255}, Color{38, 38, 38, 255}, Color{175, 175, 175, 255}, Color{45, 45, 45, 255}, Color{120, 120, 120, 255}, Color{45, 45, 45, 255}, Color{255, 0, 0, 255}, Color{40, 40, 40, 255}, Color{100, 100, 100, 255}, Color{120, 120, 120, 255}, Color{150, 150, 150, 255}, Color{40, 40, 40, 255}, Color{38, 38, 38, 255}, Color{100, 100, 100, 255}, Color{120, 120, 120, 255}, Color{150, 150, 150, 255}]
COLOR_NAMES := ["NK_COLOR_TEXT", "NK_COLOR_WINDOW", "NK_COLOR_HEADER", "NK_COLOR_BORDER", "NK_COLOR_BUTTON", "NK_COLOR_BUTTON_HOVER", "NK_COLOR_BUTTON_ACTIVE", "NK_COLOR_TOGGLE", "NK_COLOR_TOGGLE_HOVER", "NK_COLOR_TOGGLE_CURSOR", "NK_COLOR_SELECT", "NK_COLOR_SELECT_ACTIVE", "NK_COLOR_SLIDER", "NK_COLOR_SLIDER_CURSOR", "NK_COLOR_SLIDER_CURSOR_HOVER", "NK_COLOR_SLIDER_CURSOR_ACTIVE", "NK_COLOR_PROPERTY", "NK_COLOR_EDIT", "NK_COLOR_EDIT_CURSOR", "NK_COLOR_COMBO", "NK_COLOR_CHART", "NK_COLOR_CHART_COLOR", "NK_COLOR_CHART_COLOR_HIGHLIGHT", "NK_COLOR_SCROLLBAR", "NK_COLOR_SCROLLBAR_CURSOR", "NK_COLOR_SCROLLBAR_CURSOR_HOVER", "NK_COLOR_SCROLLBAR_CURSOR_ACTIVE", "NK_COLOR_TAB_HEADER", "NK_COLOR_KNOB", "NK_COLOR_KNOB_CURSOR", "NK_COLOR_KNOB_CURSOR_HOVER", "NK_COLOR_KNOB_CURSOR_ACTIVE"]
