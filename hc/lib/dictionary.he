# dictionary: a hash map from K to V.
# Open addressing with linear probing over a power-of-two table, kept as three
# parallel arrays (keys, vals, states) so a probe walks the one-byte states and
# only touches a key on a live slot. A slot's state is 0 (never used),
# 1 (holds an entry) or 2 (entry removed). The table grows when live plus
# removed slots would pass three quarters of it, so a probe always meets a
# never-used slot.
use std

struct dictionary_slot<K, V> { key K, val V, state byte }
struct dictionary<K, V> { count int = 0, removed int = 0, keys K[>..<] = [], vals V[>..<] = [], states byte[>..<] = [] }

# slot index holding key, or -1
probe<K, V>(d dictionary<K, V>&, key K) int:
	n := d.states.len
	if n == 0: return -1
	mask := n - 1
	at ~= (hash(key) & mask as uint) as int
	while true:
		st := d.states[at]
		if st == 0: return -1
		if st == 1 && d.keys[at] == key: return at
		at = (at + 1) & mask
	-1

rehash<K, V>(d dictionary<K, V>&, size int):
	ok K[>..] ~= []; ov V[>..] ~= []
	for st, i d.states: if st == 1 { ok.push(d.keys[i]); ov.push(d.vals[i]) }
	d.keys.clear(); d.vals.clear(); d.states.clear()
	d.keys.resize(size, default<K>()); d.vals.resize(size, default<V>()); d.states.resize(size, 0)
	d.count = 0
	d.removed = 0
	mask := size - 1
	for k, j ok:
		at ~= (hash(k) & mask as uint) as int
		while d.states[at] != 0: at = (at + 1) & mask
		d.keys[at] = k; d.vals[at] = ov[j]; d.states[at] = 1
		d.count += 1

# index of key's slot, adding key with value v0 when absent; true when added.
# One probe: remembers the first removed slot on the way to the never-used one.
place<K, V>(d dictionary<K, V>&, key K, v0 V) int, bool:
	n := d.states.len
	h := hash(key)
	at ~= -1
	if n > 0:
		mask := n - 1
		i ~= (h & mask as uint) as int
		while true:
			st := d.states[i]
			if st == 0: break
			if st == 1:
				if d.keys[i] == key: return i, false
			else:
				if at < 0: at = i
			i = (i + 1) & mask
		if at < 0: at = i
	if (d.count + d.removed + 1) * 4 > n * 3:
		rehash(d, max(16, next_pow2(d.count * 2 + 2)))
		mask := d.states.len - 1
		at = (h & mask as uint) as int
		while d.states[at] == 1: at = (at + 1) & mask
	if d.states[at] == 2: d.removed -= 1
	d.keys[at] = key; d.vals[at] = v0; d.states[at] = 1
	d.count += 1
	return at, true

get<K, V>(d dictionary<K, V>&, key K) V?:
	i := probe(d, key)
	if i < 0: return null
	return d.vals[i]
get<K, V>(d dictionary<K, V>&, key K, fallback V) V:
	i := probe(d, key)
	if i < 0 { fallback } else { d.vals[i] }
contains<K, V>(d dictionary<K, V>&, key K) bool: probe(d, key) >= 0
# sets key to val; true when key was new
insert<K, V>(d dictionary<K, V>&, key K, val V) bool:
	i, added := place(d, key, val)
	if !added: d.vals[i] = val
	added
get_or_insert<K, V>(d dictionary<K, V>&, key K, v0 V) V&:
	i, added := place(d, key, v0)
	return d.vals[i]
update<K, V, F>(d dictionary<K, V>&, key K, v0 V):
	i, added := place(d, key, v0)
	F(&d.vals[i])
# d[key]: the value for key, added as the default value when absent
dict_at<K, V>(d dictionary<K, V>&, key K) V&:
	i, added := place(d, key, default<V>())
	d.vals[i]
remove<K, V>(d dictionary<K, V>&, key K) bool:
	i := probe(d, key)
	if i < 0: return false
	d.states[i] = 2
	d.count -= 1
	d.removed += 1
	true
clear<K, V>(d dictionary<K, V>&):
	for &s d.states: s = 0
	d.count = 0
	d.removed = 0
reserve<K, V>(d dictionary<K, V>&, n int):
	size := max(16, next_pow2(n * 2))
	if size > d.states.len: rehash(d, size)
each<K, V, F>(d dictionary<K, V>&): for st, i d.states { if st == 1 { F(d.keys[i], &d.vals[i]) } }
keys<K, V>(d dictionary<K, V>&) K[>..]:
	o K[>..] ~= []
	for st, i d.states: if st == 1 { o.push(d.keys[i]) }
	o
values<K, V>(d dictionary<K, V>&) V[>..]:
	o V[>..] ~= []
	for st, i d.states: if st == 1 { o.push(d.vals[i]) }
	o
items<K, V>(d dictionary<K, V>&) dictionary_slot<K, V>[>..]:
	o dictionary_slot<K, V>[>..] ~= []
	for st, i d.states: if st == 1 { o.push(dictionary_slot<K, V>{d.keys[i], d.vals[i], 1}) }
	o
truthy<K, V>(d dictionary<K, V>&) bool: d.count > 0

# helpers the Python dialect lowers to
slot_lt<K, V>(a dictionary_slot<K, V>, b dictionary_slot<K, V>) bool:
	if a.key == b.key { a.val < b.val } else { a.key < b.key }
sorted<K, V>(xs dictionary_slot<K, V>[:]) dictionary_slot<K, V>[>..]:
	o dictionary_slot<K, V>[>..] ~= []
	o.append(xs)
	sort(o) { a, b => slot_lt(a, b) }
	o
set_add<K>(d dictionary<K, bool>&, k K): insert(d, k, true)
set<T>(xs T[:]) dictionary<T, bool>:
	d ~= dictionary<T, bool>{}
	for x in xs: insert(d, x, true)
	d
counter<T>(xs T[:]) dictionary<T, int>:
	d ~= dictionary<T, int>{}
	for x in xs: dict_at(d, x) += 1
	d
dict_from<K, V>(ks K[:], vs V[:]) dictionary<K, V>:
	d ~= dictionary<K, V>{}
	for i ks.len: insert(d, ks[i], vs[i])
	d
pyfmt<K, V>(s dictionary_slot<K, V>) byte[>..]: str("(", pyrepr(s.key), ", ", pyrepr(s.val), ")")
pyfmt<K, V>(d dictionary<K, V>&) byte[>..]:
	o byte[>..] ~= ['{']
	first ~= true
	for st, i d.states:
		if st == 1:
			if !first: o.append(", ")
			first = false
			o.append(pyrepr(d.keys[i])); o.append(": "); o.append(pyrepr(d.vals[i]))
	o.push('}')
	o
