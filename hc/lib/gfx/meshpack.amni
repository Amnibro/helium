import math;
namespace meshpack;
let CACHE = 16;
let CACHE_SCORE real[17] = [0.0, 0.779, 0.791, 0.789, 0.981, 0.843, 0.726, 0.847, 0.882, 0.867, 0.799, 0.642, 0.613, 0.600, 0.568, 0.372, 0.234];
let LIVE_SCORE real[9] = [0.0, 0.995, 0.713, 0.450, 0.404, 0.059, 0.005, 0.147, 0.006];
fn acmr(idx const int[:], cache int) real {
	let t = idx.len / 3;
	if t == 0 { return 0.0; }
	var nv = 0;
	for v in idx { nv = max(nv, v + 1); }
	var stamp int[>..] = [];
	stamp.resize(nv, -1000000000000);
	var misses = 0;
	for v in idx {
		if stamp[v] < misses - cache {
			stamp[v] = misses;
			misses++;
		}
	}
	(misses as real) / (t as real)
}
fn vscore(pos int, live int) real {
	CACHE_SCORE[pos + 1] + LIVE_SCORE[min(live, 8)]
}
fn cache_order(idx const int[:], nv int, out int[>..]&) {
	let t = idx.len / 3;
	if t == 0 { return; }
	var live int[>..] = [];
	live.resize(nv, 0);
	for i in t * 3 { live[idx[i]] += 1; }
	var first int[>..] = [];
	var sum = 0;
	for v in nv {
		first.push(sum);
		sum += live[v];
	}
	var filled int[>..] = [];
	filled.resize(nv, 0);
	var adj int[>..] = [];
	adj.resize(t * 3, 0);
	for i in t * 3 {
		let v = idx[i];
		adj[first[v] + filled[v]] = i / 3;
		filled[v] += 1;
	}
	var score real[>..] = [];
	for v in nv { score.push(vscore(-1, live[v])); }
	var tscore real[>..] = [];
	for i in t { tscore.push(score[idx[i * 3]] + score[idx[i * 3 + 1]] + score[idx[i * 3 + 2]]); }
	var emitted bool[>..] = [];
	emitted.resize(t, false);
	var cache int[20] = [0; 20];
	var fresh int[20] = [0; 20];
	var held = 0;
	var cursor = 1;
	var best = 0;
	while best >= 0 {
		let a = idx[best * 3];
		let b = idx[best * 3 + 1];
		let c = idx[best * 3 + 2];
		out.push(a);
		out.push(b);
		out.push(c);
		emitted[best] = true;
		tscore[best] = 0.0;
		fresh[0] = a;
		fresh[1] = b;
		fresh[2] = c;
		var w = 3;
		for i in held {
			let v = cache[i];
			if v != a && v != b && v != c {
				fresh[w] = v;
				w++;
			}
		}
		let tmp = cache;
		cache = fresh;
		fresh = tmp;
		held = min(w, CACHE);
		for k in 3 {
			let v = idx[best * 3 + k];
			let end = first[v] + live[v];
			for j in first[v]..end {
				if adj[j] == best {
					adj[j] = adj[end - 1];
					live[v] -= 1;
					break;
				}
			}
		}
		best = -1;
		var top = 0.0;
		for i in w {
			let v = cache[i];
			if live[v] == 0 { continue; }
			let ns = vscore(if i < CACHE { i } else { -1 }, live[v]);
			let diff = ns - score[v];
			score[v] = ns;
			for j in first[v]..first[v] + live[v] {
				let u = adj[j];
				tscore[u] += diff;
				if tscore[u] > top {
					best = u;
					top = tscore[u];
				}
			}
		}
		if best < 0 {
			while cursor < t && emitted[cursor] { cursor++; }
			if cursor < t { best = cursor; }
		}
	}
}
fn fetch_remap(idx const int[:], nv int, remap int[>..]&) int {
	remap.clear();
	remap.resize(nv, -1);
	var used = 0;
	for v in idx {
		if remap[v] < 0 {
			remap[v] = used;
			used++;
		}
	}
	used
}
fn optimize(idx const int[:], nv int, out int[>..]&, remap int[>..]&) int {
	var order int[>..] = [];
	cache_order(idx, nv, order);
	let used = fetch_remap(order, nv, remap);
	for v in order { out.push(remap[v]); }
	used
}
fn remap_bytes(data const byte[:], stride int, remap const int[:], used int, out byte[>..]&) {
	let base = out.len;
	out.resize(base + used * stride, 0);
	for v in remap.len {
		let slot = remap[v];
		if slot >= 0 {
			for k in stride { out[base + slot * stride + k] = data[v * stride + k]; }
		}
	}
}
fn zig32(d int) int {
	let w = ((d + 2147483648) & 4294967295) - 2147483648;
	if w >= 0 { w * 2 } else { 0 - w * 2 - 1 }
}
fn put_varint(out byte[>..]&, v int) {
	var x = v;
	while x >= 128 {
		out.push(((x & 127) + 128) as byte);
		x = x >> 7;
	}
	out.push(x as byte);
}
fn tri_stream(idx const int[:], table const byte[:], n_table int, codes byte[>..]&, data byte[>..]&, freq int[>..]&) {
	var nxt = 0;
	var prev = 0;
	var edge_a int[16] = [-1; 16];
	var edge_b int[16] = [-1; 16];
	var verts int[16] = [-1; 16];
	var edge_off = 0;
	var vert_off = 0;
	fn push_edge(x int, y int) {
		edge_a[edge_off] = x;
		edge_b[edge_off] = y;
		edge_off = (edge_off + 1) % 16;
	}
	fn push_vert(v int) {
		verts[vert_off] = v;
		vert_off = (vert_off + 1) % 16;
	}
	fn edge_find(a int, b int, c int) int {
		for i in 16 {
			let s = (edge_off + 15 - i) % 16;
			let x = edge_a[s];
			let y = edge_b[s];
			if x == a && y == b { return i * 4; }
			if x == b && y == c { return i * 4 + 1; }
			if x == c && y == a { return i * 4 + 2; }
		}
		return -1;
	}
	fn vert_find(v int) int {
		for i in 16 {
			if verts[(vert_off + 15 - i) % 16] == v { return i; }
		}
		return -1;
	}
	for t in idx.len / 3 {
		var a = idx[t * 3];
		var b = idx[t * 3 + 1];
		var c = idx[t * 3 + 2];
		fn rotate(r int) {
			if r == 1 {
				let x = a;
				a = b;
				b = c;
				c = x;
			} else if r == 2 {
				let x = c;
				c = b;
				b = a;
				a = x;
			}
		}
		let fer = edge_find(a, b, c);
		if fer >= 0 && (fer >> 2) < 15 {
			let fe = fer >> 2;
			rotate(fer & 3);
			let fc = vert_find(c);
			var fec = 15;
			if fc >= 1 && fc <= 12 {
				fec = fc;
			} else if c == nxt {
				fec = 0;
				nxt++;
			}
			if fec == 15 && c + 1 == prev {
				fec = 13;
				prev = c;
			} else if fec == 15 && c == prev + 1 {
				fec = 14;
				prev = c;
			}
			codes.push((fe * 16 + fec) as byte);
			if fec == 15 {
				put_varint(data, zig32(c - prev));
				prev = c;
			}
			if fec == 0 || fec >= 13 { push_vert(c); }
			push_edge(c, b);
			push_edge(a, c);
		} else {
			let turn = if b == nxt { 1 } else if c == nxt { 2 } else { 0 };
			rotate(turn);
			let reset = a == 0 && b == 1 && c == 2 && nxt > 0;
			if reset {
				nxt = 0;
				for i in 16 { verts[i] = -1; }
			}
			let fb = vert_find(b);
			let fc = vert_find(c);
			var fea = 15;
			if a == nxt {
				fea = 0;
				nxt++;
			}
			var feb = 15;
			if fb >= 0 && fb <= 13 {
				feb = fb + 1;
			} else if b == nxt {
				feb = 0;
				nxt++;
			}
			var fec = 15;
			if fc >= 0 && fc <= 13 {
				fec = fc + 1;
			} else if c == nxt {
				fec = 0;
				nxt++;
			}
			let aux = feb * 16 + fec;
			var found = -1;
			if fea == 0 && !reset {
				freq[aux] += 1;
				for i in min(n_table, 14) {
					if (table[i] as int) == aux {
						found = i;
						break;
					}
				}
			}
			if found >= 0 {
				codes.push((240 + found) as byte);
			} else {
				let high = if fea == 15 { 1 } else { 0 };
				codes.push((254 + high) as byte);
				data.push(aux as byte);
			}
			if fea == 15 {
				put_varint(data, zig32(a - prev));
				prev = a;
			}
			if feb == 15 {
				put_varint(data, zig32(b - prev));
				prev = b;
			}
			if fec == 15 {
				put_varint(data, zig32(c - prev));
				prev = c;
			}
			push_vert(a);
			if feb == 0 || feb == 15 { push_vert(b); }
			if fec == 0 || fec == 15 { push_vert(c); }
			push_edge(b, a);
			push_edge(c, b);
			push_edge(a, c);
		}
	}
}
fn encode_triangles(idx const int[:], out byte[>..]&) {
	var freq int[>..] = [];
	freq.resize(256, 0);
	var table byte[16] = [0; 16];
	var scratch_codes byte[>..] = [];
	var scratch_data byte[>..] = [];
	tri_stream(idx, table, 0, scratch_codes, scratch_data, freq);
	for k in 1..14 {
		var pick = -1;
		var count = 0;
		for v in 1..256 {
			if (v >> 4) < 15 && (v & 15) < 15 && freq[v] > count {
				pick = v;
				count = freq[v];
			}
		}
		if pick < 0 { break; }
		table[k] = pick as byte;
		freq[pick] = 0;
	}
	var codes byte[>..] = [];
	var data byte[>..] = [];
	tri_stream(idx, table, 14, codes, data, freq);
	out.push(225);
	out.append(codes);
	out.append(data);
	out.append(table);
}
fn encode_sequence(idx const int[:], out byte[>..]&) {
	out.push(209);
	var baseline int[2] = [0, 0];
	var current = 0;
	for v in idx {
		let cd = v - baseline[current];
		if abs(cd) >= 30 { current = 1 - current; }
		let z = zig32(v - baseline[current]);
		put_varint(out, z * 2 + current);
		baseline[current] = v;
	}
	for i in 4 { out.push(0); }
}
fn zig8(d int) int {
	let x = d & 255;
	let twice = (x * 2) & 255;
	if x >= 128 { twice ^ 255 } else { twice }
}
fn group_size(g const byte[:], w int) int {
	if w == 0 {
		for d in g {
			if (d as int) != 0 { return 1000; }
		}
		return 0;
	}
	if w == 8 { return 16; }
	let sentinel = (1 << w) - 1;
	var total = 16 * w / 8;
	for d in g {
		if (d as int) >= sentinel { total++; }
	}
	total
}
fn encode_attributes(data const byte[:], count int, stride int, out byte[>..]&) bool {
	if stride % 4 != 0 || stride < 4 || stride > 256 || count < 0 { return false; }
	if count > data.len / stride { return false; }
	out.push(160);
	var prev byte[256] = [0; 256];
	if count > 0 {
		for k in stride { prev[k] = data[k]; }
	}
	let largest = min(256, (8192 / stride) / 16 * 16);
	var at = 0;
	while at < count {
		let n = min(largest, count - at);
		let n16 = (n + 15) / 16 * 16;
		for k in stride {
			var deltas byte[256] = [0; 256];
			var before = prev[k] as int;
			for i in n {
				let v = data[(at + i) * stride + k] as int;
				deltas[i] = zig8(v - before) as byte;
				before = v;
			}
			let head = out.len;
			for h in (n16 / 16 + 3) / 4 { out.push(0); }
			var last = -1;
			for g in n16 / 16 {
				let part = deltas[g * 16..g * 16 + 16];
				var best = 3;
				var size = group_size(part, 8);
				for j in 3 {
					let width = if j == 0 { 0 } else if j == 1 { 2 } else { 4 };
					let s = group_size(part, width);
					if s < size || (s == size && j == last && best != 3) {
						best = j;
						size = s;
					}
				}
				last = best;
				let slot = head + g / 4;
				let marked = (out[slot] as int) | (best << (2 * (g % 4)));
				out[slot] = marked as byte;
				if best == 3 {
					out.append(part);
				} else if best > 0 {
					let w = best * 2;
					let sentinel = (1 << w) - 1;
					let per = 8 / w;
					for q in 16 / per {
						var acc = 0;
						for r in per { acc = (acc << w) | min(part[q * per + r] as int, sentinel); }
						out.push(acc as byte);
					}
					for d in part {
						if (d as int) >= sentinel { out.push(d); }
					}
				}
			}
		}
		for k in stride { prev[k] = data[(at + n - 1) * stride + k]; }
		at += n;
	}
	for i in max(stride, 32) - stride { out.push(0); }
	for k in stride {
		var first byte = 0;
		if count > 0 { first = data[k]; }
		out.push(first);
	}
	true
}
fn encode(data const byte[:], count int, stride int, mode int, out byte[>..]&) bool {
	if mode == 0 { return encode_attributes(data, count, stride, out); }
	if mode != 1 && mode != 2 { return false; }
	if stride != 2 && stride != 4 { return false; }
	if count < 0 || count > data.len / stride { return false; }
	if mode == 1 && count % 3 != 0 { return false; }
	var idx int[>..] = [];
	for i in count {
		var v = 0;
		for k in stride { v = v | ((data[i * stride + k] as int) << (8 * k)); }
		idx.push(v);
	}
	if mode == 1 {
		encode_triangles(idx, out);
	} else {
		encode_sequence(idx, out);
	}
	true
}
