var LINES int[>..] = [];
fn char_w(i int) f32 { sdf_text_w(TXT[i..i + 1], CSZ[i]) }
fn span_w(a int, b int) f32 { var w f32 = 0.0; for i in a..b { w += char_w(i); } w }
fn wrap(width f32) {
	LINES.clear();
