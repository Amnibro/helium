}
var SK byte[>..][>..] = []; var SV byte[>..][>..] = []; var LOCALE byte[>..] = [];
fn set_locale(l const byte[:]) { LOCALE.clear(); LOCALE.append(l); }
fn put_string(locale const byte[:], key const byte[:], v const byte[:]) { let k = str(locale, ":", key); for i in SK.len { if SK[i][..] == k[..] { SV[i].clear(); SV[i].append(v); return; } } SK.push(copy(k)); var c byte[>..] = []; c.append(v); SV.push(copy(c)); }
fn find_string(locale const byte[:], key const byte[:]) int { let k = str(locale, ":", key); for i in SK.len { if SK[i][..] == k[..] { return i; } } -1 }
