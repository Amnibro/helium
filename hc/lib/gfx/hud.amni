	else if k == IN_BACK { c3 * t * t * t - c1 * t * t } else if k == OUT_BACK { 1.0 + c3 * (t - 1.0) * (t - 1.0) * (t - 1.0) + c1 * (t - 1.0) * (t - 1.0) }
	else if k == OUT_ELASTIC { if t <= 0.0 { 0.0 } else if t >= 1.0 { 1.0 } else { pow(2.0, -10.0 * t) * sin((t * 10.0 - 0.75) * 2.0943951023931953) + 1.0 } }
