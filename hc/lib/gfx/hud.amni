var TW Tw[>..] = [];
fn prop_get(n int, p int) real { (if p == P_X { N[n].ox } else if p == P_Y { N[n].oy } else if p == P_OPACITY { N[n].opacity } else { N[n].scale }) as real }
fn prop_set(n int, p int, v real) { if p == P_X { N[n].ox = v as f32; } else if p == P_Y { N[n].oy = v as f32; } else if p == P_OPACITY { N[n].opacity = v as f32; } else { N[n].scale = v as f32; } }
fn tween(n int, p int, to real, dur real, e int) int { TW.push(Tw { node: n, prop: p, a: prop_get(n, p), b: to, el: 0.0, dur: dur, ease: e, next: -1, live: true, from_prev: false }); TW.len - 1 }
fn then(prev int, to real, dur real, e int) int { TW.push(Tw { node: TW[prev].node, prop: TW[prev].prop, a: TW[prev].b, b: to, el: 0.0, dur: dur, ease: e, next: -1, live: false, from_prev: true }); TW[prev].next = TW.len - 1; TW.len - 1 }
fn tw_value(i int) real { let t = TW[i]; if t.el >= t.dur { t.b } else { t.a + (t.b - t.a) * ease(t.ease, t.el / t.dur) } }
