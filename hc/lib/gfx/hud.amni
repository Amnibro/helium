fn rgba(c float4, a f32) byte[4] { [(clamp(c.x, 0.0, 1.0) * 255.0 + 0.5) as byte, (clamp(c.y, 0.0, 1.0) * 255.0 + 0.5) as byte, (clamp(c.z, 0.0, 1.0) * 255.0 + 0.5) as byte, (clamp(c.w * a, 0.0, 1.0) * 255.0 + 0.5) as byte] }
