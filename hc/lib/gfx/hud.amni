		d.formats[4] = gfx::VERTEX_UBYTE4_NORM; d.formats[5] = gfx::VERTEX_UBYTE4_NORM;
		PAN_PIPE = gfx::pipeline(embed_shader("shaders/hud_panel.vert"), embed_shader("shaders/hud_panel.frag"), d);
		PAN_READY = true;
	}
