			let x0 = cx - hx - 1.0; let x1 = cx + hx + 1.0; let y0 = cy - hy - 1.0; let y1 = cy + hy + 1.0;
			let p0 = PanVtx { pos: float2 { x0, y0 }, loc: float2 { x0 - cx, y0 - cy }, half: hh, rb: rb, fill: f, edge: e };
			let p1 = PanVtx { pos: float2 { x1, y0 }, loc: float2 { x1 - cx, y0 - cy }, half: hh, rb: rb, fill: f, edge: e };
			let p2 = PanVtx { pos: float2 { x1, y1 }, loc: float2 { x1 - cx, y1 - cy }, half: hh, rb: rb, fill: f, edge: e };
			let p3 = PanVtx { pos: float2 { x0, y1 }, loc: float2 { x0 - cx, y1 - cy }, half: hh, rb: rb, fill: f, edge: e };
			vs.append([p0, p1, p2, p0, p2, p3]);
		}
		if N[n].text >= 0 {
			rich(TEXTS[N[n].text][..], 16.0 * s, 0xffffff as u32);
			wrap(N[n].w * s - 2.0 * N[n].pd * s);
			var ly = cy - hy + N[n].pd * s; var l = 0;
			while l < LINES.len {
				let a0 = LINES[l]; let e0 = LINES[l + 1];
				var lh f32 = 0.0; for i in a0..e0 { lh = max(lh, CSZ[i]); }
				ly += lh * 1.25;
				var lx = cx - hx + N[n].pd * s;
				for r in RUNS {
					let ra = max(r.start, a0); let re = min(r.start + r.len, e0);
					if ra >= re { continue; }
					let c = float4 { ((r.color >> 16) & 255) as f32 / 255.0, ((r.color >> 8) & 255) as f32 / 255.0, (r.color & 255) as f32 / 255.0, 1.0 };
					sdf_text(tv, lx, ly, r.size, TXT[ra..re], rgba(c, a), if r.bold { 1 } else { 0 }, false);
					lx += span_w(ra, re);
				}
				l += 2;
			}
		}
	}
	let t0 = gfx::Texture { 0 };
	if clear { guard gfx::begin_pass(gfx::PassDesc { color: [target, t0, t0, t0], clear_color: true, color_value: bg, .. }) else { return; } gfx::end_pass(); }
	if vs.len > 0 {
		if vs.len > PAN_CAP { if PAN_CAP > 0 { gfx::release(PAN_VB); } PAN_CAP = max(vs.len, 4096); PAN_VB = gfx::buffer(gfx::BUFFER_VERTEX as int, PAN_CAP * 40, []); }
		gfx::update_buffer(PAN_VB, 0, bytes_of(vs)[..vs.len * 40]);
		guard gfx::begin_pass(gfx::PassDesc { color: [target, t0, t0, t0], clear_color: false, .. }) else { return; }
		gfx::bind(PAN_PIPE);
		gfx::uniforms(gfx::VERTEX as int, 0, HudProj { proj: gfx::ortho(0.0, w as f32, h as f32, 0.0, -1.0, 1.0) });
		gfx::bind_vertex_buffer(PAN_VB);
		gfx::draw(vs.len);
		gfx::end_pass();
	}
	sdf_draw(target, w, h, tv);
}
