		for i in k { if frozen[i] == 0 { let cl = clampv(items[i], mainax, tgt[i]); tot += cl - tgt[i]; if cl > tgt[i] { vio[i] = 1; } else if cl < tgt[i] { vio[i] = -1; } tgt[i] = cl; } }
		if abs(tot) < 1.0e-6 { for i in k { frozen[i] = 1; } } else if tot > 0.0 { for i in k { if vio[i] > 0 { frozen[i] = 1; } } } else { for i in k { if vio[i] < 0 { frozen[i] = 1; } } }
	}
