		let b = N[i];
		if i == from || !b.focusable || !b.visible { continue; }
		let p = if dir == RIGHT { b.x - (a.x + a.w) } else if dir == LEFT { a.x - (b.x + b.w) } else if dir == DOWN { b.y - (a.y + a.h) } else { a.y - (b.y + b.h) };
