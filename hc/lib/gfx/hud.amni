fn hexv(c byte) u32 { (if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 }) as u32 }
fn starts(s const byte[:], at int, p const byte[:]) bool { if at + p.len > s.len { return false; } for i in p.len { if s[at + i] != p[i] { return false; } } true }
fn rich(src const byte[:], size f32, color u32) {
	TXT.clear(); RUNS.clear(); CSZ.clear();
	var bs bool[>..] = [false]; var cs u32[>..] = [color]; var ss f32[>..] = [size]; var kind int[>..] = [];
	var at = 0;
	while at < src.len {
		var tag = false;
