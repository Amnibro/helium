let LINEAR = 0; let IN_QUAD = 1; let OUT_QUAD = 2; let INOUT_QUAD = 3; let IN_CUBIC = 4; let OUT_CUBIC = 5; let INOUT_CUBIC = 6; let IN_BACK = 7; let OUT_BACK = 8; let OUT_ELASTIC = 9;
fn ease(k int, t real) real {
