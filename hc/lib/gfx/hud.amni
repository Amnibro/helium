				else if starts(src, at, "<color=#") && e - at == 14 { var v u32 = 0; for k in 6 { v = v * 16 + hexv(src[at + 8 + k]); } bs.push(bs[bs.len - 1]); cs.push(v); ss.push(ss[ss.len - 1]); kind.push(1); }
				else if starts(src, at, "<size=") { var v f32 = 0.0; for k in at + 6..e { v = v * 10.0 + (src[k] - 48) as f32; } bs.push(bs[bs.len - 1]); cs.push(cs[cs.len - 1]); ss.push(v); kind.push(2); }
