// sdf_font: an original procedural signed-distance-field font. ASCII 32..126
// are vector strokes (line segments and circular arcs) defined in code; there
// are no font files. sdf_bake renders a 1024x512 distance atlas on the CPU in
// two weights (stroke radius 1.3 and 2.1 cell px); sdf_init uploads it.
//
// Text is emitted as TextVtx quads (pos, uv, col; 20 bytes). Draw them with
// shaders/sdf_text.vert and shaders/sdf_text.frag, with sdf_texture() and
// sdf_sampler() bound at fragment sampler slot 0. In the vertex stream:
//   uv.x <  0   flat colour (solid rects can share the pipeline)
//   uv.x >= 2   outline pass (uv.x - 2 is the atlas coordinate)
//   otherwise   glyph fill
// sdf_text(vs, x, y, px, text, colour, weight, outline): px is the cap height
// in pixels and (x, y) the top-left of the cap box; weight 0 regular, 1 bold;
// outline false adds a soft drop shadow, true a dark outline.
// sdf_text_w(text, px) is the advance width in pixels.
import std;
import math;
import gfx;
import os;
import ttf;
struct TtG { u0 f32, v0 f32, u1 f32, v1 f32, x0 f32, y0 f32, w f32, h f32, adv f32, g int, f int }
let TT_BAKE f32 = 40.0;
let TT_HI = 3;
let TT_PAD = 7;
let TT_AW = 2048;
let TT_AH = 1024;
var TT ttf::Info;
var TT_ON = 0;
var TT_WANT = false;
var TT_CAP f32 = 1.0;
var TF ttf::Info;
var TF_ON = false;
var TF_CAP f32 = 1.0;
var TT_G TtG[>..] = [];
var TT_KEY int[>..] = [];
var TT_MAP int[>..] = [];
var TT_PIX byte[>..] = [];
var TT_X = 0;
var TT_Y = 0;
var TT_ROW = 0;
var TT_DIRTY = false;
fn tt_path(k int) const byte[:] { if k == 0 { "/usr/share/fonts/inter/InterVariable.ttf" } else if k == 1 { "/usr/share/fonts/truetype/sand-box/google/Inter/Inter-VariableFont_opsz,wght.ttf" } else if k == 2 { "/usr/share/fonts/TTF/Inter-Regular.ttf" } else if k == 3 { "/usr/share/fonts/truetype/inter/Inter-Regular.ttf" } else if k == 4 { "/usr/share/fonts/noto/NotoSans-Regular.ttf" } else if k == 5 { "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf" } else if k == 6 { "/usr/share/fonts/TTF/DejaVuSans.ttf" } else if k == 7 { "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" } else if k == 8 { "/System/Library/Fonts/Supplemental/Arial.ttf" } else { "C:/Windows/Fonts/segoeui.ttf" } }
fn tt_on() bool {
	if TT_ON != 0 { return TT_ON > 0; }
	TT_ON = -1;
	var path byte[>..] = [];
	var blob byte[>..] = [];
	let named = env("HELIUM_FONT", path) && path.len > 0;
	if (named && path == "builtin") || (!named && !TT_WANT) || SDF_TTF_PIX.len > 0 { return false; }
	var ok = named && read_file(path[..], blob);
	var k = 0;
	while !ok && k < 10 { ok = read_file(tt_path(k), blob); k += 1; }
	if !ok { return false; }
	TT = ttf::Info { blob };
	TT.fo = ttf::font_offset(TT.d[..], 0);
	if TT.fo < 0 || !ttf::init(TT) { return false; }
	var b = ttf::B4 { 0, 0, 0, 0 };
	if !ttf::gbox(TT, ttf::glyph_index(TT, 'H' as int), b) || b.y1 <= 0 { return false; }
	TT_CAP = b.y1 as f32;
	let pk = if named { -1 } else { k - 1 };
	var j = 6;
	while !TF_ON && pk < 6 && j < 8 {
		var fb byte[>..] = [];
		if read_file(tt_path(j), fb) {
			TF = ttf::Info { fb };
			TF.fo = ttf::font_offset(TF.d[..], 0);
			var c = ttf::B4 { 0, 0, 0, 0 };
			TF_ON = TF.fo >= 0 && ttf::init(TF) && ttf::gbox(TF, ttf::glyph_index(TF, 'H' as int), c) && c.y1 > 0;
			TF_CAP = if TF_ON { c.y1 as f32 } else { 1.0 };
		}
		j += 1;
	}
	TT_MAP.resize(0x6000, -1);
	TT_PIX.resize(TT_AW * TT_AH * 4, 0);
	TT_ON = 1;
	true
}
fn sdf_system_font() bool {
	TT_WANT = true;
	TT_ON = if TT_ON < 0 && !SDF_READY { 0 } else { TT_ON };
	tt_on()
}
fn tt_edt(g f32[>..]&, w int, h int) {
	let n = max(w, h);
	var f f32[>..] = [];
	var d f32[>..] = [];
	var v int[>..] = [];
	var z f32[>..] = [];
	f.resize(n, 0.0);
	d.resize(n, 0.0);
	v.resize(n, 0);
	z.resize(n + 1, 0.0);
	for pass in 2 {
		let lines = if pass == 0 { w } else { h };
		let len = if pass == 0 { h } else { w };
		for l in lines {
			for i in len { f[i] = g[if pass == 0 { i * w + l } else { l * w + i }]; }
			var k = 0;
			v[0] = 0;
			z[0] = -1.0e20;
			z[1] = 1.0e20;
			for q in 1..len {
				var s = (f[q] + (q * q) as f32 - f[v[k]] - (v[k] * v[k]) as f32) / (2 * (q - v[k])) as f32;
				while k > 0 && s <= z[k] { k -= 1; s = (f[q] + (q * q) as f32 - f[v[k]] - (v[k] * v[k]) as f32) / (2 * (q - v[k])) as f32; }
				k += 1;
				v[k] = q;
				z[k] = s;
				z[k + 1] = 1.0e20;
			}
			k = 0;
			for q in len {
				while z[k + 1] < q as f32 { k += 1; }
				d[q] = ((q - v[k]) * (q - v[k])) as f32 + f[v[k]];
			}
			for i in len { g[if pass == 0 { i * w + l } else { l * w + i }] = d[i]; }
		}
	}
}
fn tt_slot(cp int, weight int) int {
	let key = cp * 2 + weight;
	if key < TT_MAP.len && TT_MAP[key] >= 0 { return TT_MAP[key]; }
	if key >= TT_MAP.len { for i in TT_KEY.len { if TT_KEY[i] == key { return i; } } }
	let g0 = ttf::glyph_index(TT, cp);
	let fb = g0 == 0 && TF_ON && ttf::glyph_index(TF, cp) != 0;
	let g = if fb { ttf::glyph_index(TF, cp) } else { g0 };
	let hs = TT_BAKE / (if fb { TF_CAP } else { TT_CAP }) * TT_HI as f32;
	let b = if fb { ttf::bbox(TF, g, hs, hs, 0.0, 0.0) } else { ttf::bbox(TT, g, hs, hs, 0.0, 0.0) };
	let pd = TT_PAD * TT_HI;
	let gw = max(0, b.x1 - b.x0);
	let gh = max(0, b.y1 - b.y0);
	let w = gw + 2 * pd;
	let h = gh + 2 * pd;
	let ow = (w + TT_HI - 1) / TT_HI;
	let oh = (h + TT_HI - 1) / TT_HI;
	if gw > 0 && gh > 0 && TT_X + ow > TT_AW { TT_X = 0; TT_Y += TT_ROW + 1; TT_ROW = 0; }
	let room = gw > 0 && gh > 0 && TT_Y + oh <= TT_AH;
	if room {
		var hi byte[>..] = [];
		hi.resize(w * h, 0);
		if fb { ttf::glyph_bitmap(TF, hi, pd * w + pd, gw, gh, w, hs, hs, g); } else { ttf::glyph_bitmap(TT, hi, pd * w + pd, gw, gh, w, hs, hs, g); }
		var gi f32[>..] = [];
		var go f32[>..] = [];
		gi.resize(w * h, 1.0e20);
		go.resize(w * h, 1.0e20);
		for i in w * h { if hi[i] >= 128 { gi[i] = 0.0; } else { go[i] = 0.0; } }
		tt_edt(gi, w, h);
		tt_edt(go, w, h);
		let bold = if weight != 0 { 0.9 } else { 0.0 };
		for oy in oh {
			for ox in ow {
				let sx = min(ox * TT_HI + TT_HI / 2, w - 1);
				let sy = min(oy * TT_HI + TT_HI / 2, h - 1);
				let k = sy * w + sx;
				let sd = (sqrt(gi[k]) - sqrt(go[k])) / TT_HI as f32 - bold;
				let val = (clamp(0.5 - sd / (2.0 * SDF_SPREAD), 0.0, 1.0) * 255.0 + 0.5) as int as byte;
				let o = ((TT_Y + oy) * TT_AW + TT_X + ox) * 4;
				TT_PIX[o] = val;
				TT_PIX[o + 1] = val;
				TT_PIX[o + 2] = val;
				TT_PIX[o + 3] = val;
			}
		}
		TT_DIRTY = true;
	}
	let adv = if fb { ttf::hmetrics(TF, g).x as f32 * TT_BAKE / TF_CAP } else { ttf::hmetrics(TT, g).x as f32 * TT_BAKE / TT_CAP };
	TT_G.push(TtG { u0: TT_X as f32 / TT_AW as f32, v0: TT_Y as f32 / TT_AH as f32, u1: (TT_X + ow) as f32 / TT_AW as f32, v1: (TT_Y + oh) as f32 / TT_AH as f32, x0: (b.x0 - pd) as f32 / TT_HI as f32, y0: (b.y0 - pd) as f32 / TT_HI as f32 + TT_BAKE, w: if room { ow as f32 } else { 0.0 }, h: oh as f32, adv: adv, g: g, f: if fb { 1 } else { 0 } });
	if room { TT_X += ow + 1; TT_ROW = max(TT_ROW, oh); }
	TT_KEY.push(key);
	if key < TT_MAP.len { TT_MAP[key] = TT_G.len - 1; }
	TT_G.len - 1
}
fn tt_next(t const byte[:], i int) int, int {
	let c = t[i] as int;
	let n = if c >= 240 { 3 } else if c >= 224 { 2 } else if c >= 192 { 1 } else { 0 };
	var cp = if n == 3 { c & 7 } else if n == 2 { c & 15 } else if n == 1 { c & 31 } else { c };
	var j = i + 1;
	for k in n { if j < t.len { cp = cp * 64 + ((t[j] as int) & 63); j += 1; } }
	return cp, j;
}
fn tt_text(vs TextVtx[>..]&, x f32, y f32, px f32, t const byte[:], c byte[4], weight int, outline bool) f32 {
	let s = px / TT_BAKE;
	let ks = TT_BAKE / TT_CAP * s;
	var pen f32 = 0.0;
	for pass in 2 {
		let is_bg = pass == 0;
		if is_bg && c[3] == 0 { continue; }
		let o = if outline { 0.0 } else if is_bg { max(1.0, px * 0.07) } else { 0.0 };
		let col byte[4] = if is_bg { [0, 0, 0, c[3]] } else { c };
		let um f32 = if outline && is_bg { 2.0 } else { 0.0 };
		pen = x + o;
		var pg = -1;
		var pf = 0;
		var i = 0;
		while i < t.len {
			let cp, j = tt_next(t, i);
			i = j;
			let q = TT_G[tt_slot(cp, weight)];
			pen += if q.f == 0 && pf == 0 { ttf::kern(TT, pg, q.g) as f32 * ks } else { 0.0 };
			pg = q.g;
			pf = q.f;
			if q.w > 0.0 {
				let qx = pen + q.x0 * s;
				let qy = y + o + q.y0 * s;
				let qx1 = qx + q.w * s;
				let qy1 = qy + q.h * s;
				vs.append([TextVtx { pos: float2 { qx, qy }, uv: float2 { q.u0 + um, q.v0 }, col: col }, TextVtx { pos: float2 { qx1, qy }, uv: float2 { q.u1 + um, q.v0 }, col: col }, TextVtx { pos: float2 { qx1, qy1 }, uv: float2 { q.u1 + um, q.v1 }, col: col }, TextVtx { pos: float2 { qx, qy }, uv: float2 { q.u0 + um, q.v0 }, col: col }, TextVtx { pos: float2 { qx1, qy1 }, uv: float2 { q.u1 + um, q.v1 }, col: col }, TextVtx { pos: float2 { qx, qy1 }, uv: float2 { q.u0 + um, q.v1 }, col: col }]);
			}
			pen += q.adv * s;
		}
	}
	pen - x
}
fn tt_width(t const byte[:], px f32) f32 {
	let s = px / TT_BAKE;
	var w f32 = 0.0;
	var pg = -1;
	var pf = 0;
	var i = 0;
	while i < t.len {
		let cp, j = tt_next(t, i);
		i = j;
		let q = TT_G[tt_slot(cp, 0)];
		w += (if q.f == 0 && pf == 0 { ttf::kern(TT, pg, q.g) as f32 * TT_BAKE / TT_CAP * s } else { 0.0 }) + q.adv * s;
		pg = q.g;
		pf = q.f;
	}
	w
}

struct TextVtx { pos float2, uv float2, col byte[4] }

struct SdfStroke {
	kind int,
	x0 f32, y0 f32, x1 f32, y1 f32,
	r f32, a0 f32, a1 f32
}

let SDF_ATLAS_W = 1024;
let SDF_ATLAS_H = 512;
let SDF_CELL = 48;
let SDF_COLS = 20;
let SDF_CAP_H f32 = 24.0;
let SDF_SPREAD f32 = 6.0;
let SDF_R_REG f32 = 1.3;
let SDF_R_BOLD f32 = 2.1;

var SDF_TEX gfx::Texture;
var SDF_SMP gfx::Sampler;
var SDF_READY bool = false;
var SDF_PIPE gfx::Pipeline;
var SDF_VB gfx::Buffer;
var SDF_VB_CAP int = 0;

struct SdfProj { proj gfx::mat4 }

var SDF_STROKES SdfStroke[>..] = [];
var SDF_FIRST int[95];
var SDF_COUNT int[95];
var SDF_ADV f32[95];
// Pen-relative x shift (font units) that centres each glyph's ink inside its advance.
var SDF_OFF f32[95];
var SDF_TTF_PIX byte[>..] = [];
var SDF_KERN f32[>..] = [];
fn sdf_kern(t const byte[:], i int) f32 { if SDF_KERN.len == 0 || i + 1 >= t.len { return 0.0; } let a = t[i] as int - 32; let b = t[i + 1] as int - 32; if a < 0 || a >= 95 || b < 0 || b >= 95 { 0.0 } else { SDF_KERN[a * 95 + b] } }

fn sdf_seg(x0 f32, y0 f32, x1 f32, y1 f32) {
	SDF_STROKES.push(SdfStroke { kind: 0, x0: x0, y0: y0, x1: x1, y1: y1, r: 0.0, a0: 0.0, a1: 0.0 });
}

fn sdf_arc(cx f32, cy f32, r f32, a0 f32, a1 f32) {
	SDF_STROKES.push(SdfStroke { kind: 1, x0: cx, y0: cy, x1: 0.0, y1: 0.0, r: r, a0: a0, a1: a1 });
}

fn sdf_circle(cx f32, cy f32, r f32) {
	sdf_arc(cx, cy, r, 0.0, 6.2831853);
}

fn sdf_dist_seg(px f32, py f32, x0 f32, y0 f32, x1 f32, y1 f32) f32 {
	let dx = x1 - x0;
	let dy = y1 - y0;
	let l2 = dx * dx + dy * dy;
	if l2 <= 0.00001 {
		let qx = px - x0;
		let qy = py - y0;
		return sqrt(qx * qx + qy * qy);
	}
	let t = clamp(((px - x0) * dx + (py - y0) * dy) / l2, 0.0, 1.0);
	let qx = px - (x0 + t * dx);
	let qy = py - (y0 + t * dy);
	return sqrt(qx * qx + qy * qy);
}

fn sdf_dist_arc(px f32, py f32, cx f32, cy f32, r f32, a0 f32, a1 f32) f32 {
	let dx = px - cx;
	let dy = py - cy;
	let d_center = sqrt(dx * dx + dy * dy);
	var th = atan2(dy, dx);
	let pi2 = 6.2831853;
	var diff = th - a0;
	while diff < 0.0 { diff += pi2; }
	while diff >= pi2 { diff -= pi2; }
	let sweep = a1 - a0;
	if diff <= sweep {
		return abs(d_center - r);
	}
	let p0x = cx + r * cos(a0);
	let p0y = cy + r * sin(a0);
	let p1x = cx + r * cos(a1);
	let p1y = cy + r * sin(a1);
	let d0x = px - p0x;
	let d0y = py - p0y;
	let d1x = px - p1x;
	let d1y = py - p1y;
	let d0 = sqrt(d0x * d0x + d0y * d0y);
	let d1 = sqrt(d1x * d1x + d1y * d1y);
	return min(d0, d1);
}

// Strokes are drawn on a shared 48-unit cell (origin x 8), but advances are
// proportional, so centre the ink of each glyph within its advance.
fn sdf_fit_bearings() {
	for k in 95 {
		SDF_OFF[k] = 0.0;
		if SDF_COUNT[k] == 0 { continue; }
		var lo f32 = 1000.0;
		var hi f32 = -1000.0;
		for j in SDF_COUNT[k] {
			let st = SDF_STROKES[SDF_FIRST[k] + j];
			if st.kind == 0 {
				lo = min(lo, min(st.x0, st.x1));
				hi = max(hi, max(st.x0, st.x1));
			} else {
				for n in 17 {
					let a = st.a0 + (st.a1 - st.a0) * n as f32 / 16.0;
					let x = st.x0 + st.r * cos(a);
					lo = min(lo, x);
					hi = max(hi, x);
				}
			}
		}
		SDF_OFF[k] = (SDF_ADV[k] - (hi - lo)) * 0.5 - (lo - 8.0);
	}
}

fn sdf_build_glyphs() {
	if SDF_STROKES.len > 0 || SDF_TTF_PIX.len > 0 { return; }
	for i in 95 {
		SDF_FIRST[i] = 0;
		SDF_COUNT[i] = 0;
		SDF_ADV[i] = 16.0;
	}

	let X0 f32 = 8.0;
	let X1 f32 = 24.0;
	let XM f32 = 16.0;
	let YT f32 = 11.0;
	let YM f32 = 23.0;
	let YB f32 = 35.0;
	let YD f32 = 41.0;
	let yt f32 = 19.0;
	let ym f32 = 27.0;

	// ASCII 32: Space
	SDF_FIRST[0] = SDF_STROKES.len;
	SDF_COUNT[0] = 0;
	SDF_ADV[0] = 12.0;

	// ASCII 33: '!'
	SDF_FIRST[1] = SDF_STROKES.len;
	sdf_seg(XM, YT, XM, YB - 6.0);
	sdf_seg(XM, YB - 1.0, XM, YB - 1.0);
	SDF_COUNT[1] = SDF_STROKES.len - SDF_FIRST[1];
	SDF_ADV[1] = 10.0;

	// ASCII 34: '"'
	SDF_FIRST[2] = SDF_STROKES.len;
	sdf_seg(13.0, YT, 13.0, YT + 6.0);
	sdf_seg(19.0, YT, 19.0, YT + 6.0);
	SDF_COUNT[2] = SDF_STROKES.len - SDF_FIRST[2];
	SDF_ADV[2] = 14.0;

	// ASCII 35: '#'
	SDF_FIRST[3] = SDF_STROKES.len;
	sdf_seg(13.0, YT, 13.0, YB);
	sdf_seg(19.0, YT, 19.0, YB);
	sdf_seg(9.0, 18.0, 23.0, 18.0);
	sdf_seg(9.0, 28.0, 23.0, 28.0);
	SDF_COUNT[3] = SDF_STROKES.len - SDF_FIRST[3];
	SDF_ADV[3] = 18.0;

	// ASCII 36: '$'
	SDF_FIRST[4] = SDF_STROKES.len;
	sdf_seg(XM, YT - 2.0, XM, YB + 2.0);
	sdf_seg(X1, YT + 2.0, X0 + 4.0, YT);
	sdf_seg(X0 + 4.0, YT, X0, YT + 4.0);
	sdf_seg(X0, YT + 4.0, X1, YB - 4.0);
	sdf_seg(X1, YB - 4.0, X1 - 4.0, YB);
	sdf_seg(X1 - 4.0, YB, X0, YB - 2.0);
	SDF_COUNT[4] = SDF_STROKES.len - SDF_FIRST[4];
	SDF_ADV[4] = 18.0;

	// ASCII 37: '%'
	SDF_FIRST[5] = SDF_STROKES.len;
	sdf_seg(22.0, YT, 10.0, YB);
	sdf_circle(12.0, YT + 3.0, 2.5);
	sdf_circle(20.0, YB - 3.0, 2.5);
	SDF_COUNT[5] = SDF_STROKES.len - SDF_FIRST[5];
	SDF_ADV[5] = 19.0;

	// ASCII 38: '&'
	SDF_FIRST[6] = SDF_STROKES.len;
	sdf_seg(22.0, YB, 11.0, 17.0);
	sdf_circle(15.0, 16.0, 4.0);
	sdf_arc(16.0, 28.0, 6.0, 0.0, 5.0);
	SDF_COUNT[6] = SDF_STROKES.len - SDF_FIRST[6];
	SDF_ADV[6] = 19.0;

	// ASCII 39: '''
	SDF_FIRST[7] = SDF_STROKES.len;
	sdf_seg(XM, YT, XM, YT + 5.0);
	SDF_COUNT[7] = SDF_STROKES.len - SDF_FIRST[7];
	SDF_ADV[7] = 8.0;

	// ASCII 40: '('
	SDF_FIRST[8] = SDF_STROKES.len;
	sdf_arc(21.0, YM, 14.0, 2.0, 4.28);
	SDF_COUNT[8] = SDF_STROKES.len - SDF_FIRST[8];
	SDF_ADV[8] = 10.0;

	// ASCII 41: ')'
	SDF_FIRST[9] = SDF_STROKES.len;
	sdf_arc(11.0, YM, 14.0, -1.14, 1.14);
	SDF_COUNT[9] = SDF_STROKES.len - SDF_FIRST[9];
	SDF_ADV[9] = 10.0;

	// ASCII 42: '*'
	SDF_FIRST[10] = SDF_STROKES.len;
	sdf_seg(11.0, YM, 21.0, YM);
	sdf_seg(13.0, YM - 5.0, 19.0, YM + 5.0);
	sdf_seg(13.0, YM + 5.0, 19.0, YM - 5.0);
	SDF_COUNT[10] = SDF_STROKES.len - SDF_FIRST[10];
	SDF_ADV[10] = 13.0;

	// ASCII 43: '+'
	SDF_FIRST[11] = SDF_STROKES.len;
	sdf_seg(10.0, YM, 22.0, YM);
	sdf_seg(XM, YM - 6.0, XM, YM + 6.0);
	SDF_COUNT[11] = SDF_STROKES.len - SDF_FIRST[11];
	SDF_ADV[11] = 17.0;

	// ASCII 44: ','
	SDF_FIRST[12] = SDF_STROKES.len;
	sdf_seg(XM, YB - 1.0, XM - 2.0, YB + 4.0);
