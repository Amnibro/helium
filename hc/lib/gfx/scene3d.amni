// Multiple-scattering energy compensation of the specular lobe (surface.frag ms_factor).
var multiscatter = true;
// Test hook for the furnace control: scales the direct light; 1.0 in normal use.
var furnace_scale f32 = 1.0;
// Test hook for the furnace controls that must fail, 0 in normal use: 1 gives dielectrics
// F0 = 1 in the specular lobe only, 2 weights diffuse by the older per-light 1 - F(v.h).
var furnace_mode = 0;
var test_rect_naive = false;
var alpha_to_coverage = false;
var mip_bias f32 = 0.0;
var mip_bias_auto = true;
var test_morph_still = false;
// Temporal accumulation. 0 off (unless the output is upscaled), 1 on.
var temporal = 0;
var temporal_blend f32 = 0.0625;     // weight of a new frame on a still pixel
var temporal_motion f32 = 0.01;      // extra weight per output pixel of motion
var temporal_max f32 = 0.5;
var temporal_gamma f32 = 1.25;       // neighbourhood clip width in standard deviations (0 = no clip)
var temporal_reset = false;          // drop the history on the next frame (camera cut)
// Depth-based history rejection (shaders/temporal.frag): a pixel whose history shows a
// surface in front of it (nearer by more than this fraction of its depth) that is no
// longer anywhere in its 3x3 neighbourhood was hidden last frame, so its history is
// dropped. 0 turns it off (a test control).
var temporal_depth_reject f32 = 0.1;
// Test hook: scales the motion vectors the temporal pass reads; 1 in normal use,
// 0 is the "motion forced to zero" control of the ghost gate.
var temporal_motion_scale f32 = 1.0;
var jitter_phases = 16;
// Write the motion target even when temporal is off (for a caller that reads
// motion_target()). With both off the target is neither allocated nor drawn.
var motion_vectors = false;
// Test hooks for gfx_smoke's must-fail shadow controls (leave at their defaults): the
// shadow map is drawn with each cascade shifted along light-space x by this many texels
// (x, y, z = cascades 0, 1, 2; sampling is unshifted), and every cascade's clear cycles
// the whole map (what a layer-only cycling rule did before S5).
var shadow_test_shift float3 = float3 { 0.0, 0.0, 0.0 };
var shadow_test_cycle_all = false;
// and never cycles at all (reported only: does the driver serialise frames anyway)
var shadow_test_cycle_never = false;
