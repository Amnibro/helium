// scene3d: a forward renderer for glTF assets loaded by gfx.gltf.
//
// Frame structure (render):
//   1. deformation data: joint matrices for every skinned instance, one storage buffer
//   2. sun shadows: CASCADES depth layers fitted to slices of the view frustum
//   3. prepass (one sample per pixel, no MSAA): view normal + depth for SSAO and,
//      when temporal runs (or `motion_vectors` is set), a second target, `motion`:
//      every pixel's screen motion since last frame (uv units, from unjittered
//      clip positions, skinning included), its view depth now and the same
//      surface point's view depth last frame. One sample per pixel means a
//      silhouette pixel holds the motion and depth of one surface (the one under
//      its sample point), never an MSAA average of two. Then hemisphere SSAO and
//      a depth-aware blur when SSAO is on.
//   4. colour: 4x MSAA RGBA16F; sky, opaque and cut-out surfaces, blended
//      surfaces far to near, then particles (gfx.sparks); resolved to `hdr`.
//   4b. temporal (when `temporal` is on, or the output is larger than the render
//      size): jittered frames accumulate into a history image at the output size
//      (shaders/temporal.frag); TAA at equal sizes, a temporal upscaler otherwise
//   5. bloom: threshold, a chain of half-size reductions, tent expansion back up
//   6. grading: exposure, curve and sRGB into the caller's RGBA8 target
//
// The scene is plain data: `view`, `sun`, `sky`, `look`, `lights` and `items` are
// globals the caller edits between frames. Each frame the item list is flattened
// into `batch` (one Batch per primitive draw, with its matrices and sort depth),
// so later stages such as GPU culling or a velocity pass can consume the same
// list. prev_* fields are kept for motion vectors.
namespace s3d;
import gfx;
import math;
import gfx.linalg;
import gfx.gltf;
import gfx.motion;
import gfx.sparks;
import gfx.fx;
import gfx.rt;
import gfx.envmap;
import gfx.clusters;
import gfx.bc;
import gfx.ktx2;
import os;

let CASCADES = 3;
let MAX_LIGHTS = 16;
let MAX_PROBES = 8;
let GI_LIGHTS = 8;
let GLOW_LEVELS = 5;
let MSAA = 4;
let LOCAL_LAYERS = 12;
let HIZ_LEVELS = 7;

struct Camera { eye float3, target float3, up float3, fov_y f32, near f32, far f32 }
struct Sun { to_sun float3, rgb float3, shadows bool, shadow_far f32, map_size int, soft f32 = 0.0, angle f32 = 0.0, reach f32 = 1.0, fit bool = false, contact f32 = 0.0 }
struct Light { pos float3, range f32, rgb float3, kind int, dir float3 = float3 { 0.0, -1.0, 0.0 }, cone f32 = 0.5, edge f32 = 0.2, shadows bool = false, soft f32 = 1.5, radius f32 = 0.0, length f32 = 0.0, width f32 = 0.0, height f32 = 0.0, axis float3 = float3 { 1.0, 0.0, 0.0 }, falloff int = 0 }
struct Sky { zenith float3, horizon float3, ground float3, ambient f32, draw bool }
struct Look { exposure f32, white f32, bloom f32, bloom_cut f32, desaturate f32, ssao bool, ao_radius f32, ao_power f32, ao_samples int, curve int = 0, auto_exposure bool = false, ae_key f32 = 0.18, ae_low f32 = 0.5, ae_high f32 = 0.95, ae_min f32 = -4.0, ae_max f32 = 4.0, ae_up f32 = 3.0, ae_down f32 = 1.0, ae_center f32 = 3.0, lut f32 = 0.0, vignette f32 = 0.0, chroma f32 = 0.0, grain f32 = 0.0, sharpen f32 = 0.0, saturation f32 = 1.0, contrast f32 = 1.0, warmth f32 = 0.0 }
struct NodeOv { item int, node int, t float3, r linalg::Quat, sc float3 }
struct WeightOv { item int, node int, k int, w f32 }
struct Item { asset int, place gfx::mat4, prev_place gfx::mat4, anim int, time f32, visible bool, anim2 int = -1, time2 f32 = 0.0, blend f32 = 1.0, bend_node int = -1, bend linalg::Quat = linalg::Quat { 0.0, 0.0, 0.0, 1.0 }, track int[4] = [-1, -1, -1, -1], tracked gfx::mat4[4] = [gfx::mat4_identity, gfx::mat4_identity, gfx::mat4_identity, gfx::mat4_identity], light_base int = -1, sway f32 = 0.0, top f32 = 0.0 }
struct InstSet { asset int, first int, count int, lod_asset int = -1, lod_distance f32 = 0.0, sway f32 = 0.0, visible bool = true, top f32 = 0.0, c float3 = float3 { 0.0, 0.0, 0.0 }, r f32 = 0.0, lo float3 = float3 { 0.0, 0.0, 0.0 }, hi float3 = float3 { 0.0, 0.0, 0.0 }, ia int[2] = [0, 0], na int[2] = [0, 0], iv int[2] = [0, 0], nv int[2] = [0, 0], smax f32 = 1.0 }
struct Caustics { on bool = false, manual bool = false, strength f32 = 1.0, focus f32 = 1.0, cap f32 = 7.0, level f32 = 0.0, waves float4 = float4 { 1.1, 0.062, 1.0, 0.7 }, absorb float3 = float3 { 0.45, 0.09, 0.07 }, lo float3 = float3 { -1.0e9, 0.0, -1.0e9 }, hi float3 = float3 { 1.0e9, 0.0, 1.0e9 } }
struct Wind { dir float3 = float3 { 1.0, 0.0, 0.0 }, strength f32 = 0.0, speed f32 = 1.0, time f32 = 0.0 }
struct Batch { prim int, item int, node int, joint_base int, model gfx::mat4, depth f32, mode int, prev_model gfx::mat4, prev_joint_base int, vis bool, trans bool, wb int, pwb int, inst int, lod int }

struct DrawU { model gfx::mat4, model_normal gfx::mat4, view_proj gfx::mat4, prev_model gfx::mat4, deform float4, misc float4, cur_vp gfx::mat4, prev_vp gfx::mat4, weights float4[16], prev_weights float4[16], inst float4, sway_o float4, wind float4, wind_t float4, push float4[4], prev_push float4[4] }
struct FrameU {
	cascade_mat gfx::mat4[3], cascade_far float4, eye float4, view_dir float4, to_sun float4, sun_rgb float4,
	zenith float4, horizon float4, ground float4, screen float4, light_pos float4[16], light_rgb float4[16], gi float4, gi_origin float4, gi_step float4, gi_dims float4,
	light_dir float4[16], light_shd float4[16], local_mat gfx::mat4[12], refl float4, view_m gfx::mat4, env float4, env_rot float4, vp gfx::mat4, cluster float4, cluster2 float4,
	probe_n float4, probe_pos float4[8], probe_lo float4[8], probe_hi float4[8], ssgi float4, decal float4, caust float4, caust_w float4, caust_box float4, caust_abs float4, rtr float4
}
struct GiU { origin float4, step float4, dims float4, rot0 float4, rot1 float4, rot2 float4, params float4, to_sun float4, sun_rgb float4, zenith float4, horizon float4, ground float4, light_pos float4[8], light_rgb float4[8], env float4, env_rot float4 }
struct SurfaceU { base float4, emissive float4, params float4, alpha float4, uv_sets float4, uv_sets2 float4, tri float4, top_tint float4, xm_base float4, xm_mr float4, xm_nrm float4, xm_occ float4, xm_emi float4, xo0 float4, xo1 float4, xo2 float4, sheen float4, misc float4, shade_a float4, shade_b float4, shade_c float4, xm_det float4, xo_det float4, top_lay float4 }
struct ExtU { ior float4, spec float4, coat float4, trans float4, atten float4, aniso float4, irid float4, tm float4[13], to float4[13] }
struct CutU { base float4, alpha float4, uv_sets float4, xm float4, xo float4 }
struct CutViewU { base float4, alpha float4, uv_sets float4, xm float4, xo float4, view gfx::mat4 }
struct SkyU { inv_view_proj gfx::mat4, prev_view_proj gfx::mat4, to_sun float4, sun_rgb float4, zenith float4, horizon float4, ground float4, env float4, env_rot float4 }
struct AoU { lens float4, tune float4 }
struct ContactU { lens float4, jit float4, sun_v float4, tune float4 }
struct GtaoU { lens float4, tune float4, size float4 }
struct TileU { size float4, lens float4, mode float4 }
struct NearU { size float4, mode float4 }
struct MblurU { size float4, tune float4 }
struct DofU { size float4, lens float4, tune float4 }
