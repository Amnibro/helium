var prev_joints gfx::mat4[>..] = [];
var cur_keys int[>..] = [];
var cur_models gfx::mat4[>..] = [];
var cur_bases int[>..] = [];
var cur_wb int[>..] = [];
var prev_wb int[>..] = [];
var cur_w f32[>..] = [];
var old_w f32[>..] = [];
var cascade_end f32[>..] = [0.0, 0.0, 0.0];
var cascade_vp gfx::mat4[>..] = [];
var cascade_live = 3;
var frames int = 0;
var motion_fresh = true;            // no previous frame to measure motion against

fn f4(x f32, y f32, z f32, w f32) float4 { float4 { x, y, z, w } }
fn x4(v float3, w f32) float4 { float4 { v.x, v.y, v.z, w } }
fn none() gfx::Texture { gfx::Texture { 0 } }

// ---- scene editing

fn add(asset int) int {
	items.push(Item { asset: asset, place: gfx::mat4_identity, prev_place: gfx::mat4_identity, anim: -1, time: 0.0, visible: true, .. });
	items.len - 1
}
fn place(item int, m gfx::mat4) { items[item].place = m; }
fn corner(lo float3, hi float3, k int) float3 { linalg::v3(if k & 1 == 0 { lo.x } else { hi.x }, if k & 2 == 0 { lo.y } else { hi.y }, if k & 4 == 0 { lo.z } else { hi.z }) }
fn asset_box(asset int) float3, float3 {
	motion::rest(asset);
	motion::update(asset, gfx::mat4_identity);
	let a = gltf::assets[asset];
	var lo = linalg::v3(1.0e30, 1.0e30, 1.0e30);
	var hi = linalg::v3(-1.0e30, -1.0e30, -1.0e30);
	for k in a.nodes.count {
		let n = gltf::nodes[a.nodes.first + k];
		if n.mesh < 0 { continue; }
		let mesh = gltf::meshes[n.mesh];
		for pk in mesh.prims.count {
			let pr = gltf::prims[mesh.prims.first + pk];
			for c in 8 {
				let q = linalg::point(motion::world[a.nodes.first + k], corner(pr.lo, pr.hi, c));
				lo = linalg::v3(min(lo.x, q.x), min(lo.y, q.y), min(lo.z, q.z));
				hi = linalg::v3(max(hi.x, q.x), max(hi.y, q.y), max(hi.z, q.z));
			}
		}
	}
	return lo, hi;
}
fn sway(item int, amount f32) {
	let lo, hi = asset_box(items[item].asset);
	items[item].sway = amount;
	items[item].top = hi.y;
}
fn inst_bound(set int, k int) {
	let s = instances[set];
	let m = inst_m[s.first + k];
	let c = linalg::point(m, s.c);
	let sc = linalg::f(sqrt(max(m.c0.x * m.c0.x + m.c0.y * m.c0.y + m.c0.z * m.c0.z, max(m.c1.x * m.c1.x + m.c1.y * m.c1.y + m.c1.z * m.c1.z, m.c2.x * m.c2.x + m.c2.y * m.c2.y + m.c2.z * m.c2.z)) as real));
	inst_c[s.first + k] = f4(c.x, c.y, c.z, s.r * sc);
}
fn add_instances(asset int, mats gfx::mat4[:]) int {
	let lo, hi = asset_box(asset);
	let d = hi - lo;
	instances.push(InstSet { asset: asset, first: inst_m.len, count: mats.len, top: hi.y, c: linalg::mix3(lo, hi, 0.5), r: linalg::f(sqrt(linalg::dot3(d, d) as real)) * 0.5, .. });
	inst_m.append(mats);
	for k in mats.len { inst_c.push(f4(0.0, 0.0, 0.0, 0.0)); inst_bound(instances.len - 1, k); }
	inst_dirty = true;
	instances.len - 1
}
fn set_instance(set int, k int, m gfx::mat4) { inst_m[instances[set].first + k] = m; inst_bound(set, k); inst_dirty = true; }
fn clear_instances() { instances.clear(); inst_m.clear(); inst_c.clear(); inst_dirty = true; }
fn instance_drawn(set int, lod int) int { instances[set].nv[lod] }
fn instance_list(set int, lod int) int[>..] {
	var out int[>..] = [];
	for k in instances[set].nv[lod] { out.push(inst_ids[instances[set].iv[lod] + k] as int); }
	out
}
fn instance_triangles(set int) int {
	var n = 0;
	let s = instances[set];
	for b in batch { if b.inst == set { n += gltf::prims[b.prim].icount / 3 * s.nv[b.lod]; } }
	n
}
fn animate(item int, anim int, time f32) { items[item].anim = anim; items[item].time = time; items[item].anim2 = -1; }
fn crossfade(item int, from int, from_time f32, to int, to_time f32, w f32) { items[item].anim2 = from; items[item].time2 = from_time; items[item].anim = to; items[item].time = to_time; items[item].blend = w; }
fn bend(item int, node int, q linalg::Quat) { items[item].bend_node = node; items[item].bend = q; }
fn track(item int, slot int, node int) { items[item].track[slot] = node; }
fn tracked(item int, slot int) gfx::mat4 { items[item].tracked[slot] }
fn pose(ii int) {
	let it = items[ii];
	motion::rest(it.asset);
	if it.anim2 >= 0 { motion::apply(it.anim2, it.time2, 1.0); }
	if it.anim >= 0 { motion::apply(it.anim, it.time, if it.anim2 >= 0 { it.blend } else { 1.0 }); }
	if it.bend_node >= 0 { motion::pose_r[it.bend_node] = linalg::qmul(motion::pose_r[it.bend_node], it.bend); }
	for o in node_ov { if o.item == ii { motion::pose_t[o.node] = o.t; motion::pose_r[o.node] = o.r; motion::pose_s[o.node] = o.sc; } }
	for o in weight_ov { if o.item == ii { motion::pose_w[o.node * motion::MAX_WEIGHTS + o.k] = o.w; } }
	motion::update(it.asset, it.place);
	for t in 4 { if it.track[t] >= 0 { items[ii].tracked[t] = motion::world[it.track[t]]; } }
}
var node_ov NodeOv[>..] = [];
var weight_ov WeightOv[>..] = [];
fn set_node(item int, node int, t float3, r linalg::Quat, sc float3) {
	for o, k in node_ov { if o.item == item && o.node == node { node_ov[k] = NodeOv { item, node, t, r, sc }; return; } }
	node_ov.push(NodeOv { item, node, t, r, sc });
}
fn set_weight(item int, node int, k int, w f32) {
	if k < 0 || k >= motion::MAX_WEIGHTS { return; }
	for o, j in weight_ov { if o.item == item && o.node == node && o.k == k { weight_ov[j].w = w; return; } }
	weight_ov.push(WeightOv { item, node, k, w });
}
fn clear_pose(item int) {
	var j = 0;
	for k in node_ov.len { if node_ov[k].item != item { node_ov[j] = node_ov[k]; j += 1; } }
	while node_ov.len > j { node_ov.pop(); }
	j = 0;
	for k in weight_ov.len { if weight_ov[k].item != item { weight_ov[j] = weight_ov[k]; j += 1; } }
	while weight_ov.len > j { weight_ov.pop(); }
}
fn add_probe(pos float3, lo float3, hi float3, fade f32) {
	if probes.len >= MAX_PROBES { return; }
	probes.push(Probe { pos: pos, lo: lo, hi: hi, fade: fade });
	probes_dirty = true;
}
fn clear_probes() { probes.clear(); probes_dirty = true; }
fn add_decal(d Decal) int { decals.push(d); decals.len - 1 }
fn clear_decals() { decals.clear(); }
fn recapture() { probes_dirty = true; }
fn probe_vol(p Probe) f32 { (p.hi.x - p.lo.x) * (p.hi.y - p.lo.y) * (p.hi.z - p.lo.z) }
fn add_light(pos float3, rgb float3, range f32) { lights.push(Light { pos, range, rgb, 0, .. }); }
fn studio_soft(bg float3, key f32) {
	sun = Sun { to_sun: linalg::unit3(linalg::v3(0.35, 0.85, 1.0)), rgb: linalg::v3(key, key * 0.985, key * 0.96), shadows: true, shadow_far: 12.0, map_size: 2048, angle: 0.22, reach: 1.5, fit: true, contact: 0.04 };
	lights.clear();
	add_light(linalg::v3(-3.5, 1.1, 4.0), linalg::v3(key * 4.0, key * 4.0, key * 4.2), 40.0);
	sky = Sky { zenith: bg, horizon: bg, ground: bg * 0.55, ambient: 1.0, draw: true };
	look.exposure = 1.0; look.curve = 1; look.bloom = 0.0; look.desaturate = 0.0; look.ssao = true;
}
fn add_rect(pos float3, target float3, axis float3, width f32, height f32, rgb float3, range f32, shadows bool) { lights.push(Light { pos: pos, range: range, rgb: rgb, kind: 0, dir: linalg::unit3(target - pos), shadows: shadows, width: width, height: height, axis: axis, .. }); }
fn rect_axis(l Light) float3 {
	let dv = linalg::unit3(l.dir);
	let a = l.axis - dv * linalg::dot3(l.axis, dv);
	return if linalg::dot3(a, a) > 1.0e-6 { linalg::unit3(a) } else { linalg::unit3(linalg::cross3(dv, if abs(dv.y) < 0.9 { linalg::v3(0.0, 1.0, 0.0) } else { linalg::v3(1.0, 0.0, 0.0) })) };
}
fn add_spot(pos float3, target float3, rgb float3, range f32, cone f32, shadows bool) { lights.push(Light { pos: pos, range: range, rgb: rgb, kind: 1, dir: linalg::unit3(target - pos), cone: cone, shadows: shadows, .. }); }
fn quad(a float3, b float3, c float3, d float3, ca float4, cb float4, cc float4, cd float4, shape int) { quads.push(QuadG { [x4(a, 1.0), x4(b, 1.0), x4(c, 1.0), x4(d, 1.0)], [ca, cb, cc, cd], f4(shape as f32, 0.0, 0.0, 0.0) }); }
fn glow_line(a float3, b float3, w f32, rgb float3) {
	let mid = (a + b) * 0.5;
	let ab = b - a;
	let em = view.eye - mid;
	var side = linalg::cross3(ab, em);
	let l = sqrt(linalg::dot3(side, side));
	if l < 1.0e-6 { return; }
	let sn = clamp(l / max(sqrt(linalg::dot3(ab, ab)) * sqrt(linalg::dot3(em, em)), 1.0e-6), 0.2, 1.0);
	side = side * (w * 0.5 * sn / l);
	let c = x4(rgb, 1.0);
	quad(a - side, a + side, b + side, b - side, c, c, c, c, 0);
}
fn ground_mark(p float3, r f32, rgb float3, a f32, shape int) {
	let c = x4(rgb, a);
	quad(linalg::v3(p.x - r, p.y, p.z - r), linalg::v3(p.x - r, p.y, p.z + r), linalg::v3(p.x + r, p.y, p.z + r), linalg::v3(p.x + r, p.y, p.z - r), c, c, c, c, shape);
}
var quad_nadd = 0;
fn quad_upload() {
	if quads.len == 0 { return; }
	var o QuadG[>..] = [];
	for q in quads { if q.prm.x < 7.5 { o.push(q); } }
	quad_nadd = o.len;
	for q in quads { if q.prm.x >= 7.5 { o.push(q); } }
	if o.len > quad_cap {
		if quad_cap > 0 { gfx::release(quad_buf); }
		quad_cap = max(o.len * 2, 256);
		quad_buf = gfx::buffer(gfx::BUFFER_STORAGE, quad_cap * 144, []);
	}
	gfx::update_buffer(quad_buf, 0, bytes_of(o)[..o.len * 144]);
}
fn quad_draw(mul bool) {
	let first = if mul { quad_nadd } else { 0 };
	let n = if mul { quads.len - quad_nadd } else { quad_nadd };
	if n <= 0 { return; }
	gfx::bind(if mul { pipe_quad_mul } else { pipe_quad_add });
	gfx::bind_storage_buffer(gfx::VERTEX, 0, quad_buf);
	let fwd = forward();
	let right = linalg::unit3(linalg::cross3(fwd, view.up));
	let up = linalg::cross3(right, fwd);
	gfx::uniforms(gfx::VERTEX, 0, QuadViewU { view_proj, x4(right, 0.0), x4(up, 0.0) });
	gfx::draw(n * 6, 1, first * 6, 0);
}
fn hdr_target() gfx::Texture { hdr }
// Valid after a frame that wrote motion (motion_wanted()); a null handle before any.
fn motion_target() gfx::Texture { motion_tex }
fn ao_target() gfx::Texture { ao }
fn bent_target() gfx::Texture { bent }
fn nd_target() gfx::Texture { nd }
fn motion_wanted() bool { motion_vectors || temporal_on() || motion_blur > 0.0 }
// The image bloom and grading read: the temporal result when it ran, else `hdr`.
fn resolved() gfx::Texture { if temporal_used { history[hist_cur] } else { hdr } }
fn temporal_on() bool { temporal != 0 || out_width != width || out_height != height }

// ---- setup

fn surface_desc(cull i32, blend i32, depth_write bool) gfx::PipelineDesc {
	gfx::PipelineDesc { cull: cull, depth_test: true, depth_write: depth_write, blend: blend, depth_compare: gfx::COMPARE_LESS_EQUAL }
}

fn drop_targets() {
	for t in [color_ms, depth_ms, hdr, nd, nd_depth, ao_raw, ao, lin_depth, bent_raw, bent, fx, tile_a, tile_b, contact_tex] { gfx::release(t); }
	drop_motion();
	drop_ssr();
	for t in glow { gfx::release(t); }
	for t in history { gfx::release(t); }
}

fn make_targets(w int, h int) { make_targets(w, h, w, h); }

// w x h is the render size; ow x oh the size of the temporal result, bloom and the
// caller's target.
fn make_targets(w int, h int, ow int, oh int) {
	if width > 0 { drop_targets(); }
	width = w;
	height = h;
	out_width = ow;
	out_height = oh;
	history.clear();
	for k in 2 { history.push(gfx::render_target(ow, oh, gfx::RGBA16F)); }
	hist_valid = false;
	color_ms = gfx::texture(gfx::TextureDesc { format: gfx::RGBA16F, usage: gfx::COLOR_TARGET, width: w as i32, height: h as i32, samples: MSAA as i32 });
	depth_ms = gfx::texture(gfx::TextureDesc { format: gfx::DEPTH32F, usage: gfx::DEPTH_TARGET, width: w as i32, height: h as i32, samples: MSAA as i32 });
	hdr = gfx::render_target(w, h, gfx::RGBA16F);
	nd = gfx::render_target(w, h, gfx::RGBA16F);
	nd_depth = gfx::texture(gfx::TextureDesc { format: gfx::DEPTH32F, usage: gfx::DEPTH_TARGET, width: w as i32, height: h as i32 });
	ao_raw = gfx::render_target(w, h, gfx::RG16F);
	ao = gfx::render_target(w, h, gfx::R16F);
	contact_tex = gfx::render_target(w, h, gfx::RG16F);
	lin_depth = gfx::render_target(w, h, gfx::R32F);
	bent_raw = gfx::render_target(w, h, gfx::RGBA16F);
	bent = gfx::render_target(w, h, gfx::RGBA16F);
	fx = gfx::render_target(w, h, gfx::RGBA16F);
	let tw = max((w + lens_tile_px - 1) / lens_tile_px, 1); let th = max((h + lens_tile_px - 1) / lens_tile_px, 1);
	tile_a = gfx::render_target(tw, th, gfx::RG16F);
	tile_b = gfx::render_target(tw, th, gfx::RG16F);
	glow.clear();
	var gw = max(ow / 2, 1);
	var gh = max(oh / 2, 1);
	for k in GLOW_LEVELS {
		glow.push(gfx::render_target(gw, gh, gfx::RGBA16F));
		gw = max(gw / 2, 1);
		gh = max(gh / 2, 1);
	}
}

// The motion target (one sample per pixel, 8 bytes a pixel) is made on the first
// frame that wants it.
fn make_motion() {
	if motion_tex.id != 0 { return; }
	motion_tex = gfx::render_target(width, height, gfx::RGBA16F);
}

fn drop_motion() {
	if motion_tex.id == 0 { return; }
	gfx::release(motion_tex);
	motion_tex = none();
}

fn make_ssr() {
	if hiz.len == 0 {
		var w = width;
		var h = height;
		for k in HIZ_LEVELS {
			w = (w + 1) / 2;
			h = (h + 1) / 2;
			hiz.push(gfx::render_target(w, h, gfx::R32F));
		}
		ssr_prev = gfx::texture(gfx::TextureDesc { format: gfx::RGBA16F, usage: gfx::SAMPLED | gfx::COLOR_TARGET, width: width as i32, height: height as i32, mips: 0 });
		ssr_have = false;
	}
	if ssr_on && ssr_hit.id == 0 { ssr_hit = gfx::render_target(width, height, gfx::RGBA32F); }
}
fn make_ssgi() {
	if ssgi_new.id != 0 { return; }
	let hw = (width + 1) / 2;
	let hh = (height + 1) / 2;
	ssgi_new = gfx::render_target(hw, hh, gfx::RGBA16F);
	for k in 2 {
		ssgi_hc.push(gfx::render_target(hw, hh, gfx::RGBA16F));
		ssgi_hz.push(gfx::render_target(hw, hh, gfx::RG32F));
	}
	ssgi_buf = gfx::buffer(gfx::BUFFER_STORAGE | gfx::BUFFER_COMPUTE_WRITE, width * height * 8, []);
	ssgi_valid = false;
}
fn drop_ssr() {
	for t in hiz { gfx::release(t); }
	hiz.clear();
	if ssr_hit.id != 0 { gfx::release(ssr_hit); }
	if ssr_prev.id != 0 { gfx::release(ssr_prev); }
	ssr_hit = none();
	ssr_prev = none();
	ssr_have = false;
	if ssgi_new.id == 0 { return; }
	gfx::release(ssgi_new);
	for t in ssgi_hc { gfx::release(t); }
	for t in ssgi_hz { gfx::release(t); }
	ssgi_hc.clear();
	ssgi_hz.clear();
	gfx::release(ssgi_buf);
	ssgi_new = none();
	ssgi_valid = false;
}
fn make_shadow_map(size int) {
	shadow_size = size;
	shadow_map = gfx::texture(gfx::TextureDesc { kind: gfx::TEXTURE_2D_ARRAY, format: gfx::DEPTH32F, usage: gfx::DEPTH_TARGET | gfx::SAMPLED, width: size as i32, height: size as i32, depth: CASCADES as i32 });
}

fn pixel_texture(rgba byte[4], format i32) gfx::Texture {
	let t = gfx::texture2d(1, 1, format, gfx::SAMPLED);
	gfx::update_texture(t, rgba[..]);
	t
}

// Creates targets and pipelines; gfx must be open. Safe to call again after a resize.
fn init(w int, h int) bool { init(w, h, w, h) }

// Renders at w x h and writes ow x oh: with a larger output the temporal pass
// upscales (TSR). The caller's target must be ow x oh.
fn init(w int, h int, ow int, oh int) bool {
	if ready {
		if w != width || h != height || ow != out_width || oh != out_height { make_targets(w, h, ow, oh); }
		return true;
	}
	let vs = embed_shader("shaders/surface.vert");
	let fs = embed_shader("shaders/surface.frag");
	let scr = embed_shader("shaders/screen.vert");
	pipe_lit = gfx::pipeline(vs, fs, surface_desc(gfx::CULL_BACK, gfx::BLEND_NONE, true));
	pipe_lit_two = gfx::pipeline(vs, fs, surface_desc(gfx::CULL_NONE, gfx::BLEND_NONE, true));
	pipe_cut = gfx::pipeline(vs, fs, gfx::PipelineDesc { cull: gfx::CULL_BACK, depth_test: true, depth_write: true, depth_compare: gfx::COMPARE_LESS_EQUAL, alpha_to_coverage: true });
	pipe_cut_two = gfx::pipeline(vs, fs, gfx::PipelineDesc { cull: gfx::CULL_NONE, depth_test: true, depth_write: true, depth_compare: gfx::COMPARE_LESS_EQUAL, alpha_to_coverage: true });
	pipe_blend = gfx::pipeline(vs, fs, surface_desc(gfx::CULL_BACK, gfx::BLEND_ALPHA, false));
	pipe_blend_back = gfx::pipeline(vs, fs, surface_desc(gfx::CULL_FRONT, gfx::BLEND_ALPHA, false));
	var sd = surface_desc(gfx::CULL_NONE, gfx::BLEND_NONE, true);
	sd.depth_bias = 1.5;
	sd.depth_bias_slope = 2.0;
	pipe_shadow = gfx::pipeline(vs, embed_shader("shaders/depth_only.frag"), sd);
	pipe_shelter = gfx::pipeline(vs, embed_shader("shaders/shelter.frag"), surface_desc(gfx::CULL_NONE, gfx::BLEND_NONE, true));
	pipe_normals = gfx::pipeline(vs, embed_shader("shaders/normals.frag"), surface_desc(gfx::CULL_BACK, gfx::BLEND_NONE, true));
	pipe_normals_two = gfx::pipeline(vs, embed_shader("shaders/normals.frag"), surface_desc(gfx::CULL_NONE, gfx::BLEND_NONE, true));
	pipe_sky = gfx::pipeline(scr, embed_shader("shaders/sky.frag"));
	envmap::setup();
	pipe_sky_motion = gfx::pipeline(scr, embed_shader("shaders/sky_motion.frag"));
	pipe_ao = gfx::pipeline(scr, embed_shader("shaders/ssao.frag"));
	pipe_ao_blur = gfx::pipeline(scr, embed_shader("shaders/ssao_blur.frag"));
	pipe_gtao = gfx::pipeline(scr, embed_shader("shaders/gtao.frag"));
	pipe_contact = gfx::pipeline(scr, embed_shader("shaders/contact.frag"));
	pipe_lens_tile = gfx::pipeline(scr, embed_shader("shaders/lens_tile.frag"));
	pipe_lens_near = gfx::pipeline(scr, embed_shader("shaders/lens_near.frag"));
	pipe_mblur = gfx::pipeline(scr, embed_shader("shaders/mblur.frag"));
	pipe_dof = gfx::pipeline(scr, embed_shader("shaders/dof.frag"));
	pipe_dof_pack = gfx::pipeline(scr, embed_shader("shaders/dof_pack.frag"));
	pipe_gtao_blur = gfx::pipeline(scr, embed_shader("shaders/gtao_blur.frag"));
	pipe_hiz = gfx::pipeline(scr, embed_shader("shaders/hiz.frag"));
	pipe_ssr = gfx::pipeline(scr, embed_shader("shaders/ssr_trace.frag"));
	pipe_ssr_copy = gfx::pipeline(scr, embed_shader("shaders/ssr_copy.frag"));
	pipe_ssgi_trace = gfx::pipeline(scr, embed_shader("shaders/ssgi_trace.frag"));
	pipe_ssgi_accum = gfx::pipeline(scr, embed_shader("shaders/ssgi_accum.frag"));
	pipe_ssgi_up = gfx::compute_pipeline(embed_shader("shaders/ssgi_up.comp"));
	pipe_fog = gfx::pipeline(scr, embed_shader("shaders/fog.frag"));
	pipe_quad_add = gfx::pipeline(embed_shader("shaders/quad.vert"), embed_shader("shaders/quad.frag"), gfx::PipelineDesc { depth_test: true, depth_write: false, blend: gfx::BLEND_ADD, depth_compare: gfx::COMPARE_LESS_EQUAL });
	pipe_quad_mul = gfx::pipeline(embed_shader("shaders/quad.vert"), embed_shader("shaders/quad.frag"), gfx::PipelineDesc { depth_test: true, depth_write: false, blend: gfx::BLEND_MULTIPLY, depth_compare: gfx::COMPARE_LESS_EQUAL });
	pipe_gi_trace = gfx::compute_pipeline(embed_shader("shaders/gi_trace.comp"));
	pipe_gi_update = gfx::compute_pipeline(embed_shader("shaders/gi_update.comp"));
	gi_dummy = gfx::buffer(gfx::BUFFER_STORAGE | gfx::BUFFER_COMPUTE_READ, 64, []);
	pipe_bright = gfx::pipeline(scr, embed_shader("shaders/glow_bright.frag"));
	pipe_down = gfx::pipeline(scr, embed_shader("shaders/glow_down.frag"));
	pipe_up = gfx::pipeline(scr, embed_shader("shaders/glow_up.frag"), gfx::PipelineDesc { blend: gfx::BLEND_ADD });
	pipe_grade = gfx::pipeline(scr, embed_shader("shaders/post.frag"));
	pipe_temporal = gfx::pipeline(scr, embed_shader("shaders/temporal.frag"));
	pipe_hist = gfx::compute_pipeline(embed_shader("shaders/expo_hist.comp"));
	pipe_adapt = gfx::compute_pipeline(embed_shader("shaders/expo_adapt.comp"));
	let rwb = gfx::BUFFER_STORAGE | gfx::BUFFER_COMPUTE_READ | gfx::BUFFER_COMPUTE_WRITE;
	var z u32[128] = [0; 128];
	hist_buf = gfx::buffer(rwb, 512, bytes_of(z)[..]);
	let one f32[4] = [1.0, 0.0, 0.0, 0.0];
	expo_buf = gfx::buffer(rwb, 16, bytes_of(one)[..]);
	if lut_n == 0 { identity_lut(17); }
	smp_linear = gfx::sampler(gfx::LINEAR, gfx::CLAMP);
	smp_point = gfx::sampler(gfx::NEAREST, gfx::CLAMP);
	smp_shadow = gfx::shadow_sampler();
	smp_ext = gfx::sampler(gfx::SamplerDesc { min_filter: gfx::LINEAR, mag_filter: gfx::LINEAR, mip_filter: gfx::LINEAR, wrap_u: gfx::REPEAT, wrap_v: gfx::REPEAT, wrap_w: gfx::CLAMP, max_anisotropy: 8.0 });
	smp_trans = gfx::sampler(gfx::SamplerDesc { min_filter: gfx::LINEAR, mag_filter: gfx::LINEAR, mip_filter: gfx::LINEAR, wrap_u: gfx::CLAMP, wrap_v: gfx::CLAMP, wrap_w: gfx::CLAMP });
	pipe_ext_copy = gfx::pipeline(scr, embed_shader("shaders/ext_copy.frag"));
	pipe_trans_copy = gfx::pipeline(embed_shader("shaders/screen.vert"), embed_shader("shaders/trans_copy.frag"));
	pipe_probe_copy = gfx::pipeline(scr, embed_shader("shaders/probe_copy.frag"));
	white = pixel_texture([255, 255, 255, 255], gfx::RGBA8);
	flat_normal = pixel_texture([128, 128, 255, 255], gfx::RGBA8);
	make_targets(w, h, ow, oh);
	make_shadow_map(sun.map_size);
	jbuf_cap = 64;
	jbuf = gfx::buffer(gfx::BUFFER_STORAGE, jbuf_cap * 64, []);
	ready = true;
	ready
}

// ---- resources from the gltf pools

// Call after gltf::reset(): drops GPU copies of geometry and images so the next
// frame uploads the new pools.
fn forget() {
	node_ov.clear();
	weight_ov.clear();
	for t in tex_srgb { if t.id != 0 { gfx::release(t); } }
	for t in tex_linear { if t.id != 0 { gfx::release(t); } }
	tex_srgb.clear();
	tex_linear.clear();
	tex_mem = 0;
	streams.clear();
	stream_pool.clear();
	stream_lv.clear();
	stream_mem = 0;
	uv_dens.clear();
	ext_map.clear();
	ext_src.clear();
	decals.clear();
	clear_instances();
	pushers.clear();
	prev_pushers.clear();
	wind_fresh = true;
	ext_cnt[0] = 0;
	ext_cnt[1] = 0;
	if uploaded_verts >= 0 { uploaded_verts = -2; }
	if uploaded_indices >= 0 { uploaded_indices = -2; }
	if uploaded_morphs >= 0 { uploaded_morphs = -2; }
	// a new scene: no last-frame placement, camera or history to measure against
	prev_keys.clear(); prev_models.clear(); prev_bases.clear(); prev_joints.clear();
	motion_fresh = true;
	temporal_reset = true;
	gi_built = false;
}

fn upload_geometry() {
	if gltf::verts.len != uploaded_verts {
		if uploaded_verts >= 0 || uploaded_verts == -2 { gfx::release(vbuf); }
		var bytes = bytes_of(gltf::verts);
		if gltf::verts.len == 0 { vbuf = gfx::buffer(gfx::BUFFER_VERTEX, 104, []); }
		else { vbuf = gfx::buffer(gfx::BUFFER_VERTEX, bytes.len, bytes[..]); }
		uploaded_verts = gltf::verts.len;
	}
	if gltf::indices.len != uploaded_indices {
		if uploaded_indices >= 0 || uploaded_indices == -2 { gfx::release(ibuf); }
		if gltf::indices.len == 0 { ibuf = gfx::buffer(gfx::BUFFER_INDEX, 4, []); }
		else { let bytes = bytes_of(gltf::indices); ibuf = gfx::buffer(gfx::BUFFER_INDEX, bytes.len, bytes[..]); }
		uploaded_indices = gltf::indices.len;
	}
	if gltf::morphs.len != uploaded_morphs {
		if uploaded_morphs >= 0 || uploaded_morphs == -2 { gfx::release(mbuf); }
		if gltf::morphs.len == 0 { mbuf = gfx::buffer(gfx::BUFFER_STORAGE, 32, []); }
		else { let bytes = bytes_of(gltf::morphs); mbuf = gfx::buffer(gfx::BUFFER_STORAGE, bytes.len, bytes[..]); }
		uploaded_morphs = gltf::morphs.len;
	}
	while tex_srgb.len < gltf::images.len { tex_srgb.push(none()); tex_linear.push(none()); }
}

fn mip_count(w int, h int) int {
	var n = 1;
	var s = max(w, h);
	while s > 1 { s = s / 2; n += 1; }
	n
}

fn chain_bytes(kind int, w int, h int, levels int) int {
	var n = 0;
	for k in levels { n += ktx2::level_size(kind, w, h, k); }
	n
}
fn tex_path(image int, srgb bool, out byte[>..]&) {
	let im = gltf::images[image];
	if im.coded.count == 0 { gltf::need_pixels(image); }
	let src = if im.coded.count > 0 { gltf::image_file(image) } else { gltf::image_pixels(image) };
	var a = 2166136261;
	var b = 7;
	let words = src.len / 4;
	for k in words { let v = src[k * 4] as int | (src[k * 4 + 1] as int << 8) | (src[k * 4 + 2] as int << 16) | (src[k * 4 + 3] as int << 24); a = ((a ^ v) * 16777619) & 0xFFFFFFFF; b = (b * 31 + v + 7) & 0xFFFFFFFFFFFF; }
	for c in src[words * 4..] { a = ((a ^ c as int) * 16777619) & 0xFFFFFFFF; b = (b * 31 + c as int + 7) & 0xFFFFFFFFFFFF; }
	out.append(tex_cache[..]);
	out.push('/');
	for k in 20 { let v = (if k < 8 { a >> (28 - 4 * k) } else { b >> (44 - 4 * (k - 8)) }) & 15; out.push((if v < 10 { '0' as int + v } else { 'a' as int + v - 10 }) as byte); }
	out.append(str("_", im.width, "x", im.height, if srgb { "s" } else { "l" }, ".ktx2")[..]);
}
fn tex_bake(image int, srgb bool, path const byte[:], file byte[>..]&, mode int) bool {
	let im = gltf::images[image];
	let mips = mip_count(im.width, im.height);
	if path.len > 0 && mode < 2 {
		file.clear();
		if (if mode == 1 { read_file_range(path, 0, 512, file) } else { read_file(path, file) }) {
			tex_read += file.len;
			let info = if mode == 1 { ktx2::head(file[..]) } else { ktx2::read(file[..]) };
			if info.ok && info.kind == bc::BC7 && info.width == im.width && info.height == im.height && info.levels == mips && info.srgb == srgb { tex_cached += 1; return true; }
		}
	}
	file.clear();
	gltf::need_pixels(image);
	var cur byte[>..] = [];
	cur.append(gltf::image_pixels(image));
	var data byte[>..] = [];
	var blk byte[>..] = [];
	var nxt byte[>..] = [];
	var w = im.width;
	var h = im.height;
	for k in mips {
		if !bc::encode(bc::BC7, cur[..], w, h, blk) { return false; }
		data.append(blk[..]);
		if k + 1 < mips { let nw, nh = bc::halve(cur[..], w, h, srgb, nxt); cur.clear(); cur.append(nxt[..]); w = nw; h = nh; }
	}
	if !ktx2::write(bc::BC7, srgb, im.width, im.height, mips, data[..], false, file) { return false; }
	tex_encoded += 1;
	if path.len > 0 { let _ = make_dir(tex_cache[..]); let _ = write_file_atomic(path, file[..]); }
	true
}
fn tex_format(kind int, srgb bool) i32 {
	if kind == bc::BC1 { if srgb { gfx::BC1_SRGB } else { gfx::BC1 } } else if kind == bc::BC3 { if srgb { gfx::BC3_SRGB } else { gfx::BC3 } } else if kind == bc::BC4 { gfx::BC4 } else if kind == bc::BC5 { gfx::BC5 } else if kind == bc::BC7 { if srgb { gfx::BC7_SRGB } else { gfx::BC7 } } else if srgb { gfx::RGBA8_SRGB } else { gfx::RGBA8 }
}
fn ktx_texture(file const byte[:], srgb bool) gfx::Texture {
	let info = ktx2::read(file);
	if !info.ok { return none(); }
	let fmt = tex_format(info.kind, srgb);
	let gpu = info.kind != 0 && tex_gpu_bc && info.width % 4 == 0 && info.height % 4 == 0 && gfx::format_supported(fmt);
	let full = mip_count(info.width, info.height);
	let regen = !gpu && info.levels == 1 && full > 1;
	let t = gfx::texture(gfx::TextureDesc { format: if gpu { fmt } else { tex_format(0, srgb) }, usage: if regen { gfx::SAMPLED | gfx::COLOR_TARGET } else { gfx::SAMPLED }, width: info.width as i32, height: info.height as i32, mips: (if regen { full } else { info.levels }) as i32 });
	var lv byte[>..] = [];
	var px byte[>..] = [];
	for n in info.levels {
		if ktx2::level(file, info, n, lv) {
			if gpu || info.kind == 0 { gfx::update_texture(t, gfx::Region { mip: n as i32, .. }, lv[..]); }
			else if bc::decode(info.kind, lv[..], max(info.width >> n, 1), max(info.height >> n, 1), px) { gfx::update_texture(t, gfx::Region { mip: n as i32, .. }, px[..]); }
		}
	}
	if regen { gfx::generate_mips(t); }
	tex_mem += if gpu { chain_bytes(info.kind, info.width, info.height, info.levels) } else { chain_bytes(0, info.width, info.height, if regen { full } else { info.levels }) };
	t
}
fn stream_chain(s TexStream, n int) int { stream_lv[s.lv + n * 3 + 2] }
fn stream_tail(w int, h int, levels int, blocks bool) int {
	var t = 0;
	while t + 1 < levels && max(w >> (t + 1), h >> (t + 1)) >= 128 && (!blocks || ((w >> (t + 1)) % 4 == 0 && (h >> (t + 1)) % 4 == 0)) { t += 1; }
	t
}
fn stream_fetch(si int, a int, b int, out byte[>..]&) bool {
	let s = streams[si];
	out.clear();
	if a < 0 || b < a { return false; }
	if s.src == 1 {
		let ok = read_file_range(stream_pool[s.at..s.at + s.len], a, b - a, out);
		tex_read += out.len;
		return ok && out.len == b - a;
	}
	if s.src == 0 {
		let f = gltf::image_file(si / 2);
		if b > f.len { return false; }
		out.append(f[a..b]);
		return true;
	}
	if b > s.len { return false; }
	out.append(stream_pool[s.at + a..s.at + b]);
	true
}
fn stream_build(si int, top int) {
	let s = streams[si];
	let image = si / 2;
	let srgb = si % 2 == 1;
	let n = s.info.levels;
	var a = stream_lv[s.lv + top * 3];
	var b = a + stream_lv[s.lv + top * 3 + 1];
	for k in top..n { a = min(a, stream_lv[s.lv + k * 3]); b = max(b, stream_lv[s.lv + k * 3] + stream_lv[s.lv + k * 3 + 1]); }
	var buf byte[>..] = [];
	var lv byte[>..] = [];
	var px byte[>..] = [];
	var good = stream_fetch(si, a, b, buf);
	let t = gfx::texture(gfx::TextureDesc { format: if s.gpu { tex_format(s.info.kind, srgb) } else { tex_format(0, srgb) }, usage: gfx::SAMPLED, width: max(s.info.width >> top, 1) as i32, height: max(s.info.height >> top, 1) as i32, mips: (n - top) as i32 });
	var up = 0;
	for attempt in 2 {
		if good && (attempt == 0 || up == 0) {
			up = 0;
			for k in top..n {
				let o = stream_lv[s.lv + k * 3] - a;
				let l = stream_lv[s.lv + k * 3 + 1];
				if good && o >= 0 && o + l <= buf.len && ktx2::unpack(buf[o..o + l], s.info, k, lv) {
					if s.gpu || s.info.kind == 0 { gfx::update_texture(t, gfx::Region { mip: (k - top) as i32, .. }, lv[..]); up += lv.len; }
					else if bc::decode(s.info.kind, lv[..], max(s.info.width >> k, 1), max(s.info.height >> k, 1), px) { gfx::update_texture(t, gfx::Region { mip: (k - top) as i32, .. }, px[..]); up += px.len; }
				} else { good = false; }
			}
		}
		if !good && attempt == 0 && s.src == 1 {
			var path byte[>..] = [];
			path.append(stream_pool[s.at..s.at + s.len]);
			good = tex_bake(image, srgb, path[..], buf, 2);
			a = 0;
			up = 0;
			if good { for k in n { let o, l = ktx2::span(buf[..], s.info, k); stream_lv[s.lv + k * 3] = o; stream_lv[s.lv + k * 3 + 1] = l; } }
		}
	}
	let old = if srgb { tex_srgb[image] } else { tex_linear[image] };
	if s.top >= 0 {
		if old.id != 0 { gfx::release(old); }
		tex_mem -= stream_chain(s, s.top);
		stream_mem -= stream_chain(s, s.top);
	}
	tex_mem += stream_chain(s, top);
	stream_mem += stream_chain(s, top);
	if srgb { tex_srgb[image] = t; } else { tex_linear[image] = t; }
	streams[si].top = top;
	tex_streamed += up;
	tex_steps += 1;
}
fn stream_open(image int, srgb bool) bool {
	let im = gltf::images[image];
	var file byte[>..] = [];
	var path byte[>..] = [];
	var src = 0;
	if im.ktx {
		let f = gltf::image_file(image);
		if !ktx2::read(f).ok { return false; }
		file.append(f[..min(f.len, 512)]);
	} else if tex_compress && im.ok && im.width % 4 == 0 && im.height % 4 == 0 {
		if stream_tail(im.width, im.height, mip_count(im.width, im.height), tex_gpu_bc && gfx::format_supported(tex_format(bc::BC7, srgb))) == 0 { return false; }
		if tex_cache.len > 0 { tex_path(image, srgb, path); }
		if !tex_bake(image, srgb, path[..], file, 1) { return false; }
		src = if path.len > 0 { 1 } else { 2 };
	} else { return false; }
	let info = ktx2::head(file[..]);
	if !info.ok { return false; }
	let gpu = info.kind != 0 && tex_gpu_bc && info.width % 4 == 0 && info.height % 4 == 0 && gfx::format_supported(tex_format(info.kind, srgb));
	let tail = stream_tail(info.width, info.height, info.levels, gpu);
	if tail == 0 { return false; }
	let si = image * 2 + (if srgb { 1 } else { 0 });
	while streams.len <= si { streams.push(TexStream { on: false, .. }); }
	streams[si] = TexStream { on: true, src: src, info: info, gpu: gpu, top: -1, want: tail, tail: tail, idle: 0, low: tail, tgt: tail, at: stream_pool.len, len: if src == 1 { path.len } else if src == 2 { file.len } else { 0 }, lv: stream_lv.len };
	if src == 1 { stream_pool.append(path[..]); } else if src == 2 { stream_pool.append(file[..]); }
	let base = stream_lv.len;
	for k in info.levels { let o, l = ktx2::span(file[..], info, k); stream_lv.push(o); stream_lv.push(l); stream_lv.push(0); }
	var sum = 0;
	for j in info.levels {
		let k = info.levels - 1 - j;
		sum += ktx2::level_size(if gpu { info.kind } else { 0 }, info.width, info.height, k);
		stream_lv[base + k * 3 + 2] = sum;
	}
	stream_build(si, tail);
	true
}
fn stream_at(image int, srgb bool) int {
	let si = image * 2 + (if srgb { 1 } else { 0 });
	if si < streams.len && streams[si].on { si } else { -1 }
}
fn image_texture(image int, srgb bool) gfx::Texture {
	let have = if srgb { tex_srgb[image] } else { tex_linear[image] };
	if have.id != 0 { return have; }
	let im = gltf::images[image];
	let t0 = clock_ns();
	if tex_stream && stream_open(image, srgb) { tex_ns += clock_ns() - t0; return if srgb { tex_srgb[image] } else { tex_linear[image] }; }
	var t = none();
	var file byte[>..] = [];
	var path byte[>..] = [];
	if im.ktx { t = ktx_texture(gltf::image_file(image), srgb); }
	else if tex_compress && im.ok && im.width % 4 == 0 && im.height % 4 == 0 {
		if tex_cache.len > 0 { tex_path(image, srgb, path); }
		if tex_bake(image, srgb, path[..], file, 0) { t = ktx_texture(file[..], srgb); }
	}
	if t.id == 0 {
		let mips = mip_count(im.width, im.height);
		t = gfx::texture(gfx::TextureDesc { format: tex_format(0, srgb), usage: gfx::SAMPLED | gfx::COLOR_TARGET, width: im.width as i32, height: im.height as i32, mips: mips as i32 });
		gltf::need_pixels(image);
		gfx::update_texture(t, gltf::image_pixels(image));
		if mips > 1 { gfx::generate_mips(t); }
		tex_mem += chain_bytes(0, im.width, im.height, mips);
	}
	tex_ns += clock_ns() - t0;
	if srgb { tex_srgb[image] = t; } else { tex_linear[image] = t; }
	t
}
fn full_texture(image int, srgb bool) gfx::Texture {
	let t = image_texture(image, srgb);
	let si = stream_at(image, srgb);
	if si < 0 { return t; }
	let s = streams[si];
	var n = 0;
	while n < s.tail && max(s.info.width >> (n + 1), s.info.height >> (n + 1)) >= ext_size { n += 1; }
	if s.top > n { stream_build(si, n); }
	streams[si].idle = 0;
	if srgb { tex_srgb[image] } else { tex_linear[image] }
}
fn uv_density(prim int, set int) f32 {
	while uv_dens.len <= prim * 2 + 1 { uv_dens.push(-1.0); }
	if uv_dens[prim * 2 + set] >= 0.0 { return uv_dens[prim * 2 + set]; }
	let pr = gltf::prims[prim];
	let uo = 7 + 2 * set - 1;
	var best real = 1.0e30;
	for t in pr.icount / 3 {
		let a = (pr.vfirst + gltf::indices[pr.ifirst + t * 3] as int) * gltf::VERTEX_FLOATS;
		let b = (pr.vfirst + gltf::indices[pr.ifirst + t * 3 + 1] as int) * gltf::VERTEX_FLOATS;
		let c = (pr.vfirst + gltf::indices[pr.ifirst + t * 3 + 2] as int) * gltf::VERTEX_FLOATS;
		let e1 = linalg::v3(gltf::verts[b] - gltf::verts[a], gltf::verts[b + 1] - gltf::verts[a + 1], gltf::verts[b + 2] - gltf::verts[a + 2]);
		let e2 = linalg::v3(gltf::verts[c] - gltf::verts[a], gltf::verts[c + 1] - gltf::verts[a + 1], gltf::verts[c + 2] - gltf::verts[a + 2]);
		let l1 = sqrt(linalg::dot3(e1, e1) as real);
		let x2 = if l1 > 0.0 { linalg::dot3(e2, e1) as real / l1 } else { 0.0 };
		let y2 = sqrt(max(linalg::dot3(e2, e2) as real - x2 * x2, 0.0));
		if l1 > 1.0e-12 && y2 > 1.0e-12 {
			let ax = (gltf::verts[b + uo] - gltf::verts[a + uo]) as real / l1;
			let ay = (gltf::verts[b + uo + 1] - gltf::verts[a + uo + 1]) as real / l1;
			let bx = ((gltf::verts[c + uo] - gltf::verts[a + uo]) as real - ax * x2) / y2;
			let by = ((gltf::verts[c + uo + 1] - gltf::verts[a + uo + 1]) as real - ay * x2) / y2;
			let tt = ax * ax + ay * ay + bx * bx + by * by;
			let dd = abs(ax * by - ay * bx);
			let big = sqrt((tt + sqrt(max(tt * tt - 4.0 * dd * dd, 0.0))) * 0.5);
			best = min(best, if big > 0.0 { dd / big } else { 0.0 });
		}
	}
	uv_dens[prim * 2 + set] = if best > 1.0e29 { 0.0 } else { best as f32 };
	uv_dens[prim * 2 + set]
}
fn stream_reach(b Batch, pr gltf::Primitive) f32 {
	var lo = linalg::v3(1.0e30, 1.0e30, 1.0e30);
	var hi = linalg::v3(-1.0e30, -1.0e30, -1.0e30);
	if b.inst >= 0 { lo = instances[b.inst].lo; hi = instances[b.inst].hi; }
	else {
		for k in 8 {
			let c = linalg::point(b.model, linalg::v3(if k & 1 == 0 { pr.lo.x } else { pr.hi.x }, if k & 2 == 0 { pr.lo.y } else { pr.hi.y }, if k & 4 == 0 { pr.lo.z } else { pr.hi.z }));
			lo = linalg::v3(min(lo.x, c.x), min(lo.y, c.y), min(lo.z, c.z));
			hi = linalg::v3(max(hi.x, c.x), max(hi.y, c.y), max(hi.z, c.z));
		}
	}
	let dx = max(max(lo.x - view.eye.x, view.eye.x - hi.x), 0.0);
	let dy = max(max(lo.y - view.eye.y, view.eye.y - hi.y), 0.0);
	let dz = max(max(lo.z - view.eye.z, view.eye.z - hi.z), 0.0);
	let r = max(linalg::f(sqrt((dx * dx + dy * dy + dz * dz) as real)) - linalg::f(sqrt((lens_offset.x * lens_offset.x + lens_offset.y * lens_offset.y) as real)), view.near);
	let m = b.model;
	let g01 = abs(m.c0.x * m.c1.x + m.c0.y * m.c1.y + m.c0.z * m.c1.z);
	let g02 = abs(m.c0.x * m.c2.x + m.c0.y * m.c2.y + m.c0.z * m.c2.z);
	let g12 = abs(m.c1.x * m.c2.x + m.c1.y * m.c2.y + m.c1.z * m.c2.z);
	let g = max(m.c0.x * m.c0.x + m.c0.y * m.c0.y + m.c0.z * m.c0.z + g01 + g02, max(m.c1.x * m.c1.x + m.c1.y * m.c1.y + m.c1.z * m.c1.z + g01 + g12, m.c2.x * m.c2.x + m.c2.y * m.c2.y + m.c2.z * m.c2.z + g02 + g12));
	r / max(linalg::f(sqrt(g as real)) * (if b.inst >= 0 { instances[b.inst].smax } else { 1.0 }), 1.0e-20)
}
fn stream_wants() {
	let ty = linalg::f(tan((view.fov_y * 0.5) as real));
	let asp = width as f32 / max(height, 1) as f32;
	let px = 2.0 * ty / max(height, 1) as f32 / (1.0 + ty * ty * (1.0 + asp * asp)) * mip_scale();
	for b in batch {
		let m = material_of(b.prim);
		let pr = gltf::prims[b.prim];
		let zero = pr.skinned || pr.targets > 0 || b.joint_base >= 0 || m.height_tex.texture >= 0;
		var f f32 = -1.0;
		for r, slot in [m.base_tex, m.emissive_tex, m.mr_tex, m.normal_tex, m.occlusion_tex] {
			if r.texture < 0 || gltf::textures[r.texture].image < 0 { continue; }
			let t = gltf::textures[r.texture];
			let si = stream_at(t.image, slot < 2);
			if si < 0 { continue; }
			let s = streams[si];
			var lv = 0;
			if !zero && t.mipmaps && t.mag_nearest == t.min_nearest {
				if f < 0.0 { f = stream_reach(b, pr) * px; }
				let tt = (r.m.x * r.m.x + r.m.y * r.m.y + r.m.z * r.m.z + r.m.w * r.m.w) as real;
				let dd = abs(r.m.x * r.m.w - r.m.y * r.m.z) as real;
				let big = sqrt((tt + sqrt(max(tt * tt - 4.0 * dd * dd, 0.0))) * 0.5);
				var rho = f as real * uv_density(b.prim, min(max(r.uv, 0), 1)) as real * (if big > 0.0 { dd / big } else { 0.0 }) * min(s.info.width, s.info.height) as real;
				lv = -1;
				while rho >= 2.0 && lv < 30 { rho = rho * 0.5; lv += 1; }
			}
			lv = clamp(lv + tex_stream_bias, 0, s.tail);
			if lv < s.want { streams[si].want = lv; }
		}
	}
}
fn stream_update() {
	if streams.len == 0 { return; }
	let t0 = clock_ns();
	let wait = tex_wait || capturing;
	for s, i in streams { if s.on { streams[i].want = s.tail; } }
	stream_wants();
	var total = tex_mem - stream_mem;
	for s, i in streams {
		if !s.on { continue; }
		var tgt = s.top;
		if s.want <= s.top { streams[i].idle = 0; streams[i].low = s.tail; tgt = s.want; }
		else {
			let low = min(s.low, s.want);
			streams[i].low = low;
			if !capturing { streams[i].idle = s.idle + 1; if s.idle + 1 >= tex_hold { tgt = low; } }
		}
		streams[i].tgt = tgt;
		total += stream_chain(s, tgt);
	}
	if tex_budget > 0 && total > tex_budget && !capturing {
		for s, i in streams { if s.on && s.tgt < s.want { total += stream_chain(s, s.want) - stream_chain(s, s.tgt); streams[i].tgt = s.want; } }
		var more = true;
		while total > tex_budget && more {
			var mx = 0;
			for s in streams { if s.on && s.tgt < s.tail { mx = max(mx, stream_chain(s, s.tgt)); } }
			more = mx > 0;
			if more { for s, i in streams { if total > tex_budget && s.on && s.tgt < s.tail && stream_chain(s, s.tgt) == mx { total += stream_chain(s, s.tgt + 1) - mx; streams[i].tgt = s.tgt + 1; } } }
		}
	}
	let steps0 = tex_steps;
	let up0 = tex_streamed;
	for s, i in streams {
		if s.on && s.tgt > s.top && (wait || tex_steps == steps0 || tex_streamed - up0 + stream_chain(s, s.tgt) <= tex_upload_cap) { stream_build(i, s.tgt); }
	}
	for s, i in streams {
		if !s.on || s.tgt >= s.top { continue; }
		var n = s.tgt;
		if !wait {
			while n < s.top && tex_streamed - up0 + stream_chain(s, n) > tex_upload_cap { n += 1; }
			if n == s.top && tex_steps == steps0 { n = s.top - 1; }
		}
		if n < s.top && (tex_budget <= 0 || capturing || tex_mem + stream_chain(s, n) - stream_chain(s, s.top) <= tex_budget) { stream_build(i, n); }
	}
	tex_pending = 0;
	tex_starved = 0;
	for s in streams { if s.on { if s.top != s.tgt { tex_pending += 1; } if s.tgt > s.want { tex_starved += 1; } } }
	if !capturing { tex_stream_ns = clock_ns() - t0; }
}

fn warm(r gltf::TexRef, srgb bool) {
	if r.texture >= 0 && gltf::textures[r.texture].image >= 0 { let _ = image_texture(gltf::textures[r.texture].image, srgb); }
}

fn ext_fill(s int, layer int, src gfx::Texture) {
	guard gfx::begin_pass(gfx::PassDesc { color: [ext_arr[s], none(), none(), none()], layer: layer as i32, .. }) else { return; }
	gfx::bind(pipe_ext_copy);
	gfx::bind_texture(gfx::FRAGMENT, 0, src, smp_linear);
	gfx::draw(3);
	gfx::end_pass();
	ext_dirty[s] = true;
}
fn ext_make(s int, cap int) {
	if ext_arr[s].id != 0 { gfx::release(ext_arr[s]); }
	ext_arr[s] = gfx::texture(gfx::TextureDesc { kind: gfx::TEXTURE_2D_ARRAY, format: if s == 1 { gfx::RGBA8_SRGB } else { gfx::RGBA8 }, usage: gfx::SAMPLED | gfx::COLOR_TARGET, width: ext_size as i32, height: ext_size as i32, depth: cap as i32, mips: mip_count(ext_size, ext_size) as i32 });
	ext_cap[s] = cap;
	ext_fill(s, 0, white);
	if s == 0 { ext_fill(s, 1, flat_normal); }
	for k in ext_src.len / 3 {
		if ext_src[k * 3] == s { ext_fill(s, ext_src[k * 3 + 2], full_texture(ext_src[k * 3 + 1], s == 1)); }
	}
}
fn ext_need(r gltf::TexRef, s int) {
	if r.texture < 0 || gltf::textures[r.texture].image < 0 { return; }
	let im = gltf::textures[r.texture].image;
	while ext_map.len <= im * 2 + s { ext_map.push(-1); }
	if ext_map[im * 2 + s] >= 0 { return; }
	if ext_cnt[s] == 0 { ext_cnt[s] = if s == 0 { 2 } else { 1 }; }
	let lay = ext_cnt[s];
	ext_cnt[s] = lay + 1;
	ext_map[im * 2 + s] = lay;
	ext_src.push(s); ext_src.push(im); ext_src.push(lay);
	if lay >= ext_cap[s] { ext_make(s, max(ext_cap[s] * 2, 4)); } else { ext_fill(s, lay, full_texture(im, s == 1)); }
}
fn ext_finish() {
	for s in 2 {
		if ext_cap[s] == 0 { ext_make(s, 4); }
		if ext_dirty[s] { gfx::generate_mips(ext_arr[s]); ext_dirty[s] = false; }
	}
}
fn ext_layer(r gltf::TexRef, s int, none_is int) f32 {
	if r.texture < 0 || gltf::textures[r.texture].image < 0 { return none_is as f32; }
	ext_map[gltf::textures[r.texture].image * 2 + s] as f32
}
fn ext_set(u ExtU&, i int, r gltf::TexRef, s int) {
	u.tm[i] = r.m;
	u.to[i] = f4(r.o.x, r.o.y, ext_layer(r, s, -1), r.uv as f32);
}
fn ext_of(m gltf::Material) ExtU {
	var u ExtU;
	u.ior = f4(m.ior, m.spec_f, m.height_scale, 0.0);
	u.spec = x4(m.spec_c, 0.0);
	u.coat = f4(m.coat, m.coat_r, m.coat_ns, 0.0);
	u.trans = f4(m.trans, m.thick, m.att_d, 0.0);
	u.atten = x4(m.att_c, 0.0);
	u.aniso = f4(m.aniso, linalg::f(cos(m.aniso_rot as real)), linalg::f(sin(m.aniso_rot as real)), 0.0);
	u.irid = f4(m.irid, m.irid_ior, m.irid_min, m.irid_max);
	ext_set(u, 0, m.spec_tex, 0); ext_set(u, 1, m.spec_c_tex, 1); ext_set(u, 2, m.coat_tex, 0); ext_set(u, 3, m.coat_r_tex, 0); ext_set(u, 4, m.coat_n_tex, 0); ext_set(u, 5, m.trans_tex, 0); ext_set(u, 6, m.thick_tex, 0);
	ext_set(u, 7, m.aniso_tex, 0); ext_set(u, 8, m.irid_tex, 0); ext_set(u, 9, m.irid_t_tex, 0); ext_set(u, 10, m.sheen_c_tex, 1); ext_set(u, 11, m.sheen_r_tex, 0); ext_set(u, 12, m.height_tex, 0);
	u
}
// Textures are created on first use; uploads must happen outside render passes,
// so every texture the batch will sample is created before the first pass.
fn warm_textures() {
	if !capturing { tex_streamed = 0; tex_steps = 0; }
	for b in batch {
		let m = material_of(b.prim);
		warm(m.base_tex, true);
		warm(m.emissive_tex, true);
		warm(m.mr_tex, false);
		warm(m.normal_tex, false);
		warm(m.occlusion_tex, false);
		ext_need(m.top_base, 1);
		ext_need(m.top_mr, 0);
		ext_need(m.top_normal, 0);
		ext_need(m.detail, 0);
		if m.ext {
			ext_need(m.spec_tex, 0); ext_need(m.spec_c_tex, 1); ext_need(m.coat_tex, 0); ext_need(m.coat_r_tex, 0); ext_need(m.coat_n_tex, 0); ext_need(m.trans_tex, 0); ext_need(m.thick_tex, 0);
			ext_need(m.aniso_tex, 0); ext_need(m.irid_tex, 0); ext_need(m.irid_t_tex, 0); ext_need(m.sheen_c_tex, 1); ext_need(m.sheen_r_tex, 0); ext_need(m.height_tex, 0);
		}
	}
	for d in decals { ext_need(gltf::TexRef { texture: d.base, uv: 0 }, 1); ext_need(gltf::TexRef { texture: d.normal, uv: 0 }, 0); }
	stream_update();
	ext_finish();
}

fn wrap_mode(gl int) i32 { if gl == 33071 { gfx::CLAMP } else if gl == 33648 { gfx::MIRROR } else { gfx::REPEAT } }

fn texture_sampler(t gltf::Texture) gfx::Sampler {
	let key = (if t.min_nearest { 1 } else { 0 }) + (if t.mag_nearest { 2 } else { 0 }) + (if t.mipmaps { 4 } else { 0 }) + 8 * (wrap_mode(t.wrap_s) as int) + 24 * (wrap_mode(t.wrap_t) as int);
	while smp_cache.len <= key { smp_cache.push(gfx::Sampler { 0 }); }
	if smp_cache[key].id == 0 {
		let minf = if t.min_nearest { gfx::NEAREST } else { gfx::LINEAR };
		smp_cache[key] = gfx::sampler(gfx::SamplerDesc {
			min_filter: minf, mag_filter: if t.mag_nearest { gfx::NEAREST } else { gfx::LINEAR },
			mip_filter: minf, wrap_u: wrap_mode(t.wrap_s), wrap_v: wrap_mode(t.wrap_t), wrap_w: gfx::CLAMP,
			max_anisotropy: if t.mipmaps { 8.0 } else { 1.0 } 
		});
	}
	smp_cache[key]
}

fn bind_slot(slot int, r gltf::TexRef, srgb bool, fallback gfx::Texture) {
	if r.texture < 0 || gltf::textures[r.texture].image < 0 {
		gfx::bind_texture(gfx::FRAGMENT, slot, fallback, smp_linear);
		return;
	}
	let t = gltf::textures[r.texture];
	gfx::bind_texture(gfx::FRAGMENT, slot, image_texture(t.image, srgb), texture_sampler(t));
}

fn material_of(prim int) gltf::Material {
	let m = gltf::prims[prim].material;
	if m >= 0 { gltf::materials[m] } else { gltf::default_material() }
}

fn cut_of(m gltf::Material) CutU {
	CutU { base: m.base, alpha: f4(m.alpha_mode as f32, m.alpha_cutoff, if m.double_sided { 1.0 } else { 0.0 }, 0.0), uv_sets: f4(m.base_tex.uv as f32, 0.0, 0.0, 0.0), xm: m.base_tex.m, xo: f4(m.base_tex.o.x, m.base_tex.o.y, 0.0, 0.0) }
}

// ---- per-frame flattening

fn find_prev(key int) int {
	for k, i in prev_keys { if k == key { return i; } }
	-1
}

// false when the box lies wholly outside one clip plane (camera passes only; shadows keep it)
fn in_view(m gfx::mat4, lo float3, hi float3) bool {
	var out = [0, 0, 0, 0, 0, 0];
	for k in 8 {
		let p = linalg::v3(if k & 1 == 0 { lo.x } else { hi.x }, if k & 2 == 0 { lo.y } else { hi.y }, if k & 4 == 0 { lo.z } else { hi.z });
		let x = m.c0.x * p.x + m.c1.x * p.y + m.c2.x * p.z + m.c3.x;
		let y = m.c0.y * p.x + m.c1.y * p.y + m.c2.y * p.z + m.c3.y;
		let z = m.c0.z * p.x + m.c1.z * p.y + m.c2.z * p.z + m.c3.z;
		let w = m.c0.w * p.x + m.c1.w * p.y + m.c2.w * p.z + m.c3.w;
		if x < -w { out[0] += 1; }
		if x > w { out[1] += 1; }
		if y < -w { out[2] += 1; }
		if y > w { out[3] += 1; }
		if z < 0.0 { out[4] += 1; }
		if z > w { out[5] += 1; }
	}
	for o in out { if o == 8 { return false; } }
	true
}
fn atmosphere(to_sun float3, power f32, haze f32, clouds f32) {
	let d = linalg::unit3(to_sun);
	sun.to_sun = d;
	sun.rgb = envmap::sun_color(d, power, haze);
	envmap::set_sky(d, power, haze, clouds, envmap::size, 0.0, 0.0);
}
fn item_lights(ii int) {
	let a = gltf::assets[items[ii].asset];
	var k = items[ii].light_base;
	let first = k < 0;
	for q in a.nodes.count {
		let ni = a.nodes.first + q;
		let li = gltf::nodes[ni].light;
		if li < 0 { continue; }
		if first && items[ii].light_base < 0 { items[ii].light_base = lights.len; k = lights.len; }
		let pl = gltf::plights[li];
		let w = motion::world[ni];
		let pos = linalg::point(w, linalg::v3(0.0, 0.0, 0.0));
		let dir = linalg::unit3(linalg::direction(w, linalg::v3(0.0, 0.0, -1.0)));
		if pl.kind == 0 { sun.to_sun = linalg::v3(-dir.x, -dir.y, -dir.z); sun.rgb = pl.rgb; continue; }
		if first {
			let reach = if pl.range > 0.0 { pl.range } else { linalg::f(sqrt((max(pl.rgb.x, max(pl.rgb.y, pl.rgb.z)) * 1000.0) as real)) };
			lights.push(Light { pos: pos, range: reach, rgb: pl.rgb, kind: if pl.kind == 2 { 1 } else { 0 }, dir: dir, cone: pl.outer, edge: 1.0 - pl.inner / max(pl.outer, 1e-3), radius: 0.01, falloff: 1, .. });
		} else { lights[k].pos = pos; lights[k].dir = dir; }
		k += 1;
	}
	if first && items[ii].light_base < 0 { items[ii].light_base = lights.len; }
}
fn frustum(m gfx::mat4) {
	let r0 = f4(m.c0.x, m.c1.x, m.c2.x, m.c3.x);
	let r1 = f4(m.c0.y, m.c1.y, m.c2.y, m.c3.y);
	let r2 = f4(m.c0.z, m.c1.z, m.c2.z, m.c3.z);
	let r3 = f4(m.c0.w, m.c1.w, m.c2.w, m.c3.w);
	fr = [r3 + r0, r3 - r0, r3 + r1, r3 - r1, r2, r3 - r2];
	for k in 6 { fr[k] = fr[k] * (1.0 / linalg::f(sqrt((fr[k].x * fr[k].x + fr[k].y * fr[k].y + fr[k].z * fr[k].z) as real))); }
}
fn gather_instances() {
	let wd = linalg::unit3(linalg::v3(wind.dir.x, 0.0, wind.dir.z));
	wind_u = f4(wd.x * wind.strength, 0.0, wd.z * wind.strength, wind.speed);
	if wind_fresh { wind_prev = wind.time; wind_fresh = false; }
	var reach f32 = 0.0;
	for k in 4 {
		push_u[k] = if k < pushers.len { pushers[k] } else { f4(0.0, 0.0, 0.0, 0.0) };
		ppush_u[k] = if k < prev_pushers.len { prev_pushers[k] } else { push_u[k] };
		reach = max(reach, push_u[k].w);
	}
	inst_ids.clear();
	frustum(view_proj);
	for s, si in instances {
		if !s.visible || s.count == 0 { continue; }
		if inst_dirty {
			var lo = linalg::v3(1.0e30, 1.0e30, 1.0e30);
			var hi = linalg::v3(-1.0e30, -1.0e30, -1.0e30);
			for k in s.count {
				let c = inst_c[s.first + k];
				lo = linalg::v3(min(lo.x, c.x - c.w), min(lo.y, c.y - c.w), min(lo.z, c.z - c.w));
				hi = linalg::v3(max(hi.x, c.x + c.w), max(hi.y, c.y + c.w), max(hi.z, c.z + c.w));
			}
			instances[si].lo = lo;
			instances[si].hi = hi;
			var sm f32 = 0.0;
			for k in s.count { sm = max(sm, inst_c[s.first + k].w); }
			instances[si].smax = if s.r > 0.0 { sm / s.r } else { 1.0 };
		}
		inst_t0.clear(); inst_t1.clear(); inst_t2.clear(); inst_t3.clear();
		let grow = 1.0 + 2.0 * s.sway * wind.strength;
		let more = if s.sway > 0.0 { reach } else { 0.0 };
		let far2 = s.lod_distance * s.lod_distance;
		for k in s.count {
			let c = inst_c[s.first + k];
			let dx = c.x - view.eye.x; let dy = c.y - view.eye.y; let dz = c.z - view.eye.z;
			let far = s.lod_asset >= 0 && dx * dx + dy * dy + dz * dz >= far2;
			var see = true;
			if instance_cull { let r = c.w * grow + more; for p in fr { if p.x * c.x + p.y * c.y + p.z * c.z + p.w < -r { see = false; } } }
			if far { inst_t1.push(k as f32); if see { inst_t3.push(k as f32); } } else { inst_t0.push(k as f32); if see { inst_t2.push(k as f32); } }
		}
		instances[si].ia = [inst_ids.len, inst_ids.len + inst_t0.len];
		instances[si].na = [inst_t0.len, inst_t1.len];
		inst_ids.append(inst_t0[..]); inst_ids.append(inst_t1[..]);
		instances[si].iv = [inst_ids.len, inst_ids.len + inst_t2.len];
		instances[si].nv = [inst_t2.len, inst_t3.len];
		inst_ids.append(inst_t2[..]); inst_ids.append(inst_t3[..]);
		let bl = instances[si].lo;
		let bh = instances[si].hi;
		let d = linalg::dot3(linalg::v3((bl.x + bh.x) * 0.5 - view.eye.x, (bl.y + bh.y) * 0.5 - view.eye.y, (bl.z + bh.z) * 0.5 - view.eye.z), forward());
		for l in if s.lod_asset >= 0 { 2 } else { 1 } {
			if instances[si].na[l] == 0 { continue; }
			let asset = if l == 0 { s.asset } else { s.lod_asset };
			motion::rest(asset);
			motion::update(asset, gfx::mat4_identity);
			let a = gltf::assets[asset];
			for k in a.nodes.count {
				let ni = a.nodes.first + k;
				let n = gltf::nodes[ni];
				if n.mesh < 0 || n.skin >= 0 { continue; }
				let mesh = gltf::meshes[n.mesh];
				for pk in mesh.prims.count {
					let pi = mesh.prims.first + pk;
					batch.push(Batch { pi, -1, ni, -1, motion::world[ni], d, material_of(pi).alpha_mode, motion::world[ni], -1, instances[si].nv[l] > 0, material_of(pi).trans > 0.0, -1, -1, si, l });
				}
			}
		}
	}
	while inst_ids.len < 4 || inst_ids.len % 4 != 0 { inst_ids.push(0.0); }
	if inst_ids.len > idbuf_cap {
		if idbuf_cap > 0 { gfx::release(idbuf); }
		idbuf_cap = inst_ids.len * 2;
		idbuf = gfx::buffer(gfx::BUFFER_STORAGE, idbuf_cap * 4, []);
	}
	gfx::update_buffer(idbuf, 0, bytes_of(inst_ids)[..inst_ids.len * 4]);
	if inst_m.len > xbuf_cap || xbuf_cap == 0 {
		if xbuf_cap > 0 { gfx::release(xbuf); }
		xbuf_cap = max(inst_m.len * 2, 1);
		xbuf = gfx::buffer(gfx::BUFFER_STORAGE, xbuf_cap * 64, []);
		inst_dirty = true;
	}
	if inst_dirty && inst_m.len > 0 { gfx::update_buffer(xbuf, 0, bytes_of(inst_m)[..inst_m.len * 64]); }
	inst_dirty = false;
}
fn gather() {
	batch.clear();
	joints.clear();
	cur_keys.clear();
	cur_models.clear();
	cur_bases.clear();
	cur_wb.clear();
	old_w.clear(); old_w.append(cur_w[..]);
	cur_w.clear();
	for it, ii in items {
		if !it.visible || it.asset < 0 { continue; }
		pose(ii);
		item_lights(ii);
		let a = gltf::assets[it.asset];
		var palette gfx::mat4[>..] = [];
		for k in a.nodes.count {
			let ni = a.nodes.first + k;
			let n = gltf::nodes[ni];
			if n.mesh < 0 { continue; }
			var joint_base = -1;
			if n.skin >= 0 {
				motion::joints(n.skin, palette);
				joint_base = joints.len;
				joints.append(palette[..]);
			}
			// last frame's transform of this node (the same one on its first frame)
			let key = ii * 1048576 + ni;
			let model_now = if joint_base >= 0 { gfx::mat4_identity } else { motion::world[ni] };
			cur_keys.push(key);
			cur_models.push(model_now);
			cur_bases.push(joint_base);
			let pi_ = find_prev(key);
			let prev_model = if pi_ >= 0 && joint_base < 0 { prev_models[pi_] } else { model_now };
			// previous joint palettes are appended after this frame's in the joint buffer
			let prev_base = if pi_ >= 0 && joint_base >= 0 && prev_bases[pi_] >= 0 { prev_bases[pi_] } else { -1 };
			let mesh = gltf::meshes[n.mesh];
			var mt = 0;
			for pk in mesh.prims.count { mt = max(mt, gltf::prims[mesh.prims.first + pk].targets); }
			mt = min(mt, motion::MAX_WEIGHTS);
			let wb = if mt > 0 { cur_w.len } else { -1 };
			for j in mt { cur_w.push(motion::weight(ni, j)); }
			cur_wb.push(wb);
			let pwb = if pi_ >= 0 && wb >= 0 && !test_morph_still && prev_wb[pi_] >= 0 && prev_wb[pi_] + mt <= old_w.len { prev_wb[pi_] } else { -1 };
			for pk in mesh.prims.count {
				let pi = mesh.prims.first + pk;
				let pr = gltf::prims[pi];
				let model = if joint_base >= 0 { gfx::mat4_identity } else { motion::world[ni] };
				let c = linalg::point(model, linalg::mix3(pr.lo, pr.hi, 0.5));
				let d = linalg::dot3(linalg::v3(c.x - view.eye.x, c.y - view.eye.y, c.z - view.eye.z), forward());
				batch.push(Batch { pi, ii, ni, joint_base, model, d, material_of(pi).alpha_mode, prev_model, prev_base, joint_base >= 0 || in_view(gfx::mul(view_proj, model), pr.lo, pr.hi), material_of(pi).trans > 0.0, wb, pwb, -1, 0 });
			}
		}
	}
	gather_instances();
	let here = joints.len;
	for b, i in batch { if batch[i].prev_joint_base >= 0 { batch[i].prev_joint_base = here + b.prev_joint_base; } }
	joints.append(prev_joints[..]);
	if joints.len > jbuf_cap {
		gfx::release(jbuf);
		jbuf_cap = joints.len * 2;
		jbuf = gfx::buffer(gfx::BUFFER_STORAGE, jbuf_cap * 64, []);
	}
	if joints.len > 0 { gfx::update_buffer(jbuf, 0, bytes_of(joints)[..joints.len * 64]); }
	// keep this frame's transforms for the next one
	prev_joints.clear();
	prev_joints.append(joints[..here]);
	prev_keys.clear(); prev_keys.append(cur_keys[..]);
	prev_models.clear(); prev_models.append(cur_models[..]);
	prev_bases.clear(); prev_bases.append(cur_bases[..]);
	prev_wb.clear(); prev_wb.append(cur_wb[..]);
}

fn forward() float3 { linalg::unit3(linalg::v3(view.target.x - view.eye.x, view.target.y - view.eye.y, view.target.z - view.eye.z)) }

fn mw(pool f32[:], base int, j int, n int) f32 { if base >= 0 && j < n && j < motion::MAX_WEIGHTS && base + j < pool.len { pool[base + j] } else { 0.0 } }
fn draw_uniforms(b Batch, vp gfx::mat4) DrawU {
	let pr = gltf::prims[b.prim];
	var w float4[16] = [float4 { 0.0, 0.0, 0.0, 0.0 }; 16];
	var pw float4[16] = [float4 { 0.0, 0.0, 0.0, 0.0 }; 16];
	for q in min((pr.targets + 3) / 4, 16) {
		w[q] = float4 { mw(cur_w[..], b.wb, q * 4, pr.targets), mw(cur_w[..], b.wb, q * 4 + 1, pr.targets), mw(cur_w[..], b.wb, q * 4 + 2, pr.targets), mw(cur_w[..], b.wb, q * 4 + 3, pr.targets) };
		pw[q] = if b.pwb >= 0 { float4 { mw(old_w[..], b.pwb, q * 4, pr.targets), mw(old_w[..], b.pwb, q * 4 + 1, pr.targets), mw(old_w[..], b.pwb, q * 4 + 2, pr.targets), mw(old_w[..], b.pwb, q * 4 + 3, pr.targets) } } else { w[q] };
	}
	let sw = b.inst < 0 && b.item >= 0 && items[b.item].sway > 0.0;
	let pl = if sw { items[b.item].place } else { gfx::mat4_identity };
	DrawU {
		model: b.model, model_normal: linalg::normal_matrix(b.model), view_proj: vp, prev_model: b.prev_model,
		deform: f4(b.joint_base as f32, pr.mfirst as f32, pr.targets as f32, pr.vfirst as f32),
		misc: f4(pr.vcount as f32, b.prev_joint_base as f32, 0.0, 0.0),
		cur_vp: view_proj_nj, prev_vp: prev_view_proj, weights: w, prev_weights: pw,
		inst: if b.inst >= 0 { f4(instances[b.inst].first as f32, (if inst_all { instances[b.inst].ia[b.lod] } else { instances[b.inst].iv[b.lod] }) as f32, instances[b.inst].sway, instances[b.inst].top) } else { f4(0.0, -1.0, if sw { items[b.item].sway } else { 0.0 }, 0.0) },
		sway_o: if sw { f4(pl.c3.x, pl.c3.y, pl.c3.z, items[b.item].top * linalg::f(sqrt((pl.c1.x * pl.c1.x + pl.c1.y * pl.c1.y + pl.c1.z * pl.c1.z) as real))) } else { f4(0.0, 0.0, 0.0, 1.0) },
		wind: wind_u, wind_t: f4(wind.time, wind_prev, min(pushers.len, 4) as f32, min(if prev_pushers.len > 0 { prev_pushers.len } else { pushers.len }, 4) as f32), push: push_u, prev_push: ppush_u
	}
}

fn bind_geometry() {
	gfx::bind_vertex_buffer(vbuf);
	gfx::bind_index_buffer(ibuf, 4);
	gfx::bind_storage_buffer(gfx::VERTEX, 0, jbuf);
	gfx::bind_storage_buffer(gfx::VERTEX, 1, mbuf);
	gfx::bind_storage_buffer(gfx::VERTEX, 2, xbuf);
	gfx::bind_storage_buffer(gfx::VERTEX, 3, idbuf);
}

fn draw_prim(b Batch) {
	let pr = gltf::prims[b.prim];
	gfx::draw_indexed(pr.icount, if b.inst < 0 { 1 } else if inst_all { instances[b.inst].na[b.lod] } else { instances[b.inst].nv[b.lod] }, pr.ifirst, pr.vfirst, 0);
}

// ---- cameras

// Radical inverse of i in the given base: the Halton low-discrepancy sequence.
fn halton(i int, base int) f32 {
	var f f32 = 1.0;
	var r f32 = 0.0;
	var n = i;
	while n > 0 {
		f = f / base as f32;
		r += f * (n % base) as f32;
		n = n / base;
	}
	r
}

fn setup_view() {
	let aspect = width as f32 / height as f32;
	view_mat = gfx::look_at(view.eye, view.target, view.up);
	proj_mat = gfx::perspective(view.fov_y, aspect, view.near, view.far);
	if lens_offset.x != 0.0 || lens_offset.y != 0.0 {
		let fw = forward();
		let rt = linalg::unit3(linalg::cross3(fw, view.up));
		let uv = linalg::cross3(rt, fw);
		let o = linalg::v3(rt.x * lens_offset.x + uv.x * lens_offset.y, rt.y * lens_offset.x + uv.y * lens_offset.y, rt.z * lens_offset.x + uv.z * lens_offset.y);
		view_mat = gfx::look_at(linalg::v3(view.eye.x + o.x, view.eye.y + o.y, view.eye.z + o.z), linalg::v3(view.target.x + o.x, view.target.y + o.y, view.target.z + o.z), view.up);
		let ty = linalg::f(tan((view.fov_y * 0.5) as real));
		proj_mat.c2.x -= lens_offset.x / (dof_focus * ty * aspect);
		proj_mat.c2.y -= lens_offset.y / (dof_focus * ty);
	}
	let nj = gfx::mul(proj_mat, view_mat);
	prev_view_proj = if motion_fresh { nj } else { view_proj_nj };
	motion_fresh = false;
	view_proj_nj = nj;
	jitter = float2 { 0.0, 0.0 };
	if temporal_on() {
		// sub-pixel offset of this frame's samples, in pixels (y down), from the
		// (2, 3) Halton sequence; index 0 is skipped because it is (0, 0)
		let i = frames % max(jitter_phases, 1) + 1;
		jitter = float2 { halton(i, 2) - 0.5, halton(i, 3) - 0.5 };
		// pixel centre c must see the unjittered image at c + jitter (temporal.frag puts
		// input sample k at k + 0.5 + jitter), so the image moves by -jitter. Clip x/w
		// gains -c2.x and y/w -c2.y (w = -z): -jx pixels is -2 jx / width in NDC, so
		// c2.x += 2 jx / width; -jy pixels (up) is +2 jy / height, so c2.y -= 2 jy / height.
		// gfx_smoke's jitter check measures the shift on the GPU.
		proj_mat.c2.x += 2.0 * jitter.x / width as f32;
		proj_mat.c2.y -= 2.0 * jitter.y / height as f32;
	}
	view_proj = gfx::mul(proj_mat, view_mat);
}

// Splits [near, shadow_far] between a logarithmic and a uniform spacing, fits a
// bounding sphere to each slice and aims a texel-snapped orthographic camera at it.
fn setup_cascades() {
	cascade_vp.clear();
	let n = view.near;
	let fz = min(sun.shadow_far, view.far);
	let fwd = forward();
	let right = linalg::unit3(linalg::cross3(fwd, view.up));
	let up = linalg::cross3(right, fwd);
	let ty = linalg::f(tan((view.fov_y * 0.5) as real));
	let tx = ty * width as f32 / height as f32;
	let to_sun = linalg::unit3(sun.to_sun);
	let side = if abs(to_sun.y) > 0.95 { linalg::v3(1.0, 0.0, 0.0) } else { linalg::v3(0.0, 1.0, 0.0) };
	let light_rot = gfx::look_at(linalg::v3(0.0, 0.0, 0.0), linalg::v3(-to_sun.x, -to_sun.y, -to_sun.z), side);
	var a = n;
	var slo = linalg::v3(1.0e30, 1.0e30, 1.0e30);
	var shi = linalg::v3(-1.0e30, -1.0e30, -1.0e30);
	if sun.fit {
		for b in batch {
			if b.mode == gltf::ALPHA_BLEND || material_of(b.prim).no_shadow { continue; }
			if b.inst >= 0 {
				for k in 8 {
					let q = corner(instances[b.inst].lo, instances[b.inst].hi, k);
					slo = linalg::v3(min(slo.x, q.x), min(slo.y, q.y), min(slo.z, q.z));
					shi = linalg::v3(max(shi.x, q.x), max(shi.y, q.y), max(shi.z, q.z));
				}
				continue;
			}
			let pr = gltf::prims[b.prim];
			let m = if b.joint_base >= 0 { items[b.item].place } else { b.model };
			for k in 8 {
				let q = linalg::point(m, linalg::v3(if k & 1 == 0 { pr.lo.x } else { pr.hi.x }, if k & 2 == 0 { pr.lo.y } else { pr.hi.y }, if k & 4 == 0 { pr.lo.z } else { pr.hi.z }));
				slo = linalg::v3(min(slo.x, q.x), min(slo.y, q.y), min(slo.z, q.z));
				shi = linalg::v3(max(shi.x, q.x), max(shi.y, q.y), max(shi.z, q.z));
			}
		}
	}
	let sc = linalg::mix3(slo, shi, 0.5);
	let sr = if slo.x < shi.x { linalg::f(sqrt(linalg::dot3(shi - slo, shi - slo) as real)) * 0.625 + 0.1 } else { 1.0e30 };
	cascade_live = CASCADES;
	for c in CASCADES {
		let t = (c + 1) as f32 / CASCADES as f32;
		let log_split = n * linalg::f(pow((fz / n) as real, t as real));
		let lin_split = n + (fz - n) * t;
		let b = 0.75 * log_split + 0.25 * lin_split;
		cascade_end[c] = b;
		// sphere through the slice: centre on the view axis, equidistant from the
		// near and far corner rings
		let ka = a * a * (1.0 + tx * tx + ty * ty);
		let kb = b * b * (1.0 + tx * tx + ty * ty);
		var z = (kb - ka) / (2.0 * (b - a)) + 0.0;
		z = clamp(z, a, b);
		let r0 = sqrt(((b - z) * (b - z) + b * b * (tx * tx + ty * ty)) as real);
		var r = linalg::f(r0);
		let fitted = cascade_live < CASCADES || sr < r;
		r = linalg::f(ceil(((if fitted { sr } else { r }) * 16.0) as real)) / 16.0;
		let centre = if fitted { sc } else { linalg::v3(view.eye.x + fwd.x * z, view.eye.y + fwd.y * z, view.eye.z + fwd.z * z) };
		if fitted { cascade_end[c] = fz; cascade_live = min(cascade_live, c + 1); }
		var cl = linalg::point(light_rot, centre);
		let texel = 2.0 * r / shadow_size as f32;
		cl.x = linalg::f(floor((cl.x / texel) as real)) * texel;
		cl.y = linalg::f(floor((cl.y / texel) as real)) * texel;
		let proj = gfx::ortho(cl.x - r, cl.x + r, cl.y - r, cl.y + r, -cl.z - max(r * 4.0, shadow_reach), -cl.z + max(r, shadow_reach));
		cascade_vp.push(gfx::mul(proj, light_rot));
		a = b;
	}
	let _ = up;
}

fn fill_frame() {
	let fwd = forward();
	frame_u.cascade_mat[0] = cascade_vp[0];
	frame_u.cascade_mat[1] = cascade_vp[1];
	frame_u.cascade_mat[2] = cascade_vp[2];
	frame_u.cascade_far = f4(cascade_end[0], cascade_end[1], cascade_end[2], 1.0 / shadow_size as f32);
	frame_u.eye = x4(view.eye, (if look.ssao { 1.0 } else { 0.0 }) + (if contact_on() { 2.0 } else { 0.0 }));
	frame_u.view_dir = x4(fwd, if sun.shadows && sun.angle > 0.0 { linalg::f(tan(sun.angle as real)) } else { 0.0 });
	frame_u.to_sun = x4(linalg::unit3(sun.to_sun), if sun.shadows { 1.0 + max(sun.soft, 0.0) } else { 0.0 });
	frame_u.sun_rgb = x4(sun.rgb, sun.reach);
	frame_u.zenith = x4(sky.zenith, 0.0);
	frame_u.horizon = x4(sky.horizon, 0.0);
	frame_u.ground = x4(sky.ground, 0.0);
	let count = min(lights.len, MAX_LIGHTS);
	local_used = 0;
	local_vp.clear();
	frame_u.screen = f4(1.0 / width as f32, 1.0 / height as f32, count as f32, sky.ambient);
	for k in MAX_LIGHTS {
		if k < count {
			let l = lights[k];
			frame_u.light_pos[k] = x4(l.pos, signed_range(l));
			let spot = l.kind == 1;
			let co = clamp(l.cone, 0.01, 1.5);
			frame_u.light_rgb[k] = x4(l.rgb, if spot { 1.0 + linalg::f(cos((co * (1.0 - clamp(l.edge, 0.0, 1.0))) as real)) } else { 0.0 });
			let dv = linalg::unit3(l.dir);
			frame_u.light_dir[k] = x4(dv, if spot { linalg::f(cos(co as real)) } else { -2.0 });
			let faces = if spot { 1 } else { 6 };
			let th = if spot { linalg::f(tan((co as real) + 0.02)) } else { 1.0 + 4.0 / local_shadow_size as f32 };
			if l.shadows && local_used + faces <= LOCAL_LAYERS {
				frame_u.light_shd[k] = f4(local_used as f32, faces as f32, 2.0 * th / local_shadow_size as f32, max(l.soft, 0.0));
				let near = max(0.02, min(0.05, l.range * 0.001));
				let pr = gfx::perspective(2.0 * linalg::f(atan(th as real)), 1.0, near, l.range);
				for f in faces {
					let sg = if f % 2 == 0 { 1.0 } else { -1.0 };
					let ax = if spot { dv } else { linalg::v3(if f / 2 == 0 { sg } else { 0.0 }, if f / 2 == 1 { sg } else { 0.0 }, if f / 2 == 2 { sg } else { 0.0 }) };
					let up = if abs(ax.y) > 0.9 { linalg::v3(0.0, 0.0, 1.0) } else { linalg::v3(0.0, 1.0, 0.0) };
					let vp = gfx::mul(pr, gfx::look_at(l.pos, l.pos + ax, up));
					local_vp.push(vp);
					frame_u.local_mat[local_used + f] = vp;
				}
				local_used += faces;
			} else { frame_u.light_shd[k] = f4(-1.0, 0.0, 0.0, 0.0); }
		} else {
			frame_u.light_pos[k] = f4(0.0, 0.0, 0.0, 1.0);
			frame_u.light_rgb[k] = f4(0.0, 0.0, 0.0, 0.0);
			frame_u.light_dir[k] = f4(0.0, -1.0, 0.0, -2.0);
			frame_u.light_shd[k] = f4(-1.0, 0.0, 0.0, 0.0);
		}
	}
	let live = gi_built && rt::ready;
	frame_u.gi = f4(if live && gi_on && gi_have { 1.0 } else { 0.0 }, if live && rt_shadows { 1.0 } else { 0.0 }, if gi_ao { 1.0 } else { 0.0 }, if temporal_on() { 1.0 } else { 0.0 });
	frame_u.rtr = f4(if live && rt_reflect { 1.0 } else { 0.0 }, rt_rough, rt_reach, if temporal_on() { (frames % 64) as f32 } else { 0.0 });
	frame_u.gi_origin = x4(linalg::v3(gi_lo.x + gi_step.x * 0.5, gi_lo.y + gi_step.y * 0.5, gi_lo.z + gi_step.z * 0.5), if gi_rt_visibility { 1.0 } else { 0.0 });
	frame_u.gi_step = x4(gi_step, gi_bias);
	frame_u.gi_dims = f4(gi_dims[0] as f32, gi_dims[1] as f32, gi_dims[2] as f32, gi_rays as f32);
	frame_u.env = f4(if !envmap::on { 0.0 } else if envmap::physical { 2.0 } else { 1.0 }, envmap::intensity, envmap::spec_lod(), envmap::irr_lod());
	frame_u.env_rot = f4(linalg::f(cos(envmap::rotation as real)), linalg::f(sin(envmap::rotation as real)), envmap::blur * envmap::spec_lod(), if spec_aa { 1.0 } else { 0.0 });
	frame_u.vp = view_proj;
	frame_u.cluster = f4(clusters::CX as f32, clusters::CY as f32, clusters::CZ as f32, world_time);
	frame_u.cluster2 = f4(view.near, clusters::CZ as f32 / linalg::f(log((view.far / view.near) as real)), wet, snow);
	var cf = caustics.manual;
	if caustics.on && !cf {
		for b in batch {
			if cf || b.item < 0 || !b.trans || material_of(b.prim).shading != 4 { continue; }
			let pr = gltf::prims[b.prim];
			var lo = linalg::v3(1.0e30, 1.0e30, 1.0e30);
			var hi = linalg::v3(-1.0e30, -1.0e30, -1.0e30);
			for c in 8 {
				let q = linalg::point(b.model, corner(pr.lo, pr.hi, c));
				lo = linalg::v3(min(lo.x, q.x), min(lo.y, q.y), min(lo.z, q.z));
				hi = linalg::v3(max(hi.x, q.x), max(hi.y, q.y), max(hi.z, q.z));
			}
			let wm = material_of(b.prim);
			caustics.level = hi.y; caustics.lo = lo; caustics.hi = hi; caustics.waves = wm.shade_b; caustics.absorb = linalg::v3(wm.shade_a.x, wm.shade_a.y, wm.shade_a.z);
			cf = true;
		}
	}
	frame_u.caust = f4(caustics.level, clamp(caustics.strength, 0.0, 1.0), caustics.focus, max(caustics.cap, 1.0));
	frame_u.caust_w = f4(caustics.waves.x, caustics.waves.y, caustics.waves.z, 0.0);
	frame_u.caust_box = f4(caustics.lo.x, caustics.lo.z, caustics.hi.x, caustics.hi.z);
	frame_u.caust_abs = f4(caustics.absorb.x, caustics.absorb.y, caustics.absorb.z, if caustics.on && cf { 1.0 } else { 0.0 });
	let np = if capturing { cap_np } else if probe_gen != envmap::gen { 0 } else { min(probes.len, MAX_PROBES) };
	frame_u.ssgi = f4(0.0, 0.0, 0.0, 0.0);
	frame_u.refl = f4(0.0, frame_u.refl.y, frame_u.refl.z, frame_u.refl.w);
	frame_u.probe_n = f4(np as f32, probe_intensity, if probe_parallax { 1.0 } else { 0.0 }, 0.0);
	for i in np {
		let p = probes[i];
		frame_u.probe_pos[i] = x4(p.pos, 0.0);
		frame_u.probe_lo[i] = x4(p.lo, max(p.fade, 0.0001));
		frame_u.probe_hi[i] = x4(p.hi, 0.0);
	}
}
// mean linear colour of an image, sampled on a sparse grid; the bounce albedo
fn image_avg(image int) float3 {
	while img_avg.len <= image { img_avg.push(float4 { 0.0, 0.0, 0.0, -1.0 }); }
	if img_avg[image].w >= 0.0 { return linalg::v3(img_avg[image].x, img_avg[image].y, img_avg[image].z); }
	let im = gltf::images[image];
	let n = im.width * im.height;
	gltf::need_pixels(image);
	let px = gltf::image_pixels(image);
	let stride = max(1, n / 4096);
	var acc = float3 { 0.0, 0.0, 0.0 };
	var cnt = 0;
	var i = 0;
	while i < n {
		let b = i * 4;
		let r = px[b] as f32 / 255.0; let g = px[b + 1] as f32 / 255.0; let bl = px[b + 2] as f32 / 255.0;
		acc = acc + float3 { r * r, g * g, bl * bl };
		cnt += 1;
		i += stride;
	}
	let a = if cnt > 0 { acc * (1.0 / cnt as f32) } else { float3 { 1.0, 1.0, 1.0 } };
	img_avg[image] = float4 { a.x, a.y, a.z, 1.0 };
	a
}
fn gi_scene() {
	rt::clear();
	for b in batch {
		if b.mode == gltf::ALPHA_BLEND || b.joint_base >= 0 || b.inst >= 0 { continue; }
		let pr = gltf::prims[b.prim];
		if pr.targets > 0 { continue; }
		let m = material_of(b.prim);
		if m.no_gi { continue; }
		let tex = if m.base_tex.texture >= 0 && gltf::textures[m.base_tex.texture].image >= 0 { image_avg(gltf::textures[m.base_tex.texture].image) } else { float3 { 1.0, 1.0, 1.0 } };
		let mt = if m.mr_tex.texture >= 0 { 0.0 } else { m.metallic };
		let rg = if m.mr_tex.texture >= 0 { 1.0 } else { m.roughness };
		let rgb = linalg::v3(m.base.x * tex.x, m.base.y * tex.y, m.base.z * tex.z);
		let gt = if m.emissive_tex.texture >= 0 && gltf::textures[m.emissive_tex.texture].image >= 0 { image_avg(gltf::textures[m.emissive_tex.texture].image) } else { float3 { 1.0, 1.0, 1.0 } };
		let glow = linalg::v3(m.emissive.x * gt.x, m.emissive.y * gt.y, m.emissive.z * gt.z);
		var t = 0;
		while t + 2 < pr.icount {
			var q float3[3] = [float3 { 0.0, 0.0, 0.0 }; 3];
			var vc = float3 { 0.0, 0.0, 0.0 };
			for c in 3 {
				let vb = (pr.vfirst + gltf::indices[pr.ifirst + t + c] as int) * gltf::VERTEX_FLOATS;
				let vi = vb + gltf::AT_POS;
				q[c] = linalg::point(b.model, linalg::v3(gltf::verts[vi], gltf::verts[vi + 1], gltf::verts[vi + 2]));
				vc = vc + linalg::v3(gltf::verts[vb + gltf::AT_COL], gltf::verts[vb + gltf::AT_COL + 1], gltf::verts[vb + gltf::AT_COL + 2]) * (1.0 / 3.0);
			}
			rt::add(q[0], q[1], q[2], linalg::v3(rgb.x * vc.x, rgb.y * vc.y, rgb.z * vc.z), mt, rg, glow);
			t += 3;
		}
	}
	rt::build();
	rt::upload();
	if rt::ready {
		let lo = if gi_box { gi_box_lo } else { linalg::v3(rt::nodes[0], rt::nodes[1], rt::nodes[2]) };
		let hi = if gi_box { gi_box_hi } else { linalg::v3(rt::nodes[4], rt::nodes[5], rt::nodes[6]) };
		gi_lo = lo;
		gi_step = linalg::v3((hi.x - lo.x) / gi_dims[0] as f32, (hi.y - lo.y) / gi_dims[1] as f32, (hi.z - lo.z) / gi_dims[2] as f32);
	}
	let np = gi_dims[0] * gi_dims[1] * gi_dims[2];
	if gi_have && (np != gi_np || gi_rays != gi_nr) { gfx::release(gi_irr); gfx::release(gi_dist); gfx::release(gi_rays_buf); gi_have = false; }
	if !gi_have && rt::ready {
		let u = gfx::BUFFER_STORAGE | gfx::BUFFER_COMPUTE_READ | gfx::BUFFER_COMPUTE_WRITE;
		gi_irr = gfx::buffer(u, np * 64 * 16, []);
		gi_dist = gfx::buffer(u, np * 256 * 8, []);
		gi_rays_buf = gfx::buffer(u, np * gi_rays * 16, []);
		gi_have = true;
	}
	gi_np = np; gi_nr = gi_rays; gi_updates = 0;
	gi_built = true;
}
fn gi_rot(k int) GiU {
	let h = (k * 2654435761 + 12345) % 1000003;
	let a = linalg::f(h as real * 0.000006283);
	let b = linalg::f((h * 7919 % 1000003) as real * 0.000003141);
	let c = linalg::f((h * 104729 % 1000003) as real * 0.000006283);
	let ca = linalg::f(cos(a as real)); let sa = linalg::f(sin(a as real));
	let cb = linalg::f(cos(b as real)); let sb = linalg::f(sin(b as real));
	let cc = linalg::f(cos(c as real)); let sc = linalg::f(sin(c as real));
	var g GiU;
	g.rot0 = f4(ca * cc - sa * cb * sc, -ca * sc - sa * cb * cc, sa * sb, 0.0);
	g.rot1 = f4(sa * cc + ca * cb * sc, -sa * sc + ca * cb * cc, -ca * sb, 0.0);
	g.rot2 = f4(sb * sc, sb * cc, cb, 0.0);
	g
}
fn gi_pass() {
	if !(gi_on || rt_shadows || rt_reflect) { return; }
	if !gi_built { gi_scene(); }
	if !gi_on || !gi_have || !rt::ready { return; }
	if gi_updates > 8 && gi_interval > 1 && frames % gi_interval != 0 { return; }
	let np = gi_np; let nr = gi_nr;
	let maxd = if gi_max_dist > 0.0 { gi_max_dist } else { 1.5 * linalg::f(sqrt((gi_step.x * gi_step.x + gi_step.y * gi_step.y + gi_step.z * gi_step.z) as real)) };
	for u in gi_updates_per_frame {
		var g = gi_rot(gi_updates);
		g.origin = frame_u.gi_origin; g.step = x4(gi_step, gi_bias); g.dims = f4(gi_dims[0] as f32, gi_dims[1] as f32, gi_dims[2] as f32, nr as f32);
		g.env = frame_u.env; g.env_rot = frame_u.env_rot;
		g.to_sun = frame_u.to_sun; g.sun_rgb = frame_u.sun_rgb; g.zenith = frame_u.zenith; g.horizon = frame_u.horizon; g.ground = frame_u.ground;
		for k in GI_LIGHTS { g.light_pos[k] = frame_u.light_pos[k]; g.light_rgb[k] = frame_u.light_rgb[k]; }
		g.params = f4(sky.ambient, if gi_updates > 0 { 1.0 } else { 0.0 }, maxd, frame_u.screen.z);
		guard gfx::begin_compute([gi_rays_buf]) else { return; }
		gfx::bind(pipe_gi_trace);
		gfx::bind_texture(gfx::COMPUTE, 0, envmap::texture(), envmap::smp);
		gfx::bind_storage_buffer(gfx::COMPUTE, 0, rt::node_buf);
		gfx::bind_storage_buffer(gfx::COMPUTE, 1, rt::tri_buf);
		gfx::bind_storage_buffer(gfx::COMPUTE, 2, gi_irr);
		gfx::bind_storage_buffer(gfx::COMPUTE, 3, gi_dist);
		gfx::uniforms(gfx::COMPUTE, 0, g);
		gfx::dispatch((np * nr + 63) / 64, 1, 1);
		gfx::end_compute();
		g.params = f4(0.0, if gi_updates > 0 { gi_hysteresis } else { 0.0 }, maxd, 0.0);
		guard gfx::begin_compute([gi_irr, gi_dist]) else { return; }
		gfx::bind(pipe_gi_update);
		gfx::bind_storage_buffer(gfx::COMPUTE, 0, gi_rays_buf);
		gfx::uniforms(gfx::COMPUTE, 0, g);
		gfx::dispatch((np * 320 + 63) / 64, 1, 1);
		gfx::end_compute();
		gi_updates += 1;
	}
}
fn signed_range(l Light) f32 { if l.falloff == 1 { -max(l.range, 0.01) } else { max(l.range, 0.01) } }
fn light_upload() {
	frame_u.decal = f4(0.0, 0.0, 0.0, 0.0);
	if lights.len == 0 && decals.len == 0 && cluster_cap > 0 && cluster_words.len == 0 { return; }
	light_data.clear();
	light_xr.clear();
	for l, k in lights {
		let spot = l.kind == 1;
		let co = clamp(l.cone, 0.01, 1.5);
		light_xr.push(x4(l.pos, max(l.range, 0.01)));
		light_data.push(x4(l.pos, signed_range(l)));
		light_data.push(x4(l.rgb, if spot { 1.0 + linalg::f(cos((co * (1.0 - clamp(l.edge, 0.0, 1.0))) as real)) } else { 0.0 }));
		light_data.push(x4(linalg::unit3(l.dir), if spot { linalg::f(cos(co as real)) } else { -2.0 }));
		light_data.push(if k < MAX_LIGHTS { frame_u.light_shd[k] } else { f4(-1.0, 0.0, 0.0, 0.0) });
		light_data.push(f4(l.radius, l.length, l.width, l.height));
		light_data.push(x4(rect_axis(l), if test_rect_naive { 1.0 } else { 0.0 }));
	}
	if light_data.len == 0 { light_data.push(f4(0.0, 0.0, 0.0, 0.0)); }
	frame_u.decal = f4(light_data.len as f32, decals.len as f32, 0.0, 0.0);
	for d in decals {
		let ax = linalg::qrotate(d.rot, linalg::v3(1.0, 0.0, 0.0));
		let ay = linalg::qrotate(d.rot, linalg::v3(0.0, 1.0, 0.0));
		let az = linalg::qrotate(d.rot, linalg::v3(0.0, 0.0, 1.0));
		let sx = 2.0 / max(d.size.x, 1e-4);
		let sy = 2.0 / max(d.size.y, 1e-4);
		let sz = 2.0 / max(d.size.z, 1e-4);
		light_data.push(x4(d.pos, ext_layer(gltf::TexRef { texture: d.base, uv: 0 }, 1, -1)));
		light_data.push(f4(ax.x * sx, ax.y * sx, ax.z * sx, ext_layer(gltf::TexRef { texture: d.normal, uv: 0 }, 0, -1)));
		light_data.push(f4(ay.x * sy, ay.y * sy, ay.z * sy, clamp(d.opacity, 0.0, 1.0)));
		light_data.push(f4(az.x * sz, az.y * sz, az.z * sz, d.normal_scale));
		light_data.push(f4(d.fade_lo, max(d.fade_hi, d.fade_lo + 1e-3), d.rough, d.metal));
	}
	let ty = linalg::f(tan((view.fov_y * 0.5) as real));
	clusters::build(view_mat, ty * width as f32 / height as f32, ty, view.near, view.far, light_xr[..], cluster_words);
	let lb = bytes_of(light_data);
	if lb.len > light_cap {
		if light_cap > 0 { gfx::release(light_buf); }
		light_cap = lb.len * 2;
		light_buf = gfx::buffer(gfx::BUFFER_STORAGE, light_cap, []);
	}
	gfx::update_buffer(light_buf, lb[..]);
	let cb = bytes_of(cluster_words);
	if cb.len > cluster_cap {
		if cluster_cap > 0 { gfx::release(cluster_buf); }
		cluster_cap = cb.len * 2;
		cluster_buf = gfx::buffer(gfx::BUFFER_STORAGE, cluster_cap, []);
	}
	gfx::update_buffer(cluster_buf, cb[..]);
	if lights.len == 0 { cluster_words.clear(); }
}
fn gi_bind() {
	let live = gi_built && rt::ready;
	gfx::bind_storage_buffer(gfx::FRAGMENT, 0, if live { rt::node_buf } else { gi_dummy });
	gfx::bind_storage_buffer(gfx::FRAGMENT, 1, if live { rt::tri_buf } else { gi_dummy });
	gfx::bind_storage_buffer(gfx::FRAGMENT, 2, if live && gi_have { gi_irr } else { gi_dummy });
	gfx::bind_storage_buffer(gfx::FRAGMENT, 3, if live && gi_have { gi_dist } else { gi_dummy });
	gfx::bind_storage_buffer(gfx::FRAGMENT, 4, light_buf);
	gfx::bind_storage_buffer(gfx::FRAGMENT, 5, cluster_buf);
	gfx::bind_storage_buffer(gfx::FRAGMENT, 6, if frame_u.ssgi.x > 0.5 { ssgi_buf } else { gi_dummy });
}

// ---- passes

fn shadow_pass() {
	if !sun.shadows { return; }
	inst_all = true;
	if sun.map_size != shadow_size { gfx::release(shadow_map); make_shadow_map(sun.map_size); }
	// The whole map is rewritten every frame: cycle it once, on the first cascade's clear,
	// so a frame still sampling the last map keeps it (frames are submitted without
	// waiting), and never on the later cascades, which would discard the earlier layers.
	for c in cascade_live {
		let cyc = if shadow_test_cycle_never { 2 } else if shadow_test_cycle_all || c == 0 { 1 } else { 2 };
		guard gfx::begin_pass(gfx::PassDesc { depth: shadow_map, layer: c as i32, clear_depth: true, depth_value: 1.0, cycle: cyc as i32, .. }) else { return; }
		gfx::bind(pipe_shadow);
		bind_geometry();
		let shift = if c == 0 { shadow_test_shift.x } else { if c == 1 { shadow_test_shift.y } else { shadow_test_shift.z } };
		var vp = cascade_vp[c];
		if shift != 0.0 {
			// clip x += dx * w moves the map by dx in ndc, i.e. shift texels
			let dx = 2.0 * shift / shadow_size as f32;
			vp.c0.x += dx * vp.c0.w; vp.c1.x += dx * vp.c1.w; vp.c2.x += dx * vp.c2.w; vp.c3.x += dx * vp.c3.w;
		}
		for b in batch {
			if b.mode == gltf::ALPHA_BLEND { continue; }
			let m = material_of(b.prim);
			if m.no_shadow { continue; }
			gfx::uniforms(gfx::VERTEX, 0, draw_uniforms(b, vp));
			gfx::uniforms(gfx::FRAGMENT, 0, cut_of(m));
			bind_slot(0, m.base_tex, true, white);
			draw_prim(b);
		}
		gfx::end_pass();
	}
}

fn shelter_pass() {
	fx::eye = view.eye;
	fx::shelter_box = f4(0.0, 0.0, 0.0, 0.0);
	let e, top = fx::weather_bounds(view.eye);
	if !shelter || e <= 0.0 { return; }
	if shelter_size != shelter_res {
		if shelter_size > 0 { gfx::release(shelter_map); gfx::release(shelter_depth); }
		shelter_size = shelter_res;
		shelter_map = gfx::render_target(shelter_size, shelter_size, gfx::R32F);
		shelter_depth = gfx::texture(gfx::TextureDesc { format: gfx::DEPTH32F, usage: gfx::DEPTH_TARGET, width: shelter_size as i32, height: shelter_size as i32 });
	}
	let tx = 2.0 * e / (shelter_size - 4) as f32;
	let he = tx * shelter_size as f32 * 0.5;
	let cx = floor(view.eye.x / tx) * tx; let cz = floor(view.eye.z / tx) * tx;
	let hi = top + 100.0;
	let vp = gfx::mat4 { c0: f4(1.0 / he, 0.0, 0.0, 0.0), c1: f4(0.0, 0.0, -1.0 / 400.0, 0.0), c2: f4(0.0, -1.0 / he, 0.0, 0.0), c3: f4(-cx / he, cz / he, hi / 400.0, 1.0) };
	inst_all = true;
	guard gfx::begin_pass(gfx::PassDesc { color: [shelter_map, none(), none(), none()], depth: shelter_depth, color_value: f4(-1.0e30, 0.0, 0.0, 1.0), cycle: 1, .. }) else { return; }
	gfx::bind(pipe_shelter);
	bind_geometry();
	for b in batch { let m = material_of(b.prim); if m.no_shadow { continue; } gfx::uniforms(gfx::VERTEX, 0, draw_uniforms(b, vp)); gfx::uniforms(gfx::FRAGMENT, 0, cut_of(m)); bind_slot(0, m.base_tex, true, white); draw_prim(b); }
	gfx::end_pass();
	fx::shelter_tex = shelter_map;
	fx::shelter_box = f4(cx, cz, 0.5 / he, 1.0);
}
fn local_shadow_pass() {
	if local_used == 0 { return; }
	inst_all = true;
	if local_size != local_shadow_size {
		if local_size > 0 { gfx::release(local_map); }
		local_size = local_shadow_size;
		local_map = gfx::texture(gfx::TextureDesc { kind: gfx::TEXTURE_2D_ARRAY, format: gfx::DEPTH32F, usage: gfx::DEPTH_TARGET | gfx::SAMPLED, width: local_size as i32, height: local_size as i32, depth: LOCAL_LAYERS as i32 });
	}
	for c in local_used {
		guard gfx::begin_pass(gfx::PassDesc { depth: local_map, layer: c as i32, clear_depth: true, depth_value: 1.0, cycle: (if c == 0 { 1 } else { 2 }) as i32, .. }) else { return; }
		gfx::bind(pipe_shadow);
		bind_geometry();
		let vp = local_vp[c];
		for b in batch {
			if b.mode == gltf::ALPHA_BLEND { continue; }
			let m = material_of(b.prim);
			if m.no_shadow { continue; }
			let pr = gltf::prims[b.prim];
			if b.joint_base < 0 && b.inst < 0 && !in_view(gfx::mul(vp, b.model), pr.lo, pr.hi) { continue; }
			gfx::uniforms(gfx::VERTEX, 0, draw_uniforms(b, vp));
			gfx::uniforms(gfx::FRAGMENT, 0, cut_of(m));
			bind_slot(0, m.base_tex, true, white);
			draw_prim(b);
		}
		gfx::end_pass();
	}
}
fn fullscreen(p gfx::Pipeline) { gfx::bind(p); }

fn sky_u() SkyU {
	let to_sun = linalg::unit3(sun.to_sun);
	SkyU { inv_view_proj: linalg::inverse(view_proj_nj), prev_view_proj: prev_view_proj, to_sun: x4(to_sun, if sky.draw { 0.0 } else { 1.0 }), sun_rgb: x4(sun.rgb, 0.0), zenith: x4(sky.zenith, 0.0), horizon: x4(sky.horizon, 0.0), ground: x4(sky.ground, 0.0), env: frame_u.env, env_rot: frame_u.env_rot }
}

// Prepass: normal + depth (nd) for SSAO, and the motion target when it is wanted. Both
// are single-sample, so every pixel's motion and depth belong to the one surface under
// its (jittered) sample point.
fn ao_pass() {
	inst_all = false;
	let mv = motion_wanted();
	nd_ran = false;
	let cs = contact_on();
	bent_ran = false;
	mt_ran = false;
	var water = false;
	for b in batch { if b.trans && b.vis && material_of(b.prim).shading == 4 { water = true; } }
	if !water && !look.ssao && !mv && !cs && !ssr_on && !ssgi_live() && !fog_on && dof_aperture <= 0.0 && !(fx::ready() && fx::wants_depth()) { return; }
	nd_ran = true;
	let gia = gi_on && gi_ao && gi_built && gi_have;
	let gt = look.ssao && (ao_mode == 1 || gia);
	let ar = if gia { min(gi_step.x, min(gi_step.y, gi_step.z)) } else { look.ao_radius };
	let ap = if gia { 1.0 } else { look.ao_power };
	let ld = gt || cs || ssr_on || ssgi_live();
	if mv || ld { make_motion(); }
	mt_ran = mv || ld;
	let mt = if mt_ran { motion_tex } else { none() };
	guard gfx::begin_pass(gfx::PassDesc { color: [nd, mt, if ld { lin_depth } else { none() }, none()], depth: nd_depth, color_value: f4(0.0, 0.0, 1.0, 0.0), .. }) else { return; }
	// background first: the sky's nd (normal +z, depth 0) and its motion (rotation only),
	// view depth 60000 now and last frame
	if mv {
		gfx::bind(pipe_sky_motion);
		gfx::uniforms(gfx::FRAGMENT, 0, sky_u());
		gfx::draw(3);
	}
	var current = -1;
	bind_geometry();
	for b in batch {
		if b.mode == gltf::ALPHA_BLEND || b.trans || !b.vis { continue; }
		let m = material_of(b.prim);
		let want = if m.double_sided { 1 } else { 0 };
		if want != current {
			gfx::bind(if m.double_sided { pipe_normals_two } else { pipe_normals });
			bind_geometry();
			current = want;
		}
		let c = cut_of(m);
		gfx::uniforms(gfx::VERTEX, 0, draw_uniforms(b, view_proj));
		gfx::uniforms(gfx::FRAGMENT, 0, CutViewU { base: c.base, alpha: c.alpha, uv_sets: c.uv_sets, xm: c.xm, xo: c.xo, view: view_mat });
		bind_slot(0, m.base_tex, true, white);
		draw_prim(b);
	}
	gfx::end_pass();
	if !look.ssao { return; }

	let ty = linalg::f(tan((view.fov_y * 0.5) as real));
	let tx = ty * width as f32 / height as f32;
	if gt {
		guard gfx::begin_pass(gfx::PassDesc { color: [ao_raw, bent_raw, none(), none()], .. }) else { return; }
		gfx::bind(pipe_gtao);
		gfx::bind_texture(gfx::FRAGMENT, 0, nd, smp_point);
		gfx::bind_texture(gfx::FRAGMENT, 1, lin_depth, smp_point);
		gfx::uniforms(gfx::FRAGMENT, 0, GtaoU { lens: f4(tx, ty, 1.0 / width as f32, 1.0 / height as f32), tune: f4(ar, gtao_falloff, ap, 0.0), size: f4(1.0 / width as f32, 1.0 / height as f32, max(look.ao_samples / 4, 1) as f32, gtao_steps as f32) });
		gfx::draw(3);
		gfx::end_pass();
		guard gfx::begin_pass(gfx::PassDesc { color: [ao, bent, none(), none()], .. }) else { return; }
		gfx::bind(pipe_gtao_blur);
		gfx::bind_texture(gfx::FRAGMENT, 0, ao_raw, smp_point);
		gfx::bind_texture(gfx::FRAGMENT, 1, bent_raw, smp_point);
		gfx::uniforms(gfx::FRAGMENT, 0, TexelU { texel: f4(1.0 / width as f32, 1.0 / height as f32, 0.0, 0.0) });
		gfx::draw(3);
		gfx::end_pass();
		bent_ran = true;
		return;
	}
	guard gfx::begin_pass(gfx::PassDesc { color: [ao_raw, none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_ao);
	gfx::bind_texture(gfx::FRAGMENT, 0, nd, smp_point);
	gfx::uniforms(gfx::FRAGMENT, 0, AoU { lens: f4(tx, ty, 1.0 / width as f32, 1.0 / height as f32), tune: f4(look.ao_radius, 0.02, look.ao_power, look.ao_samples as f32) });
	gfx::draw(3);
	gfx::end_pass();

	guard gfx::begin_pass(gfx::PassDesc { color: [ao, none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_ao_blur);
	gfx::bind_texture(gfx::FRAGMENT, 0, ao_raw, smp_point);
	gfx::uniforms(gfx::FRAGMENT, 0, TexelU { texel: f4(1.0 / width as f32, 1.0 / height as f32, 0.0, 0.0) });
	gfx::draw(3);
	gfx::end_pass();
}

fn contact_on() bool { sun.shadows && sun.contact > 0.0 }
fn contact_pass() {
	if !contact_on() || !nd_ran { return; }
	let ty = linalg::f(tan((view.fov_y * 0.5) as real));
	let tx = ty * width as f32 / height as f32;
	let l = linalg::unit3(sun.to_sun);
	let lv = linalg::unit3(linalg::v3(view_mat.c0.x * l.x + view_mat.c1.x * l.y + view_mat.c2.x * l.z, view_mat.c0.y * l.x + view_mat.c1.y * l.y + view_mat.c2.y * l.z, view_mat.c0.z * l.x + view_mat.c1.z * l.y + view_mat.c2.z * l.z));
	guard gfx::begin_pass(gfx::PassDesc { color: [contact_tex, none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_contact);
	gfx::bind_texture(gfx::FRAGMENT, 0, lin_depth, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 1, nd, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 2, if look.ssao { ao } else { white }, smp_point);
	gfx::uniforms(gfx::FRAGMENT, 0, ContactU { lens: f4(tx, ty, 1.0 / width as f32, 1.0 / height as f32), jit: f4(jitter.x, jitter.y, width as f32, height as f32), sun_v: x4(lv, sun.contact), tune: f4(min(contact_steps, 32) as f32, contact_thick, if look.ssao { 1.0 } else { 0.0 }, if temporal_on() { 1.0 } else { 0.0 }) });
	gfx::draw(3);
	gfx::end_pass();
}
fn ssr_pass() {
	let ty = linalg::f(tan((view.fov_y * 0.5) as real));
	frame_u.view_m = view_mat;
	if (!ssr_on && !ssgi_live()) || !nd_ran { ssr_have = false; frame_u.refl = f4(0.0, if spec_occlusion { if bent_ran { 2.0 } else { 1.0 } } else { 0.0 }, ssr_rough, height as f32 / (2.0 * ty)); return; }
	make_ssr();
	if temporal_reset { ssr_have = false; }
	var sw = width;
	var sh = height;
	for k in HIZ_LEVELS {
		guard gfx::begin_pass(gfx::PassDesc { color: [hiz[k], none(), none(), none()], .. }) else { return; }
		gfx::bind(pipe_hiz);
		gfx::bind_texture(gfx::FRAGMENT, 0, if k == 0 { lin_depth } else { hiz[k - 1] }, smp_point);
		gfx::uniforms(gfx::FRAGMENT, 0, HizU { hz: f4(if k == 0 { 1.0 } else { 0.0 }, (sw - 1) as f32, (sh - 1) as f32, 0.0) });
		gfx::draw(3);
		gfx::end_pass();
		sw = (sw + 1) / 2;
		sh = (sh + 1) / 2;
	}
	if !ssr_on { frame_u.refl = f4(0.0, if spec_occlusion { if bent_ran { 2.0 } else { 1.0 } } else { 0.0 }, ssr_rough, height as f32 / (2.0 * ty)); return; }
	let tx = ty * width as f32 / height as f32;
	guard gfx::begin_pass(gfx::PassDesc { color: [ssr_hit, none(), none(), none()], color_value: f4(0.0, 0.0, 0.0, 0.0), .. }) else { return; }
	gfx::bind(pipe_ssr);
	gfx::bind_texture(gfx::FRAGMENT, 0, lin_depth, smp_point);
	for k in HIZ_LEVELS { gfx::bind_texture(gfx::FRAGMENT, k + 1, hiz[k], smp_point); }
	gfx::bind_texture(gfx::FRAGMENT, HIZ_LEVELS + 1, nd, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, HIZ_LEVELS + 2, if mt_ran { motion_tex } else { white }, smp_point);
	gfx::uniforms(gfx::FRAGMENT, 0, SsrU { lens: f4(tx, ty, 1.0 / width as f32, 1.0 / height as f32), jit: f4(jitter.x, jitter.y, width as f32, height as f32), tune: f4(min(ssr_steps, 128) as f32, ssr_thickness, ssr_max_dist, if mt_ran { 1.0 } else { 0.0 }), edge: f4(ssr_edge, view.near, if temporal_on() { (frames % 128) as f32 + 1.0 } else { 0.0 }, 0.0), inv_view: linalg::inverse(view_mat), prev_vp: prev_view_proj });
	gfx::draw(3);
	gfx::end_pass();
	frame_u.refl = f4(if ssr_have { 1.0 } else { 0.0 }, if spec_occlusion { if bent_ran { 2.0 } else { 1.0 } } else { 0.0 }, ssr_rough, height as f32 / (2.0 * ty));
}
fn ssgi_live() bool { ssgi_on && !gi_on && !capturing }
fn ssgi_pass() {
	frame_u.ssgi = f4(0.0, 0.0, 0.0, 0.0);
	if !ssgi_live() || !nd_ran || hiz.len == 0 || !mt_ran { ssgi_valid = false; return; }
	make_ssgi();
	if temporal_reset { ssgi_valid = false; }
	let ty = linalg::f(tan((view.fov_y * 0.5) as real));
	let tx = ty * width as f32 / height as f32;
	guard gfx::begin_pass(gfx::PassDesc { color: [ssgi_new, none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_ssgi_trace);
	gfx::bind_texture(gfx::FRAGMENT, 0, lin_depth, smp_point);
	for k in HIZ_LEVELS { gfx::bind_texture(gfx::FRAGMENT, k + 1, hiz[k], smp_point); }
	gfx::bind_texture(gfx::FRAGMENT, HIZ_LEVELS + 1, nd, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, HIZ_LEVELS + 2, motion_tex, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, HIZ_LEVELS + 3, ssr_prev, smp_linear);
	gfx::uniforms(gfx::FRAGMENT, 0, SsgiU { lens: f4(tx, ty, 1.0 / width as f32, 1.0 / height as f32), jit: f4(jitter.x, jitter.y, width as f32, height as f32), tune: f4(min(ssgi_steps, 128) as f32, ssgi_thickness, ssgi_dist, 1.0), edge: f4(ssgi_edge, view.near, (frames % 1024) as f32, 0.0), inv_view: linalg::inverse(view_mat), prev_vp: prev_view_proj, misc: f4(min(max(ssgi_rays, 1), 16) as f32, if ssr_have { 1.0 } else { 0.0 }, 0.0, 0.0) });
	gfx::draw(3);
	gfx::end_pass();
	let into = 1 - ssgi_cur;
	guard gfx::begin_pass(gfx::PassDesc { color: [ssgi_hc[into], ssgi_hz[into], none(), none()], .. }) else { return; }
	gfx::bind(pipe_ssgi_accum);
	gfx::bind_texture(gfx::FRAGMENT, 0, ssgi_new, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 1, ssgi_hc[ssgi_cur], smp_linear);
	gfx::bind_texture(gfx::FRAGMENT, 2, ssgi_hz[ssgi_cur], smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 3, lin_depth, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 4, motion_tex, smp_point);
	gfx::uniforms(gfx::FRAGMENT, 0, SsgiAU { size: f4(width as f32, height as f32, 1.0 / width as f32, 1.0 / height as f32), tune: f4(if ssgi_valid { 1.0 } else { 0.0 }, 0.05, max(ssgi_frames, 1.0), 0.0), jit: f4(jitter.x, jitter.y, 0.0, 0.0) });
	gfx::draw(3);
	gfx::end_pass();
	ssgi_cur = into;
	guard gfx::begin_compute([ssgi_buf]) else { return; }
	gfx::bind(pipe_ssgi_up);
	gfx::bind_texture(gfx::COMPUTE, 0, ssgi_hc[ssgi_cur], smp_point);
	gfx::bind_texture(gfx::COMPUTE, 1, ssgi_hz[ssgi_cur], smp_point);
	gfx::bind_texture(gfx::COMPUTE, 2, lin_depth, smp_point);
	gfx::bind_texture(gfx::COMPUTE, 3, nd, smp_point);
	gfx::uniforms(gfx::COMPUTE, 0, SsgiUpU { size: f4(width as f32, height as f32, 0.0, 0.0), tune: f4(0.05, 0.0, 0.0, 0.0) });
	gfx::dispatch((width + 63) / 64, height, 1);
	gfx::end_compute();
	ssgi_valid = true;
	frame_u.ssgi = f4(1.0, width as f32, ssgi_intensity, clamp(ssgi_ao, 0.0, 1.0));
}
fn ssr_capture() {
	if !(ssr_on || ssgi_live()) || hiz.len == 0 { return; }
	guard gfx::begin_pass(gfx::PassDesc { color: [ssr_prev, none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_ssr_copy);
	gfx::bind_texture(gfx::FRAGMENT, 0, resolved(), smp_linear);
	gfx::draw(3);
	gfx::end_pass();
	if ssr_on { gfx::generate_mips(ssr_prev); }
	ssr_have = true;
}
fn cut_cover(m gltf::Material) bool { alpha_to_coverage && m.alpha_mode == gltf::ALPHA_MASK }
fn lit_pipe(m gltf::Material) gfx::Pipeline { if cut_cover(m) { if m.double_sided { pipe_cut_two } else { pipe_cut } } else { if m.double_sided { pipe_lit_two } else { pipe_lit } } }
fn mip_scale() f32 { (if mip_bias_auto && !capturing { min(width as f32 / max(out_width, 1) as f32, 1.0) } else { 1.0 }) * linalg::f(pow(2.0, mip_bias as real)) }
fn surface_of(m gltf::Material) SurfaceU {
	SurfaceU {
		base: m.base,
		emissive: x4(m.emissive, if m.unlit { 1.0 } else { 0.0 }),
		params: f4(m.metallic, m.roughness, if m.normal_tex.texture < 0 || gltf::textures[m.normal_tex.texture].image < 0 { 0.0 } else { m.normal_scale }, m.occlusion_strength),
		alpha: f4(m.alpha_mode as f32, m.alpha_cutoff, if m.double_sided && !m.keep_normal { 1.0 } else { 0.0 }, if cut_cover(m) { MSAA as f32 } else { 0.0 }),
		uv_sets: f4(m.base_tex.uv as f32, m.mr_tex.uv as f32, m.normal_tex.uv as f32, m.occlusion_tex.uv as f32),
		uv_sets2: f4(m.emissive_tex.uv as f32, debug_view as f32, ((if multiscatter { 1 } else { 0 }) + 2 * furnace_mode) as f32, furnace_scale),
		tri: f4(m.tri, if m.top_base.texture < 0 { 0.0 } else { m.top }, m.top_scale, m.top_sharp),
		top_tint: m.top_tint,
		xm_base: m.base_tex.m, xm_mr: m.mr_tex.m, xm_nrm: m.normal_tex.m, xm_occ: m.occlusion_tex.m, xm_emi: m.emissive_tex.m,
		xo0: f4(m.base_tex.o.x, m.base_tex.o.y, m.mr_tex.o.x, m.mr_tex.o.y), xo1: f4(m.normal_tex.o.x, m.normal_tex.o.y, m.occlusion_tex.o.x, m.occlusion_tex.o.y), xo2: f4(m.emissive_tex.o.x, m.emissive_tex.o.y, mip_scale(), 0.0),
		sheen: x4(m.sheen, m.sheen_rough),
		misc: f4(m.catcher, m.shading as f32, if m.ext { 1.0 } else { 0.0 }, 1.0),
		shade_a: m.shade_a, shade_b: m.shade_b, shade_c: m.shade_c, xm_det: m.detail.m, xo_det: f4(m.detail.o.x, m.detail.o.y, 0.0, 0.0),
		top_lay: f4(ext_layer(m.top_base, 1, 0), ext_layer(m.top_mr, 0, 0), ext_layer(m.top_normal, 0, 1), ext_layer(m.detail, 0, 1))
	}
}

fn draw_lit(b Batch) {
	let m = material_of(b.prim);
	gfx::uniforms(gfx::VERTEX, 0, draw_uniforms(b, view_proj));
	gfx::uniforms(gfx::FRAGMENT, 0, frame_u);
	var su = surface_of(m);
	if m.ext { su.misc.w = linalg::f(sqrt((b.model.c0.x * b.model.c0.x + b.model.c0.y * b.model.c0.y + b.model.c0.z * b.model.c0.z) as real)); }
	gfx::uniforms(gfx::FRAGMENT, 1, su);
	if m.ext { gfx::uniforms(gfx::FRAGMENT, 2, ext_of(m)); ext_pushed = true; } else if !ext_pushed { gfx::uniforms(gfx::FRAGMENT, 2, ext_zero); ext_pushed = true; }
	bind_slot(0, m.base_tex, true, white);
	bind_slot(1, m.mr_tex, false, white);
	bind_slot(2, m.normal_tex, false, flat_normal);
	bind_slot(3, m.occlusion_tex, false, white);
	bind_slot(4, m.emissive_tex, true, white);
	gfx::bind_texture(gfx::FRAGMENT, 5, shadow_map, smp_shadow);
	gfx::bind_texture(gfx::FRAGMENT, 6, if contact_on() { contact_tex } else if look.ssao { ao } else { white }, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 10, shadow_map, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 11, if local_size > 0 { local_map } else { shadow_map }, smp_shadow);
	gfx::bind_texture(gfx::FRAGMENT, 7, ext_arr[0], smp_ext);
	gfx::bind_texture(gfx::FRAGMENT, 8, ext_arr[1], smp_ext);
	gfx::bind_texture(gfx::FRAGMENT, 9, if trans_tex.id != 0 { trans_tex } else { white }, smp_trans);
	gfx::bind_texture(gfx::FRAGMENT, 12, if bent_ran { bent } else { white }, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 13, if ssr_on && ssr_hit.id != 0 { ssr_hit } else { white }, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 14, if ssr_on && ssr_hit.id != 0 { ssr_prev } else { white }, smp_linear);
	gfx::bind_texture(gfx::FRAGMENT, 15, envmap::texture(), envmap::smp);
	gi_bind();
	draw_prim(b);
}

fn trans_capture() {
	if trans_w != width || trans_h != height {
		if trans_tex.id != 0 { gfx::release(trans_tex); }
		trans_tex = gfx::texture(gfx::TextureDesc { format: gfx::RGBA16F, usage: gfx::SAMPLED | gfx::COLOR_TARGET, width: width as i32, height: height as i32, mips: mip_count(width, height) as i32 });
		trans_w = width;
		trans_h = height;
	}
	guard gfx::begin_pass(gfx::PassDesc { color: [trans_tex, none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_trans_copy);
	gfx::bind_texture(gfx::FRAGMENT, 0, hdr, smp_linear);
	gfx::bind_texture(gfx::FRAGMENT, 1, nd, smp_point);
	gfx::draw(3);
	gfx::end_pass();
	gfx::generate_mips(trans_tex);
}
fn color_pass() {
	inst_all = false;
	let clear = x4(sky.horizon, 1.0);
	ext_pushed = false;
	guard gfx::begin_pass(gfx::PassDesc { color: [color_ms, none(), none(), none()], resolve: [hdr, none(), none(), none()], depth: depth_ms, color_value: clear, .. }) else { return; }
	// with sky drawing off the sky pass writes the flat clear colour
	gfx::bind(pipe_sky);
	gfx::bind_texture(gfx::FRAGMENT, 0, envmap::texture(), envmap::smp);
	gfx::uniforms(gfx::FRAGMENT, 0, sky_u());
	gfx::draw(3);
	// opaque and cut-out, single- then double-sided
	for pass in if alpha_to_coverage { 4 } else { 2 } {
		let pp = if pass == 0 { pipe_lit } else if pass == 1 { pipe_lit_two } else if pass == 2 { pipe_cut } else { pipe_cut_two };
		var bound = false;
		for b in batch {
			if b.mode == gltf::ALPHA_BLEND || b.trans || !b.vis { continue; }
			if lit_pipe(material_of(b.prim)).id != pp.id { continue; }
			if !bound { gfx::bind(pp); bind_geometry(); bound = true; }
			draw_lit(b);
		}
	}
	var any_trans = false;
	for b in batch { if b.trans && b.vis { any_trans = true; } }
	if any_trans && !capturing {
		gfx::end_pass();
		trans_capture();
		guard gfx::begin_pass(gfx::PassDesc { color: [color_ms, none(), none(), none()], resolve: [hdr, none(), none(), none()], depth: depth_ms, clear_color: false, clear_depth: false, .. }) else { return; }
		for b in batch {
			if !b.trans || !b.vis { continue; }
			gfx::bind(lit_pipe(material_of(b.prim)));
			bind_geometry();
			draw_lit(b);
		}
	}
	// blended, far to near
	var order int[>..] = [];
	for b, i in batch { if b.mode == gltf::ALPHA_BLEND && b.vis { order.push(i); } }
	for i in 1..order.len {
		var j = i;
		while j > 0 && batch[order[j - 1]].depth < batch[order[j]].depth {
			let t = order[j]; order[j] = order[j - 1]; order[j - 1] = t;
			j -= 1;
		}
	}
	for i in order {
		if material_of(batch[i].prim).double_sided {
			gfx::bind(pipe_blend_back);
			bind_geometry();
			draw_lit(batch[i]);
		}
		gfx::bind(pipe_blend);
		bind_geometry();
		draw_lit(batch[i]);
	}
	let fwd = forward();
	let right = linalg::unit3(linalg::cross3(fwd, view.up));
	let up = linalg::cross3(right, fwd);
	if !capturing {
		quad_draw(true);
		quad_draw(false);
		sparks::draw(view_proj, right, up);
		fx::draw(view_proj, view_mat, right, up, nd, nd_ran, 1.0, width, height);
	}
	gfx::end_pass();
}

fn lens_tiles(src gfx::Texture, mode f32) {
	let k = lens_tile_px;
	let tw = max((width + k - 1) / k, 1); let th = max((height + k - 1) / k, 1);
	let ty = linalg::f(tan((view.fov_y * 0.5) as real));
	guard gfx::begin_pass(gfx::PassDesc { color: [tile_a, none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_lens_tile);
	gfx::bind_texture(gfx::FRAGMENT, 0, src, smp_point);
	gfx::uniforms(gfx::FRAGMENT, 0, TileU { size: f4(width as f32, height as f32, k as f32, 0.0), lens: f4(dof_aperture * height as f32 / (2.0 * ty), dof_focus, dof_max_px, motion_blur), mode: f4(mode, 0.0, 0.0, 0.0) });
	gfx::draw(3);
	gfx::end_pass();
	guard gfx::begin_pass(gfx::PassDesc { color: [tile_b, none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_lens_near);
	gfx::bind_texture(gfx::FRAGMENT, 0, tile_a, smp_point);
	gfx::uniforms(gfx::FRAGMENT, 0, NearU { size: f4(tw as f32, th as f32, 0.0, 0.0), mode: f4(mode, 0.0, 0.0, 0.0) });
	gfx::draw(3);
	gfx::end_pass();
}
fn lens_swap() { let t = hdr; hdr = fx; fx = t; }
fn fog_pass() {
	if !fog_on || !nd_ran { return; }
	guard gfx::begin_pass(gfx::PassDesc { color: [fx, none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_fog);
	gfx::bind_texture(gfx::FRAGMENT, 0, hdr, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 1, nd, smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 2, shadow_map, smp_shadow);
	gfx::bind_texture(gfx::FRAGMENT, 3, envmap::texture(), envmap::smp);
	var u FogU;
	u.inv_view_proj = linalg::inverse(view_proj);
	u.cascade_mat[0] = frame_u.cascade_mat[0]; u.cascade_mat[1] = frame_u.cascade_mat[1]; u.cascade_mat[2] = frame_u.cascade_mat[2];
	u.cascade_far = frame_u.cascade_far; u.eye = frame_u.eye; u.view_dir = frame_u.view_dir; u.to_sun = frame_u.to_sun;
	u.sun_rgb = x4(sun.rgb * fog_sun, 0.0);
	u.ambient = x4(fog_ambient, 0.0);
	u.params = f4(fog_density, fog_falloff, fog_height, fog_far);
	u.params2 = f4(fog_steps as f32, (frames % 64) as f32, fog_g, frame_u.screen.z);
	u.env = frame_u.env;
	u.env_rot = frame_u.env_rot;
	for k in MAX_LIGHTS { u.light_pos[k] = frame_u.light_pos[k]; u.light_rgb[k] = frame_u.light_rgb[k]; }
	gfx::uniforms(gfx::FRAGMENT, 0, u);
	gfx::draw(3);
	gfx::end_pass();
	lens_swap();
}

fn lens_pass() {
	let k = lens_tile_px;
	if motion_blur > 0.0 && motion_tex.id != 0 {
		lens_tiles(motion_tex, 0.0);
		guard gfx::begin_pass(gfx::PassDesc { color: [fx, none(), none(), none()], .. }) else { return; }
		gfx::bind(pipe_mblur);
		gfx::bind_texture(gfx::FRAGMENT, 0, hdr, smp_point);
		gfx::bind_texture(gfx::FRAGMENT, 1, motion_tex, smp_point);
		gfx::bind_texture(gfx::FRAGMENT, 2, tile_b, smp_point);
		gfx::uniforms(gfx::FRAGMENT, 0, MblurU { size: f4(width as f32, height as f32, 0.0, k as f32), tune: f4(motion_blur, k as f32, mb_samples as f32, mb_soft_z) });
		gfx::draw(3);
		gfx::end_pass();
		lens_swap();
	}
	if dof_aperture > 0.0 {
		lens_tiles(nd, 1.0);
		let ty = linalg::f(tan((view.fov_y * 0.5) as real));
		guard gfx::begin_pass(gfx::PassDesc { color: [fx, none(), none(), none()], .. }) else { return; }
		gfx::bind(pipe_dof_pack);
		gfx::bind_texture(gfx::FRAGMENT, 0, hdr, smp_point);
		gfx::bind_texture(gfx::FRAGMENT, 1, nd, smp_point);
		gfx::draw(3);
		gfx::end_pass();
		lens_swap();
		guard gfx::begin_pass(gfx::PassDesc { color: [fx, none(), none(), none()], .. }) else { return; }
		gfx::bind(pipe_dof);
		gfx::bind_texture(gfx::FRAGMENT, 0, hdr, smp_point);
		gfx::bind_texture(gfx::FRAGMENT, 1, tile_b, smp_point);
		gfx::uniforms(gfx::FRAGMENT, 0, DofU { size: f4(width as f32, height as f32, 0.0, k as f32), lens: f4(dof_aperture * height as f32 / (2.0 * ty), dof_focus, dof_max_px, 0.0), tune: f4(dof_samples as f32, 0.0, 0.0, 0.0) });
		gfx::draw(3);
		gfx::end_pass();
		lens_swap();
	}
}
fn temporal_draw() {
	let into = 1 - hist_cur;
	guard gfx::begin_pass(gfx::PassDesc { color: [history[into], none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_temporal);
	gfx::bind_texture(gfx::FRAGMENT, 0, hdr, smp_linear);
	gfx::bind_texture(gfx::FRAGMENT, 1, history[hist_cur], smp_point);
	gfx::bind_texture(gfx::FRAGMENT, 2, motion_tex, smp_point);
	let fresh = !hist_valid || temporal_reset;
	let up = out_width as f32 / width as f32;
	gfx::uniforms(gfx::FRAGMENT, 0, TemporalU {
		in_size: f4(width as f32, height as f32, 1.0 / width as f32, 1.0 / height as f32),
		out_size: f4(out_width as f32, out_height as f32, 1.0 / out_width as f32, 1.0 / out_height as f32),
		jitter: f4(jitter.x, jitter.y, if fresh { 1.0 } else { 0.0 }, temporal_blend),
		// footprint: about one input pixel measured in output pixels
		tune: f4(temporal_gamma, temporal_motion, temporal_max, max(0.5 * up, 0.75)),
		reject: f4(temporal_depth_reject, temporal_motion_scale, 0.0, 0.0)
	});
	gfx::draw(3);
	gfx::end_pass();
	hist_cur = into;
}

fn temporal_pass() {
	temporal_used = temporal_on();
	if !temporal_used { hist_valid = false; temporal_reset = false; return; }
	temporal_draw();
	hist_valid = true;
	temporal_reset = false;
}

// Runs only the temporal pass n more times on the last frame's inputs (for timing).
fn temporal_repeat(n int) { for k in n { temporal_draw(); } }

fn glow_pass() {
	if look.bloom <= 0.0 { return; }
	let cut = f4(look.bloom_cut, look.bloom_cut * 0.5, 64.0, 1.0);
	guard gfx::begin_pass(gfx::PassDesc { color: [glow[0], none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_bright);
	gfx::bind_texture(gfx::FRAGMENT, 0, resolved(), smp_linear);
	gfx::uniforms(gfx::FRAGMENT, 0, GlowU { texel: f4(1.0 / out_width as f32, 1.0 / out_height as f32, 0.0, 0.0), cut: cut });
	gfx::draw(3);
	gfx::end_pass();
	for k in 1..GLOW_LEVELS {
		let src = gfx::texture_info(glow[k - 1]);
		guard gfx::begin_pass(gfx::PassDesc { color: [glow[k], none(), none(), none()], .. }) else { return; }
		gfx::bind(pipe_down);
		gfx::bind_texture(gfx::FRAGMENT, 0, glow[k - 1], smp_linear);
		gfx::uniforms(gfx::FRAGMENT, 0, GlowU { texel: f4(1.0 / src.width as f32, 1.0 / src.height as f32, 0.0, 0.0), cut: cut });
		gfx::draw(3);
		gfx::end_pass();
	}
	var k = GLOW_LEVELS - 1;
	while k > 0 {
		let src = gfx::texture_info(glow[k]);
		guard gfx::begin_pass(gfx::PassDesc { color: [glow[k - 1], none(), none(), none()], clear_color: false, .. }) else { return; }
		gfx::bind(pipe_up);
		gfx::bind_texture(gfx::FRAGMENT, 0, glow[k], smp_linear);
		gfx::uniforms(gfx::FRAGMENT, 0, GlowU { texel: f4(1.0 / src.width as f32, 1.0 / src.height as f32, 0.0, 0.0), cut: f4(cut.x, cut.y, cut.z, 0.8) });
		gfx::draw(3);
		gfx::end_pass();
		k -= 1;
	}
}

fn set_lut(rgba const byte[:], n int) bool {
	if n < 2 || rgba.len < n * n * n * 4 { return false; }
	if lut_n > 0 { gfx::release(lut_tex); }
	lut_tex = gfx::texture3d(n, n, n, gfx::RGBA8, gfx::SAMPLED);
	gfx::update_texture(lut_tex, rgba[..n * n * n * 4]);
	lut_n = n;
	true
}
fn identity_lut(n int) {
	var px byte[>..] = [];
	for b in n { for g in n { for r in n { px.push((r * 255 / (n - 1)) as byte); px.push((g * 255 / (n - 1)) as byte); px.push((b * 255 / (n - 1)) as byte); px.push(255); } } }
	let _ = set_lut(px[..], n);
}
fn lut_strip(rgba const byte[:], w int, h int) bool {
	let n = h;
	if n < 2 || w != n * n { return false; }
	var px byte[>..] = [];
	for b in n { for g in n { for r in n { let o = (g * w + b * n + r) * 4; px.push(rgba[o]); px.push(rgba[o + 1]); px.push(rgba[o + 2]); px.push(255); } } }
	set_lut(px[..], n)
}
fn lut_cube(text const byte[:]) bool {
	var n = 0;
	var vals f32[>..] = [];
	for line in split(text, '\n') {
		let w = words(line);
		if w.len == 0 || w[0][0] == 35 { continue; }
		if w[0] == "LUT_3D_SIZE" && w.len > 1 { let v, ok = parse_int(w[1]); if ok { n = v; } continue; }
		if w.len == 3 { var ok = true; for t in w { let v, good = parse_flt(t); if good { vals.push(v as f32); } else { ok = false; } } if !ok { return false; } }
	}
	if n < 2 || vals.len < n * n * n * 3 { return false; }
	var px byte[>..] = [];
	for i in n * n * n { for c in 3 { px.push((clamp(vals[i * 3 + c], 0.0, 1.0) * 255.0 + 0.5) as byte); } px.push(255); }
	set_lut(px[..], n)
}
fn exposure_pass() {
	if !look.auto_exposure { expo_fresh = true; return; }
	let src = resolved();
	let span = max(ae_log_max - ae_log_min, 1.0);
	guard gfx::begin_compute([hist_buf]) else { return; }
	gfx::bind(pipe_hist);
	gfx::bind_texture(gfx::COMPUTE, 0, src, smp_point);
	gfx::uniforms(gfx::COMPUTE, 0, HistU { size: f4(out_width as f32, out_height as f32, 2.0, (frames % 2) as f32), range: f4(ae_log_min, 1.0 / span, max(look.ae_center, 0.0), 0.0) });
	gfx::dispatch((out_width / 2 + 7) / 8, (out_height / 2 + 7) / 8, 1);
	gfx::end_compute();
	guard gfx::begin_compute([hist_buf, expo_buf]) else { return; }
	gfx::bind(pipe_adapt);
	gfx::uniforms(gfx::COMPUTE, 0, AdaptU { range: f4(ae_log_min, 1.0 / span, 0.0, look.ae_max), pct: f4(clamp(look.ae_low, 0.0, 1.0), clamp(look.ae_high, 0.0, 1.0), look.ae_key, look.ae_min), rate: f4(look.ae_up, look.ae_down, exposure_dt, if expo_fresh || temporal_reset { 1.0 } else { 0.0 }) });
	gfx::dispatch(1, 1, 1);
	gfx::end_compute();
	expo_fresh = false;
}
fn exposure_now() f32 {
	var v f32[>..] = [];
	if !gfx::read_buffer(expo_buf, v, 4) { return 1.0; }
	v[0]
}
fn grade_pass(target gfx::Texture) {
	guard gfx::begin_pass(gfx::PassDesc { color: [target, none(), none(), none()], .. }) else { return; }
	gfx::bind(pipe_grade);
	gfx::bind_texture(gfx::FRAGMENT, 0, resolved(), if look.chroma > 0.0 { smp_linear } else { smp_point });
	gfx::bind_texture(gfx::FRAGMENT, 1, if look.bloom > 0.0 { glow[0] } else { white }, smp_linear);
	gfx::bind_texture(gfx::FRAGMENT, 2, lut_tex, smp_linear);
	gfx::bind_storage_buffer(gfx::FRAGMENT, 0, expo_buf);
	gfx::uniforms(gfx::FRAGMENT, 0, GradeU { tone: f4(look.exposure, look.white, look.bloom, look.desaturate), mode: f4(look.curve as f32, if look.auto_exposure { 1.0 } else { 0.0 }, if lut_n > 0 { clamp(look.lut, 0.0, 1.0) } else { 0.0 }, lut_n as f32), lens: f4(look.vignette, look.chroma, look.grain, look.sharpen), color: f4(look.saturation, look.contrast, look.warmth, 0.0), frame: f4(out_width as f32, out_height as f32, (frames % 1024) as f32, 0.0) });
	gfx::draw(3);
	gfx::end_pass();
}

// Renders the scene into target (RGBA8, COLOR_TARGET, the output size given to init).
fn probe_capture() {
	probes_dirty = false;
	if probes.len == 0 { probe_gen = envmap::gen; return; }
	for i in 1..probes.len {
		var j = i;
		while j > 0 && probe_vol(probes[j - 1]) > probe_vol(probes[j]) {
			let t = probes[j]; probes[j] = probes[j - 1]; probes[j - 1] = t;
			j -= 1;
		}
	}
	envmap::reserve(probes.len + 1);
	let n = envmap::cube_n;
	let ps = max(probe_res, 16);
	let sv = view;
	let sw = width;
	let sh = height;
	let sow = out_width;
	let soh = out_height;
	let scm = color_ms;
	let sdm = depth_ms;
	let shd = hdr;
	let st = temporal;
	let sao = look.ssao;
	let sct = sun.contact;
	let sssr = ssr_on;
	let slo = lens_offset;
	let svpn = view_proj_nj;
	let spvp = prev_view_proj;
	let smf = motion_fresh;
	color_ms = gfx::texture(gfx::TextureDesc { format: gfx::RGBA16F, usage: gfx::COLOR_TARGET, width: ps as i32, height: ps as i32, samples: MSAA as i32 });
	depth_ms = gfx::texture(gfx::TextureDesc { format: gfx::DEPTH32F, usage: gfx::DEPTH_TARGET, width: ps as i32, height: ps as i32, samples: MSAA as i32 });
	hdr = gfx::render_target(ps, ps, gfx::RGBA16F);
	width = ps;
	height = ps;
	out_width = ps;
	out_height = ps;
	temporal = 0;
	look.ssao = false;
	sun.contact = 0.0;
	ssr_on = false;
	bent_ran = false;
	lens_offset = float2 { 0.0, 0.0 };
	capturing = true;
	let raw = gfx::texture(gfx::TextureDesc { kind: gfx::TEXTURE_CUBE, format: gfx::RGBA16F, usage: gfx::SAMPLED | gfx::COLOR_TARGET, width: n as i32, height: n as i32, mips: envmap::mip_count(n) as i32 });
	let axes float3[6] = [float3 { 1.0, 0.0, 0.0 }, float3 { -1.0, 0.0, 0.0 }, float3 { 0.0, 1.0, 0.0 }, float3 { 0.0, -1.0, 0.0 }, float3 { 0.0, 0.0, 1.0 }, float3 { 0.0, 0.0, -1.0 }];
	for b in max(probe_bounces, 1) {
	cap_np = if b == 0 { 0 } else { min(probes.len, MAX_PROBES) };
	for p, i in probes {
		for f in 6 {
			view = Camera { eye: p.pos, target: p.pos + axes[f], up: if f == 2 || f == 3 { float3 { 0.0, 0.0, 1.0 } } else { float3 { 0.0, 1.0, 0.0 } }, fov_y: 1.5707964, near: probe_near, far: sv.far };
			setup_view();
			gather();
			setup_cascades();
			warm_textures();
			fill_frame();
			light_upload();
			shadow_pass();
			local_shadow_pass();
			color_pass();
			guard gfx::begin_pass(gfx::PassDesc { color: [raw, none(), none(), none()], layer: f as i32, .. }) else { continue; }
			gfx::bind(pipe_probe_copy);
			gfx::bind_texture(gfx::FRAGMENT, 0, hdr, smp_linear);
			gfx::uniforms(gfx::FRAGMENT, 0, ProbeCopyU { vp: view_proj_nj, p: f4(f as f32, 0.0, 0.0, 0.0) });
			gfx::draw(3);
			gfx::end_pass();
		}
		gfx::generate_mips(raw);
		envmap::filter(raw, n, i + 1, b == 0 || b < probe_bounces - 1);
	}
	}
	gfx::release(raw);
	gfx::release(color_ms);
	gfx::release(depth_ms);
	gfx::release(hdr);
	view = sv;
	width = sw;
	height = sh;
	out_width = sow;
	out_height = soh;
	color_ms = scm;
	depth_ms = sdm;
	hdr = shd;
	temporal = st;
	look.ssao = sao;
	sun.contact = sct;
	ssr_on = sssr;
	lens_offset = slo;
	view_proj_nj = svpn;
	prev_view_proj = spvp;
	motion_fresh = smf;
	capturing = false;
	probe_gen = envmap::gen;
}
fn render(target gfx::Texture) {
	if render_begin() { render_end(target); }
}
fn render_begin() bool {
	if !ready { return false; }
	upload_geometry();
	if probes_dirty || (probes.len > 0 && probe_gen != envmap::gen) { probe_capture(); }
	setup_view();
	gather();
	setup_cascades();
	warm_textures();
	fill_frame();
	gi_pass();
	fill_frame();
	light_upload();
	shadow_pass();
	local_shadow_pass();
	ao_pass();
	contact_pass();
	ssr_pass();
	ssgi_pass();
	if fx::ready() && fx_dt > 0.0 { shelter_pass(); fx::simulate(fx_dt, nd, nd_ran, view_mat, view_proj_nj); }
	quad_upload();
	color_pass();
	fog_pass();
	true
}
fn render_end(target gfx::Texture) {
	lens_pass();
	temporal_pass();
	ssr_capture();
	glow_pass();
	exposure_pass();
	grade_pass(target);
	for i in items.len { items[i].prev_place = items[i].place; }
	wind_prev = wind.time;
	prev_pushers.clear(); prev_pushers.append(pushers[..]);
	quads.clear();
	frames += 1;
}
