struct GlowU { texel float4, cut float4 }
struct GradeU { tone float4, mode float4, lens float4, color float4, frame float4 }
struct HistU { size float4, range float4 }
struct AdaptU { range float4, pct float4, rate float4 }
struct FogU { inv_view_proj gfx::mat4, cascade_mat gfx::mat4[3], cascade_far float4, eye float4, view_dir float4, to_sun float4, sun_rgb float4, ambient float4, params float4, params2 float4, light_pos float4[16], light_rgb float4[16], env float4, env_rot float4 }
struct QuadG { p float4[4], c float4[4], prm float4 }
struct QuadViewU { view_proj gfx::mat4, right float4, up float4 }
struct SsrU { lens float4, jit float4, tune float4, edge float4, inv_view gfx::mat4, prev_vp gfx::mat4 }
struct SsgiU { lens float4, jit float4, tune float4, edge float4, inv_view gfx::mat4, prev_vp gfx::mat4, misc float4 }
struct SsgiAU { size float4, tune float4, jit float4 }
struct SsgiUpU { size float4, tune float4 }
struct HizU { hz float4 }
struct TemporalU { in_size float4, out_size float4, jitter float4, tune float4, reject float4 }

