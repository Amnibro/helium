}
vec3 lit1(vec3 P, vec3 T, vec3 V, vec3 L, vec3 sig, vec3 cms, float h, float bm, float ex, vec2 ld, float sb) {
	float nf = min(ld.y * look.y, 60.0), tr = exp(-ld.x * light.z);
