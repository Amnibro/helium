	return tr * sb * fs + tf * cms * exp(-0.5 * sl * sl / sf2) * inversesqrt(6.2831853 * sf2) * 0.1591549 * 2.0 * look.w;
}
vec3 shadeAt(vec3 P, vec3 T, vec3 sig0, vec3 cms, float h, float bm) {
	vec3 sig = sig0, V = normalize(cam.xyz - P);
	vec3 col = vec3(0.0);
