layout(std430, set = 0, binding = 3) readonly buffer Segs { uvec4 segs[]; };
layout(std430, set = 0, binding = 4) readonly buffer LFront { uint lfront[]; };
layout(std430, set = 0, binding = 5) readonly buffer LAcc { uint lacc[]; };
layout(std430, set = 1, binding = 0) buffer Front { uint front[]; };
layout(std430, set = 1, binding = 1) buffer Acc { uint acc[]; };
#include "strand_gen.glsl"
#include "strand_shade.glsl"
float lightTx(ivec2 q, float w, uint s) {
	if (q.x < 0 || q.y < 0 || q.x >= int(light.x) || q.y >= int(light.y)) return 0.0;
	uint li = s * uint(light.x) * uint(light.y) + uint(q.y) * uint(light.x) + uint(q.x);
	float x = (w - uintBitsToFloat(lfront[li])) / params.x - 0.5, d = 0.0;
	for (uint k = 0u; k < 4u; k++) d += float(lacc[li * 4u + k]) / 4096.0 * clamp(x - float(k), 0.0, 1.0);
	return d;
}
float bodyT(vec3 P) {
	if (to_sun.w < 0.5) return 1.0;
	vec4 c = shadow_vp * vec4(P + to_sun.xyz * 0.004, 1.0);
	vec3 n = c.xyz / c.w;
	vec2 uv = vec2(n.x * 0.5 + 0.5, 0.5 - n.y * 0.5);
	if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return 1.0;
