		colA = shadeAt(A, TA, strandSig(g, j, t0), cb * mix(0.62, 1.0, smoothstep(0.0, 0.35, t0)) * mix(1.0, 1.08, smoothstep(0.6, 1.0, t0)), hh, bm);
		colB = shadeAt(B, TB, strandSig(g, j, t1), cb * mix(0.62, 1.0, smoothstep(0.0, 0.35, t1)) * mix(1.0, 1.08, smoothstep(0.6, 1.0, t1)), hh, bm);
