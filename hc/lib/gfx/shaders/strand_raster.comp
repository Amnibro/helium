		float dd = length(dl), q = clamp(1.0 - dd * dd / (pl[i * 2].w * pl[i * 2].w), 0.0, 1.0), ar = min(plx[i].y / dd, 1.2), tc = dot(core.xyz - P, dl) / dd, oc = tc <= 0.0 || core.w <= 0.0 ? 1.0 : smoothstep(core.w * 0.8, core.w, length(core.xyz - P - dl / dd * tc));
		if (q * oc <= 0.0) continue;
		col += params.y * seg_g * pl[i * 2 + 1].rgb * q * q / (1.0 + dd * dd * cam.w * cam.w) * lit1(P, T, V, dl / dd, sig, cms, h, bm, 0.25 * ar * ar, lightD(P, plvp[i], plx[i].x, uint(i) + 1u), oc);
