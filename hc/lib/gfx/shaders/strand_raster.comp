		float sb = bodyT(P);
		if (sb > 0.0) col = sun_rgb.rgb * params.y * seg_g * lit1(P, T, V, to_sun.xyz, sig, cms, h, bm, 0.0, lightD(P, light_vp, light.w, 0u), sb);
	}
