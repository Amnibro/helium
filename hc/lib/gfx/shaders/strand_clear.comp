layout(local_size_x = 64) in;
#include "strand_common.glsl"
layout(std430, set = 1, binding = 0) buffer Front { uint front[]; };
layout(std430, set = 1, binding = 1) buffer Acc { uint acc[]; };
void main() {
	uint i = gl_GlobalInvocationID.x;
	uint n = look.z > 1.5 ? uint(light.x) * uint(light.y) : uint(size.x) * uint(size.y);
