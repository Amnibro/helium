layout(local_size_x = 64) in;
layout(std430, set = 1, binding = 0) buffer Alive { uint alive[]; };
layout(std430, set = 1, binding = 1) buffer Keys { float keys[]; };
layout(std430, set = 1, binding = 2) buffer Ev { uint evd[]; };
layout(set = 2, binding = 0) uniform U { vec4 info; };
void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i == 0u) { alive[0] = 0u; evd[0] = 0u; evd[uint(info.w)] = 0u; }
	if (i < uint(info.x)) { keys[i] = -1.0e30; alive[i + 1u] = 0u; }
}
