layout(std430, set = 0, binding = 0) readonly buffer Joints { vec4 joint_cols[]; };
layout(std430, set = 0, binding = 1) readonly buffer Morphs { vec4 morph_data[]; };
layout(std430, set = 0, binding = 2) readonly buffer Insts { vec4 inst_cols[]; };
layout(std430, set = 0, binding = 3) readonly buffer InstIds { vec4 inst_ids[]; };
layout(set = 1, binding = 0) uniform ImpDraw { mat4 view_proj; mat4 cur_vp; mat4 prev_vp; vec4 inst; vec4 ray; vec4 box_c; vec4 box_e; vec4 knobs; };
layout(location = 0) out vec3 out_world;
layout(location = 1) flat out vec4 out_m0;
layout(location = 2) flat out vec4 out_m1;
layout(location = 3) flat out vec4 out_m2;
layout(location = 4) flat out vec4 out_ray;
layout(location = 5) flat out vec4 out_zr;
layout(location = 6) flat out vec4 out_wr;
layout(location = 7) flat out vec4 out_tint;
layout(location = 8) flat out vec4 out_c;
layout(location = 9) flat out vec4 out_e;
layout(location = 10) flat out vec4 out_k;
layout(location = 11) out vec4 out_cur;
layout(location = 12) out vec4 out_prev;
void main() {
	int q = int(inst.y) + gl_InstanceIndex;
	float v = inst_ids[q >> 2][q & 3];
	int k = (int(inst.x) + int(v)) * 4;
	vec4 c0 = inst_cols[k];
	vec4 c1 = inst_cols[k + 1];
	vec4 c2 = inst_cols[k + 2];
	vec3 t = inst_cols[k + 3].xyz;
	vec3 r0 = cross(c1.xyz, c2.xyz);
	vec3 r1 = cross(c2.xyz, c0.xyz);
	vec3 r2 = cross(c0.xyz, c1.xyz);
	float id = 1.0 / dot(c0.xyz, r0);
	r0 *= id;
	r1 *= id;
	r2 *= id;
	out_m0 = vec4(r0, -dot(r0, t));
	out_m1 = vec4(r1, -dot(r1, t));
	out_m2 = vec4(r2, -dot(r2, t));
	int j = (gl_VertexIndex / 6) * 4 + ((106632 >> (3 * (gl_VertexIndex % 6))) & 7);
	int pk = j < 8 ? 5901273 : (j < 16 ? 9734130 : 2952684);
	int ci = (pk >> (3 * (j & 7))) & 7;
	vec3 cb = vec3(float(ci & 1), float((ci >> 1) & 1), float((ci >> 2) & 1)) * 2.0 - 1.0;
	vec3 p = box_c.xyz + box_e.xyz * cb * 1.01;
	vec4 wp = vec4(c0.xyz * p.x + c1.xyz * p.y + c2.xyz * p.z + t, 1.0);
	out_world = wp.xyz;
	out_ray = ray;
	out_zr = vec4(view_proj[0][2], view_proj[1][2], view_proj[2][2], view_proj[3][2]);
	out_wr = vec4(view_proj[0][3], view_proj[1][3], view_proj[2][3], view_proj[3][3]);
	out_tint = vec4(c0.w, c1.w, c2.w, fract(v) * (4.0 / 3.0));
	out_c = box_c;
	out_e = box_e;
	out_k = knobs;
	out_cur = cur_vp * wp;
	out_prev = prev_vp * wp;
	gl_Position = view_proj * wp;
}
