#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(std430, set = 0, binding = 1) readonly buffer Tri { vec4 tri[]; };
layout(std430, set = 0, binding = 2) readonly buffer Mat { vec4 mat[]; };
layout(std430, set = 0, binding = 3) readonly buffer Tex { uint tex[]; };
layout(std430, set = 0, binding = 4) buffer Acc { vec4 acc[]; };
layout(std430, set = 0, binding = 5) readonly buffer Par { vec4 par[]; };
layout(std430, set = 0, binding = 6) readonly buffer Lit { vec4 lit[]; };
#include "lighting.glsl"
#include "ms.glsl"
uint rs;
int hit_p;
vec2 hit_b;
uint hash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }
float rnd() { rs = rs * 747796405u + 2891336453u; uint w = ((rs >> ((rs >> 28u) + 4u)) ^ rs) * 277803737u; w = (w >> 22u) ^ w; return float(w >> 8u) * (1.0 / 16777216.0); }
vec4 texel(uint t, int x, int y, int w, int h, bool srgb) {
	int xx = ((x % w) + w) % w;
	int yy = ((y % h) + h) % h;
	vec4 c = unpackUnorm4x8(tex[tex[t * 4u] + uint(yy * w + xx)]);
	return srgb ? vec4(mix(c.rgb / 12.92, pow((c.rgb + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c.rgb)), c.a) : c;
}
vec4 tsamp(float tf, vec2 uv, bool srgb) {
	if (tf < 0.0) return vec4(1.0);
	uint t = uint(tf);
	int w = int(tex[t * 4u + 1u]);
	int h = int(tex[t * 4u + 2u]);
	vec2 f = uv * vec2(float(w), float(h)) - 0.5;
	vec2 fl = floor(f);
	ivec2 i = ivec2(fl);
	vec2 r = f - fl;
	return mix(mix(texel(t, i.x, i.y, w, h, srgb), texel(t, i.x + 1, i.y, w, h, srgb), r.x), mix(texel(t, i.x, i.y + 1, w, h, srgb), texel(t, i.x + 1, i.y + 1, w, h, srgb), r.x), r.y);
}
vec2 tuv(int q, vec2 b) { return vec2(tri[q].w, tri[q + 1].w) * (1.0 - b.x - b.y) + vec2(tri[q + 2].w, tri[q + 3].x) * b.x + tri[q + 3].yz * b.y; }
bool pass_ok(int p, vec2 b) {
	int q = p * 7;
	int m = int(tri[q + 3].w) * 5;
	vec4 mm = mat[m + 2];
	if (mm.w < 0.5) return true;
	float a = mat[m].a * tri[q + 6].a * tsamp(mat[m + 3].x, tuv(q, b), false).a;
	return mm.w < 1.5 ? a >= mm.z : rnd() < a;
}
float trace(vec3 o, vec3 d, float tmax, bool any) {
	rayQueryEXT q;
	rayQueryInitializeEXT(q, tlas, any ? 4u : 0u, 255u, o, 0.0, d, tmax);
	while (rayQueryProceedEXT(q)) { if (pass_ok(rayQueryGetIntersectionPrimitiveIndexEXT(q, false), rayQueryGetIntersectionBarycentricsEXT(q, false))) rayQueryConfirmIntersectionEXT(q); }
	if (rayQueryGetIntersectionTypeEXT(q, true) == 0u) return -1.0;
	hit_p = rayQueryGetIntersectionPrimitiveIndexEXT(q, true);
	hit_b = rayQueryGetIntersectionBarycentricsEXT(q, true);
	return rayQueryGetIntersectionTEXT(q, true);
}
float offc(float p, float n) { int oi = int(256.0 * n); float pi = intBitsToFloat(floatBitsToInt(p) + (p < 0.0 ? -oi : oi)); return abs(p) < 0.03125 ? p + 0.0000152587890625 * n : pi; }
vec3 offs(vec3 p, vec3 n) { return vec3(offc(p.x, n.x), offc(p.y, n.y), offc(p.z, n.z)); }
void onb(vec3 n, out vec3 b1, out vec3 b2) {
	float s = n.z >= 0.0 ? 1.0 : -1.0;
	float a = -1.0 / (s + n.z);
	float b = n.x * n.y * a;
	b1 = vec3(1.0 + s * n.x * n.x * a, s * b, -s * n.x);
	b2 = vec3(b, s + n.y * n.y * a, -n.y);
}
vec3 fres(vec3 f0, float f90, float c) { float m = 1.0 - c; float m2 = m * m; return f0 + (vec3(f90) - f0) * (m2 * m2 * m); }
vec3 bsdf(vec3 n, vec3 v, vec3 l, vec3 alb, vec3 f0, float f90, float rough, vec3 ms, vec3 kd) {
	float nl = dot(n, l);
	if (nl <= 0.0) return vec3(0.0);
	vec3 h = normalize(v + l);
	float nv = max(dot(n, v), 1e-4);
	float al = max(rough * rough, 0.002);
	vec3 spec = ms * fres(f0, f90, max(dot(h, v), 0.0)) * (ggx_d(max(dot(n, h), 0.0), al) * smith_g(nl, nv, rough) / (4.0 * nl * nv + 1e-4));
	return (kd * alb / PI_F + spec) * nl;
}
float g1x(float c, float a) { float a2 = a * a; return 2.0 * c / (c + sqrt(a2 + (1.0 - a2) * c * c)); }
vec3 vndf(vec3 ve, float a, float u1, float u2) {
	vec3 vh = normalize(vec3(a * ve.x, a * ve.y, ve.z));
	float lsq = vh.x * vh.x + vh.y * vh.y;
	vec3 t1 = lsq > 0.0 ? vec3(-vh.y, vh.x, 0.0) * inversesqrt(lsq) : vec3(1.0, 0.0, 0.0);
	vec3 t2 = cross(vh, t1);
	float r = sqrt(u1);
	float ph = 6.28318530717959 * u2;
	float p1 = r * cos(ph);
	float s = 0.5 * (1.0 + vh.z);
	float p2 = (1.0 - s) * sqrt(max(0.0, 1.0 - p1 * p1)) + s * r * sin(ph);
	vec3 nh = t1 * p1 + t2 * p2 + vh * sqrt(max(0.0, 1.0 - p1 * p1 - p2 * p2));
	return normalize(vec3(a * nh.x, a * nh.y, max(0.0, nh.z)));
}
vec3 env(vec3 d) { return par[11].x > 0.5 ? vec3(par[11].y) : sky_color(d, normalize(par[6].xyz), par[8].rgb, par[9].rgb, par[10].rgb, par[7].rgb) * par[8].w; }
vec3 radiance(vec3 o, vec3 d) {
	vec3 L = vec3(0.0);
	vec3 tp = vec3(1.0);
	int maxd = int(par[1].z);
	int nli = int(par[1].w);
	vec3 ts = normalize(par[6].xyz);
	vec3 sb1;
	vec3 sb2;
	onb(ts, sb1, sb2);
	for (int depth = 0; depth < maxd; depth++) {
		float t = trace(o, d, 1e30, false);
		if (t < 0.0) { L += tp * env(d); break; }
		vec3 p = o + d * t;
		int q = hit_p * 7;
		vec2 hb = hit_b;
		float w0 = 1.0 - hb.x - hb.y;
		vec3 n = normalize(tri[q].xyz * w0 + tri[q + 1].xyz * hb.x + tri[q + 2].xyz * hb.y);
		vec2 uv = tuv(q, hb);
		int mb = int(tri[q + 3].w) * 5;
		vec4 m0 = mat[mb];
		vec4 m1 = mat[mb + 1];
		vec4 m2 = mat[mb + 2];
		vec4 m3 = mat[mb + 3];
		vec4 m4 = mat[mb + 4];
		vec3 gn = tri[q + 5].xyz;
		vec4 bc = m0 * tri[q + 6] * tsamp(m3.x, uv, true);
		L += tp * m1.rgb * tsamp(m3.w, uv, true).rgb;
		if (m4.z > 0.5) { L += tp * bc.rgb; break; }
		if (m3.z >= 0.0) {
			vec3 tn = tsamp(m3.z, uv, false).xyz * 2.0 - 1.0;
			vec4 tg = tri[q + 4];
			vec3 tt = normalize(tg.xyz - n * dot(n, tg.xyz));
			n = normalize(tt * (tn.x * m2.y) + cross(n, tt) * (tg.w * tn.y * m2.y) + n * tn.z);
		}
		if (dot(gn, d) > 0.0) { gn = -gn; n = -n; }
		vec3 v = -d;
		if (dot(n, v) <= 0.0) n = gn;
		float nv = max(dot(n, v), 1e-4);
		vec4 mr = tsamp(m3.y, uv, false);
		float metal = clamp(m1.w * mr.b, 0.0, 1.0);
		float rough = clamp(m2.x * mr.g, 0.0, 1.0);
		float fd = (m4.w - 1.0) / (m4.w + 1.0);
		vec3 f0 = mix(vec3(fd * fd * m4.x), bc.rgb, metal);
		float f90 = mix(m4.x, 1.0, metal);
		vec3 alb = bc.rgb * (1.0 - metal);
		vec2 eb = ms_lut(nv, rough);
		vec3 ms = ms_factor(f0, ms_e(nv, rough, eb.x), par[11].w > 0.5);
		vec3 ef = ms * (f0 * (eb.x - eb.y) + vec3(f90 * eb.y));
		vec3 kd = max(1.0 - ef, vec3(0.0));
		vec3 po = offs(p, gn);
		if (par[7].w > 0.5) {
			float ct = 1.0 - rnd() * (1.0 - par[6].w);
			float st = sqrt(max(0.0, 1.0 - ct * ct));
			float ph = 6.28318530717959 * rnd();
			vec3 l = sb1 * (st * cos(ph)) + sb2 * (st * sin(ph)) + ts * ct;
			if (dot(gn, l) > 0.0 && trace(po, l, 1e30, true) < 0.0) L += tp * bsdf(n, v, l, alb, f0, f90, rough, ms, kd) * par[7].rgb;
		}
		for (int i = 0; i < nli; i++) {
			vec3 dl = lit[i * 2].xyz - p;
			float dd = length(dl);
			vec3 l = dl / dd;
			if (dot(gn, l) > 0.0 && trace(po, l, dd, true) < 0.0) L += tp * bsdf(n, v, l, alb, f0, f90, rough, ms, kd) * (lit[i * 2 + 1].rgb * range_falloff(dd, lit[i * 2 + 1].w));
		}
		float ws = dot(ef, vec3(0.2126, 0.7152, 0.0722));
		float wd = dot(kd * alb, vec3(0.2126, 0.7152, 0.0722));
		float ps = ws + wd > 0.0 ? ws / (ws + wd) : 0.0;
		vec3 b1;
		vec3 b2;
		onb(n, b1, b2);
		float a = max(rough * rough, 0.002);
		vec3 l;
		if (rnd() < ps) {
			vec3 h = vndf(vec3(dot(v, b1), dot(v, b2), nv), a, rnd(), rnd());
			l = reflect(-v, b1 * h.x + b2 * h.y + n * h.z);
		} else {
			float r1 = rnd();
			float rr = sqrt(r1);
			float ph = 6.28318530717959 * rnd();
			l = b1 * (rr * cos(ph)) + b2 * (rr * sin(ph)) + n * sqrt(max(0.0, 1.0 - r1));
		}
		float nl = dot(n, l);
		if (nl <= 0.0 || dot(gn, l) <= 0.0) break;
		vec3 hh = normalize(v + l);
		float pdf = ps * par[12].x * ggx_d(max(dot(n, hh), 0.0), a) * g1x(nv, a) / (4.0 * nv) + (1.0 - ps) * nl / PI_F;
		if (pdf <= 0.0) break;
		tp *= bsdf(n, v, l, alb, f0, f90, rough, ms, kd) / pdf;
		if (depth >= 3) { float pq = min(max(tp.x, max(tp.y, tp.z)), 0.95); if (rnd() >= pq) break; tp /= pq; }
		o = po;
		d = l;
	}
	return L;
}
void main() {
	uvec2 g = gl_GlobalInvocationID.xy;
	uvec2 px = g + uvec2(par[1].xy);
	vec2 wh = par[0].xy;
	if (px.x >= uint(wh.x) || px.y >= uint(wh.y) || g.x >= uint(par[12].z) || g.y >= uint(par[12].w)) return;
	uint pi = px.y * uint(wh.x) + px.x;
	int n = int(par[0].z);
	uint base = uint(par[0].w);
	float th = par[2].w;
	vec4 s = base == 0u ? vec4(0.0) : acc[pi * 2u];
	vec4 s2 = base == 0u ? vec4(0.0) : acc[pi * 2u + 1u];
	for (int k = 0; k < n; k++) {
		rs = hash(pi * 0x9E3779B9u ^ hash(base + uint(k)));
		float u = ((float(px.x) + rnd()) / wh.x * 2.0 - 1.0) * th * par[3].w;
		float v = (1.0 - (float(px.y) + rnd()) / wh.y * 2.0) * th;
		vec3 L = radiance(par[2].xyz, normalize(par[3].xyz * u + par[4].xyz * v + par[5].xyz));
		float y = dot(L, vec3(0.2126, 0.7152, 0.0722));
		bool ok = y >= 0.0 && y < 1e30;
		s += ok ? vec4(L, y) : vec4(0.0);
		s2 += vec4(ok ? y * y : 0.0, 1.0, ok ? 0.0 : 1.0, 0.0);
	}
	acc[pi * 2u] = s;
	acc[pi * 2u + 1u] = s2;
}
