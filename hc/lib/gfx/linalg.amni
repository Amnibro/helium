// linalg: quaternions, rigid transforms and 4x4 matrix helpers for the 3D renderer.
// Matrices are gfx::mat4 (column-major, columns c0..c3); vectors are float3/float4.
namespace linalg;
import gfx;
import math;

struct Quat { x f32, y f32, z f32, w f32 }

fn quat_identity() Quat { Quat { 0.0, 0.0, 0.0, 1.0 } }

fn f(v real) f32 { v as f32 }

fn v3(x f32, y f32, z f32) float3 { float3 { x, y, z } }

fn length3(v float3) f32 { f(sqrt((v.x * v.x + v.y * v.y + v.z * v.z) as real)) }

fn unit3(v float3) float3 {
	let n = length3(v);
	if n <= 0.0 { return v; }
	v3(v.x / n, v.y / n, v.z / n)
}

fn dot3(a float3, b float3) f32 { a.x * b.x + a.y * b.y + a.z * b.z }

fn cross3(a float3, b float3) float3 { v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x) }

fn mix3(a float3, b float3, t f32) float3 { v3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t) }

// Hamilton product: applying the result rotates by b first, then a.
fn qmul(a Quat, b Quat) Quat {
	Quat {
		a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
		a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
		a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
		a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
	}
}

fn qnorm(q Quat) Quat {
	let n = f(sqrt((q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w) as real));
	if n <= 0.0 { return quat_identity(); }
	Quat { q.x / n, q.y / n, q.z / n, q.w / n }
}

fn qaxis(axis float3, angle f32) Quat {
	let a = unit3(axis);
	let s = f(sin((angle * 0.5) as real));
	Quat { a.x * s, a.y * s, a.z * s, f(cos((angle * 0.5) as real)) }
}

// v' = v + 2w(u x v) + 2(u x (u x v)), with u the vector part of q.
fn qrotate(q Quat, v float3) float3 {
	let u = v3(q.x, q.y, q.z);
	let t = cross3(u, v);
	let t2 = v3(t.x * 2.0, t.y * 2.0, t.z * 2.0);
	let c = cross3(u, t2);
	v3(v.x + q.w * t2.x + c.x, v.y + q.w * t2.y + c.y, v.z + q.w * t2.z + c.z)
}

// Spherical interpolation on the shorter arc; falls back to a normalized lerp when nearly parallel.
fn qslerp(a Quat, b0 Quat, t f32) Quat {
	var b = b0;
	var c = a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w;
	if c < 0.0 { b = Quat { -b.x, -b.y, -b.z, -b.w }; c = -c; }
	var ka = 1.0 - t;
	var kb = t;
	if c < 0.9995 {
		let th = atan2(sqrt(1.0 - (c * c) as real), c as real);
		let s = sin(th);
		ka = f(sin(((1.0 - t) as real) * th) / s);
		kb = f(sin((t as real) * th) / s);
	}
	qnorm(Quat { a.x * ka + b.x * kb, a.y * ka + b.y * kb, a.z * ka + b.z * kb, a.w * ka + b.w * kb })
}

fn col(x f32, y f32, z f32, w f32) float4 { float4 { x, y, z, w } }

// Rotation matrix of a unit quaternion.
fn qmatrix(q Quat) gfx::mat4 {
	let xx = q.x * q.x; let yy = q.y * q.y; let zz = q.z * q.z;
	let xy = q.x * q.y; let xz = q.x * q.z; let yz = q.y * q.z;
	let wx = q.w * q.x; let wy = q.w * q.y; let wz = q.w * q.z;
	gfx::mat4 {
		col(1.0 - 2.0 * (yy + zz), 2.0 * (xy + wz), 2.0 * (xz - wy), 0.0),
		col(2.0 * (xy - wz), 1.0 - 2.0 * (xx + zz), 2.0 * (yz + wx), 0.0),
		col(2.0 * (xz + wy), 2.0 * (yz - wx), 1.0 - 2.0 * (xx + yy), 0.0),
		col(0.0, 0.0, 0.0, 1.0)
	}
}

// T * R * S, the glTF node transform order.
fn compose(t float3, r Quat, s float3) gfx::mat4 {
	var m = qmatrix(r);
	m.c0 = col(m.c0.x * s.x, m.c0.y * s.x, m.c0.z * s.x, 0.0);
	m.c1 = col(m.c1.x * s.y, m.c1.y * s.y, m.c1.z * s.y, 0.0);
	m.c2 = col(m.c2.x * s.z, m.c2.y * s.z, m.c2.z * s.z, 0.0);
	m.c3 = col(t.x, t.y, t.z, 1.0);
	m
}

fn flat(m gfx::mat4) f32[16] {
	[m.c0.x, m.c0.y, m.c0.z, m.c0.w, m.c1.x, m.c1.y, m.c1.z, m.c1.w, m.c2.x, m.c2.y, m.c2.z, m.c2.w, m.c3.x, m.c3.y, m.c3.z, m.c3.w]
}

fn unflat(a f32[16]) gfx::mat4 {
	gfx::mat4 { col(a[0], a[1], a[2], a[3]), col(a[4], a[5], a[6], a[7]), col(a[8], a[9], a[10], a[11]), col(a[12], a[13], a[14], a[15]) }
}

fn transpose(m gfx::mat4) gfx::mat4 {
	gfx::mat4 { col(m.c0.x, m.c1.x, m.c2.x, m.c3.x), col(m.c0.y, m.c1.y, m.c2.y, m.c3.y), col(m.c0.z, m.c1.z, m.c2.z, m.c3.z), col(m.c0.w, m.c1.w, m.c2.w, m.c3.w) }
}

// General inverse by the adjugate: the 2x2 minors of the top two and bottom two rows
// (Laplace expansion along row pairs) give every cofactor. Singular input gives identity.
fn inverse(m gfx::mat4) gfx::mat4 {
	let e = flat(transpose(m)); // row-major: e[r * 4 + c]
	fn at(r int, c int) real { e[r * 4 + c] as real }
	let s0 = at(0, 0) * at(1, 1) - at(1, 0) * at(0, 1);
	let s1 = at(0, 0) * at(1, 2) - at(1, 0) * at(0, 2);
	let s2 = at(0, 0) * at(1, 3) - at(1, 0) * at(0, 3);
	let s3 = at(0, 1) * at(1, 2) - at(1, 1) * at(0, 2);
	let s4 = at(0, 1) * at(1, 3) - at(1, 1) * at(0, 3);
	let s5 = at(0, 2) * at(1, 3) - at(1, 2) * at(0, 3);
	let c5 = at(2, 2) * at(3, 3) - at(3, 2) * at(2, 3);
	let c4 = at(2, 1) * at(3, 3) - at(3, 1) * at(2, 3);
	let c3 = at(2, 1) * at(3, 2) - at(3, 1) * at(2, 2);
	let c2 = at(2, 0) * at(3, 3) - at(3, 0) * at(2, 3);
	let c1 = at(2, 0) * at(3, 2) - at(3, 0) * at(2, 2);
	let c0 = at(2, 0) * at(3, 1) - at(3, 0) * at(2, 1);
	let det = s0 * c5 - s1 * c4 + s2 * c3 + s3 * c2 - s4 * c1 + s5 * c0;
	if abs(det) < 1e-30 { return gfx::mat4_identity; }
	let k = 1.0 / det;
	var r f32[16] = [0.0; 16]; // row-major result
	r[0] = f(( at(1, 1) * c5 - at(1, 2) * c4 + at(1, 3) * c3) * k);
	r[1] = f((-at(0, 1) * c5 + at(0, 2) * c4 - at(0, 3) * c3) * k);
	r[2] = f(( at(3, 1) * s5 - at(3, 2) * s4 + at(3, 3) * s3) * k);
	r[3] = f((-at(2, 1) * s5 + at(2, 2) * s4 - at(2, 3) * s3) * k);
	r[4] = f((-at(1, 0) * c5 + at(1, 2) * c2 - at(1, 3) * c1) * k);
	r[5] = f(( at(0, 0) * c5 - at(0, 2) * c2 + at(0, 3) * c1) * k);
	r[6] = f((-at(3, 0) * s5 + at(3, 2) * s2 - at(3, 3) * s1) * k);
	r[7] = f(( at(2, 0) * s5 - at(2, 2) * s2 + at(2, 3) * s1) * k);
	r[8] = f(( at(1, 0) * c4 - at(1, 1) * c2 + at(1, 3) * c0) * k);
	r[9] = f((-at(0, 0) * c4 + at(0, 1) * c2 - at(0, 3) * c0) * k);
	r[10] = f(( at(3, 0) * s4 - at(3, 1) * s2 + at(3, 3) * s0) * k);
	r[11] = f((-at(2, 0) * s4 + at(2, 1) * s2 - at(2, 3) * s0) * k);
	r[12] = f((-at(1, 0) * c3 + at(1, 1) * c1 - at(1, 2) * c0) * k);
	r[13] = f(( at(0, 0) * c3 - at(0, 1) * c1 + at(0, 2) * c0) * k);
	r[14] = f((-at(3, 0) * s3 + at(3, 1) * s1 - at(3, 2) * s0) * k);
	r[15] = f(( at(2, 0) * s3 - at(2, 1) * s1 + at(2, 2) * s0) * k);
	transpose(unflat(r))
}

// Matrix for transforming normals: inverse-transpose of the upper 3x3, no translation.
fn normal_matrix(m gfx::mat4) gfx::mat4 {
	var n = transpose(inverse(m));
	n.c0.w = 0.0; n.c1.w = 0.0; n.c2.w = 0.0;
	n.c3 = col(0.0, 0.0, 0.0, 1.0);
	n
}

fn point(m gfx::mat4, p float3) float3 {
	let r = gfx::mul(m, col(p.x, p.y, p.z, 1.0));
	if r.w != 0.0 && r.w != 1.0 { return v3(r.x / r.w, r.y / r.w, r.z / r.w); }
	v3(r.x, r.y, r.z)
}

fn direction(m gfx::mat4, d float3) float3 {
	let r = gfx::mul(m, col(d.x, d.y, d.z, 0.0));
	v3(r.x, r.y, r.z)
}

fn near_equal(a gfx::mat4, b gfx::mat4, eps f32) bool {
	let x = flat(a);
	let y = flat(b);
	for i in 16 { if abs(x[i] - y[i]) > eps { return false; } }
	true
}
