struct Emitter { pos float3, shape int, size float3, rate f32, dir float3, speed_min f32, speed_max f32, life_min f32, life_max f32, spread f32, gravity f32, drag f32, curl f32, curl_scale f32, collide bool, restitution f32, soft f32, alpha bool, colors float4[4], sizes float4, on bool, stretch f32 = 0.0, wrap bool = false, follow bool = false, splash f32 = 0.0, splash_size f32 = 0.05, splash_rgba float4 = float4 { 1.0, 1.0, 1.0, 1.0 }, on_death int = -1, on_death_n int = 0, on_hit int = -1, on_hit_n int = 0, inherit f32 = 0.0, trail f32 = 0.0, mesh int = -1, spin f32 = 0.0 }
