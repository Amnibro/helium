	bval(0, 1);
	bval(0, 1);
	seg_on = false;
	seg_map = false;
	abs_d = true;
	for i in 4 {
		seg_q[i] = 0;
		seg_f[i] = 0;
		ref_d[i] = 0;
		mode_d[i] = 0;
	}
	for i in 3 { seg_p[i] = 255; }
	if bval(0, 1) == 1 {
		seg_on = true;
		seg_map = bval(0, 1) == 1;
		if bval(0, 1) == 1 {
			abs_d = bval(0, 1) == 1;
			for i in 4 { seg_q[i] = if bval(0, 1) == 1 { bsval(0, 7) } else { 0 }; }
			for i in 4 { seg_f[i] = if bval(0, 1) == 1 { bsval(0, 6) } else { 0 }; }
		}
		if seg_map {
			for i in 3 { seg_p[i] = if bval(0, 1) == 1 { bval(0, 8) } else { 255 }; }
		}
	}
	fl_simple = bval(0, 1) == 1;
	fl_level = bval(0, 6);
	fl_sharp = bval(0, 3);
	fl_deltas = false;
	if bval(0, 1) == 1 {
		fl_deltas = true;
		if bval(0, 1) == 1 {
			for i in 4 { if bval(0, 1) == 1 { ref_d[i] = bsval(0, 6); } }
			for i in 4 { if bval(0, 1) == 1 { mode_d[i] = bsval(0, 6); } }
		}
	}
	ftype = if fl_level == 0 { 0 } else if fl_simple { 1 } else { 2 };
