			q = seg_q[s];
			if !abs_d { q += base; }
		}
		let k = s * 6;
		dq[k] = DCTAB[clampm(q + d[0], 127)];
		dq[k + 1] = ACTAB[clampm(q, 127)];
		dq[k + 2] = DCTAB[clampm(q + d[1], 127)] * 2;
		dq[k + 3] = max((ACTAB[clampm(q + d[2], 127)] * 101581) >> 16, 8);
		dq[k + 4] = DCTAB[clampm(q + d[3], 117)];
		dq[k + 5] = ACTAB[clampm(q + d[4], 127)];
	}
	bval(0, 1);
	for i in 1056 { cprob[i] = if bit(0, COEFU[i]) == 1 { bval(0, 8) } else { COEF0[i] }; }
	skip_on = bval(0, 1) == 1;
	skip_p = 0;
	if skip_on { skip_p = bval(0, 8); }
