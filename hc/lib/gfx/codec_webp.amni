	}
	let isz = le32(at + 4);
	if isz > rs - 12 || isz > n - (at + 8) { return fail("bad image chunk size"); }
	img_at = at + 8;
	img_len = isz;
	lossless = tag_is(at, "VP8L");
	if !lossless {
		if img_len < 10 { return fail("VP8 chunk too short"); }
