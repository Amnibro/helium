var co int[>..];
fn wrap16(v int) int { ((v + 32768) & 65535) - 32768 }
fn large(r int, p int) int {
	if bit(r, cprob[p + 3]) == 0 {
		if bit(r, cprob[p + 4]) == 0 { return 2; }
		return 3 + bit(r, cprob[p + 5]);
	}
	if bit(r, cprob[p + 6]) == 0 {
		if bit(r, cprob[p + 7]) == 0 { return 5 + bit(r, 159); }
		let a = bit(r, 165);
		let b = bit(r, 145);
		return 7 + 2 * a + b;
	}
	let b1 = bit(r, cprob[p + 8]);
	let b0 = bit(r, cprob[p + 9 + b1]);
	let cat = 2 * b1 + b0;
	let st = match cat { 0 => 0, 1 => 3, 2 => 7, _ => 12 };
	let cl = match cat { 0 => 3, 1 => 4, 2 => 5, _ => 11 };
	var v = 0;
	for i in cl { v = v + v + bit(r, CATP[st + i]); }
	v + 3 + (8 << cat)
}
fn coeffs(r int, ty int, ctx int, dqdc int, dqac int, first int, at int) int {
	var n = first;
	var p = (ty * 8 + BANDS[n]) * 33 + ctx * 11;
	while n < 16 {
		if bit(r, cprob[p]) == 0 { return n; }
		while bit(r, cprob[p + 1]) == 0 {
			n += 1;
			p = (ty * 8 + BANDS[n]) * 33;
			if n == 16 { return 16; }
		}
		let nb = (ty * 8 + BANDS[n + 1]) * 33;
		var v = 0;
		if bit(r, cprob[p + 2]) == 0 {
			v = 1;
			p = nb + 11;
		} else {
			v = large(r, p);
			p = nb + 22;
		}
		let s = bsign(r, v) * (if n > 0 { dqac } else { dqdc });
		co[at + ZIGZAG[n]] = wrap16(s);
		n += 1;
	}
	16
}
var nz_top int[>..];
var dnz_top int[>..];
var nz_left int = 0;
var dnz_left int = 0;
var mr_code int[>..];
var mr_has int[>..];
fn setb(v int, i int, f int) int { ((v | (1 << i)) ^ (1 << i)) | (f << i) }
fn codeof(nz int, dc int) int { if nz > 3 { 3 } else if nz > 1 { 2 } else if dc != 0 { 1 } else { 0 } }
fn wht(sc int, base int) {
	var tmp int[16] = [0; 16];
	for i in 4 {
		let a0 = co[sc + i] + co[sc + 12 + i];
		let a1 = co[sc + 4 + i] + co[sc + 8 + i];
		let a2 = co[sc + 4 + i] - co[sc + 8 + i];
		let a3 = co[sc + i] - co[sc + 12 + i];
		tmp[i] = a0 + a1;
		tmp[8 + i] = a0 - a1;
		tmp[4 + i] = a3 + a2;
		tmp[12 + i] = a3 - a2;
	}
	for i in 4 {
		let dc = tmp[4 * i] + 3;
		let a0 = dc + tmp[4 * i + 3];
		let a1 = tmp[4 * i + 1] + tmp[4 * i + 2];
		let a2 = tmp[4 * i + 1] - tmp[4 * i + 2];
		let a3 = dc - tmp[4 * i + 3];
		co[base + 16 * (4 * i)] = (a0 + a1) >> 3;
		co[base + 16 * (4 * i + 1)] = (a3 + a2) >> 3;
		co[base + 16 * (4 * i + 2)] = (a0 - a1) >> 3;
		co[base + 16 * (4 * i + 3)] = (a3 - a2) >> 3;
	}
}
fn resid(mx int, tp int) bool {
	let base = mx * 384;
	for i in 384 { co[base + i] = 0; }
	let cd = mx * 24;
	let i4 = mr_i4[mx];
	if skip_on && mr_skip[mx] != 0 {
		for i in 24 { mr_code[cd + i] = 0; }
		nz_top[mx] = 0;
		nz_left = 0;
		if i4 == 0 {
			dnz_top[mx] = 0;
			dnz_left = 0;
		}
		mr_has[mx] = 0;
		return true;
	}
	let q = mr_seg[mx] * 6;
	var first = 0;
	var ty = 3;
	if i4 == 0 {
		let sc = mb_w * 384;
		for i in 16 { co[sc + i] = 0; }
		let nz = coeffs(tp, 1, dnz_top[mx] + dnz_left, dq[q + 2], dq[q + 3], 0, sc);
		let f = if nz > 0 { 1 } else { 0 };
		dnz_top[mx] = f;
		dnz_left = f;
		if nz > 1 {
			wht(sc, base);
		} else {
			let dc0 = (co[sc] + 3) >> 3;
			for i in 16 { co[base + 16 * i] = dc0; }
		}
		first = 1;
		ty = 0;
	}
	var nzt = nz_top[mx];
	var nzl = nz_left;
	var has = 0;
	for y in 4 {
		var l = (nzl >> y) & 1;
		for x in 4 {
			let b = y * 4 + x;
			let nz = coeffs(tp, ty, l + ((nzt >> x) & 1), dq[q], dq[q + 1], first, base + b * 16);
			l = if nz > first { 1 } else { 0 };
			nzt = setb(nzt, x, l);
			let c = codeof(nz, co[base + b * 16]);
			mr_code[cd + b] = c;
			if c != 0 { has = 1; }
		}
		nzl = setb(nzl, y, l);
	}
	for ch in 2 {
		for y in 2 {
			var l = (nzl >> (4 + 2 * ch + y)) & 1;
			for x in 2 {
				let b = 256 + ch * 64 + (y * 2 + x) * 16;
				let nz = coeffs(tp, 2, l + ((nzt >> (4 + 2 * ch + x)) & 1), dq[q + 4], dq[q + 5], 0, base + b);
				l = if nz > 0 { 1 } else { 0 };
				nzt = setb(nzt, 4 + 2 * ch + x, l);
				let c = codeof(nz, co[base + b]);
				mr_code[cd + 16 + ch * 4 + y * 2 + x] = c;
				if c != 0 { has = 1; }
			}
			nzl = setb(nzl, 4 + 2 * ch + y, l);
		}
	}
	nz_top[mx] = nzt;
	nz_left = nzl;
	mr_has[mx] = has;
	if bd_eof[tp] != 0 { return fail("truncated token data"); }
	true
}
var wk int[832] = [0; 832];
var top_y int[>..];
var top_u int[>..];
var top_v int[>..];
var pl byte[>..];
var ysz int = 0;
var usz int = 0;
fn recon_row(my int) {
	for j in 16 { wk[40 + j * 32 - 1] = 129; }
	for j in 8 {
		wk[584 + j * 32 - 1] = 129;
		wk[600 + j * 32 - 1] = 129;
	}
	if my > 0 {
		wk[7] = 129;
		wk[551] = 129;
		wk[567] = 129;
	} else {
		for i in 21 { wk[7 + i] = 127; }
		for i in 9 {
			wk[551 + i] = 127;
			wk[567 + i] = 127;
		}
	}
	let ys = mb_w * 16;
	let cs = mb_w * 8;
	for mx in mb_w {
		if mx > 0 {
			for j in 17 {
				let jj = j - 1;
				for k in 4 { wk[40 + jj * 32 - 4 + k] = wk[40 + jj * 32 + 12 + k]; }
			}
			for j in 9 {
				let jj = j - 1;
				for k in 4 {
					wk[584 + jj * 32 - 4 + k] = wk[584 + jj * 32 + 4 + k];
					wk[600 + jj * 32 - 4 + k] = wk[600 + jj * 32 + 4 + k];
				}
			}
		}
		if my > 0 {
			for k in 16 { wk[8 + k] = top_y[mx * 16 + k]; }
			for k in 8 {
				wk[552 + k] = top_u[mx * 8 + k];
				wk[568 + k] = top_v[mx * 8 + k];
			}
		}
		let cd = mx * 24;
		let cb = mx * 384;
		if mr_i4[mx] != 0 {
			if my > 0 {
				if mx >= mb_w - 1 {
					for k in 4 { wk[24 + k] = top_y[mx * 16 + 15]; }
				} else {
					for k in 4 { wk[24 + k] = top_y[(mx + 1) * 16 + k]; }
				}
			}
			for r in 3 {
				for k in 4 { wk[24 + 128 * (r + 1) + k] = wk[24 + k]; }
			}
			for n in 16 {
				let o = 40 + 4 * (n & 3) + 128 * (n >> 2);
				pred4(o, mr_sub[mx * 16 + n]);
				dotrans(mr_code[cd + n], cb + 16 * n, o);
			}
		} else {
			pred_big(40, 16, mr_ym[mx], my > 0, mx > 0);
			for n in 16 { dotrans(mr_code[cd + n], cb + 16 * n, 40 + 4 * (n & 3) + 128 * (n >> 2)); }
		}
		pred_big(584, 8, mr_cm[mx], my > 0, mx > 0);
		pred_big(600, 8, mr_cm[mx], my > 0, mx > 0);
		uvtrans(cd + 16, cb + 256, 584);
		uvtrans(cd + 20, cb + 320, 600);
		if my < mb_h - 1 {
			for k in 16 { top_y[mx * 16 + k] = wk[40 + 15 * 32 + k]; }
			for k in 8 {
				top_u[mx * 8 + k] = wk[584 + 7 * 32 + k];
				top_v[mx * 8 + k] = wk[600 + 7 * 32 + k];
			}
		}
		for j in 16 {
			for k in 16 { pl[(my * 16 + j) * ys + mx * 16 + k] = wk[40 + j * 32 + k] as byte; }
		}
		for j in 8 {
			for k in 8 {
				pl[ysz + (my * 8 + j) * cs + mx * 8 + k] = wk[584 + j * 32 + k] as byte;
				pl[ysz + usz + (my * 8 + j) * cs + mx * 8 + k] = wk[600 + j * 32 + k] as byte;
			}
		}
	}
}
fn pred_big(o int, s int, mode int, tp bool, lf bool) {
	if mode == 0 {
		var dc = 128;
		if tp || lf {
			var sum = 0;
			if tp { for i in s { sum += wk[o - 32 + i]; } }
			if lf { for i in s { sum += wk[o - 1 + 32 * i]; } }
			let lg = if s == 16 { 5 } else { 4 };
			dc = if tp && lf { (sum + s) >> lg } else { (sum + (s >> 1)) >> (lg - 1) };
		}
		for j in s {
			for i in s { wk[o + 32 * j + i] = dc; }
		}
	} else if mode == 1 {
		let tl = wk[o - 33];
		for j in s {
			let l = wk[o + 32 * j - 1];
			for i in s { wk[o + 32 * j + i] = clampb(l + wk[o - 32 + i] - tl); }
		}
	} else if mode == 2 {
		for j in s {
			for i in s { wk[o + 32 * j + i] = wk[o - 32 + i]; }
		}
	} else {
		for j in s {
			let l = wk[o + 32 * j - 1];
			for i in s { wk[o + 32 * j + i] = l; }
		}
	}
}
fn nb(o int, n int) int {
	if n < 4 { wk[o - 1 + 32 * n] } else if n == 4 { wk[o - 33] } else { wk[o - 32 + n - 5] }
}
fn pred4(o int, mode int) {
	if mode == 0 {
		var dc = 4;
		for i in 4 { dc += wk[o - 32 + i] + wk[o - 1 + 32 * i]; }
		dc = dc >> 3;
		for j in 4 {
			for i in 4 { wk[o + 32 * j + i] = dc; }
		}
	} else if mode == 1 {
		let tl = wk[o - 33];
		for j in 4 {
			let l = wk[o + 32 * j - 1];
			for i in 4 { wk[o + 32 * j + i] = clampb(l + wk[o - 32 + i] - tl); }
		}
	} else {
		for y in 4 {
			for x in 4 {
				let e = PRED4[(mode - 2) * 16 + x + 4 * y];
				let k = e >> 12;
				let a = nb(o, (e >> 8) & 15);
				var v = a;
				if k == 2 {
					v = (a + nb(o, (e >> 4) & 15) + 1) >> 1;
				} else if k == 3 {
					v = (a + 2 * nb(o, (e >> 4) & 15) + nb(o, e & 15) + 2) >> 2;
				}
				wk[o + 32 * y + x] = v;
			}
		}
	}
}
fn m1(a int) int { ((a * 20091) >> 16) + a }
fn m2(a int) int { (a * 35468) >> 16 }
fn wadd(p int, v int) { wk[p] = clampb(wk[p] + v); }
fn idct(cb int, o int) {
	var tmp int[16] = [0; 16];
	for i in 4 {
		let a = co[cb + i] + co[cb + 8 + i];
		let b = co[cb + i] - co[cb + 8 + i];
		let c = m2(co[cb + 4 + i]) - m1(co[cb + 12 + i]);
		let d = m1(co[cb + 4 + i]) + m2(co[cb + 12 + i]);
		tmp[4 * i] = a + d;
		tmp[4 * i + 1] = b + c;
		tmp[4 * i + 2] = b - c;
		tmp[4 * i + 3] = a - d;
	}
	for i in 4 {
		let dc = tmp[i] + 4;
		let a = dc + tmp[8 + i];
		let b = dc - tmp[8 + i];
		let c = m2(tmp[4 + i]) - m1(tmp[12 + i]);
		let d = m1(tmp[4 + i]) + m2(tmp[12 + i]);
		let p = o + 32 * i;
		wadd(p, (a + d) >> 3);
		wadd(p + 1, (b + c) >> 3);
		wadd(p + 2, (b - c) >> 3);
		wadd(p + 3, (a - d) >> 3);
	}
}
fn dcadd(cb int, o int) {
	let dc = (co[cb] + 4) >> 3;
	for j in 4 {
		for i in 4 { wadd(o + 32 * j + i, dc); }
	}
}
fn dotrans(code int, cb int, o int) {
	if code >= 2 {
		idct(cb, o);
	} else if code == 1 {
		dcadd(cb, o);
	}
}
fn uvtrans(cd int, cb int, o int) {
	var any = 0;
	var big = 0;
	for k in 4 {
		let c = mr_code[cd + k];
		if c != 0 { any = 1; }
		if c >= 2 { big = 1; }
	}
	if any == 0 { return; }
	for k in 4 {
		let po = o + 4 * (k & 1) + 128 * (k >> 1);
		if big == 1 {
			idct(cb + 16 * k, po);
		} else if co[cb + 16 * k] != 0 {
			dcadd(cb + 16 * k, po);
		}
	}
}
var f_seg int[>..];
var f_i4 int[>..];
var f_has int[>..];
var fs_lim int[8] = [0; 8];
var fs_il int[8] = [0; 8];
var fs_hev int[8] = [0; 8];
fn s1(v int) int { if v < -128 { -128 } else if v > 127 { 127 } else { v } }
fn s2(v int) int { if v < -16 { -16 } else if v > 15 { 15 } else { v } }
fn put(o int, v int) { pl[o] = clampb(v) as byte; }
fn two(o int, st int, p1 int, p0 int, q0 int, q1 int) {
	let a = 3 * (q0 - p0) + s1(p1 - q1);
	let a1 = s2((a + 4) >> 3);
	let a2 = s2((a + 3) >> 3);
	put(o - st, p0 + a2);
	put(o, q0 - a1);
}
fn four(o int, st int, p1 int, p0 int, q0 int, q1 int) {
	let a = 3 * (q0 - p0);
	let a1 = s2((a + 4) >> 3);
	let a2 = s2((a + 3) >> 3);
	let a3 = (a1 + 1) >> 1;
	put(o - 2 * st, p1 + a3);
	put(o - st, p0 + a2);
	put(o, q0 - a1);
	put(o + st, q1 - a3);
}
fn six(o int, st int) {
	let p2 int = pl[o - 3 * st];
	let p1 int = pl[o - 2 * st];
	let p0 int = pl[o - st];
	let q0 int = pl[o];
	let q1 int = pl[o + st];
	let q2 int = pl[o + 2 * st];
	let a = s1(3 * (q0 - p0) + s1(p1 - q1));
	let a1 = (27 * a + 63) >> 7;
	let a2 = (18 * a + 63) >> 7;
	let a3 = (9 * a + 63) >> 7;
	put(o - 3 * st, p2 + a3);
	put(o - 2 * st, p1 + a2);
	put(o - st, p0 + a1);
	put(o, q0 - a1);
	put(o + st, q1 - a2);
	put(o + 2 * st, q2 - a3);
}
fn edge(pos int, step int, lstep int, cnt int, thr int, il int, hv int, kind int) {
	let t2 = 2 * thr + 1;
	for i in cnt {
		let o = pos + i * lstep;
		let p1 int = pl[o - 2 * step];
		let p0 int = pl[o - step];
		let q0 int = pl[o];
		let q1 int = pl[o + step];
		if 4 * abs(p0 - q0) + abs(p1 - q1) > t2 { continue; }
		if kind == 0 {
			two(o, step, p1, p0, q0, q1);
			continue;
		}
		let p3 int = pl[o - 4 * step];
		let p2 int = pl[o - 3 * step];
		let q2 int = pl[o + 2 * step];
		let q3 int = pl[o + 3 * step];
		if abs(p3 - p2) > il || abs(p2 - p1) > il || abs(p1 - p0) > il || abs(q3 - q2) > il || abs(q2 - q1) > il || abs(q1 - q0) > il { continue; }
		if abs(p1 - p0) > hv || abs(q1 - q0) > hv {
			two(o, step, p1, p0, q0, q1);
		} else if kind == 1 {
			six(o, step);
		} else {
			four(o, step, p1, p0, q0, q1);
		}
	}
}
fn fprep() {
	for s in 4 {
		for i4 in 2 {
			var lvl = fl_level;
			if seg_on {
				lvl = seg_f[s];
				if !abs_d { lvl += fl_level; }
			}
			if fl_deltas {
				lvl += ref_d[0];
				if i4 == 1 { lvl += mode_d[0]; }
			}
			lvl = clampm(lvl, 63);
			let k = s * 2 + i4;
			if lvl > 0 {
				var il = lvl;
				if fl_sharp > 0 {
					il = if fl_sharp > 4 { il >> 2 } else { il >> 1 };
					if il > 9 - fl_sharp { il = 9 - fl_sharp; }
				}
				if il < 1 { il = 1; }
				fs_il[k] = il;
				fs_lim[k] = 2 * lvl + il;
				fs_hev[k] = if lvl >= 40 { 2 } else if lvl >= 15 { 1 } else { 0 };
			} else {
				fs_lim[k] = 0;
			}
		}
	}
}
fn loop_filter() {
	let ys = mb_w * 16;
	let cs = mb_w * 8;
	for my in mb_h {
		for mx in mb_w {
			let idx = my * mb_w + mx;
			let i4 = f_i4[idx];
			let k = f_seg[idx] * 2 + i4;
			let lim = fs_lim[k];
			if lim == 0 { continue; }
			let il = fs_il[k];
			let hv = fs_hev[k];
			let inner = i4 != 0 || f_has[idx] != 0;
			let yp = my * 16 * ys + mx * 16;
			let up = ysz + my * 8 * cs + mx * 8;
			let vp = up + usz;
			if ftype == 1 {
				if mx > 0 { edge(yp, 1, ys, 16, lim + 4, il, hv, 0); }
				if inner {
					for e in 1..4 { edge(yp + 4 * e, 1, ys, 16, lim, il, hv, 0); }
				}
				if my > 0 { edge(yp, ys, 1, 16, lim + 4, il, hv, 0); }
				if inner {
					for e in 1..4 { edge(yp + 4 * e * ys, ys, 1, 16, lim, il, hv, 0); }
				}
			} else {
				if mx > 0 {
					edge(yp, 1, ys, 16, lim + 4, il, hv, 1);
					edge(up, 1, cs, 8, lim + 4, il, hv, 1);
					edge(vp, 1, cs, 8, lim + 4, il, hv, 1);
				}
				if inner {
					for e in 1..4 { edge(yp + 4 * e, 1, ys, 16, lim, il, hv, 2); }
					edge(up + 4, 1, cs, 8, lim, il, hv, 2);
					edge(vp + 4, 1, cs, 8, lim, il, hv, 2);
				}
				if my > 0 {
					edge(yp, ys, 1, 16, lim + 4, il, hv, 1);
					edge(up, cs, 1, 8, lim + 4, il, hv, 1);
					edge(vp, cs, 1, 8, lim + 4, il, hv, 1);
				}
				if inner {
					for e in 1..4 { edge(yp + 4 * e * ys, ys, 1, 16, lim, il, hv, 2); }
					edge(up + 4 * cs, cs, 1, 8, lim, il, hv, 2);
					edge(vp + 4 * cs, cs, 1, 8, lim, il, hv, 2);
				}
			}
		}
	}
}
var up_u int[>..];
var up_v int[>..];
fn g(i int) int { let v int = pl[i]; v }
fn mh(v int, k int) int { (v * k) >> 8 }
fn clip8c(v int) int { if v >= 0 && v <= 16383 { v >> 6 } else if v < 0 { 0 } else { 255 } }
fn upsample(pb int, nr int, fr int, dst int[>..]&) {
	let cs = mb_w * 8;
	let n = pb + nr * cs;
	let f = pb + fr * cs;
	dst[0] = (3 * g(n) + g(f) + 2) >> 2;
	let last = (width - 1) >> 1;
	for i in 1..(last + 1) {
		let a = g(n + i - 1);
		let b = g(n + i);
		let c = g(f + i - 1);
		let d = g(f + i);
		let s = a + b + c + d + 8;
		dst[2 * i - 1] = (((s + 2 * (b + c)) >> 3) + a) >> 1;
		dst[2 * i] = (((s + 2 * (a + d)) >> 3) + b) >> 1;
	}
	if (width & 1) == 0 { dst[width - 1] = (3 * g(n + last) + g(f + last) + 2) >> 2; }
}
fn to_rgba(px byte[>..]&) {
	px.clear();
	px.resize(width * height * 4, 0);
	up_u.clear();
	up_u.resize(width, 0);
	up_v.clear();
	up_v.resize(width, 0);
	let ch = (height + 1) >> 1;
	let ys = mb_w * 16;
	for r in height {
		var near = r >> 1;
		var far = if (r & 1) == 1 { (r + 1) >> 1 } else { (r >> 1) - 1 };
		if far < 0 { far = 0; }
		if far > ch - 1 { far = ch - 1; }
		if near > ch - 1 { near = ch - 1; }
		upsample(ysz, near, far, up_u);
		upsample(ysz + usz, near, far, up_v);
		for x in width {
			let y = mh(g(r * ys + x), 19077);
			let u = up_u[x];
			let v = up_v[x];
			let o = (r * width + x) * 4;
			px[o] = clip8c(y + mh(v, 26149) - 14234) as byte;
			px[o + 1] = clip8c(y - mh(u, 6419) - mh(v, 13320) + 8708) as byte;
			px[o + 2] = clip8c(y + mh(u, 33050) - 17685) as byte;
			px[o + 3] = 255 as byte;
		}
	}
}
var al int[>..];
fn alpha(px byte[>..]&) bool {
	if alph_at < 0 || alph_len < 2 { return false; }
	let hd = sb(alph_at);
	let method = hd & 3;
	let filter = (hd >> 2) & 3;
	let pre = (hd >> 4) & 3;
	let rsv = hd >> 6;
	if method > 1 || pre > 1 || rsv != 0 { return false; }
	let n = width * height;
	al.clear();
	if method == 0 {
		if alph_len - 1 < n { return false; }
		for i in n { al.push(sb(alph_at + 1 + i)); }
	} else {
		lreset();
		lbegin(alph_at + 1, alph_at + alph_len);
		if !stream(width, height, true, argb) { return false; }
		if argb.len != n { return false; }
		for i in n { al.push((argb[i] >> 8) & 255); }
	}
	for y in height {
		let o = y * width;
		if filter == 0 { continue; }
		if y == 0 || filter == 1 {
			var pred = if y == 0 { 0 } else { al[o - width] };
			for x in width {
				pred = (pred + al[o + x]) & 255;
				al[o + x] = pred;
			}
		} else if filter == 2 {
			for x in width { al[o + x] = (al[o + x] + al[o - width + x]) & 255; }
		} else {
			var left = al[o - width];
			var tl = left;
			for x in width {
				let top = al[o - width + x];
				left = (al[o + x] + clampb(left + top - tl)) & 255;
				tl = top;
				al[o + x] = left;
			}
		}
	}
	for i in n { px[4 * i + 3] = al[i] as byte; }
	true
}
fn rz(a int[>..]&, n int) {
	a.clear();
	a.resize(n, 0);
}
fn vp8(px byte[>..]&) bool {
	if !vp8_head() { return false; }
	rz(mr_seg, mb_w);
	rz(mr_skip, mb_w);
	rz(mr_i4, mb_w);
	rz(mr_ym, mb_w);
	rz(mr_cm, mb_w);
	rz(mr_sub, mb_w * 16);
	rz(top_m, mb_w * 4);
	rz(nz_top, mb_w);
	rz(dnz_top, mb_w);
	rz(mr_code, mb_w * 24);
	rz(mr_has, mb_w);
	rz(co, mb_w * 384 + 16);
	rz(top_y, mb_w * 16);
	rz(top_u, mb_w * 8);
	rz(top_v, mb_w * 8);
	rz(f_seg, mb_w * mb_h);
	rz(f_i4, mb_w * mb_h);
	rz(f_has, mb_w * mb_h);
	ysz = mb_w * 16 * mb_h * 16;
	usz = mb_w * 8 * mb_h * 8;
	pl.clear();
	pl.resize(ysz + 2 * usz, 0);
	for my in mb_h {
		if !modes_row() { return false; }
		nz_left = 0;
		dnz_left = 0;
		let tp = 1 + (my & (nparts - 1));
		for mx in mb_w {
			if !resid(mx, tp) { return false; }
			let idx = my * mb_w + mx;
			f_seg[idx] = mr_seg[mx];
			f_i4[idx] = mr_i4[mx];
			f_has[idx] = mr_has[mx];
		}
		recon_row(my);
	}
	if ftype > 0 {
		fprep();
		loop_filter();
	}
	to_rgba(px);
	if has_alpha && !alpha(px) { return fail("bad alpha"); }
	true
}
fn is_webp(b const byte[:]) bool {
	b.len >= 12 && b[0] == 'R' && b[1] == 'I' && b[2] == 'F' && b[3] == 'F' && b[8] == 'W' && b[9] == 'E' && b[10] == 'B' && b[11] == 'P'
}
fn load(data const byte[:]) {
	src.clear();
	src.append(data);
}
fn size(b const byte[:]) int, int, bool {
	load(b);
	let ok = parse();
	if ok { return width, height, true; }
	return 0, 0, false;
}
fn decode(data const byte[:], px byte[>..]&) int, int, bool {
	px.clear();
	load(data);
	if !parse() { return 0, 0, false; }
	let ok = if lossless { vp8l(px) } else { vp8(px) };
	if !ok {
		px.clear();
		return 0, 0, false;
	}
	return width, height, true;
}
