}
var mr_seg int[>..];
var mr_skip int[>..];
var mr_i4 int[>..];
var mr_ym int[>..];
var mr_cm int[>..];
var mr_sub int[>..];
var top_m int[>..];
var left_m int[4] = [0; 4];
fn tree4(base int) int {
	if bit(0, BMODEP[base]) == 0 { return 0; }
	if bit(0, BMODEP[base + 1]) == 0 { return 1; }
	if bit(0, BMODEP[base + 2]) == 0 { return 2; }
	if bit(0, BMODEP[base + 3]) == 0 {
		if bit(0, BMODEP[base + 4]) == 0 { return 3; }
		return 4 + bit(0, BMODEP[base + 5]);
	}
	if bit(0, BMODEP[base + 6]) == 0 { return 6; }
	if bit(0, BMODEP[base + 7]) == 0 { return 7; }
	8 + bit(0, BMODEP[base + 8])
}
fn modes_row() bool {
	for i in 4 { left_m[i] = 0; }
	for x in mb_w {
		var seg = 0;
		if seg_map { seg = if bit(0, seg_p[0]) == 0 { bit(0, seg_p[1]) } else { 2 + bit(0, seg_p[2]) }; }
		mr_seg[x] = seg;
		mr_skip[x] = if skip_on { bit(0, skip_p) } else { 0 };
		if bit(0, 145) == 0 {
			mr_i4[x] = 1;
			for y in 4 {
				for xx in 4 {
					let m = tree4((top_m[4 * x + xx] * 10 + left_m[y]) * 9);
					top_m[4 * x + xx] = m;
					left_m[y] = m;
					mr_sub[16 * x + xx + 4 * y] = m;
				}
			}
		} else {
			mr_i4[x] = 0;
			var ym = 0;
			if bit(0, 156) == 1 {
				ym = if bit(0, 128) == 1 { 1 } else { 3 };
			} else {
				ym = if bit(0, 163) == 1 { 2 } else { 0 };
			}
			for i in 4 {
				top_m[4 * x + i] = ym;
				left_m[i] = ym;
			}
			mr_ym[x] = ym;
		}
		var cm = 0;
		if bit(0, 142) == 0 {
			cm = 0;
		} else if bit(0, 114) == 0 {
			cm = 2;
		} else {
			cm = if bit(0, 183) == 1 { 1 } else { 3 };
		}
		mr_cm[x] = cm;
	}
