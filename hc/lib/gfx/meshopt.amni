import math;
namespace meshopt;
let MODE_ATTRIBUTES = 0;
let MODE_TRIANGLES = 1;
let MODE_INDICES = 2;
let FILTER_NONE = 0;
let FILTER_OCTAHEDRAL = 1;
let FILTER_QUATERNION = 2;
let FILTER_EXPONENTIAL = 3;
let FILTER_COLOR = 4;
fn mode_of(name const byte[:]) int {
	if name == "ATTRIBUTES" { return 0; }
	if name == "TRIANGLES" { return 1; }
	if name == "INDICES" { return 2; }
	-1
}
fn filter_of(name const byte[:]) int {
	if name.len == 0 || name == "NONE" { return 0; }
	if name == "OCTAHEDRAL" { return 1; }
	if name == "QUATERNION" { return 2; }
	if name == "EXPONENTIAL" { return 3; }
	if name == "COLOR" { return 4; }
	-1
}
fn unzig(v int) int {
	if (v & 1) != 0 { -1 - (v >> 1) } else { v >> 1 }
}
fn read_varint(s const byte[:], pos int) int, int {
	var v = 0;
	var p = pos;
	for i in 5 {
		if p < 0 || p >= s.len { return 0, -1; }
		let b int = s[p];
		p++;
		v += (b & 127) << (7 * i);
		if b < 128 { return v, p; }
	}
	return 0, -1;
}
fn put_index(out byte[>..]&, v int, size int) {
	let x = v & 0xffffffff;
	out.push((x & 255) as! byte);
	out.push(((x >> 8) & 255) as! byte);
	if size != 2 {
		out.push(((x >> 16) & 255) as! byte);
		out.push(((x >> 24) & 255) as! byte);
	}
}
fn attr_run(s const byte[:], count int, stride int, out byte[>..]&) bool {
	if stride < 4 || stride > 256 || stride % 4 != 0 || count < 0 || s.len == 0 { return false; }
	let first int = s[0];
	if first != 0xa0 && first != 0xa1 { return false; }
	let v1 = first == 0xa1;
	let tail = if v1 { stride + stride / 4 } else { stride };
	let minpad = if v1 { 24 } else { 32 };
	let padded = max(tail, minpad);
	if s.len < 1 + padded { return false; }
	let limit = s.len - padded;
	let base = s.len - tail;
	var prev byte[256] = [0; 256];
	var chan byte[64] = [0; 64];
	for i in stride { prev[i] = s[base + i]; }
	if v1 { for j in stride / 4 { chan[j] = s[base + stride + j]; } }
	let maxb = min(256, 8192 / stride / 16 * 16);
	var deltas byte[8192] = [0; 8192];
	var pos = 1;
	var done = 0;
	while done < count {
		let n = min(count - done, maxb);
		if !attr_block(s, pos, limit, v1, stride, n, deltas) { return false; }
		for e in n {
			if !attr_element(prev, deltas, n, e, stride, v1, chan) { return false; }
			out.append(prev[..stride]);
		}
		done += n;
	}
	pos == limit
}
fn attributes(s const byte[:], count int, stride int, out byte[>..]&) bool {
	let start = out.len;
	if attr_run(s, count, stride, out) { return true; }
	out.resize(start, 0);
	false
}
fn attr_width(v1 bool, ctl int, mode int) int {
	if !v1 {
		return match mode { 0 => 0, 1 => 2, 2 => 4, _ => 8 };
	}
	if ctl == 0 {
		return match mode { 0 => 0, 1 => 1, 2 => 2, _ => 4 };
	}
	match mode { 0 => 1, 1 => 2, 2 => 4, _ => 8 }
}
fn attr_block(s const byte[:], pos int&, limit int, v1 bool, stride int, n int, deltas byte[:]) bool {
	let groups = (n + 15) / 16;
	let hdr = (groups + 3) / 4;
	var ctrl_base = 0;
	if v1 {
		let nc = stride / 4;
		if pos + nc > limit { return false; }
		ctrl_base = pos;
		pos += nc;
	}
	for i in stride * n { deltas[i] = 0; }
	for k in stride {
		var ctl = 0;
		if v1 {
			let cb int = s[ctrl_base + k / 4];
			ctl = (cb >> (2 * (k % 4))) & 3;
		}
		if ctl == 2 { continue; }
		if ctl == 3 {
			if pos + n > limit { return false; }
			for e in n { deltas[k * n + e] = s[pos + e]; }
			pos += n;
			continue;
		}
		if pos + hdr > limit { return false; }
		let hp = pos;
		pos += hdr;
		for g in groups {
			let hb int = s[hp + g / 4];
			let mode = (hb >> (2 * (g % 4))) & 3;
			let bits = attr_width(v1, ctl, mode);
			let nbytes = bits * 2;
			if pos + nbytes > limit { return false; }
			let gp = pos;
			pos += nbytes;
			let sent = (1 << bits) - 1;
			for m in 16 {
				var d = 0;
				if bits == 1 {
					let q int = s[gp + m / 8];
					d = (q >> (m % 8)) & 1;
				} else if bits == 2 {
					let q int = s[gp + m / 4];
					d = (q >> (6 - 2 * (m % 4))) & 3;
				} else if bits == 4 {
					let q int = s[gp + m / 2];
					d = if m % 2 == 0 { q >> 4 } else { q & 15 };
				} else if bits == 8 {
					let q int = s[gp + m];
					d = q;
				}
				if bits > 0 && bits < 8 && d == sent {
					if pos >= limit { return false; }
					let q int = s[pos];
					d = q;
					pos++;
				}
				let e = g * 16 + m;
				if e < n { deltas[k * n + e] = d as! byte; }
			}
		}
	}
	true
}
fn attr_element(prev byte[:], deltas const byte[:], n int, e int, stride int, v1 bool, chan const byte[:]) bool {
	for j in stride / 4 {
		let cb int = chan[j];
		let ch = if v1 { cb & 3 } else { 0 };
		let k = 4 * j;
		if ch == 0 {
			for q in 4 {
				let d int = deltas[(k + q) * n + e];
				let p int = prev[k + q];
				prev[k + q] = ((p + unzig(d)) & 255) as! byte;
			}
		} else if ch == 1 {
			for h in 2 {
				let k0 = k + 2 * h;
				let d0 int = deltas[k0 * n + e];
				let d1 int = deltas[(k0 + 1) * n + e];
				let p0 int = prev[k0];
				let p1 int = prev[k0 + 1];
				let nv = ((p0 | (p1 << 8)) + unzig(d0 | (d1 << 8))) & 0xffff;
				prev[k0] = (nv & 255) as! byte;
				prev[k0 + 1] = (nv >> 8) as! byte;
			}
		} else if ch == 2 {
			var d = 0;
			var pv = 0;
			for q in 4 {
				let dq int = deltas[(k + q) * n + e];
				let pq int = prev[k + q];
				d = d | (dq << (8 * q));
				pv = pv | (pq << (8 * q));
			}
			let r = cb >> 4;
			let rot = ((d >> r) | (d << (32 - r))) & 0xffffffff;
			let nv = pv ^ rot;
			for q in 4 { prev[k + q] = ((nv >> (8 * q)) & 255) as! byte; }
		} else {
			return false;
		}
	}
	true
}
fn tri_run(s const byte[:], count int, size int, out byte[>..]&) bool {
	let nt = count / 3;
	let aux_at = s.len - 16;
	var data = 1 + nt;
	var nx = 0;
	var lst = 0;
	var efa int[16] = [0; 16];
	var efb int[16] = [0; 16];
	var vf int[16] = [0; 16];
	var ew = 0;
	var vw = 0;
	var ok = true;
	fn rd() int {
		let v, p = read_varint(s, data);
		if p < 0 || p > aux_at {
			ok = false;
			return 0;
		}
		data = p;
		lst = (lst + unzig(v)) & 0xffffffff;
		lst
	}
	fn pe(a int, b int) {
		efa[ew] = a;
		efb[ew] = b;
		ew = (ew + 1) % 16;
	}
	fn pv(v int) {
		vf[vw] = v;
		vw = (vw + 1) % 16;
	}
	for t in nt {
		let code int = s[1 + t];
		let x = code >> 4;
		let y = code & 15;
		var a = 0;
		var b = 0;
		var c = 0;
		if x < 15 {
			let ei = (ew - 1 - x) % 16;
			a = efa[ei];
			b = efb[ei];
			if y == 0 {
				c = nx;
				nx++;
			} else if y <= 12 {
				c = vf[(vw - 1 - y) % 16];
			} else if y == 13 {
				c = (lst - 1) & 0xffffffff;
				lst = c;
			} else if y == 14 {
				c = (lst + 1) & 0xffffffff;
				lst = c;
			} else {
				c = rd();
				if !ok { return false; }
			}
			if y == 0 || y > 12 { pv(c); }
			pe(c, b);
			pe(a, c);
		} else if y < 14 {
			let aux int = s[aux_at + y];
			let z = aux >> 4;
			let w = aux & 15;
			a = nx;
			nx++;
			if z == 0 {
				b = nx;
				nx++;
			} else {
				b = vf[(vw - z) % 16];
			}
			if w == 0 {
				c = nx;
				nx++;
			} else {
				c = vf[(vw - w) % 16];
			}
			pe(b, a);
			pe(c, b);
			pe(a, c);
			pv(a);
			if z == 0 { pv(b); }
			if w == 0 { pv(c); }
		} else {
			if data >= aux_at { return false; }
			let nb int = s[data];
			data++;
			let z = nb >> 4;
			let w = nb & 15;
			if nb == 0 { nx = 0; }
			if y == 14 {
				a = nx;
				nx++;
			} else {
				a = rd();
				if !ok { return false; }
			}
			if z == 0 {
				b = nx;
				nx++;
			} else if z == 15 {
				b = rd();
				if !ok { return false; }
			} else {
				b = vf[(vw - z) % 16];
			}
			if w == 0 {
				c = nx;
				nx++;
			} else if w == 15 {
				c = rd();
				if !ok { return false; }
			} else {
				c = vf[(vw - w) % 16];
			}
			pe(b, a);
			pe(c, b);
			pe(a, c);
			pv(a);
			if z == 0 || z == 15 { pv(b); }
			if w == 0 || w == 15 { pv(c); }
		}
		put_index(out, a, size);
		put_index(out, b, size);
		put_index(out, c, size);
	}
	data == aux_at
}
fn triangles(s const byte[:], count int, size int, out byte[>..]&) bool {
	if count < 0 || count % 3 != 0 || (size != 2 && size != 4) || s.len < 17 + count / 3 { return false; }
	let f int = s[0];
	if f != 0xe1 { return false; }
	let start = out.len;
	if tri_run(s, count, size, out) { return true; }
	out.resize(start, 0);
	false
}
fn idx_run(s const byte[:], count int, size int, out byte[>..]&) bool {
	let limit = s.len - 4;
	var pos = 1;
	var bases int[2] = [0; 2];
	for i in count {
		let v, p = read_varint(s, pos);
		if p < 0 || p > limit { return false; }
		pos = p;
		let which = v & 1;
		let delta = unzig(v >> 1);
		bases[which] = (bases[which] + delta) & 0xffffffff;
		put_index(out, bases[which], size);
	}
	pos == limit
}
fn indices(s const byte[:], count int, size int, out byte[>..]&) bool {
	if count < 0 || (size != 2 && size != 4) || s.len < 5 { return false; }
	let f int = s[0];
	if f != 0xd1 { return false; }
	let start = out.len;
	if idx_run(s, count, size, out) { return true; }
	out.resize(start, 0);
	false
}
fn s8(v int) int {
	let x = v & 255;
	if x >= 128 { x - 256 } else { x }
}
fn s16(v int) int {
	let x = v & 0xffff;
	if x >= 32768 { x - 65536 } else { x }
}
fn rnd(x real) int {
	floor(x + 0.5) as int
}
fn get_u(buf const byte[:], at int, w int) int {
	let lo int = buf[at];
	if w == 1 { lo } else {
		let hi int = buf[at + 1];
		lo | (hi << 8)
	}
}
fn get_s(buf const byte[:], at int, w int) int {
	let u = get_u(buf, at, w);
	if w == 1 { s8(u) } else { s16(u) }
}
fn put_u(buf byte[:], at int, w int, v int) {
	buf[at] = (v & 255) as! byte;
	if w == 2 { buf[at + 1] = ((v >> 8) & 255) as! byte; }
}
fn octahedral(buf byte[:], start int, count int, stride int) bool {
	if stride != 4 && stride != 8 { return false; }
	if count < 0 || start < 0 || start + count * stride > buf.len { return false; }
	let w = stride / 4;
	let mx = if stride == 4 { 127.0 } else { 32767.0 };
	for i in count {
		let at = start + i * stride;
		let c0 = get_s(buf, at, w);
		let c1 = get_s(buf, at + w, w);
		let one = get_s(buf, at + 2 * w, w);
		if one == 0 { return false; }
		var x real = (c0 as real) / (one as real);
		var y real = (c1 as real) / (one as real);
		let z real = 1.0 - abs(x) - abs(y);
		let t real = max(-z, 0.0);
		x = if x >= 0.0 { x - t } else { x + t };
		y = if y >= 0.0 { y - t } else { y + t };
		let h real = mx / sqrt(x * x + y * y + z * z);
		put_u(buf, at, w, rnd(x * h));
		put_u(buf, at + w, w, rnd(y * h));
		put_u(buf, at + 2 * w, w, rnd(z * h));
	}
	true
}
fn quaternion(buf byte[:], start int, count int, stride int) bool {
	if stride != 8 { return false; }
	if count < 0 || start < 0 || start + count * stride > buf.len { return false; }
	for i in count {
		let at = start + i * stride;
		let c0 = get_s(buf, at, 2);
		let c1 = get_s(buf, at + 2, 2);
		let c2 = get_s(buf, at + 4, 2);
		let w0 = get_s(buf, at + 6, 2);
		let m = w0 & 3;
		let s real = 0.7071067811865476 / ((w0 | 3) as real);
		let x real = (c0 as real) * s;
		let y real = (c1 as real) * s;
		let z real = (c2 as real) * s;
		let w real = sqrt(max(0.0, 1.0 - x * x - y * y - z * z));
		put_u(buf, at + 2 * ((m + 1) % 4), 2, rnd(x * 32767.0));
		put_u(buf, at + 2 * ((m + 2) % 4), 2, rnd(y * 32767.0));
		put_u(buf, at + 2 * ((m + 3) % 4), 2, rnd(z * 32767.0));
		put_u(buf, at + 2 * m, 2, rnd(w * 32767.0));
	}
	true
}
fn exponential(buf byte[:], start int, count int, stride int) bool {
	if stride < 0 || stride % 4 != 0 { return false; }
	if count < 0 || start < 0 || start + count * stride > buf.len { return false; }
	var fl f32[1] = [0.0];
	for g in count * stride / 4 {
		let at = start + 4 * g;
		var v = 0;
		for q in 4 {
			let b int = buf[at + q];
			v = v | (b << (8 * q));
		}
		if v >= 0x80000000 { v -= 0x100000000; }
		let e = v >> 24;
		var m = v & 0xffffff;
		if m >= 0x800000 { m -= 0x1000000; }
		let f real = pow(2.0, e as real) * (m as real);
		fl[0] = f as! f32;
		let bs = bytes_of(fl);
		for q in 4 { buf[at + q] = bs[q]; }
	}
	true
}
fn color(buf byte[:], start int, count int, stride int) bool {
	if stride != 4 && stride != 8 { return false; }
	if count < 0 || start < 0 || start + count * stride > buf.len { return false; }
	let w = stride / 4;
	let mx = if stride == 4 { 255.0 } else { 65535.0 };
	for i in count {
		let at = start + i * stride;
		let y = get_u(buf, at, w);
		let co = get_s(buf, at + w, w);
		let cg = get_s(buf, at + 2 * w, w);
		let a0 = get_u(buf, at + 3 * w, w);
		var b = -1;
		for q in 32 { if (a0 >> q) != 0 { b = q; } }
		let as_ = (1 << (b + 1)) - 1;
		let r = y + co - cg;
		let g = y + cg;
		let bl = y - co - cg;
		let a = ((a0 & (as_ >> 1)) << 1) | (a0 & 1);
		let ss real = if as_ == 0 { 0.0 } else { mx / (as_ as real) };
		put_u(buf, at, w, rnd((r as real) * ss));
		put_u(buf, at + w, w, rnd((g as real) * ss));
		put_u(buf, at + 2 * w, w, rnd((bl as real) * ss));
		put_u(buf, at + 3 * w, w, rnd((a as real) * ss));
	}
	true
}
fn decode(s const byte[:], count int, stride int, mode int, flt int, out byte[>..]&) bool {
	let start = out.len;
	var ok = false;
	if mode == 0 {
		if attributes(s, count, stride, out) {
			ok = match flt {
				0 => true,
				1 => octahedral(out, start, count, stride),
				2 => quaternion(out, start, count, stride),
				3 => exponential(out, start, count, stride),
				4 => color(out, start, count, stride),
				_ => false,
			};
		}
	} else if mode == 1 {
		ok = flt == 0 && triangles(s, count, stride, out);
	} else if mode == 2 {
		ok = flt == 0 && indices(s, count, stride, out);
	}
	if !ok { out.resize(start, 0); }
	ok
}
