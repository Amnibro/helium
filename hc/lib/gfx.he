	if fmt < 0: misuse(str("texture format ", desc.format, " is not one of gfx's formats")); return h
	if kind < 0 || kind > 3: misuse(str("texture kind ", desc.kind, " is not one of TEXTURE_2D, _2D_ARRAY, _3D or _CUBE")); return h
	if w < 1 || ht < 1 || w > 16384 || ht > 16384: misuse(str("a texture of ", w, " x ", ht)); return h
