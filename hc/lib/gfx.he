update_texture(t Texture, rg Region, data const byte[:]) bool: update_texture_region(t, rg, data)
update_texture(t Texture, data const byte[:]) bool: update_texture(t, Region{}, data)
download_texture(o CTReg&, out byte[:], what const byte[:]) bool:
