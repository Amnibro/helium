	if COMP == i { COMP = -1 } s_rmcp(DEV, CMPS[i].p); trem(TCMP, p.id)
release_pipelines():
	for i TPIP.live.len: if TPIP.live[i] { free_pipeline(i) }
	for i TCMP.live.len: if TCMP.live[i] { s_rmcp(DEV, CMPS[i].p) }
	for s SHS: s_rmsh(DEV, s.sh)
	tclear(TPIP, "pipeline"); tclear(TCMP, "compute pipeline"); PIPS.clear(); CMPS.clear(); SHS.clear()
release_resources():
	for i TBUF.live.len: if TBUF.live[i] { s_rmbuf(DEV, BUFS[i].buf) }
	for i TTEX.live.len: if TTEX.live[i] { s_rmtex(DEV, TEXS[i].tex) }
	for i TSMP.live.len: if TSMP.live[i] { s_rmsmp(DEV, SMPS[i]) }
	tclear(TBUF, "buffer"); tclear(TTEX, "texture"); tclear(TSMP, "sampler"); BUFS.clear(); TEXS.clear(); SMPS.clear()
reset_bindings(): for k 3 { SB[k] = 0; TB[k] = 0; BB[k] = 0 } VBB = 0; IXB = false
begin_pass_desc(d const PassDesc&) bool:
	if !need("begin_pass"): return false
	if PASS != 0 || CPASS != 0: return misuse(str("begin_pass inside a ", pname(), " pass: end it first"))
	cts CCol[>..] ~= []; t ~= Tg{0, [0; 4], 0, false, 0}; samples ~= 0; w ~= 0; h ~= 0; mip := d.mip as int; lay := d.layer as int
	for i 4:
		if d.color[i].id == 0: break
		k := tslot(d.color[i])
		if k < 0: return false
		let s .= TEXS[k]
		if s.usage & 2 == 0: return misuse(str("begin_pass: color target ", i, " was not created with COLOR_TARGET"))
		layers := if s.d.kind == 3 { 6 } else { if s.d.kind == 0 { 1 } else { s.d.depth as int } }
		if mip < 0 || mip >= s.d.mips as int || lay < 0 || lay >= layers: return misuse(str("begin_pass: color target ", i, " has no mip ", mip, ", layer ", lay))
		tw := max(s.d.width as int >> mip, 1); th := max(s.d.height as int >> mip, 1)
		if i > 0 && (tw != w || th != h || s.d.samples as int != samples): return misuse("begin_pass: the color targets differ in size or sample count")
		w = tw; h = th; samples = s.d.samples as int
		c ~= CCol{s.tex, mip as u32, lay as u32, d.color_value.x, d.color_value.y, d.color_value.z, d.color_value.w, if d.clear_color { 1 } else { 0 }, 0, 0, 0, 0, d.clear_color, false}
		if d.resolve[i].id != 0:
			rk := tslot(d.resolve[i])
			if rk < 0: return false
			let r .= TEXS[rk]
			if s.d.samples < 2 || r.d.samples != 1 || r.fmt != s.fmt || r.d.width != s.d.width || r.d.height != s.d.height: return misuse(str("begin_pass: resolve target ", i, " must be a single-sample texture of the multisampled target's size and format"))
			c.rtex = r.tex; c.store = 3
		cts.push(c); t.c[i] = s.fmt; t.nc = i + 1
	dt ~= CDep{0, 0.0, 0, 0, 0, 0, false, 0, 0, 0}
	if d.depth.id != 0:
		k := tslot(d.depth)
		if k < 0: return false
		let s .= TEXS[k]
		if s.usage & 4 == 0: return misuse("begin_pass: the depth target was not created with DEPTH_TARGET")
		if t.nc > 0 && (s.d.width as int != w || s.d.height as int != h || s.d.samples as int != samples): return misuse(str("begin_pass: the depth target is ", s.d.width, " x ", s.d.height, " with ", s.d.samples, " sample(s), the color targets ", w, " x ", h, " with ", samples))
		w = s.d.width as int; h = s.d.height as int; samples = s.d.samples as int
		dt = CDep{s.tex, d.depth_value, if d.clear_depth { 1 } else { 0 }, 0, 1, 0, d.clear_depth, 0, 0, 0}; t.hd = true; t.d = s.fmt
	if t.nc == 0 && !t.hd: return misuse("begin_pass with no targets")
	t.sc = nsamp(samples); c := cmd()
	if c == 0: return false
	PASS = s_bpass(c, if cts.len > 0 { ffi::ptr(bytes_of(cts[..])) } else { 0 }, t.nc as u32, if t.hd { pp(dt) } else { 0 })
	if PASS == 0: return sdl_fail("beginning a render pass")
	TG = t; PIPE = -1; reset_bindings(); vp ~= CVP{0.0, 0.0, w as f32, h as f32, 0.0, 1.0}; s_vp(PASS, pp(vp)); r ~= CRect{0, 0, w as i32, h as i32}; s_sc(PASS, pp(r)); true
begin_pass(desc PassDesc) bool: begin_pass_desc(desc)
begin_pass(target Texture, depth Texture, clear float4) bool: d ~= PassDesc{depth: depth, color_value: clear}; d.color[0] = target; begin_pass_desc(d)
begin_screen(clear float4) bool: begin_pass(screen(), screen_depth(), clear)
end_pass():
	if PASS == 0: misuse("end_pass with no render pass begun"); return
	s_epass(PASS); PASS = 0; PIPE = -1
bind(p Pipeline):
	if PASS == 0: misuse("bind_pipeline outside a render pass"); return
	i := tget(TPIP, p.id)
	if i < 0: return
	if (PIPS[i].desc.depth_test || PIPS[i].desc.depth_write) && !TG.hd: misuse("bind_pipeline: the pipeline tests or writes depth, and the pass has no depth target"); return
	gp := pipeline_for(i)
	if gp == 0: return
	s_bgp(PASS, gp); PIPE = i
bind_vertex_buffer(slot int, b Buffer, offset int):
	if PASS == 0: misuse("bind_vertex_buffer outside a render pass"); return
	k := bslot(b)
	if k < 0: return
	s := BUFS[k]
	if slot < 0 || slot > 1 || offset < 0 || offset >= s.size || s.usage & 1 == 0: misuse(str("bind_vertex_buffer: slot ", slot, " (0, or 1 for instances), offset ", offset, ", of a BUFFER_VERTEX buffer")); return
	bb ~= CBB{s.buf, offset as u32}; s_bvb(PASS, slot as u32, pp(bb), 1); VBB |= 1 << slot
bind_vertex_buffer(b Buffer): bind_vertex_buffer(0, b, 0)
bind_index_buffer(b Buffer, index_size int, offset int):
	if PASS == 0: misuse("bind_index_buffer outside a render pass"); return
	k := bslot(b)
	if k < 0: return
	s := BUFS[k]
	if index_size != 2 && index_size != 4 || offset < 0 || offset >= s.size || s.usage & 2 == 0: misuse(str("bind_index_buffer: indices of 2 or 4 bytes, not ", index_size, ", from a BUFFER_INDEX buffer")); return
	bb ~= CBB{s.buf, offset as u32}; s_bib(PASS, pp(bb), if index_size == 2 { 0 } else { 1 }); IXB = true
bind_index_buffer(b Buffer, index_size int): bind_index_buffer(b, index_size, 0)
stage_pass(stage int, slot int, what const byte[:]) bool:
	if stage < 0 || stage > 2: return misuse(str(what, ": stage ", stage, " is not VERTEX, FRAGMENT or COMPUTE"))
	if slot < 0 || slot > 31: return misuse(str(what, ": slot ", slot))
	if (if stage == 2 { CPASS == 0 } else { PASS == 0 }): return misuse(str(what, " for the ", stage_name(stage), " stage outside a ", if stage == 2 { "compute" } else { "render" }, " pass"))
	true
bind_texture(stage int, slot int, t Texture, s Sampler):
	if !stage_pass(stage, slot, "bind_texture"): return
	k := tslot(t); q := tget(TSMP, s.id)
	if k < 0 || q < 0: return
	if TEXS[k].usage & 1 == 0: misuse("bind_texture: the texture was not created SAMPLED"); return
	b ~= CTSB{TEXS[k].tex, SMPS[q]}; p := pp(b)
	if stage == 0 { s_bvs(PASS, slot as u32, p, 1) } else { if stage == 1 { s_bfs(PASS, slot as u32, p, 1) } else { s_bcs(CPASS, slot as u32, p, 1) } }
	SB[stage] |= 1 << slot
bind_storage_texture(stage int, slot int, t Texture):
	if !stage_pass(stage, slot, "bind_storage_texture"): return
	k := tslot(t)
	if k < 0: return
	if TEXS[k].usage & (if stage == 2 { 16 } else { 8 }) == 0: misuse(str("bind_storage_texture: the texture was not created ", if stage == 2 { "COMPUTE_READ" } else { "STORAGE_READ" })); return
	U8S[2] = TEXS[k].tex; p := pu(2)
	if stage == 0 { s_bvst(PASS, slot as u32, p, 1) } else { if stage == 1 { s_bfst(PASS, slot as u32, p, 1) } else { s_bcst(CPASS, slot as u32, p, 1) } }
	TB[stage] |= 1 << slot
bind_storage_buffer(stage int, slot int, b Buffer):
	if !stage_pass(stage, slot, "bind_storage_buffer"): return
	k := bslot(b)
	if k < 0: return
	if BUFS[k].usage & (if stage == 2 { 16 } else { 8 }) == 0: misuse(str("bind_storage_buffer: the buffer was not created ", if stage == 2 { "BUFFER_COMPUTE_READ" } else { "BUFFER_STORAGE" })); return
	U8S[2] = BUFS[k].buf; p := pu(2)
	if stage == 0 { s_bvsb(PASS, slot as u32, p, 1) } else { if stage == 1 { s_bfsb(PASS, slot as u32, p, 1) } else { s_bcsb(CPASS, slot as u32, p, 1) } }
	BB[stage] |= 1 << slot
bound_info(stage int, o Info&) bool:
	if stage == 2: if COMP < 0 { return false } o = CMPS[COMP].info; return true
	if PIPE < 0: return false
	o = SHS[if stage == 0 { PIPS[PIPE].vs } else { PIPS[PIPE].fs }].info; true
push_uniforms(stage int, slot int, data const byte[:]):
	if !need("push_uniforms"): return
	if stage < 0 || stage > 2 || slot < 0 || slot > 3: misuse(str("push_uniforms: stage ", stage, ", slot ", slot, " (0 to 3)")); return
	if data.len <= 0 || data.len > 32768: misuse(str("push_uniforms: ", data.len, " bytes (1 to 32768)")); return
	o ~= default<Info>()
	if bound_info(stage, o) && slot < o.nub && o.usz[slot] != data.len: misuse(str("push_uniforms: the ", stage_name(stage), " shader's uniform block ", slot, " is ", o.usz[slot], " bytes by std140, and ", data.len, " were pushed")); return
	c := cmd()
	if c == 0: return
	p := ffi::ptr(data); n := data.len as u32
	if stage == 0 { s_vu(c, slot as u32, p, n) } else { if stage == 1 { s_fu(c, slot as u32, p, n) } else { s_cu(c, slot as u32, p, n) } }
	UP[stage] |= 1 << slot
uniforms<T>(stage int, slot int, u T): push_uniforms(stage, slot, bytes_of(u))
viewport(x f32, y f32, w f32, h f32):
	if PASS == 0: misuse("viewport outside a render pass"); return
	vp ~= CVP{x, y, w, h, 0.0, 1.0}; s_vp(PASS, pp(vp))
scissor(x int, y int, w int, h int):
	if PASS == 0: misuse("scissor outside a render pass"); return
	r ~= CRect{x as i32, y as i32, w as i32, h as i32}; s_sc(PASS, pp(r))
sr(what const byte[:], stage int, count int, bound int, kind const byte[:], how const byte[:]) bool:
	for slot count: if bound & (1 << slot) == 0 { return misuse(str(what, ": the ", stage_name(stage), " shader reads ", kind, " ", slot, ", which no ", how, " gave it")) }
	true
stage_ready(stage int, o Info&, what const byte[:]) bool: sr(what, stage, o.nsmp, SB[stage], "sampler", "bind_texture") && sr(what, stage, o.nstro, TB[stage], "storage texture", "bind_storage_texture") && sr(what, stage, o.nsbro, BB[stage], "storage buffer", "bind_storage_buffer") && sr(what, stage, o.nub, UP[stage], "uniform block", "push_uniforms")
ready_to_draw(what const byte[:]) bool:
	if PASS == 0: return misuse(str(what, " outside a render pass"))
	if PIPE < 0: return misuse(str(what, " with no pipeline bound"))
	missing := PIPS[PIPE].vmask & ~VBB
	if missing != 0: return misuse(str(what, ": the pipeline reads vertex buffer ", if missing & 1 != 0 { 0 } else { 1 }, ", which is not bound"))
	stage_ready(0, SHS[PIPS[PIPE].vs].info, what) && stage_ready(1, SHS[PIPS[PIPE].fs].info, what)
draw(vertices int, instances int, first_vertex int, first_instance int):
	if !ready_to_draw("draw"): return
	if vertices < 0 || instances < 0 || first_vertex < 0 || first_instance < 0: misuse("draw: a negative count"); return
	s_draw(PASS, vertices as u32, instances as u32, first_vertex as u32, first_instance as u32)
draw(vertices int): draw(vertices, 1, 0, 0)
draw_instanced(vertices int, instances int): draw(vertices, instances, 0, 0)
draw_indexed(indices int, instances int, first_index int, vertex_offset int, first_instance int):
	if !ready_to_draw("draw_indexed"): return
	if !IXB: misuse("draw_indexed with no index buffer bound"); return
	if indices < 0 || instances < 0 || first_index < 0 || first_instance < 0: misuse("draw_indexed: a negative count"); return
	s_drawi(PASS, indices as u32, instances as u32, first_index as u32, vertex_offset as i32, first_instance as u32)
draw_indexed(indices int): draw_indexed(indices, 1, 0, 0, 0)
draw_indexed_instanced(indices int, instances int): draw_indexed(indices, instances, 0, 0, 0)
begin_compute(rwb const Buffer[:], rwt const Texture[:]) bool:
	if !need("begin_compute"): return false
	if PASS != 0 || CPASS != 0: return misuse(str("begin_compute inside a ", pname(), " pass: end it first"))
	if rwb.len > 8 || rwt.len > 8: return misuse("begin_compute: at most 8 read-write buffers and 8 textures")
	bb CSBRW[>..] ~= []; tb CSTRW[>..] ~= []
	for b, i rwb:
		k := bslot(b)
		if k < 0: return false
		if BUFS[k].usage & 32 == 0: return misuse(str("begin_compute: read-write buffer ", i, " was not created BUFFER_COMPUTE_WRITE"))
		bb.push(CSBRW{BUFS[k].buf, false})
	for t, i rwt:
		k := tslot(t)
		if k < 0: return false
		if TEXS[k].usage & 96 == 0: return misuse(str("begin_compute: read-write texture ", i, " was not created COMPUTE_WRITE or COMPUTE_READ_WRITE"))
		tb.push(CSTRW{TEXS[k].tex, 0, 0, false})
	c := cmd()
	if c == 0: return false
	CPASS = s_bcomp(c, if tb.len > 0 { ffi::ptr(bytes_of(tb[..])) } else { 0 }, tb.len as u32, if bb.len > 0 { ffi::ptr(bytes_of(bb[..])) } else { 0 }, bb.len as u32)
	if CPASS == 0: return sdl_fail("beginning a compute pass")
	COMP = -1; CRB = rwb.len; CRT = rwt.len; SB[2] = 0; TB[2] = 0; BB[2] = 0; true
begin_compute(rwb const Buffer[:]) bool: none Texture[>..] ~= []; begin_compute(rwb, none[..])
end_compute():
	if CPASS == 0: misuse("end_compute with no compute pass begun"); return
	s_ecomp(CPASS); CPASS = 0; COMP = -1
bind(p ComputePipeline):
	if CPASS == 0: misuse("bind_compute_pipeline outside a compute pass"); return
	i := tget(TCMP, p.id)
	if i < 0: return
	o := CMPS[i].info
	if o.nsbrw != CRB || o.nstrw != CRT: misuse(str("bind_compute_pipeline: the shader writes ", o.nsbrw, " buffer(s) and ", o.nstrw, " texture(s), and begin_compute was given ", CRB, " and ", CRT)); return
	s_bcp(CPASS, CMPS[i].p); COMP = i
dispatch(x int, y int, z int):
	if CPASS == 0: misuse("dispatch outside a compute pass"); return
	if COMP < 0: misuse("dispatch with no compute pipeline bound"); return
	if x < 0 || y < 0 || z < 0: misuse("dispatch: a negative group count"); return
	if !stage_ready(2, CMPS[COMP].info, "dispatch"): return
	s_disp(CPASS, x as u32, y as u32, z as u32)
row(m mat4, i int) float4:
	if i == 0: return float4{m.c0.x, m.c1.x, m.c2.x, m.c3.x}
	if i == 1: return float4{m.c0.y, m.c1.y, m.c2.y, m.c3.y}
	if i == 2: return float4{m.c0.z, m.c1.z, m.c2.z, m.c3.z}
	float4{m.c0.w, m.c1.w, m.c2.w, m.c3.w}
mul(m mat4, v float4) float4: float4{dot(row(m, 0), v), dot(row(m, 1), v), dot(row(m, 2), v), dot(row(m, 3), v)}
mul(a mat4, b mat4) mat4: mat4{mul(a, b.c0), mul(a, b.c1), mul(a, b.c2), mul(a, b.c3)}
translate(t float3) mat4: m ~= mat4_identity; m.c3 = float4{t.x, t.y, t.z, 1.0}; m
scale(s float3) mat4: mat4{float4{s.x, 0.0, 0.0, 0.0}, float4{0.0, s.y, 0.0, 0.0}, float4{0.0, 0.0, s.z, 0.0}, float4{0.0, 0.0, 0.0, 1.0}}
rotate(axis float3, angle f32) mat4:
	a := normalize(axis); c := cos(angle); s := sin(angle); k := 1.0 - c
	mat4{float4{c + a.x * a.x * k, a.y * a.x * k + a.z * s, a.z * a.x * k - a.y * s, 0.0}, float4{a.x * a.y * k - a.z * s, c + a.y * a.y * k, a.z * a.y * k + a.x * s, 0.0}, float4{a.x * a.z * k + a.y * s, a.y * a.z * k - a.x * s, c + a.z * a.z * k, 0.0}, float4{0.0, 0.0, 0.0, 1.0}}
perspective(fovy f32, aspect f32, near f32, far f32) mat4: f := 1.0 / tan(fovy * 0.5); mat4{float4{f / aspect, 0.0, 0.0, 0.0}, float4{0.0, f, 0.0, 0.0}, float4{0.0, 0.0, far / (near - far), -1.0}, float4{0.0, 0.0, near * far / (near - far), 0.0}}
ortho(left f32, right f32, bottom f32, top f32, near f32, far f32) mat4: mat4{float4{2.0 / (right - left), 0.0, 0.0, 0.0}, float4{0.0, 2.0 / (top - bottom), 0.0, 0.0}, float4{0.0, 0.0, 1.0 / (near - far), 0.0}, float4{(left + right) / (left - right), (top + bottom) / (bottom - top), near / (near - far), 1.0}}
look_at(eye float3, target float3, up float3) mat4:
	f := normalize(target - eye); s := normalize(cross(f, up)); u := cross(s, f)
	mat4{float4{s.x, u.x, -f.x, 0.0}, float4{s.y, u.y, -f.y, 0.0}, float4{s.z, u.z, -f.z, 0.0}, float4{-dot(s, eye), -dot(u, eye), dot(f, eye), 1.0}}
elem_size<T>(xs T[>..]&) int: one := default<T>(); bytes_of(one).len
append_as<T>(raw const byte[:], out T[>..]&):
	image byte[>..] ~= []; n ~= raw.len as uint
	while true: low := (n & 127) as byte; n >>= 7; if n == 0 { image.push(low); break } image.push(low | 128)
	image.append(raw); elems, ok := from_bytes<T[>..]>(image[..]); assert(ok); out.append(elems[..])
