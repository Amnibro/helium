teq(a Tg&, b Tg&) bool: a.nc == b.nc && a.c[0] == b.c[0] && a.c[1] == b.c[1] && a.c[2] == b.c[2] && a.c[3] == b.c[3] && a.d == b.d && a.hd == b.hd && a.sc == b.sc
