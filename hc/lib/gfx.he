texture2d(width int, height int, format i32, usage i32) Texture: texture(TextureDesc{format: format, usage: usage, width: width as i32, height: height as i32})
texture2d(width int, height int) Texture: texture2d(width, height, 1, 1)
render_target(width int, height int, format i32) Texture: texture2d(width, height, format, 3)
depth_target(width int, height int) Texture: texture2d(width, height, 20, 5)
texture3d(width int, height int, depth int, format i32, usage i32) Texture: texture(TextureDesc{kind: 2, format: format, usage: usage, width: width as i32, height: height as i32, depth: depth as i32})
texture_cube(size int, format i32, usage i32) Texture: texture(TextureDesc{kind: 3, format: format, usage: usage, width: size as i32, height: size as i32})
texture_array(width int, height int, layers int, format i32, usage i32) Texture: texture(TextureDesc{kind: 1, format: format, usage: usage, width: width as i32, height: height as i32, depth: layers as i32})
region(s TexS&, r const Region&, o CTReg&, what const byte[:]) bool:
