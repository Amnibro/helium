// Pointer, keyboard, undo, IME hooks, and animation ticks.
namespace uikit;
import text;
import uikit.core;
import uikit.widgets;
import uikit.paint;

let KEY_LEFT = 0xF001; let KEY_RIGHT = 0xF002; let KEY_UP = 0xF003; let KEY_DOWN = 0xF004;
let KEY_ENTER = 0xF005; let KEY_BACK = 0xF006; let KEY_TAB = 0xF007; let KEY_ESC = 0xF008;

var UNDO_N int[>..] = [];
var UNDO_S byte[>..][>..] = [];
var UNDO_C int[>..] = [];
var IME byte[>..] = [];
var IME_ON = 0;

fn input_reset() { UNDO_N.clear(); UNDO_S.clear(); UNDO_C.clear(); IME.clear(); IME_ON = 0; }

fn snapshot(id int) {
	UNDO_N.push(id);
	UNDO_S.push([]);
	UNDO_S[UNDO_S.len - 1].append(s_text(N[id].str_i));
	UNDO_C.push(N[id].i1);
}

fn undo(id int) bool {
	var i = UNDO_N.len - 1;
	while i >= 0 {
		if UNDO_N[i] == id {
			s_set(N[id].str_i, UNDO_S[i][..]);
			N[id].i1 = UNDO_C[i];
			return true;
		}
		i -= 1;
	}
	false
}

fn field_insert(id int, s const byte[:]) {
	if N[id].str_i < 0 { set_text(id, ""); }
	snapshot(id);
	STR[N[id].str_i].append(s);
	N[id].i1 = text::grapheme_count(s_text(N[id].str_i));
}

fn activate(id int, x f32, y f32) {
	if id < 0 || N[id].flags & FL_OFF != 0 { return; }
	focus_set(id);
	let k = N[id].kind;
	if k == K_BUTTON || k == K_ICON || k == K_FAB || k == K_SEG || k == K_CHIP { N[id].i3 += 1; }
	else if k == K_TOGGLE || k == K_CHECK { if N[id].flags & FL_ON != 0 { set_on(id, 0); } else { set_on(id, 1); } }
	else if k == K_RADIO {
		for i in N.len { if N[i].kind == K_RADIO && N[i].i2 == N[id].i2 { set_on(i, 0); } }
		set_on(id, 1);
	} else if k == K_SLIDER {
		let t = (x - N[id].x) / N[id].w;
		let v = if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t };
		N[id].val = v;
	} else if k == K_RANGE {
		let t = (x - N[id].x) / N[id].w;
		if t < (N[id].val + N[id].val2) * 0.5 { N[id].val = if t < 0.0 { 0.0 } else { t }; }
		else { N[id].val2 = if t > 1.0 { 1.0 } else { t }; }
	} else if k == K_STEP {
		if x < N[id].x + N[id].w * 0.5 { N[id].val -= 1.0; } else { N[id].val += 1.0; }
	} else if k == K_SELECT || k == K_ACC || k == K_TREE || k == K_POP || k == K_CONTEXT {
		if N[id].flags & FL_OPEN != 0 { set_open(id, 0); } else { set_open(id, 1); }
	} else if k == K_TABS { N[id].i0 += 1; }
	else if k == K_PAGE {
		if x < N[id].x + 24.0 { if N[id].i0 > 0 { N[id].i0 -= 1; } }
		else if x > N[id].x + N[id].w - 24.0 { if N[id].i0 + 1 < N[id].i1 { N[id].i0 += 1; } }
	} 	else if k == K_VLIST {
		let rh = if N[id].val2 < 1.0 { 28.0 } else { N[id].val2 };
		N[id].i1 = y_of(y, id, rh);
	}
}

fn y_of(x f32, id int, rh f32) int {
	let row = ((x - N[id].y) / rh) as int + (N[id].val / rh) as int;
	if row < 0 { 0 } else if row >= N[id].i0 { N[id].i0 - 1 } else { row }
}

fn pointer(x f32, y f32, down int) {
	let id = hit(x, y);
	if down == 0 {
		for i in N.len { N[i].flags = bit_off(N[i].flags, FL_PRESS); }
		return;
	}
	if id >= 0 {
		N[id].flags = N[id].flags | FL_PRESS;
		if N[id].kind == K_BUTTON || N[id].kind == K_FAB || N[id].kind == K_ICON { ripple_at(id, x, y); }
		activate(id, x, y);
	}
}

fn key(code int, mods int) {
	if code == KEY_TAB { if mods & 1 != 0 { focus_prev(); } else { focus_next(); } return; }
	if FOCUS < 0 { return; }
	let id = FOCUS;
	let k = N[id].kind;
	if (k == K_FIELD || k == K_AREA || k == K_COMBO) && code == KEY_BACK {
		let s = s_text(N[id].str_i);
		if s.len == 0 { return; }
		snapshot(id);
		var n = s.len - 1;
		while n > 0 && (s[n] & 0xC0) as int == 0x80 { n -= 1; }
		STR[N[id].str_i].resize(n, 0);
		return;
	}
	if code == KEY_ENTER && (k == K_BUTTON || k == K_TOGGLE || k == K_CHECK) { activate(id, N[id].x + 1.0, N[id].y + 1.0); }
	if code == KEY_LEFT && (k == K_SLIDER || k == K_TABS) { N[id].val = if N[id].val > 0.05 { N[id].val - 0.05 } else { 0.0 }; if k == K_TABS && N[id].i0 > 0 { N[id].i0 -= 1; } }
	if code == KEY_RIGHT && k == K_SLIDER { N[id].val = if N[id].val < 0.95 { N[id].val + 0.05 } else { 1.0 }; }
	if (mods & 2) != 0 && (code == 122 || code == 90) { undo(id); }
}

fn type_text(s const byte[:]) {
	if FOCUS < 0 { return; }
	let k = N[FOCUS].kind;
	if k == K_FIELD || k == K_AREA || k == K_COMBO { field_insert(FOCUS, s); }
}

fn ime_set(s const byte[:]) { IME.clear(); IME.append(s); IME_ON = 1; }
fn ime_commit() {
	if IME_ON != 0 && FOCUS >= 0 { field_insert(FOCUS, IME[..]); }
	IME.clear();
	IME_ON = 0;
}

fn spring_step(x f32, v f32&, target f32, dt f32) f32 {
	let accel = (target - x) * 90.0 - v * 14.0;
	v += accel * dt;
	x + v * dt
}

fn tick(dt f32) {
	SPIN += dt;
	ripple_tick(dt);
	for i in N.len {
		if N[i].kind == K_DIALOGUE {
			let n = text::grapheme_count(s_text(N[i].str_i));
			if N[i].i0 < n { N[i].i0 += 1; }
		} else if N[i].kind == K_DAMAGE {
			N[i].val -= dt;
			N[i].y -= 12.0 * dt;
			if N[i].val <= 0.0 { N[i].vis = 0; }
		} else if N[i].kind == K_TOAST {
			N[i].val -= dt;
			if N[i].val <= 0.0 { N[i].vis = 0; }
		}
	}
}
