// Extra painters: HUD kits, charts, color, and the 100-effect text styles.
namespace uikit;

fn sin_milli(deg int) int {
	var d = deg;
	while d < 0 { d += 360; }
	while d >= 360 { d -= 360; }
	var sign = 1;
	if d >= 180 { sign = -1; d -= 180; }
	let num = 4 * d * (180 - d);
	let den = 40500 - d * (180 - d);
	if den == 0 { return 0; }
	sign * num * 1000 / den
}
fn cos_milli(deg int) int { sin_milli(deg + 90) }

fn atan2_deg(y int, x int) int {
	if x == 0 && y == 0 { return 0; }
	let ax = if x < 0 { -x } else { x };
	let ay = if y < 0 { -y } else { y };
	var deg = 0;
	if ax >= ay && ax > 0 { deg = ay * 45 / ax; }
	else if ay > 0 { deg = 90 - ax * 45 / ay; }
	if x >= 0 && y >= 0 { return deg; }
	if x < 0 && y >= 0 { return 180 - deg; }
	if x < 0 && y < 0 { return 180 + deg; }
	if deg == 0 { return 0; }
	360 - deg
}

fn hsv(h int, s f32, v f32) u32 {
	let c = v * s;
	let hf = h as f32 / 60.0;
	var hp = hf;
	while hp >= 2.0 { hp = hp - 2.0; }
	var d = hp - 1.0;
	if d < 0.0 { d = 0.0 - d; }
	let x = c * (1.0 - d);
	let m = v - c;
	var r f32 = 0.0;
	var g f32 = 0.0;
	var b f32 = 0.0;
	let seg = (h / 60) % 6;
	let seg6 = if seg < 0 { seg + 6 } else { seg };
	if seg6 == 0 { r = c; g = x; }
	else if seg6 == 1 { r = x; g = c; }
	else if seg6 == 2 { g = c; b = x; }
	else if seg6 == 3 { g = x; b = c; }
	else if seg6 == 4 { r = x; b = c; }
	else { r = c; b = x; }
	var ri = ((r + m) * 255.0) as int;
	var gi = ((g + m) * 255.0) as int;
	var bi = ((b + m) * 255.0) as int;
	if ri < 0 { ri = 0; } if ri > 255 { ri = 255; }
	if gi < 0 { gi = 0; } if gi > 255 { gi = 255; }
	if bi < 0 { bi = 0; } if bi > 255 { bi = 255; }
	((ri << 16) | (gi << 8) | bi) as u32
}

fn blit_ring(rgb u32, rad int, alpha int) {
	for k in 16 {
		let dx = cos_milli(k * 22) * rad / 1000;
		let dy = sin_milli(k * 22) * rad / 1000;
		blit_run(rgb, dx, dy, alpha);
	}
}

fn blit_shadow(rgb u32) {
	blit_run(rgb, 1, 1, 80);
	blit_run(rgb, 2, 2, 60);
	blit_run(rgb, 3, 4, 40);
	blit_run(rgb, 5, 6, 24);
	blit_run(rgb, 7, 9, 14);
}

fn blit_gradient(top u32, bot u32) {
	for i in GI.len {
		let id = GI[i];
		let x0 = GX[i] as int + C_X[id];
		let y0 = GY[i] as int + C_Y[id];
		let gh = if C_H[id] < 1 { 1 } else { C_H[id] };
		for py in C_H[id] {
			let col = lerp_rgb(top, bot, py as f32 / gh as f32);
			for px in C_W[id] {
				let a = alpha(id, px, py);
				if a > 0 { put(x0 + px, y0 + py, col, a); }
			}
		}
	}
}

fn fx_pair(slot int) u32, u32 {
	if slot == 0 { return 0xFDE047, 0xC2410C; }
	if slot == 1 { return 0xFEF08A, 0xE11D48; }
	if slot == 2 { return 0xE0F2FE, 0x1D4ED8; }
	if slot == 3 { return 0xFDE68A, 0x6D28D9; }
	if slot == 4 { return 0xBBF7D0, 0x047857; }
	if slot == 5 { return 0xF5D0FE, 0x6B21A8; }
	if slot == 6 { return 0xF8FAFC, 0x1E293B; }
	if slot == 7 { return 0xFBCFE8, 0x7C3AED; }
	if slot == 8 { return 0xFDBA74, 0x9F1239; }
	return 0x111111, 0xF8FAFC;
}

fn fx_draw(i int, x int, y int, text const byte[:], size f32, rgb u32) {
	let g = if i < 0 { 0 } else { i / 10 };
	let slot = if i < 0 { 0 } else { i % 10 };
	var limit = -1;
	if i == 6 { limit = 3; }
	TRACK = if i == 7 { size * 0.14 } else { 0.0 };
	let n = place_run(text, x as f32, y as f32, size, false, i == 1 || g == 5 && slot == 3, false, limit);
	TRACK = 0.0;
	if n < 1 { return; }
	if g == 8 {
		for k in n { GY[k] = GY[k] + ((k % 3) - 1) as f32 * 2.0; }
	}
	if i == 93 && n > 2 { GY[1] = GY[1] - 3.0; }
	if g == 1 {
		let ink = if slot == 2 { 0xE11D48 } else if slot == 3 { 0xCA8A04 } else if slot == 8 { 0xF8FAFC } else if slot == 9 { 0x111111 } else { 0x111111 };
		let rad = if slot == 0 || slot == 6 { 1 } else if slot == 1 || slot == 7 { 3 } else { 2 };
		blit_ring(ink as u32, rad, 255);
		if slot == 5 { blit_ring(0xF8FAFC, rad + 1, 255); }
	}
	if i == 3 {
		blit_run(0x111111, 2, 3, 90);
		blit_run(0x111111, 4, 5, 40);
	}
	if g == 2 {
		let dx = if slot == 1 || slot == 2 { 6 } else if slot == 3 { 5 } else { 2 };
		let dy = if slot == 4 { 1 } else if slot == 1 { 0 } else { dx };
		let col = if slot == 5 { 0x2563EB } else if slot == 6 { 0xC2410C } else if slot == 7 { 0x0369A1 } else { 0x111111 };
		let a = if slot == 1 || slot == 8 { 255 } else { 140 };
		blit_run(col as u32, dx, dy, a);
		if slot == 8 { blit_run(0x111111, dx + 3, dy + 2, 100); }
	}
	if i == 4 || g == 3 {
		let glow = if slot == 0 { 0x22D3EE } else if slot == 1 { 0xE879F9 } else if slot == 2 { 0xFACC15 } else if slot == 3 { 0xF43F5E } else if slot == 6 { 0xF97316 } else if slot == 8 { 0x38BDF8 } else { 0xF8FAFC };
		blit_ring(glow as u32, 3, 160);
		blit_ring(0x111111, 1, 180);
	}
	if g == 6 && slot != 3 && slot != 8 {
		let glow = if slot == 0 || slot == 6 { 0xF97316 } else if slot == 1 { 0x38BDF8 } else if slot == 2 || slot == 4 { 0xA3E635 } else if slot == 5 { 0xFDE047 } else if slot == 7 { 0x818CF8 } else { 0xE11D48 };
		blit_ring(glow as u32, 3, 150);
	}
	if g == 7 {
		blit_run(0x22D3EE, -1, 0, 200);
		blit_run(0xE879F9, 1, 0, 200);
	}
	if i == 52 { blit_run(0xF8FAFC, 1, 1, 230); blit_run(0x111111, -2, -2, 230); }
	else if i == 51 { blit_run(0xF8FAFC, -2, -2, 240); blit_run(0x111111, 3, 3, 220); }
	else if i == 50 { blit_run(0xF8FAFC, -1, -1, 230); blit_run(0x111111, 1, 1, 200); }
	else if i == 57 { blit_run(0x111111, -1, -1, 200); }
	else if i == 58 { blit_run(0xF8FAFC, 0, 2, 230); }
	if g == 4 || i == 5 || (g == 6 && slot != 6 && slot != 8) || i == 94 || i == 95 || i == 97 {
		let top, bot = fx_pair(if g == 4 { slot } else if i == 94 || i == 97 { 0 } else if i == 95 { 4 } else if i == 53 { 6 } else { slot });
		if g == 4 || i == 99 || i == 94 || i == 95 || i == 97 { blit_ring(0x111111, 1, 255); }
		blit_gradient(top, bot);
	} else if i == 54 {
		blit_gradient(0xE2E8F0, 0x334155);
		blit_run(0xF8FAFC, 0, -2, 180);
	} else if i == 59 {
		blit_ring(0x111111, 2, 255);
		blit_ring(0xF8FAFC, 1, 255);
	} else if g == 8 || i == 99 {
		for k in n {
			let col = hsv((k * 48 + slot * 18) % 360, 0.9, 0.95);
			let id = GI[k];
			let x0 = GX[k] as int + C_X[id];
			let y0 = GY[k] as int + C_Y[id];
			for py in C_H[id] { for px in C_W[id] { let a = alpha(id, px, py); if a > 0 { put(x0 + px, y0 + py, col, a); } } }
		}
		blit_ring(0x111111, 1, 200);
	} else if i == 56 {
		blit_ring(0xF8FAFC, 1, 255);
		blit_run(0xBFDBFE, 0, 0, 140);
	} else if i == 96 {
		blit_ring(0x111111, 2, 255);
		blit_run(0xF8FAFC, 0, 0, 255);
		blit_run(0xE11D48, 3, 3, 160);
	} else if i != 59 {
		let fill = if i == 52 { 0x334155 } else if i == 51 { 0xF8FAFC } else if i == 68 { 0x7F1D1D } else if g == 6 && slot == 8 { 0xFDE047 } else { rgb };
		blit_run(fill, 0, 0, 255);
	}
	if i == 8 { fill_rect(x, y + size as int - 2, (n * 8), 2, 0x111111, 255); }
	if i == 9 { fill_rect(x, y + (size as int) / 2, n * 8, 2, 0xE11D48, 255); }
}

fn text_pop(x int, y int, text const byte[:], size f32, fill u32, stroke u32, lift f32) {
	let yy = y - (lift * 6.0) as int;
	let n = place_run(text, x as f32, yy as f32 + size * 0.8, size, false, true, false, -1);
	if n < 1 { return; }
	blit_ring(stroke, 2, 255);
	blit_shadow(0x000000);
	blit_gradient(0xFFFFFF, fill);
}

fn paint_minimap(x int, y int, w int, h int, seed int) {
	let cx = x + w / 2;
	let cy = y + h / 2;
	var r = w / 2 - 3;
	if h / 2 - 3 < r { r = h / 2 - 3; }
	if r < 8 { return; }
	let fog = r * 7 / 10;
	for py in y..y + h {
		for px in x..x + w {
			let dx = px - cx;
			let dy = py - cy;
			let d2 = dx * dx + dy * dy;
			if d2 > r * r { continue; }
			var col = 0x1B4332;
			let n = (px * 13 + py * 7 + seed * 17) & 31;
			if n < 8 { col = 0x2D6A4F; }
			if n > 26 { col = 0x95D5B2; }
			if (px + seed) % 19 < 3 && (py % 13) < 5 { col = 0x1D4E89; }
			if (px * 5 + py + seed) % 29 == 0 { col = 0x6B4F3A; }
			put(px, py, col as u32, 255);
			if d2 > fog * fog { put(px, py, 0x000000, 150); }
			if d2 > (r - 2) * (r - 2) { put(px, py, 0xF4F6FB, 220); }
		}
	}
	let dirs = [0, 90, 180, 270];
	for i in 4 {
		let ox = cos_milli(dirs[i]) * (r - 8) / 1000;
		let oy = sin_milli(dirs[i]) * (r - 8) / 1000;
		let lab = if i == 0 { "E" } else if i == 1 { "N" } else if i == 2 { "W" } else { "S" };
		draw_text(cx + ox - 4, cy - oy - 8, lab, 10.0, 0xF4F6FB, 0, -1);
	}
	ih_mark(cx - 10, cy - 18, 0xF2E35A);
	ih_mark(cx + r / 3, cy - r / 4, 0xFF5A5A);
	ih_mark(cx - r / 3, cy + r / 5, 0x7CFFB2);
	fill_tri(cx, cy - 8, cx - 5, cy + 6, cx + 5, cy + 6, 0xFFFFFF);
}

fn ih_mark(x int, y int, rgb u32) {
	fill_tri(x, y - 4, x - 4, y + 3, x + 4, y + 3, rgb);
}

fn fill_tri(ax int, ay int, bx int, by int, cx int, cy int, rgb u32) {
	var minx = ax; if bx < minx { minx = bx; } if cx < minx { minx = cx; }
	var maxx = ax; if bx > maxx { maxx = bx; } if cx > maxx { maxx = cx; }
	var miny = ay; if by < miny { miny = by; } if cy < miny { miny = cy; }
	var maxy = ay; if by > maxy { maxy = by; } if cy > maxy { maxy = cy; }
	for py in miny..maxy + 1 {
		for px in minx..maxx + 1 {
			let c1 = (bx - ax) * (py - ay) - (by - ay) * (px - ax);
			let c2 = (cx - bx) * (py - by) - (cy - by) * (px - bx);
			let c3 = (ax - cx) * (py - cy) - (ay - cy) * (px - cx);
			if (c1 >= 0 && c2 >= 0 && c3 >= 0) || (c1 <= 0 && c2 <= 0 && c3 <= 0) { put(px, py, rgb, 255); }
		}
	}
}

fn in_sector(dx int, dy int, i int, n int) bool {
	if n < 1 { return false; }
	let a0 = i * 360 / n;
	let a1 = (i + 1) * 360 / n;
	let c0 = cos_milli(a0);
	let s0 = sin_milli(a0);
	let c1 = cos_milli(a1);
	let s1 = sin_milli(a1);
	let cr0 = c0 * dy - s0 * dx;
	let cr1 = c1 * dy - s1 * dx;
	cr0 >= 0 && cr1 <= 0
}

fn paint_radial(x int, y int, w int, h int, count int, selected int, seed int) {
	let cx = x + w / 2;
	let cy = y + h / 2;
	var r = w / 2 - 2;
	if h / 2 - 2 < r { r = h / 2 - 2; }
	if r < 12 { return; }
	let n = if count < 3 { 6 } else if count > 8 { 8 } else { count };
	let inner = r / 3;
	for py in cy - r..cy + r {
		for px in cx - r..cx + r {
			let dx = px - cx;
			let dy = cy - py;
			let d2 = dx * dx + dy * dy;
			if d2 > r * r || d2 < inner * inner { continue; }
			var seg = 0;
			var found = 0;
			for i in n { if in_sector(dx, dy, i, n) { seg = i; found = 1; } }
			if found == 0 { continue; }
			var col = if seg == selected { THEME.accent } else if seg % 2 == 0 { THEME.surface2 } else { THEME.surface };
			put(px, py, col, 255);
			if d2 > (r - 2) * (r - 2) || d2 < (inner + 2) * (inner + 2) { put(px, py, THEME.ink, 180); }
		}
	}
	for i in n {
		let mid = i * 360 / n + 180 / n;
		let ox = cos_milli(mid) * (r * 2 / 3) / 1000;
		let oy = sin_milli(mid) * (r * 2 / 3) / 1000;
		icon_draw((seed + i) % 20, cx + ox - 8, cy - oy - 8, 16, THEME.ink);
	}
}

fn rarity_col(i int) u32 {
	if i % 5 == 0 { return 0x9AA0A6; }
	if i % 5 == 1 { return 0x3DDC97; }
	if i % 5 == 2 { return 0x3B82F6; }
	if i % 5 == 3 { return 0xA855F7; }
	0xEAB308
}

fn paint_inventory(x int, y int, w int, h int, cols int, rows int, seed int) {
	let c = if cols < 1 { 3 } else { cols };
	let r = if rows < 1 { 2 } else { rows };
	let cw = (w - 8) / c;
	let rh = (h - 8) / r;
	for yy in r {
		for xx in c {
			let x0 = x + 4 + xx * cw;
			let y0 = y + 4 + yy * rh;
			let rare = rarity_col(seed + xx + yy * 3);
			fill_rect(x0 + 2, y0 + 2, cw - 4, rh - 4, 0x12141A, 255);
			stroke_rect(x0 + 2, y0 + 2, cw - 4, rh - 4, rare, 2);
			let empty = (xx + yy + seed) % 5 == 0;
			if !empty {
				let isz = if cw < rh { cw - 8 } else { rh - 8 };
				if isz > 4 {
					let ix = x0 + (cw - isz) / 2;
					let iy = y0 + (rh - isz) / 2;
					icon_draw((seed * 3 + xx * 5 + yy * 7) % 500, ix, iy, isz, 0xF4F6FB);
				}
				let stack = (xx + yy * 2 + seed) % 6 + 1;
				if stack > 1 {
					TMP.clear();
					format(TMP, stack);
					draw_text(x0 + cw - 16, y0 + rh - 14, TMP[..], 10.0, 0xFFFFFF, 0, -1);
				}
			}
		}
	}
}

fn paint_quest(x int, y int, w int, h int, seed int) {
	draw_text(x + 6, y + 2, "Quests", 12.0, THEME.ink, 0, -1);
	let a = if seed % 3 == 0 { "Find the gate" } else if seed % 3 == 1 { "Escort Mira" } else { "Light the beacon" };
	let b = if seed % 2 == 0 { "Collect 3" } else { "Clear the camp" };
	draw_text(x + 6, y + 18, a, 11.0, THEME.muted, 0, -1);
	draw_text(x + 6, y + 34, b, 11.0, THEME.ok, 0, -1);
}

fn paint_boss(x int, y int, w int, h int, name const byte[:], v f32) {
	draw_text(x + 4, y + 1, name, 11.0, THEME.ink, 0, -1);
	let by = y + h - 8;
	fill_rect(x + 4, by, w - 8, 6, 0x2A1214, 255);
	var fw = ((w - 8) as f32 * v) as int;
	if fw < 0 { fw = 0; }
	if fw > w - 8 { fw = w - 8; }
	fill_rect(x + 4, by, fw, 6, 0xE23B3B, 255);
	fill_rect(x + 4, by, fw, 2, 0xFFB4A8, 180);
}

fn paint_buffs(x int, y int, w int, h int, seed int) {
	let n = 4;
	let cw = if w / n < 8 { 8 } else { w / n };
	for i in n {
		let x0 = x + 4 + i * cw;
		round_rect(x0, y + 4, cw - 8, h - 8, 4, THEME.surface2, 255);
		icon_draw((seed + i * 3) % 20, x0 + 2, y + 6, h - 12, THEME.accent);
	}
}

fn paint_cooldowns(x int, y int, w int, h int, seed int) {
	let n = 5;
	let cw = w / n;
	var r = h / 2 - 4;
	if cw / 2 - 2 < r { r = cw / 2 - 2; }
	if r < 6 { return; }
	for i in n {
		let cx = x + cw * i + cw / 2;
		let cy = y + h / 2;
		let ready = (seed + i) % 5;
		for py in cy - r..cy + r {
			for px in cx - r..cx + r {
				let dx = px - cx;
				let dy = cy - py;
				let d2 = dx * dx + dy * dy;
				if d2 > r * r { continue; }
				put(px, py, THEME.surface2, 255);
				let ang = atan2_deg(dy, dx);
				let sweep = ready * 60;
				if ang > 90 && ang < 90 + sweep { put(px, py, 0x000000, 140); }
				if d2 > (r - 2) * (r - 2) { put(px, py, THEME.accent, 255); }
			}
		}
		icon_draw((seed + i) % 20, cx - r / 2, cy - r / 2, r, THEME.ink);
	}
}

fn paint_chart(x int, y int, w int, h int, kind int) {
	let k = if kind < 0 { 0 } else { kind % 7 };
	if k == 0 || k == 5 {
		var px0 = x + 8;
		var py0 = y + h - 16;
		let vals = [4, 8, 6, 12, 9, 14, 11];
		for i in 6 {
			let x1 = x + 8 + (i + 1) * (w - 16) / 6;
			let y1 = y + h - 12 - vals[i + 1] * (h - 20) / 16;
			let y0 = y + h - 12 - vals[i] * (h - 20) / 16;
			stroke_line(px0, y0, x1, y1, THEME.accent);
			px0 = x1;
		}
	} else if k == 1 {
		let vals = [8, 14, 6, 11, 9];
		let bw = (w - 16) / 5;
		for i in 5 {
			let bh = vals[i] * (h - 16) / 16;
			fill_rect(x + 8 + i * bw, y + h - 8 - bh, bw - 4, bh, THEME.accent, 255);
		}
	} else if k == 2 {
		let cx = x + w / 2;
		let cy = y + h / 2;
		var r = h / 2 - 6;
		if w / 4 < r { r = w / 4; }
		for py in cy - r..cy + r {
			for px in cx - r..cx + r {
				let dx = px - cx;
				let dy = cy - py;
				if dx * dx + dy * dy > r * r { continue; }
				let ang = atan2_deg(dy, dx);
				let col = if ang < 140 { THEME.accent } else if ang < 230 { THEME.ok } else { THEME.warn };
				put(px, py, col, 255);
			}
		}
	} else if k == 3 {
		let cx = x + w / 2;
		let cy = y + h / 2;
		var r = h / 2 - 8;
		for i in 5 {
			let ang = i * 72 - 90;
			let ox = cos_milli(ang) * r / 1000;
			let oy = sin_milli(ang) * r / 1000;
			stroke_line(cx, cy, cx + ox, cy - oy, THEME.border);
		}
		stroke_line(cx, cy - r / 2, cx + r / 3, cy - r / 5, THEME.accent);
		stroke_line(cx + r / 3, cy - r / 5, cx + r / 5, cy + r / 3, THEME.accent);
		stroke_line(cx + r / 5, cy + r / 3, cx - r / 3, cy + r / 6, THEME.accent);
		stroke_line(cx - r / 3, cy + r / 6, cx - r / 4, cy - r / 3, THEME.accent);
		stroke_line(cx - r / 4, cy - r / 3, cx, cy - r / 2, THEME.accent);
	} else if k == 4 {
		let cx = x + w / 2;
		let cy = y + h - 8;
		var r = h - 16;
		if w / 2 - 4 < r { r = w / 2 - 4; }
		for py in cy - r..cy {
			for px in cx - r..cx + r {
				let dx = px - cx;
				let dy = cy - py;
				let d2 = dx * dx + dy * dy;
				if d2 > r * r || dy < 0 { continue; }
				put(px, py, THEME.surface2, 255);
				let ang = atan2_deg(dy, dx);
				if ang < 140 { put(px, py, THEME.accent, 255); }
			}
		}
	} else {
		for row in 4 {
			for col in 8 {
				let heat = (row * 3 + col * 5) % 10;
				let colr = lerp_rgb(0x102030, THEME.accent, heat as f32 / 10.0);
				fill_rect(x + 6 + col * (w - 12) / 8, y + 6 + row * (h - 12) / 4, (w - 12) / 8 - 2, (h - 12) / 4 - 2, colr, 255);
			}
		}
	}
}

fn stroke_line(x0 int, y0 int, x1 int, y1 int, rgb u32) {
	var dx = x1 - x0; if dx < 0 { dx = -dx; }
	var dy = y1 - y0; if dy < 0 { dy = -dy; }
	let n = if dx > dy { dx } else { dy };
	if n < 1 { put(x0, y0, rgb, 255); return; }
	for i in n + 1 {
		let x = x0 + (x1 - x0) * i / n;
		let y = y0 + (y1 - y0) * i / n;
		put(x, y, rgb, 255);
	}
}

fn paint_picker(x int, y int, w int, h int, hue int, s f32, v f32) {
	let side = if h - 8 < w / 2 { h - 8 } else { w / 2 };
	if side < 8 { return; }
	for py in side {
		for px in side {
			let ss = px as f32 / side as f32;
			let vv = 1.0 - py as f32 / side as f32;
			put(x + 4 + px, y + 4 + py, hsv(hue, ss, vv), 255);
		}
	}
	let mx = x + 4 + (s * side as f32) as int;
	let my = y + 4 + ((1.0 - v) * side as f32) as int;
	stroke_rect(mx - 3, my - 3, 6, 6, 0xFFFFFF, 1);
	let rx = x + side + 14;
	let ry = y + 4 + side / 2;
	let rr = side / 2;
	for py in ry - rr..ry + rr {
		for px in rx..rx + rr {
			let dx = px - rx;
			let dy = ry - py;
			let d2 = dx * dx + dy * dy;
			if d2 > rr * rr || d2 < (rr - 10) * (rr - 10) { continue; }
			let ang = atan2_deg(dy, dx);
			put(px, py, hsv(ang, 1.0, 1.0), 255);
		}
	}
}
