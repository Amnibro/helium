}

fn paint_curve(x int, y int, w int, amp int, thick int, phase int, rgb u32) {
	var i = 0;
	while i < w {
		let ang = phase + i * 360 / w;
		let yy = y + sin_milli(ang) * amp / 1000;
		fill_rect(x + i, yy, 3, thick, rgb, 255);
		i += 2;
	}
}

fn paint_park(cx int, cy int, rgb u32) {
	fill_ell(cx, cy, 70, 46, rgb, 255);
	fill_ell(cx - 36, cy + 18, 48, 34, rgb, 255);
	fill_ell(cx + 40, cy - 10, 36, 28, rgb, 255);
	fill_ell(cx + 8, cy + 28, 30, 22, rgb, 255);
}

fn paint_streets(x int, y int, w int, h int) {
	var paper = 0xE4E0D4;
	var road = 0xF7F4EC;
	var major = 0xE7C56A;
	var park = 0xB7D39A;
	var water = 0x8FB8D4;
	var wall = 0xD5CBBA;
	var roof = 0xC4B49A;
	var name = 0x2C332C;
	if chan_luma(THEME.ink as int) > 150 {
		paper = 0x171C22;
		road = 0x2A313C;
		major = 0x6A5A32;
		park = 0x1C3326;
		water = 0x1A3044;
		wall = 0x2A3038;
		roof = 0x3A4450;
		name = 0xD5D8DE;
	}
	fill_rect(x, y, w, h, paper as u32, 255);
	fill_rect(x, y + h * 3 / 5, w / 3, h * 2 / 5, water as u32, 255);
	fill_ell(x + w / 6, y + h * 3 / 5, w / 5, h / 8, water as u32, 255);
	fill_rect(x, y + h * 3 / 5, w / 3, 6, 0xFFFFFF, 80);
	paint_park(x + w * 3 / 4, y + h / 6, park as u32);
	map_block(x, y, w, h, 8, 6, 16, 12, wall as u32, roof as u32);
	map_block(x, y, w, h, 28, 8, 14, 16, wall as u32, 0xB08968);
	map_block(x, y, w, h, 48, 10, 18, 11, wall as u32, roof as u32);
	map_block(x, y, w, h, 70, 28, 12, 14, wall as u32, 0xA89880);
	map_block(x, y, w, h, 40, 36, 20, 14, wall as u32, roof as u32);
	map_block(x, y, w, h, 66, 48, 16, 18, wall as u32, 0xC47A62);
	map_block(x, y, w, h, 8, 40, 18, 12, wall as u32, roof as u32);
	map_block(x, y, w, h, 46, 62, 14, 12, wall as u32, roof as u32);
	map_block(x, y, w, h, 68, 72, 18, 14, wall as u32, 0xB08968);
	map_road(x, y, w, h, 0, 24, 100, 22, 14, major as u32, road as u32);
	map_road(x, y, w, h, 0, 58, 100, 64, 12, major as u32, road as u32);
	map_road(x, y, w, h, 22, 0, 26, 100, 8, road as u32, 0xC8BEA8);
	map_road(x, y, w, h, 46, 0, 42, 100, 7, road as u32, 0xC8BEA8);
	map_road(x, y, w, h, 78, 0, 74, 100, 9, road as u32, 0xC8BEA8);
	map_road(x, y, w, h, 8, 86, 62, 34, 5, 0xE23B3B, 0xE23B3B);
	draw_text(x + 16, y + 12, "Harbor", 16.0, name as u32, 0, -1);
	draw_text(x + w / 2, y + h / 3, "Oak", 16.0, name as u32, 0, -1);
	draw_text(x + w / 5, y + h * 2 / 3, "Mill", 16.0, name as u32, 0, -1);
	draw_text(x + w * 3 / 4, y + h / 8, "Park", 16.0, name as u32, 0, -1);
	paint_pin(x + w * 2 / 3, y + h / 3);
}

fn paint_pin(cx int, cy int) {
	fill_tri(cx - 8, cy - 2, cx + 8, cy - 2, cx, cy + 16, 0xE23B3B);
	fill_ell(cx, cy - 6, 10, 10, 0xE23B3B, 255);
	fill_ell(cx, cy - 6, 4, 4, 0xFFFFFF, 255);
}

fn paint_minimap(x int, y int, w int, h int, seed int) {
	if w < 16 || h < 16 { return; }
	if seed == 38 { paint_streets(x, y, w, h); return; }
	var base = 0x1B3328;
	if seed == 1 { base = 0x0E2430; }
	else if seed == 2 { base = 0x121A16; }
	else if seed == 5 || seed == 11 || seed == 15 { base = 0x100C10; }
	else if seed == 7 || seed == 8 { base = 0x161412; }
	else if seed == 14 { base = 0x1A1C18; }
	else if seed == 16 { base = 0x070814; }
	else if seed == 19 || seed == 23 { base = 0x120814; }
	else if seed == 20 || seed == 21 { base = 0x14121A; }
	else if seed == 22 { base = 0x161410; }
	fill_rect(x, y, w, h, base as u32, 255);
	map_lay(seed, x, y, w, h);
	var py = y + 2;
	while py < y + h {
		var px = x + 2;
		while px < x + w {
			if noise(px + seed * 13, py) > 230 { put(px, py, 0xFFFFFF, 32); }
			px += 4;
		}
		py += 4;
	}
	let cx = map_at(x, w, 46);
	let cy = map_at(y, h, 56);
	let m = if w > 400 { 8 } else { 4 };
	fill_tri(cx, cy - m, cx - m, cy + m, cx + m, cy + m, 0xFFFFFF);
	ih_mark(map_at(x, w, 70), map_at(y, h, 32), 0xFF5A5A);
	ih_mark(map_at(x, w, 24), map_at(y, h, 72), 0x7CFFB2);
}

fn ih_mark(x int, y int, rgb u32) {
	fill_tri(x, y - 4, x - 4, y + 3, x + 4, y + 3, rgb);
}

fn fill_tri(ax int, ay int, bx int, by int, cx int, cy int, rgb u32) {
	var minx = ax; if bx < minx { minx = bx; } if cx < minx { minx = cx; }
	var maxx = ax; if bx > maxx { maxx = bx; } if cx > maxx { maxx = cx; }
	var miny = ay; if by < miny { miny = by; } if cy < miny { miny = cy; }
	var maxy = ay; if by > maxy { maxy = by; } if cy > maxy { maxy = cy; }
	for py in miny..maxy + 1 {
		for px in minx..maxx + 1 {
			let c1 = (bx - ax) * (py - ay) - (by - ay) * (px - ax);
			let c2 = (cx - bx) * (py - by) - (cy - by) * (px - bx);
			let c3 = (ax - cx) * (py - cy) - (ay - cy) * (px - cx);
			if (c1 >= 0 && c2 >= 0 && c3 >= 0) || (c1 <= 0 && c2 <= 0 && c3 <= 0) { put(px, py, rgb, 255); }
		}
	}
}

fn in_sector(dx int, dy int, i int, n int) bool {
	if n < 1 { return false; }
	let a0 = i * 360 / n;
	let a1 = (i + 1) * 360 / n;
	let c0 = cos_milli(a0);
	let s0 = sin_milli(a0);
	let c1 = cos_milli(a1);
	let s1 = sin_milli(a1);
	let cr0 = c0 * dy - s0 * dx;
	let cr1 = c1 * dy - s1 * dx;
	cr0 >= 0 && cr1 <= 0
}

fn paint_radial(x int, y int, w int, h int, count int, selected int, seed int) {
	let cx = x + w / 2;
	let cy = y + h / 2;
	var r = w / 2 - 2;
	if h / 2 - 2 < r { r = h / 2 - 2; }
	if r < 12 { return; }
	let n = if count < 3 { 6 } else if count > 8 { 8 } else { count };
	let inner = r / 3;
	for py in cy - r..cy + r {
		for px in cx - r..cx + r {
			let dx = px - cx;
			let dy = cy - py;
			let d2 = dx * dx + dy * dy;
			if d2 > r * r || d2 < inner * inner { continue; }
			var seg = 0;
			var found = 0;
			for i in n { if in_sector(dx, dy, i, n) { seg = i; found = 1; } }
			if found == 0 { continue; }
			var col = if seg == selected { THEME.accent } else if seg % 2 == 0 { THEME.surface2 } else { THEME.surface };
			put(px, py, col, 255);
			if d2 > (r - 2) * (r - 2) || d2 < (inner + 2) * (inner + 2) { put(px, py, THEME.ink, 180); }
		}
	}
	for i in n {
		let mid = i * 360 / n + 180 / n;
		let ox = cos_milli(mid) * (r * 2 / 3) / 1000;
		let oy = sin_milli(mid) * (r * 2 / 3) / 1000;
		icon_draw(slot_icon(seed + i), cx + ox - 8, cy - oy - 8, 16, THEME.ink);
	}
}

fn rarity_col(i int) u32 {
	if i % 5 == 0 { return 0x9AA0A6; }
	if i % 5 == 1 { return 0x3DDC97; }
	if i % 5 == 2 { return 0x3B82F6; }
	if i % 5 == 3 { return 0xA855F7; }
	0xEAB308
}

fn paint_inventory(x int, y int, w int, h int, cols int, rows int, seed int) {
	let c = if cols < 1 { 3 } else { cols };
	let r = if rows < 1 { 2 } else { rows };
	let cw = (w - 8) / c;
	let rh = (h - 8) / r;
	for yy in r {
		for xx in c {
			let x0 = x + 4 + xx * cw;
			let y0 = y + 4 + yy * rh;
			let rare = rarity_col(seed + xx + yy * 3);
			fill_rect(x0 + 2, y0 + 2, cw - 4, rh - 4, 0x12141A, 255);
			stroke_rect(x0 + 2, y0 + 2, cw - 4, rh - 4, rare, 2);
			let empty = (xx + yy + seed) % 5 == 0;
			if !empty {
				let isz = if cw < rh { cw - 8 } else { rh - 8 };
				if isz > 4 {
					let ix = x0 + (cw - isz) / 2;
					let iy = y0 + (rh - isz) / 2;
					icon_draw(slot_icon(seed + xx + yy * 3), ix, iy, isz, 0xF4F6FB);
				}
				let stack = (xx + yy * 2 + seed) % 6 + 1;
				if stack > 1 {
					TMP.clear();
					format(TMP, stack);
					draw_text(x0 + cw - 16, y0 + rh - 14, TMP[..], 10.0, 0xFFFFFF, 0, -1);
				}
			}
		}
	}
}

fn slot_icon(i int) int {
	let k = if i < 0 { 0 } else { i % 8 };
	if k == 0 { return 0; }
	if k == 1 { return 4; }
	if k == 2 { return 1; }
	if k == 3 { return 16; }
	if k == 4 { return 8; }
	if k == 5 { return 43; }
	if k == 6 { return 5; }
	15
}

fn paint_quest(x int, y int, w int, h int, seed int) {
	fill_rect(x, y, w, h, THEME.surface, 255);
	draw_text(x + 8, y + 6, "Quests", 16.0, THEME.ink, 0, -1);
	let a = if seed % 3 == 0 { "Find the gate" } else if seed % 3 == 1 { "Escort Mira" } else { "Light the beacon" };
	let b = if seed % 2 == 0 { "Collect 3" } else { "Clear the camp" };
	draw_text(x + 8, y + 28, a, 15.0, THEME.ink, 0, -1);
	draw_text(x + 8, y + 50, b, 15.0, THEME.ink, 0, -1);
}

fn paint_boss(x int, y int, w int, h int, name const byte[:], v f32) {
	if h <= 24 && name.len > 0 { draw_text(x + 4, y + 1, name, 11.0, THEME.ink, 0, -1); }
	let by = y + h - 8;
	fill_rect(x + 4, by, w - 8, 6, 0x2A1214, 255);
	var fw = ((w - 8) as f32 * v) as int;
	if fw < 0 { fw = 0; }
	if fw > w - 8 { fw = w - 8; }
	var trail = v + HIT_GAP;
	if trail > 1.0 { trail = 1.0; }
	var tw = ((w - 8) as f32 * trail) as int;
	if tw > w - 8 { tw = w - 8; }
	let chip = if HIT_A > 180 { 0xFFE7A8 } else if HIT_A > 120 { 0xE07040 } else { 0x8A4030 };
	if tw > fw + 3 {
		fill_rect(x + 6 + fw, by, tw - fw - 2, 6, chip as u32, HIT_A);
		fill_rect(x + 4 + fw, by, 2, 6, 0x140C0A, 230);
		fill_rect(x + 4 + fw, by, 2, 2, 0xFFFFFF, HIT_A);
	}
	fill_rect(x + 4, by, fw, 6, 0xE23B3B, 255);
	fill_rect(x + 4, by, fw, 2, 0xFFB4A8, 180);
	var tick = 24;
	while tick < w - 8 { fill_rect(x + 4 + tick, by, 1, 6, 0x000000, 120); tick += 24; }
}

fn paint_buffs(x int, y int, w int, h int, seed int) {
	let n = 4;
	let cw = if w / n < 8 { 8 } else { w / n };
	for i in n {
		let x0 = x + 4 + i * cw;
		round_rect(x0, y + 4, cw - 8, h - 8, 4, THEME.surface2, 255);
		icon_draw(slot_icon(seed + i), x0 + 2, y + 6, h - 12, THEME.ink);
	}
}

fn paint_cooldowns(x int, y int, w int, h int, seed int) {
	let n = 5;
	let cw = w / n;
	var r = h / 2 - 4;
	if cw / 2 - 2 < r { r = cw / 2 - 2; }
	if r < 6 { return; }
	for i in n {
		let cx = x + cw * i + cw / 2;
		let cy = y + h / 2;
		let ready = (seed + i) % 5;
		for py in cy - r..cy + r {
			for px in cx - r..cx + r {
				let dx = px - cx;
				let dy = cy - py;
				let d2 = dx * dx + dy * dy;
				if d2 > r * r { continue; }
				put(px, py, THEME.surface2, 255);
				let ang = atan2_deg(dy, dx);
				let sweep = ready * 60;
				if ang > 90 && ang < 90 + sweep { put(px, py, 0x000000, 140); }
				if d2 > (r - 2) * (r - 2) { put(px, py, THEME.accent, 255); }
			}
		}
		icon_draw(slot_icon(seed + i), cx - r / 2, cy - r / 2, r, THEME.ink);
	}
}

fn day_lab(i int) const byte[:] {
	if i == 0 { return "Mon"; }
	if i == 1 { return "Tue"; }
	if i == 2 { return "Wed"; }
	if i == 3 { return "Thu"; }
	if i == 4 { return "Fri"; }
	if i == 5 { return "Sat"; }
	"Sun"
}

fn chart_y(base int, ph int, v int) int { base - v * ph / 16 }

fn chart_grid(x int, y int, w int, h int, spark int) int, int, int, int {
	var left = 8;
	var bot = 8;
	var top = 8;
	var right = 8;
	if spark == 0 && w >= 160 && h >= 120 {
		left = 44;
		bot = 28;
		top = 12;
		right = 12;
	}
	let px = x + left;
	let py = y + top;
	let pw = if w > left + right { w - left - right } else { 4 };
	let ph = if h > top + bot { h - top - bot } else { 4 };
	let base = py + ph;
	if spark == 0 && left > 8 {
		var g = 0;
		while g <= 4 {
			let gy = chart_y(base, ph, g * 4);
			fill_rect(px, gy, pw, 1, THEME.border, 180);
			TMP.clear();
			format(TMP, g * 4);
			draw_text(x + 4, gy - 8, TMP[..], 16.0, THEME.muted, 0, -1);
			g += 1;
		}
		var i = 0;
		while i < 7 {
			draw_text(px + i * pw / 7, base + 6, day_lab(i), 16.0, THEME.muted, 0, -1);
			i += 1;
		}
	}
	return px, py, pw, ph;
}

fn chart_series(px int, base int, pw int, ph int, area int) {
	let vals = [4, 8, 6, 12, 9, 14, 11];
	var i = 0;
	while i < 6 {
		let x0 = px + i * pw / 6;
		let x1 = px + (i + 1) * pw / 6;
		let y0 = chart_y(base, ph, vals[i]);
		let y1 = chart_y(base, ph, vals[i + 1]);
		if area != 0 {
			var xx = x0;
			while xx < x1 {
				let t = if x1 == x0 { 0 } else { (xx - x0) * 100 / (x1 - x0) };
				let yy = y0 + (y1 - y0) * t / 100;
				if base > yy { fill_rect(xx, yy, 1, base - yy, THEME.accent, 70); }
				xx += 1;
			}
		}
		stroke_line(x0, y0, x1, y1, THEME.accent);
		stroke_line(x0, y0 + 1, x1, y1 + 1, THEME.accent);
		i += 1;
	}
	fill_ell(px + pw, chart_y(base, ph, vals[6]), 4, 4, THEME.accent, 255);
}

fn chart_bars(px int, base int, pw int, ph int) {
	let vals = [6, 11, 8, 14, 9, 12, 7];
	let bw = pw / 7;
	var i = 0;
	while i < 7 {
		let bh = vals[i] * ph / 16;
		let bx = px + i * bw + 4;
		let gap = if bw > 12 { 8 } else { 2 };
		fill_rect(bx, base - bh, bw - gap, bh, THEME.accent, 255);
		i += 1;
	}
}

fn chart_donut(x int, y int, w int, h int) {
	let cx = x + w / 2;
	let cy = y + h / 2;
	var r = h / 2 - 16;
	if w / 2 - 16 < r { r = w / 2 - 16; }
	if r < 16 { return; }
	let inner = r * 58 / 100;
	for py in cy - r..cy + r {
		for px in cx - r..cx + r {
			let dx = px - cx;
			let dy = cy - py;
			let d2 = dx * dx + dy * dy;
			if d2 > r * r || d2 < inner * inner { continue; }
			let ang = atan2_deg(dy, dx);
			let col = if ang < 170 { THEME.accent } else if ang < 280 { THEME.ok } else { THEME.warn };
			put(px, py, col, 255);
		}
	}
	draw_text(cx - 16, cy - 10, "64", 20.0, THEME.ink, 0, -1);
}

fn paint_goods(x int, y int, w int, h int, kind int) {
	let ink = THEME.ink;
	let acc = THEME.accent;
	let cx = x + w / 2;
	let cy = y + h / 2;
	let lit = lerp_rgb(acc, 0xFFFFFF, 0.45 as f32);
	let shade = lerp_rgb(acc, 0x1A140C, 0.35 as f32);
	if kind == 0 {
		fill_ell(cx, cy + 30, 34, 10, 0x000000, 40);
		fill_rect(cx - 26, cy - 16, 52, 40, shade, 255);
		fill_rect(cx - 26, cy - 16, 16, 40, acc, 255);
		fill_rect(cx - 22, cy - 8, 6, 28, lit, 220);
		fill_ell(cx, cy + 22, 26, 12, shade, 255);
		fill_ell(cx, cy - 16, 26, 10, lit, 255);
		fill_ell(cx, cy - 16, 16, 6, 0x6A3A28, 255);
		fill_ell(cx + 34, cy + 4, 14, 18, ink, 255);
		fill_ell(cx + 28, cy + 4, 8, 12, THEME.surface, 255);
	} else if kind == 1 {
		fill_ell(cx, cy + 34, 30, 8, 0x000000, 45);
		fill_rect(cx - 6, cy - 4, 12, 32, ink, 255);
		fill_rect(cx - 4, cy - 4, 3, 32, lit, 180);
		fill_ell(cx, cy + 28, 26, 8, shade, 255);
		fill_ell(cx, cy - 16, 46, 16, shade, 255);
		fill_ell(cx, cy - 20, 36, 10, acc, 255);
		fill_ell(cx - 8, cy - 22, 14, 6, lit, 230);
	} else if kind == 2 {
		fill_rect(cx - 34, cy + 28, 72, 8, 0x000000, 35);
		fill_rect(cx - 34, cy - 10, 68, 44, shade, 255);
		fill_rect(cx - 34, cy - 10, 22, 44, acc, 255);
		fill_rect(cx - 28, cy - 2, 8, 28, lit, 200);
		fill_rect(cx - 10, cy + 8, 36, 4, ink, 80);
		fill_ell(cx - 14, cy - 22, 8, 14, ink, 255);
		fill_ell(cx + 14, cy - 22, 8, 14, ink, 255);
		fill_rect(cx - 18, cy - 28, 10, 6, lit, 255);
	} else if kind == 3 {
		fill_rect(cx - 42, cy - 2, 78, 8, shade, 255);
		fill_rect(cx - 42, cy - 2, 78, 3, lit, 255);
		fill_rect(cx + 24, cy - 10, 18, 18, acc, 255);
		fill_rect(cx + 26, cy - 8, 6, 10, lit, 230);
		fill_tri(cx + 42, cy - 2, cx + 52, cy + 2, cx + 42, cy + 6, ink);
	} else if kind == 4 {
		fill_ell(cx, cy + 22, 50, 8, 0x000000, 35);
		fill_ell(cx, cy + 6, 46, 20, shade, 255);
		fill_ell(cx, cy + 2, 40, 14, acc, 255);
		fill_ell(cx - 10, cy - 2, 16, 6, lit, 220);
		fill_ell(cx, cy + 8, 28, 8, 0x6A3A28, 255);
		fill_ell(cx, cy - 2, 34, 6, lit, 255);
	} else {
		fill_rect(cx - 40, cy + 16, 84, 8, 0x000000, 30);
		fill_rect(cx - 38, cy - 18, 76, 22, shade, 255);
		fill_rect(cx - 38, cy - 18, 24, 22, acc, 255);
		fill_rect(cx - 32, cy - 12, 8, 12, lit, 200);
		fill_rect(cx - 28, cy + 2, 64, 16, ink, 200);
		fill_rect(cx - 22, cy + 6, 18, 8, lit, 120);
		fill_rect(cx + 8, cy - 8, 28, 8, acc, 255);
	}
}

fn paint_chart(x int, y int, w int, h int, kind int) {
	if kind >= 10 { paint_goods(x, y, w, h, kind - 10); return; }
	let k = if kind < 0 { 0 } else { kind % 7 };
	if k == 2 && w >= 120 && h >= 120 { chart_donut(x, y, w, h); return; }
	let spark = if k == 4 || k == 5 || h < 96 || w < 140 { 1 } else { 0 };
	let px, py, pw, ph = chart_grid(x, y, w, h, spark);
	let base = py + ph;
	if k == 1 || k == 6 { chart_bars(px, base, pw, ph); return; }
	if k == 3 { chart_series(px, base, pw, ph, 1); return; }
	chart_series(px, base, pw, ph, 0);
}

fn stroke_line(x0 int, y0 int, x1 int, y1 int, rgb u32) {
	var dx = x1 - x0; if dx < 0 { dx = -dx; }
	var dy = y1 - y0; if dy < 0 { dy = -dy; }
	let n = if dx > dy { dx } else { dy };
	if n < 1 { put(x0, y0, rgb, 255); return; }
	for i in n + 1 {
		let x = x0 + (x1 - x0) * i / n;
		let y = y0 + (y1 - y0) * i / n;
		put(x, y, rgb, 255);
	}
}

fn paint_picker(x int, y int, w int, h int, hue int, s f32, v f32) {
	let side = if h - 8 < w / 2 { h - 8 } else { w / 2 };
	if side < 8 { return; }
	for py in side {
		for px in side {
			let ss = px as f32 / side as f32;
			let vv = 1.0 - py as f32 / side as f32;
			put(x + 4 + px, y + 4 + py, hsv(hue, ss, vv), 255);
		}
	}
	let mx = x + 4 + (s * side as f32) as int;
	let my = y + 4 + ((1.0 - v) * side as f32) as int;
	let mark = if contrast_ratio(0xFFFFFF, THEME.bg) < 3.0 { THEME.ink } else { 0xFFFFFF };
	stroke_rect(mx - 3, my - 3, 6, 6, mark, 1);
	let rx = x + side + 14;
	let ry = y + 4 + side / 2;
	let rr = side / 2;
	for py in ry - rr..ry + rr {
		for px in rx..rx + rr {
			let dx = px - rx;
			let dy = ry - py;
			let d2 = dx * dx + dy * dy;
			if d2 > rr * rr || d2 < (rr - 10) * (rr - 10) { continue; }
			let ang = atan2_deg(dy, dx);
			put(px, py, hsv(ang, 1.0, 1.0), 255);
		}
	}
}

var SKY_TOP = 0x101820;
var SKY_BOT = 0x1C2A38;
var SKY_GRD = 0x121820;
var SKY_H = 720;
var LIGHT_SCENE = 0;

fn chan_luma(c int) int {
	let r = (c >> 16) & 255;
	let g = (c >> 8) & 255;
	let b = c & 255;
	(r * 3 + g * 6 + b) / 10
}

fn title_ink(ty int) u32 {
	var t = 0;
	if ty >= SKY_H { t = 5; }
	else if SKY_H > 0 { t = ty * 5 / SKY_H; }
	if t < 0 { t = 0; }
	if t > 5 { t = 5; }
	let col = if ty >= SKY_H { SKY_GRD as u32 } else { lerp_rgb(SKY_TOP as u32, SKY_BOT as u32, t as f32 / 5.0) };
	if chan_luma(col as int) > 150 { return 0x1A140C; }
	THEME.ink
}

fn back_title(g int, screen int, mode int) {
	if screen != 0 || g >= 24 { return; }
	var tx = 120;
	var ty = 260;
	if mode == 1 { tx = 180; ty = 140; }
	else if mode == 2 { tx = 760; ty = 150; }
	else if mode == 3 { tx = 140; ty = 150; }
	else if mode == 4 { tx = 1080; ty = 220; }
	let ink = title_ink(ty);
	draw_text(tx, ty, genre_name(g), 84.0, ink, 0, -1);
	draw_text(tx, ty + 96, sub_line(g), 28.0, ink, 0, -1);
	fill_rect(tx, ty + 88, 220, 4, THEME.accent, 255);
}

fn back_speck(x int, y int, w int, h int, cut int, light int) {
	var py = y + 3;
	while py < y + h {
		var px = x + 3;
		while px < x + w {
			let n = noise(px, py);
			if light != 0 {
				if n > cut { put(px, py, 0x1A140C, 40); }
			} else if n > cut { put(px, py, 0xFFFFFF, 90); }
			px += 5;
		}
		py += 5;
	}
}

fn shade_hill(cx int, cy int, rx int, ry int, shade u32, lit u32, rim u32) {
	if rx < 12 || ry < 8 { return; }
	fill_ell(cx, cy + ry / 6, rx, ry, shade, 255);
	fill_ell(cx, cy - ry / 10, rx - rx / 5, ry * 2 / 3, lit, 255);
	fill_ell(cx - rx / 3, cy - ry / 2, rx / 4, ry / 6, rim, 200);
}

fn paint_cloud(cx int, cy int, s int, rgb u32) {
	if s < 10 { return; }
	fill_ell(cx, cy, s, s / 2, rgb, 160);
	fill_ell(cx - s / 2, cy + s / 8, s * 2 / 3, s / 3, rgb, 140);
	fill_ell(cx + s * 2 / 5, cy + 2, s / 2, s / 3, rgb, 130);
	fill_ell(cx - s / 8, cy - s / 4, s / 3, s / 5, 0xFFFFFF, 55);
}

fn paint_tower(x0 int, y0 int, tw int, th int, body u32, rim u32, win u32) {
	if tw < 8 || th < 16 { return; }
	fill_rect(x0 + 4, y0 + 6, tw, th, 0x000000, 45);
	fill_rect(x0, y0, tw, th, body, 255);
	fill_rect(x0, y0, 3, th, rim, 255);
	fill_rect(x0, y0, tw, 3, rim, 210);
	fill_rect(x0 + tw - 4, y0, 4, th, 0x000000, 80);
	var wy = y0 + 10;
	while wy + 6 < y0 + th {
		fill_rect(x0 + 6, wy, 4, 5, win, 255);
		if tw > 24 { fill_rect(x0 + tw - 12, wy, 4, 5, win, 220); }
		wy += 14;
	}
}

fn back_mottle(x int, y int, w int, h int, light int) {
	var py = y + 8;
	while py < y + h {
		var px = x + 5;
		while px < x + w {
			let n = noise(px * 3 + 17, py + 9);
			if n > 168 {
				let col = if light != 0 { 0x1A140C } else { 0xE8EEF6 };
				let a = if n > 220 { 48 } else { 26 };
				fill_rect(px, py, 5, 2, col as u32, a);
			}
			px += 13;
		}
		py += 11;
	}
}

fn back_lay(g int, x int, y int, w int, h int, skyh int, farx int, nearx int, far u32, near u32, accent u32) {
	let hy = y + skyh;
	fill_rect(x, hy - 36, w, 72, far, 70);
	if g == 16 {
		fill_ell(x + w / 5 + farx, y + h / 3, w / 7, w / 10, 0x1A3A88, 140);
		fill_ell(x + w * 3 / 5 + farx, hy - h / 8, w / 10, w / 12, 0x16306A, 255);
		fill_ell(x + w * 3 / 5 + farx - w / 28, hy - h / 7, w / 16, w / 18, 0x4A7AD8, 255);
		fill_ell(x + w * 3 / 5 + farx - w / 40, hy - h / 6, w / 28, w / 30, 0xD6E4FF, 180);
		fill_ell(x + w * 4 / 5 + nearx / 4, y + h / 5, 18, 18, 0xF4E7C5, 255);
		fill_ell(x + w / 8, y + h / 6, 3, 3, 0xFFFFFF, 255);
		fill_ell(x + w / 3, y + h / 4, 2, 2, 0xFFFFFF, 220);
		fill_ell(x + w * 4 / 5, y + h / 3, 3, 3, 0xFFFFFF, 255);
		fill_ell(x + w / 2, y + h * 2 / 3, 2, 2, 0xE8E4D0, 255);
		return;
	}
	if g != 9 && g != 12 && g != 19 && g != 20 && g != 21 {
		let lit = lerp_rgb(far, 0xE7EEF6, 0.55 as f32);
		shade_hill(x + w / 6 + farx, hy + 8, w / 7, h / 10, far, lit, accent);
		shade_hill(x + w * 4 / 5 + farx / 2, hy + 16, w / 8, h / 12, near, lerp_rgb(near, 0xF4F7FB, 0.4 as f32), accent);
	}
	if g == 0 || g == 8 || g == 14 {
		paint_tower(x + w / 8 + nearx / 4, hy - h / 5, 48, h / 5, near, accent, 0xF4E2A8);
		paint_tower(x + w / 4 + nearx / 3, hy - h / 8, 36, h / 8, far, accent, 0xE8D090);
		paint_tower(x + w * 3 / 4 + nearx / 5, hy - h / 4, 56, h / 4, near, 0xF4E7C5, 0xFFE7A0);
		paint_tower(x + w * 5 / 6, hy - h / 7, 40, h / 7, far, accent, 0xF0D8A0);
		paint_cloud(x + w / 5, y + h / 5, 70, 0xD0D8E4);
		paint_cloud(x + w * 4 / 5, y + h / 4, 90, 0xE4E8F0);
	} else if g == 1 {
		shade_hill(x + w / 2 + nearx / 2, hy + 10, w / 4, h / 7, 0x1E6A40, 0x3CB56A, 0xD8F0C0);
		fill_rect(x, hy + h / 10, w, h / 8, 0x2A6A9A, 255);
		fill_rect(x, hy + h / 10, w, 8, 0x8ED4F0, 160);
		paint_cloud(x + 180, y + 180, 80, 0xF4F7FB);
		paint_cloud(x + w - 260, y + 220, 100, 0xE7EEF6);
	} else if g == 2 {
		shade_hill(x + w / 3 + nearx / 3, hy, w / 5, h / 8, near, 0x2E8A58, accent);
		fill_ell(x + w / 2, hy + 8, w / 3, h / 16, 0x3AA0E8, 255);
		fill_ell(x + w / 2, hy, w / 4, h / 28, 0x8ED4F0, 180);
		paint_tower(x + 80, hy - 70, 28, 70, far, accent, 0xF4E2A8);
		paint_tower(x + w - 140, hy - 90, 36, 90, near, accent, 0xF4E2A8);
	} else if g == 3 {
		shade_hill(x + w / 2 + nearx / 2, hy + 20, w / 3, h / 9, near, 0x6A8A40, accent);
		paint_tower(x + w / 5, hy - 48, 64, 48, 0xC4A06A, 0xF0D8A8, 0x6A4020);
		paint_tower(x + w * 2 / 3, hy - 64, 80, 64, 0xA07848, 0xE8C898, 0x5A3818);
		paint_cloud(x + 200, y + 160, 70, 0xF7F4EA);
	} else if g == 4 {
		shade_hill(x + w / 2 + farx, hy - 10, w / 5, h / 5, far, 0x6A4890, accent);
		shade_hill(x + w / 4 + nearx / 2, hy + 8, w / 6, h / 8, near, 0x3A7848, 0xC8E8A0);
		paint_tower(x + w * 2 / 3, hy - 80, 44, 56, 0xC45A58, 0xF4C8A8, 0xF4E7C5);
		paint_tower(x + w * 2 / 3 + 48, hy - 56, 36, 40, 0x8A3038, 0xE8A090, 0xF4E7C5);
		paint_cloud(x + 160, y + 150, 60, 0xF8E4F0);
	} else if g == 5 {
		shade_hill(x + w / 5 + farx, hy, w / 8, h / 4, 0x1A1210, 0x3A2820, 0xE25822);
		shade_hill(x + w * 3 / 4 + nearx / 3, hy + 10, w / 6, h / 5, near, 0x2A1A14, 0xC45A30);
		paint_tower(x + w / 2 - 30, hy - h / 4, 60, h / 4, 0x2A2018, 0xE8C8A0, 0xF0A060);
		paint_cloud(x + w - 200, y + 200, 50, 0x4A4038);
	} else if g == 6 {
		shade_hill(x + w / 3 + nearx / 2, hy + 6, w / 4, h / 8, near, 0x3A8858, accent);
		paint_tower(x + w * 3 / 5, hy - 100, 70, 100, far, 0xF0C14A, 0xF4E7C5);
		paint_tower(x + w * 3 / 5 - 40, hy - 60, 36, 60, near, accent, 0xF4E2A8);
		paint_cloud(x + 140, y + 160, 80, 0xE4EEF8);
		paint_cloud(x + w - 220, y + 200, 60, 0xF4F7FB);
	} else if g == 7 {
		shade_hill(x + w / 4 + farx, hy - 8, w / 5, h / 7, far, near, accent);
		shade_hill(x + w * 3 / 4 + farx / 2, hy, w / 6, h / 8, near, far, 0xF0E040);
		fill_tri(x + w / 2, hy - 4, x + w / 2 - 80, y + h, x + w / 2 + 80, y + h, 0x3A4048);
		fill_tri(x + w / 2, hy + 8, x + w / 2 - 28, y + h - 4, x + w / 2 + 28, y + h - 4, accent);
		paint_cloud(x + 180, y + 150, 90, 0xF4F7FB);
	} else if g == 9 {
		paint_tower(x + 40, hy - h / 6, w / 8, h / 6, 0xE8EEF4, 0xFFFFFF, 0x3A6A9A);
		paint_tower(x + w - w / 6, hy - h / 5, w / 7, h / 5, 0xD8E4F0, 0xFFFFFF, 0x2A5878);
		fill_rect(x + w / 2 - 8, hy, 16, h - skyh, 0xF8F8F8, 220);
		fill_ell(x + w / 2, hy + h / 10, 18, 18, 0xF8F8F8, 255);
		paint_cloud(x + 200, y + 140, 70, 0xFFFFFF);
	} else if g == 10 {
		shade_hill(x + w / 5 + nearx / 2, hy + 4, w / 5, h / 7, near, 0x4AAA58, 0xD8F0A0);
		shade_hill(x + w * 2 / 3 + nearx / 3, hy + 12, w / 6, h / 9, far, 0x2A7840, accent);
		fill_rect(x + w / 3, hy - 24, 120, 16, 0x3A6A38, 255);
		fill_rect(x + w / 2, hy - 48, 90, 14, 0x2A5A30, 255);
		paint_cloud(x + 160, y + 140, 80, 0xFFFFFF);
		paint_cloud(x + w - 240, y + 180, 100, 0xF4F8FC);
	} else if g == 11 {
		shade_hill(x + w / 4, hy, w / 7, h / 6, 0x1A1018, 0x3A2430, 0xE07030);
		shade_hill(x + w * 3 / 4 + nearx / 4, hy + 8, w / 6, h / 5, near, 0x2A1820, accent);
		paint_tower(x + w / 2 - 20, hy - 90, 40, 90, 0x241820, 0xC06030, 0xF0A060);
	} else if g == 13 {
		shade_hill(x + w / 6 + farx, hy, w / 6, h / 8, far, 0x2A6840, 0xC8E090);
		paint_tower(x + w / 3, hy - 36, 28, 70, 0x6A4030, 0xC87848, 0x2A1810);
		fill_ell(x + w / 3 + 10, hy - 48, 22, 28, 0x1E4A28, 255);
		paint_tower(x + w * 2 / 3, hy - 28, 24, 60, 0x5A3828, 0xC87848, 0x2A1810);
		fill_ell(x + w * 2 / 3 + 8, hy - 40, 20, 26, 0x163820, 255);
		fill_rect(x, hy + h / 12, w, 24, 0x2A6A8A, 255);
		paint_cloud(x + w - 200, y + 160, 70, 0xF4E8D0);
	} else if g == 15 {
		paint_tower(x + w / 2 - 50, hy - 120, 100, 90, 0x1A1214, 0x4A2024, 0xE03030);
		fill_tri(x + w / 2, hy - 150, x + w / 2 - 70, hy - 90, x + w / 2 + 70, hy - 90, 0x140C10);
		paint_tower(x + w / 5, hy - 80, 16, 80, 0x1A1410, 0x3A3028, 0x2A2018);
		fill_ell(x + w / 5 + 8, hy - 96, 28, 16, 0x101010, 255);
		paint_cloud(x + 140, y + 180, 80, 0x2A2428);
		paint_cloud(x + w - 180, y + 200, 90, 0x1A181C);
	} else if g == 17 {
		shade_hill(x + w / 4 + farx, hy - 20, w / 5, h / 4, far, 0x3A78A0, 0xD6EEF8);
		shade_hill(x + w * 3 / 5 + nearx / 3, hy, w / 6, h / 6, near, 0x2A8A50, 0xD8F0B0);
		paint_tower(x + w / 2 - 24, hy - 110, 48, 110, 0xC8C0A8, 0xF4E7C5, 0x6A90C0);
		paint_tower(x + w / 2 - 70, hy - 60, 28, 60, near, accent, 0xF4E2A8);
		paint_cloud(x + 160, y + 140, 70, 0xF7FBFF);
	} else if g == 18 {
		fill_ell(x + w * 3 / 4 + farx / 2, y + h / 6, 48, 48, 0xFFE08A, 255);
		fill_ell(x + w * 3 / 4 + farx / 2 - 10, y + h / 6 - 8, 28, 28, 0xFFF6D0, 255);
		shade_hill(x + w / 4 + nearx / 2, hy + 8, w / 5, h / 8, 0x6AAA58, 0xA8E090, 0xFFF2C8);
		shade_hill(x + w * 2 / 3, hy + 16, w / 7, h / 10, near, 0x8ED36A, 0xFFF6E0);
		paint_cloud(x + 180, y + 160, 80, 0xFFFFFF);
		paint_cloud(x + w / 2, y + 200, 60, 0xFFF0F4);
	} else if g == 22 {
		shade_hill(x + w / 3, hy + 10, w / 5, h / 9, near, 0x6A4828, accent);
		paint_tower(x + w / 2, hy - 70, 80, 50, 0x5A3A22, 0xE0B060, 0xF4E2A0);
		paint_tower(x + w / 6, hy - 40, 48, 40, 0x4A3018, 0xC89858, 0xF0D090);
		paint_cloud(x + w - 200, y + 160, 60, 0xF4E0C0);
	} else if g == 23 {
		shade_hill(x + w / 4 + nearx / 3, hy, w / 6, h / 8, near, 0xC03080, 0xFFD0E8);
		paint_tower(x + w / 2 - 20, hy - 80, 40, 80, 0x4A0878, 0xFFD24A, 0xFFF2C0);
		fill_ell(x + w / 5 + farx / 2, y + h / 5, 36, 36, 0xFFD24A, 240);
		fill_ell(x + w * 3 / 4, y + h / 4, 22, 22, 0xFF4AD0, 220);
		paint_cloud(x + w - 180, y + 150, 50, 0xFFD0F0);
	} else if g == 12 {
		fill_rect(x, hy - 20, w, h - skyh + 20, 0x1A140E, 255);
		fill_rect(x + 80, hy - 80, w - 160, 16, 0x3A2A1C, 255);
		fill_rect(x + 80, hy - 80, w - 160, 4, 0xC8A060, 255);
		paint_tower(x + w / 5, hy - 140, 36, 60, 0x2A2018, 0xE0C080, 0xF4E2A8);
		paint_cloud(x + w * 3 / 4, y + 160, 40, 0x6A5040);
	} else if g == 19 {
		fill_rect(x + w / 6, hy - 40, w * 2 / 3, 24, 0x1A1020, 255);
		fill_rect(x + w / 6, hy - 40, w * 2 / 3, 4, accent, 255);
		paint_tower(x + w / 5, hy - 160, 28, 120, 0x140810, 0xFF4A8A, 0xFFD0E8);
		paint_tower(x + w * 3 / 4, hy - 180, 28, 140, 0x140810, 0x4AD0FF, 0xD0F4FF);
		fill_ell(x + w / 3, y + h / 4, 30, 30, 0xFF4A8A, 90);
		fill_ell(x + w * 2 / 3, y + h / 5, 24, 24, 0x4AD0FF, 90);
	} else if g == 20 {
		fill_rect(x + w / 5, hy - 80, 80, 80, accent, 255);
		fill_rect(x + w / 5, hy - 80, 80, 8, 0xFFFFFF, 160);
		fill_rect(x + w / 2, hy - 120, 64, 64, 0x5A78E0, 255);
		fill_rect(x + w / 2, hy - 120, 8, 64, 0xF2C14A, 255);
		fill_rect(x + w * 2 / 3, hy - 48, 96, 48, near, 255);
		paint_cloud(x + 140, y + 160, 50, 0xE4E8FF);
	} else if g == 21 {
		fill_rect(x + 60, y + 80, 36, h - 120, 0x6A4038, 255);
		fill_rect(x + w - 96, y + 80, 36, h - 120, 0x6A4038, 255);
		fill_rect(x + 40, y + 60, w - 80, 28, 0x4A2828, 255);
		fill_rect(x + w / 3, y + 100, w / 3, h / 2, 0xC8D8EC, 255);
		fill_rect(x + w / 3, y + 100, 8, h / 2, 0xF4F7FB, 255);
		shade_hill(x + w / 2, y + h / 2, w / 8, h / 10, far, accent, 0xFFFFFF);
	}
	if g != 16 && g != 12 { fill_rect(x, hy - 2, w, 3, accent, 140); }
}

fn back_depth(g int, mode int, x int, y int, w int, h int) {
	var top = 0x101820;
	var bot = 0x3E86C4;
	var ground = 0x1A3348;
	var far = 0x163A60;
	var near = 0x102840;
	var accent = 0xF08A3A;
	if g == 1 { top = 0x2E78C8; bot = 0x8ED4F8; ground = 0x2E9A58; far = 0x1A6840; near = 0x145030; accent = 0x7A5AD8; }
	else if g == 2 { top = 0x14604A; bot = 0x3AAA78; ground = 0x1E7848; far = 0x145038; near = 0x0E3828; accent = 0x3AA0E8; }
	else if g == 3 { top = 0x4A8A58; bot = 0xC6D878; ground = 0xD0A85A; far = 0x3A6838; near = 0x2A4828; accent = 0xE0C04A; }
	else if g == 4 { top = 0x3A1878; bot = 0xE070C0; ground = 0x2A7848; far = 0x2A1860; near = 0x1A4030; accent = 0xF4E7C5; }
	else if g == 5 { top = 0x1A1210; bot = 0x3A2820; ground = 0x140E0C; far = 0x2A1A14; near = 0x100C0A; accent = 0xE25822; }
	else if g == 6 { top = 0x1A3068; bot = 0x3A78D0; ground = 0x6A4A28; far = 0x142850; near = 0x3A3018; accent = 0xF0C14A; }
	else if g == 7 { top = 0x2A78C0; bot = 0xF0C14A; ground = 0x3A4048; far = 0x1A5080; near = 0x2A3038; accent = 0xF0E040; }
	else if g == 8 { top = 0x6A1830; bot = 0xE04858; ground = 0x2A1418; far = 0x4A1020; near = 0x1A0C10; accent = 0xF0C14A; }
	else if g == 9 { top = 0x5EC8F8; bot = 0xD4F2FF; ground = 0x3DDC6A; far = 0x1E8A48; near = 0x146838; accent = 0xF8F8F8; }
	else if g == 10 { top = 0x4AA0F0; bot = 0xF2D27A; ground = 0x3A9A48; far = 0x2A7040; near = 0x1A5030; accent = 0xF2D27A; }
	else if g == 11 { top = 0x2A1438; bot = 0x5A2858; ground = 0x1A1018; far = 0x3A1840; near = 0x120C14; accent = 0xE07030; }
	else if g == 12 { top = 0x1A3050; bot = 0x24885A; ground = 0x1E8A50; far = 0x145038; near = 0x0A3028; accent = 0xE8C040; }
	else if g == 13 { top = 0x3A78B0; bot = 0xF0C878; ground = 0x3A8A40; far = 0x2A6030; near = 0x1A4020; accent = 0xF0C878; }
	else if g == 14 { top = 0x6AB0E8; bot = 0xE4F2FF; ground = 0xD0B48A; far = 0x4A6A88; near = 0x3A5068; accent = 0xF0C14A; }
	else if g == 15 { top = 0x10080C; bot = 0x1A1014; ground = 0x0C080C; far = 0x1A1014; near = 0x080608; accent = 0xC02020; }
	else if g == 16 { top = 0x040818; bot = 0x1230A0; ground = 0x081028; far = 0x0A1848; near = 0x1A3068; accent = 0xF4E7C5; }
	else if g == 17 { top = 0x2A58A0; bot = 0x7AD4F0; ground = 0x3AAA58; far = 0x1A6840; near = 0x145030; accent = 0xF4E7C5; }
	else if g == 18 { top = 0xF8D7A8; bot = 0xF7B7C8; ground = 0x8ED36A; far = 0xE0A070; near = 0x6AAA58; accent = 0xFFE08A; }
	else if g == 19 { top = 0x3A0860; bot = 0xE02878; ground = 0x180818; far = 0x5A1060; near = 0x100610; accent = 0x4AD0FF; }
	else if g == 20 { top = 0x243878; bot = 0x5A78E0; ground = 0x1A2858; far = 0x2A3878; near = 0x141E40; accent = 0xF2C14A; }
	else if g == 21 { top = 0x4A2058; bot = 0xF0A090; ground = 0x2A1828; far = 0x3A1840; near = 0x1A1020; accent = 0xF0A060; }
	else if g == 22 { top = 0x4A3018; bot = 0xF0B050; ground = 0x2A1C10; far = 0x3A2814; near = 0x1A140C; accent = 0xF0C14A; }
	else if g == 23 { top = 0x7A14C0; bot = 0xFF3AA8; ground = 0x4A0878; far = 0x5A1090; near = 0x2A0848; accent = 0xFFD24A; }
	else if g == 24 { top = 0x1E3A5C; bot = 0x4A7AB0; ground = 0x16304A; far = 0x163454; near = 0x102438; accent = 0x5B8DEF; }
	else if g == 25 { top = 0x241848; bot = 0x4A3A88; ground = 0x1A1430; far = 0x2A2058; near = 0x140E28; accent = 0x8A7AE0; }
	else if g == 26 { top = 0xF6E6D4; bot = 0xF0C8A8; ground = 0xE8B090; far = 0xE0A888; near = 0xC88868; accent = 0xE05A3A; }
	else if g == 27 { top = 0x3A1860; bot = 0xE04080; ground = 0x2A1048; far = 0x4A1868; near = 0x1A0830; accent = 0xFF5A9A; }
	else if g == 28 { top = 0x14382C; bot = 0x3AAA78; ground = 0x102820; far = 0x1A4838; near = 0x0C2018; accent = 0x5AD0A0; }
	else if g == 29 { top = 0x140818; bot = 0x6A1860; ground = 0x100610; far = 0x3A1040; near = 0x0C0810; accent = 0xE040A0; }
	else if g == 30 { top = 0x1A1C22; bot = 0x2E3440; ground = 0x12141A; far = 0x242830; near = 0x101218; accent = 0x7AA2F7; }
	else if g == 31 { top = 0xE8EEF4; bot = 0xD0D8E4; ground = 0xC8D0DC; far = 0xB0B8C8; near = 0x98A0B0; accent = 0x3A6FE0; }
	else if g == 32 { top = 0xE8D8F8; bot = 0xF0C8E8; ground = 0xD8C0E8; far = 0xC8A8D8; near = 0xB090C0; accent = 0x7A4AD0; }
	else if g == 33 { top = 0x0E1A40; bot = 0x1A3A80; ground = 0x0A1430; far = 0x142858; near = 0x081028; accent = 0x4A8AE0; }
	else if g == 34 { top = 0xF4F7FB; bot = 0xD6E4F8; ground = 0xE8F0FA; far = 0xC0D0E8; near = 0xA8B8D0; accent = 0x635BFF; }
	else if g == 35 { top = 0xF6F1E6; bot = 0xE8DCC8; ground = 0xEFE6D4; far = 0xD8C8B0; near = 0xC0B098; accent = 0xC45A20; }
	else if g == 36 { top = 0xD6ECFA; bot = 0x8EC8F0; ground = 0xC8E4F4; far = 0x98C0E0; near = 0x78A8C8; accent = 0xE05A3A; }
	else if g == 37 { top = 0xF0E6D4; bot = 0xE0C8A8; ground = 0xE8D4B8; far = 0xD0B898; near = 0xB89878; accent = 0x3A8A5A; }
	else if g == 38 { top = 0x1A4A38; bot = 0x3A9A68; ground = 0x2A6848; far = 0x1A5838; near = 0x123828; accent = 0xE0C04A; }
	else if g == 39 { top = 0x0E2420; bot = 0x1A4A40; ground = 0x0A1C18; far = 0x143830; near = 0x081410; accent = 0xD4B06A; }
	else if g == 40 { top = 0xE8F6F2; bot = 0xB8E8DC; ground = 0xD4F0E8; far = 0xA0D0C0; near = 0x80B8A8; accent = 0xE04058; }
	SKY_TOP = top; SKY_BOT = bot; SKY_GRD = ground;
	var skyh = h * 2 / 3;
	if g == 16 { skyh = h; }
	SKY_H = skyh;
	var i = 0;
	while i < 12 {
		let col = lerp_rgb(top as u32, bot as u32, i as f32 / 11.0);
		let y0 = y + skyh * i / 12;
		let y1 = y + skyh * (i + 1) / 12;
		fill_rect(x, y0, w, y1 - y0 + 1, col, 255);
		i += 1;
	}
	if skyh < h { fill_rect(x, y + skyh, w, h - skyh, ground as u32, 255); }
	let farx = mode * 10;
	let nearx = mode * 36;
	back_lay(g, x, y, w, h, skyh, farx, nearx, far as u32, near as u32, accent as u32);
	let light = if chan_luma(top) > 140 || chan_luma(ground) > 140 { 1 } else { 0 };
	LIGHT_SCENE = light;
	let cut = if g == 16 { 80 } else if light != 0 { 210 } else { 200 };
	back_speck(x, y, w, h, cut, light);
	back_mottle(x, y, w, h, light);
}

fn paint_stage_back(id int, x int, y int, w int, h int) {
	let g = N[id].i0;
	let screen = N[id].i1;
	let mode = N[id].i2;
	if g >= 24 {
		LIGHT_SCENE = 0;
		fill_rect(x, y, w, h, THEME.bg, 255);
		return;
	}
	if mode <= 0 { HIT_GAP = 0.22; HIT_A = 255; }
	else if mode == 1 { HIT_GAP = 0.16; HIT_A = 220; }
	else if mode == 2 { HIT_GAP = 0.11; HIT_A = 180; }
	else if mode == 3 { HIT_GAP = 0.07; HIT_A = 140; }
	else { HIT_GAP = 0.04; HIT_A = 90; }
	back_depth(g, mode, x, y, w, h);
	if g == 0 && screen == 3 {
		let cx = x + w / 2;
		let cy = y + h / 2;
		fill_rect(cx - 2, cy - 28, 4, 18, THEME.ink, 255);
		fill_rect(cx - 2, cy + 10, 4, 18, THEME.ink, 255);
		fill_rect(cx - 28, cy - 2, 18, 4, THEME.ink, 255);
		fill_rect(cx + 10, cy - 2, 18, 4, THEME.ink, 255);
	}
	back_title(g, screen, mode);
}
