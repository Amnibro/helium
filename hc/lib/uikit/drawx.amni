fn back_souls(x int, y int, w int, h int) {
	fill_rect(x, y, w, h, 0x0C0E12, 255);
	fill_rect(x, y + h / 3, w, 72, 0xB0B6BE, 36);
	fill_rect(x, y + h / 2, w, 100, 0xD0D4D8, 24);
	fill_rect(x + w / 8, y + h / 5, 32, h / 2, 0x1A1E24, 255);
	fill_rect(x + w - w / 8 - 32, y + h / 4, 32, h / 2, 0x1A1E24, 255);
	fill_rect(x, y + h * 2 / 3, w, 4, 0x6A6048, 255);
