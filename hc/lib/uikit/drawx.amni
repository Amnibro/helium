fn back_racing(x int, y int, w int, h int) {
	fill_rect(x, y, w, h / 3, 0x1A2430, 255);
	fill_rect(x, y + h / 3, w, h - h / 3, 0x2A2E34, 255);
	fill_rect(x, y + h / 3, w, 6, 0xE8C840, 255);
	var i = 0;
	while i < 6 {
		let bh = 40 + (i * 17) % 48;
		fill_rect(x + 24 + i * 48, y + h / 3 - bh, 32, bh, 0x3A4450, 255);
		i += 1;
	}
	var k = 0;
	while k < 12 {
		fill_rect(x + 80 + k * 140, y + h * 2 / 3, 56, 8, 0xE6E2D0, 255);
		k += 1;
	}
}

