	fill_rect(x + w / 5, y + h / 2 - 8, w * 3 / 5, 6, 0xE8D8C8, 255);
	fill_rect(x + w / 5, y + h / 2 + 28, w * 3 / 5, 6, 0xE8D8C8, 255);
	fill_rect(x + w / 5, y + h / 2 + 64, w * 3 / 5, 6, 0xE8D8C8, 255);
	fill_rect(x + w / 5 - 16, y + h / 2 - 40, 16, 160, 0xC8B070, 255);
	fill_rect(x + w - w / 5, y + h / 2 - 40, 16, 160, 0xC8B070, 255);
}

fn back_table(x int, y int, w int, h int) {
	fill_rect(x, y, w, h, 0x14120E, 255);
	fill_rect(x + w / 8, y + h / 4, w * 3 / 4, h / 2, 0x1E4A32, 255);
	fill_rect(x + w / 6, y + h / 3, w * 2 / 3, h / 3, 0x246044, 255);
	fill_rect(x + w / 8, y + h / 4, w * 3 / 4, 4, 0xC8A24A, 255);
	fill_rect(x + w / 8, y + h / 4 + h / 2 - 4, w * 3 / 4, 4, 0xC8A24A, 255);
}

fn paint_stage_back(id int, x int, y int, w int, h int) {
	let g = N[id].i0;
	let screen = N[id].i1;
	let mode = N[id].i2;
	if g == 1 { back_royale(x, y, w, h); }
	else if g == 3 { back_rts(x, y, w, h); }
	else if g == 6 { back_hall(x, y, w, h); }
	else if g == 9 { back_pitch(x, y, w, h); }
	else if g == 10 { back_hills(x, y, w, h); }
	else if g == 11 { back_crypt(x, y, w, h); }
	else if g == 13 { back_wild(x, y, w, h); }
	else if g == 14 { back_town(x, y, w, h); }
	else if g == 15 { back_dark(x, y, w, h); }
	else if g == 16 { back_void(x, y, w, h); }
	else if g == 17 { back_glen(x, y, w, h); }
	else if g == 18 { back_farm(x, y, w, h); }
	else if g == 2 { back_moba(x, y, w, h); }
	else if g == 4 { back_jrpg(x, y, w, h); }
	else if g == 5 { back_souls(x, y, w, h); }
	else if g == 7 { back_racing(x, y, w, h); }
	else if g == 8 { back_arena(x, y, w, h); }
	else if g == 12 { back_table(x, y, w, h); }
	else { back_fps(x, y, w, h, g, screen); }
	back_title(g, screen, mode);
}
