// Extra painters: HUD kits, charts, color, and the 100-effect text styles.
namespace uikit;

fn sin_milli(deg int) int {
	var d = deg;
	while d < 0 { d += 360; }
	while d >= 360 { d -= 360; }
	var sign = 1;
	if d >= 180 { sign = -1; d -= 180; }
	let num = 4 * d * (180 - d);
	let den = 40500 - d * (180 - d);
	if den == 0 { return 0; }
	sign * num * 1000 / den
}
fn cos_milli(deg int) int { sin_milli(deg + 90) }

fn atan2_deg(y int, x int) int {
	if x == 0 && y == 0 { return 0; }
	let ax = if x < 0 { -x } else { x };
	let ay = if y < 0 { -y } else { y };
	var deg = 0;
	if ax >= ay && ax > 0 { deg = ay * 45 / ax; }
	else if ay > 0 { deg = 90 - ax * 45 / ay; }
	if x >= 0 && y >= 0 { return deg; }
	if x < 0 && y >= 0 { return 180 - deg; }
	if x < 0 && y < 0 { return 180 + deg; }
	if deg == 0 { return 0; }
	360 - deg
}

fn hsv(h int, s f32, v f32) u32 {
	let c = v * s;
	let hf = h as f32 / 60.0;
	var hp = hf;
	while hp >= 2.0 { hp = hp - 2.0; }
	var d = hp - 1.0;
	if d < 0.0 { d = 0.0 - d; }
	let x = c * (1.0 - d);
	let m = v - c;
	var r f32 = 0.0;
	var g f32 = 0.0;
	var b f32 = 0.0;
	let seg = (h / 60) % 6;
	let seg6 = if seg < 0 { seg + 6 } else { seg };
	if seg6 == 0 { r = c; g = x; }
	else if seg6 == 1 { r = x; g = c; }
	else if seg6 == 2 { g = c; b = x; }
	else if seg6 == 3 { g = x; b = c; }
	else if seg6 == 4 { r = x; b = c; }
	else { r = c; b = x; }
	var ri = ((r + m) * 255.0) as int;
	var gi = ((g + m) * 255.0) as int;
	var bi = ((b + m) * 255.0) as int;
	if ri < 0 { ri = 0; } if ri > 255 { ri = 255; }
	if gi < 0 { gi = 0; } if gi > 255 { gi = 255; }
	if bi < 0 { bi = 0; } if bi > 255 { bi = 255; }
	((ri << 16) | (gi << 8) | bi) as u32
}

fn blit_ring(rgb u32, rad int, alpha int) {
	for k in 16 {
		let dx = cos_milli(k * 22) * rad / 1000;
		let dy = sin_milli(k * 22) * rad / 1000;
		blit_run(rgb, dx, dy, alpha);
	}
}

fn blit_shadow(rgb u32) {
	blit_run(rgb, 1, 1, 80);
	blit_run(rgb, 2, 2, 60);
	blit_run(rgb, 3, 4, 40);
	blit_run(rgb, 5, 6, 24);
	blit_run(rgb, 7, 9, 14);
}

fn blit_gradient(top u32, bot u32) {
	for i in GI.len {
		let id = GI[i];
		let x0 = GX[i] as int + C_X[id];
		let y0 = GY[i] as int + C_Y[id];
		let gh = if C_H[id] < 1 { 1 } else { C_H[id] };
		for py in C_H[id] {
			let col = lerp_rgb(top, bot, py as f32 / gh as f32);
			for px in C_W[id] {
				let a = alpha(id, px, py);
				if a > 0 { put(x0 + px, y0 + py, col, a); }
			}
		}
	}
}

fn fx_pair(slot int) u32, u32 {
	if slot == 0 { return 0xFDE047, 0xC2410C; }
	if slot == 1 { return 0xFEF08A, 0xE11D48; }
	if slot == 2 { return 0xE0F2FE, 0x1D4ED8; }
	if slot == 3 { return 0xFDE68A, 0x6D28D9; }
	if slot == 4 { return 0xBBF7D0, 0x047857; }
	if slot == 5 { return 0xF5D0FE, 0x6B21A8; }
	if slot == 6 { return 0xF8FAFC, 0x1E293B; }
	if slot == 7 { return 0xFBCFE8, 0x7C3AED; }
	if slot == 8 { return 0xFDBA74, 0x9F1239; }
	return 0x111111, 0xF8FAFC;
}

fn fx_draw(i int, x int, y int, text const byte[:], size f32, rgb u32) {
	let g = if i < 0 { 0 } else { i / 10 };
	let slot = if i < 0 { 0 } else { i % 10 };
	var limit = -1;
	if i == 6 { limit = 3; }
	TRACK = if i == 7 { size * 0.14 } else { 0.0 };
	let n = place_run(text, x as f32, y as f32, size, false, i == 1 || g == 5 && slot == 3, false, limit);
	TRACK = 0.0;
	if n < 1 { return; }
	if g == 8 {
		for k in n { GY[k] = GY[k] + ((k % 3) - 1) as f32 * 2.0; }
	}
	if i == 93 && n > 2 { GY[1] = GY[1] - 3.0; }
	if g == 1 {
		let ink = if slot == 2 { 0xE11D48 } else if slot == 3 { 0xCA8A04 } else if slot == 8 { 0xF8FAFC } else if slot == 9 { 0x111111 } else { 0x111111 };
		let rad = if slot == 0 || slot == 6 { 1 } else if slot == 1 || slot == 7 { 3 } else { 2 };
		blit_ring(ink as u32, rad, 255);
		if slot == 5 { blit_ring(0xF8FAFC, rad + 1, 255); }
	}
	if i == 3 {
		blit_run(0x111111, 2, 3, 90);
		blit_run(0x111111, 4, 5, 40);
	}
	if g == 2 {
		let dx = if slot == 1 || slot == 2 { 6 } else if slot == 3 { 5 } else { 2 };
		let dy = if slot == 4 { 1 } else if slot == 1 { 0 } else { dx };
		let col = if slot == 5 { 0x2563EB } else if slot == 6 { 0xC2410C } else if slot == 7 { 0x0369A1 } else { 0x111111 };
		let a = if slot == 1 || slot == 8 { 255 } else { 140 };
		blit_run(col as u32, dx, dy, a);
		if slot == 8 { blit_run(0x111111, dx + 3, dy + 2, 100); }
	}
	if i == 4 || g == 3 {
		let glow = if slot == 0 { 0x22D3EE } else if slot == 1 { 0xE879F9 } else if slot == 2 { 0xFACC15 } else if slot == 3 { 0xF43F5E } else if slot == 6 { 0xF97316 } else if slot == 8 { 0x38BDF8 } else { 0xF8FAFC };
		blit_ring(glow as u32, 3, 160);
		blit_ring(0x111111, 1, 180);
	}
	if g == 6 && slot != 3 && slot != 8 {
		let glow = if slot == 0 || slot == 6 { 0xF97316 } else if slot == 1 { 0x38BDF8 } else if slot == 2 || slot == 4 { 0xA3E635 } else if slot == 5 { 0xFDE047 } else if slot == 7 { 0x818CF8 } else { 0xE11D48 };
		blit_ring(glow as u32, 3, 150);
	}
	if g == 7 {
		blit_run(0x22D3EE, -1, 0, 200);
		blit_run(0xE879F9, 1, 0, 200);
	}
	if i == 52 { blit_run(0xF8FAFC, 1, 1, 230); blit_run(0x111111, -2, -2, 230); }
	else if i == 51 { blit_run(0xF8FAFC, -2, -2, 240); blit_run(0x111111, 3, 3, 220); }
	else if i == 50 { blit_run(0xF8FAFC, -1, -1, 230); blit_run(0x111111, 1, 1, 200); }
	else if i == 57 { blit_run(0x111111, -1, -1, 200); }
	else if i == 58 { blit_run(0xF8FAFC, 0, 2, 230); }
	if g == 4 || i == 5 || (g == 6 && slot != 6 && slot != 8) || i == 94 || i == 95 || i == 97 {
		let top, bot = fx_pair(if g == 4 { slot } else if i == 94 || i == 97 { 0 } else if i == 95 { 4 } else if i == 53 { 6 } else { slot });
		if g == 4 || i == 99 || i == 94 || i == 95 || i == 97 { blit_ring(0x111111, 1, 255); }
		blit_gradient(top, bot);
	} else if i == 54 {
		blit_gradient(0xE2E8F0, 0x334155);
		blit_run(0xF8FAFC, 0, -2, 180);
	} else if i == 59 {
		blit_ring(0x111111, 2, 255);
		blit_ring(0xF8FAFC, 1, 255);
	} else if g == 8 || i == 99 {
		for k in n {
			let col = hsv((k * 48 + slot * 18) % 360, 0.9, 0.95);
			let id = GI[k];
			let x0 = GX[k] as int + C_X[id];
			let y0 = GY[k] as int + C_Y[id];
			for py in C_H[id] { for px in C_W[id] { let a = alpha(id, px, py); if a > 0 { put(x0 + px, y0 + py, col, a); } } }
		}
		blit_ring(0x111111, 1, 200);
	} else if i == 56 {
		blit_ring(0xF8FAFC, 1, 255);
		blit_run(0xBFDBFE, 0, 0, 140);
	} else if i == 96 {
		blit_ring(0x111111, 2, 255);
		blit_run(0xF8FAFC, 0, 0, 255);
		blit_run(0xE11D48, 3, 3, 160);
	} else if i != 59 {
		let fill = if i == 52 { 0x334155 } else if i == 51 { 0xF8FAFC } else if i == 68 { 0x7F1D1D } else if g == 6 && slot == 8 { 0xFDE047 } else { rgb };
		blit_run(fill, 0, 0, 255);
	}
	if i == 8 { fill_rect(x, y + size as int - 2, (n * 8), 2, 0x111111, 255); }
	if i == 9 { fill_rect(x, y + (size as int) / 2, n * 8, 2, 0xE11D48, 255); }
}

fn text_pop(x int, y int, text const byte[:], size f32, fill u32, stroke u32, lift f32) {
	let yy = y - (lift * 6.0) as int;
	let n = place_run(text, x as f32, yy as f32 + size * 0.8, size, false, true, false, -1);
	if n < 1 { return; }
	blit_ring(stroke, 2, 255);
	blit_shadow(0x000000);
	blit_gradient(0xFFFFFF, fill);
}

fn isqrt(n int) int {
	if n <= 0 { return 0; }
	var a = n;
	var b = (a + 1) / 2;
	while b < a { a = b; b = (a + n / a) / 2; }
	a
}

fn fill_ell(cx int, cy int, rx int, ry int, rgb u32, a int) {
	if rx < 2 || ry < 2 { return; }
	var py = cy - ry;
	while py <= cy + ry {
		let dy = (py - cy) * 1000 / ry;
		let room = 1000000 - dy * dy;
		if room > 0 {
			let hw = isqrt(room) * rx / 1000;
			if hw > 0 { fill_rect(cx - hw, py, hw * 2 + 1, 1, rgb, a); }
		}
		py += 1;
	}
}

fn map_at(o int, s int, p int) int { o + s * p / 100 }

fn map_rad(w int, h int, p int) int {
	let s = if w < h { w } else { h };
	let r = s * p / 100;
	if r < 3 { 3 } else { r }
}

fn map_blob(x int, y int, w int, h int, px int, py int, rx int, ry int, rgb u32) {
	fill_ell(map_at(x, w, px), map_at(y, h, py), w * rx / 100, h * ry / 100, rgb, 255);
}

fn map_node(x int, y int, w int, h int, px int, py int, p int, rgb u32) {
	let r = map_rad(w, h, p);
	fill_ell(map_at(x, w, px), map_at(y, h, py), r, r, rgb, 255);
}

fn map_chain(x int, y int, w int, h int, x0 int, y0 int, x1 int, y1 int, n int, p int, rgb u32) {
	if n < 2 { return; }
	let r = map_rad(w, h, p);
	let dx = (x1 - x0) * w / 100;
	let dy = (y1 - y0) * h / 100;
	var steps = isqrt(dx * dx + dy * dy) / (r / 2 + 1);
	if steps < n { steps = n; }
	if steps > 40 { steps = 40; }
	if steps < 2 { steps = 2; }
	let ry = if r < 5 { r } else { r * 3 / 4 };
	var i = 0;
	while i < steps {
		let px = x0 + (x1 - x0) * i / (steps - 1);
		let py = y0 + (y1 - y0) * i / (steps - 1);
		fill_ell(map_at(x, w, px), map_at(y, h, py), r, ry, rgb, 255);
		i += 1;
	}
}

fn map_ring(x int, y int, w int, h int, px int, py int, p int, rgb u32) {
	let cx = map_at(x, w, px);
	let cy = map_at(y, h, py);
	let r = map_rad(w, h, p);
	var n = r;
	if n < 16 { n = 16; }
	if n > 72 { n = 72; }
	let d = if r > 48 { 4 } else { 2 };
	var i = 0;
	while i < n {
		let ox = cos_milli(i * 360 / n) * r / 1000;
		let oy = sin_milli(i * 360 / n) * r / 1000;
		fill_ell(cx + ox, cy + oy, d, d, rgb, 255);
		i += 1;
	}
}

fn map_lot(x int, y int, w int, h int, px int, py int, bw int, bh int, rgb u32) {
	let ww = w * bw / 100;
	let hh = h * bh / 100;
	if ww < 2 || hh < 2 { return; }
	fill_rect(map_at(x, w, px), map_at(y, h, py), ww, hh, rgb, 255);
}

fn map_block(x int, y int, w int, h int, px int, py int, bw int, bh int, body u32, roof u32) {
	let x0 = map_at(x, w, px);
	let y0 = map_at(y, h, py);
	let ww = w * bw / 100;
	let hh = h * bh / 100;
	if ww < 4 || hh < 4 { return; }
	fill_rect(x0 + 2, y0 + 2, ww, hh, 0x000000, 70);
	fill_rect(x0, y0, ww, hh, body, 255);
	fill_rect(x0, y0, ww, 2, roof, 255);
	fill_rect(x0, y0, 2, hh, roof, 200);
	if ww > 14 && hh > 12 { fill_rect(x0 + ww / 3, y0 + hh / 3, ww / 5, hh / 4, roof, 160); }
}

fn map_road(x int, y int, w int, h int, x0 int, y0 int, x1 int, y1 int, wide int, asphalt u32, curb u32) {
	let ax = map_at(x, w, x0);
	let ay = map_at(y, h, y0);
	let bx = map_at(x, w, x1);
	let by = map_at(y, h, y1);
	var dx = bx - ax;
	if dx < 0 { dx = -dx; }
	var dy = by - ay;
	if dy < 0 { dy = -dy; }
	let n = if dx > dy { dx } else { dy };
	if n < 1 { return; }
	let cw = wide + 4;
	var i = 0;
	while i <= n {
		let px = ax + (bx - ax) * i / n;
		let py = ay + (by - ay) * i / n;
		fill_rect(px - cw / 2, py - cw / 2, cw, cw, curb, 255);
		fill_rect(px - wide / 2, py - wide / 2, wide, wide, asphalt, 255);
		if wide >= 8 && i % 10 < 4 { fill_rect(px - 1, py - 1, 2, 2, 0xE7D48A, 255); }
		i += 1;
	}
}

fn map_lay(seed int, x int, y int, w int, h int) {
	let road = 0x3C4450 as u32;
	let curb = 0xD9CDB4 as u32;
	let wall = 0x6A5844 as u32;
	let roof = 0xE4C48A as u32;
	let grass = 0x2C6A44 as u32;
	let dirt = 0x6A5438 as u32;
	let water = 0x2A6494 as u32;
	if seed == 1 {
		map_lot(x, y, w, h, 6, 8, 88, 70, grass);
		map_lot(x, y, w, h, 0, 72, 100, 28, water);
		map_road(x, y, w, h, 14, 18, 86, 18, 7, road, curb);
		map_road(x, y, w, h, 14, 58, 86, 58, 7, road, curb);
		map_road(x, y, w, h, 18, 14, 18, 64, 6, road, curb);
		map_road(x, y, w, h, 78, 14, 78, 64, 6, road, curb);
		map_block(x, y, w, h, 28, 28, 16, 14, wall, roof);
		map_block(x, y, w, h, 52, 30, 14, 16, 0x4A4038, 0xC45A3A);
		map_ring(x, y, w, h, 50, 42, 28, 0xE7C84A);
	} else if seed == 2 {
		map_lot(x, y, w, h, 0, 0, 100, 100, 0x1A3A2C);
		map_road(x, y, w, h, 10, 16, 90, 16, 8, road, curb);
		map_road(x, y, w, h, 10, 84, 90, 84, 8, road, curb);
		map_road(x, y, w, h, 10, 78, 90, 22, 7, road, curb);
		map_road(x, y, w, h, 0, 46, 100, 58, 12, water, 0x8EC8E4);
		map_block(x, y, w, h, 6, 68, 16, 16, 0x3A6AD0, 0xD6E4FF);
		map_block(x, y, w, h, 76, 8, 16, 16, 0xC44A3A, 0xF4C8B0);
	} else if seed == 3 {
		map_lot(x, y, w, h, 4, 6, 92, 88, 0x3A4A32);
		map_road(x, y, w, h, 12, 78, 48, 48, 7, dirt, curb);
		map_road(x, y, w, h, 48, 48, 82, 22, 7, dirt, curb);
		map_road(x, y, w, h, 22, 28, 70, 70, 5, road, curb);
		map_block(x, y, w, h, 16, 62, 18, 16, wall, roof);
		map_block(x, y, w, h, 62, 16, 20, 14, 0x5A6840, 0xC8D090);
		map_block(x, y, w, h, 40, 36, 12, 12, 0x4A4438, 0xE8C878);
	} else if seed == 4 {
		map_lot(x, y, w, h, 8, 10, 40, 30, water);
		map_lot(x, y, w, h, 52, 18, 40, 50, grass);
		map_road(x, y, w, h, 8, 78, 46, 62, 6, dirt, curb);
		map_road(x, y, w, h, 46, 62, 86, 28, 6, dirt, curb);
		map_block(x, y, w, h, 58, 24, 14, 12, 0xC45A58, 0xF4D0B0);
		map_block(x, y, w, h, 74, 26, 12, 14, 0x8A4040, 0xE8B090);
		map_block(x, y, w, h, 66, 48, 16, 12, wall, roof);
	} else if seed == 5 {
		map_lot(x, y, w, h, 8, 12, 84, 76, 0x2A2420);
		map_road(x, y, w, h, 12, 78, 48, 58, 8, 0x4A443C, curb);
		map_road(x, y, w, h, 48, 58, 78, 28, 8, 0x4A443C, curb);
		map_block(x, y, w, h, 62, 14, 24, 22, 0x3A3030, 0xC4A878);
		map_block(x, y, w, h, 70, 18, 8, 28, 0x2A2424, 0xE8C8A0);
	} else if seed == 6 {
		map_lot(x, y, w, h, 6, 8, 88, 84, grass);
		map_road(x, y, w, h, 16, 74, 50, 40, 7, dirt, curb);
		map_road(x, y, w, h, 50, 40, 82, 20, 7, dirt, curb);
		map_block(x, y, w, h, 18, 58, 16, 14, wall, roof);
		map_block(x, y, w, h, 58, 22, 18, 14, 0x4A6848, 0xD0C080);
		map_block(x, y, w, h, 70, 58, 14, 16, wall, 0xC45A3A);
	} else if seed == 7 {
		map_lot(x, y, w, h, 18, 16, 64, 68, grass);
		map_road(x, y, w, h, 16, 22, 84, 22, 10, 0x2A2E34, 0xE8E4E0);
		map_road(x, y, w, h, 16, 78, 84, 78, 10, 0x2A2E34, 0xE8E4E0);
		map_road(x, y, w, h, 16, 22, 16, 78, 10, 0x2A2E34, 0xC44A3A);
		map_road(x, y, w, h, 84, 22, 84, 78, 10, 0x2A2E34, 0xC44A3A);
		map_block(x, y, w, h, 40, 40, 20, 16, 0x3A4248, 0xD0D4DC);
	} else if seed == 8 {
		map_lot(x, y, w, h, 16, 22, 68, 56, 0x4A3428);
		map_road(x, y, w, h, 20, 28, 80, 28, 4, 0xE8E0D0, 0x2A2420);
		map_road(x, y, w, h, 20, 72, 80, 72, 4, 0xE8E0D0, 0x2A2420);
		map_block(x, y, w, h, 22, 36, 12, 16, 0x6EC8FF, 0xF4FBFF);
		map_block(x, y, w, h, 66, 36, 12, 16, 0xE24A4A, 0xF4D0C8);
	} else if seed == 9 {
		map_lot(x, y, w, h, 14, 16, 72, 68, 0x2E8A48);
		map_road(x, y, w, h, 18, 50, 82, 50, 3, 0xF4F4F0, 0x2E8A48);
		map_road(x, y, w, h, 50, 20, 50, 80, 3, 0xF4F4F0, 0x2E8A48);
		map_block(x, y, w, h, 8, 20, 10, 60, 0xD8E4F0, 0xFFFFFF);
		map_block(x, y, w, h, 82, 20, 10, 60, 0xD8E4F0, 0xFFFFFF);
		map_block(x, y, w, h, 44, 42, 12, 10, 0xF8F8F8, 0xE8E8E8);
	} else if seed == 10 {
		map_lot(x, y, w, h, 6, 8, 88, 84, 0x1E4A30);
		map_block(x, y, w, h, 12, 22, 28, 8, 0x3A6844, 0x8ED48A);
		map_block(x, y, w, h, 22, 40, 36, 8, 0x2A5038, 0x6AAA70);
		map_block(x, y, w, h, 16, 58, 24, 8, 0x4A7850, 0xC8E090);
		map_road(x, y, w, h, 48, 18, 48, 82, 4, 0xC8B080, dirt);
		map_block(x, y, w, h, 62, 62, 18, 12, wall, roof);
	} else if seed == 11 {
		map_lot(x, y, w, h, 8, 10, 24, 20, 0x2A2428);
		map_lot(x, y, w, h, 40, 12, 22, 22, 0x322C30);
		map_lot(x, y, w, h, 66, 36, 24, 22, 0x3A3034);
		map_lot(x, y, w, h, 24, 58, 22, 24, 0x2A2428);
		map_road(x, y, w, h, 28, 24, 46, 22, 4, 0x5A5048, 0x2A2420);
		map_road(x, y, w, h, 56, 28, 70, 44, 4, 0x5A5048, 0x2A2420);
		map_road(x, y, w, h, 46, 30, 34, 64, 4, 0x5A5048, 0x2A2420);
		map_block(x, y, w, h, 44, 16, 8, 8, 0x6A3030, 0xE07030);
	} else if seed == 12 {
		map_lot(x, y, w, h, 8, 14, 84, 72, 0x1A3A28);
		map_road(x, y, w, h, 14, 28, 86, 28, 6, 0xC8B48A, 0x3A6848);
		map_road(x, y, w, h, 14, 50, 86, 50, 6, 0xC8B48A, 0x3A6848);
