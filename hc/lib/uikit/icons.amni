// 500 named vector pictograms. icon_named() is the count with real silhouettes.
namespace uikit;
import uikit.icons_reg;

var ISEEN int[500] = [0; 500];
var IREADY = false;

fn icon_count() int { 500 }

fn popcount(v int) int {
	var n = 0;
	var x = v;
	while x != 0 { n += x & 1; x = x >> 1; }
	n
}

fn worm_mask(id int) int {
	var m = 0;
	var x = id % 5;
	var y = (id / 5) % 5;
	var dir = (id / 25) % 4;
	for step in 18 {
		m = m | (1 << (y * 5 + x));
		let turn = ((id + step * 19) >> ((step + (id & 7)) % 6)) & 3;
		if turn == 0 { dir = (dir + 3) & 3; }
		else if turn == 1 { dir = (dir + 1) & 3; }
		var nx = x;
		var ny = y;
		if dir == 0 { nx += 1; }
		else if dir == 1 { ny += 1; }
		else if dir == 2 { nx -= 1; }
		else { ny -= 1; }
		if nx < 0 { nx = 0; dir = 0; }
		else if nx > 4 { nx = 4; dir = 2; }
		else if ny < 0 { ny = 0; dir = 1; }
		else if ny > 4 { ny = 4; dir = 3; }
		else { x = nx; y = ny; }
	}
	let bit = 1 << (((id / 7) % 5) * 5 + ((id / 3) % 5));
	if (id & 1) == 0 { m = m | bit; }
	else if popcount(m) > 6 { m = m & (bit ^ 33554431); }
	if popcount(m) < 4 { m = m | (1 << (id % 25)); }
	m & 33554431
}

fn build_icon_masks() {
	if IREADY { return; }
	var n = 0;
	var salt = 0;
	while n < 500 && salt < 40000 {
		let m = worm_mask(n * 131 + salt * 17 + 3);
		var dup = popcount(m) < 5;
		if !dup {
			for i in n { if ISEEN[i] == m { dup = true; } }
		}
		if !dup {
			ISEEN[n] = m;
			n += 1;
		}
		salt += 1;
	}
	while n < 500 {
		ISEEN[n] = ((n * 97 + 13) & 33554431);
		if ISEEN[n] == 0 { ISEEN[n] = n + 1; }
		n += 1;
	}
	for n in 500 {
		var tries = 0;
		while tries < 80 {
			var dup = false;
			for i in n { if ISEEN[i] == ISEEN[n] { dup = true; } }
			if !dup && popcount(ISEEN[n]) >= 4 { break; }
			ISEEN[n] = (ISEEN[n] + 19 + tries * 3) & 33554431;
			if ISEEN[n] == 0 { ISEEN[n] = tries + 1; }
			tries += 1;
		}
	}
	IREADY = true;
}

fn icon_mask(id int) int {
	var i = id;
	if i < 0 { i = 0; }
	if i >= 500 { i = i % 500; }
	let n = icon_len(i);
	if n <= 0 {
		build_icon_masks();
		return ISEEN[i];
	}
	var h = 0;
	for k in n {
		h = h & 16777215;
		h = ((h << 5) ^ icon_byte(i, k) ^ (k * 97)) & 16777215;
	}
	h | 1073741824
}

fn icon_hit(id int, u int, v int) bool {
	let m = icon_mask(id);
	if (m & 1073741824) != 0 { return false; }
	for gy in 5 {
		for gx in 5 {
			let bit = 1 << (gy * 5 + gx);
			if (m & bit) == 0 { continue; }
			let cx = gx * 200 + 100;
			let cy = gy * 200 + 100;
			let dx = u - cx;
			let dy = v - cy;
			if dx * dx + dy * dy <= 125 * 125 { return true; }
		}
	}
	false
}

fn cov_from_sd(sd f32) int {
	let w f32 = 1.35;
	if sd <= 0.0 - w { return 255; }
	if sd >= w { return 0; }
	let t = (w - sd) / (w + w);
	(t * 255.0) as int
}

fn disc_sd(u f32, v f32, cx f32, cy f32, r f32) f32 {
	let dx = u - cx;
	let dy = v - cy;
	sqrt(dx * dx + dy * dy) - r
}

fn box_sd(u f32, v f32, x f32, y f32, w f32, h f32) f32 {
	let cx = x + w * 0.5;
	let cy = y + h * 0.5;
	var dx = u - cx;
	var dy = v - cy;
	if dx < 0.0 { dx = 0.0 - dx; }
	if dy < 0.0 { dy = 0.0 - dy; }
	dx = dx - w * 0.5;
	dy = dy - h * 0.5;
	var ax = dx;
	var ay = dy;
	if ax < 0.0 { ax = 0.0; }
	if ay < 0.0 { ay = 0.0; }
	var mx = dx;
	if dy > mx { mx = dy; }
	if mx < 0.0 { mx } else { sqrt(ax * ax + ay * ay) }
}

fn cross2(ax f32, ay f32, bx f32, by f32) f32 { ax * by - ay * bx }

fn tri_sd(u f32, v f32, ax f32, ay f32, bx f32, by f32, cx f32, cy f32) f32 {
	let e0x = bx - ax; let e0y = by - ay;
	let e1x = cx - bx; let e1y = cy - by;
	let e2x = ax - cx; let e2y = ay - cy;
	let l0 = sqrt(e0x * e0x + e0y * e0y);
	let l1 = sqrt(e1x * e1x + e1y * e1y);
	let l2 = sqrt(e2x * e2x + e2y * e2y);
	if l0 < 0.2 || l1 < 0.2 || l2 < 0.2 { return 8.0; }
	var s0 = cross2(e0x, e0y, u - ax, v - ay) / l0;
	var s1 = cross2(e1x, e1y, u - bx, v - by) / l1;
	var s2 = cross2(e2x, e2y, u - cx, v - cy) / l2;
	let area = cross2(bx - ax, by - ay, cx - ax, cy - ay);
	if area < 0.0 { s0 = 0.0 - s0; s1 = 0.0 - s1; s2 = 0.0 - s2; }
	var m = s0;
	if s1 < m { m = s1; }
	if s2 < m { m = s2; }
	0.0 - m
}

fn seg_sd(u f32, v f32, x0 f32, y0 f32, x1 f32, y1 f32, rad f32) f32 {
	let dx = x1 - x0;
	let dy = y1 - y0;
	let len2 = dx * dx + dy * dy;
	var t f32 = 0.0;
	if len2 > 0.01 { t = ((u - x0) * dx + (v - y0) * dy) / len2; }
	if t < 0.0 { t = 0.0; }
	if t > 1.0 { t = 1.0; }
	let px = x0 + t * dx;
	let py = y0 + t * dy;
	let ex = u - px;
	let ey = v - py;
	sqrt(ex * ex + ey * ey) - rad
}

fn icon_cover(id int, u f32, v f32) int {
	var i = 0;
	let n = icon_len(id);
	var cover = 0;
	while i < n {
		let op = icon_byte(id, i);
		if op == 1 {
			let a = cov_from_sd(disc_sd(u, v, icon_byte(id, i + 1) as f32, icon_byte(id, i + 2) as f32, icon_byte(id, i + 3) as f32));
			if a > cover { cover = a; }
			i += 4;
		} else if op == 2 {
			let a = cov_from_sd(box_sd(u, v, icon_byte(id, i + 1) as f32, icon_byte(id, i + 2) as f32, icon_byte(id, i + 3) as f32, icon_byte(id, i + 4) as f32));
			if a > cover { cover = a; }
			i += 5;
		} else if op == 3 {
			let a = cov_from_sd(tri_sd(u, v, icon_byte(id, i + 1) as f32, icon_byte(id, i + 2) as f32, icon_byte(id, i + 3) as f32, icon_byte(id, i + 4) as f32, icon_byte(id, i + 5) as f32, icon_byte(id, i + 6) as f32));
			if a > cover { cover = a; }
			i += 7;
		} else if op == 4 {
			let thick = icon_byte(id, i + 5) as f32 * 0.5;
			let a = cov_from_sd(seg_sd(u, v, icon_byte(id, i + 1) as f32, icon_byte(id, i + 2) as f32, icon_byte(id, i + 3) as f32, icon_byte(id, i + 4) as f32, thick));
			if a > cover { cover = a; }
			i += 6;
		} else if op == 5 {
			let cx = icon_byte(id, i + 1) as f32;
			let cy = icon_byte(id, i + 2) as f32;
			let r = icon_byte(id, i + 3) as f32;
			let thick = icon_byte(id, i + 4) as f32 * 0.5;
			let dx = u - cx;
			let dy = v - cy;
			var dist = sqrt(dx * dx + dy * dy) - r;
			if dist < 0.0 { dist = 0.0 - dist; }
			let a = cov_from_sd(dist - thick);
			if a > cover { cover = a; }
			i += 5;
		} else if op == 6 {
			let a = cov_from_sd(disc_sd(u, v, icon_byte(id, i + 1) as f32, icon_byte(id, i + 2) as f32, icon_byte(id, i + 3) as f32));
			cover = cover * (255 - a) / 255;
			i += 4;
		} else if op == 7 {
			let a = cov_from_sd(box_sd(u, v, icon_byte(id, i + 1) as f32, icon_byte(id, i + 2) as f32, icon_byte(id, i + 3) as f32, icon_byte(id, i + 4) as f32));
			cover = cover * (255 - a) / 255;
			i += 5;
		} else {
			i += 1;
		}
	}
	cover
}

fn spell_rgb(id int) u32, u32 {
	let k = if id < 0 { 0 } else { id % 8 };
	if k == 0 { return 0x8C2A2A, 0xF0B0A0; }
	if k == 1 { return 0x2A4E86, 0xB7D4F4; }
	if k == 2 { return 0x2A6A40, 0xB7E2C4; }
	if k == 3 { return 0x8A6230, 0xF4D7A4; }
	if k == 4 { return 0x5C3488, 0xD4B4F0; }
	if k == 5 { return 0x8A3E22, 0xF4C090; }
	if k == 6 { return 0x1E646C, 0xA8E0E4; }
	return 0x8A2A58, 0xF0B0C8;
}

fn spell_plate(x int, y int, s int, body u32, lit u32, shape int) {
	let cx = x + s / 2;
	let cy = y + s / 2;
	if shape == 1 {
		fill_tri(cx, y, x, cy, cx, y + s, 0xFFF6E8);
		fill_tri(cx, y, x + s, cy, cx, y + s, 0xFFF6E8);
		fill_tri(cx, y + 2, x + 3, cy, cx, y + s - 3, body);
		fill_tri(cx, y + 2, x + s - 3, cy, cx, y + s - 3, body);
		fill_ell(cx, y + s / 3, s / 5, s / 8, lit, 200);
	} else if shape == 2 {
		fill_rect(x, y, s, s, 0xFFF6E8, 255);
		fill_rect(x + 2, y + 2, s - 4, s - 4, body, 255);
		fill_rect(x + 4, y + 4, s - 8, s / 3, lit, 180);
	} else if shape == 3 {
		fill_ell(cx, cy + s / 10, s / 2, s / 2, 0xFFF6E8, 255);
		fill_ell(cx, cy + s / 10, s / 2 - 2, s / 2 - 3, body, 255);
		fill_tri(cx, cy, x + s / 5, cy + s / 8, x + s - s / 5, cy + s / 8, body);
		fill_ell(cx, cy - s / 8, s / 4, s / 6, lit, 200);
	} else {
		fill_ell(cx, cy, s / 2, s / 2, 0xFFF6E8, 255);
		fill_ell(cx, cy, s / 2 - 2, s / 2 - 2, body, 255);
		fill_ell(cx, cy - s / 6, s / 3, s / 5, lit, 190);
	}
}

fn spell_mark(id int, x int, y int, s int, ink u32) {
	let cx = x + s / 2;
	let cy = y + s / 2;
	if id == 0 {
		fill_rect(cx - 2, y + s / 6, 4, s * 3 / 5, 0xE8EEF4, 255);
		fill_rect(cx - 1, y + s / 5, 2, s / 2, 0xFFFFFF, 220);
		fill_tri(cx, y + 2, cx - 4, y + s / 5, cx + 4, y + s / 5, 0xF4F7FB);
		fill_rect(cx - s / 5, cy + s / 10, s * 2 / 5, 3, 0xC8A15A, 255);
		fill_ell(cx, y + s - s / 6, 4, 4, 0xC8A15A, 255);
	} else if id == 1 || id == 52 {
		fill_ell(cx, cy - s / 10, s / 3, s / 4, 0xD6E4F4, 255);
		fill_rect(x + s / 5, cy, s * 3 / 5, s / 5, 0x8AA4C0, 255);
		fill_rect(cx - s / 6, cy - 2, s / 3, 3, 0x1A2430, 255);
	} else if id == 2 {
		fill_ell(cx - s / 8, cy - s / 10, s / 6, s / 6, 0xE23B4A, 255);
		fill_ell(cx + s / 8, cy - s / 10, s / 6, s / 6, 0xFF6A72, 255);
		fill_tri(cx, cy + s / 4, cx - s / 4, cy, cx + s / 4, cy, 0xE23B4A);
	} else if id == 4 || id == 74 {
		fill_rect(cx - 3, y + s / 5, 6, s / 8, 0xE8EEF4, 255);
		fill_ell(cx, cy + s / 8, s / 4, s / 3, 0xE8F4FF, 255);
		fill_ell(cx, cy + s / 6, s / 5, s / 5, 0x3B82F6, 255);
		fill_rect(cx - 1, cy, 2, s / 5, 0xFFFFFF, 180);
	} else if id == 5 {
		fill_ell(cx, cy + s / 8, s / 4, s / 3, 0xE25822, 255);
		fill_ell(cx, cy, s / 6, s / 4, 0xF0A040, 255);
		fill_ell(cx, cy - s / 10, s / 10, s / 8, 0xFFF2C8, 255);
	} else if id == 16 {
		stroke_line(cx - s / 3, y + s / 5, cx - s / 5, cy, ink);
		stroke_line(cx - s / 5, cy, cx - s / 3, y + s - s / 5, ink);
		stroke_line(cx + s / 4, y + s / 4, cx - s / 6, y + s - s / 4, 0xE8C878);
		fill_tri(cx + s / 4, y + s / 5, cx + s / 3, y + s / 3, cx + s / 8, y + s / 3, 0xF4F0E0);
	} else if id == 13 || id == 43 {
		fill_tri(cx, y + s / 5, cx - s / 4, cy, cx + s / 4, cy, 0xF4F7FF);
		fill_tri(cx, y + s - s / 5, cx - s / 4, cy, cx + s / 4, cy, 0x7AA0E8);
		fill_rect(cx - 1, y + s / 4, 2, s / 2, 0xFFFFFF, 200);
	} else if id == 15 {
		fill_ell(cx, cy - s / 8, s / 3, s / 6, 0xF4E7A0, 255);
		fill_rect(cx - 2, cy, 4, s / 3, 0x3A3428, 255);
		fill_ell(cx, cy + s / 4, s / 5, 4, 0x2A241C, 255);
		fill_ell(cx, cy - s / 6, s / 8, s / 10, 0xFFFFFF, 200);
	} else if id == 75 || id == 77 {
		fill_ell(cx, cy, s / 4, s / 4, ink, 255);
		fill_ell(cx, cy, s / 8, s / 8, 0xFFFFFF, 255);
		fill_rect(cx - 1, y + s / 6, 2, s * 2 / 3, ink, 255);
		fill_rect(x + s / 6, cy - 1, s * 2 / 3, 2, ink, 255);
	} else if id == 78 {
		fill_rect(x + s / 6, cy - 3, s * 2 / 3, 6, 0xD0D4DC, 255);
		fill_rect(x + s / 5, cy - 1, s / 2, 2, 0xFFFFFF, 220);
		fill_rect(cx - 2, cy, 8, s / 4, 0x3A3E46, 255);
	} else if id == 79 {
		fill_ell(cx, cy + 2, s / 4, s / 4, 0x3E8A45, 255);
		fill_ell(cx - s / 10, cy - s / 12, s / 10, s / 12, 0x8ED48A, 255);
		fill_rect(cx + s / 8, y + s / 5, 3, s / 6, 0xE8E4D0, 255);
	} else if id == 8 {
		fill_rect(cx - s / 5, cy, s / 3, s / 4, 0x4A3828, 255);
		fill_rect(cx - s / 4, cy + s / 8, s / 2, s / 6, 0x3A2C20, 255);
		fill_rect(cx - s / 5, cy, s / 8, s / 5, 0x6A5040, 255);
	} else if id % 5 == 0 {
		stroke_line(x + s / 4, y + s / 4, x + s - s / 4, y + s - s / 4, ink);
		stroke_line(x + s - s / 4, y + s / 4, x + s / 4, y + s - s / 4, ink);
		fill_ell(cx, cy, s / 8, s / 8, 0xFFFFFF, 220);
	} else if id % 5 == 1 {
		fill_tri(cx, y + s / 5, x + s / 5, y + s - s / 5, x + s - s / 5, y + s - s / 5, ink);
		fill_ell(cx, cy, 3, 3, 0xFFFFFF, 230);
	} else if id % 5 == 2 {
		fill_ell(cx, cy, s / 4, s / 6, ink, 255);
		fill_ell(cx, cy, s / 8, s / 12, 0xFFFFFF, 230);
	} else if id % 5 == 3 {
		fill_rect(cx - 2, y + s / 5, 4, s * 3 / 5, ink, 255);
		fill_rect(x + s / 5, cy - 2, s * 3 / 5, 4, ink, 255);
	} else {
		fill_ell(cx - s / 6, cy, s / 8, s / 8, ink, 255);
		fill_ell(cx + s / 6, cy - s / 8, s / 8, s / 8, 0xFFFFFF, 220);
		fill_ell(cx, cy + s / 6, s / 7, s / 7, ink, 255);
	}
}

fn paint_spell(id int, x int, y int, s int) {
	let body, lit = spell_rgb(id);
	let shape = if id < 0 { 0 } else { id % 4 };
	spell_plate(x, y, s, body, lit, shape);
	spell_mark(id, x + 1, y + 1, s, 0x10141C);
	spell_mark(id, x, y, s, lit);
}

fn icon_draw(id int, x int, y int, size int, rgb u32) {
	if size < 2 { return; }
	let n = if id < 0 { 0 } else if id >= 500 { id % 500 } else { id };
	if APP_UI == 0 && size >= 16 { paint_spell(n, x, y, size); return; }
	if icon_len(n) <= 0 {
		for py in size {
			for px in size {
				var hit = 0;
				for sy in 2 {
					for sx in 2 {
						let u = ((px * 2 + sx) * 1000) / (size * 2);
						let v = ((py * 2 + sy) * 1000) / (size * 2);
						if icon_hit(n, u, v) { hit += 1; }
					}
				}
				if hit > 0 { put(x + px, y + py, rgb, hit * 63); }
			}
		}
		return;
	}
	for py in size {
		for px in size {
			let u = (px as f32 + 0.5) * 64.0 / (size as f32);
			let v = (py as f32 + 0.5) * 64.0 / (size as f32);
			let a = icon_cover(n, u, v);
			if a > 0 { put(x + px, y + py, rgb, a); }
		}
	}
}
