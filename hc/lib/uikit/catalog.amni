fn fx_count() int { 100 }

fn fx_copy(i int, out byte[>..]&) {
	let s = "plain,bold,outline,shadow,glow,gradient,typewriter,wide,underline,strike,stroke-thin,stroke-thick,stroke-red,stroke-gold,stroke-ink,stroke-double,stroke-soft,stroke-hard,stroke-white,stroke-black,shadow-soft,shadow-hard,shadow-long,shadow-cast,shadow-contact,shadow-blue,shadow-warm,shadow-cool,shadow-stack,shadow-drop,glow-cyan,glow-magenta,glow-gold,glow-red,glow-white,bloom,halo,ember-glow,ice-glow,neon-sign,grad-gold,grad-fire,grad-ice,grad-dusk,grad-mint,grad-royal,grad-steel,grad-candy,grad-sunset,grad-mono,bevel,emboss,deboss,chrome,metal,pearl,glass-text,inset-text,letterpress,engrave,fire,ice,neon,lava,poison,holy,shadow-flame,arcane,blood,electric,glitch,glitch-rgb,slice,chromatic,broken,scan,vhs,corrupt,offset,jitter,wave,rainbow,pride,prism,aurora,candy-wave,flag,shimmer,pulse,ribbon,shake,scramble,pop,bounce,crit,heal,damage,title,subtitle,outline-gradient";
	var n = 0;
	var start = 0;
	var p = 0;
	out.clear();
	while p <= s.len {
		if p == s.len || s[p] == 44 {
			if n == i {
				for k in start..p { out.push(s[k]); }
				return;
			}
			n += 1;
			start = p + 1;
		}
		p += 1;
	}
}

