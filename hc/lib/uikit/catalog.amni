// Parameterized catalog: 300 themes, 41 genres, 100 effects, 30 font pairings.
namespace uikit;
import uikit.theme;
import uikit.widgets;
import uikit.core;

fn hsl(h int, s int, l int) u32 {
	var hh = h;
	while hh < 0 { hh += 360; }
	while hh >= 360 { hh -= 360; }
	let hf = hh as f32;
	let sf = s as f32 / 100.0;
	let lf = l as f32 / 100.0;
	let c = (1.0 - abs(2.0 * lf - 1.0)) * sf;
	let hp = hf / 60.0;
	var hpmod = hp;
	while hpmod >= 2.0 { hpmod = hpmod - 2.0; }
	var d = hpmod - 1.0;
	if d < 0.0 { d = 0.0 - d; }
	let x = c * (1.0 - d);
	let m = lf - c / 2.0;
	var r f32 = 0.0;
	var g f32 = 0.0;
	var b f32 = 0.0;
	let seg = hp as int;
	if seg == 0 { r = c; g = x; }
	else if seg == 1 { r = x; g = c; }
	else if seg == 2 { g = c; b = x; }
	else if seg == 3 { g = x; b = c; }
	else if seg == 4 { r = x; b = c; }
	else { r = c; b = x; }
	var ri = ((r + m) * 255.0) as int;
	var gi = ((g + m) * 255.0) as int;
	var bi = ((b + m) * 255.0) as int;
	if ri < 0 { ri = 0; } if ri > 255 { ri = 255; }
	if gi < 0 { gi = 0; } if gi > 255 { gi = 255; }
	if bi < 0 { bi = 0; } if bi > 255 { bi = 255; }
	((ri << 16) | (gi << 8) | bi) as u32
}

fn catalog_count() int { 300 }
fn catalog_families() int { 15 }

fn catalog_family_name(f int) const byte[:] {
	if f == 0 { return "ink"; }
	if f == 1 { return "glass"; }
	if f == 2 { return "neon"; }
	if f == 3 { return "parchment"; }
	if f == 4 { return "brutal"; }
	if f == 5 { return "pixel"; }
	if f == 6 { return "tactical"; }
	if f == 7 { return "arena"; }
	if f == 8 { return "jrpg"; }
	if f == 9 { return "horror"; }
	if f == 10 { return "circuit"; }
	if f == 11 { return "cozy"; }
	if f == 12 { return "terminal"; }
	if f == 13 { return "news"; }
	"royal"
}

fn catalog_set(index int) {
	var i = index;
	if i < 0 { i = 0; }
	if i > 299 { i = 299; }
	let fam = i / 20;
	let v = i % 20;
	let dark = v < 10;
	let hue = (fam * 23 + (v % 10) * 11) % 360;
	let ah = (hue + 32) % 360;
	var bg = hsl(hue, if dark { 26 } else { 16 }, if dark { 8 } else { 97 });
	var surface = hsl(hue, if dark { 20 } else { 10 }, if dark { 14 } else { 100 });
	let ink = hsl(hue, if dark { 10 } else { 28 }, if dark { 95 } else { 13 });
	var acc = hsl(ah, 72, 46);
	var step = 0;
	while contrast_ratio(0xFFFFFF, acc) < 3.0 && step < 12 {
		acc = lerp_rgb(acc, 0x000000, 0.18);
		step += 1;
	}
	var rad f32 = 6.0;
	rad = rad + (v % 5) as f32 * 2.0;
	var sh = 1;
	var glass = 0;
	var pixel = 0;
	var bw f32 = 1.0;
	var family = FAM_FLAT;
	if fam == 1 { glass = 1; family = FAM_GLASS; rad = 14.0; }
	if fam == 2 || fam == 10 { sh = 3; family = FAM_NEON; rad = 4.0; }
	if fam == 3 || fam == 8 || fam == 14 { family = FAM_FANTASY; bw = 2.0; }
	if fam == 4 { sh = 2; family = FAM_BRUTAL; rad = 0.0; bw = 3.0; }
	if fam == 5 || fam == 12 { pixel = 1; family = FAM_RETRO; rad = 0.0; }
	if fam == 13 { family = FAM_MINIMAL; rad = 2.0; }
	if fam == 9 { family = FAM_FLAT; }
	theme_apply(bg, surface, ink, acc, rad, bw, sh, glass, pixel, 10.0);
	THEME.family = family;
	THEME.variant = v;
	THEME.on_accent = 0xFFFFFF;
}

