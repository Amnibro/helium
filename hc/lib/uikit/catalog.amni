}

fn pair_body(i int) int { i % 22 }
fn pair_accent(i int) int {
	let a = (i * 5 + 7) % 22;
	if a == i % 22 { (a + 1) % 22 } else { a }
}

fn boss_name(g int) const byte[:] {
	if g % 8 == 0 { return "Warden"; }
	if g % 8 == 1 { return "Baron"; }
	if g % 8 == 2 { return "Drake"; }
	if g % 8 == 3 { return "Titan"; }
	if g % 8 == 4 { return "Queen"; }
	if g % 8 == 5 { return "Colossus"; }
	if g % 8 == 6 { return "Reaper"; }
	"Oracle"
}

fn game_kit(col int, g int, look int) {
	let title = button(col, genre_name(g), look % 20);
	set_px(title, 216.0, 32.0);
	let boss = boss_bar(col, 0.64);
	set_text(boss, boss_name(g));
	set_px(boss, 216.0, 22.0);
	let buff = buff_row(col, g);
	set_px(buff, 216.0, 28.0);
	let hp = health_bar(col, 0.72, look % 6);
	set_px(hp, 216.0, 16.0);
	let mp = mana_bar(col, 0.4, look % 6);
	set_px(mp, 216.0, 16.0);
	let mid = flex(col, DIR_ROW);
	set_gap(mid, 4.0);
	let map = minimap(mid, look % 6);
	set_px(map, 104.0, 100.0);
	N[map].i3 = g;
	let inv = inventory(mid, 3, 2, look % 6);
	set_px(inv, 104.0, 100.0);
	N[inv].i3 = g + 3;
	let quest = quest_log(col, g);
	set_text(quest, "Quests");
	set_px(quest, 216.0, 56.0);
	let cool = cooldown_row(col, g);
	set_px(cool, 216.0, 48.0);
	if g == 7 || g == 9 || g == 19 {
		let ch = chart(col, g % 7, look % 6);
		set_px(ch, 216.0, 72.0);
	} else {
		let rad = radial(col, 6, g % 6, look % 6);
		set_px(rad, 216.0, 88.0);
		N[rad].i3 = g;
	}
	let line = dialogue(col, "Hold the gate.", 40, look % 6);
	set_px(line, 216.0, 48.0);
	let nums = flex(col, DIR_ROW);
	set_gap(nums, 4.0);
	let d0 = damage_number(nums, "128", 0);
	set_px(d0, 64.0, 28.0);
	let d1 = damage_number(nums, "256", 1);
	set_px(d1, 64.0, 28.0);
	N[d1].val = 0.55;
	let d2 = damage_number(nums, "+40", 2);
	set_px(d2, 64.0, 28.0);
	N[d2].val = 0.8;
	let menu = flex(col, DIR_ROW);
	set_gap(menu, 4.0);
	let p = button(menu, "Play", 0);
	set_px(p, 64.0, 28.0);
	let s = button(menu, "Map", 2);
	set_px(s, 64.0, 28.0);
	let b = button(menu, "Bag", 5);
	set_px(b, 64.0, 28.0);
}

fn app_kit(col int, g int, look int) {
	let title = button(col, genre_name(g), look % 20);
	set_px(title, 216.0, 32.0);
	if g == 33 {
		let em = text_field(col, "Email", look % 6);
		set_px(em, 216.0, 32.0);
		let pw = text_field(col, "Password", look % 6);
		set_px(pw, 216.0, 32.0);
		let go = button(col, "Sign in", 0);
		set_px(go, 216.0, 32.0);
	} else if g == 31 {
		let t1 = toggle(col, "Dark", 1, look % 6);
		set_px(t1, 216.0, 32.0);
		let t2 = toggle(col, "Motion", 0, look % 6);
		set_px(t2, 216.0, 32.0);
		let cp = color_picker(col, 0x3B6FE2, look % 6);
		set_px(cp, 216.0, 120.0);
		N[cp].i1 = 210;
		N[cp].val = 0.7;
		N[cp].val2 = 0.85;
	} else if g == 28 {
		let a = message_bar(col, "On my way", 0);
		set_px(a, 216.0, 36.0);
		let c = message_bar(col, "See you there", 2);
		set_px(c, 216.0, 36.0);
		let f = text_field(col, "Message", look % 6);
		set_px(f, 216.0, 32.0);
	} else if g == 36 {
		let days = flex(col, DIR_ROW);
		set_gap(days, 2.0);
		let n0 = button(days, "M", 2); set_px(n0, 28.0, 28.0);
		let n1 = button(days, "T", 0); set_px(n1, 28.0, 28.0);
		let n2 = button(days, "W", 2); set_px(n2, 28.0, 28.0);
		let n3 = button(days, "T", 2); set_px(n3, 28.0, 28.0);
		let n4 = button(days, "F", 2); set_px(n4, 28.0, 28.0);
	} else if g == 38 {
		let map = minimap(col, 0);
		set_px(map, 216.0, 140.0);
		N[map].i3 = 4;
	} else if g == 37 {
		let row = flex(col, DIR_ROW);
		set_gap(row, 4.0);
		let a = card(row, "To", 2); set_px(a, 68.0, 72.0);
		let b = card(row, "Now", 0); set_px(b, 68.0, 72.0);
		let c = card(row, "End", 1); set_px(c, 68.0, 72.0);
	} else {
		let ch = chart(col, g % 7, look % 6);
		set_px(ch, 216.0, 90.0);
		let tb = table(col, 4, 2, 0);
		set_px(tb, 216.0, 110.0);
		table_set(tb, 0, 0, "Ada"); table_set(tb, 0, 1, "12");
		table_set(tb, 1, 0, "Bea"); table_set(tb, 1, 1, "9");
		table_set(tb, 2, 0, "Cal"); table_set(tb, 2, 1, "4");
		table_set(tb, 3, 0, "Dee"); table_set(tb, 3, 1, "7");
		table_filter(tb, "a");
		table_pin(tb, 1);
		table_resize(tb, 0, 80.0);
	}
	if g == 26 || g == 34 {
		let price = button(col, "Buy", 0);
		set_px(price, 216.0, 32.0);
	}
	if g == 32 {
		let step = flex(col, DIR_ROW);
		set_gap(step, 6.0);
		let a = badge(step, "1", 0); set_px(a, 36.0, 28.0);
		let b = badge(step, "2", 1); set_px(b, 36.0, 28.0);
		let c = badge(step, "3", 2); set_px(c, 36.0, 28.0);
	}
}

fn build_genre(parent int, g int, variation int) int {
	if g < 24 { build_screen(parent, g, 3); } else { app_page(parent, g); }
	variation
}
