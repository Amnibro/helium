// One layout per genre screen. Not a recolored copy of the FPS kit.
namespace uikit;
import uikit.widgets;
import uikit.core;

fn scr_col(parent int) int {
	let c = flex(parent, DIR_COL);
	set_w(c, 176.0);
	set_gap(c, 8.0);
	set_pad(c, 8.0);
	c
}
fn scr_btn(col int, text const byte[:], look int) int {
	let b = button(col, text, look);
	set_px(b, 160.0, 32.0);
	b
}
fn scr_lab(col int, text const byte[:]) int {
	let l = label(col, text, 7);
	set_px(l, 160.0, 16.0);
	l
}
fn scr_row(col int) int {
	let r = flex(col, DIR_ROW);
	set_gap(r, 8.0);
	set_pad(r, 0.0);
	r
}

fn kit_talk(g int) const byte[:] {
	if g == 0 || g == 1 { return "Hold the gate."; }
	if g == 2 { return "Baron in 20."; }
	if g == 4 || g == 17 { return "The gate holds."; }
	if g == 7 { return "Lap 2 of 3."; }
	if g == 8 { return "Round 2."; }
	if g == 12 { return "Intent: attack."; }
	if g == 18 { return "Shop is open."; }
	if g == 21 { return "Stay or go."; }
	if g == 23 { return "Pity 12."; }
	"Press on."
}

fn add_title(col int, g int, look int) {
	let b = button(col, genre_name(g), look);
	set_px(b, 224.0, 32.0);
}
fn add_boss(col int, g int) {
	let b = boss_bar(col, 0.64);
	set_text(b, boss_name(g));
	set_px(b, 224.0, 24.0);
}
fn add_buff(col int, g int) {
	let b = buff_row(col, g);
	set_px(b, 224.0, 32.0);
}
fn add_bars(col int, look int) {
	let hp = health_bar(col, 0.72, look % 6);
	set_px(hp, 224.0, 16.0);
	let mp = mana_bar(col, 0.4, look % 6);
	set_px(mp, 224.0, 16.0);
}
fn add_mid(col int, g int, mode int) {
	if mode == 3 {
		let map = minimap(col, 0);
		set_px(map, 224.0, 72.0);
		N[map].i3 = g;
		let inv = inventory(col, 4, 2, 0);
		set_px(inv, 224.0, 64.0);
		N[inv].i3 = g + 3;
	} else {
		let row = scr_row(col);
		var mw = 104;
		var iw = 112;
		var mh = 96;
		if mode == 1 { mw = 144; iw = 72; mh = 80; }
		if mode == 2 { mw = 72; iw = 144; mh = 112; }
		if mode == 4 { mw = 96; iw = 120; mh = 96; }
		let map = minimap(row, 0);
		set_px(map, mw as f32, mh as f32);
		N[map].i3 = g;
		let inv = inventory(row, if mode == 2 { 4 } else { 3 }, 2, 0);
		set_px(inv, iw as f32, mh as f32);
		N[inv].i3 = g + 3;
	}
}
fn add_quest(col int, g int) {
	let q = quest_log(col, g);
	set_text(q, "Quests");
	set_px(q, 224.0, 56.0);
}
fn add_cool(col int, g int) {
	let c = cooldown_row(col, g);
	set_px(c, 224.0, 48.0);
}
fn add_feature(col int, g int, mode int) {
	let h = if mode == 1 { 64.0 } else if mode == 2 { 96.0 } else if mode == 3 { 72.0 } else if mode == 4 { 80.0 } else { 88.0 };
	if g == 7 || g == 9 || g == 19 {
		let ch = chart(col, g % 7, mode % 6);
		set_px(ch, 224.0, h);
	} else {
		let rad = radial(col, 6, g % 6, mode % 6);
		set_px(rad, 224.0, h);
		N[rad].i3 = g;
	}
}
fn add_talk(col int, g int, look int) {
	let d = dialogue(col, kit_talk(g), 40, look % 6);
	set_px(d, 224.0, 48.0);
}
fn add_nums(col int) {
	let row = scr_row(col);
	let a = damage_number(row, "128", 0); set_px(a, 64.0, 32.0);
	let b = damage_number(row, "256", 1); set_px(b, 64.0, 32.0);
	let c = damage_number(row, "+40", 2); set_px(c, 64.0, 32.0);
}
fn add_menu(col int) {
	let row = scr_row(col);
	let a = button(row, "Play", 0); set_px(a, 64.0, 32.0);
	let b = button(row, "Map", 2); set_px(b, 64.0, 32.0);
	let c = button(row, "Bag", 5); set_px(c, 64.0, 32.0);
}
fn add_flavor(col int, g int) {
	if g == 0 || g == 1 {
		let row = scr_row(col);
		let a = button(row, "C", 0); set_px(a, 32.0, 32.0);
		let b = button(row, "Q", 2); set_px(b, 32.0, 32.0);
		let c = button(row, "E", 4); set_px(c, 32.0, 32.0);
	} else if g == 2 {
		let row = scr_row(col);
		let a = button(row, "Q", 0); set_px(a, 32.0, 32.0);
		let b = button(row, "W", 0); set_px(b, 32.0, 32.0);
		let c = button(row, "E", 0); set_px(c, 32.0, 32.0);
		let d = button(row, "R", 4); set_px(d, 32.0, 32.0);
	} else if g == 8 {
		let row = scr_row(col);
		let a = button(row, "P1", 0); set_px(a, 64.0, 32.0);
		let b = button(row, "P2", 1); set_px(b, 64.0, 32.0);
	} else if g == 12 {
		let a = button(col, "Strike", 0); set_px(a, 224.0, 32.0);
		let b = button(col, "Block", 2); set_px(b, 224.0, 32.0);
	} else if g == 18 {
		let a = button(col, "Seeds", 0); set_px(a, 224.0, 32.0);
	} else if g == 23 {
		let a = button(col, "Pull", 0); set_px(a, 224.0, 32.0);
	}
}

fn rich_column(parent int, g int, mode int) int {
	let col = flex(parent, DIR_COL);
	set_w(col, 240.0);
	set_gap(col, 8.0);
	set_pad(col, 8.0);
	let look = mode % 6;
	if mode == 0 {
		add_title(col, g, look); add_boss(col, g); add_buff(col, g); add_bars(col, look);
		add_mid(col, g, mode); add_quest(col, g); add_cool(col, g); add_feature(col, g, mode);
		add_talk(col, g, look); add_nums(col); add_menu(col); add_flavor(col, g);
	} else if mode == 1 {
		add_title(col, g, 5); add_mid(col, g, mode); add_boss(col, g); add_bars(col, 5);
		add_feature(col, g, mode); add_cool(col, g); add_quest(col, g); add_talk(col, g, 5);
		add_flavor(col, g); add_nums(col); add_menu(col); add_buff(col, g);
	} else if mode == 2 {
		add_menu(col); add_talk(col, g, 6); add_quest(col, g); add_mid(col, g, mode);
		add_title(col, g, 6); add_boss(col, g); add_bars(col, 0); add_cool(col, g);
		add_feature(col, g, mode); add_nums(col); add_buff(col, g); add_flavor(col, g);
	} else if mode == 3 {
		add_boss(col, g); add_bars(col, 2); add_cool(col, g); add_feature(col, g, mode);
		add_mid(col, g, mode); add_quest(col, g); add_talk(col, g, 2); add_nums(col);
		add_menu(col); add_title(col, g, 2); add_buff(col, g); add_flavor(col, g);
	} else {
		add_feature(col, g, mode); add_mid(col, g, mode); add_title(col, g, 4);
		add_talk(col, g, 4); add_quest(col, g); add_boss(col, g); add_bars(col, 4);
		add_buff(col, g); add_cool(col, g); add_nums(col); add_menu(col); add_flavor(col, g);
	}
	col
}

fn rich_app(parent int, g int, mode int) int {
	let col = flex(parent, DIR_COL);
	set_w(col, 480.0);
	set_gap(col, 8.0);
	set_pad(col, 8.0);
	let title = button(col, genre_name(g), mode % 6);
	set_px(title, 464.0, 32.0);
	if g == 33 {
		let a = text_field(col, "Email", 2); set_px(a, 464.0, 32.0);
		let b = text_field(col, "Password", 2); set_px(b, 464.0, 32.0);
		let c = button(col, "Sign in", 0); set_px(c, 200.0, 32.0);
	} else if g == 31 {
		let a = toggle(col, "Dark", 1, 0); set_px(a, 240.0, 32.0);
		let b = toggle(col, "Motion", 0, 2); set_px(b, 240.0, 32.0);
		let cp = color_picker(col, 0x3B6FE2, 2); set_px(cp, 280.0, 120.0);
		N[cp].i1 = 200; N[cp].val = 0.75; N[cp].val2 = 0.9;
	} else if g == 28 {
		let a = message_bar(col, "On my way", 2); set_px(a, 280.0, 32.0);
		let b = message_bar(col, "See you", 0); set_px(b, 220.0, 32.0);
		let f = text_field(col, "Message", 2); set_px(f, 464.0, 32.0);
	} else if g == 36 {
		let row = scr_row(col);
		let a = button(row, "M", 0); set_px(a, 32.0, 32.0);
		let b = button(row, "T", 2); set_px(b, 32.0, 32.0);
		let c = button(row, "W", 2); set_px(c, 32.0, 32.0);
		let d = button(row, "T", 2); set_px(d, 32.0, 32.0);
		let e = button(row, "F", 2); set_px(e, 32.0, 32.0);
	} else if g == 38 {
		let map = minimap(col, 0); set_px(map, 464.0, 160.0); N[map].i3 = 4;
		let f = text_field(col, "Search", 2); set_px(f, 464.0, 32.0);
	} else if g == 37 {
		let row = scr_row(col);
		let a = card(row, "To", 2); set_px(a, 144.0, 80.0);
		let b = card(row, "Now", 0); set_px(b, 144.0, 80.0);
		let c = card(row, "End", 1); set_px(c, 144.0, 80.0);
	} else {
		if mode == 1 {
			let tb = table(col, 4, 2, 0); set_px(tb, 464.0, 128.0);
			table_set(tb, 0, 0, "Ada"); table_set(tb, 0, 1, "12");
			table_set(tb, 1, 0, "Bea"); table_set(tb, 1, 1, "9");
			table_set(tb, 2, 0, "Cal"); table_set(tb, 2, 1, "4");
			table_set(tb, 3, 0, "Dee"); table_set(tb, 3, 1, "7");
			table_filter(tb, "a"); table_pin(tb, 1); table_resize(tb, 0, 160.0);
			let ch = chart(col, g % 7, 0); set_px(ch, 464.0, 112.0);
		} else if mode == 2 {
			let row = scr_row(col);
			let a = card(row, "One", 0); set_px(a, 144.0, 64.0);
			let b = card(row, "Two", 2); set_px(b, 144.0, 64.0);
			let c = card(row, "Net", 4); set_px(c, 144.0, 64.0);
			let ch = chart(col, 0, 0); set_px(ch, 464.0, 112.0);
			let tb = table(col, 4, 2, 0); set_px(tb, 464.0, 96.0);
			table_set(tb, 0, 0, "Ada"); table_set(tb, 0, 1, "12");
			table_set(tb, 1, 0, "Bea"); table_set(tb, 1, 1, "9");
			table_filter(tb, "a"); table_pin(tb, 1);
		} else {
			let ch = chart(col, g % 7, mode % 6); set_px(ch, 464.0, 112.0);
			let tb = table(col, 4, 2, 0); set_px(tb, 464.0, 128.0);
			table_set(tb, 0, 0, "Ada"); table_set(tb, 0, 1, "12");
			table_set(tb, 1, 0, "Bea"); table_set(tb, 1, 1, "9");
			table_set(tb, 2, 0, "Cal"); table_set(tb, 2, 1, "4");
			table_set(tb, 3, 0, "Dee"); table_set(tb, 3, 1, "7");
			table_filter(tb, "a"); table_pin(tb, 1); table_resize(tb, 0, 160.0);
		}
	}
	if g == 26 || g == 34 { let buy = button(col, "Buy", 0); set_px(buy, 120.0, 32.0); }
	if g == 32 {
		let row = scr_row(col);
		let a = badge(row, "1", 0); set_px(a, 32.0, 32.0);
		let b = badge(row, "2", 1); set_px(b, 32.0, 32.0);
		let c = badge(row, "3", 2); set_px(c, 32.0, 32.0);
	}
	col
}

fn sub_line(g int) const byte[:] {
	if g == 0 { return "Tactical"; }
	if g == 1 { return "Squad"; }
	if g == 2 { return "Rift"; }
	if g == 3 { return "Command"; }
	if g == 4 { return "Tales"; }
	if g == 5 { return "Ash"; }
	if g == 6 { return "Realm"; }
	if g == 7 { return "Grid"; }
	if g == 8 { return "Versus"; }
	if g == 9 { return "Match"; }
	if g == 10 { return "Peak"; }
	if g == 11 { return "Escape"; }
	if g == 12 { return "Climb"; }
	if g == 13 { return "Camp"; }
	if g == 14 { return "Budget"; }
	if g == 15 { return "Hunt"; }
	if g == 16 { return "Hull"; }
	if g == 17 { return "Party"; }
	if g == 18 { return "Farm"; }
	if g == 19 { return "Beat"; }
	if g == 20 { return "Lock"; }
	if g == 21 { return "Scene"; }
	if g == 22 { return "Idle"; }
	"Banner"
}

fn shop_item(g int, i int) const byte[:] {
	if g == 0 || g == 1 {
		if i == 0 { return "Rifle 29"; }
		if i == 1 { return "Vest 10"; }
		if i == 2 { return "Ghost"; }
		return "Sheriff";
	}
	if g == 2 {
		if i == 0 { return "Boots"; }
		if i == 1 { return "Tome"; }
		if i == 2 { return "Gold"; }
		return "Ward";
	}
	if g == 3 {
		if i == 0 { return "Depot"; }
		if i == 1 { return "Barracks"; }
		if i == 2 { return "Supply"; }
		return "Refinery";
	}
	if g == 5 {
		if i == 0 { return "Flask"; }
		if i == 1 { return "Rune"; }
		if i == 2 { return "Gem"; }
		return "Ash";
	}
	if g == 7 {
		if i == 0 { return "Aero"; }
		if i == 1 { return "Grip"; }
		if i == 2 { return "Fuel"; }
		return "Turbo";
	}
	if g == 12 {
		if i == 0 { return "Strike"; }
		if i == 1 { return "Defend"; }
		if i == 2 { return "Relic"; }
		return "Skip";
	}
	if g == 17 || g == 23 {
		if i == 0 { return "Banner"; }
		if i == 1 { return "Pull x1"; }
		if i == 2 { return "Pull x10"; }
		return "Pity 12";
	}
	if g == 18 {
		if i == 0 { return "Seeds"; }
		if i == 1 { return "Milk"; }
		if i == 2 { return "Wood"; }
		return "Buy";
	}
	if i == 0 { return "Blade"; }
	if i == 1 { return "Potion"; }
	if i == 2 { return "Key"; }
	return "Map";
}

fn wide(col int, text const byte[:], look int, h f32) {
	let b = button(col, text, look);
	set_px(b, 224.0, h);
}
fn half_row(col int, a const byte[:], b const byte[:], look int) {
	let row = scr_row(col);
	let x = button(row, a, look); set_px(x, 108.0, 32.0);
	let y = button(row, b, look); set_px(y, 108.0, 32.0);
}

fn screen_title_real(col int, g int, mode int) {
	if mode == 1 {
		wide(col, "Play", 0, 32.0);
		wide(col, genre_name(g), mode, 40.0);
		wide(col, sub_line(g), 2, 32.0);
	} else if mode == 3 {
		wide(col, genre_name(g), mode, 40.0);
		half_row(col, "Play", "Load", 0);
		wide(col, sub_line(g), 2, 32.0);
	} else if mode == 4 {
		half_row(col, "Play", "Opts", 0);
		wide(col, genre_name(g), mode, 48.0);
		wide(col, sub_line(g), 5, 32.0);
	} else {
		wide(col, genre_name(g), mode, 48.0);
		wide(col, sub_line(g), 2, 32.0);
		wide(col, "Play", 0, 32.0);
		if mode == 2 { wide(col, "Load", 5, 32.0); }
	}
}

fn screen_pause_real(col int, g int, mode int) {
	let extra = if g == 1 { "Leave" } else if g == 14 { "Budget" } else if g == 21 { "Save" } else { "Quit" };
	if mode == 1 {
		wide(col, extra, 5, 32.0);
		wide(col, "Options", 2, 32.0);
		wide(col, "Resume", 0, 32.0);
	} else if mode == 2 {
		wide(col, "Resume", 0, 40.0);
		let s = slider(col, 0.6, 0); set_px(s, 224.0, 24.0);
		wide(col, "Options", 2, 32.0);
		wide(col, extra, 5, 32.0);
	} else if mode == 4 {
		half_row(col, "Resume", extra, 0);
		wide(col, "Options", 2, 32.0);
	} else {
		wide(col, "Resume", 0, 32.0);
		wide(col, "Options", 2, 32.0);
		wide(col, extra, 5, 32.0);
		if mode == 3 { wide(col, sub_line(g), 1, 32.0); }
	}
}

fn screen_settings_real(col int, g int, mode int) {
	let a = if g == 0 { "Aim" } else if g == 7 { "ABS" } else if g == 19 { "Offset" } else { "Sound" };
	let b = if g == 0 { "Voice" } else if g == 21 { "Auto" } else { "Music" };
	if mode == 1 {
		let s = slider(col, 0.7, 0); set_px(s, 224.0, 24.0);
		let t = toggle(col, a, 1, 0); set_px(t, 224.0, 32.0);
		let u = toggle(col, b, 0, 2); set_px(u, 224.0, 32.0);
	} else if mode == 4 {
		let t = toggle(col, a, 1, 5); set_px(t, 224.0, 32.0);
		let u = toggle(col, b, 1, 5); set_px(u, 224.0, 32.0);
		wide(col, "Apply", 0, 32.0);
	} else {
		let t = toggle(col, a, 1, mode % 6); set_px(t, 224.0, 32.0);
		let u = toggle(col, b, 0, 2); set_px(u, 224.0, 32.0);
		let s = slider(col, 0.55, 0); set_px(s, 224.0, 24.0);
		if mode == 2 { wide(col, "Apply", 0, 32.0); }
	}
}

fn screen_shop_real(col int, g int, mode int) {
	if mode == 1 {
		half_row(col, shop_item(g, 0), shop_item(g, 1), 0);
		half_row(col, shop_item(g, 2), shop_item(g, 3), 2);
		wide(col, "Buy", 0, 32.0);
	} else if mode == 2 {
		wide(col, shop_item(g, 0), 0, 48.0);
		wide(col, shop_item(g, 1), 2, 32.0);
		wide(col, shop_item(g, 2), 2, 32.0);
		wide(col, shop_item(g, 3), 5, 32.0);
	} else if mode == 4 {
		wide(col, "Buy", 0, 32.0);
		wide(col, shop_item(g, 0), 1, 32.0);
		wide(col, shop_item(g, 1), 1, 32.0);
		wide(col, shop_item(g, 2), 1, 32.0);
		wide(col, shop_item(g, 3), 1, 32.0);
	} else {
		wide(col, shop_item(g, 0), mode % 6, 32.0);
		wide(col, shop_item(g, 1), 2, 32.0);
		wide(col, shop_item(g, 2), 2, 32.0);
		wide(col, shop_item(g, 3), 5, 32.0);
		if mode == 3 { wide(col, "Buy", 0, 32.0); }
	}
}

fn screen_map_real(col int, g int, mode int) {
	if g == 12 {
		if mode == 2 {
			wide(col, "Shop", 1, 32.0);
			wide(col, "Rest", 2, 32.0);
			wide(col, "Elite", 0, 32.0);
		} else {
			wide(col, "Elite", 0, 32.0);
			wide(col, "Rest", 2, 32.0);
			wide(col, "Shop", 1, 32.0);
		}
		let map = minimap(col, 0); set_px(map, 224.0, 96.0); N[map].i3 = g;
	} else if g == 18 {
		half_row(col, "Mon", "Tue", 2);
		half_row(col, "Wed", "Thu", 0);
		let map = minimap(col, 0); set_px(map, 224.0, if mode == 1 { 72.0 } else { 112.0 }); N[map].i3 = g;
	} else if g == 3 {
		let map = minimap(col, 0); set_px(map, 224.0, 96.0); N[map].i3 = g;
		half_row(col, "Move", "Atk", 0);
		wide(col, "Build", 2, 32.0);
	} else if mode == 1 {
		half_row(col, "Pin", "Mark", 0);
		let map = minimap(col, 0); set_px(map, 224.0, 128.0); N[map].i3 = g;
	} else if mode == 4 {
		let map = minimap(col, 0); set_px(map, 224.0, 160.0); N[map].i3 = g;
		wide(col, "Ping", 0, 32.0);
	} else {
		let map = minimap(col, 0); set_px(map, 224.0, 144.0); N[map].i3 = g;
		wide(col, sub_line(g), 2, 32.0);
	}
}

fn screen_results_real(col int, g int, mode int) {
	if g == 8 {
		let a = health_bar(col, 0.8, 0); set_px(a, 224.0, 16.0);
		let t = label(col, "59", 4); set_px(t, 224.0, 24.0);
		let b = health_bar(col, 0.2, 1); set_px(b, 224.0, 16.0);
		wide(col, "KO", 0, 40.0);
	} else if g == 7 {
		let t = label(col, "1:12.4", 4); set_px(t, 224.0, 24.0);
		wide(col, "1st", 0, 32.0);
		wide(col, "2nd", 2, 32.0);
		wide(col, "3rd", 5, 32.0);
	} else if g == 5 || g == 15 {
		wide(col, "DIED", 5, 48.0);
		wide(col, "Again", 0, 32.0);
		let hp = health_bar(col, 0.0, 0); set_px(hp, 224.0, 16.0);
	} else if g == 23 || g == 17 {
		wide(col, "SSR", 0, 48.0);
		wide(col, "5 star", 4, 32.0);
		wide(col, "Pity 12", 2, 32.0);
	} else if mode == 2 {
		wide(col, "1st", 0, 32.0);
		wide(col, "2nd", 2, 32.0);
		wide(col, "3rd", 5, 32.0);
		let t = label(col, "13 - 9", 7); set_px(t, 224.0, 16.0);
	} else {
		wide(col, if g == 0 { "WIN" } else if g == 1 { "Place 3" } else if g == 19 { "RANK S" } else { "CLEAR" }, 0, 48.0);
		let t = label(col, if g == 0 { "13 - 9" } else if g == 4 { "XP 240" } else { "Reward" }, 7);
		set_px(t, 224.0, 16.0);
		wide(col, "Again", 2, 32.0);
	}
}

fn build_panel(parent int, g int, screen int, mode int) int {
	if g == 0 || g == 2 { return build_stage(parent, g, screen, mode); }
	if screen == 3 { return rich_column(parent, g, mode); }
	let col = flex(parent, DIR_COL);
	set_w(col, 240.0);
	set_gap(col, 8.0);
	set_pad(col, 8.0);
	if screen == 0 { screen_title_real(col, g, mode); }
	else if screen == 1 { screen_pause_real(col, g, mode); }
	else if screen == 2 { screen_settings_real(col, g, mode); }
	else if screen == 4 { screen_shop_real(col, g, mode); }
	else if screen == 5 { screen_map_real(col, g, mode); }
	else { screen_results_real(col, g, mode); }
	col
}

fn min_screen(g int, screen int) int {
	if g == 0 || g == 2 {
		if screen == 3 { return 14; }
		if screen == 0 { return 7; }
		return 4;
	}
	if screen == 3 { return min_leaves(g); }
	if screen == 4 { return 4; }
	if screen == 5 { return 2; }
	3
}

fn screen_title(col int, g int) {
	if g == 0 || g == 1 { scr_lab(col, "STRIKE"); scr_btn(col, "Play", 0); scr_btn(col, "Range", 2); }
	else if g == 2 { scr_lab(col, "RIFT"); scr_btn(col, "Find", 0); scr_btn(col, "Train", 2); }
	else if g == 3 { scr_lab(col, "COMMAND"); scr_btn(col, "Skirmish", 0); }
	else if g == 4 || g == 17 { scr_lab(col, "TALES"); scr_btn(col, "New", 0); scr_btn(col, "Load", 2); }
	else if g == 5 || g == 15 { scr_lab(col, "ASH"); scr_btn(col, "Enter", 0); }
	else if g == 6 { scr_lab(col, "REALM"); scr_btn(col, "Login", 0); }
	else if g == 7 { scr_lab(col, "GRID"); scr_btn(col, "Race", 0); }
	else if g == 8 { scr_lab(col, "VERSUS"); scr_btn(col, "Fight", 0); }
	else if g == 9 { scr_lab(col, "MATCH"); scr_btn(col, "Kick", 0); }
	else if g == 10 { scr_lab(col, "PEAK"); scr_btn(col, "Start", 0); }
	else if g == 11 { scr_lab(col, "RUN"); scr_btn(col, "Escape", 0); }
	else if g == 12 { scr_lab(col, "DECK"); scr_btn(col, "Climb", 0); }
	else if g == 13 { scr_lab(col, "CAMP"); scr_btn(col, "Survive", 0); }
	else if g == 14 { scr_lab(col, "CITY"); scr_btn(col, "Build", 0); }
	else if g == 16 { scr_lab(col, "HULL"); scr_btn(col, "Launch", 0); }
	else if g == 18 { scr_lab(col, "FARM"); scr_btn(col, "Morning", 0); }
	else if g == 19 { scr_lab(col, "BEAT"); scr_btn(col, "Play", 0); }
	else if g == 20 { scr_lab(col, "LOCK"); scr_btn(col, "Solve", 0); }
	else if g == 21 { scr_lab(col, "SCENE"); scr_btn(col, "Start", 0); scr_btn(col, "Load", 2); }
	else if g == 22 { scr_lab(col, "IDLE"); scr_btn(col, "Tap", 0); }
	else { scr_lab(col, "BANNER"); scr_btn(col, "Summon", 0); }
}

fn screen_pause(col int, g int) {
	if g == 8 { scr_lab(col, "PAUSE"); scr_btn(col, "Resume", 0); scr_btn(col, "Training", 2); }
	else if g == 21 { scr_lab(col, "LOG"); scr_btn(col, "Back", 0); scr_btn(col, "Save", 2); }
	else if g == 14 { scr_lab(col, "MENU"); scr_btn(col, "Resume", 0); scr_btn(col, "Budget", 2); }
	else { scr_lab(col, "PAUSE"); scr_btn(col, "Resume", 0); scr_btn(col, "Options", 2); scr_btn(col, "Quit", 5); }
}

fn screen_settings(col int, g int) {
	scr_lab(col, "OPTIONS");
	if g == 0 || g == 1 { let a = toggle(col, "Aim", 1, 0); set_px(a, 160.0, 32.0); let b = toggle(col, "Voice", 0, 2); set_px(b, 160.0, 32.0); }
	else if g == 7 { let a = toggle(col, "ABS", 1, 0); set_px(a, 160.0, 32.0); let b = slider(col, 0.4, 0); set_px(b, 160.0, 24.0); }
	else if g == 19 { let a = slider(col, 0.7, 0); set_px(a, 160.0, 24.0); scr_lab(col, "Offset"); }
	else if g == 21 { let a = toggle(col, "Auto", 1, 0); set_px(a, 160.0, 32.0); scr_lab(col, "Text"); }
	else { let a = toggle(col, "Sound", 1, 0); set_px(a, 160.0, 32.0); let b = slider(col, 0.6, 2); set_px(b, 160.0, 24.0); }
}

