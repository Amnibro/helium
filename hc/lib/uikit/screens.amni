// One layout per genre screen. Not a recolored copy of the FPS kit.
namespace uikit;
import uikit.widgets;
import uikit.core;

fn scr_col(parent int) int {
	let c = flex(parent, DIR_COL);
	set_w(c, 176.0);
	set_gap(c, 8.0);
	set_pad(c, 8.0);
	c
}
fn scr_btn(col int, text const byte[:], look int) int {
	let b = button(col, text, look);
	set_px(b, 160.0, 32.0);
	b
}
fn scr_lab(col int, text const byte[:]) int {
	let l = label(col, text, 7);
	set_px(l, 160.0, 16.0);
	l
}
fn scr_row(col int) int {
	let r = flex(col, DIR_ROW);
	set_gap(r, 8.0);
	r
}

fn screen_title(col int, g int) {
	if g == 0 || g == 1 { scr_lab(col, "STRIKE"); scr_btn(col, "Play", 0); scr_btn(col, "Range", 2); }
	else if g == 2 { scr_lab(col, "RIFT"); scr_btn(col, "Find", 0); scr_btn(col, "Train", 2); }
	else if g == 3 { scr_lab(col, "COMMAND"); scr_btn(col, "Skirmish", 0); }
	else if g == 4 || g == 17 { scr_lab(col, "TALES"); scr_btn(col, "New", 0); scr_btn(col, "Load", 2); }
	else if g == 5 || g == 15 { scr_lab(col, "ASH"); scr_btn(col, "Enter", 0); }
	else if g == 6 { scr_lab(col, "REALM"); scr_btn(col, "Login", 0); }
	else if g == 7 { scr_lab(col, "GRID"); scr_btn(col, "Race", 0); }
	else if g == 8 { scr_lab(col, "VERSUS"); scr_btn(col, "Fight", 0); }
	else if g == 9 { scr_lab(col, "MATCH"); scr_btn(col, "Kick", 0); }
	else if g == 10 { scr_lab(col, "PEAK"); scr_btn(col, "Start", 0); }
	else if g == 11 { scr_lab(col, "RUN"); scr_btn(col, "Escape", 0); }
	else if g == 12 { scr_lab(col, "DECK"); scr_btn(col, "Climb", 0); }
	else if g == 13 { scr_lab(col, "CAMP"); scr_btn(col, "Survive", 0); }
	else if g == 14 { scr_lab(col, "CITY"); scr_btn(col, "Build", 0); }
	else if g == 16 { scr_lab(col, "HULL"); scr_btn(col, "Launch", 0); }
	else if g == 18 { scr_lab(col, "FARM"); scr_btn(col, "Morning", 0); }
	else if g == 19 { scr_lab(col, "BEAT"); scr_btn(col, "Play", 0); }
	else if g == 20 { scr_lab(col, "LOCK"); scr_btn(col, "Solve", 0); }
	else if g == 21 { scr_lab(col, "SCENE"); scr_btn(col, "Start", 0); scr_btn(col, "Load", 2); }
	else if g == 22 { scr_lab(col, "IDLE"); scr_btn(col, "Tap", 0); }
	else { scr_lab(col, "BANNER"); scr_btn(col, "Summon", 0); }
}

fn screen_pause(col int, g int) {
	if g == 8 { scr_lab(col, "PAUSE"); scr_btn(col, "Resume", 0); scr_btn(col, "Training", 2); }
	else if g == 21 { scr_lab(col, "LOG"); scr_btn(col, "Back", 0); scr_btn(col, "Save", 2); }
	else if g == 14 { scr_lab(col, "MENU"); scr_btn(col, "Resume", 0); scr_btn(col, "Budget", 2); }
	else { scr_lab(col, "PAUSE"); scr_btn(col, "Resume", 0); scr_btn(col, "Options", 2); scr_btn(col, "Quit", 5); }
}

fn screen_settings(col int, g int) {
	scr_lab(col, "OPTIONS");
	if g == 0 || g == 1 { let a = toggle(col, "Aim", 1, 0); set_px(a, 160.0, 32.0); let b = toggle(col, "Voice", 0, 2); set_px(b, 160.0, 32.0); }
	else if g == 7 { let a = toggle(col, "ABS", 1, 0); set_px(a, 160.0, 32.0); let b = slider(col, 0.4, 0); set_px(b, 160.0, 24.0); }
	else if g == 19 { let a = slider(col, 0.7, 0); set_px(a, 160.0, 24.0); scr_lab(col, "Offset"); }
	else if g == 21 { let a = toggle(col, "Auto", 1, 0); set_px(a, 160.0, 32.0); scr_lab(col, "Text"); }
	else { let a = toggle(col, "Sound", 1, 0); set_px(a, 160.0, 32.0); let b = slider(col, 0.6, 2); set_px(b, 160.0, 24.0); }
}

fn screen_hud(col int, g int) {
	if g == 0 {
		let row = scr_row(col);
		let map = minimap(row, 0); set_px(map, 72.0, 72.0);
		let side = flex(row, DIR_COL);
		let ammo = button(side, "24", 5); set_px(ammo, 48.0, 24.0);
		let hpnum = button(side, "90", 2); set_px(hpnum, 48.0, 24.0);
		let hp = health_bar(col, 0.7, 0); set_px(hp, 160.0, 16.0);
		let nums = scr_row(col);
		let d0 = damage_number(nums, "128", 0); set_px(d0, 48.0, 32.0);
		let d1 = damage_number(nums, "256", 1); set_px(d1, 48.0, 32.0);
		let ab = scr_row(col);
		let q = button(ab, "C", 0); set_px(q, 36.0, 32.0);
		let w = button(ab, "Q", 2); set_px(w, 36.0, 32.0);
		let e = button(ab, "E", 2); set_px(e, 36.0, 32.0);
	} else if g == 1 {
		let hp = health_bar(col, 0.8, 0); set_px(hp, 160.0, 16.0);
		let sh = mana_bar(col, 0.5, 1); set_px(sh, 160.0, 16.0);
		scr_lab(col, "Squad 3");
		let map = minimap(col, 0); set_px(map, 160.0, 72.0);
	} else if g == 2 {
		scr_lab(col, "12   8");
		scr_lab(col, "18:20");
		let hp = health_bar(col, 0.66, 0); set_px(hp, 160.0, 16.0);
		let mp = mana_bar(col, 0.4, 0); set_px(mp, 160.0, 16.0);
		let ab = scr_row(col);
		let q = button(ab, "Q", 0); set_px(q, 32.0, 32.0);
		let w = button(ab, "W", 0); set_px(w, 32.0, 32.0);
		let e = button(ab, "E", 0); set_px(e, 32.0, 32.0);
		let r = button(ab, "R", 4); set_px(r, 32.0, 32.0);
		let map = minimap(col, 0); set_px(map, 80.0, 64.0);
	} else if g == 3 {
		scr_lab(col, "Min 480");
		let map = minimap(col, 0); set_px(map, 160.0, 64.0);
		let ab = scr_row(col);
		let a = button(ab, "A", 2); set_px(a, 36.0, 24.0);
		let b = button(ab, "M", 2); set_px(b, 36.0, 24.0);
		let c = button(ab, "B", 0); set_px(c, 36.0, 24.0);
	} else if g == 4 {
		let a = health_bar(col, 0.9, 0); set_px(a, 160.0, 16.0);
		let b = health_bar(col, 0.4, 1); set_px(b, 160.0, 16.0);
		let c = mana_bar(col, 0.7, 0); set_px(c, 160.0, 16.0);
		scr_btn(col, "Attack", 0);
		scr_btn(col, "Magic", 2);
		let d = dialogue(col, "Hold.", 8, 0); set_px(d, 160.0, 36.0);
	} else if g == 5 {
		let hp = health_bar(col, 0.55, 5); set_px(hp, 160.0, 8.0);
		let st = mana_bar(col, 0.8, 5); set_px(st, 160.0, 8.0);
		scr_lab(col, "Flask 4");
	} else if g == 6 {
		scr_lab(col, "You");
		let hp = health_bar(col, 0.77, 0); set_px(hp, 160.0, 16.0);
		scr_lab(col, "Wolf");
		let th = health_bar(col, 0.3, 1); set_px(th, 160.0, 8.0);
		scr_lab(col, "Quest");
	} else if g == 7 {
		scr_lab(col, "187");
		scr_lab(col, "P1  Lap 2");
		let map = minimap(col, 0); set_px(map, 160.0, 56.0);
	} else if g == 8 {
		scr_lab(col, "P1");
		let a = health_bar(col, 0.8, 0); set_px(a, 160.0, 16.0);
		scr_lab(col, "59");
		scr_lab(col, "P2");
		let b = health_bar(col, 0.45, 1); set_px(b, 160.0, 16.0);
	} else if g == 9 {
		scr_lab(col, "1 - 0");
		scr_lab(col, "64 min");
		let map = minimap(col, 0); set_px(map, 100.0, 64.0);
	} else if g == 10 {
		scr_lab(col, "Hearts 3");
		let hp = health_bar(col, 0.6, 0); set_px(hp, 120.0, 16.0);
	} else if g == 11 {
		let hp = health_bar(col, 0.5, 0); set_px(hp, 160.0, 16.0);
		scr_lab(col, "Boon");
		let row = scr_row(col);
		let a = button(row, "Z", 0); set_px(a, 32.0, 32.0);
		let b = button(row, "D", 4); set_px(b, 32.0, 32.0);
	} else if g == 12 {
		scr_lab(col, "Slime 42");
		let hp = health_bar(col, 0.62, 1); set_px(hp, 160.0, 16.0);
		scr_lab(col, "Energy 3");
		scr_btn(col, "Strike", 0);
		scr_btn(col, "Block", 2);
		scr_lab(col, "Draw 5");
	} else if g == 13 {
		let hp = health_bar(col, 0.7, 0); set_px(hp, 160.0, 8.0);
		let food = mana_bar(col, 0.4, 2); set_px(food, 160.0, 8.0);
		let row = scr_row(col);
		let a = button(row, "1", 2); set_px(a, 28.0, 24.0);
		let b = button(row, "2", 0); set_px(b, 28.0, 24.0);
		let c = button(row, "3", 2); set_px(c, 28.0, 24.0);
	} else if g == 14 {
		scr_lab(col, "12,400");
		let r = progress(col, 0.7, 0); set_px(r, 160.0, 16.0);
		let c = progress(col, 0.3, 1); set_px(c, 160.0, 16.0);
		let i = progress(col, 0.5, 2); set_px(i, 160.0, 16.0);
		scr_btn(col, "Zone", 0);
	} else if g == 15 {
		scr_lab(col, "Gen 3/5");
		let g1 = progress(col, 0.8, 1); set_px(g1, 160.0, 16.0);
		let hp = health_bar(col, 0.35, 0); set_px(hp, 160.0, 8.0);
		scr_lab(col, "Run");
	} else if g == 16 {
		scr_lab(col, "Hull 70");
		let hp = health_bar(col, 0.7, 0); set_px(hp, 160.0, 16.0);
		let sh = mana_bar(col, 0.9, 0); set_px(sh, 160.0, 8.0);
		scr_lab(col, "Scrap 18");
	} else if g == 17 {
		let hp = health_bar(col, 0.8, 0); set_px(hp, 160.0, 16.0);
		let row = scr_row(col);
		let e = button(row, "E", 0); set_px(e, 36.0, 32.0);
		let q = button(row, "Q", 4); set_px(q, 36.0, 32.0);
		scr_lab(col, "Party");
	} else if g == 18 {
		scr_lab(col, "6:00am");
		scr_lab(col, "1,240g");
		let en = progress(col, 0.55, 2); set_px(en, 160.0, 16.0);
		let row = scr_row(col);
		let a = button(row, "Ax", 2); set_px(a, 36.0, 24.0);
		let b = button(row, "Rod", 0); set_px(b, 48.0, 24.0);
	} else if g == 19 {
		scr_lab(col, "Combo 42");
		let row = scr_row(col);
		let a = button(row, "A", 0); set_px(a, 36.0, 28.0);
		let s = button(row, "S", 0); set_px(s, 36.0, 28.0);
		let d = button(row, "D", 4); set_px(d, 36.0, 28.0);
	} else if g == 20 {
		scr_lab(col, "Score 1200");
		let grid = inventory(col, 4, 4, 2); set_px(grid, 120.0, 100.0);
	} else if g == 21 {
		scr_lab(col, "Mira");
		let d = dialogue(col, "Stay or go.", 20, 0); set_px(d, 160.0, 48.0);
		scr_btn(col, "Stay", 0);
		scr_btn(col, "Go", 2);
	} else if g == 22 {
		scr_lab(col, "1.2M");
		scr_btn(col, "Click", 0);
		scr_btn(col, "Farm", 2);
	} else {
		scr_lab(col, "Gems 1600");
		scr_btn(col, "Banner", 0);
		scr_btn(col, "Pull", 4);
	}
}

fn screen_bag(col int, g int) {
	if g == 0 || g == 1 { scr_lab(col, "BUY"); scr_lab(col, "Rifle 29"); scr_lab(col, "Vest 10"); scr_btn(col, "Buy", 0); }
	else if g == 2 { scr_lab(col, "SHOP"); scr_lab(col, "Gold 1350"); scr_btn(col, "Boots", 0); scr_btn(col, "Tome", 2); }
	else if g == 12 { scr_lab(col, "REWARD"); scr_btn(col, "Strike", 0); scr_btn(col, "Defend", 2); scr_btn(col, "Skip", 5); }
	else if g == 18 { scr_lab(col, "STORE"); scr_lab(col, "Seeds 20"); scr_btn(col, "Buy", 0); }
	else if g == 22 { scr_lab(col, "UPGRADE"); scr_btn(col, "Oven", 0); scr_lab(col, "Cost 50"); }
	else if g == 23 { scr_lab(col, "PULL"); scr_lab(col, "Pity 12"); scr_btn(col, "x10", 0); }
	else if g == 14 { scr_lab(col, "BUDGET"); scr_lab(col, "Road 400"); scr_btn(col, "Fund", 0); }
	else {
		scr_lab(col, "BAG");
		let inv = inventory(col, 4, 3, 0); set_px(inv, 160.0, 100.0); N[inv].i3 = g + 2;
	}
}

fn screen_map(col int, g int) {
	if g == 12 { scr_lab(col, "PATH"); scr_btn(col, "Elite", 0); scr_btn(col, "Rest", 2); scr_btn(col, "Shop", 1); }
	else if g == 20 { scr_lab(col, "BOARD"); let inv = inventory(col, 4, 4, 2); set_px(inv, 140.0, 120.0); }
	else if g == 14 { scr_lab(col, "CITY"); let map = minimap(col, 0); set_px(map, 160.0, 120.0); }
	else if g == 21 { scr_lab(col, "GALLERY"); scr_btn(col, "Ch 1", 2); scr_btn(col, "Ch 2", 0); }
	else { scr_lab(col, "MAP"); let map = minimap(col, 0); set_px(map, 160.0, 140.0); N[map].i3 = g; }
}

fn screen_results(col int, g int) {
	if g == 0 { scr_lab(col, "WIN"); scr_lab(col, "13 - 9"); }
	else if g == 2 { scr_lab(col, "ACE"); scr_lab(col, "12 - 8"); }
	else if g == 1 { scr_lab(col, "Place 3"); scr_lab(col, "Kills 6"); }
	else if g == 5 || g == 15 { scr_lab(col, "DIED"); scr_btn(col, "Again", 0); }
	else if g == 7 { scr_lab(col, "Podium"); scr_lab(col, "1:12.4"); }
	else if g == 8 { scr_lab(col, "KO"); scr_lab(col, "P1"); }
	else if g == 9 { scr_lab(col, "FULL"); scr_lab(col, "2 - 1"); }
	else if g == 11 || g == 12 { scr_lab(col, "CLEAR"); scr_lab(col, "12:40"); }
	else if g == 19 { scr_lab(col, "RANK S"); scr_lab(col, "Combo 80"); }
	else if g == 22 { scr_lab(col, "PRESTIGE"); scr_lab(col, "x3"); }
	else if g == 23 { scr_lab(col, "SSR"); scr_lab(col, "5 star"); }
	else if g == 4 { scr_lab(col, "VICTORY"); scr_lab(col, "XP 240"); }
	else { scr_lab(col, "DONE"); scr_lab(col, "Reward"); }
}

fn build_screen(parent int, g int, screen int) int {
	let col = scr_col(parent);
	if screen == 0 { screen_title(col, g); }
	else if screen == 1 { screen_pause(col, g); }
	else if screen == 2 { screen_settings(col, g); }
	else if screen == 3 { screen_hud(col, g); }
	else if screen == 4 { screen_bag(col, g); }
	else if screen == 5 { screen_map(col, g); }
	else { screen_results(col, g); }
	col
}

fn app_page(parent int, g int) int {
	let col = flex(parent, DIR_COL);
	set_w(col, 520.0);
	set_gap(col, 8.0);
	set_pad(col, 8.0);
	if g == 24 {
		let row = flex(col, DIR_ROW); set_gap(row, 8.0);
		let a = card(row, "Users", 4); set_px(a, 160.0, 64.0);
		let b = card(row, "Sales", 0); set_px(b, 160.0, 64.0);
		let c = card(row, "Net", 2); set_px(c, 160.0, 64.0);
		let ch = chart(col, 0, 0); set_px(ch, 500.0, 112.0);
	} else if g == 25 || g == 26 || g == 39 {
		let f = text_field(col, "Filter", 2); set_px(f, 500.0, 32.0);
		let tb = table(col, 4, 2, 0); set_px(tb, 500.0, 128.0);
		table_set(tb, 0, 0, "Ada"); table_set(tb, 0, 1, "12");
		table_set(tb, 1, 0, "Bea"); table_set(tb, 1, 1, "9");
		table_set(tb, 2, 0, "Cal"); table_set(tb, 2, 1, "4");
		table_set(tb, 3, 0, "Dee"); table_set(tb, 3, 1, "7");
		table_filter(tb, "a"); table_pin(tb, 1); table_resize(tb, 0, 180.0);
		if g == 26 { let buy = button(col, "Buy", 0); set_px(buy, 120.0, 28.0); }
	} else if g == 27 {
		scr_lab(col, "Ada");
		let post = card(col, "Hello", 2); set_px(post, 500.0, 72.0);
		let like = button(col, "Like", 3); set_px(like, 80.0, 32.0);
	} else if g == 28 {
		let a = message_bar(col, "On my way", 2); set_px(a, 280.0, 32.0);
		let b = message_bar(col, "See you", 0); set_px(b, 220.0, 32.0);
		let f = text_field(col, "Message", 2); set_px(f, 500.0, 32.0);
	} else if g == 29 {
		scr_lab(col, "Track");
		let p = progress(col, 0.42, 0); set_px(p, 500.0, 16.0);
		let row = flex(col, DIR_ROW); set_gap(row, 8.0);
		let a = button(row, "Prev", 2); set_px(a, 80.0, 28.0);
		let b = button(row, "Play", 0); set_px(b, 80.0, 28.0);
		let c = button(row, "Next", 2); set_px(c, 80.0, 28.0);
	} else if g == 30 {
		scr_lab(col, "main.amni");
		scr_lab(col, "fn main");
		scr_lab(col, "print");
		let f = text_field(col, "Find", 2); set_px(f, 500.0, 28.0);
	} else if g == 31 {
		let a = toggle(col, "Dark", 1, 0); set_px(a, 240.0, 28.0);
		let b = toggle(col, "Motion", 0, 2); set_px(b, 240.0, 28.0);
		let cp = color_picker(col, 0x3B6FE2, 2); set_px(cp, 280.0, 120.0);
		N[cp].i1 = 200; N[cp].val = 0.75; N[cp].val2 = 0.9;
	} else if g == 32 {
		scr_lab(col, "Step 2");
		let row = flex(col, DIR_ROW); set_gap(row, 8.0);
		let a = badge(row, "1", 1); set_px(a, 36.0, 28.0);
		let b = badge(row, "2", 0); set_px(b, 36.0, 28.0);
		let c = badge(row, "3", 2); set_px(c, 36.0, 28.0);
		let n = button(col, "Next", 0); set_px(n, 120.0, 28.0);
	} else if g == 33 {
		let a = text_field(col, "Email", 2); set_px(a, 360.0, 32.0);
		let b = text_field(col, "Password", 2); set_px(b, 360.0, 32.0);
		let c = button(col, "Sign in", 0); set_px(c, 200.0, 32.0);
	} else if g == 34 {
		let row = flex(col, DIR_ROW); set_gap(row, 8.0);
		let a = card(row, "Free", 2); set_px(a, 152.0, 88.0);
		let b = card(row, "Pro", 0); set_px(b, 152.0, 88.0);
		let c = card(row, "Team", 4); set_px(c, 152.0, 88.0);
	} else if g == 35 {
		scr_lab(col, "Guide");
		scr_lab(col, "Install");
		scr_lab(col, "Themes");
		scr_lab(col, "Tokens");
	} else if g == 36 {
		let row = flex(col, DIR_ROW); set_gap(row, 8.0);
		let a = button(row, "M", 0); set_px(a, 36.0, 28.0);
		let b = button(row, "T", 2); set_px(b, 36.0, 28.0);
		let c = button(row, "W", 2); set_px(c, 36.0, 28.0);
		let d = button(row, "F", 2); set_px(d, 36.0, 28.0);
		scr_lab(col, "May");
	} else if g == 37 {
		let row = flex(col, DIR_ROW); set_gap(row, 8.0);
		let a = card(row, "To", 2); set_px(a, 152.0, 80.0);
		let b = card(row, "Now", 0); set_px(b, 152.0, 80.0);
		let c = card(row, "End", 1); set_px(c, 152.0, 80.0);
	} else if g == 38 {
		let f = text_field(col, "Search", 2); set_px(f, 500.0, 32.0);
		let map = minimap(col, 0); set_px(map, 500.0, 180.0);
		let pin = button(col, "Pin", 0); set_px(pin, 80.0, 28.0);
	} else {
		scr_lab(col, "Today");
		let a = progress(col, 0.7, 0); set_px(a, 500.0, 16.0);
		let b = progress(col, 0.4, 1); set_px(b, 500.0, 16.0);
		let c = progress(col, 0.55, 2); set_px(c, 500.0, 16.0);
		let ch = chart(col, 1, 0); set_px(ch, 500.0, 100.0);
	}
	col
}
