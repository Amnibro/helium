	var py f32 = 920.0;
	var cx f32 = 1560.0;
	var cy f32 = 700.0;
	var tx f32 = 80.0;
	var ty f32 = 160.0;
	if mode == 1 { cx = 80.0; cy = 200.0; tx = 1200.0; }
	else if mode == 2 { py = 980.0; cx = 1500.0; cy = 860.0; }
	else if mode == 3 { px = 80.0; py = 200.0; cx = 820.0; cy = 760.0; ty = 160.0; tx = 1200.0; }
	else if mode == 4 { tx = 80.0; ty = 200.0; cx = 1560.0; cy = 360.0; }
	if mode == 3 {
		let col = flex(f, DIR_COL);
		set_gap(col, 12.0);
		set_pad(col, 0.0);
		place_at(col, 80.0, 200.0, 280.0, 520.0);
		member(col, "Terra", "420");
		member(col, "Locke", "310");
		member(col, "Celes", "280");
		member(col, "Edgar", "190");
	} else {
		party_line(f, px, py);
	}
	cmd_menu(f, cx, cy);
	turn_row(f, tx, ty);
}

