// 16:9 stage layouts. Coordinates are a 1920x1080 design grid.
namespace uikit;
import uikit.widgets;
import uikit.core;

fn menu_n(g int) int {
	if g == 0 { return 5; }
	if g == 2 { return 5; }
	if g == 4 { return 4; }
	if g == 5 { return 3; }
	if g == 1 { return 5; }
	if g == 7 { return 4; }
	if g == 8 { return 4; }
	if g == 12 { return 4; }
	4
}
fn menu_at(g int, i int) const byte[:] {
	if g == 0 {
		if i == 0 { return "Play"; }
		if i == 1 { return "Loadout"; }
		if i == 2 { return "Range"; }
		if i == 3 { return "Options"; }
		return "Quit";
	}
	if g == 2 {
		if i == 0 { return "Play"; }
		if i == 1 { return "Practice"; }
		if i == 2 { return "Collection"; }
		if i == 3 { return "Options"; }
		return "Quit";
	}
	if g == 4 {
		if i == 0 { return "New Game"; }
		if i == 1 { return "Continue"; }
		if i == 2 { return "Extras"; }
		return "Config";
	}
	if g == 5 {
		if i == 0 { return "Continue"; }
		if i == 1 { return "New Game"; }
		return "Settings";
	}
	if g == 1 {
		if i == 0 { return "Drop"; }
		if i == 1 { return "Duos"; }
		if i == 2 { return "Squads"; }
		if i == 3 { return "Locker"; }
		return "Quit";
	}
	if g == 7 {
		if i == 0 { return "Race"; }
		if i == 1 { return "Career"; }
		if i == 2 { return "Garage"; }
		return "Options";
	}
	if g == 8 {
		if i == 0 { return "Versus"; }
		if i == 1 { return "Arcade"; }
		if i == 2 { return "Training"; }
		return "Options";
	}
	if g == 12 {
		if i == 0 { return "Climb"; }
		if i == 1 { return "Daily"; }
		if i == 2 { return "Collection"; }
		return "Options";
	}
	if i == 0 { return "Play"; }
	if i == 1 { return "Continue"; }
	if i == 2 { return "Options"; }
	"Quit"
}

fn stage_title(f int, g int, mode int) {
	var x f32 = 1420.0;
	var y f32 = 280.0;
	if mode == 1 { x = 760.0; y = 560.0; }
	else if mode == 2 { x = 96.0; y = 520.0; }
	else if mode == 3 { x = 760.0; y = 400.0; }
	else if mode == 4 { x = 96.0; y = 160.0; }
	let n = menu_n(g);
	let col = flex(f, DIR_COL);
	set_gap(col, 16.0);
	set_pad(col, 0.0);
	place_at(col, x, y, 400.0, 384.0);
	for i in n {
		let b = button(col, menu_at(g, i), if i == 0 { 0 } else { 2 });
		set_px(b, 400.0, 64.0);
		set_preset(b, 2);
	}
	var vx f32 = 80.0;
	var px f32 = 1420.0;
	if mode == 1 { vx = 80.0; px = 1420.0; }
	if mode == 2 || mode == 4 { vx = 1100.0; px = 1100.0; }
	let ver = label(f, "v1.04", 2);
	place_at(ver, vx, 1000.0, 280.0, 40.0);
	let go = label(f, "Press Start", 1);
	place_at(go, px, 920.0, 360.0, 48.0);
}

fn mark_anchor(id int) { N[id].flags = N[id].flags | FL_ANCHOR; }

fn kill_row(col int, killer const byte[:], kcol u32, icon int, victim const byte[:], vcol u32) {
	let row = flex(col, DIR_ROW);
	set_gap(row, 8.0);
	set_pad(row, 0.0);
	set_px(row, 212.0, 36.0);
	let a = label(row, killer, 3); set_px(a, 80.0, 36.0); N[a].fg = kcol;
	let ic = icon_button(row, icon, 3); set_px(ic, 36.0, 36.0);
	let b = label(row, victim, 3); set_px(b, 80.0, 36.0); N[b].fg = vcol;
}

fn feed_col(f int, x f32, y f32) {
	let col = card(f, "", 2);
	set_gap(col, 8.0);
	set_pad(col, 8.0);
	place_at(col, x, y, 228.0, 184.0);
	let ally = 0xD6ECFF as u32;
	let foe = 0xFFD0C2 as u32;
	kill_row(col, "You", ally, 77, "Ace", foe);
	kill_row(col, "Nova", foe, 0, "You", ally);
	kill_row(col, "You", ally, 16, "Hex", foe);
	kill_row(col, "Ace", foe, 74, "Kit", ally);
}

fn vitals(f int, x f32, y f32) {
	let heart = icon_button(f, 2, 3); place_at(heart, x, y, 36.0, 36.0);
	let hp = health_bar(f, 0.72, 0); place_at(hp, x + 44.0, y + 8.0, 220.0, 24.0);
	let hn = label(f, "144", 2); place_at(hn, x + 272.0, y + 4.0, 72.0, 32.0);
	let sh = icon_button(f, 1, 3); place_at(sh, x, y + 44.0, 36.0, 36.0);
	let arm = health_bar(f, 0.4, 2); place_at(arm, x + 44.0, y + 52.0, 220.0, 20.0);
	let sn = label(f, "80", 3); place_at(sn, x + 272.0, y + 44.0, 64.0, 28.0);
}

fn ammo_readout(f int, x f32, y f32) {
	let big = label(f, "24", 0); place_at(big, x, y, 72.0, 56.0);
	let slash = label(f, "/", 4); place_at(slash, x + 72.0, y + 20.0, 24.0, 28.0);
	let small = label(f, "90", 3); place_at(small, x + 96.0, y + 16.0, 56.0, 32.0);
}

fn objective_pip(f int, y f32) {
	let row = flex(f, DIR_ROW);
	set_gap(row, 8.0);
	set_pad(row, 0.0);
	place_at(row, 888.0, y, 144.0, 40.0);
	mark_anchor(row);
	let pip = icon_button(row, 75, 3); set_px(pip, 40.0, 40.0);
	let letter = label(row, "A", 2); set_px(letter, 32.0, 40.0); N[letter].i2 = 1;
	let dist = label(row, "32m", 3); set_px(dist, 56.0, 40.0); N[dist].i2 = 1;
}

fn prompt_center(f int, text const byte[:], y f32) {
	let lab = label(f, text, 2);
	place_at(lab, 840.0, y, 240.0, 40.0);
	mark_anchor(lab);
}

fn ability4(f int, x f32, y f32, s f32) {
	let gap = 16.0;
	let w = s * 4.0 + gap * 3.0;
	let row = flex(f, DIR_ROW);
	set_gap(row, gap);
	set_pad(row, 0.0);
	place_at(row, x, y, w, s);
	let a = icon_button(row, 77, 2); set_px(a, s, s);
	let b = icon_button(row, 16, 2); set_px(b, s, s);
	let c = icon_button(row, 1, 2); set_px(c, s, s);
	let d = icon_button(row, 4, 2); set_px(d, s, s);
}

fn stage_hud_fps(f int, mode int) {
	var mapx f32 = 48.0;
	var mapy f32 = 48.0;
	var maps f32 = 280.0;
	var fx f32 = 1500.0;
	var fy f32 = 48.0;
	var hx f32 = 48.0;
	var hy f32 = 900.0;
	var ax f32 = 1560.0;
	var ay f32 = 968.0;
	var wx f32 = 1464.0;
	var wy f32 = 968.0;
	var bx f32 = 792.0;
	var by f32 = 980.0;
	var bs f32 = 72.0;
	if mode == 1 {
		maps = 160.0;
		hx = 48.0; hy = 960.0;
		ax = 1640.0; ay = 980.0;
		wx = 1544.0; wy = 980.0;
		bx = 824.0; by = 992.0; bs = 56.0;
	} else if mode == 2 {
		maps = 200.0;
		hx = 520.0; hy = 960.0;
		ax = 1280.0; ay = 980.0;
		wx = 1560.0; wy = 968.0;
		bx = 900.0; by = 880.0;
	} else if mode == 3 {
		mapx = 96.0; mapy = 96.0;
		fx = 1460.0; fy = 96.0;
		hx = 96.0; hy = 880.0;
		ax = 1500.0; ay = 960.0;
		wx = 1400.0; wy = 952.0;
		bx = 760.0; by = 960.0;
	} else if mode == 4 {
		mapx = 1592.0; mapy = 48.0;
		fx = 48.0; fy = 48.0;
		hx = 1500.0; hy = 920.0;
		ax = 48.0; ay = 980.0;
		wx = 360.0; wy = 968.0;
		bx = 792.0; by = 980.0;
	}
	let map = minimap(f, 0);
	place_at(map, mapx, mapy, maps, maps);
	N[map].i3 = 0;
	feed_col(f, fx, fy);
	vitals(f, hx, hy);
	ammo_readout(f, ax, ay);
	let gun = icon_button(f, 78, 2);
	place_at(gun, wx, wy, 72.0, 72.0);
	ability4(f, bx, by, bs);
	let nade = icon_button(f, 79, 0);
	place_at(nade, 48.0, if mode == 4 { 800.0 } else { 400.0 }, 72.0, 72.0);
	prompt_center(f, "Hold F", 800.0);
	objective_pip(f, 48.0);
}

fn ability6(f int, x f32, y f32, s f32) {
	let gap = 12.0;
	let w = s * 6.0 + gap * 5.0;
	let row = flex(f, DIR_ROW);
	set_gap(row, gap);
	set_pad(row, 0.0);
	place_at(row, x, y, w, s);
	let q = icon_button(row, 0, 2); set_px(q, s, s);
	let wpn = icon_button(row, 16, 2); set_px(wpn, s, s);
	let e = icon_button(row, 1, 2); set_px(e, s, s);
	let r = icon_button(row, 15, 2); set_px(r, s, s);
	let d = icon_button(row, 4, 2); set_px(d, s, s);
	let fl = icon_button(row, 74, 2); set_px(fl, s, s);
}

fn stage_hud_moba(f int, mode int) {
	var px f32 = 48.0;
	var py f32 = 900.0;
	var mx f32 = 1572.0;
	var my f32 = 732.0;
	var ms f32 = 300.0;
	var ax f32 = 704.0;
	var ay f32 = 980.0;
	var asz f32 = 64.0;
	var sx f32 = 760.0;
	var sy f32 = 24.0;
	if mode == 1 { ms = 200.0; mx = 1672.0; my = 832.0; asz = 56.0; ax = 752.0; }
	else if mode == 2 { ay = 640.0; ax = 48.0; }
	else if mode == 3 { ms = 240.0; mx = 1632.0; my = 792.0; }
	else if mode == 4 { sx = 48.0; sy = 160.0; }
	let face = icon_button(f, 11, 0);
	place_at(face, px, py, 96.0, 96.0);
	let hp = health_bar(f, 0.66, 0);
	place_at(hp, px + 112.0, py + 16.0, 320.0, 24.0);
	let mp = mana_bar(f, 0.4, 0);
	place_at(mp, px + 112.0, py + 52.0, 320.0, 20.0);
	let gold = label(f, "2450 g", 2);
	place_at(gold, px, py - 48.0, 200.0, 36.0);
	let lv = label(f, "Lv 11", 2);
	place_at(lv, px + 240.0, py - 48.0, 160.0, 36.0);
	let map = minimap(f, 0);
	place_at(map, mx, my, ms, ms);
	N[map].i3 = 2;
	ability6(f, ax, ay, asz);
	let row = flex(f, DIR_ROW);
	set_gap(row, 16.0);
	set_pad(row, 0.0);
	place_at(row, sx, sy, 400.0, 48.0);
	let k = label(row, "4", 1); set_px(k, 80.0, 48.0);
	let t = label(row, "12:40", 1); set_px(t, 160.0, 48.0);
	let dth = label(row, "3", 1); set_px(dth, 80.0, 48.0);
	let items = flex(f, DIR_ROW);
	set_gap(items, 8.0);
	set_pad(items, 0.0);
	place_at(items, px, py - 112.0, 328.0, 48.0);
	let i0 = icon_button(items, 52, 2); set_px(i0, 48.0, 48.0);
	let i1 = icon_button(items, 43, 2); set_px(i1, 48.0, 48.0);
	let i2 = icon_button(items, 0, 2); set_px(i2, 48.0, 48.0);
	let i3 = icon_button(items, 4, 2); set_px(i3, 48.0, 48.0);
	let i4 = icon_button(items, 8, 2); set_px(i4, 48.0, 48.0);
	let i5 = icon_button(items, 13, 2); set_px(i5, 48.0, 48.0);
}

fn stage_pause(f int, g int, mode int) {
	var x f32 = 680.0;
	var y f32 = 220.0;
	var w f32 = 560.0;
	if mode == 1 { x = 80.0; y = 180.0; }
	else if mode == 2 { x = 1280.0; y = 180.0; }
	else if mode == 3 { x = 360.0; y = 640.0; w = 1200.0; }
	else if mode == 4 { x = 680.0; y = 80.0; }
	let col = flex(f, DIR_COL);
	set_gap(col, 16.0);
	set_pad(col, 0.0);
	if mode == 3 {
		place_at(col, x, y, w, 80.0);
		set_dir(col, DIR_ROW);
		let a = button(col, "Resume", 0); set_px(a, 280.0, 64.0); set_preset(a, 2);
		let b = button(col, "Options", 2); set_px(b, 280.0, 64.0); set_preset(b, 2);
		let c = button(col, if g == 2 { "Surrender" } else { "Loadout" }, 2); set_px(c, 280.0, 64.0); set_preset(c, 2);
		let d = button(col, "Quit", 5); set_px(d, 280.0, 64.0); set_preset(d, 2);
	} else {
		place_at(col, x, y, w, 400.0);
		let t = label(col, "Paused", 0); set_px(t, w, 56.0);
		let a = button(col, "Resume", 0); set_px(a, w, 64.0); set_preset(a, 2);
		let b = button(col, "Options", 2); set_px(b, w, 64.0); set_preset(b, 2);
		let c = button(col, if g == 2 { "Surrender" } else { "Loadout" }, 2); set_px(c, w, 64.0); set_preset(c, 2);
		let d = button(col, "Quit", 5); set_px(d, w, 64.0); set_preset(d, 2);
	}
	let ver = label(f, "v1.04", 3);
	place_at(ver, 80.0, 1000.0, 200.0, 36.0);
}

fn stage_settings(f int, g int, mode int) {
	var x f32 = 360.0;
	var y f32 = 140.0;
	if mode == 1 { x = 80.0; }
	else if mode == 2 { x = 1040.0; }
	else if mode == 3 { y = 480.0; }
	else if mode == 4 { x = 160.0; y = 80.0; }
	let head = label(f, "Options", 0);
	place_at(head, x, y, 400.0, 56.0);
	let a = toggle(f, if g == 2 { "Quick cast" } else { "Aim assist" }, 1, 0); place_at(a, x, y + 80.0, 520.0, 56.0);
	let b = toggle(f, "Voice chat", 0, 2); place_at(b, x, y + 152.0, 520.0, 56.0);
	let s = label(f, "Sound", 2); place_at(s, x, y + 216.0, 200.0, 28.0);
	let c = slider(f, 0.7, 0); place_at(c, x, y + 252.0, 520.0, 40.0);
	let e = label(f, "Look", 2); place_at(e, x, y + 304.0, 200.0, 32.0);
	let d = slider(f, 0.4, 2); place_at(d, x, y + 344.0, 520.0, 40.0);
	let apply = button(f, "Apply", 0); place_at(apply, x, y + 408.0, 240.0, 64.0); set_preset(apply, 2);
}

fn stage_shop_fps(f int, g int, mode int) {
	var x f32 = 160.0;
	var y f32 = 160.0;
	if mode == 1 { x = 480.0; }
	else if mode == 2 { y = 360.0; }
	else if mode == 3 { x = 80.0; y = 80.0; }
	else if mode == 4 { x = 160.0; y = 480.0; }
	let head = label(f, if g == 2 { "Shop" } else { "Loadout" }, 0);
	place_at(head, x, y, 400.0, 56.0);
	let gold = label(f, "840 cr", 1);
	place_at(gold, x + 880.0, y, 240.0, 48.0);
	let row = flex(f, DIR_ROW);
	set_gap(row, 24.0);
	set_pad(row, 0.0);
	place_at(row, x, y + 176.0, 1224.0, 200.0);
	let a = button(row, if g == 2 { "Boots  300" } else { "Rifle  2900" }, 0); set_px(a, 288.0, 200.0); set_preset(a, 2);
	let b = button(row, if g == 2 { "Tome  400" } else { "Vest  1000" }, 2); set_px(b, 288.0, 200.0); set_preset(b, 2);
	let c = button(row, if g == 2 { "Gold  350" } else { "Ghost  500" }, 2); set_px(c, 288.0, 200.0); set_preset(c, 2);
	let d = button(row, if g == 2 { "Ward  75" } else { "Sheriff  800" }, 2); set_px(d, 288.0, 200.0); set_preset(d, 2);
	let ia = icon_button(f, if g == 2 { 52 } else { 77 }, 2); place_at(ia, x + 108.0, y + 88.0, 72.0, 72.0);
	let ib = icon_button(f, if g == 2 { 14 } else { 1 }, 2); place_at(ib, x + 420.0, y + 88.0, 72.0, 72.0);
	let ic = icon_button(f, if g == 2 { 5 } else { 50 }, 2); place_at(ic, x + 732.0, y + 88.0, 72.0, 72.0);
	let id = icon_button(f, if g == 2 { 17 } else { 0 }, 2); place_at(id, x + 1044.0, y + 88.0, 72.0, 72.0);
	let buy = button(f, "Buy", 0); place_at(buy, x, y + 400.0, 240.0, 64.0); set_preset(buy, 2);
}

fn stage_map_fps(f int, g int, mode int) {
	var x f32 = 80.0;
	var y f32 = 80.0;
	var w f32 = 1280.0;
	var h f32 = 920.0;
	if mode == 1 { x = 560.0; w = 1280.0; }
	else if mode == 2 { y = 200.0; h = 760.0; w = 1760.0; }
	else if mode == 3 { x = 80.0; y = 240.0; w = 1760.0; h = 640.0; }
	else if mode == 4 { x = 480.0; y = 120.0; w = 960.0; h = 840.0; }
	let map = minimap(f, 0);
	place_at(map, x, y, w, h);
	N[map].i3 = g;
	let pin = button(f, "Ping", 0); place_at(pin, 80.0, 1000.0, 200.0, 56.0); set_preset(pin, 2);
	let mark = button(f, "Mark", 2); place_at(mark, 300.0, 1000.0, 200.0, 56.0); set_preset(mark, 2);
	let title = label(f, if g == 2 { "Rift" } else { "Strike map" }, 1); place_at(title, 80.0, 24.0, 360.0, 48.0);
}

fn stage_results_fps(f int, g int, mode int) {
	var rx f32 = 80.0;
	var ry f32 = 80.0;
	var tx f32 = 640.0;
	var ty f32 = 200.0;
	if mode == 1 { rx = 1280.0; tx = 80.0; }
	else if mode == 2 { rx = 680.0; ry = 80.0; tx = 360.0; ty = 280.0; }
	else if mode == 3 { rx = 80.0; ry = 640.0; tx = 80.0; ty = 80.0; }
	else if mode == 4 { rx = 80.0; ry = 200.0; tx = 900.0; ty = 200.0; }
	let rank = label(f, if g == 2 { "VICTORY" } else { "WIN" }, 0);
	place_at(rank, rx, ry, 400.0, 72.0);
	let sub = label(f, if g == 2 { "12 / 3 / 7" } else { "13  -  9" }, 1);
	place_at(sub, rx, ry + 80.0, 400.0, 48.0);
	let tb = table(f, 4, 2, 3);
	place_at(tb, tx, ty, 720.0, 280.0);
	table_set(tb, 0, 0, "Kills"); table_set(tb, 0, 1, if g == 2 { "12" } else { "18" });
	table_set(tb, 1, 0, if g == 2 { "Deaths" } else { "Deaths" }); table_set(tb, 1, 1, if g == 2 { "3" } else { "7" });
	table_set(tb, 2, 0, if g == 2 { "Assists" } else { "Plants" }); table_set(tb, 2, 1, if g == 2 { "7" } else { "3" });
	table_set(tb, 3, 0, if g == 2 { "Gold" } else { "Score" }); table_set(tb, 3, 1, if g == 2 { "14200" } else { "2840" });
	let rw = label(f, "Rewards", 2);
	place_at(rw, tx, ty + 300.0, 240.0, 40.0);
	let row = flex(f, DIR_ROW);
	set_gap(row, 16.0);
	set_pad(row, 0.0);
	place_at(row, tx, ty + 352.0, 248.0, 72.0);
	let a = icon_button(row, 5, 0); set_px(a, 72.0, 72.0);
	let b = icon_button(row, 13, 2); set_px(b, 72.0, 72.0);
	let c = icon_button(row, 43, 2); set_px(c, 72.0, 72.0);
	let again = button(f, "Again", 0);
	place_at(again, 80.0, 980.0, 240.0, 64.0);
	set_preset(again, 2);
}

fn member(col int, name const byte[:], hp const byte[:]) {
	let box = flex(col, DIR_COL);
	set_gap(box, 4.0);
	set_pad(box, 0.0);
	set_px(box, 220.0, 100.0);
	let n = label(box, name, 2); set_px(n, 220.0, 32.0);
	let b = health_bar(box, 0.7, 0); set_px(b, 220.0, 20.0);
	let h = label(box, hp, 3); set_px(h, 220.0, 28.0);
}

fn party_line(f int, x f32, y f32) {
	let row = flex(f, DIR_ROW);
	set_gap(row, 16.0);
	set_pad(row, 0.0);
	place_at(row, x, y, 928.0, 100.0);
	member(row, "Terra", "420");
	member(row, "Locke", "310");
	member(row, "Celes", "280");
	member(row, "Edgar", "190");
}

fn cmd_menu(f int, x f32, y f32) {
	let col = flex(f, DIR_COL);
	set_gap(col, 12.0);
	set_pad(col, 0.0);
	place_at(col, x, y, 280.0, 260.0);
	let a = button(col, "Attack", 0); set_px(a, 280.0, 56.0); set_preset(a, 2);
	let b = button(col, "Magic", 2); set_px(b, 280.0, 56.0); set_preset(b, 2);
	let c = button(col, "Item", 2); set_px(c, 280.0, 56.0); set_preset(c, 2);
