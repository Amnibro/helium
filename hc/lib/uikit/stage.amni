	let floor = label(f, "Floor  12", 1); place_at(floor, 760.0, y + 100.0, 400.0, 40.0); mark_anchor(floor);
	let gold = label(f, "Gold  240", 2); place_at(gold, 760.0, y + 156.0, 400.0, 40.0); mark_anchor(gold);
	let card = label(f, "Gained  Strike+", 1); place_at(card, 760.0, y + 212.0, 400.0, 40.0); mark_anchor(card);
	let go = button(f, "Continue", 0); place_at(go, 780.0, y + 300.0, 360.0, 64.0); set_preset(go, 2);
}

fn stage_settings_deck(f int, mode int) {
	var x f32 = 640.0;
	var y f32 = 240.0;
	if mode == 1 { x = 80.0; }
	else if mode == 2 { x = 1120.0; }
	else if mode == 3 { y = 520.0; }
	else if mode == 4 { y = 80.0; x = 480.0; }
	let head = label(f, "Run", 0); place_at(head, x, y, 320.0, 56.0);
	let a = toggle(f, "Fast", 1, 0); place_at(a, x, y + 80.0, 480.0, 56.0);
	let b = slider(f, 0.5, 0); place_at(b, x, y + 160.0, 480.0, 32.0);
	let c = toggle(f, "Shake", 0, 2); place_at(c, x, y + 216.0, 480.0, 56.0);
}

fn stage_map_deck(f int, mode int) {
	var y f32 = 360.0;
	var x f32 = 200.0;
	if mode == 1 { y = 160.0; }
	else if mode == 2 { y = 640.0; x = 80.0; }
	else if mode == 3 { y = 200.0; x = 360.0; }
	else if mode == 4 { y = 480.0; x = 160.0; }
	let act = label(f, "Act  1", 0); place_at(act, 760.0, y - 80.0, 400.0, 48.0); mark_anchor(act);
	let a = button(f, "Elite", 0); place_at(a, x, y, 280.0, 72.0); set_preset(a, 2);
	let b = button(f, "Rest", 2); place_at(b, x + 360.0, y + 120.0, 280.0, 72.0); set_preset(b, 2);
	let c = button(f, "Shop", 1); place_at(c, x + 720.0, y, 280.0, 72.0); set_preset(c, 2);
	let d = button(f, "Boss", 5); place_at(d, x + 1080.0, y + 120.0, 280.0, 72.0); set_preset(d, 2);
}

fn build_stage(frame int, g int, screen int, mode int) int {
	N[frame].i0 = g;
	N[frame].i1 = screen;
	N[frame].i2 = mode;
	if screen == 0 { stage_title(frame, g, mode); }
	else if screen == 1 {
		if g == 4 { stage_pause_jrpg(frame, mode); }
		else if g == 5 { stage_pause_souls(frame, mode); }
		else if g == 1 { stage_pause_royale(frame, mode); }
		else if g == 7 { stage_pause_racing(frame, mode); }
		else if g == 8 { stage_pause_fighting(frame, mode); }
		else if g == 12 { stage_pause_deck(frame, mode); }
		else { stage_pause(frame, g, mode); }
	}
	else if screen == 2 {
		if g == 4 { stage_settings_jrpg(frame, mode); }
		else if g == 5 { stage_settings_souls(frame, mode); }
		else if g == 1 { stage_settings_royale(frame, mode); }
		else if g == 7 { stage_settings_racing(frame, mode); }
		else if g == 8 { stage_settings_fighting(frame, mode); }
		else if g == 12 { stage_settings_deck(frame, mode); }
		else { stage_settings(frame, g, mode); }
	}
	else if screen == 3 {
		if g == 2 { stage_hud_moba(frame, mode); }
		else if g == 4 { stage_hud_jrpg(frame, mode); }
		else if g == 5 { stage_hud_souls(frame, mode); }
		else if g == 1 { stage_hud_royale(frame, mode); }
		else if g == 7 { stage_hud_racing(frame, mode); }
		else if g == 8 { stage_hud_fighting(frame, mode); }
		else if g == 12 { stage_hud_deck(frame, mode); }
		else { stage_hud_fps(frame, mode); }
	}
	else if screen == 4 {
		if g == 4 { stage_shop_jrpg(frame, mode); }
		else if g == 5 { stage_shop_souls(frame, mode); }
		else if g == 1 { stage_shop_royale(frame, mode); }
		else if g == 7 { stage_shop_racing(frame, mode); }
		else if g == 8 { stage_shop_fighting(frame, mode); }
		else if g == 12 { stage_shop_deck(frame, mode); }
		else { stage_shop_fps(frame, g, mode); }
	}
	else if screen == 5 {
		if g == 4 { stage_map_jrpg(frame, mode); }
		else if g == 5 { stage_map_souls(frame, mode); }
		else if g == 1 { stage_map_royale(frame, mode); }
		else if g == 7 { stage_map_racing(frame, mode); }
		else if g == 8 { stage_map_fighting(frame, mode); }
		else if g == 12 { stage_map_deck(frame, mode); }
		else { stage_map_fps(frame, g, mode); }
	}
	else if g == 4 { stage_results_jrpg(frame, mode); }
	else if g == 5 { stage_results_souls(frame, mode); }
	else if g == 1 { stage_results_royale(frame, mode); }
	else if g == 7 { stage_results_racing(frame, mode); }
	else if g == 8 { stage_results_fighting(frame, mode); }
	else if g == 12 { stage_results_deck(frame, mode); }
	else { stage_results_fps(frame, g, mode); }
	frame
}
