fn glyph_row(ch int, row int) int {
	if row < 0 || row > 6 { return 0; }
	var c = ch;
	if c >= 97 && c <= 122 { c = c - 32; }
	if c < 32 || c > 126 { return 0; }
	GLYPH[(c - 32) * 7 + row] as int
}

fn font_scale(size f32) int {
	let sc = (size / 8.0) as int;
	if sc < 1 { 1 } else { sc }
}

fn text_advance(s const byte[:], size f32) f32 {
	if THEME.pixel == 0 && fonts_ready() { return measure_run(s, size, false, false, false); }
	let sc = font_scale(size);
	(text::display_width(s) * 6 * sc) as f32
}
