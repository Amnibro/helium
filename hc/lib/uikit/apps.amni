fn app_set_body(f int, g int) {
	let w = col2();
	var t1 = "Notifications";
	var d1 = "What can interrupt you.";
	var a1 = "Push";
	var b1 = "Email";
	var t2 = "Display";
	var d2 = "How dense the screen is.";
	var a2 = "Compact";
	var b2 = "Motion";
	if g == 26 { t1 = "Checkout"; d1 = "Tax, receipts, and stock alerts."; a1 = "Tax"; b1 = "Receipts"; t2 = "Shipping"; d2 = "When orders leave the shop."; a2 = "Labels"; b2 = "Pickup"; }
	else if g == 28 { t1 = "Messages"; d1 = "Read state and alerts."; a1 = "Previews"; b1 = "Sounds"; t2 = "Privacy"; d2 = "Who can start a chat."; a2 = "Requests"; b2 = "Read receipts"; }
	else if g == 29 { t1 = "Playback"; d1 = "Crossfade and offline copies."; a1 = "Crossfade"; b1 = "Offline"; t2 = "Sound"; d2 = "Output level."; a2 = "Normalize"; b2 = "Gapless"; }
	else if g == 36 { t1 = "Calendars"; d1 = "Which calendars show."; a1 = "Work"; b1 = "Personal"; t2 = "Reminders"; d2 = "How early to nudge."; a2 = "10 min"; b2 = "Email"; }
	else if g == 39 { t1 = "Alerts"; d1 = "Charges and deposits."; a1 = "Push"; b1 = "Email"; t2 = "Security"; d2 = "Confirm large amounts."; a2 = "Confirm"; b2 = "Hide sums"; }
	else if g == 40 { t1 = "Goals"; d1 = "Daily move and sleep."; a1 = "Move"; b1 = "Sleep"; t2 = "Sharing"; d2 = "Who can see this week."; a2 = "Share"; b2 = "Coach"; }
	set_group(f, AX, AY, w, t1, d1, a1, b1);
	set_group(f, AX + w + 16.0, AY, w, t2, d2, a2, b2);
	set_group(f, AX, AY + 248.0, w, "Account", "Profile, devices, and sign-in.", "Sync", "Devices");
	set_group(f, AX + w + 16.0, AY + 248.0, w, "Privacy", "What is stored on this device.", "History", "Analytics");
}

fn record(f int, y f32, who const byte[:], pic int, title const byte[:], sub const byte[:], meta const byte[:], action const byte[:]) {
	let c = card(f, "", 2);
	place_at(c, AX, y, AW, 96.0);
	set_pad(c, 12.0); set_gap(c, 12.0);
	let row = flex(c, DIR_ROW); set_px(row, AW - 24.0, 72.0); set_gap(row, 12.0); set_pad(row, 0.0);
	if pic >= 0 {
		let thumb = chart(row, 10 + pic, 2); set_px(thumb, 72.0, 64.0);
	} else {
		let av = avatar(row, who, 0); set_px(av, 64.0, 64.0);
	}
	let col = flex(row, DIR_COL); set_px(col, 520.0, 64.0); set_gap(col, 4.0); set_pad(col, 0.0);
	let t = label(col, title, 2); set_px(t, 500.0, 28.0);
	let s = label(col, sub, 4); set_px(s, 500.0, 24.0);
	let m = label(row, meta, 4); set_px(m, 240.0, 32.0);
	let b = button(row, action, 0); set_px(b, 120.0, 40.0); set_preset(b, 4);
}

