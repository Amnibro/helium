// App chrome on a 1920x1080 grid. Spacing is 8, 12, or 16.
namespace uikit;
import uikit.widgets;
import uikit.core;

var AX f32 = 256.0;
var AY f32 = 88.0;
var AW f32 = 1648.0;
var SIDE f32 = 0.0;

fn app_accent(g int) u32 {
	if g == 25 || g == 34 { return 0x4338CA; }
	if g == 26 || g == 40 { return 0xBE123C; }
	if g == 27 { return 0xBE185D; }
	if g == 28 || g == 39 { return 0x047857; }
	if g == 29 || g == 32 { return 0x6D28D9; }
	if g == 31 || g == 38 { return 0x0F766E; }
	if g == 35 { return 0xC2410C; }
	if g == 36 { return 0xB91C1C; }
	if g == 37 { return 0x15803D; }
	0x1D4ED8
}

fn app_theme(g int, mode int) {
	var bg = 0xF6F7F9;
	var surface = 0xFFFFFF;
	var ink = 0x1C2128;
	var s2 = 0xF1F3F6;
	var border = 0xE2E6EC;
	if mode >= 3 {
		bg = 0x12141A;
		surface = 0x1C2028;
		ink = 0xF4F6F8;
		s2 = 0x2A2F3A;
		border = 0x3A4150;
	}
	theme_apply(bg as u32, surface as u32, ink as u32, app_accent(g), 8.0, 1.0, 1, 0, 0, 12.0);
	THEME.surface2 = s2 as u32;
	THEME.border = border as u32;
	THEME.family = FAM_FLAT;
	THEME.glass = 0;
	THEME.pixel = 0;
	THEME.shadow = 1;
	THEME.radius = 12.0;
	THEME.border_w = 1.0;
	APP_UI = 1;
}

fn app_place(mode int) {
	if mode == 2 || mode == 4 {
		AX = 16.0; AY = 88.0; AW = 1888.0; SIDE = -1.0;
	} else if mode == 1 {
		AX = 16.0; AY = 88.0; AW = 1648.0; SIDE = 1680.0;
	} else {
		AX = 256.0; AY = 88.0; AW = 1648.0; SIDE = 0.0;
	}
}

fn app_shell(f int, mode int, brand const byte[:], a const byte[:], b const byte[:], c const byte[:], d const byte[:], action const byte[:]) {
	app_place(mode);
	if SIDE >= 0.0 {
		let s = card(f, "", 2);
		place_at(s, SIDE, 16.0, 240.0, 320.0);
		set_pad(s, 16.0); set_gap(s, 12.0);
		let br = label(s, brand, 1); set_px(br, 208.0, 40.0);
		let n0 = button(s, a, 0); set_px(n0, 208.0, 44.0); set_preset(n0, 4);
		let n1 = button(s, b, 2); set_px(n1, 208.0, 44.0); set_preset(n1, 4);
		let n2 = button(s, c, 2); set_px(n2, 208.0, 44.0); set_preset(n2, 4);
		let n3 = button(s, d, 2); set_px(n3, 208.0, 44.0); set_preset(n3, 4);
	}
	let top = card(f, "", 2);
	place_at(top, AX, 16.0, AW, 56.0);
	set_pad(top, 12.0); set_gap(top, 12.0);
	let row = flex(top, DIR_ROW); set_px(row, AW - 24.0, 32.0); set_gap(row, 12.0); set_pad(row, 0.0);
	let title = label(row, brand, 2); set_px(title, 280.0, 32.0);
	let find = text_field(row, "Search", 2); set_px(find, 360.0, 32.0);
	let go = button(row, action, 0); set_px(go, 140.0, 32.0); set_preset(go, 4);
}

fn metric(f int, x f32, y f32, w f32, name const byte[:], value const byte[:]) {
	let c = card(f, "", 2);
	place_at(c, x, y, w, 144.0);
	set_pad(c, 16.0); set_gap(c, 8.0);
	let n = label(c, name, 3); set_px(n, w - 32.0, 24.0);
	let v = label(c, value, 1); set_px(v, w - 32.0, 36.0);
	let ch = chart(c, 5, 3); set_px(ch, w - 32.0, 36.0);
}

fn kcard(f int, x f32, y f32, w f32, title const byte[:], tag const byte[:], tag2 const byte[:], who const byte[:], checks const byte[:], due const byte[:]) {
	let c = card(f, "", 2);
	place_at(c, x, y, w, 168.0);
	set_pad(c, 16.0); set_gap(c, 8.0);
	let t = label(c, title, 2); set_px(t, w - 32.0, 32.0);
	let tags = flex(c, DIR_ROW); set_px(tags, w - 32.0, 32.0); set_gap(tags, 8.0); set_pad(tags, 0.0);
	let tg = chip(tags, tag, 2); set_px(tg, 88.0, 28.0);
	let tg2 = chip(tags, tag2, 1); set_px(tg2, 88.0, 28.0);
	let row = flex(c, DIR_ROW); set_px(row, w - 32.0, 36.0); set_gap(row, 8.0); set_pad(row, 0.0);
	let av = avatar(row, who, 0); set_px(av, 36.0, 36.0);
	let ck = label(row, checks, 4); set_px(ck, 80.0, 32.0);
	let d = label(row, due, 4); set_px(d, 120.0, 32.0);
}

fn txrow(f int, x f32, y f32, w f32, icon int, name const byte[:], meta const byte[:], amt const byte[:]) {
	let c = card(f, "", 2);
	place_at(c, x, y, w, 64.0);
	set_pad(c, 12.0); set_gap(c, 12.0);
	let row = flex(c, DIR_ROW); set_px(row, w - 24.0, 40.0); set_gap(row, 12.0); set_pad(row, 0.0);
	let ic = icon_button(row, icon, 1); set_px(ic, 40.0, 40.0);
	let nm = label(row, name, 2); set_px(nm, 320.0, 40.0);
	let mt = label(row, meta, 3); set_px(mt, 240.0, 40.0);
	let am = label(row, amt, 2); set_px(am, 160.0, 40.0);
}

fn panel(f int, x f32, y f32, w f32, h f32, title const byte[:]) int {
	let c = card(f, "", 2);
	place_at(c, x, y, w, h);
	set_pad(c, 16.0); set_gap(c, 8.0);
	let t = label(c, title, 2); set_px(t, w - 32.0, 28.0);
	c
}

fn app_dash_main(f int) {
	let w = (AW - 48.0) / 4.0;
	metric(f, AX, AY, w, "Open", "12");
	metric(f, AX + w + 16.0, AY, w, "Cycle", "4d");
	metric(f, AX + (w + 16.0) * 2.0, AY, w, "Bugs", "3");
	metric(f, AX + (w + 16.0) * 3.0, AY, w, "Ship", "80%");
	let ch = chart(f, 0, 2); place_at(ch, AX, AY + 160.0, AW - 336.0, 400.0);
	let dn = chart(f, 2, 2); place_at(dn, AX + AW - 320.0, AY + 160.0, 320.0, 400.0);
	let tb = table(f, 4, 3, 2); place_at(tb, AX, AY + 576.0, AW, 240.0);
	table_set(tb, -1, 0, "Issue"); table_set(tb, -1, 1, "Who"); table_set(tb, -1, 2, "Age");
	table_set(tb, 0, 0, "Login"); table_set(tb, 0, 1, "Mira"); table_set(tb, 0, 2, "2d");
	table_set(tb, 1, 0, "Bill"); table_set(tb, 1, 1, "Sol"); table_set(tb, 1, 2, "5h");
	table_set(tb, 2, 0, "Search"); table_set(tb, 2, 1, "Ned"); table_set(tb, 2, 2, "1d");
	table_set(tb, 3, 0, "Export"); table_set(tb, 3, 1, "Ada"); table_set(tb, 3, 2, "4h");
}

fn app_admin_main(f int) {
	let q = text_field(f, "Find a person", 2); place_at(q, AX, AY, AW - 240.0, 48.0);
	let inv = button(f, "Invite", 0); place_at(inv, AX + AW - 220.0, AY, 220.0, 48.0); set_preset(inv, 4);
	let tb = table(f, 5, 3, 2); place_at(tb, AX, AY + 64.0, AW - 400.0, 320.0);
	table_set(tb, -1, 0, "Name"); table_set(tb, -1, 1, "Role"); table_set(tb, -1, 2, "Seen");
	table_set(tb, 0, 0, "Mira"); table_set(tb, 0, 1, "Owner"); table_set(tb, 0, 2, "Now");
	table_set(tb, 1, 0, "Sol"); table_set(tb, 1, 1, "Admin"); table_set(tb, 1, 2, "1h");
	table_set(tb, 2, 0, "Ned"); table_set(tb, 2, 1, "Staff"); table_set(tb, 2, 2, "1d");
	table_set(tb, 3, 0, "Ada"); table_set(tb, 3, 1, "Staff"); table_set(tb, 3, 2, "3d");
	table_set(tb, 4, 0, "Bram"); table_set(tb, 4, 1, "Guest"); table_set(tb, 4, 2, "9d");
	let a = button(f, "Owner", 0); place_at(a, AX + AW - 380.0, AY + 64.0, 360.0, 72.0); set_preset(a, 4);
	let b = button(f, "Staff", 2); place_at(b, AX + AW - 380.0, AY + 152.0, 360.0, 72.0); set_preset(b, 4);
	let c = button(f, "Guest", 2); place_at(c, AX + AW - 380.0, AY + 240.0, 360.0, 72.0); set_preset(c, 4);
	let n = label(f, "5 people", 3); place_at(n, AX + AW - 380.0, AY + 328.0, 240.0, 32.0);
}

fn col3() f32 { if AW > 1700.0 { return 608.0; } 528.0 }
fn col2() f32 { if AW > 1700.0 { return 920.0; } 800.0 }

fn product(f int, x f32, y f32, w f32, kind int, name const byte[:], price const byte[:], stars int) {
	let c = card(f, "", 2);
	place_at(c, x, y, w, 280.0);
	set_pad(c, 12.0); set_gap(c, 8.0);
	let pic = chart(c, 10 + kind, 2); set_px(pic, w - 24.0, 120.0);
	let n = label(c, name, 2); set_px(n, w - 24.0, 28.0);
	let row = flex(c, DIR_ROW); set_px(row, w - 24.0, 40.0); set_gap(row, 8.0); set_pad(row, 0.0);
	let p = label(row, price, 2); set_px(p, 80.0, 36.0);
	let r = rating(row, stars, 0); set_px(r, 96.0, 28.0);
	let add = button(row, "Add", 0); set_px(add, 72.0, 36.0); set_preset(add, 4);
}

fn app_shop_main(f int) {
	let w = col3();
	let y = AY;
	product(f, AX, y, w, 0, "Mug", "12", 5);
	product(f, AX + w + 16.0, y, w, 1, "Lamp", "28", 4);
	product(f, AX + (w + 16.0) * 2.0, y, w, 2, "Tote", "18", 5);
	product(f, AX, y + 296.0, w, 3, "Pen", "6", 4);
	product(f, AX + w + 16.0, y + 296.0, w, 4, "Bowl", "22", 5);
	product(f, AX + (w + 16.0) * 2.0, y + 296.0, w, 5, "Cloth", "16", 4);
	let cart = card(f, "", 2); place_at(cart, AX, y + 592.0, AW, 88.0); set_pad(cart, 16.0); set_gap(cart, 8.0);
	let row = flex(cart, DIR_ROW); set_px(row, AW - 32.0, 48.0); set_gap(row, 16.0); set_pad(row, 0.0);
	let a = label(row, "Cart  3", 4); set_px(a, 200.0, 36.0);
	let b = label(row, "Total  86", 1); set_px(b, 240.0, 40.0);
	let pay = button(row, "Checkout", 0); set_px(pay, 180.0, 44.0); set_preset(pay, 4);
}

fn app_btn_at(f int, text const byte[:], x f32, y f32, w f32, h f32, look int) {
	let b = button(f, text, look); place_at(b, x, y, w, h); set_preset(b, 4);
}

fn app_social_main(f int) {
	let box = text_field(f, "Share something", 2); place_at(box, AX, AY, AW - 160.0, 56.0);
	app_btn_at(f, "Post", AX + AW - 144.0, AY, 144.0, 56.0, 0);
	let a = card(f, "", 2); place_at(a, AX, AY + 72.0, col2(), 280.0); set_pad(a, 16.0); set_gap(a, 12.0);
	let t1 = label(a, "Mira", 2); set_px(t1, 400.0, 28.0);
	let p1 = label(a, "Morning light on the harbor.", 3); set_px(p1, 400.0, 48.0);
	let b = card(f, "", 2); place_at(b, AX + col2() + 16.0, AY + 72.0, col2(), 280.0); set_pad(b, 16.0); set_gap(b, 12.0);
	let t2 = label(b, "Sol", 2); set_px(t2, 400.0, 28.0);
	let p2 = label(b, "New loaf, still warm.", 3); set_px(p2, 400.0, 48.0);
	app_btn_at(f, "Mira", AX, AY + 368.0, 200.0, 48.0, 0);
	app_btn_at(f, "Sol", AX + 216.0, AY + 368.0, 200.0, 48.0, 2);
	app_btn_at(f, "Ned", AX + 432.0, AY + 368.0, 200.0, 48.0, 2);
	app_btn_at(f, "Ada", AX + 648.0, AY + 368.0, 200.0, 48.0, 2);
}

fn tick_col() u32 {
	if THEME.ink == 0xF4F6F8 { return 0x6EE7B7; }
	0x047857
}

fn bubble(f int, x f32, y f32, who const byte[:], a const byte[:], b const byte[:], time const byte[:], mine int) {
	if mine == 0 {
		let av = avatar(f, who, 0); place_at(av, x, y, 40.0, 40.0);
		let c = card(f, "", 1); place_at(c, x + 48.0, y, 440.0, 112.0); set_pad(c, 12.0); set_gap(c, 4.0);
		let t = label(c, a, 4); set_px(t, 416.0, 24.0);
		let u = label(c, b, 4); set_px(u, 416.0, 24.0);
		let meta = flex(c, DIR_ROW); set_px(meta, 416.0, 20.0); set_gap(meta, 8.0); set_pad(meta, 0.0);
		let s = label(meta, time, 5); set_px(s, 80.0, 20.0);
		let k = label(meta, "vv", 5); set_px(k, 40.0, 20.0); N[k].fg = tick_col();
	} else {
		let c = card(f, "", 2); place_at(c, x, y, 440.0, 112.0); set_pad(c, 12.0); set_gap(c, 4.0);
		let t = label(c, a, 4); set_px(t, 416.0, 24.0);
		let u = label(c, b, 4); set_px(u, 416.0, 24.0);
		let meta = flex(c, DIR_ROW); set_px(meta, 416.0, 20.0); set_gap(meta, 8.0); set_pad(meta, 0.0);
		let s = label(meta, time, 5); set_px(s, 80.0, 20.0);
		let k = label(meta, "vv", 5); set_px(k, 40.0, 20.0); N[k].fg = tick_col();
		let av = avatar(f, who, 0); place_at(av, x + 448.0, y, 40.0, 40.0);
	}
}

fn app_chat_main(f int) {
	app_btn_at(f, "Mira", AX, AY, 280.0, 48.0, 0);
	app_btn_at(f, "Sol", AX, AY + 56.0, 280.0, 48.0, 2);
	app_btn_at(f, "Ned", AX, AY + 112.0, 280.0, 48.0, 2);
	app_btn_at(f, "Ada", AX, AY + 168.0, 280.0, 48.0, 2);
	app_btn_at(f, "Bram", AX, AY + 224.0, 280.0, 48.0, 2);
	let x = AX + 304.0;
	bubble(f, x, AY, "M", "On my way", "through the harbor.", "2:14", 0);
	bubble(f, x + 320.0, AY + 120.0, "Y", "See you at six", "by the oak gate.", "2:15", 1);
	bubble(f, x, AY + 240.0, "M", "Bring the notes", "and the spare key.", "2:16", 0);
	bubble(f, x + 320.0, AY + 360.0, "Y", "Already in the bag", "next to the lamp.", "2:18", 1);
	bubble(f, x, AY + 480.0, "M", "The gate is open", "on the mill side.", "2:21", 0);
	bubble(f, x + 320.0, AY + 600.0, "Y", "Two minutes out", "I can see it.", "2:22", 1);
	let box = text_field(f, "Message", 2); place_at(box, x, AY + 728.0, AW - 520.0, 56.0);
	app_btn_at(f, "Send", AX + AW - 148.0, AY + 728.0, 148.0, 56.0, 0);
}

