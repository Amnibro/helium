fn set_group(f int, x f32, y f32, w f32, title const byte[:], desc const byte[:], a const byte[:], b const byte[:]) {
	let c = card(f, "", 2);
	place_at(c, x, y, w, 232.0);
	set_pad(c, 16.0); set_gap(c, 8.0);
	let h = label(c, title, 2); set_px(h, w - 32.0, 32.0);
	let d = label(c, desc, 4); set_px(d, w - 32.0, 40.0);
	let t1 = toggle(c, a, 1, 0); set_px(t1, w - 32.0, 48.0);
	let t2 = toggle(c, b, 0, 2); set_px(t2, w - 32.0, 48.0);
}

fn app_sets_main(f int) {
	let w = col2();
	set_group(f, AX, AY, w, "Appearance", "Theme, motion, and type size.", "Dark", "Motion");
