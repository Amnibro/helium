fn app_docs_main(f int) {
	app_btn_at(f, "Start", AX, AY, 240.0, 48.0, 0);
	app_btn_at(f, "Layout", AX, AY + 56.0, 240.0, 48.0, 2);
	app_btn_at(f, "Type", AX, AY + 112.0, 240.0, 48.0, 2);
	app_btn_at(f, "Color", AX, AY + 168.0, 240.0, 48.0, 2);
	let body = card(f, "", 2); place_at(body, AX + 256.0, AY, AW - 560.0, 400.0); set_pad(body, 16.0); set_gap(body, 12.0);
	let h = label(body, "Build a screen", 1); set_px(h, 600.0, 40.0);
	let p = label(body, "Place the title, then the body.", 3); set_px(p, 600.0, 64.0);
	let q = label(body, "Keep the measure near 70 characters.", 3); set_px(q, 640.0, 64.0);
	app_btn_at(f, "On this page", AX + AW - 280.0, AY, 280.0, 48.0, 2);
	app_btn_at(f, "Next", AX + AW - 280.0, AY + 64.0, 280.0, 48.0, 2);
}

fn app_cal_main(f int) {
	let head = label(f, "March", 1); place_at(head, AX, AY, 200.0, 36.0);
	var col = 0;
	while col < 7 {
		var name = "Su";
		if col == 1 { name = "Mo"; }
		else if col == 2 { name = "Tu"; }
		else if col == 3 { name = "We"; }
		else if col == 4 { name = "Th"; }
		else if col == 5 { name = "Fr"; }
		else if col == 6 { name = "Sa"; }
		let lab = label(f, name, 5); place_at(lab, AX + col as f32 * 80.0, AY + 40.0, 64.0, 24.0);
		col += 1;
	}
	var row = 0;
	while row < 6 {
		var c = 0;
		while c < 7 {
			let index = row * 7 + c;
			let d = index - 6;
			var n = d;
			var march = 1;
			if d < 1 { n = 28 + d; march = 0; }
			else if d > 31 { n = d - 31; march = 0; }
			TMP.clear();
			format(TMP, n);
			let look = if march != 0 && d == 14 { 0 } else if march != 0 { 2 } else { 1 };
			let cell = button(f, TMP[..], look);
			place_at(cell, AX + c as f32 * 80.0, AY + 72.0 + row as f32 * 64.0, 72.0, 56.0);
			set_preset(cell, 4);
			c += 1;
		}
		row += 1;
	}
	let day = label(f, "Wednesday  14", 1); place_at(day, AX + 600.0, AY, 480.0, 36.0);
	var i = 0;
	while i < 8 {
		var txt = "9";
		if i == 1 { txt = "10"; }
		else if i == 2 { txt = "11"; }
		else if i == 3 { txt = "12"; }
		else if i == 4 { txt = "1"; }
		else if i == 5 { txt = "2"; }
		else if i == 6 { txt = "3"; }
		else if i == 7 { txt = "4"; }
		let lab = label(f, txt, 5); place_at(lab, AX + 600.0, AY + 48.0 + i as f32 * 72.0, 48.0, 24.0);
		i += 1;
	}
	app_btn_at(f, "Standup", AX + 664.0, AY + 120.0, 360.0, 56.0, 0);
	app_btn_at(f, "Review", AX + 664.0, AY + 264.0, 420.0, 128.0, 2);
	app_btn_at(f, "Lunch", AX + 1100.0, AY + 336.0, 280.0, 56.0, 1);
	app_btn_at(f, "Ship", AX + 664.0, AY + 480.0, 360.0, 56.0, 2);
}

