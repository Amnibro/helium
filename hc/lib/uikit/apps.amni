fn app_health(f int, mode int) {
	var y f32 = 160.0;
	if mode == 1 { y = 220.0; }
	else if mode == 3 { y = 180.0; }
	else if mode == 4 { y = 200.0; }
	app_title(f, "Pulse");
	app_btn(f, "Move  82", 80.0, y, 480.0, 200.0, 0);
	app_btn(f, "Sleep  7h", 600.0, y, 480.0, 200.0, 2);
	app_btn(f, "Heart  62", 1120.0, y, 480.0, 200.0, 1);
	let ch = chart(f, 1, 0); place_at(ch, 80.0, y + 240.0, 1000.0, 320.0);
	let bar = health_bar(f, 0.82, 0); place_at(bar, 1120.0, y + 280.0, 640.0, 24.0);
	app_lab(f, "Goal  82%", 1120.0, y + 320.0, 280.0);
	app_lab(f, "This week", 80.0, y + 580.0, 280.0);
}

fn app_list(f int, mode int, g int) {
	var x f32 = 200.0;
	var y f32 = 160.0;
	if mode == 1 { x = 1080.0; }
	else if mode == 2 { y = 280.0; }
	else if mode == 3 { x = 80.0; }
	else if mode == 4 { y = 200.0; x = 640.0; }
	if g == 24 {
		app_title(f, "Boards");
		app_btn(f, "Launch", x, y, 480.0, 72.0, 0);
		app_btn(f, "Billing", x, y + 88.0, 480.0, 72.0, 2);
		app_btn(f, "Search", x, y + 176.0, 480.0, 72.0, 2);
		app_lab(f, "3 boards", x, y + 272.0, 240.0);
	} else if g == 26 {
		app_title(f, "Orders");
		app_btn(f, "Open  4", x, y, 480.0, 72.0, 0);
		app_btn(f, "Packed  2", x, y + 88.0, 480.0, 72.0, 2);
		app_btn(f, "Sent  11", x, y + 176.0, 480.0, 72.0, 2);
		app_lab(f, "Harbor", x, y + 272.0, 240.0);
	} else if g == 29 {
		app_title(f, "Library");
		app_btn(f, "Glass", x, y, 480.0, 72.0, 0);
		app_btn(f, "Ember", x, y + 88.0, 480.0, 72.0, 2);
		app_btn(f, "Tide", x, y + 176.0, 480.0, 72.0, 2);
		app_lab(f, "3 songs", x, y + 272.0, 240.0);
	} else if g == 39 {
		app_title(f, "Cards");
		app_btn(f, "Daily", x, y, 480.0, 72.0, 0);
		app_btn(f, "Save", x, y + 88.0, 480.0, 72.0, 2);
		app_btn(f, "Travel", x, y + 176.0, 480.0, 72.0, 2);
		app_lab(f, "Ledger", x, y + 272.0, 240.0);
	} else {
		app_title(f, "List");
		app_btn(f, "One", x, y, 480.0, 72.0, 0);
		app_btn(f, "Two", x, y + 88.0, 480.0, 72.0, 2);
		app_btn(f, "Three", x, y + 176.0, 480.0, 72.0, 2);
		app_lab(f, "Recent", x, y + 272.0, 240.0);
	}
}

fn app_browse(f int, mode int, g int) {
	var y f32 = 140.0;
	if mode == 1 { y = 240.0; }
	else if mode == 3 { y = 200.0; }
	app_title(f, if g == 36 { "Month" } else if g == 35 { "Index" } else if g == 38 { "Places" } else { "Browse" });
	let ch = chart(f, g % 5, 0); place_at(ch, 80.0, y, 1000.0, 480.0);
	app_btn(f, "All", 1160.0, y, 280.0, 64.0, 0);
	app_btn(f, "Mine", 1480.0, y, 280.0, 64.0, 2);
	app_btn(f, "Week", 1160.0, y + 88.0, 600.0, 64.0, 2);
	app_lab(f, "Filtered", 1160.0, y + 180.0, 280.0);
}

fn build_app(frame int, g int, screen int, mode int) int {
	N[frame].i0 = g;
	N[frame].i1 = screen;
	N[frame].i2 = mode;
	if screen == 0 {
		if g == 24 { app_home(frame, mode, "Northstar", "Open", "Boards", "Alerts", "Options"); }
		else if g == 25 { app_home(frame, mode, "Roster", "People", "Roles", "Audit", "Options"); }
		else if g == 26 { app_home(frame, mode, "Harbor", "Shop", "Orders", "Stock", "Options"); }
		else if g == 27 { app_home(frame, mode, "Field", "Feed", "Saved", "Profile", "Options"); }
		else if g == 28 { app_home(frame, mode, "Wire", "Chats", "Calls", "Saved", "Options"); }
		else if g == 29 { app_home(frame, mode, "Needle", "Listen", "Library", "Radio", "Options"); }
		else if g == 30 { app_home(frame, mode, "Quill", "Open", "New", "Recent", "Options"); }
		else if g == 31 { app_home(frame, mode, "Prefs", "General", "Sound", "Account", "Options"); }
		else if g == 32 { app_home(frame, mode, "Welcome", "Start", "Skip", "Tour", "Options"); }
		else if g == 33 { app_home(frame, mode, "Sign in", "Enter", "Create", "Help", "Options"); }
		else if g == 34 { app_home(frame, mode, "Plans", "Free", "Plus", "Team", "Options"); }
		else if g == 35 { app_home(frame, mode, "Guide", "Start", "Search", "Index", "Options"); }
		else if g == 36 { app_home(frame, mode, "Week", "Today", "Month", "Agenda", "Options"); }
		else if g == 37 { app_home(frame, mode, "Board", "Mine", "All", "Archive", "Options"); }
		else if g == 38 { app_home(frame, mode, "Atlas", "Search", "Saved", "Nearby", "Options"); }
		else if g == 39 { app_home(frame, mode, "Ledger", "Home", "Cards", "Send", "Options"); }
		else { app_home(frame, mode, "Pulse", "Today", "Week", "Goals", "Options"); }
	} else if screen == 1 {
		if g == 28 { app_menu(frame, mode, "Wire", "Resume", "Mute", "Archive", "Leave"); }
		else if g == 33 { app_menu(frame, mode, "Account", "Profile", "Security", "Devices", "Sign out"); }
		else { app_menu(frame, mode, "Menu", "Resume", "Search", "Account", "Quit"); }
	} else if screen == 2 {
		if g == 31 { app_sets(frame, mode); }
		else if g == 29 { app_prefs(frame, mode, "Sound", "Crossfade", "Offline"); }
		else if g == 39 { app_prefs(frame, mode, "Alerts", "Push", "Email"); }
		else { app_prefs(frame, mode, "Settings", "Alerts", "Compact"); }
	} else if screen == 3 {
		if g == 24 { app_dash(frame, mode); }
		else if g == 25 { app_admin(frame, mode); }
		else if g == 26 { app_shop(frame, mode); }
		else if g == 27 { app_social(frame, mode); }
		else if g == 28 { app_chat(frame, mode); }
		else if g == 29 { app_media(frame, mode); }
		else if g == 30 { app_editor(frame, mode); }
		else if g == 31 { app_sets(frame, mode); }
		else if g == 32 { app_onboard(frame, mode); }
		else if g == 33 { app_auth(frame, mode); }
		else if g == 34 { app_price(frame, mode); }
		else if g == 35 { app_docs(frame, mode); }
		else if g == 36 { app_cal(frame, mode); }
		else if g == 37 { app_kanban(frame, mode); }
		else if g == 38 { app_maps(frame, mode); }
		else if g == 39 { app_bank(frame, mode); }
		else { app_health(frame, mode); }
	} else if screen == 4 {
		app_list(frame, mode, g);
	} else if screen == 5 {
		app_browse(frame, mode, g);
	} else if g == 26 {
		app_sum(frame, mode, "Receipt", "Harbor", "Done", "Item", "Qty", "Sum");
	} else if g == 39 {
		app_sum(frame, mode, "Month", "Ledger", "Export", "When", "Who", "Sum");
	} else if g == 40 {
		app_sum(frame, mode, "Week", "Pulse", "Share", "Day", "Move", "Sleep");
	} else {
		app_sum(frame, mode, "Summary", "This week", "Export", "Item", "Now", "All");
	}
	for i in N.len {
		if N[i].preset >= 4 && N[i].preset <= 10 { set_preset(i, 3); }
	}
	frame
}
