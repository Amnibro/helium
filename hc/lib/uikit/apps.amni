// 16:9 screens for the app genres. Same 1920x1080 grid as the game stages.
namespace uikit;
import uikit.widgets;
import uikit.core;

fn app_title(f int, text const byte[:]) {
	let h = label(f, text, 1);
	place_at(h, 720.0, 36.0, 480.0, 56.0);
	mark_anchor(h);
}

fn app_btn(f int, text const byte[:], x f32, y f32, w f32, h f32, look int) int {
	let b = button(f, text, look);
	place_at(b, x, y, w, h);
	set_preset(b, 2);
	b
}

fn app_lab(f int, text const byte[:], x f32, y f32, w f32) int {
	let a = label(f, text, 2);
	place_at(a, x, y, w, 40.0);
	a
}

fn app_home(f int, mode int, name const byte[:], a const byte[:], b const byte[:], c const byte[:], d const byte[:]) {
	app_title(f, name);
	var x f32 = 1400.0;
	var y f32 = 240.0;
	if mode == 1 { x = 80.0; }
	else if mode == 2 { x = 760.0; y = 640.0; }
	else if mode == 3 { y = 200.0; x = 80.0; }
	else if mode == 4 { x = 200.0; y = 720.0; }
	app_btn(f, a, x, y, 400.0, 64.0, 0);
	app_btn(f, b, x, y + 80.0, 400.0, 64.0, 2);
	app_btn(f, c, x, y + 160.0, 400.0, 64.0, 2);
	app_btn(f, d, x, y + 240.0, 400.0, 64.0, 5);
	app_lab(f, "v1.04", 1560.0, 1000.0, 240.0);
}

fn app_menu(f int, mode int, name const byte[:], a const byte[:], b const byte[:], c const byte[:], d const byte[:]) {
	app_title(f, name);
	var x f32 = 760.0;
	var y f32 = 200.0;
	if mode == 1 { x = 80.0; }
	else if mode == 2 { x = 1400.0; }
	else if mode == 3 { y = 520.0; }
	else if mode == 4 { y = 120.0; x = 480.0; }
	app_btn(f, a, x, y, 400.0, 64.0, 0);
	app_btn(f, b, x, y + 80.0, 400.0, 64.0, 2);
	app_btn(f, c, x, y + 160.0, 400.0, 64.0, 2);
	app_btn(f, d, x, y + 240.0, 400.0, 64.0, 5);
}

fn app_prefs(f int, mode int, name const byte[:], a const byte[:], b const byte[:]) {
	var x f32 = 640.0;
	var y f32 = 200.0;
	if mode == 1 { x = 80.0; }
	else if mode == 2 { x = 1080.0; }
	else if mode == 3 { y = 480.0; }
	else if mode == 4 { y = 120.0; }
	let head = label(f, name, 1); place_at(head, x, y, 400.0, 56.0);
	let t1 = toggle(f, a, 1, 0); place_at(t1, x, y + 80.0, 520.0, 64.0);
	let t2 = toggle(f, b, 0, 2); place_at(t2, x, y + 160.0, 520.0, 64.0);
	let s = slider(f, 0.6, 0); place_at(s, x, y + 248.0, 520.0, 32.0);
}

fn app_sum(f int, mode int, name const byte[:], side const byte[:], go const byte[:], h0 const byte[:], h1 const byte[:], h2 const byte[:]) {
	app_title(f, name);
	app_lab(f, side, 80.0, 40.0, 280.0);
	var x f32 = 480.0;
	var y f32 = 180.0;
	if mode == 1 { x = 80.0; }
	else if mode == 2 { x = 1000.0; }
	else if mode == 3 { y = 360.0; }
	else if mode == 4 { x = 240.0; y = 200.0; }
	let tb = table(f, 4, 3, 2);
	place_at(tb, x, y, 840.0, 240.0);
	table_set(tb, -1, 0, h0); table_set(tb, -1, 1, h1); table_set(tb, -1, 2, h2);
	table_set(tb, 0, 0, "Open"); table_set(tb, 0, 1, "12"); table_set(tb, 0, 2, "4");
	table_set(tb, 1, 0, "Done"); table_set(tb, 1, 1, "9"); table_set(tb, 1, 2, "30");
	table_set(tb, 2, 0, "Wait"); table_set(tb, 2, 1, "3"); table_set(tb, 2, 2, "1");
	table_set(tb, 3, 0, "Net"); table_set(tb, 3, 1, "18"); table_set(tb, 3, 2, "27");
	app_btn(f, go, 80.0, 980.0, 280.0, 64.0, 0);
}

fn app_dash(f int, mode int) {
	var my f32 = 120.0;
	var cy f32 = 260.0;
	var lx f32 = 48.0;
	var rx f32 = 960.0;
	if mode == 1 { my = 840.0; cy = 140.0; }
	else if mode == 2 { lx = 960.0; rx = 48.0; }
	else if mode == 3 { my = 200.0; cy = 360.0; }
	else if mode == 4 { my = 140.0; cy = 280.0; }
	app_title(f, "Northstar");
	app_btn(f, "Open  12", 48.0, my, 420.0, 100.0, 0);
	app_btn(f, "Cycle  4d", 492.0, my, 420.0, 100.0, 2);
	app_btn(f, "Bugs  3", 936.0, my, 420.0, 100.0, 1);
	app_btn(f, "Ship  80", 1380.0, my, 420.0, 100.0, 2);
	let ch = chart(f, 0, 0); place_at(ch, lx, cy, 880.0, 400.0);
	let tb = table(f, 4, 3, 2); place_at(tb, rx, cy, 900.0, 280.0);
	table_set(tb, -1, 0, "Issue"); table_set(tb, -1, 1, "Who"); table_set(tb, -1, 2, "Age");
	table_set(tb, 0, 0, "Login"); table_set(tb, 0, 1, "Mira"); table_set(tb, 0, 2, "2d");
	table_set(tb, 1, 0, "Bill"); table_set(tb, 1, 1, "Sol"); table_set(tb, 1, 2, "5h");
	table_set(tb, 2, 0, "Search"); table_set(tb, 2, 1, "Ned"); table_set(tb, 2, 2, "1d");
	table_set(tb, 3, 0, "Export"); table_set(tb, 3, 1, "Ada"); table_set(tb, 3, 2, "4h");
	app_lab(f, "Live", lx, cy + 420.0, 200.0);
	app_lab(f, "Queue", rx, cy + 300.0, 200.0);
}

fn app_admin(f int, mode int) {
	var y f32 = 140.0;
	var sx f32 = 1500.0;
	if mode == 1 { y = 200.0; sx = 48.0; }
	else if mode == 2 { y = 120.0; }
	else if mode == 3 { y = 280.0; }
	else if mode == 4 { sx = 48.0; y = 160.0; }
	var tx f32 = 48.0;
	if sx < 200.0 { tx = 480.0; }
	app_title(f, "Roster");
	let q = text_field(f, "Find a person", 2); place_at(q, tx, y, 720.0, 56.0);
	app_btn(f, "Invite", tx + 740.0, y, 220.0, 56.0, 0);
	let tb = table(f, 5, 3, 2); place_at(tb, tx, y + 80.0, 960.0, 280.0);
	table_set(tb, -1, 0, "Name"); table_set(tb, -1, 1, "Role"); table_set(tb, -1, 2, "Seen");
	table_set(tb, 0, 0, "Mira"); table_set(tb, 0, 1, "Owner"); table_set(tb, 0, 2, "Now");
	table_set(tb, 1, 0, "Sol"); table_set(tb, 1, 1, "Admin"); table_set(tb, 1, 2, "1h");
	table_set(tb, 2, 0, "Ned"); table_set(tb, 2, 1, "Staff"); table_set(tb, 2, 2, "1d");
	table_set(tb, 3, 0, "Ada"); table_set(tb, 3, 1, "Staff"); table_set(tb, 3, 2, "3d");
	table_set(tb, 4, 0, "Bram"); table_set(tb, 4, 1, "Guest"); table_set(tb, 4, 2, "9d");
	app_btn(f, "Owner", sx, y + 80.0, 360.0, 72.0, 0);
	app_btn(f, "Staff", sx, y + 168.0, 360.0, 72.0, 2);
	app_btn(f, "Guest", sx, y + 256.0, 360.0, 72.0, 2);
	app_lab(f, "5 people", tx, y + 376.0, 280.0);
}

