fn app_browse_body(f int, g int) {
	if g == 38 { app_maps_main(f); return; }
	if g == 36 { app_cal_main(f); return; }
	if g == 37 { app_kanban_main(f); return; }
	let kind = if g == 24 { 1 } else if g == 40 { 3 } else if g == 29 { 5 } else { 0 };
	let ch = chart(f, kind, 2); place_at(ch, AX, AY, AW - 320.0, 400.0);
	app_btn_at(f, "Week", AX + AW - 300.0, AY, 300.0, 48.0, 0);
	app_btn_at(f, "Month", AX + AW - 300.0, AY + 64.0, 300.0, 48.0, 2);
	app_btn_at(f, "Year", AX + AW - 300.0, AY + 128.0, 300.0, 48.0, 2);
}

fn app_sum_body(f int, g int) {
	if g == 39 {
		txrow(f, AX, AY, AW, 5, "In", "This month", "+4,200");
		txrow(f, AX, AY + 72.0, AW, 7, "Out", "This month", "-1,840");
		let ch = chart(f, 3, 2); place_at(ch, AX, AY + 160.0, AW, 280.0);
		return;
	}
	if g == 26 {
		metric(f, AX, AY, 480.0, "Revenue", "860");
		metric(f, AX + 496.0, AY, 480.0, "Orders", "14");
		let ch = chart(f, 1, 2); place_at(ch, AX, AY + 160.0, AW, 320.0);
		return;
	}
	if g == 40 {
		let dn = chart(f, 2, 2); place_at(dn, AX, AY, 360.0, 360.0);
		let ch = chart(f, 0, 2); place_at(ch, AX + 376.0, AY, AW - 376.0, 360.0);
		let lab = label(f, "Week of  12", 2); place_at(lab, AX, AY + 376.0, 320.0, 32.0);
		return;
	}
	let ch = chart(f, 3, 2); place_at(ch, AX, AY, AW - 360.0, 360.0);
	metric(f, AX + AW - 344.0, AY, 344.0, "Net", "18");
	app_btn_at(f, "Export", AX + AW - 344.0, AY + 160.0, 344.0, 56.0, 0);
}

fn raise_app_type() {
	for i in N.len {
		if N[i].preset == 3 { set_preset(i, 4); }
		if N[i].preset >= 6 && N[i].preset <= 10 { set_preset(i, 5); }
	}
}

fn build_app(frame int, g int, screen int, mode int) int {
	N[frame].i0 = g;
	N[frame].i1 = screen;
	N[frame].i2 = mode;
	var brand = "Northstar";
	var a = "Home";
	var b = "Work";
	var c = "Alerts";
	var d = "Account";
	var action = "New";
	if g == 25 { brand = "Roster"; a = "People"; b = "Roles"; c = "Audit"; d = "Account"; action = "Invite"; }
	else if g == 26 { brand = "Harbor"; a = "Shop"; b = "Orders"; c = "Stock"; d = "Account"; action = "Cart"; }
	else if g == 27 { brand = "Field"; a = "Feed"; b = "Saved"; c = "Notes"; d = "Profile"; action = "Post"; }
	else if g == 28 { brand = "Wire"; a = "Chats"; b = "Calls"; c = "Saved"; d = "Account"; action = "New"; }
	else if g == 29 { brand = "Needle"; a = "Listen"; b = "Library"; c = "Radio"; d = "Account"; action = "Play"; }
	else if g == 30 { brand = "Quill"; a = "Files"; b = "Search"; c = "Recent"; d = "Account"; action = "New"; }
	else if g == 31 { brand = "Prefs"; a = "General"; b = "Sound"; c = "Account"; d = "About"; action = "Save"; }
	else if g == 32 { brand = "Welcome"; a = "Start"; b = "Steps"; c = "Skip"; d = "Help"; action = "Next"; }
	else if g == 33 { brand = "Account"; a = "Sign in"; b = "Create"; c = "Help"; d = "About"; action = "Enter"; }
	else if g == 34 { brand = "Plans"; a = "Pricing"; b = "Billing"; c = "Usage"; d = "Account"; action = "Upgrade"; }
	else if g == 35 { brand = "Guide"; a = "Start"; b = "Layout"; c = "Type"; d = "Color"; action = "Search"; }
	else if g == 36 { brand = "Week"; a = "Today"; b = "Month"; c = "Agenda"; d = "Calendars"; action = "New"; }
	else if g == 37 { brand = "Board"; a = "Mine"; b = "All"; c = "Archive"; d = "Account"; action = "Add"; }
	else if g == 38 { brand = "Atlas"; a = "Map"; b = "Saved"; c = "Nearby"; d = "Layers"; action = "Search"; }
	else if g == 39 { brand = "Ledger"; a = "Home"; b = "Cards"; c = "Send"; d = "Account"; action = "Send"; }
	else if g == 40 { brand = "Pulse"; a = "Today"; b = "Week"; c = "Goals"; d = "Account"; action = "Log"; }
	app_shell(frame, mode, brand, a, b, c, d, action);
	if screen == 0 { app_home_body(frame, g); }
	else if screen == 1 { app_menu_body(frame, g); }
	else if screen == 2 {
		if g == 31 { app_sets_main(frame); }
		else { app_set_body(frame, g); }
	} else if screen == 3 {
		if g == 24 { app_dash_main(frame); }
		else if g == 25 { app_admin_main(frame); }
		else if g == 26 { app_shop_main(frame); }
		else if g == 27 { app_social_main(frame); }
		else if g == 28 { app_chat_main(frame); }
		else if g == 29 { app_media_main(frame); }
		else if g == 30 { app_editor_main(frame); }
		else if g == 31 { app_sets_main(frame); }
		else if g == 32 { app_onboard_main(frame); }
		else if g == 33 { app_auth_main(frame); }
		else if g == 34 { app_price_main(frame); }
		else if g == 35 { app_docs_main(frame); }
		else if g == 36 { app_cal_main(frame); }
		else if g == 37 { app_kanban_main(frame); }
		else if g == 38 { app_maps_main(frame); }
		else if g == 39 { app_bank_main(frame); }
		else { app_health_main(frame); }
	} else if screen == 4 { app_list_body(frame, g); }
	else if screen == 5 { app_browse_body(frame, g); }
	else { app_sum_body(frame, g); }
	raise_app_type();
	frame
}
