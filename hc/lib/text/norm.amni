// Canonical decomposition and composition. Hangul is algorithmic (UAX #15).
// The Latin and Greek table is a one-step canonical mapping, not the whole UCD.
namespace text;
import text.utf;

var DP int[>..] = [];
var DA int[>..] = [];
var DB int[>..] = [];
var NORM_READY = false;

fn decomp_add(cp int, a int, b int) {
	DP.push(cp);
	DA.push(a);
	DB.push(b);
}

fn norm_boot() {
	if NORM_READY { return; }
	NORM_READY = true;
	let pairs = [
		0x00C0, 0x0041, 0x0300, 0x00C1, 0x0041, 0x0301, 0x00C2, 0x0041, 0x0302, 0x00C3, 0x0041, 0x0303, 0x00C4, 0x0041, 0x0308, 0x00C5, 0x0041, 0x030A,
		0x00C7, 0x0043, 0x0327, 0x00C8, 0x0045, 0x0300, 0x00C9, 0x0045, 0x0301, 0x00CA, 0x0045, 0x0302, 0x00CB, 0x0045, 0x0308,
		0x00CC, 0x0049, 0x0300, 0x00CD, 0x0049, 0x0301, 0x00CE, 0x0049, 0x0302, 0x00CF, 0x0049, 0x0308, 0x00D1, 0x004E, 0x0303,
		0x00D2, 0x004F, 0x0300, 0x00D3, 0x004F, 0x0301, 0x00D4, 0x004F, 0x0302, 0x00D5, 0x004F, 0x0303, 0x00D6, 0x004F, 0x0308,
		0x00D9, 0x0055, 0x0300, 0x00DA, 0x0055, 0x0301, 0x00DB, 0x0055, 0x0302, 0x00DC, 0x0055, 0x0308, 0x00DD, 0x0059, 0x0301,
		0x00E0, 0x0061, 0x0300, 0x00E1, 0x0061, 0x0301, 0x00E2, 0x0061, 0x0302, 0x00E3, 0x0061, 0x0303, 0x00E4, 0x0061, 0x0308, 0x00E5, 0x0061, 0x030A,
		0x00E7, 0x0063, 0x0327, 0x00E8, 0x0065, 0x0300, 0x00E9, 0x0065, 0x0301, 0x00EA, 0x0065, 0x0302, 0x00EB, 0x0065, 0x0308,
		0x00EC, 0x0069, 0x0300, 0x00ED, 0x0069, 0x0301, 0x00EE, 0x0069, 0x0302, 0x00EF, 0x0069, 0x0308, 0x00F1, 0x006E, 0x0303,
		0x00F2, 0x006F, 0x0300, 0x00F3, 0x006F, 0x0301, 0x00F4, 0x006F, 0x0302, 0x00F5, 0x006F, 0x0303, 0x00F6, 0x006F, 0x0308,
		0x00F9, 0x0075, 0x0300, 0x00FA, 0x0075, 0x0301, 0x00FB, 0x0075, 0x0302, 0x00FC, 0x0075, 0x0308, 0x00FD, 0x0079, 0x0301, 0x00FF, 0x0079, 0x0308,
		0x0100, 0x0041, 0x0304, 0x0101, 0x0061, 0x0304, 0x0102, 0x0041, 0x0306, 0x0103, 0x0061, 0x0306, 0x0104, 0x0041, 0x0328, 0x0105, 0x0061, 0x0328,
		0x0106, 0x0043, 0x0301, 0x0107, 0x0063, 0x0301, 0x0108, 0x0043, 0x0302, 0x0109, 0x0063, 0x0302, 0x010A, 0x0043, 0x0307, 0x010B, 0x0063, 0x0307,
		0x010C, 0x0043, 0x030C, 0x010D, 0x0063, 0x030C, 0x0112, 0x0045, 0x0304, 0x0113, 0x0065, 0x0304, 0x011A, 0x0045, 0x030C, 0x011B, 0x0065, 0x030C,
		0x0143, 0x004E, 0x0301, 0x0144, 0x006E, 0x0301, 0x0147, 0x004E, 0x030C, 0x0148, 0x006E, 0x030C,
		0x014C, 0x004F, 0x0304, 0x014D, 0x006F, 0x0304, 0x0150, 0x004F, 0x030B, 0x0151, 0x006F, 0x030B,
		0x015A, 0x0053, 0x0301, 0x015B, 0x0073, 0x0301, 0x0160, 0x0053, 0x030C, 0x0161, 0x0073, 0x030C, 0x015E, 0x0053, 0x0327, 0x015F, 0x0073, 0x0327,
		0x016A, 0x0055, 0x0304, 0x016B, 0x0075, 0x0304, 0x0170, 0x0055, 0x030B, 0x0171, 0x0075, 0x030B, 0x016E, 0x0055, 0x030A, 0x016F, 0x0075, 0x030A,
		0x0178, 0x0059, 0x0308, 0x0179, 0x005A, 0x0301, 0x017A, 0x007A, 0x0301, 0x017D, 0x005A, 0x030C, 0x017E, 0x007A, 0x030C,
		0x01A0, 0x004F, 0x031B, 0x01A1, 0x006F, 0x031B, 0x01AF, 0x0055, 0x031B, 0x01B0, 0x0075, 0x031B,
		0x0386, 0x0391, 0x0301, 0x0388, 0x0395, 0x0301, 0x0389, 0x0397, 0x0301, 0x038A, 0x0399, 0x0301, 0x038C, 0x039F, 0x0301, 0x038E, 0x03A5, 0x0301, 0x038F, 0x03A9, 0x0301,
		0x0390, 0x03CA, 0x0301, 0x03AA, 0x0399, 0x0308, 0x03AB, 0x03A5, 0x0308,
		0x03AC, 0x03B1, 0x0301, 0x03AD, 0x03B5, 0x0301, 0x03AE, 0x03B7, 0x0301, 0x03AF, 0x03B9, 0x0301,
		0x03B0, 0x03CB, 0x0301, 0x03CA, 0x03B9, 0x0308, 0x03CB, 0x03C5, 0x0308, 0x03CC, 0x03BF, 0x0301, 0x03CD, 0x03C5, 0x0301, 0x03CE, 0x03C9, 0x0301
	];
	var i = 0;
	while i + 2 < pairs.len { decomp_add(pairs[i], pairs[i + 1], pairs[i + 2]); i += 3; }
}

fn decomp_find(cp int) int {
	var lo = 0;
	var hi = DP.len;
	while lo < hi {
		let mid = (lo + hi) / 2;
		if DP[mid] == cp { return mid; }
		if DP[mid] < cp { lo = mid + 1; } else { hi = mid; }
	}
	-1
}

fn hangul_decomp(cp int, out int[>..]&) bool {
	if cp < 0xAC00 || cp > 0xD7A3 { return false; }
	let s = cp - 0xAC00;
	let l = 0x1100 + s / 588;
	let v = 0x1161 + (s % 588) / 28;
	let t = s % 28;
	out.push(l);
	out.push(v);
	if t != 0 { out.push(0x11A7 + t); }
	true
}

recursive fn decompose_into(cp int, out int[>..]&) {
	if hangul_decomp(cp, out) { return; }
	let ix = decomp_find(cp);
	if ix >= 0 { decompose_into(DA[ix], out); decompose_into(DB[ix], out); return; }
	out.push(cp);
}

fn reorder(xs int[>..]&) {
	var i = 0;
	while i < xs.len {
		if ccc(xs[i]) == 0 { i += 1; continue; }
		var j = i;
		while j < xs.len && ccc(xs[j]) != 0 { j += 1; }
		var a = i + 1;
		while a < j {
			var b = a;
			while b > i && ccc(xs[b]) < ccc(xs[b - 1]) {
				let t = xs[b];
				xs[b] = xs[b - 1];
				xs[b - 1] = t;
				b -= 1;
			}
			a += 1;
		}
		i = j;
	}
}

fn to_cps(s const byte[:], out int[>..]&) {
	out.clear();
	var i = 0;
	while i < s.len {
		let cp, n = utf8_next(s, i);
		out.push(cp);
		i += n;
	}
}

fn from_cps(xs int[:]) byte[>..] {
	var out byte[>..] = [];
	for cp in xs { utf8_put(out, cp); }
	out
}

fn nfd_cps(s const byte[:], out int[>..]&) {
	norm_boot();
	var raw int[>..] = [];
	to_cps(s, raw);
	out.clear();
	for cp in raw { decompose_into(cp, out); }
	reorder(out);
}

fn nfd(s const byte[:]) byte[>..] {
	var xs int[>..] = [];
	nfd_cps(s, xs);
	from_cps(xs[..])
}

fn compose_pair(a int, b int) int {
	if a >= 0x1100 && a < 0x1100 + 19 && b >= 0x1161 && b < 0x1161 + 21 {
		return 0xAC00 + ((a - 0x1100) * 21 + (b - 0x1161)) * 28;
	}
	if a >= 0xAC00 && a <= 0xD7A3 {
		let si = a - 0xAC00;
		if si % 28 == 0 && b > 0x11A7 && b < 0x11A7 + 28 { return a + (b - 0x11A7); }
	}
	for i in DP.len { if DA[i] == a && DB[i] == b { return DP[i]; } }
	0
}

fn nfc(s const byte[:]) byte[>..] {
	var xs int[>..] = [];
	nfd_cps(s, xs);
	var out int[>..] = [];
	var starter = -1;
	var last = 0;
	for cp in xs {
		if starter >= 0 {
			let comp = compose_pair(out[starter], cp);
			let hangul = comp >= 0xAC00 && comp <= 0xD7A3;
			if comp != 0 && (hangul && last == 0 || last < ccc(cp)) { out[starter] = comp; continue; }
		}
		out.push(cp);
		if ccc(cp) == 0 { starter = out.len - 1; last = 0; } else { last = ccc(cp); }
	}
	from_cps(out[..])
}
