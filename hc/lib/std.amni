fn min<T>(a T, b T) T { if b < a { return b; } return a; }
fn max<T>(a T, b T) T { if a < b { return b; } return a; }
fn clamp<T>(x T, lo T, hi T) T {
	if x < lo { return lo; }
	if hi < x { return hi; }
	return x;
}
fn abs<T>(x T) T { if x < 0 { return -x; } return x; }
fn abs(x f32) f32 { if x < 0.0 { return -x; } return x; }
fn abs(x real) real { if x < 0.0 { return -x; } return x; }
fn rem<T>(a T, b T) T {
	if b < 0 && ~b == 0 { return 0; }
	return a - (a / b) * b;
}
fn div_euclid<T>(a T, b T) T {
	let q = a / b;
	if rem(a, b) < 0 {
		if b > 0 { return q - 1; }
		return q + 1;
	}
	return q;
}
fn sign<T>(x T) T {
	if x < 0 { return -1; }
	if 0 < x { return 1; }
	return 0;
}
fn sign(x f32) f32 {
	if x < 0.0 { return -1.0; }
	if 0.0 < x { return 1.0; }
	return 0.0;
}
fn sign(x real) real {
	if x < 0.0 { return -1.0; }
	if 0.0 < x { return 1.0; }
	return 0.0;
}
fn lerp(a f32, b f32, t f32) f32 { a + (b - a) * t }
fn lerp(a real, b real, t real) real { a + (b - a) * t }
fn next_pow2(x int) int {
	var p = 1;
	while p < x { p = p * 2; }
	return p;
}
extern fn popcount(x uint) int = "hr_popcount";
extern fn clz(x uint) int = "hr_clz";
extern fn ctz(x uint) int = "hr_ctz";
fn swap<T>(a T&, b T&) {
	let t = a;
	a = b;
	b = t;
}
fn hash_mix(x uint) uint {
	var h = x * 11400714819323198485;
	h = h ^ (h >> 32);
	return h;
}
fn hash(x i8) uint { hash_mix(x as! uint) }
fn hash(x i16) uint { hash_mix(x as! uint) }
fn hash(x i32) uint { hash_mix(x as! uint) }
fn hash(x int) uint { hash_mix(x as! uint) }
fn hash(x byte) uint { hash_mix(x) }
fn hash(x u16) uint { hash_mix(x) }
fn hash(x u32) uint { hash_mix(x) }
fn hash(x uint) uint { hash_mix(x) }
fn hash(x bool) uint { if x { return hash_mix(1); } return hash_mix(2); }
fn hash(x f32) uint { hash_mix((x * 65536.0) as! uint) }
fn hash(x real) uint { hash_mix((x * 65536.0) as! uint) }
fn hash_le64(s byte[:], i int) uint {
	let c = s[i..i + 8];
	c[0] | (c[1] as uint) << 8 | (c[2] as uint) << 16 | (c[3] as uint) << 24 |
		(c[4] as uint) << 32 | (c[5] as uint) << 40 | (c[6] as uint) << 48 | (c[7] as uint) << 56
}
fn hash_le32(s byte[:], i int) uint {
	let c = s[i..i + 4];
	c[0] | (c[1] as uint) << 8 | (c[2] as uint) << 16 | (c[3] as uint) << 24
}
fn hash(s byte[:]) uint {
	let n = s.len;
	if n > 24 { return hash_lanes(s); }
	var h = (n as! uint) * 11400714819323198485;
	var w uint = 0;
	if n > 8 {
		var i = 0;
		while i < n - 8 {
			h = (h ^ hash_le64(s, i)) * 11400714819323198485;
			h = (h << 29) | (h >> 35);
			i += 8;
		}
		w = hash_le64(s, n - 8);
	} else if n >= 4 {
		w = hash_le32(s, 0) | hash_le32(s, n - 4) << 32;
	} else if n > 0 {
		w = s[0] | (s[n >> 1] as uint) << 8 | (s[n - 1] as uint) << 16;
	}
	h = (h ^ w) * 11400714819323198485;
	h = (h ^ (h >> 32)) * 15485907386658061715;
	return h ^ (h >> 32);
}
fn hash_lanes(s byte[:]) uint {
	let n = s.len;
	var h = (n as! uint) * 11400714819323198485;
	var g = h ^ 0x9E3779B97F4A7C15;
	var i = 0;
	while i < n - 24 {
		h = (h ^ hash_le64(s, i)) * 11400714819323198485;
		h = (h << 29) | (h >> 35);
		g = (g ^ hash_le64(s, i + 8)) * 11400714819323198485;
		g = (g << 29) | (g >> 35);
		i += 16;
	}
	h = h ^ ((g << 31) | (g >> 33));
	while i < n - 8 {
		h = (h ^ hash_le64(s, i)) * 11400714819323198485;
		h = (h << 29) | (h >> 35);
		i += 8;
	}
	h = (h ^ hash_le64(s, n - 8)) * 11400714819323198485;
	h = (h ^ (h >> 32)) * 15485907386658061715;
	return h ^ (h >> 32);
}
fn hash_combine(seed uint, h uint) uint {
	seed ^ (h + 11400714819323198485 + (seed << 6) + (seed >> 2))
}
struct rng { s uint }
fn rand_u64(r rng&) uint {
	r.s = r.s + 11400714819323198485;
	var z = r.s;
	z = (z ^ (z >> 30)) * 13787848793156543929;
	z = (z ^ (z >> 27)) * 10723151780598845931;
	return z ^ (z >> 31);
}
fn rand_int(r rng&, n int) int { (rand_u64(r) % (n as uint)) as int }
fn rand_flt(r rng&) real { (rand_u64(r) >> 11) * (1.0 / 9007199254740992.0) }
fn shuffle<T>(xs T[:], r rng&) {
	var i = xs.len - 1;
	while i > 0 {
		let j = rand_int(r, i + 1);
		let t T = xs[i];
		xs[i] .= xs[j];
		xs[j] .= t;
		i -= 1;
	}
}
fn swap_at<T>(xs T[:], i int, j int) {
	let t T = xs[i];
	xs[i] .= xs[j];
	xs[j] .= t;
}
fn each_rev<T, F>(xs T[:]) {
	var i = xs.len;
	while i > 0 {
		i -= 1;
		F(xs[i]);
	}
}
fn each_chunk<T, F>(xs T[:], n int) {
	var i = 0;
	var k = 0;
	while i < xs.len {
		let e = min(i + n, xs.len);
		F(xs[i..e], k);
		i = e;
		k += 1;
	}
}
fn find<T, F>(xs T[:]) T? {
	for &x in xs { if F(x) { return x; } }
	return null;
}
fn find_index<T, F>(xs T[:]) int {
	for x, i in xs { if F(x) { return i; } }
	return -1;
}
fn position<T>(xs T[:], v T) int {
	for x, i in xs { if x == v { return i; } }
	return -1;
}
fn contains<T>(xs T[:], v T) bool { position(xs, v) >= 0 }
fn any<T, F>(xs T[:]) bool {
	for x in xs { if F(x) { return true; } }
	return false;
}
fn all<T, F>(xs T[:]) bool {
	for x in xs { if !F(x) { return false; } }
	return true;
}
fn count<T, F>(xs T[:]) int {
	var n = 0;
	for x in xs { if F(x) { n += 1; } }
	return n;
}
fn min<T>(xs T[:]) T {
	assert(xs.len > 0);
	var m = xs[0];
	for x in xs { if x < m { m = x; } }
	return m;
}
fn min<T, F>(xs T[:]) T {
	assert(xs.len > 0);
	var m = xs[0];
	for x in xs { if F(x, m) { m = x; } }
	return m;
}
fn max<T>(xs T[:]) T {
	assert(xs.len > 0);
	var m = xs[0];
	for x in xs { if m < x { m = x; } }
	return m;
}
fn max<T, F>(xs T[:]) T {
	assert(xs.len > 0);
	var m = xs[0];
	for x in xs { if F(m, x) { m = x; } }
	return m;
}
fn min_by<T, F>(xs T[:]) int {
	if xs.len == 0 { return -1; }
	var best = 0;
	var bk = F(xs[0]);
	for x, i in xs {
		let k = F(x);
		if k < bk { bk = k; best = i; }
	}
	return best;
}
fn max_by<T, F>(xs T[:]) int {
	if xs.len == 0 { return -1; }
	var best = 0;
	var bk = F(xs[0]);
	for x, i in xs {
		let k = F(x);
		if bk < k { bk = k; best = i; }
	}
	return best;
}
fn last<T>(xs T[:]) T& {
	assert(xs.len > 0);
	xs[xs.len - 1]
}
fn lower_bound<T, F>(xs T[:]) int {
	var lo = 0;
	var hi = xs.len;
	while lo < hi {
		let mid = lo + (hi - lo) / 2;
		if F(xs[mid]) { lo = mid + 1; } else { hi = mid; }
	}
	return lo;
}
fn binary_search<T>(xs T[:], v T) int, bool {
	var lo = 0;
	var hi = xs.len;
	while lo < hi {
		let mid = lo + (hi - lo) / 2;
		if xs[mid] < v { lo = mid + 1; } else { hi = mid; }
	}
	return lo, lo < xs.len && xs[lo] == v;
}
fn find<T>(xs T[:], sub T[:]) int {
	if sub.len == 0 { return 0; }
	var i = 0;
	while i + sub.len <= xs.len {
		if xs[i] == sub[0] && xs[i..i + sub.len] == sub { return i; }
		i += 1;
	}
	return -1;
}
fn rfind<T>(xs T[:], sub T[:]) int {
	if sub.len == 0 { return xs.len; }
	if sub.len > xs.len { return -1; }
	var i = xs.len - sub.len;
	while i >= 0 {
		if xs[i] == sub[0] && xs[i..i + sub.len] == sub { return i; }
		i -= 1;
	}
	return -1;
}
fn starts_with<T>(xs T[:], p T[:]) bool { p.len <= xs.len && xs[..p.len] == p }
fn ends_with<T>(xs T[:], p T[:]) bool { p.len <= xs.len && xs[xs.len - p.len..] == p }
struct ByteSet {
	members bool[256],
	kind byte,
	invert bool,
	bytes byte[3],
	lo byte[16],
	hi byte[16],
}
fn byte_set(members bool[256]) ByteSet {
	var n = 0;
	for m in members { if m { n += 1; } }
	var s = ByteSet { members: members, kind: 5, invert: false, bytes: [0; 3], lo: [0; 16],
					  hi: [0; 16] };
	for b in 256 {
		if members[b] {
			let bit = (1 << ((b >> 4) & 7)) as byte;
			if b < 128 { s.lo[b & 15] |= bit; } else { s.hi[b & 15] |= bit; }
		}
	}
	let invert = n > 128;
	var k = 0;
	var first = 0;
	var last = 0;
	for b in 256 {
		if members[b] != invert {
			if k == 0 { first = b; }
			if k < 3 { s.bytes[k] = b as byte; }
			last = b;
			k += 1;
		}
	}
	if k <= 3 {
		s.kind = k as byte;
		s.invert = invert;
		for j in k..3 { s.bytes[j] = s.bytes[0]; }
	} else if last - first + 1 == k {
		s.kind = 4;
		s.invert = invert;
		s.bytes[0] = first as byte;
		s.bytes[1] = (last - first) as byte;
	}
	return s;
}
fn byte_set(bytes byte[:]) ByteSet {
	var members bool[256] = [false; 256];
	for b in bytes { members[b] = true; }
	return byte_set(members);
}
extern fn find_any(s const byte[:], set const ByteSet&) int = "hr_find_any";
extern fn byte_set_pair(s const byte[:], a const ByteSet&, d int,
						  b const ByteSet&) int = "hr_find_pair";
fn find_pair(s byte[:], a const ByteSet&, d int, b const ByteSet&) int {
	assert(d >= 0);
	return byte_set_pair(s, a, d, b);
}
fn map<T, F>(xs T[:]) {
	var out = [];
	for x in xs { out.push(F(x)); }
	return out;
}
fn filter<T, F>(xs T[:]) T[>..] {
	var out T[>..] = [];
	for x in xs { if F(x) { out.push(copy(x)); } }
	return out;
}
fn fold<T, A, F>(xs T[:], acc A) A {
	var a = acc;
	for x in xs { a = F(a, x); }
	return a;
}
fn sum<T>(xs T[:]) T {
	var s = default<T>();
	for x in xs { s += x; }
	return s;
}
fn concat<T>(a T[:], b T[:]) T[>..] {
	var out T[>..] = [];
	out.append(a);
	out.append(b);
	return out;
}
fn fill<T>(xs T[:], v T) { for i in xs.len { xs[i] .= v; } }
fn copy_into<T>(dst T[:], src T[:]) {
	assert(dst.len == src.len);
	for i in dst.len { dst[i] .= src[i]; }
}
fn reverse<T>(xs T[:]) {
	var i = 0;
	var j = xs.len - 1;
	while i < j {
		swap_at(xs, i, j);
		i += 1;
		j -= 1;
	}
}
fn to_lower(s byte[:]) { for &c in s { if c >= 'A' && c <= 'Z' { c += 32; } } }
fn to_upper(s byte[:]) { for &c in s { if c >= 'a' && c <= 'z' { c -= 32; } } }
fn sort_insertion<T, F>(v T[:]) {
	for i in 1..v.len {
		let x T = v[i];
		var j = i;
		while j > 0 {
			let y T = v[j - 1];
			if !F(x, y) { break; }
			v[j] .= y;
			j -= 1;
		}
		v[j] .= x;
	}
}
fn sort_run<T, F>(v T[:]) int {
	if v.len < 2 { return v.len; }
	var e = 2;
	if F(v[1], v[0]) {
		while e < v.len {
			if !F(v[e], v[e - 1]) { break; }
			e += 1;
		}
		reverse(v[..e]);
	} else {
		while e < v.len {
			if F(v[e], v[e - 1]) { break; }
			e += 1;
		}
	}
	return e;
}
fn sort_median3<T, F>(v T[:], a int, b int, c int) int {
	let x = F(v[a], v[b]);
	if x != F(v[a], v[c]) { return a; }
	if F(v[b], v[c]) != x { return c; }
	return b;
}
fn sort_pivot<T, F>(v T[:]) int {
	let n8 = v.len / 8;
	let a = 0;
	let b = n8 * 4;
	let c = n8 * 7;
	if v.len < 128 { return sort_median3(v, a, b, c) { x, y => F(x, y) }; }
	let m8 = n8 / 8;
	let ma = sort_median3(v, a, a + m8 * 4, a + m8 * 7) { x, y => F(x, y) };
	let mb = sort_median3(v, b, b + m8 * 4, b + m8 * 7) { x, y => F(x, y) };
	let mc = sort_median3(v, c, c + m8 * 4, c + m8 * 7) { x, y => F(x, y) };
	return sort_median3(v, ma, mb, mc) { x, y => F(x, y) };
}
fn sort_partition<T, F>(v T[:]) int {
	let p T = v[0];
	var lt = 1;
	for i in 1..v.len {
		let x T = v[i];
		v[i] .= v[lt];
		v[lt] .= x;
		lt += if F(x, p) { 1 } else { 0 };
	}
	return lt - 1;
}
fn sort_heap<T, F>(v T[:]) {
	var i = v.len / 2;
	while i > 0 {
		i -= 1;
		sift_down(v, i) { a, b => F(b, a) };
	}
	var end = v.len;
	while end > 1 {
		end -= 1;
		swap_at(v, 0, end);
		sift_down(v[..end], 0) { a, b => F(b, a) };
	}
}
fn sort<T>(xs T[:]) { sort(xs) { a, b => a < b } }
fn sort<T, F>(xs T[:]) {
	let n = xs.len;
	if n <= 10 {
		sort_insertion(xs) { a, b => F(a, b) };
		return;
	}
	let r = sort_run(xs) { a, b => F(a, b) };
	if r == n { return; }
	var limit = 2 * (63 - clz(n as uint));
	var st int[..144] = [];
	var lo = 0;
	var hi = n;
	loop {
		let v = xs[lo..hi];
		if v.len > 10 && limit > 0 {
			limit -= 1;
			swap_at(v, 0, sort_pivot(v) { a, b => F(a, b) });
			if lo > 0 && !F(xs[lo - 1], v[0]) {
				let m = sort_partition(v) { a, b => !F(b, a) };
				swap_at(v, 0, m);
				lo += m + 1;
				continue;
			}
			let m = sort_partition(v) { a, b => F(a, b) };
			swap_at(v, 0, m);
			if m < v.len - 1 - m {
				st.push(lo + m + 1);
				st.push(hi);
				st.push(limit);
				hi = lo + m;
			} else {
				st.push(lo);
				st.push(lo + m);
				st.push(limit);
				lo += m + 1;
			}
			continue;
		}
		if v.len > 10 {
			sort_heap(v) { a, b => F(a, b) };
		} else {
			sort_insertion(v) { a, b => F(a, b) };
		}
		if st.len == 0 { return; }
		limit = st.pop();
		hi = st.pop();
		lo = st.pop();
	}
}
fn sort_merge<T, F>(l T[:], r T[:], d T[:], chaotic bool&) {
	if !F(r[0], l[l.len - 1]) {
		copy_into(d[..l.len], l);
		copy_into(d[l.len..], r);
		return;
	}
	var a = 0;
	var b = 0;
	var k = 0;
	var switches = 0;
	var last_r = false;
	if chaotic {
		while a < l.len && b < r.len {
			let take_r = F(r[b], l[a]);
			d[k] .= if take_r { r[b] } else { l[a] };
			if take_r { b += 1; } else { a += 1; }
			if take_r != last_r { switches += 1; }
			last_r = take_r;
			k += 1;
		}
	} else {
		while a < l.len && b < r.len {
			if F(r[b], l[a]) {
				d[k] .= r[b];
				b += 1;
				if !last_r { switches += 1; }
				last_r = true;
			} else {
				d[k] .= l[a];
				a += 1;
				if last_r { switches += 1; }
				last_r = false;
			}
			k += 1;
		}
	}
	chaotic = switches * 4 > k;
	if a < l.len {
		copy_into(d[k..], l[a..]);
	} else {
		copy_into(d[k..], r[b..]);
	}
}
fn stable_sort<T>(xs T[:]) { stable_sort(xs) { a, b => a < b } }
fn stable_sort<T, F>(xs T[:]) {
	let n = xs.len;
	if n <= 20 {
		sort_insertion(xs) { a, b => F(a, b) };
		return;
	}
	var r = sort_run(xs) { a, b => F(a, b) };
	if r == n { return; }
	var ends int[>..] = [];
	var lo = 0;
	loop {
		let v = xs[lo..];
		if r < 16 && r < v.len {
			r = min(16, v.len);
			sort_insertion(v[..r]) { a, b => F(a, b) };
		}
		lo += r;
		ends.push(lo);
		if lo >= n { break; }
		r = sort_run(xs[lo..]) { a, b => F(a, b) };
	}
	var tmp T[>..] = [];
	tmp.append(xs);
	var passes = 0;
	var runs = ends.len;
	while runs > 1 {
		runs = (runs + 1) / 2;
		passes += 1;
	}
	var into_tmp = passes % 2 == 0;
	var chaotic = true;
	while ends.len > 1 {
		let src T[:] = if into_tmp { xs } else { tmp };
		let dst T[:] = if into_tmp { tmp } else { xs };
		var start = 0;
		var w = 0;
		var i = 0;
		while i < ends.len {
			let mid = ends[i];
			var end = mid;
			if i + 1 < ends.len {
				end = ends[i + 1];
				sort_merge(src[start..mid], src[mid..end], dst[start..end], chaotic) { a, b => F(a, b) };
			} else {
				copy_into(dst[start..end], src[start..end]);
			}
			ends[w] = end;
			w += 1;
			start = end;
			i += 2;
		}
		ends.resize(w);
		into_tmp = !into_tmp;
	}
}
fn push_n<A, T>(xs A&, v T, n int) { for i in n { xs.push(v); } }
fn insert_at<A, T>(xs A&, i int, v T) {
	xs.push(v);
	var j = xs.len - 1;
	while j > i {
		xs[j] .= xs[j - 1];
		j -= 1;
	}
	xs[i] .= v;
}
fn remove_at<A>(xs A&, i int) {
	let v = xs[i];
	var j = i;
	while j + 1 < xs.len {
		xs[j] .= xs[j + 1];
		j += 1;
	}
	xs.pop();
	return v;
}
fn swap_remove<A>(xs A&, i int) {
	let v = xs[i];
	xs[i] .= xs[xs.len - 1];
	xs.pop();
	return v;
}
fn retain<A, F>(xs A&) {
	var w = 0;
	for i in xs.len {
		if F(xs[i]) {
			xs[w] .= xs[i];
			w += 1;
		}
	}
	xs.resize(w);
}
fn dedup<A>(xs A&) {
	if xs.len == 0 { return; }
	var w = 1;
	var i = 1;
	while i < xs.len {
		if !(xs[i] == xs[w - 1]) {
			xs[w] .= xs[i];
			w += 1;
		}
		i += 1;
	}
	xs.resize(w);
}
fn heap_push<A, T>(xs A&, v T) { heap_push(xs, v) { a, b => a < b } }
fn heap_push<A, T, F>(xs A&, v T) {
	xs.push(v);
	sift_up(xs, xs.len - 1) { a, b => F(a, b) };
}
fn sift_up<T, F>(xs T[:], start int) {
	var i = start;
	let x T = xs[i];
	while i > 0 {
		let p = (i - 1) / 2;
		if !F(x, xs[p]) { break; }
		xs[i] .= xs[p];
		i = p;
	}
	xs[i] .= x;
}
fn sift_down<T, F>(xs T[:], start int) {
	let n = xs.len;
	var i = start;
	if 2 * i + 1 >= n { return; }
	let x T = xs[i];
	loop {
		let l = 2 * i + 1;
		if l >= n { break; }
		var m = l;
		let r = l + 1;
		if r < n && F(xs[r], xs[l]) { m = r; }
		if !F(xs[m], x) { break; }
		xs[i] .= xs[m];
		i = m;
	}
	xs[i] .= x;
}
fn heap_pop<A>(xs A&) { heap_pop(xs) { a, b => a < b } }
fn heap_pop<A, F>(xs A&) {
	let top = xs[0];
	sift_hole(xs) { a, b => F(a, b) };
	xs.pop();
	return top;
}
fn sift_hole<T, F>(xs T[:]) {
	let n = xs.len - 1;
	if n == 0 { return; }
	let x T = xs[n];
	var i = 0;
	var c = 1;
	while c < n - 1 {
		if F(xs[c + 1], xs[c]) { c += 1; }
		xs[i] .= xs[c];
		i = c;
		c = 2 * c + 1;
	}
	if c == n - 1 {
		xs[i] .= xs[c];
		i = c;
	}
	while i > 0 {
		let p = (i - 1) / 2;
		if F(xs[p], x) { break; }
		xs[i] .= xs[p];
		i = p;
	}
	xs[i] .= x;
}
fn make_heap<A>(xs A&) { make_heap(xs) { a, b => a < b } }
fn make_heap<A, F>(xs A&) {
	var i = xs.len / 2;
	while i > 0 {
		i -= 1;
		sift_down(xs, i) { a, b => F(a, b) };
	}
}
fn format_uint<B>(out B&, v uint, base int, width int, padc byte) {
	if base == 10 {
		if width > 1 {
			var n = 1;
			var x = v;
			while x >= 10 {
				x /= 10;
				n += 1;
			}
			var padn = width - n;
			while padn > 0 {
				out.push(padc);
				padn -= 1;
			}
		}
		format(out, v);
		return;
	}
	var digits byte[..64] = [];
	var x = v;
	if x == 0 { digits.push('0'); }
	let b = base as uint;
	while x > 0 {
		let d = (x % b) as int;
		var c byte = 0;
		if d < 10 { c = ('0' + d) as byte; } else { c = ('a' + d - 10) as byte; }
		digits.push(c);
		x = x / b;
	}
	var padn = width - digits.len;
	while padn > 0 {
		out.push(padc);
		padn -= 1;
	}
	each_rev(digits) { out.push(it); };
}
fn format_int<B>(out B&, v int, base int, width int, padc byte) {
	if v < 0 {
		out.push('-');
		format_uint(out, 0 - v as! uint, base, width - 1, padc);
	} else {
		format_uint(out, v as uint, base, width, padc);
	}
}
fn format_uleb(out byte[>..]&, v int) {
	var x = v as uint;
	loop {
		let b = (x & 0x7f) as byte;
		x >>= 7;
		if x == 0 { out.push(b); return; }
		out.push(b | 0x80);
	}
}
fn parse_uleb(s byte[:]) int, int {
	var v = 0 as uint;
	var shift = 0;
	var i = 0;
	while i < s.len && i < 10 {
		let b = s[i];
		if shift > 63 || (shift == 63 && (b & 0x7e) != 0) { return 0, 0; }
		v |= (b & 0x7f) as uint << shift;
		i++;
		if b < 0x80 { return v as int, i; }
		shift += 7;
	}
	return 0, 0;
}
extern fn flt_floor(x real) real = "floor";
extern fn flt_fma(x real, y real, z real) real = "fma";
fn format_flt(out byte[>..]&, v real, decimals int) {
	if v != v || v - v != 0.0 {
		format(out, v);
		return;
	}
	var x = v;
	if x < 0.0 {
		out.push('-');
		x = -x;
	}
	var scale = 1.0;
	for i in decimals { scale *= 10.0; }
	var f = flt_floor(x * scale);
	if decimals <= 22 && f < 4503599627370496.0 {
		if flt_fma(x, scale, -f) < 0.0 { f -= 1.0; }
		let t = flt_fma(x, scale, -(f + 0.5));
		if t > 0.0 || (t == 0.0 && f % 2.0 != 0.0) { f += 1.0; }
	} else {
		f = flt_floor(x * scale + 0.5);
	}
	let scaled = f as! int;
	let iscale = scale as int;
	format_uint(out, (scaled / iscale) as uint, 10, 0, ' ');
	if decimals > 0 {
		out.push('.');
		format_uint(out, (scaled % iscale) as uint, 10, decimals, '0');
	}
}
fn parse_int(s byte[:], base int = 10) int, bool {
	var i = 0;
	var neg = false;
	if s.len > 0 && (s[0] == '-' || s[0] == '+') {
		neg = s[0] == '-';
		i = 1;
	}
	if i >= s.len { return 0, false; }
	let min = -9223372036854775807 - 1;
	var v = 0;
	while i < s.len {
		let c = s[i] as int;
		var d = -1;
		if c >= '0' && c <= '9' { d = c - '0'; }
		else if c >= 'a' && c <= 'z' { d = c - 'a' + 10; }
		else if c >= 'A' && c <= 'Z' { d = c - 'A' + 10; }
		if d < 0 || d >= base { return 0, false; }
		if v < (min + d) / base { return 0, false; }
		v = v * base - d;
		i += 1;
	}
	if !neg {
		if v == min { return 0, false; }
		v = -v;
	}
	return v, true;
}
const parse_flt_pow10: real[23] = [1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
								  1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22];
fn parse_flt(s byte[:]) real, bool {
	var i = 0;
	var neg = false;
	if s.len > 0 && (s[0] == '-' || s[0] == '+') {
		neg = s[0] == '-';
		i = 1;
	}
	let start = i;
	var mant uint = 0;
	while i < s.len {
		let d = s[i] - '0';
		if d >= 10 { break; }
		mant = mant * 10 + d;
		i += 1;
	}
	var digits = i - start;
	var exp10 = 0;
	if i < s.len && s[i] == '.' {
		i += 1;
		let fstart = i;
		while i < s.len {
			let d = s[i] - '0';
			if d >= 10 { break; }
			mant = mant * 10 + d;
			i += 1;
		}
		exp10 = fstart - i;
		digits -= exp10;
	}
	if digits == 0 { return 0.0, false; }
	if digits <= 19 && i == s.len {
		var v = 0.0;
		if digits <= 18 { v = mant as! int; } else { v = mant; }
		if exp10 < 0 { v /= parse_flt_pow10[-exp10]; }
		if neg { v = -v; }
		return v, true;
	}
	if digits > 19 {
		mant = 0;
		exp10 = 0;
		var mdigits = 0;
		var j = start;
		while j < s.len && s[j] == '0' { j += 1; }
		while j < s.len && s[j] - '0' < 10 {
			if mdigits < 19 { mant = mant * 10 + (s[j] - '0'); mdigits += 1; }
			else { exp10 += 1; }
			j += 1;
		}
		if j < s.len && s[j] == '.' {
			j += 1;
			if mant == 0 {
				while j < s.len && s[j] == '0' { exp10 -= 1; j += 1; }
			}
			while j < s.len && s[j] - '0' < 10 {
				if mdigits < 19 { mant = mant * 10 + (s[j] - '0'); mdigits += 1; exp10 -= 1; }
				j += 1;
			}
		}
	}
	if i < s.len && (s[i] == 'e' || s[i] == 'E') {
		i += 1;
		var eneg = false;
		if i < s.len && (s[i] == '-' || s[i] == '+') {
			eneg = s[i] == '-';
			i += 1;
		}
		var e = 0;
		var edigits = 0;
		while i < s.len && s[i] >= '0' && s[i] <= '9' {
			if e < 100000 { e = e * 10 + (s[i] - '0'); }
			edigits += 1;
			i += 1;
		}
		if edigits == 0 { return 0.0, false; }
		exp10 += if eneg { -e } else { e };
	}
	var v real = mant;
	var e = exp10;
	while e > 22 { v *= 1e22; e -= 22; }
	while e < -22 { v /= 1e22; e += 22; }
	if e > 0 { v *= parse_flt_pow10[e]; } else if e < 0 { v /= parse_flt_pow10[-e]; }
	if i != s.len { return 0.0, false; }
	if neg { v = -v; }
	return v, true;
}
fn compare(a byte[:], b byte[:]) int {
	let n = min(a.len, b.len);
	for i in n {
		if a[i] < b[i] { return -1; }
		if b[i] < a[i] { return 1; }
	}
	if a.len < b.len { return -1; }
	if b.len < a.len { return 1; }
	return 0;
}
fn is_space(c byte) bool { c == ' ' || c == '\t' || c == '\n' || c == '\r' }
fn trim_start(s byte[:]) byte[:] {
	var i = 0;
	while i < s.len && is_space(s[i]) { i += 1; }
	return s[i..];
}
fn trim_end(s byte[:]) byte[:] {
	var e = s.len;
	while e > 0 && is_space(s[e - 1]) { e -= 1; }
	return s[..e];
}
fn trim(s byte[:]) byte[:] { trim_end(trim_start(s)) }
fn split(s byte[:], sep byte) const byte[:][>..] {
	var out const byte[:][>..] = [];
	var start = 0;
	for c, i in s {
		if c == sep {
			out.push(s[start..i]);
			start = i + 1;
		}
	}
	out.push(s[start..]);
	return out;
}
fn split(s byte[:], sep byte[:]) const byte[:][>..] {
	var out const byte[:][>..] = [];
	if sep.len == 0 {
		out.push(s);
		return out;
	}
	var start = 0;
	var i = 0;
	while i + sep.len <= s.len {
		if s[i..i + sep.len] == sep {
			out.push(s[start..i]);
			i += sep.len;
			start = i;
		} else {
			i += 1;
		}
	}
	out.push(s[start..]);
	return out;
}
fn each_split<F>(s byte[:], sep byte) {
	var start = 0;
	for c, i in s {
		if c == sep {
			F(s[start..i]);
			start = i + 1;
		}
	}
	F(s[start..]);
}
fn each_split<F>(s byte[:], sep byte[:]) {
	if sep.len == 0 {
		F(s);
		return;
	}
	var start = 0;
	var i = 0;
	while i + sep.len <= s.len {
		if s[i..i + sep.len] == sep {
			F(s[start..i]);
			i += sep.len;
			start = i;
		} else {
			i += 1;
		}
	}
	F(s[start..]);
}
fn words(s byte[:]) const byte[:][>..] {
	var out const byte[:][>..] = [];
	var i = 0;
	while i < s.len {
		while i < s.len && is_space(s[i]) { i += 1; }
		let start = i;
		while i < s.len && !is_space(s[i]) { i += 1; }
		if i > start { out.push(s[start..i]); }
	}
	return out;
}
fn each_word<F>(s byte[:]) {
	var i = 0;
	while i < s.len {
		while i < s.len && is_space(s[i]) { i += 1; }
		let start = i;
		while i < s.len && !is_space(s[i]) { i += 1; }
		if i > start { F(s[start..i]); }
	}
}
fn join<T>(out byte[>..]&, parts T[:], sep byte[:]) {
	for p, i in parts {
		if i > 0 { out.append(sep); }
		out.append(p);
	}
}
fn format_replaced(out byte[>..]&, s byte[:], old byte[:], with byte[:]) {
	if old.len == 0 {
		out.append(s);
		return;
	}
	var start = 0;
	var i = 0;
	while i + old.len <= s.len {
		if s[i..i + old.len] == old {
			out.append(s[start..i]);
			out.append(with);
			i += old.len;
			start = i;
		} else {
			i += 1;
		}
	}
	out.append(s[start..]);
}
fn each_utf8<F>(s byte[:]) {
	var i = 0;
	while i < s.len {
		let b = s[i] as int;
		var cp = 0xFFFD;
		var n = 1;
		if b < 0x80 {
			cp = b;
		} else if b >= 0xC0 && b < 0xE0 && i + 1 < s.len {
			cp = ((b & 0x1F) << 6) | ((s[i + 1] as int) & 0x3F);
			n = 2;
		} else if b >= 0xE0 && b < 0xF0 && i + 2 < s.len {
			cp = ((b & 0x0F) << 12) | (((s[i + 1] as int) & 0x3F) << 6) |
				 ((s[i + 2] as int) & 0x3F);
			n = 3;
		} else if b >= 0xF0 && b < 0xF8 && i + 3 < s.len {
			cp = ((b & 0x07) << 18) | (((s[i + 1] as int) & 0x3F) << 12) |
				 (((s[i + 2] as int) & 0x3F) << 6) | ((s[i + 3] as int) & 0x3F);
			n = 4;
		}
		F(cp);
		i += n;
	}
}
fn push_utf8(out byte[>..]&, cp int) {
	if cp < 0x80 {
		out.push(cp as byte);
	} else if cp < 0x800 {
		out.push((0xC0 | (cp >> 6)) as byte);
		out.push((0x80 | (cp & 0x3F)) as byte);
	} else if cp < 0x10000 {
		out.push((0xE0 | (cp >> 12)) as byte);
		out.push((0x80 | ((cp >> 6) & 0x3F)) as byte);
		out.push((0x80 | (cp & 0x3F)) as byte);
	} else {
		out.push((0xF0 | (cp >> 18)) as byte);
		out.push((0x80 | ((cp >> 12) & 0x3F)) as byte);
		out.push((0x80 | ((cp >> 6) & 0x3F)) as byte);
		out.push((0x80 | (cp & 0x3F)) as byte);
	}
}
