import std;
extern fn trim_memory() bool = "hr_trim_memory";
extern fn read_file(path const byte[:], out byte[>..]&) bool = "hr_os_read_file";    // appends the whole file
extern fn write_file(path const byte[:], data const byte[:]) bool = "hr_os_write_file";
extern fn make_exec(path const byte[:]) bool = "hr_os_make_exec";
extern fn write_file_atomic(path const byte[:], data const byte[:]) bool = "hr_os_write_file_atomic";
extern fn append_file(path const byte[:], data const byte[:]) bool = "hr_os_append_file";
extern fn file_exists(path const byte[:]) bool = "hr_os_file_exists";    // a file, not a directory
extern fn file_mtime(path const byte[:]) int = "hr_os_file_mtime";      // seconds since the epoch, -1 if absent
extern fn delete_file(path const byte[:]) bool = "hr_os_remove_file";
extern fn rename_file(from const byte[:], to const byte[:]) bool = "hr_os_rename_file";
extern fn make_dir(path const byte[:]) bool = "hr_os_make_dir";         // true if one is there afterwards
extern fn is_dir(path const byte[:]) bool = "hr_os_is_dir";
extern fn delete_dir(path const byte[:]) bool = "hr_os_remove_dir";     // an empty one
extern fn list_dir(path const byte[:], out byte[>..]&) bool = "hr_os_list_dir";
extern fn read_line(out byte[>..]&) bool = "hr_os_read_line";  // one line of stdin, no newline; false at end
extern fn read_stdin(out byte[>..]&) = "hr_os_read_stdin";        // everything until end of input
extern fn write_stdout(s const byte[:]) = "hr_os_write_stdout";
extern fn write_stderr(s const byte[:]) = "hr_os_write_stderr";
extern fn flush_stdout() = "hr_os_flush_stdout";
extern fn arg_count() int = "hr_os_arg_count";
extern fn arg(i int, out byte[>..]&) = "hr_os_arg";            // appends argument i (0 = the program)
extern fn env(name const byte[:], out byte[>..]&) bool = "hr_os_getenv";
extern fn resource_dir(out byte[>..]&) bool = "hr_os_resource_dir";
fn resource_dir() byte[>..] {
	var out byte[>..] = [];
	if !resource_dir(out) { abort("cannot locate the application resource directory"); }
	return out;
}
var argv_text byte[>..] = [];
fn args() byte[:][>..] {
	var out byte[:][>..] = [];
	for i in arg_count() {
		let start = argv_text.len;
		arg(i, argv_text);
		out.push(argv_text[start..]);
	}
	return out;
}
extern fn time_ns() int = "hr_os_time_ns";    // wall clock, nanoseconds since the epoch
extern fn clock_ns() int = "hr_os_clock_ns";  // monotonic, high resolution
extern fn sleep_ms(ms int) = "hr_os_sleep_ms";
fn time() real { time_ns() / 1000000000.0 }
fn clock() real { clock_ns() / 1000000000.0 }
fn sleep(seconds real) { sleep_ms((seconds * 1000.0) as! int) }
extern fn random_seed() uint = "hr_os_random_u64";
