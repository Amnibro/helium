# binary: float bit patterns and bounds-checked little-endian reads from bytes.
namespace binary
use std

extern f32_bits(x f32) u32 = "hr_f32_bits"
extern f32_from_bits(bits u32) f32 = "hr_f32_from_bits"
extern f64_bits(x real) uint = "hr_f64_bits"
extern f64_from_bits(bits uint) real = "hr_f64_from_bits"

# true when bytes [at, at + size) lie inside data
fits(data const byte[:], at int, size int) bool: at >= 0 && size >= 0 && size <= data.len - at

# n bytes at `at` as an unsigned little-endian number; the caller checks bounds
gather(data const byte[:], at int, n int) uint:
	v uint ~= 0
	k ~= n
	while k > 0:
		k -= 1
		v = (v << 8) | data[at + k] as uint
	v

read_u8(data const byte[:], at int) byte, bool: if fits(data, at, 1) { return data[at], true }; return 0, false
read_u16le(data const byte[:], at int) u16, bool: if fits(data, at, 2) { return gather(data, at, 2) as u16, true }; return 0, false
read_i16le(data const byte[:], at int) i16, bool: v, ok := read_u16le(data, at); return v as! i16, ok
read_u32le(data const byte[:], at int) u32, bool: if fits(data, at, 4) { return gather(data, at, 4) as u32, true }; return 0, false
read_i32le(data const byte[:], at int) i32, bool: v, ok := read_u32le(data, at); return v as! i32, ok
read_u64le(data const byte[:], at int) uint, bool: if fits(data, at, 8) { return gather(data, at, 8), true }; return 0, false
read_f32le(data const byte[:], at int) f32, bool: v, ok := read_u32le(data, at); return f32_from_bits(v), ok
read_f64le(data const byte[:], at int) real, bool: v, ok := read_u64le(data, at); return f64_from_bits(v), ok
read_bytes(data const byte[:], at int, size int) const byte[:], bool: if fits(data, at, size) { return data[at..at + size], true }; return data[..0], false
# a fixed-width field holding a zero-padded name
read_name(data const byte[:], at int, width int) const byte[:], bool:
	field, ok := read_bytes(data, at, width)
	if !ok: return field, false
	end ~= 0
	while end < field.len && field[end] != 0: end += 1
	return field[..end], true

# a cursor over bytes that moves past what it reads
struct Reader { data const byte[:], pos int }
reader(data const byte[:]) Reader: Reader{data, 0}
remaining(r Reader&) int: r.data.len - r.pos
skip(r Reader&, size int) bool:
	if !fits(r.data, r.pos, size): return false
	r.pos += size
	true
read_u8(r Reader&) byte, bool: v, ok := read_u8(r.data, r.pos); if ok { r.pos += 1 }; return v, ok
read_u16le(r Reader&) u16, bool: v, ok := read_u16le(r.data, r.pos); if ok { r.pos += 2 }; return v, ok
read_i16le(r Reader&) i16, bool: v, ok := read_i16le(r.data, r.pos); if ok { r.pos += 2 }; return v, ok
read_u32le(r Reader&) u32, bool: v, ok := read_u32le(r.data, r.pos); if ok { r.pos += 4 }; return v, ok
read_i32le(r Reader&) i32, bool: v, ok := read_i32le(r.data, r.pos); if ok { r.pos += 4 }; return v, ok
read_u64le(r Reader&) uint, bool: v, ok := read_u64le(r.data, r.pos); if ok { r.pos += 8 }; return v, ok
read_f32le(r Reader&) f32, bool: v, ok := read_f32le(r.data, r.pos); if ok { r.pos += 4 }; return v, ok
read_f64le(r Reader&) real, bool: v, ok := read_f64le(r.data, r.pos); if ok { r.pos += 8 }; return v, ok
read_bytes(r Reader&, size int) const byte[:], bool: v, ok := read_bytes(r.data, r.pos, size); if ok { r.pos += size }; return v, ok
read_name(r Reader&, width int) const byte[:], bool: v, ok := read_name(r.data, r.pos, width); if ok { r.pos += width }; return v, ok
# the next size bytes as a reader of their own
subreader(r Reader&, size int) Reader, bool: v, ok := read_bytes(r, size); return reader(v), ok

# appending little-endian values
put_u16le(out byte[>..]&, v u16): out.push(v as! byte); out.push((v >> 8) as! byte)
put_u32le(out byte[>..]&, v u32): for i 4 { out.push((v >> (8 * i)) as! byte) }
put_u64le(out byte[>..]&, v uint): for i 8 { out.push((v >> (8 * i)) as! byte) }
put_f32le(out byte[>..]&, v f32): put_u32le(out, f32_bits(v))
put_f64le(out byte[>..]&, v real): put_u64le(out, f64_bits(v))
