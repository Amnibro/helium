namespace gl
POINTS i32 := 0
LINES i32 := 1
LINE_STRIP i32 := 3
TRIANGLES i32 := 4
TRIANGLE_STRIP i32 := 5
DEPTH_BUFFER_BIT i32 := 0x100
COLOR_BUFFER_BIT i32 := 0x4000
ZERO i32 := 0
ONE i32 := 1
SRC_ALPHA i32 := 0x302
ONE_MINUS_SRC_ALPHA i32 := 0x303
DST_ALPHA i32 := 0x304
LESS i32 := 0x201
LEQUAL i32 := 0x203
ALWAYS i32 := 0x207
BLEND i32 := 0xBE2
DEPTH_TEST i32 := 0xB71
CULL_FACE i32 := 0xB44
ARRAY_BUFFER i32 := 0x8892
ELEMENT_ARRAY_BUFFER i32 := 0x8893
STATIC_DRAW i32 := 0x88E4
DYNAMIC_DRAW i32 := 0x88E8
STREAM_DRAW i32 := 0x88E0
BYTE i32 := 0x1400
UNSIGNED_BYTE i32 := 0x1401
UNSIGNED_SHORT i32 := 0x1403
UNSIGNED_INT i32 := 0x1405
FLOAT i32 := 0x1406
FRAGMENT_SHADER i32 := 0x8B30
VERTEX_SHADER i32 := 0x8B31
TEXTURE_2D i32 := 0xDE1
TEXTURE0 i32 := 0x84C0
TEXTURE_MAG_FILTER i32 := 0x2800
TEXTURE_MIN_FILTER i32 := 0x2801
TEXTURE_WRAP_S i32 := 0x2802
TEXTURE_WRAP_T i32 := 0x2803
NEAREST i32 := 0x2600
LINEAR i32 := 0x2601
LINEAR_MIPMAP_LINEAR i32 := 0x2703
CLAMP_TO_EDGE i32 := 0x812F
REPEAT i32 := 0x2901
extern init(canvas i32, antialias bool, alpha bool) bool = "he_gl_init"
