extern create_vao() i32 = "he_gl_create_vao"
extern bind_vao(v i32) = "he_gl_bind_vao"
extern attrib_ptr(idx i32, size i32, kind i32, norm bool, stride i32, offset i32) = "he_gl_attrib_ptr"
