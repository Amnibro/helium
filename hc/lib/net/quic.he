q_closef(q Quic&, s int) byte[>..]:
	b byte[>..] ~= []; f ~= QFrame{}; app := q.eapp && s == 2
	f.ty = if app { 29 } else { 28 }; f.a = if q.eapp && !app { 12 } else { q.err }
	if app || !q.eapp: f.data.append(q.ereason[..])
	qf_put(b, f); b
q_min(a real, b real) real: if a == 0.0 || b < a { b } else { a }
q_timer(q const Quic&) real, int, bool:
	t ~= 0.0; sp ~= 0; f := (1 << min(q.ptoc, 10)) as real
	for s 3:
		l := q.sp[s].losst
		if l > 0.0 && (t == 0.0 || l < t): t = l; sp = s
	if t > 0.0: return t, sp, true
	if q.srv && !q.valid && 3 * q.rxb - q.txb < QMAXD: return 0.0, 0, false
	for s 3:
		x := q.sp[s].lastae + q_pto(q, s) * f
		if q.sp[s].sent.len > 0 && q.sp[s].tok && (s < 2 || q.conf) && (t == 0.0 || x < t): t = x; sp = s
	if t == 0.0 && !q.srv && !q.conf && q.tls_on: sp = if q.sp[1].tok { 1 } else { 0 }; t = q.tlast + q_pto(q, sp) * f
