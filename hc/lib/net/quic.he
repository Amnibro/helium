		if !(t == 0 || t == 2 || t == 28 || t == 29): ae = true
		q_frame(q, s, f); o = e
	if r.pn > q.sp[s].rlarge:
		if ae && r.pn != q.sp[s].rlarge + 1: q.sp[s].ooo = true
		q.sp[s].rlarge = r.pn; q.sp[s].rlt = q.now
	else if ae: q.sp[s].ooo = true
	rs_add(q.sp[s].rxr, r.pn, r.pn + 1)
	while q.sp[s].rxr.len > 64: q.sp[s].rfl = q.sp[s].rxr[1]; rs_shift(q.sp[s].rxr)
	if ae && q.sp[s].ackn == 0: q.sp[s].ackt = q.now + 0.025
