quic_timeout(q const Quic&) real:
	if q.state == QUIC_CLOSED: return 0.0
	if q.state >= QUIC_CLOSING: return q.closet
	t, s, loss := q_timer(q); r ~= if (q.test & 4) != 0 { 0.0 } else { t }
	for i 3:
		if q.sp[i].ackn > 0 && q.sp[i].tok: r = q_min(r, if i == 2 { q.sp[i].ackt } else { q.now })
	if q.idle > 0.0 || !q.hs: r = q_min(r, q.tidle + (if q.idle > 0.0 { q.idle } else { 10.0 }))
	if q.keep > 0.0 && q.hs: r = q_min(r, max(q.tlast, q.tidle) + q.keep)
	r
quic_send(q Quic&, out byte[>..]&, now real) bool:
