	pls byte[>..][>..] ~= []; sps int[>..] ~= []; pns int[>..] ~= []; aes int[>..] ~= []; total ~= 0; ini ~= false; closing := q.state == QUIC_CLOSING; hsk ~= false
	for s 3:
		ovh := (if s == 2 { 1 + q.dcid.len } else { 9 + q.dcid.len + q.scid.len + (if s == 0 { 1 } else { 0 }) }) + 20; room := QMAXD - total - ovh
		if !q.sp[s].tok || room < 64: continue
		rec ~= QSent{}; pl := if closing { q_closef(q, s) } else { q_frames(q, s, room, rec) }
		if pl.len == 0: continue
		ae := rec.fr.len > 0; rec.pn = q.sp[s].npn; rec.t = now; q.sp[s].npn += 1; sps.push(s); pns.push(rec.pn); aes.push(if ae { 1 } else { 0 }); total += ovh + pl.len; pls.push(pl)
		if s == 0 && (ae || !q.srv): ini = true
		if s == 1: hsk = true
		if ae: q.sp[s].sent.push(QRec { pn: rec.pn, t: now, size: 0, fo: q.sp[s].fr.len, fc: rec.fr.len }); q.sp[s].fr.append(rec.fr[..]); q.sp[s].lastae = now; q.tlast = now
		if ae && !q.asr: q.asr = true; q.tidle = now
	n := pls.len
	if n == 0: return false
	if ini && total < QMAXD: pls[n - 1].resize(pls[n - 1].len + QMAXD - total, 0)
	for i n:
		s := sps[i]; hdr := if s == 2 { qh_short(q.dcid[..], q.phase, 4, pns[i]) } else { qh_long(if s == 0 { 0 } else { 2 }, q.dcid[..], q.scid[..], "", 4, pns[i], pls[i].len) }
		pkt := qp_seal(q.sp[s].tx, hdr[..], 4, pns[i], pls[i][..]); out.append(pkt[..])
		if aes[i] == 1: k := q.sp[s].sent.len - 1; q.sp[s].sent[k].size = pkt.len; q.infl += pkt.len
