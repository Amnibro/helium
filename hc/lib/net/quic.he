quic_state(q const Quic&) int: q.state
quic_close(q Quic&, code int, why const byte[:]): q_end(q, true, code, why)
quic_write(q Quic&, id int, d const byte[:]) bool:
	i := q_find(q, id)
	if i < 3 || q.st[i].sfin || q.st[i].srst >= 0 || q.state >= QUIC_CLOSING: return false
	qs_write(q.st[i], d); true
quic_fin(q Quic&, id int) bool:
	i := q_find(q, id)
	if i < 3 || q.st[i].srst >= 0: return false
	q.st[i].sfin = true; true
quic_read(q Quic&, id int, out byte[>..]&) int:
	i := q_find(q, id)
	if i < 3: return -1
	n := qs_take(q.st[i], out); q.rxread += n; q_credit(q)
	if q.st[i].rfin < 0 && q.st[i].rmax - q.st[i].rbase < q.st[i].rwin / 2: q.st[i].rmax = q.st[i].rbase + q.st[i].rwin; q.st[i].fl |= 1
	q_done(q, i); n
quic_stream(q const Quic&, id int) int:
	i := q_find(q, id)
	if i < 3: return -1
	(if qs_avail(q.st[i]) > 0 { 1 } else { 0 }) | (if q.st[i].rfin >= 0 && q.st[i].rbase == q.st[i].rfin { 2 } else { 0 }) | (if q.st[i].rrst >= 0 { 4 } else { 0 }) | (if q.st[i].sstop >= 0 { 8 } else { 0 }) | (if q.st[i].facked { 16 } else { 0 })
quic_unsent(q const Quic&, id int) int: i := q_find(q, id); if i < 3 { 0 } else { q.st[i].sw - q.st[i].sbase }
quic_reset(q Quic&, id int, code int):
	i := q_find(q, id)
	if i >= 3 && q.st[i].srst < 0: q.st[i].srst = code; q.st[i].fl |= 2
quic_stop(q Quic&, id int, code int):
	i := q_find(q, id)
	if i >= 3 && q.st[i].rstop < 0: q.st[i].rstop = code; q.st[i].fl |= 4
quic_accept(q Quic&) int:
	if q.nacc >= q.newst.len: return -1
	q.nacc += 1; q.newst[q.nacc - 1]
