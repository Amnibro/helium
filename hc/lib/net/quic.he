q_timers(q Quic&):
	now := q.now
	if q.state == QUIC_CLOSED: return
	if q.state >= QUIC_CLOSING:
		if now >= q.closet: q.state = QUIC_CLOSED
		return
	if q.idle > 0.0 && now >= q.tidle + q.idle || !q.hs && now >= q.tidle + 10.0: q.state = QUIC_CLOSED; q.err = -2; return
	t, s, loss := q_timer(q)
	if t == 0.0 || now < t || (q.test & 4) != 0: return
	if loss: q_lost(q, s); return
	q.ptoc += 1; q.sp[s].probe = 2
