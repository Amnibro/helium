q_frames(q Quic&, s int, room int, rec QSent&) byte[>..]:
	b byte[>..] ~= []; ack := q.sp[s].ackn > 0 && q.sp[s].rxr.len > 0; can := s < 2 || q.sp[s].probe > 0 || q.infl + QMAXD <= q.cwnd
	if ack: q_ackf(q, s, b)
	al := b.len
	if can: q_emit(q, s, b, room, rec)
	if can && s == 2 && q.hs && room - b.len > 100: q_app(q, b, room, rec)
	if b.len == al && (q.sp[s].probe > 0 || s == 2 && q.keep > 0.0 && q.hs && q.now >= max(q.tlast, q.tidle) + q.keep): b.push(1); q_note(rec, -9, 0, 0)
	if b.len == al && !(ack && (s < 2 || q.sp[s].ackn >= 2 || q.sp[s].ooo || q.now >= q.sp[s].ackt)): b.clear(); return b
	if ack: q.sp[s].ackn = 0; q.sp[s].ooo = false
	if q.sp[s].probe > 0 && b.len > al: q.sp[s].probe -= 1
