quic_recv(q Quic&, d const byte[:], now real):
	q.now = now; o ~= 0
	if q.state == QUIC_CLOSING: q.cpend = true
	if q.state >= QUIC_CLOSING: return
	q.rxb += d.len
	while o < d.len && q.state < QUIC_CLOSING:
		n := q_packet(q, d[o..], d.len)
		if n <= 0: break
		o += n
q_ackf(q Quic&, s int, b byte[>..]&):
	r := q.sp[s].rxr.len; f ~= QFrame{}; hi := q.sp[s].rxr[r - 1]; lo ~= q.sp[s].rxr[r - 2]; cnt := min(r / 2 - 1, 16)
	f.ty = 2; f.a = hi - 1; f.b = if s == 2 { (((q.now - q.sp[s].rlt) * 1000000.0) as int) >> q.lp.v[10] } else { 0 }; f.rg.push(hi - 1 - lo)
	for j cnt: i := r - 4 - 2 * j; f.rg.push(lo - q.sp[s].rxr[i + 1] - 1); f.rg.push(q.sp[s].rxr[i + 1] - 1 - q.sp[s].rxr[i]); lo = q.sp[s].rxr[i]
	qf_put(b, f)
q_emit(q Quic&, i int, b byte[>..]&, room int, rec QSent&):
	crypto := i < 3
	while room - b.len >= 32:
		off ~= q.st[i].snext; n ~= 0; fresh ~= true; cap := room - b.len - 20
		if q.st[i].rtx.len >= 2:
			l := q.st[i].rtx.pop(); a := q.st[i].rtx.pop(); lo, hi := rs_gap(q.st[i].sack, max(a, q.st[i].sbase), a + l)
			if lo >= hi: continue
			off = lo; n = min(hi - lo, cap); fresh = false
			if lo + n < a + l: q.st[i].rtx.push(lo + n); q.st[i].rtx.push(a + l - lo - n)
		else:
			av := q.st[i].sw - off; n = min(cap, if crypto || (q.test & 1) != 0 { av } else { min(av, min(q.st[i].smax - off, q.txmax - q.txdata)) })
		fin := !crypto && q.st[i].sfin && !q.st[i].fsent && off + max(n, 0) == q.st[i].sw
		if n <= 0 && !fin: break
		n = max(n, 0); f ~= QFrame{}; at := q.st[i].sh + off - q.st[i].sbase
		f.ty = if crypto { 6 } else { 8 }; f.a = if crypto { off } else { q.st[i].id }; f.b = off; f.fin = fin; f.data.append(q.st[i].sbuf[at..at + n]); qf_put(b, f)
		if fresh: q.st[i].snext += n
		if fresh && !crypto: q.txdata += n
		if fin: q.st[i].fsent = true
		rec.fr.push(i); rec.fr.push(off); rec.fr.push(n); rec.fr.push(if fin { 1 } else { 0 })
q_ctl(b byte[>..]&, ty int, x int, y int, z int): f ~= QFrame{}; f.ty = ty; f.a = x; f.b = y; f.c = z; qf_put(b, f)
q_note(rec QSent&, a int, x int, y int): rec.fr.push(a); rec.fr.push(x); rec.fr.push(y); rec.fr.push(0)
q_app(q Quic&, b byte[>..]&, room int, rec QSent&):
	n := q.st.len - 3
	if (q.pend & 8) != 0: b.push(30)
	if (q.pend & 1) != 0: q_ctl(b, 16, q.rxmax, 0, 0)
	if (q.pend & 2) != 0: q_ctl(b, 18, q.mxib, 0, 0)
	if (q.pend & 4) != 0: q_ctl(b, 19, q.mxiu, 0, 0)
	if q.pend != 0: q_note(rec, -1, q.pend, 0); q.pend = 0
	if q.prsp.len == 8: b.push(27); b.append(q.prsp[..]); q.prsp.clear(); q_note(rec, -3, 0, 0)
	while q.retire.len > 0 && room - b.len > 64: x := q.retire.pop(); q_ctl(b, 25, x, 0, 0); q_note(rec, -4, x, 0)
	for k n:
		i := 3 + (q.rr + k) % n; fl := q.st[i].fl
		if room - b.len < 64: break
		if (fl & 1) != 0: q_ctl(b, 17, q.st[i].id, q.st[i].rmax, 0)
		if (fl & 2) != 0: q_ctl(b, 4, q.st[i].id, q.st[i].srst, q.st[i].snext)
		if (fl & 4) != 0: q_ctl(b, 5, q.st[i].id, q.st[i].rstop, 0)
		if fl != 0: q_note(rec, -2, i, fl); q.st[i].fl = 0
		if q.st[i].srst < 0: q_emit(q, i, b, room, rec)
