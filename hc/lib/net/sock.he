namespace net
use std
use ffi
extern "libc.so.6" {
	k_socket(d i32, t i32, p i32) i32 = "socket";
	k_bind(fd i32, a uint, l u32) i32 = "bind";
	k_listen(fd i32, n i32) i32 = "listen";
	k_accept4(fd i32, a uint, l uint, f i32) i32 = "accept4";
	k_connect(fd i32, a uint, l u32) i32 = "connect";
	k_send(fd i32, b uint, n uint, f i32) int = "send";
	k_recv(fd i32, b uint, n uint, f i32) int = "recv";
	k_sendto(fd i32, b uint, n uint, f i32, a uint, l u32) int = "sendto";
	k_recvfrom(fd i32, b uint, n uint, f i32, a uint, l uint) int = "recvfrom";
	k_close(fd i32) i32 = "close";
	k_setsockopt(fd i32, lv i32, o i32, v uint, l u32) i32 = "setsockopt";
	k_getsockopt(fd i32, lv i32, o i32, v uint, l uint) i32 = "getsockopt";
	k_getsockname(fd i32, a uint, l uint) i32 = "getsockname";
	k_getpeername(fd i32, a uint, l uint) i32 = "getpeername";
	k_fcntl(fd i32, c i32, a i32) i32 = "fcntl";
	k_poll(p uint, n uint, ms i32) i32 = "poll";
	k_errno() uint = "__errno_location";
}
AGAIN := -11
INPROGRESS := -115
INTR := -4
BADF := -9
ACCES := -13
INVAL := -22
PIPE := -32
NOSYS := -38
MSGSIZE := -90
ADDRINUSE := -98
ADDRNOTAVAIL := -99
NETUNREACH := -101
CONNABORTED := -103
CONNRESET := -104
NOTCONN := -107
TIMEDOUT := -110
CONNREFUSED := -111
HOSTUNREACH := -113
READ := 1
WRITE := 4
ERR := 8
HUP := 16
ANY := 0
LOOPBACK := 0x7F000001
struct Addr { ip int, port int }
struct Poll { n int, tags int[64], fds int[64] }
var KA byte[>..]
var KL byte[>..]
var KB byte[>..]
var KP byte[>..]
err() int: e := ffi::bytes(k_errno(), 4); v := (e[0] as int) | (e[1] as int) << 8 | (e[2] as int) << 16 | (e[3] as int) << 24; if v == 0 { -5 } else { -v }
ka(ip int, port int):
	KA.clear(); KA.resize(16, 0); KA[0] = 2; KA[2] = ((port >> 8) & 255) as! byte; KA[3] = (port & 255) as! byte; KA[4] = ((ip >> 24) & 255) as! byte; KA[5] = ((ip >> 16) & 255) as! byte; KA[6] = ((ip >> 8) & 255) as! byte; KA[7] = (ip & 255) as! byte
kl(): KA.clear(); KA.resize(16, 0); KL.clear(); KL.resize(4, 0); KL[0] = 16
kip() int: (KA[4] as int) << 24 | (KA[5] as int) << 16 | (KA[6] as int) << 8 | KA[7] as int
kport() int: (KA[2] as int) << 8 | KA[3] as int
opt(fd int, lv int, o int, v int) int: KP.clear(); KP.resize(4, 0); KP[0] = (v & 255) as! byte; k_setsockopt(fd as i32, lv as i32, o as i32, ffi::ptr(KP[..]), 4 as! u32) as int
open_sock(kind int) int: fd := k_socket(2, (kind | 2048 | 524288) as i32, 0) as int; if fd < 0 { err() } else { fd }
listen_raw(ip int, port int, backlog int) int:
	fd := open_sock(1); if fd < 0 { return fd }
	opt(fd, 1, 2, 1); ka(ip, port)
	if k_bind(fd as i32, ffi::ptr(KA[..]), 16 as! u32) < 0 || k_listen(fd as i32, backlog as i32) < 0 { e := err(); k_close(fd as i32); return e }
	fd
accept(h int) int: fd := k_accept4(h as i32, 0 as uint, 0 as uint, (2048 | 524288) as i32) as int; if fd < 0 { err() } else { fd }
connect_raw(ip int, port int) int:
	fd := open_sock(1); if fd < 0 { return fd }
	ka(ip, port)
	if k_connect(fd as i32, ffi::ptr(KA[..]), 16 as! u32) < 0 { e := err(); if e != INPROGRESS { k_close(fd as i32); return e } }
	fd
connected(h int) int:
	KP.clear(); KP.resize(4, 0); KL.clear(); KL.resize(4, 0); KL[0] = 4
	if k_getsockopt(h as i32, 1, 4, ffi::ptr(KP[..]), ffi::ptr(KL[..])) < 0 { return err() }
	e := (KP[0] as int) | (KP[1] as int) << 8
	if e != 0 { return -e }
	kl(); if k_getpeername(h as i32, ffi::ptr(KA[..]), ffi::ptr(KL[..])) < 0 { e2 := err(); return if e2 == NOTCONN { AGAIN } else { e2 } }
	0
send(h int, data const byte[:]) int: n := k_send(h as i32, ffi::ptr(data), data.len as uint, 16384); if n < 0 { err() } else { n }
recv_into(h int, buf byte[:]) int: n := k_recv(h as i32, ffi::ptr(buf), buf.len as uint, 0); if n < 0 { err() } else { n }
udp_raw(ip int, port int) int:
	fd := open_sock(2); if fd < 0 { return fd }
	ka(ip, port)
	if k_bind(fd as i32, ffi::ptr(KA[..]), 16 as! u32) < 0 { e := err(); k_close(fd as i32); return e }
	fd
send_to_raw(h int, ip int, port int, data const byte[:]) int: ka(ip, port); n := k_sendto(h as i32, ffi::ptr(data), data.len as uint, 16384, ffi::ptr(KA[..]), 16 as! u32); if n < 0 { err() } else { n }
close(h int) int: if k_close(h as i32) < 0 { err() } else { 0 }
nodelay(h int, on bool) int: r := opt(h, 6, 1, if on { 1 } else { 0 }); if r < 0 { err() } else { 0 }
blocking(h int, on bool) int:
	f := k_fcntl(h as i32, 3, 0) as int; if f < 0 { return err() }
	nf := if on { f & ~2048 } else { f | 2048 }
	if k_fcntl(h as i32, 4, nf as i32) < 0 { err() } else { 0 }
local_raw(h int) int: kl(); if k_getsockname(h as i32, ffi::ptr(KA[..]), ffi::ptr(KL[..])) < 0 { err() } else { kip() << 16 | kport() }
peer_raw(h int) int: kl(); if k_getpeername(h as i32, ffi::ptr(KA[..]), ffi::ptr(KL[..])) < 0 { err() } else { kip() << 16 | kport() }
parse_ip(s const byte[:]) int, bool:
	if s == "localhost": return LOOPBACK, true
	ip ~= 0; part ~= 0; digits ~= 0; dots ~= 0
	for c s:
		if c == '.':
			if digits == 0 || dots == 3: return 0, false
			ip = ip << 8 | part; part = 0; digits = 0; dots += 1
		else if c >= '0' && c <= '9':
			part = part * 10 + (c - '0') as int; digits += 1
			if digits > 3 || part > 255: return 0, false
		else:
			return 0, false
	if digits == 0 || dots != 3: return 0, false
	return ip << 8 | part, true
addr(host const byte[:], port int) Addr: ip, ok := parse_ip(host); Addr { ip: if ok { ip } else { -1 }, port: port }
parse_addr(s const byte[:]) Addr, bool:
	k ~= -1
	for c, i in s: if c == ':': k = i
	if k < 0: return Addr { ip: -1, port: 0 }, false
	ip, ok := parse_ip(s[..k]); p, pok := parse_int(s[k + 1..])
	if !ok || !pok || p < 0 || p > 65535: return Addr { ip: -1, port: 0 }, false
	return Addr { ip: ip, port: p }, true
format(out byte[>..]&, a Addr): format(out, a.ip >> 24 & 255, ".", a.ip >> 16 & 255, ".", a.ip >> 8 & 255, ".", a.ip & 255, ":", a.port);
unpack(v int) Addr: Addr { ip: v >> 16 & 0xFFFFFFFF, port: v & 0xFFFF }
valid(a Addr) bool: a.ip >= 0 && a.ip <= 0xFFFFFFFF && a.port >= 0 && a.port <= 65535
listen(a Addr, backlog int = 64) int: if valid(a) { listen_raw(a.ip, a.port, backlog) } else { INVAL }
connect(a Addr) int: if valid(a) { connect_raw(a.ip, a.port) } else { INVAL }
recv(h int, out byte[>..]&, limit int = 65536) int:
	KB.resize(clamp(limit, 1, 65536), 0)
	n := recv_into(h, KB[..])
	if n > 0: out.append(KB[..n])
	n
send_all(h int, data const byte[:]) int:
	o ~= 0
	while o < data.len:
		n := send(h, data[o..])
		if n == AGAIN: return o
		if n < 0: return n
		o += n
	o
local_addr(h int) Addr: v := local_raw(h); if v < 0 { Addr { ip: -1, port: v } } else { unpack(v) }
peer_addr(h int) Addr: v := peer_raw(h); if v < 0 { Addr { ip: -1, port: v } } else { unpack(v) }
local_port(h int) int: v := local_raw(h); if v < 0 { v } else { v & 0xFFFF }
udp(a Addr) int: if valid(a) { udp_raw(a.ip, a.port) } else { INVAL }
send_to(h int, to Addr, data const byte[:]) int: if valid(to) { send_to_raw(h, to.ip, to.port, data) } else { INVAL }
recv_from(h int, out byte[>..]&, from Addr&) int:
	KB.resize(65536, 0); kl()
	n := k_recvfrom(h as i32, ffi::ptr(KB[..]), 65536 as uint, 0, ffi::ptr(KA[..]), ffi::ptr(KL[..]))
	if n < 0: return err()
	out.append(KB[..n]); from = Addr { ip: kip(), port: kport() }
	n
clear(p Poll&): p.n = 0;
add(p Poll&, h int, events int, tag int = 0) bool:
	if p.n == 64: return false
	p.fds[p.n] = h & 0xFFFFFFFF | (events & 0xFFFF) << 32; p.tags[p.n] = tag; p.n += 1
	true
wait(p Poll&, ms int) int:
	KP.clear(); KP.resize(p.n * 8, 0)
	for i p.n:
		f := p.fds[i] & 0xFFFFFFFF; e := p.fds[i] >> 32 & 0xFFFF
		for b 4 { KP[i * 8 + b] = ((f >> (b * 8)) & 255) as! byte }
		KP[i * 8 + 4] = (e & 255) as! byte; KP[i * 8 + 5] = ((e >> 8) & 255) as! byte
	r := k_poll(ffi::ptr(KP[..]), p.n as uint, ms as i32) as int
	if r < 0: return err()
	if r == 0: return 0
	for i p.n: p.fds[i] = p.fds[i] & 0xFFFFFFFFFFFF | ((KP[i * 8 + 6] as int) | (KP[i * 8 + 7] as int) << 8) << 48
	k ~= 0
	for i p.n:
		if p.fds[i] >> 48 & 0xFFFF != 0:
			f := p.fds[i]; t := p.tags[i]; p.fds[i] = p.fds[k]; p.tags[i] = p.tags[k]; p.fds[k] = f; p.tags[k] = t; k += 1
	k
tag(p Poll&, i int) int: p.tags[i]
handle(p Poll&, i int) int: p.fds[i] & 0xFFFFFFFF
events(p Poll&, i int) int: p.fds[i] >> 48 & 0xFFFF
wait_one(h int, events int, ms int) int:
	var p Poll
	add(p, h, events)
	r := wait(p, ms)
	if r <= 0 { r } else { p.events(0) }
frame(out byte[>..]&, msg const byte[:]): out.push((msg.len & 255) as! byte); out.push((msg.len >> 8 & 255) as! byte); out.append(msg)
frame_len(buf const byte[:]) int:
	if buf.len < 2: return 0
	m := (buf[0] as int) | (buf[1] as int) << 8
	if buf.len < 2 + m { 0 } else { 2 + m }
error_name(e int) const byte[:]:
	match e:
		0 => "ok"
		-11 => "would block (AGAIN)"
		-115 => "in progress"
		-4 => "interrupted"
		-9 => "bad handle"
		-13 => "permission denied"
		-22 => "invalid argument"
		-32 => "broken pipe"
		-38 => "not supported on this target"
		-90 => "message too long"
		-98 => "address in use"
		-99 => "address not available"
		-101 => "network unreachable"
		-103 => "connection aborted"
		-104 => "connection reset"
		-107 => "not connected"
		-110 => "timed out"
		-111 => "connection refused"
		-113 => "host unreachable"
		_ => "socket error"
