rt_f2d(bits u64) u64, int:
	ma := bits & 0x7FFFFF; ie := (bits >> 23 & 0xFF) as int
	e2 := if ie == 0 { 1 - 127 - 23 - 2 } else { ie - 127 - 23 - 2 }; m2 := if ie == 0 { ma } else { ma | ((1) as u64) << 23 }
	ab := m2 & 1 == 0; mv := 4 * m2; mp := 4 * m2 + 2; mms := if ma != 0 || ie <= 1 { (1) as u64 } else { (0) as u64 }; mm := 4 * m2 - 1 - mms
	vr u64 ~= 0; vp u64 ~= 0; vm u64 ~= 0; e10 ~= 0; vmt ~= false; vrt ~= false; ld u64 ~= 0
	if e2 >= 0:
		q := rt_l10p2(e2); e10 = q
		k := 61 + rt_p5b(q) - 1; i := -e2 + q + k
		vr = rt_ms32(mv, RT_P5I[2 * q + 1] + 1, i); vp = rt_ms32(mp, RT_P5I[2 * q + 1] + 1, i); vm = rt_ms32(mm, RT_P5I[2 * q + 1] + 1, i)
		if q != 0 && (vp - 1) / 10 <= vm / 10: l := 61 + rt_p5b(q - 1) - 1; ld = rt_ms32(mv, RT_P5I[2 * (q - 1) + 1] + 1, -e2 + q - 1 + l) % 10
		if q <= 9: if mv % 5 == 0: vrt = rt_p5f(mv) >= q else: if ab: vmt = rt_p5f(mm) >= q else: if rt_p5f(mp) >= q: vp -= 1
	else:
		q := rt_l10p5(-e2); e10 = q + e2
		i := -e2 - q; k := rt_p5b(i) - 61; j ~= q - k
		vr = rt_ms32(mv, RT_P5[2 * i + 1], j); vp = rt_ms32(mp, RT_P5[2 * i + 1], j); vm = rt_ms32(mm, RT_P5[2 * i + 1], j)
		if q != 0 && (vp - 1) / 10 <= vm / 10: j = q - 1 - (rt_p5b(i + 1) - 61); ld = rt_ms32(mv, RT_P5[2 * (i + 1) + 1], j) % 10
		if q <= 1: vrt = true; if ab { vmt = mms == 1 } else { vp -= 1 } else: if q < 31: vrt = mv & (((1) as u64) << (q - 1) as u64) - 1 == 0
	rm ~= 0; out u64 ~= 0
	if vmt || vrt:
		while vp / 10 > vm / 10: vmt = vmt && vm % 10 == 0; vrt = vrt && ld == 0; ld = vr % 10; vr = vr / 10; vp = vp / 10; vm = vm / 10; rm += 1
		if vmt: while vm % 10 == 0: vrt = vrt && ld == 0; ld = vr % 10; vr = vr / 10; vp = vp / 10; vm = vm / 10; rm += 1
		if vrt && ld == 5 && vr % 2 == 0: ld = 4
		out = vr + (if vr == vm && (!ab || !vmt) || ld >= 5 { (1) as u64 } else { (0) as u64 })
	else:
		while vp / 10 > vm / 10: ld = vr % 10; vr = vr / 10; vp = vp / 10; vm = vm / 10; rm += 1
		out = vr + (if vr == vm || ld >= 5 { (1) as u64 } else { (0) as u64 })
