RT_P1 := 0x1.921fb54442d18p0; RT_P2 := 0x1.1a62633145c07p-54; RT_P3 := -0x1.f1976b7ed8fbcp-110
RT_L2H := 0x1.62e42fefa39efp-1; RT_L2L := 0x1.abc9e3b39803fp-56; RT_IL2H := 0x1.71547652b82fep0; RT_IL2L := 0x1.777d0ffda0d24p-56; RT_IL10H := 0x1.bcb7b1526e50ep-2; RT_IL10L := 0x1.95355baaafad3p-57
dd_s(a real, b real) real, real: s := a + b; v := s - a; return s, a - (s - v) + (b - v)
dd_add(ah real, al real, bh real, bl real) real, real: s, e := dd_s(ah, bh); t, f := dd_s(al, bl); h, l := dd_s(s, e + t); h2, l2 := dd_s(h, l + f); return h2, l2
dd_mul(ah real, al real, bh real, bl real) real, real: p := ah * bh; h, l := dd_s(p, rt_fma(ah, bh, -p) + (ah * bl + al * bh)); return h, l
dd_divd(ah real, al real, b real) real, real: q1 := ah / b; p := q1 * b; rh, rl := dd_add(ah, al, -p, -rt_fma(q1, b, -p)); h, l := dd_s(q1, (rh + rl) / b); return h, l
dd_div(ah real, al real, bh real, bl real) real, real: q1 := ah / bh; ph, pl := dd_mul(q1, 0.0, bh, bl); rh, rl := dd_add(ah, al, -ph, -pl); q2 := rh / bh; ph2, pl2 := dd_mul(q2, 0.0, bh, bl); sh, sl := dd_add(rh, rl, -ph2, -pl2); h, l := dd_s(q1, q2); h2, l2 := dd_add(h, l, sh / bh, 0.0); return h2, l2
dd_sqrt(ah real, al real) real, real: if ah <= 0.0 { return 0.0, 0.0 } s := rt_fsq(ah); p := s * s; rh, rl := dd_add(ah, al, -p, -rt_fma(s, s, -p)); h, l := dd_s(s, (rh + rl) / (2.0 * s)); return h, l
rt_inf(neg bool) real: rt_bd(if neg { 0xFFF0000000000000 } else { 0x7FF0000000000000 })
rt_ldx(x real, k int) real: rt_bd(rt_ldexp(rt_db(x), k))
rt_expdd(xh real, xl real) real:
	if xh != xh { return xh } if xh > 709.8 { return rt_inf(false) } if xh < -745.2: return 0.0
	k := rt_ffl(xh * RT_IL2H + 0.5); ph := k * RT_L2H; r1, r2 := dd_add(xh, xl, -ph, -rt_fma(k, RT_L2H, -ph)); qh := k * RT_L2L; rh, rl := dd_add(r1, r2, -qh, -rt_fma(k, RT_L2L, -qh))
	zh := rh / 256.0; zl := rl / 256.0; th ~= 1.0; tl ~= 0.0; i ~= 11
	while i >= 1: mh, ml := dd_mul(zh, zl, th, tl); dh, dl := dd_divd(mh, ml, i as real); h, l := dd_add(1.0, 0.0, dh, dl); th = h; tl = l; i -= 1
	for _ 8: h, l := dd_mul(th, tl, th, tl); th = h; tl = l
	rt_ldx(th, k as int)
rt_lgm(x real) int, real, real:
	b ~= rt_db(x); e ~= 0; if b >> 52 & 0x7FF == 0: b = rt_db(x * 0x1p54); e = -54
	e += (b >> 52 & 0x7FF) as int - 1023; m ~= rt_bd(b & 0xFFFFFFFFFFFFF | 0x3FF0000000000000)
	if m > 1.4142135623730951: m = m * 0.5; e += 1
