	jf := rt_ffl(rh * 64.0 + 0.5); j := jf as int; aj := if j < 0 { -j } else { j }; sg := if j < 0 { -1.0 } else { 1.0 }; yh, yl := dd_s(rh - jf * 0.015625, rl); z := yh * yh
	sy := yh * z * (-0.16666666666666666 + z * (0.008333333333333333 + z * -0.0001984126984126984)) + yl; cy := z * (-0.5 + z * (0.041666666666666664 + z * (-0.001388888888888889 + z * 2.48015873015873e-05))) - yh * yl
	sa := sg * rt_bd(RT_SCT[4 * aj]); sl := sg * rt_bd(RT_SCT[4 * aj + 1]); ca := rt_bd(RT_SCT[4 * aj + 2]); cl := rt_bd(RT_SCT[4 * aj + 3])
	if c: ph := sa * yh; h, e1 := dd_s(ca, -ph); r1, r2 := dd_s(h, e1 - rt_fma(sa, yh, -ph) + cl + ca * cy - sa * sy - sl * yh); return r1, r2
	ph := ca * yh; h, e1 := dd_s(sa, ph); r1, r2 := dd_s(h, e1 + rt_fma(ca, yh, -ph) + sl + sa * cy + ca * sy + cl * yh); return r1, r2
rt_trig(x real, w int) real:
	if x != x || x == rt_inf(false) || x == rt_inf(true): return x - x
	if w != 2 && x != 0.0 && x > -268435456.0 && x < 268435456.0:
		sm := x > -0.7853981633974483 && x < 0.7853981633974483; kf := if sm { 0.0 } else { rt_ffl(x * 0.6366197723675814 + 0.5) }; ph := kf * RT_P1; rh0, rl1 := dd_s(x - ph, -(rt_fma(kf, RT_P1, -ph) + kf * RT_P2)); rl0 := rl1 - kf * RT_P3
		k0 := (kf as int + w) & 3; h0, l0 := rt_scq(rh0, rl0, k0 & 1 != 0); e0 := (if h0 < 0.0 { -h0 } else { h0 }) * 2.168404344971009e-19 + (if kf < 0.0 { -kf } else { kf }) * 7.888609052210118e-31; f0 := h0 + (l0 + e0)
		if f0 == h0 + (l0 - e0): return if k0 >= 2 { -f0 } else { f0 }
	n, rh, rl := rt_rp2(x); q := n & 3
	sh, sl := rt_sc(rh, rl, false); ch, cl := rt_sc(rh, rl, true)
	if w == 2: h, l := if q & 1 == 0 { dd_div(sh, sl, ch, cl) } else { dd_div(-ch, -cl, sh, sl) }; return h + l
	k := q + w & 3
	if k == 0: sh + sl else: if k == 1: ch + cl else: if k == 2: -(sh + sl) else: -(ch + cl)
rt_sin(x real) real: rt_trig(x, 0)
rt_cos(x real) real: rt_trig(x, 1)
rt_tan(x real) real: rt_trig(x, 2)
rt_atdd(t0h real, t0l real) real, real:
	th ~= t0h; tl ~= t0l
	for _ 3: mh, ml := dd_mul(th, tl, th, tl); ah, al := dd_add(1.0, 0.0, mh, ml); sh, sl := dd_sqrt(ah, al); dh, dl := dd_add(1.0, 0.0, sh, sl); h, l := dd_div(th, tl, dh, dl); th = h; tl = l
	zh, zl := dd_mul(th, tl, th, tl); vh, vl ~= dd_divd(1.0, 0.0, 33.0); k ~= 15
	while k >= 0: mh, ml := dd_mul(zh, zl, vh, vl); ih, il := dd_divd(if k % 2 == 0 { 1.0 } else { -1.0 }, 0.0, (2 * k + 1) as real); h, l := dd_add(ih, il, mh, ml); vh = h; vl = l; k -= 1
	h, l := dd_mul(th, tl, vh, vl); return 8.0 * h, 8.0 * l
rt_at2(yh real, yl real, xh real, xl real) real, real:
	if yh <= xh: qh, ql := dd_div(yh, yl, xh, xl); h, l := rt_atdd(qh, ql); return h, l
	qh, ql := dd_div(xh, xl, yh, yl); ah, al := rt_atdd(qh, ql); h, l := dd_add(RT_P1, RT_P2, -ah, -al); return h, l
rt_sgn(neg bool, v real) real: if neg: -v else: v
rt_atan(x real) real: if x != x { return x } neg := rt_db(x) >> 63 != 0; ax := if neg { -x } else { x }; if ax == rt_inf(false) { return rt_sgn(neg, RT_P1) } h, l := rt_at2(ax, 0.0, 1.0, 0.0); rt_sgn(neg, h + l)
rt_atan2(y real, x real) real:
	if x != x || y != y: return x + y
	ny := rt_db(y) >> 63 != 0; nx := rt_db(x) >> 63 != 0; ay := if ny { -y } else { y }; ax := if nx { -x } else { x }; inf := rt_inf(false)
	if ay == 0.0: return if nx { rt_sgn(ny, RT_P1 * 2.0) } else { y }
	if ax == 0.0: return rt_sgn(ny, RT_P1)
	if ax == inf: if ay == inf { h, l := if nx { dd_mul(RT_P1, RT_P2, 1.5, 0.0) } else { dd_mul(RT_P1, RT_P2, 0.5, 0.0) }; return rt_sgn(ny, h + l) } return rt_sgn(ny, if nx { RT_P1 * 2.0 } else { 0.0 })
	if ay == inf: return rt_sgn(ny, RT_P1)
	h, l := rt_at2(ay, 0.0, ax, 0.0)
	if nx: h2, l2 := dd_add(2.0 * RT_P1, 2.0 * RT_P2, -h, -l); return rt_sgn(ny, h2 + l2)
	rt_sgn(ny, h + l)
rt_asin(x real) real: if !(x >= -1.0 && x <= 1.0) { return rt_bd(0x7FF8000000000000) } neg := x < 0.0; ax := if neg { -x } else { x }; ah, al := dd_add(1.0, 0.0, -ax, 0.0); bh, bl := dd_add(1.0, 0.0, ax, 0.0); mh, ml := dd_mul(ah, al, bh, bl); sh, sl := dd_sqrt(mh, ml); if sh == 0.0 { return rt_sgn(neg, RT_P1) } h, l := rt_at2(ax, 0.0, sh, sl); if x == 0.0 { return x } rt_sgn(neg, h + l)
rt_acos(x real) real: if !(x >= -1.0 && x <= 1.0) { return rt_bd(0x7FF8000000000000) } neg := x < 0.0; ax := if neg { -x } else { x }; ah, al := dd_add(1.0, 0.0, -ax, 0.0); bh, bl := dd_add(1.0, 0.0, ax, 0.0); mh, ml := dd_mul(ah, al, bh, bl); sh, sl := dd_sqrt(mh, ml); if ax == 0.0 { return RT_P1 } h, l := rt_at2(sh, sl, ax, 0.0); if neg { h2, l2 := dd_add(2.0 * RT_P1, 2.0 * RT_P2, -h, -l); return h2 + l2 } h + l
rt_sinf(x f32) f32: rt_sin(x as real) as f32
rt_cosf(x f32) f32: rt_cos(x as real) as f32
rt_tanf(x f32) f32: rt_tan(x as real) as f32
rt_asinf(x f32) f32: rt_asin(x as real) as f32
rt_acosf(x f32) f32: rt_acos(x as real) as f32
rt_atanf(x f32) f32: rt_atan(x as real) as f32
rt_atan2f(y f32, x f32) f32: rt_atan2(y as real, x as real) as f32
rt_expf(x f32) f32: rt_exp(x as real) as f32
rt_logf(x f32) f32: rt_log(x as real) as f32
rt_log2f(x f32) f32: rt_log2(x as real) as f32
rt_log10f(x f32) f32: rt_log10(x as real) as f32
rt_powf(x f32, y f32) f32: rt_pow(x as real, y as real) as f32
