rt_tgo(r int): mst(r + 96, 1); rt_fwake(r + 96);
rt_hwt() int: var m u64[16]; k := sys3(204, 0, 128, uptr(m[..])); c ~= 0; if k > 0 { for i 16 { x ~= m[i]; while x != 0 { x = x & x - 1; c += 1 } } } max(1, min(c, RT_SBUD / (RT_RSZ * 4) - 1))
