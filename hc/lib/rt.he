struct RtV { b int, n int, top int, fl int, fln int, flc int }
var RT_RSZ int; var RT_SBUD int; var RT_TIER int; var RT_TEND int
var RT_FREE int[4096]
var RT_NFREE int
var RT_OUT RtV; var RT_SINK int
extern vptr(v RtV&) int = "!ptr"
var RT_EB byte[512]
var RT_DBG int
var RT_AVX2 int
var RT_EN int
rt_write(fd int, s const byte[:]): o ~= 0; while o < s.len: w := sys3(1, fd, ptr(s[o..]), s.len - o); if w <= 0 { return } o += w
rt_flush(): if RT_OUT.n == 0 { return } if RT_SH != 0 { rt_lock(RT_SH) } o ~= 0; while o < RT_OUT.n { w := sys3(1, 1, RT_OUT.b + o, RT_OUT.n - o); if w <= 0 { break } o += w } RT_OUT.n = 0; if RT_SH != 0: rt_unlock(RT_SH);
rt_sink() int: if RT_SINK == 0: vptr(RT_OUT) else: RT_SINK
rt_sink_set(a int) int: o := RT_SINK; RT_SINK = a; o
var RT_PLS int; var RT_PD int
rt_pbeg() int: RT_PLS = RT_OUT.n; RT_PD = 1; rt_sink_set(0)
rt_pend(o int): rt_nl(); RT_PD = 0; rt_sink_set(o);
rt_app(p int, n int): if n > 0: d := rt_grow(rt_sink(), n, 1); mcopy(d, p, n);
rt_ps(s const byte[:]): rt_app(ptr(s), s.len);
rt_pq(s const byte[:]): rt_ps("\""); rt_ps(s); rt_ps("\"");
rt_digits(b byte[24]&, u u64) int: v ~= u; i ~= 24; loop { i -= 1; b[i] = (48 + v % 10) as byte; v = v / 10; if v == 0 { break } } i
rt_pu(u u64): var b byte[24]; i := rt_digits(b, u); rt_ps(b[i..]);
rt_pi(v int): u ~= v as! u64; if v < 0 { rt_ps("-"); u = 0 - u } rt_pu(u);
rt_pb(b bool): if b: rt_ps("true"); else: rt_ps("false");
rt_nl(): rt_ps("\n"); if RT_OUT.n > 65536: rt_flush();
rt_exit(c int): rt_flush(); sys3(231, c, 0, 0);
rt_es(s const byte[:]): for c s: if RT_EN < 512: RT_EB[RT_EN] = c; RT_EN += 1
rt_eu(u u64): var b byte[24]; i := rt_digits(b, u); rt_es(b[i..]);
rt_ei(v int): u ~= v as! u64; if v < 0 { rt_es("-"); u = 0 - u } rt_eu(u);
rt_fail(loc const byte[:]): if RT_PD > 0 && RT_PLS <= RT_OUT.n { RT_OUT.n = RT_PLS } rt_es(" ("); rt_es(loc); rt_es(")\n"); if RT_TID >= 0 && mld(RT_REC + 56) != 0 { rt_tabort() } rt_flush(); rt_write(2, RT_EB[..RT_EN]); sys3(231, 1, 0, 0);
rt_die(k int, loc const byte[:]): rt_es("helium runtime error: "); if k == 1 { rt_es("integer overflow") } if k == 2 { rt_es("division by zero") } if k == 4 { rt_es("cast changes the value") } if k == 5 { rt_es(if RT_TIER != 0 { "array grew past its region" } else { "array grew past 16 GiB" }) } if k == 6 { rt_es("assert failed") } if k == 7 { rt_es("division overflow") } rt_fail(loc);
rt_ovfd(a int, b int, k int, loc const byte[:]):
