rt_flmv(f int, d int, s int, k int): if d < s: for j k { mst(f + 8 * (d + j), mld(f + 8 * (s + j))) } else: j ~= k - 1; while j >= 0: mst(f + 8 * (d + j), mld(f + 8 * (s + j))); j -= 1
rt_sfree(v RtV&, idx int, len int):
	if len <= 0: return
	f := rt_flp(v); n := v.fln; pos ~= 0
	while pos < n && mld(f + 16 * pos) < idx: pos += 1
	q := f + 16 * (pos - 1)
	if pos > 0 && mld(q) + mld(q + 8) == idx: mst(q + 8, mld(q + 8) + len); if pos < n && mld(q) + mld(q + 8) == mld(f + 16 * pos) { mst(q + 8, mld(q + 8) + mld(f + 16 * pos + 8)); rt_flmv(f, 2 * pos, 2 * (pos + 1), 2 * (n - pos - 1)); v.fln -= 1 } return
	if pos < n && idx + len == mld(f + 16 * pos): mst(f + 16 * pos, idx); mst(f + 16 * pos + 8, mld(f + 16 * pos + 8) + len); return
	rt_flmv(f, 2 * (pos + 1), 2 * pos, 2 * (n - pos)); mst(f + 16 * pos, idx); mst(f + 16 * pos + 8, len); v.fln += 1
rt_stake(v RtV&, k int, esz int, loc const byte[:]) int:
	if k < 0: rt_abort("alloc_slice of a negative length", loc)
