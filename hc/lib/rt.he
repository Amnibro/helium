rt_find_any(s const byte[:], m int) int: i ~= 0; k := mld1(m + 256); p := ptr(s); if k >= 1 && k <= 3 { w, iv := rt_bw(m); while i + 32 <= s.len { x := rt_bm32(p + i, w) ^ (iv | iv << 16); if x != 0 { return i + rt_ctz(x as u64) } i += 32 } while i + 16 <= s.len { x := rt_bm16(p + i, w) ^ iv; if x != 0 { return i + rt_ctz(x as u64) } i += 16 } } else if rt_simd256() && rt_lo7(m) { while i + 32 <= s.len { x := rt_bms32(p + i, m); if x != 0 { return i + rt_ctz(x as u64) } i += 32 } } while i < s.len { if mld1(m + s[i] as int) != 0 { return i } i += 1 } -1
