extern rt_ctz(x u64) int = "hr_ctz"
rt_z8(y u64) u64: t := (y & 0x7F7F7F7F7F7F7F7F) + 0x7F7F7F7F7F7F7F7F; ~(t | y | 0x7F7F7F7F7F7F7F7F)
