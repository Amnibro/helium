rt_p5b(e int) int: (e * 1217359 >> 19) + 1
rt_mulw(a u64, b u64) u64, u64: a0 := a & 0xFFFFFFFF; a1 := a >> 32; b0 := b & 0xFFFFFFFF; b1 := b >> 32; p00 := a0 * b0; p01 := a0 * b1; p10 := a1 * b0; mid := (p00 >> 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF); return a1 * b1 + (p01 >> 32) + (p10 >> 32) + (mid >> 32), mid << 32 | p00 & 0xFFFFFFFF
rt_ms64(m u64, t u64[684]&, q int, j int) u64: h0, l0 := rt_mulw(m, t[2 * q]); h2, l2 := rt_mulw(m, t[2 * q + 1]); lo := l2 + h0; hi := h2 + (if lo < h0 { (1) as u64 } else { (0) as u64 }); s := j - 64; if s >= 64: hi >> (s - 64) as u64 else: if s == 0: lo else: lo >> s as u64 | hi << (64 - s) as u64
rt_ms64b(m u64, t u64[652]&, q int, j int) u64: h0, l0 := rt_mulw(m, t[2 * q]); h2, l2 := rt_mulw(m, t[2 * q + 1]); lo := l2 + h0; hi := h2 + (if lo < h0 { (1) as u64 } else { (0) as u64 }); s := j - 64; if s >= 64: hi >> (s - 64) as u64 else: if s == 0: lo else: lo >> s as u64 | hi << (64 - s) as u64
rt_ms32(m u64, f u64, sh int) u64: b0 := m * (f & 0xFFFFFFFF); b1 := m * (f >> 32); (b0 >> 32) + b1 >> ((sh - 32) as u64) & 0xFFFFFFFF
rt_p5f(v0 u64) int: v ~= v0; c ~= 0; while v % 5 == 0 { v = v / 5; c += 1 } c
rt_l10p2(e int) int: e * 78913 >> 18
rt_l10p5(e int) int: e * 732923 >> 20
rt_d2d(bits u64) u64, int:
	ma := bits & 0xFFFFFFFFFFFFF; ie := (bits >> 52 & 0x7FF) as int
	e2 := if ie == 0 { 1 - 1023 - 52 - 2 } else { ie - 1023 - 52 - 2 }; m2 := if ie == 0 { ma } else { ma | ((1) as u64) << 52 }
	ab := m2 & 1 == 0; mv := 4 * m2; mms := if ma != 0 || ie <= 1 { (1) as u64 } else { (0) as u64 }
	vr u64 ~= 0; vp u64 ~= 0; vm u64 ~= 0; e10 ~= 0; vmt ~= false; vrt ~= false
	if e2 >= 0:
		q := rt_l10p2(e2) - (if e2 > 3 { 1 } else { 0 }); e10 = q
		k := 125 + rt_p5b(q) - 1; i := -e2 + q + k
		vr = rt_ms64(mv, RT_P5I, q, i); vp = rt_ms64(mv + 2, RT_P5I, q, i); vm = rt_ms64(mv - 1 - mms, RT_P5I, q, i)
		if q <= 21: if mv % 5 == 0: vrt = rt_p5f(mv) >= q else: if ab: vmt = rt_p5f(mv - 1 - mms) >= q else: if rt_p5f(mv + 2) >= q: vp -= 1
	else:
		q := rt_l10p5(-e2) - (if -e2 > 1 { 1 } else { 0 }); e10 = q + e2
		i := -e2 - q; k := rt_p5b(i) - 125; j := q - k
		vr = rt_ms64b(mv, RT_P5, i, j); vp = rt_ms64b(mv + 2, RT_P5, i, j); vm = rt_ms64b(mv - 1 - mms, RT_P5, i, j)
		if q <= 1: vrt = true; if ab { vmt = mms == 1 } else { vp -= 1 } else: if q < 63: vrt = mv & (((1) as u64) << q as u64) - 1 == 0
	rm ~= 0; ld u64 ~= 0; out u64 ~= 0
	if vmt || vrt:
		loop: pd := vp / 10; md := vm / 10; if pd <= md { break } vmt = vmt && vm % 10 == 0; vrt = vrt && ld == 0; ld = vr % 10; vr = vr / 10; vp = pd; vm = md; rm += 1
		if vmt: loop: if vm % 10 != 0 { break } vrt = vrt && ld == 0; ld = vr % 10; vr = vr / 10; vp = vp / 10; vm = vm / 10; rm += 1
		if vrt && ld == 5 && vr % 2 == 0: ld = 4
		out = vr + (if vr == vm && (!ab || !vmt) || ld >= 5 { (1) as u64 } else { (0) as u64 })
	else:
		up ~= false
		if vp / 100 > vm / 100: up = vr % 100 >= 50; vr = vr / 100; vp = vp / 100; vm = vm / 100; rm += 2
		loop: pd := vp / 10; md := vm / 10; if pd <= md { break } up = vr % 10 >= 5; vr = vr / 10; vp = pd; vm = md; rm += 1
