extern rt_bm16(p int, w int) int = "hr_bm16"
inline rt_match16(s const byte[:], i int, w int) int: rt_bm16(ptr(s) + i, w)
extern rt_bm32(p int, w int) int = "hr_bm32"
inline rt_match32(s const byte[:], i int, w int) int: rt_bm32(ptr(s) + i, w)
rt_bm32s(p int, w int) int: rt_bm16s(p, w) | rt_bm16s(p + 16, w) << 16
extern rt_bms32(p int, m int) int = "hr_bms32"
extern rt_simd256() bool = "hr_simd256"
