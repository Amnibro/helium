struct TNode { b AABB, fi int, h int }
struct TProxy { ud u64, cat u64, node int, next int }
struct TStats { nv int, lv int }
struct DTree { nodes TNode[>..], par int[>..], px TProxy[>..], nend int = 2, pfree int = -1, pcount int = 0, pxfree int = 0, swap TNode[>..], has_swap bool = false, rcap int = 0, dfs bool = true }
TN_MOVED := 1073741824
TN_LEAF := 2147483648
TN_MASK := 1073741823
TN_EMPTY := 3221225471
TSTACK := 512
PINF := binary::f32_from_bits(2139095040)
INF_BOX := AABB{float3{PINF, PINF, PINF}, float3{-PINF, -PINF, -PINF}}
EMPTY_NODE := TNode{INF_BOX, 3221225471, 0}
is_leaf(n TNode) bool: n.fi & TN_LEAF != 0
is_moved(n TNode) bool: n.fi & TN_MOVED != 0
left_of(n TNode) int: n.fi & TN_MASK
node_h(n TNode) int: if is_leaf(n) { 0 } else { n.h }
root_pair(t DTree&) int: if is_leaf(t.nodes[0]) { 0 } else { left_of(t.nodes[0]) }
tovl(a AABB, b AABB) bool: a.lower.x <= b.upper.x && a.lower.y <= b.upper.y && a.lower.z <= b.upper.z && b.lower.x <= a.upper.x && b.lower.y <= a.upper.y && b.lower.z <= a.upper.z
cat_ok(c u64, m u64, all bool) bool: if all { (c & m) == m } else { (c & m) != 0 }
new_tree(cap0 int) DTree:
	c := max(cap0, 16); t ~= DTree{..}; t.nend = 2; t.pfree = -1; t.dfs = true
	for i 2 * c: t.nodes.push(TNode{AABB{V0, V0}, 0, 0}); t.par.push(0)
	t.nodes[0] = EMPTY_NODE; t.nodes[1] = EMPTY_NODE; t.par[0] = -1; t.par[1] = -1
	for i c: t.px.push(TProxy{0, 0, -1, if i < c - 1 { i + 1 } else { -1 }})
	t
mk_internal(ns TNode[>..]&, p int) TNode: a := ns[p]; b := ns[p + 1]; TNode{box_union(a.b, b.b), p | ((a.fi | b.fi) & TN_MOVED), 1 + max(node_h(a), node_h(b))}
alloc_pair(t DTree&) int:
	if t.pfree != -1: p := t.pfree; t.pfree = t.par[p]; return p
	if t.nend + 2 > t.nodes.len:
		oc := t.nodes.len; nc ~= oc + (oc >> 1); nc += nc & 1
		for i nc - oc: t.nodes.push(TNode{AABB{V0, V0}, 0, 0}); t.par.push(0)
		t.swap.clear(); t.has_swap = false
	p := t.nend; t.nend += 2; p
free_pair(t DTree&, p int): t.nodes[p] = EMPTY_NODE; t.nodes[p + 1] = EMPTY_NODE; t.par[p] = t.pfree; t.par[p + 1] = -1; t.pfree = p
alloc_proxy(t DTree&) int:
	if t.pxfree == -1:
		oc := t.px.len; nc := oc + max(oc >> 1, 1)
		for i oc..nc: t.px.push(TProxy{0, 0, -1, if i < nc - 1 { i + 1 } else { -1 }})
		t.pxfree = oc
	i := t.pxfree; t.pxfree = t.px[i].next; t.px[i] = TProxy{0, 0, -1, -1}; t.pcount += 1; i
link_children(t DTree&, i int):
	n := t.nodes[i]
	if is_leaf(n) { t.px[left_of(n)].node = i } else { p := left_of(n); t.par[p] = i; t.par[p + 1] = i }
node_ordered(ns TNode[>..]&, i int) bool: is_leaf(ns[i]) || i < left_of(ns[i])
best_sibling(t DTree&, bd AABB) int:
	cd := box_center(bd); ad := perimeter(bd); ns := t.nodes; ni ~= 0
	if is_leaf(ns[0]): return 0
	rb := ns[0].b; ab ~= perimeter(rb); dc ~= perimeter(box_union(rb, bd)); ic ~= 0.0 as f32; bs ~= 0; bc ~= dc
	loop:
		c1 := left_of(ns[ni]); c2 := c1 + 1; cs := dc + ic
		if cs < bc: bs = ni; bc = cs
		ic += dc - ab; l1 := is_leaf(ns[c1]); l2 := is_leaf(ns[c2]); lc1 ~= FLT_MAX; b1 := ns[c1].b; dc1 := perimeter(box_union(b1, bd)); a1 ~= 0.0 as f32
		if l1 { x := dc1 + ic; if x < bc { bs = c1; bc = x } } else { a1 = perimeter(b1); lc1 = ic + dc1 + fmin(ad - a1, 0.0) }
		lc2 ~= FLT_MAX; b2 := ns[c2].b; dc2 := perimeter(box_union(b2, bd)); a2 ~= 0.0 as f32
		if l2 { x := dc2 + ic; if x < bc { bs = c2; bc = x } } else { a2 = perimeter(b2); lc2 = ic + dc2 + fmin(ad - a2, 0.0) }
		if l1 && l2: break
		if bc <= lc1 && bc <= lc2: break
		if lc1 == lc2 && !l1: lc1 = vlen2(box_center(b1) - cd); lc2 = vlen2(box_center(b2) - cd)
		if lc1 < lc2 && !l1 { ni = c1; ab = a1; dc = dc1 } else { ni = c2; ab = a2; dc = dc2 }
	bs
swap_nodes(t DTree&, d int, u int):
	x := t.nodes[d]; t.nodes[d] = t.nodes[u]; t.nodes[u] = x; link_children(t, d); link_children(t, u)
	if !node_ordered(t.nodes, d) || !node_ordered(t.nodes, u): t.dfs = false
	c := d ^ 1; t.nodes[c] = mk_internal(t.nodes, left_of(t.nodes[c]))
rotate_nodes(t DTree&, ia int):
	ib := left_of(t.nodes[ia]); ic := ib + 1; b := t.nodes[ib]; c := t.nodes[ic]; lb := is_leaf(b); lc := is_leaf(c)
	if lb && lc: return
	bd ~= -1; bu ~= -1; bx ~= 0.0 as f32
	if !lc:
		f := left_of(c); g := f + 1; ac := perimeter(c.b); d1 := perimeter(box_union(b.b, t.nodes[g].b)) - ac
		if d1 < bx: bd = ib; bu = f; bx = d1
		d2 := perimeter(box_union(b.b, t.nodes[f].b)) - ac
		if d2 < bx: bd = ib; bu = g; bx = d2
	if !lb:
		d := left_of(b); e := d + 1; ab := perimeter(b.b); d1 := perimeter(box_union(c.b, t.nodes[e].b)) - ab
		if d1 < bx: bd = ic; bu = d; bx = d1
		d2 := perimeter(box_union(c.b, t.nodes[d].b)) - ab
		if d2 < bx: bd = ic; bu = e; bx = d2
	if bd != -1: swap_nodes(t, bd, bu)
insert_leaf(t DTree&, b AABB, pid int, mv bool, rot bool):
	ud := t.px[pid].ud; s32 := (ud & 0xFFFFFFFF) as int; lf := TNode{b, pid | TN_LEAF | (if mv { TN_MOVED } else { 0 }), if s32 >= 2147483648 { s32 - 4294967296 } else { s32 }}
	if t.nodes[0].fi == TN_EMPTY: t.nodes[0] = lf; t.px[pid].node = 0; return
	s := best_sibling(t, b); p := alloc_pair(t); t.nodes[p] = t.nodes[s]; t.nodes[p + 1] = lf; t.par[p] = s; t.par[p + 1] = s; link_children(t, p); t.px[pid].node = p + 1; t.nodes[s] = mk_internal(t.nodes, p)
	if !node_ordered(t.nodes, s) || !node_ordered(t.nodes, p): t.dfs = false
	i ~= s
	while i != -1:
		if rot: rotate_nodes(t, i)
		t.nodes[i] = mk_internal(t.nodes, left_of(t.nodes[i])); i = t.par[i]
remove_leaf(t DTree&, pid int):
	lf := t.px[pid].node
	if lf == 0: t.nodes[0] = EMPTY_NODE; return
	pa := t.par[lf]; t.nodes[pa] = t.nodes[lf ^ 1]; link_children(t, pa); free_pair(t, lf & ~1); i ~= t.par[pa]
	while i != -1: t.nodes[i] = mk_internal(t.nodes, left_of(t.nodes[i])); i = t.par[i]
tree_create(t DTree&, b AABB, cat u64, ud u64, mv bool) int: p := alloc_proxy(t); t.px[p].cat = cat; t.px[p].ud = ud; insert_leaf(t, b, p, mv, true); p
tree_destroy(t DTree&, p int): remove_leaf(t, p); t.px[p].node = -1; t.px[p].next = t.pxfree; t.pxfree = p; t.pcount -= 1
tree_move(t DTree&, p int, b AABB, mv bool): remove_leaf(t, p); insert_leaf(t, b, p, mv, false)
tree_enlarge(t DTree&, p int, b AABB):
	i ~= t.px[p].node; t.nodes[i].b = b; t.nodes[i].fi |= TN_MOVED; i = t.par[i]
	while i != -1:
		ch := enlarge(t.nodes[i].b, b); t.nodes[i].fi |= TN_MOVED; i = t.par[i]
		if !ch: break
	while i != -1 && t.nodes[i].fi & TN_MOVED == 0: t.nodes[i].fi |= TN_MOVED; i = t.par[i]
tree_height(t DTree&) int: node_h(t.nodes[0])
tree_area_ratio(t DTree&) f32:
	if t.pcount == 0: return 0.0
	ra := perimeter(t.nodes[0].b)
	if ra <= 0.0: return 0.0
	ia ~= 0.0 as f32
	for i 2..t.nend: if !is_leaf(t.nodes[i]) { ia += perimeter(t.nodes[i].b) }
	ia / ra
tree_root_box(t DTree&) AABB: if t.pcount == 0 { AABB{V0, V0} } else { t.nodes[0].b }
tree_bytes(t DTree&) int: 112 + t.nodes.len * 36 + t.px.len * 24 + (if t.has_swap { t.nodes.len * 32 } else { 0 }) + t.rcap * 76
tree_query<F>(t DTree&, b AABB, m u64, all bool) TStats:
	r ~= TStats{0, 0}
	if t.pcount == 0: return r
	st int[>..] ~= [root_pair(t)]
	while st.len > 0:
		p := st.pop(); r.nv += 1
		for i 2:
			n := t.nodes[p + i]
			if !tovl(b, n.b): continue
			if is_leaf(n):
				id := left_of(n); x := t.px[id]
				if cat_ok(x.cat, m, all):
					go := F(id, x.ud); r.lv += 1
					if !go: return r
			else if st.len < TSTACK - 1: st.push(left_of(n))
	r
node_d2(p float3, n TNode) f32: r := p - vclamp(p, n.b.lower, n.b.upper); dot(r, r)
struct QItem { ni int, d f32 }
tree_closest<F>(t DTree&, p float3, m u64, all bool, msq f32&) TStats:
	r ~= TStats{0, 0}
	if t.pcount == 0: return r
	ms ~= msq; rp := root_pair(t); s1 := QItem{rp, node_d2(p, t.nodes[rp])}; st QItem[>..] ~= []
	if rp == 0 { st.push(s1) } else { s2 := QItem{rp + 1, node_d2(p, t.nodes[rp + 1])}; if s2.d < s1.d { st.push(s1); st.push(s2) } else { st.push(s2); st.push(s1) } }
	while st.len > 0:
		it := st.pop(); n := t.nodes[it.ni]; r.nv += 1
		if it.d >= ms: continue
		if is_leaf(n):
			id := left_of(n); x := t.px[id]
			if !cat_ok(x.cat, m, all): continue
			dd := F(ms, id, x.ud)
			if dd < ms: ms = dd
			r.lv += 1; continue
		if st.len + 2 > TSTACK: continue
		q := left_of(n); i1 := QItem{q, node_d2(p, t.nodes[q])}; i2 := QItem{q + 1, node_d2(p, t.nodes[q + 1])}
		if i2.d < i1.d { st.push(i1); st.push(i2) } else { st.push(i2); st.push(i1) }
	msq = ms; r
tree_cast<F>(t DTree&, b AABB, tr float3, maxf0 f32, m u64, all bool, ray bool) TStats:
	r ~= TStats{0, 0}
	if t.pcount == 0: return r
	p1 := box_center(b); ex := box_ext(b); mf ~= maxf0; tb ~= if ray { q := madd(p1, mf, tr); AABB{vmin(p1, q), vmax(p1, q)} } else { s := sv(mf, tr); AABB{vmin(b.lower, b.lower + s), vmax(b.upper, b.upper + s)} }
	st int[>..] ~= [root_pair(t)]
	while st.len > 0:
		p := st.pop(); r.nv += 1; hs int[>..] ~= []
		for i 2:
			n := t.nodes[p + i]
			if !tovl(tb, n.b): continue
			if !bray(n.b.lower - ex, n.b.upper + ex, p1, tr): continue
			hs.push(p + i)
		if hs.len == 2 && !is_leaf(t.nodes[hs[0]]) && !is_leaf(t.nodes[hs[1]]) && vdist2(box_center(t.nodes[hs[0]].b), p1) < vdist2(box_center(t.nodes[hs[1]].b), p1): x := hs[0]; hs[0] = hs[1]; hs[1] = x
		for h hs:
			n := t.nodes[h]
			if is_leaf(n):
				id := left_of(n); x := t.px[id]
				if !cat_ok(x.cat, m, all): continue
				v := F(mf, id, x.ud); r.lv += 1
				if v == 0.0: return r
				if 0.0 < v && (if ray { v <= mf } else { v < mf }): mf = v; tb = if ray { q := madd(p1, mf, tr); AABB{vmin(p1, q), vmax(p1, q)} } else { s := sv(mf, tr); AABB{vmin(b.lower, b.lower + s), vmax(b.upper, b.upper + s)} }
			else if st.len < TSTACK - 1: st.push(left_of(n))
	r
tree_ray<F>(t DTree&, org float3, tr float3, maxf f32, m u64, all bool) TStats: tree_cast(t, AABB{org, org}, tr, maxf, m, all, true) { a, b, c => F(a, b, c) }
tree_boxcast<F>(t DTree&, b AABB, tr float3, maxf f32, m u64, all bool) TStats: tree_cast(t, b, tr, maxf, m, all, false) { a, c, d => F(a, c, d) }
part_mid(ix int[>..]&, cs float3[>..]&, s int, n int) int:
	if n <= 2: return n / 2
	lo ~= cs[s]; hi ~= lo
	for i 1..n: lo = vmin(lo, cs[s + i]); hi = vmax(hi, cs[s + i])
	d := hi - lo; ax := if d.x >= d.y && d.x >= d.z { 0 } else if d.y >= d.z { 1 } else { 2 }; pv := vget(sv(0.5, lo + hi), ax); i1 ~= 0; i2 ~= n
	while i1 < i2:
		while i1 < i2 && vget(cs[s + i1], ax) < pv: i1 += 1
		while i1 < i2 && vget(cs[s + i2 - 1], ax) >= pv: i2 -= 1
		if i1 < i2: a := ix[s + i1]; ix[s + i1] = ix[s + i2 - 1]; ix[s + i2 - 1] = a; c := cs[s + i1]; cs[s + i1] = cs[s + i2 - 1]; cs[s + i2 - 1] = c; i1 += 1; i2 -= 1
	if i1 > 0 && i1 < n { i1 } else { n / 2 }
bump_pair(t DTree&, pa int) int: p := t.nend; t.nend += 2; t.par[p] = pa; t.par[p + 1] = pa; p
set_left(n TNode&, p int): n.fi = (n.fi & ~TN_MASK) | p
copy_subtree(t DTree&, n0 TNode, ni int):
	if is_leaf(n0): t.swap[ni] = n0; t.px[left_of(n0)].node = ni; return
	n ~= n0; st int[>..] ~= []; op ~= left_of(n); np ~= bump_pair(t, ni); set_left(n, np); t.swap[ni] = n
	loop:
		t.swap[np] = t.nodes[op]; t.swap[np + 1] = t.nodes[op + 1]
		if is_leaf(t.swap[np + 1]) { t.px[left_of(t.swap[np + 1])].node = np + 1 } else if st.len < 2 * TSTACK { st.push(left_of(t.swap[np + 1])); st.push(np + 1) }
		if !is_leaf(t.swap[np]): li := np; op = left_of(t.swap[np]); np = bump_pair(t, li); set_left(t.swap[li], np); continue
		t.px[left_of(t.swap[np])].node = np
		if st.len == 0: break
		ix := st.pop(); op = st.pop(); np = bump_pair(t, ix); set_left(t.swap[ix], np)
place_leaf(t DTree&, n TNode, ni int): if is_leaf(n) { t.swap[ni] = n; t.px[left_of(n)].node = ni } else { copy_subtree(t, n, ni) }
struct RItem { ni int, p int, cc int, s int, sp int, e int }
build_tree(t DTree&, lv TNode[>..]&, ix int[>..]&, cs float3[>..]&, lc int):
	t.nend = 2; t.swap[1] = EMPTY_NODE; t.par[0] = -1; t.par[1] = -1
	if lc == 1: place_leaf(t, lv[ix[0]], 0); return
	st RItem[>..] ~= [RItem{0, bump_pair(t, 0), -1, 0, part_mid(ix, cs, 0, lc), lc}]; top ~= 0
	loop:
		st[top].cc += 1; it := st[top]
		if it.cc == 2:
			t.swap[it.ni] = mk_internal(t.swap, it.p)
			if top == 0: break
			top -= 1; st.pop(); continue
		s := if it.cc == 0 { it.s } else { it.sp }; e := if it.cc == 0 { it.sp } else { it.e }; ni := it.p + it.cc
		if e - s == 1: place_leaf(t, lv[ix[s]], ni); continue
		np := bump_pair(t, ni); top += 1; st.push(RItem{ni, np, -1, s, s + part_mid(ix, cs, s, e - s), e})
tree_rebuild(t DTree&, full bool) int:
	if t.pcount == 0: return 0
	rt := t.nodes[0]
	if !full && !is_moved(rt) && t.dfs: return 0
	if !t.has_swap: t.swap.clear(); for i t.nodes.len { t.swap.push(TNode{AABB{V0, V0}, 0, 0}) } t.has_swap = true
	if t.pcount > t.rcap: t.rcap = t.pcount + t.pcount / 2
	ix int[>..] ~= []; lv TNode[>..] ~= []; cs float3[>..] ~= []; st int[>..] ~= []
	if !is_leaf(rt) && (full || is_moved(rt)):
		st.push(left_of(rt))
	else:
		n ~= rt
		n.fi &= ~TN_MOVED
		lv.push(n)
		cs.push(box_center(n.b))
		ix.push(0)
	while st.len > 0:
		p := st.pop()
		for i 2:
			n ~= t.nodes[p + i]
			if !is_leaf(n) && (full || is_moved(n)): st.push(left_of(n)); continue
			n.fi &= ~TN_MOVED; ix.push(lv.len); lv.push(n); cs.push(box_center(n.b))
	build_tree(t, lv, ix, cs, lv.len); t.nodes.clear(); t.nodes.append(t.swap[..]); t.pfree = -1; t.dfs = true; lv.len
tree_mark_serial(t DTree&, p int):
	i ~= t.px[p].node
	while i != -1: t.nodes[i].fi |= TN_MOVED; i = t.par[i]
tree_mark_moved(t DTree&, p int, b AABB):
	i ~= t.px[p].node; t.nodes[i].b = b; t.nodes[i].fi |= TN_MOVED; i = t.par[i]
	while i != -1 && t.nodes[i].fi & TN_MOVED == 0: t.nodes[i].fi |= TN_MOVED; i = t.par[i]
tree_clear_moved(t DTree&):
	if !is_moved(t.nodes[0]): return
	t.nodes[0].fi &= ~TN_MOVED
	if is_leaf(t.nodes[0]): return
	st int[>..] ~= [left_of(t.nodes[0])]
	while st.len > 0:
		p := st.pop()
		for i 2:
			if t.nodes[p + i].fi & TN_MOVED != 0:
				t.nodes[p + i].fi &= ~TN_MOVED
				if !is_leaf(t.nodes[p + i]) && st.len < TSTACK: st.push(left_of(t.nodes[p + i]))
tree_gather_moved(t DTree&) int[>..]:
	o int[>..] ~= []; rt := t.nodes[0]
	if !is_moved(rt): return o
	if is_leaf(rt): o.push(left_of(rt)); return o
	st int[>..] ~= [left_of(rt)]
	while st.len > 0:
		p := st.pop()
		for i 2:
			n := t.nodes[p + i]
			if !is_moved(n): continue
			if is_leaf(n) { o.push(left_of(n)) } else if st.len < TSTACK { st.push(left_of(n)) }
	o
tree_refit(t DTree&):
	if !is_moved(t.nodes[0]): return
	if !t.dfs:
		r := t.nodes[0]
		if is_leaf(r): return
		st int[>..] ~= [~0, left_of(r), left_of(r) + 1]
		while st.len > 0:
			it := st.pop()
			if it < 0: q := left_of(t.nodes[~it]); t.nodes[~it].b = box_union(t.nodes[q].b, t.nodes[q + 1].b); continue
			n := t.nodes[it]
			if is_leaf(n) || !is_moved(n): continue
			if st.len + 3 <= TSTACK: q := left_of(n); st.push(~it); st.push(q); st.push(q + 1)
		return
	p ~= t.nend - 2
	while p >= 0:
		f1 := t.nodes[p].fi; f2 := t.nodes[p + 1].fi
		if (f1 | f2) & TN_MOVED != 0:
			if f1 & (TN_LEAF | TN_MOVED) == TN_MOVED: c := f1 & TN_MASK; t.nodes[p].b = box_union(t.nodes[c].b, t.nodes[c + 1].b)
			if f2 & (TN_LEAF | TN_MOVED) == TN_MOVED: c := f2 & TN_MASK; t.nodes[p + 1].b = box_union(t.nodes[c].b, t.nodes[c + 1].b)
		p -= 2
struct BPhase { tr DTree[>..], pairs dictionary<u64, int> }
BP_SMASK := 4194303
new_bp(sc int, dc int) BPhase: bp ~= BPhase{..}; bp.tr.push(new_tree(sc)); bp.tr.push(new_tree(16)); bp.tr.push(new_tree(dc)); bp
pair_key(s1 int, s2 int, c int) u64: ((min(s1, s2) & BP_SMASK) as! u64) << 42 | ((max(s1, s2) & BP_SMASK) as! u64) << 20 | ((c & 1048575) as! u64)
key_a(k u64) int: (k >> 42 & 4194303) as! int
key_b(k u64) int: (k >> 20 & 4194303) as! int
key_c(k u64) int: (k & 1048575) as! int
bp_create(bp BPhase&, ty int, b AABB, cat u64, si int, force bool) int: tree_create(bp.tr[ty], b, cat, si as! u64, ty != 0 || force) << 2 | ty
bp_destroy(bp BPhase&, k int): tree_destroy(bp.tr[k & 3], k >> 2)
bp_move(bp BPhase&, k int, b AABB): tree_move(bp.tr[k & 3], k >> 2, b, true)
bp_box(bp BPhase&, k int) AABB: bp.tr[k & 3].nodes[bp.tr[k & 3].px[k >> 2].node].b
bp_shape(bp BPhase&, k int) int: bp.tr[k & 3].px[k >> 2].ud as! int
box_overlaps(a AABB, b AABB) bool: !(a.upper.x < b.lower.x || a.lower.x > b.upper.x || a.upper.y < b.lower.y || a.lower.y > b.upper.y || a.upper.z < b.lower.z || a.lower.z > b.upper.z)
bp_overlap(bp BPhase&, ka int, kb int) bool: box_overlaps(bp_box(bp, ka), bp_box(bp, kb))
tpair(a TNode, b TNode) bool: (a.fi | b.fi) & TN_MOVED != 0 && tovl(a.b, b.b)
needs_rebuild(t DTree&) bool: is_moved(t.nodes[0]) || !t.dfs
proxy_subtree<F>(p TNode, ns TNode[>..]&, pr int, cc bool):
	mk := p.fi & TN_MOVED; st int[>..] ~= [pr]
	while st.len > 0:
		q := st.pop()
		for i 2:
			n := ns[q + i]
			if (n.fi | mk) & TN_MOVED == 0 || !tovl(p.b, n.b): continue
			if is_leaf(n) { F(min(p.h, n.h), max(p.h, n.h), cc) } else if st.len < TSTACK { st.push(left_of(n)) }
visit_pair<F>(na TNode[>..]&, nb TNode[>..]&, a TNode, b TNode, st int[>..]&, cc bool):
	if !tpair(a, b): return
	la := is_leaf(a); lb := is_leaf(b)
	if la && lb { F(min(a.h, b.h), max(a.h, b.h), cc) } else if la { proxy_subtree(a, nb, left_of(b), cc) { x, y, c => F(x, y, c) } } else if lb { proxy_subtree(b, na, left_of(a), cc) { x, y, c => F(x, y, c) } } else if st.len < 2 * TSTACK { st.push(left_of(a)); st.push(left_of(b)) }
cross_pairs<F>(na TNode[>..]&, nb TNode[>..]&, a TNode, b TNode, cc bool):
	st int[>..] ~= []
	visit_pair(na, nb, a, b, st, cc) { x, y, c => F(x, y, c) }
	while st.len > 0:
		j := st.pop(); i := st.pop()
		for u 2: for v 2: visit_pair(na, nb, na[i + u], nb[j + v], st, cc) { x, y, c => F(x, y, c) }
bp_find<F>(bp BPhase&, chk bool) bool:
	if !(is_moved(bp.tr[0].nodes[0]) || needs_rebuild(bp.tr[1]) || needs_rebuild(bp.tr[2])): return false
	for ty 2: cross_pairs(bp.tr[2].nodes, bp.tr[ty].nodes, bp.tr[2].nodes[0], bp.tr[ty].nodes[0], ty == 0 && chk) { x, y, c => F(x, y, c) }
	p ~= 2
	while p < bp.tr[2].nend:
		if (bp.tr[2].nodes[p].fi | bp.tr[2].nodes[p + 1].fi) & TN_MOVED != 0: cross_pairs(bp.tr[2].nodes, bp.tr[2].nodes, bp.tr[2].nodes[p], bp.tr[2].nodes[p + 1], false) { x, y, c => F(x, y, c) }
		p += 2
	tree_clear_moved(bp.tr[0]); tree_rebuild(bp.tr[2], false); tree_rebuild(bp.tr[1], false)
	true
SH_CAPSULE := 0
SH_COMPOUND := 1
SH_HEIGHT := 2
SH_HULL := 3
SH_MESH := 4
SH_SPHERE := 5
struct Mat { fr f32 = 0.6, rest f32 = 0.0, roll f32 = 0.0, tv float3 = V0, uid u64 = 0, color u32 = 0 }
struct CCap { c Capsule, mat int }
struct CSph { s Sphere, mat int }
struct HInst { xf Transform, h int, mat int }
struct MInst { xf Transform, sc float3, m int, mi int[4] }
struct CHullDef { h int, xf Transform, mat Mat }
struct CMeshDef { m int, xf Transform, sc float3, mats Mat[>..] }
struct CompoundD { tree DTree, mats Mat[>..], caps CCap[>..], hi HInst[>..], hs HData[>..], mi MInst[>..], ms MeshD[>..], sph CSph[>..], bytes int = 0 }
struct Child { ty int, cap Capsule, sph Sphere, h int, m int, sc float3, xf Transform, mi int[4] }
al8(n int) int: (n + 7) & -8
hull_bytes(h HData&) int: v := h.pts.len; f := h.pl.len; 144 + al8(v) + al8(12 * v) + al8(4 * h.eg.len) + al8(16 * f) + al8(f) + al8(12 * ((v + 3) & -4)) + al8(12 * ((f + 3) & -4))
mesh_bytes(m MeshD&) int: t := m.t.len; 96 + al8(32 * m.nodes.len) + al8(12 * m.v.len) + al8(12 * t) + 2 * al8(t)
hf_bytes(f HField&) int: c := (f.rows - 1) * (f.cols - 1); 96 + al8(2 * f.rows * f.cols) + al8(c) + al8(2 * c)
fb(x f32) u32: binary::f32_bits(x)
f3b(a float3, b float3) bool: fb(a.x) == fb(b.x) && fb(a.y) == fb(b.y) && fb(a.z) == fb(b.z)
mat_eq(a Mat, b Mat) bool: fb(a.fr) == fb(b.fr) && fb(a.rest) == fb(b.rest) && fb(a.roll) == fb(b.roll) && f3b(a.tv, b.tv) && a.uid == b.uid && a.color == b.color
mesh_eq(a MeshD&, b MeshD&) bool:
	if a.hash != b.hash || a.nodes.len != b.nodes.len || a.v.len != b.v.len || a.t.len != b.t.len || a.mcount != b.mcount || a.degen != b.degen || a.height != b.height || fb(a.area) != fb(b.area) || !f3b(a.bounds.lower, b.bounds.lower) || !f3b(a.bounds.upper, b.bounds.upper): return false
	for i a.v.len: if !f3b(a.v[i], b.v[i]) { return false }
	for i a.t.len: if a.t[i].i1 != b.t[i].i1 || a.t[i].i2 != b.t[i].i2 || a.t[i].i3 != b.t[i].i3 || a.mat[i] != b.mat[i] || a.fl[i] != b.fl[i] { return false }
	for i a.nodes.len: n := a.nodes[i]; o := b.nodes[i]; if !f3b(n.lo, o.lo) || !f3b(n.hi, o.hi) || n.ax != o.ax || n.ch != o.ch || n.tc != o.tc || n.to != o.to { return false }
	true
mat_index(ms Mat[>..]&, m Mat) int:
	for i ms.len: if mat_eq(ms[i], m) { return i }
	ms.push(m); ms.len - 1
create_compound(caps const CCap[:], cmats const Mat[:], hulls const CHullDef[:], hpool HData[>..]&, meshes const CMeshDef[:], mpool MeshD[>..]&, sphs const CSph[:], smats const Mat[:]) CompoundD, bool:
	n := caps.len + hulls.len + sphs.len + meshes.len
	if n >= 1048576: return CompoundD{..}, false
	cd ~= CompoundD{..}; cd.tree = new_tree(n); ci ~= 0
	for i caps.len: cd.caps.push(CCap{caps[i].c, mat_index(cd.mats, cmats[i])}); tree_create(cd.tree, capsule_box(caps[i].c, XI), 0xFFFFFFFFFFFFFFFF, ci as! u64, true); ci += 1
	for d hulls:
		tree_create(cd.tree, hull_box(hpool[d.h], d.xf), 0xFFFFFFFFFFFFFFFF, ci as! u64, true); ci += 1
		mi := mat_index(cd.mats, d.mat); si ~= -1
		for j cd.hs.len: if si < 0 && hull_eq(cd.hs[j], hpool[d.h]) { si = j }
		if si < 0: cd.hs.push(copy(hpool[d.h])); si = cd.hs.len - 1
		cd.hi.push(HInst{d.xf, si, mi})
	for d meshes:
		tree_create(cd.tree, mesh_box(mpool[d.m], d.xf, d.sc), 0xFFFFFFFFFFFFFFFF, ci as! u64, true); ci += 1
		x ~= MInst{d.xf, d.sc, 0, [0, 0, 0, 0]}
		for j min(d.mats.len, 4): x.mi[j] = mat_index(cd.mats, d.mats[j])
		si ~= -1
		for j cd.ms.len: if si < 0 && mesh_eq(cd.ms[j], mpool[d.m]) { si = j }
		if si < 0: cd.ms.push(copy(mpool[d.m])); si = cd.ms.len - 1
		x.m = si; cd.mi.push(x)
	for i sphs.len: cd.sph.push(CSph{sphs[i].s, mat_index(cd.mats, smats[i])}); tree_create(cd.tree, sphere_box(sphs[i].s, XI), 0xFFFFFFFFFFFFFFFF, ci as! u64, true); ci += 1
	tree_rebuild(cd.tree, true)
	b ~= 184 + al8(32 * cd.tree.nend) + al8(24 * cd.tree.pcount) + al8(40 * cd.mats.len) + al8(32 * caps.len) + al8(36 * hulls.len)
	for h cd.hs: b += al8(hull_bytes(h))
	b += al8(60 * meshes.len)
	for m cd.ms: b += al8(mesh_bytes(m))
	cd.bytes = b + al8(20 * sphs.len)
	return cd, true
child_of(cd CompoundD&, i0 int) Child:
	i ~= i0; c ~= Child{SH_CAPSULE, Capsule{V0, V0, 0.0}, Sphere{V0, 0.0}, -1, -1, V0, XI, [0, 0, 0, 0]}
	if i < cd.caps.len: c.cap = cd.caps[i].c; c.mi[0] = cd.caps[i].mat; return c
	i -= cd.caps.len
	if i < cd.hi.len: c.ty = SH_HULL; c.h = cd.hi[i].h; c.xf = cd.hi[i].xf; c.mi[0] = cd.hi[i].mat; return c
	i -= cd.hi.len
	if i < cd.mi.len: c.ty = SH_MESH; c.m = cd.mi[i].m; c.sc = cd.mi[i].sc; c.xf = cd.mi[i].xf; c.mi = cd.mi[i].mi; return c
	i -= cd.mi.len
	c.ty = SH_SPHERE; c.sph = cd.sph[i].s; c.mi[0] = cd.sph[i].mat; c
compound_box(cd CompoundD&, xf Transform) AABB: box_xform(xf, cd.tree.nodes[0].b)
overlap_compound(cd CompoundD&, xf Transform, px Proxy) bool:
	lp := local_pts(px, xf); l := Proxy{lp[..], px.r}; hit ~= false
	tree_query(cd.tree, proxy_box(l), 0xFFFFFFFFFFFFFFFF, false) { id, ud =>
		c := child_of(cd, ud as! int);
		o := if c.ty == SH_CAPSULE { overlap_capsule(c.cap, c.xf, l) } else if c.ty == SH_HULL { overlap_hull(cd.hs[c.h], c.xf, l) } else if c.ty == SH_MESH { overlap_mesh(cd.ms[c.m], c.sc, c.xf, l) } else { overlap_sphere(c.sph, c.xf, l) };
		if o { hit = true }
		!o
	}
	hit
child_out(cd CompoundD&, c Child&, o0 CastOut, ci int) CastOut:
	o ~= o0; o.mat = if c.ty == SH_MESH { c.mi[min(o.mat, 3)] } else { c.mi[0] }
	if o.hit: o.p = xpt(c.xf, o.p); o.n = rot(c.xf.q, o.n); o.child = ci
	o
ray_compound(cd CompoundD&, org float3, tr float3, maxf f32) CastOut:
	r ~= NOCAST
	tree_ray(cd.tree, org, tr, maxf, 0xFFFFFFFFFFFFFFFF, false) { mf, id, ud =>
		ci := ud as! int; c := child_of(cd, ci); lo := xipt(c.xf, org); lt := irot(c.xf.q, tr);
		o := child_out(cd, c, if c.ty == SH_CAPSULE { ray_capsule(c.cap, lo, lt, mf) } else if c.ty == SH_HULL { ray_hull(cd.hs[c.h], lo, lt, mf) } else if c.ty == SH_MESH { ray_mesh(cd.ms[c.m], c.sc, lo, lt, mf) } else { ray_sphere(c.sph, lo, lt, mf) }, ci);
		if o.hit { r = o; o.frac } else { mf }
	}
	r
cast_compound(cd CompoundD&, px Proxy, tr float3, maxf f32, enc bool) CastOut:
	r ~= NOCAST
	if px.pts.len == 0: return r
	tree_boxcast(cd.tree, proxy_box(px), tr, maxf, 0xFFFFFFFFFFFFFFFF, false) { mf, id, ud =>
		ci := ud as! int; c := child_of(cd, ci); lp := local_pts(px, c.xf); l := Proxy{lp[..], px.r}; lt := irot(c.xf.q, tr);
		o := child_out(cd, c, if c.ty == SH_CAPSULE { cast_capsule(c.cap, l, lt, mf, enc) } else if c.ty == SH_HULL { cast_hull(cd.hs[c.h], l, lt, mf, enc) } else if c.ty == SH_MESH { cast_mesh(cd.ms[c.m], c.sc, l, lt, mf, enc) } else { cast_sphere(c.sph, l, lt, mf, enc) }, ci);
		if o.hit { r = o; o.frac } else { mf }
	}
	r
child_sweep(cxf Transform, chx Transform) Sweep: x := xmul(cxf, chx); Sweep{V0, x.p, x.p, x.q, x.q}
mover_compound(res PlaneRes[>..]&, cap int, cd CompoundD&, mv Capsule) int:
	r := float3{mv.radius, mv.radius, mv.radius}; n0 := res.len
	tree_query(cd.tree, AABB{vmin(mv.center1, mv.center2) - r, vmax(mv.center1, mv.center2) + r}, 0xFFFFFFFFFFFFFFFF, false) { id, ud =>
		ci := ud as! int; c := child_of(cd, ci); lm := Capsule{xipt(c.xf, mv.center1), xipt(c.xf, mv.center2), mv.radius}; s := res.len;
		if c.ty == SH_MESH { mover_mesh(res, cap - (s - n0), cd.ms[c.m], c.sc, lm) } else { pr ~= PlaneRes{Plane{V0, 0.0}, V0, 0, 0, 0}; k := if c.ty == SH_CAPSULE { mover_capsule(pr, c.cap, lm) } else if c.ty == SH_HULL { mover_hull(pr, cd.hs[c.h], lm) } else { mover_sphere(pr, c.sph, lm) }; if k > 0 { res.push(pr) } };
		for i s..res.len { res[i].pl.normal = rot(c.xf.q, res[i].pl.normal); res[i].p = xpt(c.xf, res[i].p); res[i].child = ci; res[i].mat = c.mi[min(res[i].mat, 3)] };
		res.len - n0 < cap
	}
	res.len - n0
hull_box(h HData&, xf Transform) AABB: box_xform(xf, h.aabb)
