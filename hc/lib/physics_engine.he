mesh_tri_of(va View&, ti int) MTriV: if va.ty == SH_MESH { mesh_tri(vmesh(va), va.msc, ti) } else { hf_tri(G_HF[va.hf], ti) }
refresh_cache(w World&, cid int, va View&, xa Transform, b AABB):
	c := &w.contacts[cid]
	if box_contains(c.qb, b): return
	r := aabb_margin() + spec_dist(); e := float3{r, r, r}; c.qb = AABB{b.lower - e, b.upper + e}
	lb := box_xform(xinv(xa), c.qb)
	ix := if va.ty == SH_MESH { query_mesh(vmesh(va), va.msc, lb) } else { query_hf(G_HF[va.hf], lb) }
	n := min(ix.len, 256); nc TriCache[>..] ~= []; j ~= 0
	for i n:
		t ~= TriCache{ix[i], SAT{}, SCache{..}}
		while j < c.tcache.len && c.tcache[j].tri < ix[i]: j += 1
		if j < c.tcache.len && c.tcache[j].tri == ix[i]: t.sat = c.tcache[j].sat; t.sc = c.tcache[j].sc
