convex_manifold(w World&, cid int, va View&, xa Transform, vb View&, xb Transform) bool:
	lm ~= LM{..}; x := ximul(xa, xb); ta := va.ty; tb := vb.ty
	if ta == SH_SPHERE { collide_spheres(lm, 4, va.sph, vb.sph, x) } else if ta == SH_CAPSULE { if tb == SH_SPHERE { collide_capsule_sphere(lm, 4, va.cap, vb.sph, x) } else { collide_capsules(lm, 4, va.cap, vb.cap, x) } } else { if tb == SH_SPHERE { collide_hull_sphere(lm, 4, vhull(w, va), vb.sph, x, w.contacts[cid].sc) } else if tb == SH_CAPSULE { collide_hull_capsule(lm, 4, vhull(w, va), vb.cap, x, w.contacts[cid].sc) } else { collide_hulls(lm, 4, vhull(w, va), vhull(w, vb), x, w.contacts[cid].sat); w.sat_calls += 1; w.sat_hits += w.contacts[cid].sat.hit } }
