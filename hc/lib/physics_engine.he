		p := pt[i].p; sc := fmax(cross2f(p - a, ba), fmax(cross2f(p - b, cb), cross2f(p - c, ac)))
		if better_cull(sc, pt[i].s, bs, bsep, ts, sl): bs = sc; bsep = pt[i].s; bi = i
	if bi == -1: pt[0] = fp[0]; pt[1] = fp[1]; pt[2] = fp[2]; return 3
	fp.push(pt[bi]); for i 4 { pt[i] = fp[i] }
