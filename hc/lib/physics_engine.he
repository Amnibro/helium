	c.mans.clear(); for i cl.len { c.mans.push(Manifold{..}) }
	used bool[>..] ~= []; for i oc { used.push(false) }
	rb := qmat(xb.q); off := xb.p - xa.p; ro := slop()
	for i cl.len:
		m := &c.mans[i]; m.count = cl[i].pts.len; m.n = mv(rb, cl[i].mn); cn := mv(rb, cl[i].mn); bd ~= 0.995 as f32; bi ~= -1
		for j oc: if !used[j] { d := dot(old[j].n, cn); if d > bd { bi = j; bd = d } }
		if bi != -1: m.fi = old[bi].fi; m.ri = old[bi].ri; m.twist = old[bi].twist; used[bi] = true
		for j m.count:
