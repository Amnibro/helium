hf_range(f HField&, lo float3, hi float3) int[4]: [ffloor(lo.z / f.sc.z) as int, ffloor(hi.z / f.sc.z) as int, ffloor(lo.x / f.sc.x) as int, ffloor(hi.x / f.sc.x) as int]
overlap_hf(f HField&, xf Transform, px Proxy) bool:
	lp := local_pts(px, xf); l := Proxy{lp[..], px.r}; b := proxy_box(l); g := hf_range(f, b.lower, b.upper); bc := sv(0.5, b.lower + b.upper); be := b.upper - bc; ca ~= SCache{..}
