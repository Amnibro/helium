	if ta == SH_MESH || ta == SH_HEIGHT { c.flags |= CF_MESH } else if ta == SH_COMPOUND && child_of(G_CPD[w.shapes[sa].cpd], child).ty == SH_MESH { c.flags |= CF_MESH }
	if w.bodies[ba].ty == BODY_STATIC || w.bodies[bb].ty == BODY_STATIC: c.flags |= CF_STATIC
	if (w.shapes[sa].flags | w.shapes[sb].flags) & SF_CONTACT_EV != 0: c.flags |= CF_EVENTS
	if w.shapes[sa].flags & SF_SPECULATIVE != 0 && w.shapes[sb].flags & SF_SPECULATIVE != 0: c.flags |= CF_SPEC_POINTS
	c.ed[0] = CEdge{ba, -1, w.bodies[ba].hck}; ka := cid << 1; h := w.bodies[ba].hck
	if h != -1: w.contacts[h >> 1].ed[h & 1].prev = ka
