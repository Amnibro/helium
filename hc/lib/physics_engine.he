	c.id = cid; c.gen = g + 1; c.set = si; c.color = -1; c.li = w.sets[si].cidx.len; c.isl = -1; c.islx = -1; c.sa = sa; c.sb = sb; c.child = child
	if w.bodies[ba].flags & BF_RECYCLE != 0 && w.bodies[bb].flags & BF_RECYCLE != 0: c.flags |= CF_RECYCLE
