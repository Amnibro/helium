			if f & 0x44 == 0x44 && find_key(fe, m.i3, m.i1): continue
			acc.push(k)
	if acc.len == 0: w.contacts[cid].mans.clear(); return false
	cl Clu[>..] ~= []; mem int[>..] ~= []; cpc ~= 0
	for k acc:
		m := &ms[k]; cpc += m.count; ci ~= -1
		for j cl.len: if dot(cl[j].mn, m.n) > 0.996 && dot(cl[j].tn, m.tn) > 0.996 { ci = j; break }
		if ci != -1 { mem.push(ci); cl[ci].cap += m.count } else { mem.push(cl.len); cl.push(Clu{m.n, m.tn, [], m.count}) }
	if cpc == 0: return false
