namespace phx
use std
use vec
use binary
use dictionary
struct Quat { x f32, y f32, z f32, w f32 }
struct Transform { p float3, q Quat }
struct Mat3 { cx float3, cy float3, cz float3 }
struct AABB { lower float3, upper float3 }
struct Plane { normal float3, offset f32 }
struct MassData { mass f32, center float3, inertia Mat3 }
struct Sphere { center float3, radius f32 }
struct Capsule { center1 float3, center2 float3, radius f32 }
PI f32 := 3.14159265359
FLT_MIN f32 := 1.17549435e-38
FLT_EPS f32 := 1.1920929e-7
FLT_MAX f32 := 3.40282347e+38
V0 := float3{0.0, 0.0, 0.0}
QI := Quat{0.0, 0.0, 0.0, 1.0}
XI := Transform{float3{0.0, 0.0, 0.0}, Quat{0.0, 0.0, 0.0, 1.0}}
M0 := Mat3{float3{0.0, 0.0, 0.0}, float3{0.0, 0.0, 0.0}, float3{0.0, 0.0, 0.0}}
M1 := Mat3{float3{1.0, 0.0, 0.0}, float3{0.0, 1.0, 0.0}, float3{0.0, 0.0, 1.0}}
EMPTY_BOX := AABB{float3{3.40282347e+38, 3.40282347e+38, 3.40282347e+38}, float3{-3.40282347e+38, -3.40282347e+38, -3.40282347e+38}}
var LUPM f32 = 1.0
huge() f32: 100000.0 * LUPM
slop() f32: 0.005 * LUPM
spec_dist() f32: 4.0 * slop()
aabb_margin() f32: 0.05 * LUPM
fmin(a f32, b f32) f32: if a < b { a } else { b }
fmax(a f32, b f32) f32: if a > b { a } else { b }
fabs(a f32) f32: if a < 0.0 { -a } else { a }
fclamp(a f32, lo f32, hi f32) f32: if a < lo { lo } else if hi < a { hi } else { a }
iclamp(a int, lo int, hi int) int: if a < lo { lo } else if hi < a { hi } else { a }
flerp(a f32, b f32, t f32) f32: (1.0 - t) * a + t * b
fsqrt(x f32) f32: sqrt(x)
fvalid(a f32) bool: a == a && a - a == 0.0
vvalid(a float3) bool: fvalid(a.x) && fvalid(a.y) && fvalid(a.z)
qv(q Quat) float3: float3{q.x, q.y, q.z}
mkq(v float3, s f32) Quat: Quat{v.x, v.y, v.z, s}
vlen(v float3) f32: sqrt(dot(v, v))
vlen2(v float3) f32: v.x * v.x + v.y * v.y + v.z * v.z
vdist(a float3, b float3) f32: vlen(b - a)
vdist2(a float3, b float3) f32: vlen2(b - a)
nrm(a float3) float3:
	l2 := a.x * a.x + a.y * a.y + a.z * a.z
	if l2 > 1000.0 * FLT_MIN { s := 1.0 / sqrt(l2); float3{s * a.x, s * a.y, s * a.z} } else { V0 }
len_nrm(l f32&, a float3) float3:
	l2 := a.x * a.x + a.y * a.y + a.z * a.z
	if l2 > 1000.0 * FLT_MIN { l = sqrt(l2); s := 1.0 / l; float3{s * a.x, s * a.y, s * a.z} } else { l = 0.0; V0 }
perp(a float3) float3: nrm(if a.x < -0.5 || 0.5 < a.x { float3{a.y, -a.x, 0.0} } else { float3{0.0, a.z, -a.y} })
is_nrm(a float3) bool: fabs(1.0 - dot(a, a)) < 100.0 * FLT_EPS
madd(a float3, s f32, b float3) float3: float3{a.x + s * b.x, a.y + s * b.y, a.z + s * b.z}
msub(a float3, s f32, b float3) float3: float3{a.x - s * b.x, a.y - s * b.y, a.z - s * b.z}
sv(s f32, a float3) float3: float3{s * a.x, s * a.y, s * a.z}
vlerp(a float3, b float3, t f32) float3: float3{(1.0 - t) * a.x + t * b.x, (1.0 - t) * a.y + t * b.y, (1.0 - t) * a.z + t * b.z}
blend2(s f32, a float3, t f32, b float3) float3: float3{s * a.x + t * b.x, s * a.y + t * b.y, s * a.z + t * b.z}
blend3(s f32, a float3, t f32, b float3, u f32, c float3) float3: float3{s * a.x + t * b.x + u * c.x, s * a.y + t * b.y + u * c.y, s * a.z + t * b.z + u * c.z}
vabs(a float3) float3: float3{fabs(a.x), fabs(a.y), fabs(a.z)}
vsign(a float3) float3: float3{if a.x >= 0.0 { 1.0 } else { -1.0 }, if a.y >= 0.0 { 1.0 } else { -1.0 }, if a.z >= 0.0 { 1.0 } else { -1.0 }}
vmin(a float3, b float3) float3: float3{fmin(a.x, b.x), fmin(a.y, b.y), fmin(a.z, b.z)}
vmax(a float3, b float3) float3: float3{fmax(a.x, b.x), fmax(a.y, b.y), fmax(a.z, b.z)}
vclamp(a float3, lo float3, hi float3) float3: float3{fclamp(a.x, lo.x, hi.x), fclamp(a.y, lo.y, hi.y), fclamp(a.z, lo.z, hi.z)}
safe_scale(a float3) float3: vsign(a) * vmax(vabs(a), float3{0.01, 0.01, 0.01})
vget(v float3, i int) f32: if i == 0 { v.x } else if i == 1 { v.y } else { v.z }
major_axis(v float3) int: if v.x < v.y { if v.y < v.z { 2 } else { 1 } } else { if v.x < v.z { 2 } else { 0 } }
vmin_el(v float3) f32: fmin(v.x, fmin(v.y, v.z))
vmax_el(v float3) f32: fmax(v.x, fmax(v.y, v.z))
triple(a float3, b float3, c float3) f32: d := float3{b.y * c.z - b.z * c.y, b.z * c.x - b.x * c.z, b.x * c.y - b.y * c.x}; a.x * d.x + a.y * d.y + a.z * d.z
mcross(a float3, b float3) float3: float3{a.y * b.z + a.z * b.y, a.z * b.x + a.x * b.z, a.x * b.y + a.y * b.x}
clamp_len(v float3, m f32) float3: l2 := vlen2(v); if l2 <= m * m { v } else { sv(m / sqrt(l2), v) }
arb_perp(v float3) float3: nrm(if v.x < -0.5 || 0.5 < v.x { float3{0.67 * v.y + -0.42 * v.z, -0.67 * v.x, 0.42 * v.x} } else if v.y < -0.5 || 0.5 < v.y { float3{0.67 * v.y, -0.67 * v.x + -0.42 * v.z, 0.42 * v.y} } else { float3{0.67 * v.z, -0.42 * v.z, -0.67 * v.x - -0.42 * v.y} })
qn_ok(q Quat) bool: qq := q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w; 1.0 - 20.0 * FLT_EPS < qq && qq < 1.0 + 20.0 * FLT_EPS
qvalid(q Quat) bool: fvalid(q.x) && fvalid(q.y) && fvalid(q.z) && fvalid(q.w) && qn_ok(q)
xvalid(t Transform) bool: vvalid(t.p) && qvalid(t.q)
rot(q Quat, v float3) float3: u := qv(q); madd(v, 2.0, cross(u, madd(cross(u, v), q.w, v)))
irot(q Quat, v float3) float3: u := qv(q); madd(v, 2.0, cross(u, msub(cross(u, v), q.w, v)))
qdot(a Quat, b Quat) f32: a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
qmul(a Quat, b Quat) Quat: av := qv(a); bv := qv(b); mkq(madd(madd(cross(av, bv), a.w, bv), b.w, av), a.w * b.w - dot(av, bv))
qimul(a Quat, b Quat) Quat: av := qv(a); bv := qv(b); mkq(msub(madd(cross(bv, av), a.w, bv), b.w, av), a.w * b.w + dot(av, bv))
qconj(q Quat) Quat: Quat{-q.x, -q.y, -q.z, q.w}
qneg(q Quat) Quat: Quat{-q.x, -q.y, -q.z, -q.w}
qnrm(q Quat) Quat: l2 := qdot(q, q); if l2 > 1000.0 * FLT_MIN { s := 1.0 / sqrt(l2); Quat{s * q.x, s * q.y, s * q.z, s * q.w} } else { QI }
q_axis_angle(axis float3, r f32) Quat: cs := cos_sin(0.5 * r); Quat{cs.y * axis.x, cs.y * axis.y, cs.y * axis.z, cs.x}
q_get_axis_angle(r f32&, q Quat) float3: l := sqrt(q.x * q.x + q.y * q.y + q.z * q.z); r = 2.0 * atan2f(l, q.w); if l > 0.0 { il := 1.0 / l; float3{il * q.x, il * q.y, il * q.z} } else { V0 }
q_angle(q Quat) f32: 2.0 * atan2f(sqrt(q.x * q.x + q.y * q.y + q.z * q.z), q.w)
twist_angle_q(q Quat) f32: 2.0 * (if q.w < 0.0 { atan2f(-q.z, -q.w) } else { atan2f(q.z, q.w) })
swing_angle_q(q Quat) f32: 2.0 * atan2f(sqrt(q.x * q.x + q.y * q.y), sqrt(q.z * q.z + q.w * q.w))
qnlerp(a0 Quat, b Quat, t f32) Quat: a := if qdot(a0, b) < 0.0 { qneg(a0) } else { a0 }; v := vlerp(qv(a), qv(b), t); qnrm(mkq(v, (1.0 - t) * a.w + t * b.w))
xmul(a Transform, b Transform) Transform: Transform{rot(a.q, b.p) + a.p, qmul(a.q, b.q)}
ximul(a Transform, b Transform) Transform: Transform{irot(a.q, b.p - a.p), qimul(a.q, b.q)}
xinv(t Transform) Transform: Transform{irot(t.q, -t.p), qconj(t.q)}
xpt(t Transform, v float3) float3: rot(t.q, v) + t.p
xipt(t Transform, v float3) float3: irot(t.q, v - t.p)
det3(m Mat3) f32: dot(m.cx, cross(m.cy, m.cz))
mv(m Mat3, a float3) float3: float3{m.cx.x * a.x + m.cy.x * a.y + m.cz.x * a.z, m.cx.y * a.x + m.cy.y * a.y + m.cz.y * a.z, m.cx.z * a.x + m.cy.z * a.y + m.cz.z * a.z}
mneg(a Mat3) Mat3: Mat3{-a.cx, -a.cy, -a.cz}
madd3(a Mat3, b Mat3) Mat3: Mat3{a.cx + b.cx, a.cy + b.cy, a.cz + b.cz}
msub3(a Mat3, b Mat3) Mat3: Mat3{a.cx - b.cx, a.cy - b.cy, a.cz - b.cz}
sm(s f32, a Mat3) Mat3: Mat3{sv(s, a.cx), sv(s, a.cy), sv(s, a.cz)}
mm(a Mat3, b Mat3) Mat3: Mat3{mv(a, b.cx), mv(a, b.cy), mv(a, b.cz)}
mt(m Mat3) Mat3: Mat3{float3{m.cx.x, m.cy.x, m.cz.x}, float3{m.cx.y, m.cy.y, m.cz.y}, float3{m.cx.z, m.cy.z, m.cz.z}}
minv_t(m Mat3) Mat3: d := det3(m); if fabs(d) > 1000.0 * FLT_MIN { i := 1.0 / d; Mat3{sv(i, cross(m.cy, m.cz)), sv(i, cross(m.cz, m.cx)), sv(i, cross(m.cx, m.cy))} } else { M0 }
minv(m Mat3) Mat3: d := det3(m); if fabs(d) > 1000.0 * FLT_MIN { mt(minv_t(m)) } else { M0 }
solve3(m Mat3, a float3) float3:
	d := det3(m); if fabs(d) <= 1000.0 * FLT_MIN: return V0
	i := 1.0 / d; float3{i * dot(cross(m.cy, m.cz), a), i * dot(cross(m.cz, m.cx), a), i * dot(cross(m.cx, m.cy), a)}
mabs(m Mat3) Mat3: Mat3{vabs(m.cx), vabs(m.cy), vabs(m.cz)}
qmat(q Quat) Mat3:
	xx := q.x * q.x; yy := q.y * q.y; zz := q.z * q.z; xy := q.x * q.y; xz := q.x * q.z; xw := q.x * q.w; yz := q.y * q.z; yw := q.y * q.w; zw := q.z * q.w
	Mat3{float3{1.0 - 2.0 * (yy + zz), 2.0 * (xy + zw), 2.0 * (xz - yw)}, float3{2.0 * (xy - zw), 1.0 - 2.0 * (xx + zz), 2.0 * (yz + xw)}, float3{2.0 * (xz + yw), 2.0 * (yz - xw), 1.0 - 2.0 * (xx + yy)}}
diag(a f32, b f32, c f32) Mat3: Mat3{float3{a, 0.0, 0.0}, float3{0.0, b, 0.0}, float3{0.0, 0.0, c}}
skew(v float3) Mat3: Mat3{float3{0.0, v.z, -v.y}, float3{-v.z, 0.0, v.x}, float3{v.y, -v.x, 0.0}}
steiner(m f32, o float3) Mat3:
	ixy := -m * o.x * o.y; ixz := -m * o.x * o.z; iyz := -m * o.y * o.z
	Mat3{float3{m * (o.y * o.y + o.z * o.z), ixy, ixz}, float3{ixy, m * (o.x * o.x + o.z * o.z), iyz}, float3{ixz, iyz, m * (o.x * o.x + o.y * o.y)}}
rot_inertia(q Quat, c Mat3) Mat3: r := qmat(q); mm(r, mm(c, mt(r)))
xform_inertia(t Transform, c Mat3, m f32) Mat3: madd3(rot_inertia(t.q, c), steiner(m, t.p))
sphere_inertia(m f32, r f32) Mat3: i := 0.4 * m * r * r; diag(i, i, i)
cyl_inertia(m f32, r f32, h f32) Mat3: ixx := m * (3.0 * r * r + h * h) / 12.0; diag(ixx, 0.5 * m * r * r, ixx)
box_inertia(m f32, lo float3, hi float3) Mat3: d := hi - lo; diag(m * (d.y * d.y + d.z * d.z) / 12.0, m * (d.x * d.x + d.z * d.z) / 12.0, m * (d.x * d.x + d.y * d.y) / 12.0)
mk_aabb(p const float3[:], r f32) AABB:
	a ~= AABB{p[0], p[0]}
	for i 1..p.len: a.lower = vmin(a.lower, p[i]); a.upper = vmax(a.upper, p[i])
	rr := float3{r, r, r}; AABB{a.lower - rr, a.upper + rr}
box_contains(a AABB, b AABB) bool: !(a.lower.x > b.lower.x || b.upper.x > a.upper.x || a.lower.y > b.lower.y || b.upper.y > a.upper.y || a.lower.z > b.lower.z || b.upper.z > a.upper.z)
box_area(a AABB) f32: d := a.upper - a.lower; 2.0 * (d.x * d.y + d.y * d.z + d.z * d.x)
box_center(a AABB) float3: sv(0.5, a.upper + a.lower)
box_ext(a AABB) float3: sv(0.5, a.upper - a.lower)
box_union(a AABB, b AABB) AABB: AABB{vmin(a.lower, b.lower), vmax(a.upper, b.upper)}
box_inflate(a AABB, e f32) AABB: r := float3{e, e, e}; AABB{a.lower - r, a.upper + r}
box_add(a AABB, p float3) AABB: AABB{vmin(a.lower, p), vmax(a.upper, p)}
box_overlap(a AABB, b AABB) bool: !(a.upper.x < b.lower.x || a.lower.x > b.upper.x || a.upper.y < b.lower.y || a.lower.y > b.upper.y || a.upper.z < b.lower.z || a.lower.z > b.upper.z)
box_xform(t Transform, a AABB) AABB: c := xpt(t, box_center(a)); e := mv(mabs(qmat(t.q)), box_ext(a)); AABB{c - e, c + e}
box_valid(a AABB) bool: vvalid(a.lower) && vvalid(a.upper) && a.lower.x <= a.upper.x && a.lower.y <= a.upper.y && a.lower.z <= a.upper.z
box_bounded(a AABB) bool: h := huge(); !(a.lower.x < -h || a.lower.y < -h || a.lower.z < -h || a.upper.x > h || a.upper.y > h || a.upper.z > h)
box_sane(a AABB) bool: box_valid(a) && box_bounded(a)
plane_valid(p Plane) bool: vvalid(p.normal) && is_nrm(p.normal) && fvalid(p.offset)
plane_nrm(p Plane) Plane: il := 1.0 / vlen(p.normal); Plane{sv(il, p.normal), il * p.offset}
plane_np(n float3, p float3) Plane: Plane{n, dot(n, p)}
plane_pts(a float3, b float3, c float3) Plane: n := nrm(cross(b - a, c - a)); Plane{n, dot(n, a)}
normal_pts(a float3, b float3, c float3) float3: nrm(cross(b - a, c - a))
plane_xform(t Transform, p Plane) Plane: n := rot(t.q, p.normal); Plane{n, p.offset + dot(n, t.p)}
plane_sep(p Plane, v float3) f32: dot(p.normal, v) - p.offset
signed_vol(a float3, b float3, c float3, p float3) f32: dot(cross(b - a, c - a), p - a)
atan2f(y f32, x f32) f32:
	if x == 0.0 && y == 0.0: return 0.0
	ax := fabs(x); ay := fabs(y); a := fmin(ay, ax) / fmax(ay, ax); s := a * a; c := s * a; q := s * s
	r ~= 0.024840285 * q + 0.18681418; t := -0.094097948 * q - 0.33213072; r = r * s + t; r = r * c + a
	if ay > ax: r = 1.57079637 - r
	if x < 0.0: r = 3.14159274 - r
	if y < 0.0 { -r } else { r }
remf(x f32, y f32) f32:
	xd := x as f64; yd := y as f64; q := xd / yd
	if !(q - q == 0.0): return (x - x) / (x - x)
	t := q as int; f := t as f64; fr := q - f; n ~= f
	if fr > 0.5 { n = f + 1.0 } else if fr < -0.5 { n = f - 1.0 }
	sg := if yd < 0.0 { -1.0 } else { 1.0 }; h := 0.5 * yd * sg; r ~= xd - n * yd
	if r > h { n += sg; r = xd - n * yd } else if r < -h { n -= sg; r = xd - n * yd }
	if (r == h || r == -h) && (n as int) % 2 != 0: n += if r > 0.0 { sg } else { -sg }; r = xd - n * yd
	if r == 0.0 { x * 0.0 } else { r as f32 }
cos_sin(rad f32) float2:
	x := remf(rad, 2.0 * PI); p2 := PI * PI
	c := if x < -0.5 * PI { y := x + PI; y2 := y * y; -(p2 - 4.0 * y2) / (p2 + y2) } else if x > 0.5 * PI { y := x - PI; y2 := y * y; -(p2 - 4.0 * y2) / (p2 + y2) } else { y2 := x * x; (p2 - 4.0 * y2) / (p2 + y2) }
	s := if x < 0.0 { y := x + PI; -16.0 * y * (PI - y) / (5.0 * p2 - 4.0 * y * (PI - y)) } else { 16.0 * x * (PI - x) / (5.0 * p2 - 4.0 * x * (PI - x)) }
	m := sqrt(s * s + c * c); im := if m > 0.0 { 1.0 / m } else { 0.0 }; float2{c * im, s * im}
q_from_mat(m Mat3) Quat:
	c1 := m.cx; c2 := m.cy; c3 := m.cz; tr := m.cx.x + m.cy.y + m.cz.z
	qnrm(if tr >= 0.0 { Quat{c2.z - c3.y, c3.x - c1.z, c1.y - c2.x, tr + 1.0} } else if c1.x > c2.y && c1.x > c3.z { Quat{c1.x - c2.y - c3.z + 1.0, c2.x + c1.y, c3.x + c1.z, c2.z - c3.y} } else if c2.y > c3.z { Quat{c1.y + c2.x, c2.y - c3.z - c1.x + 1.0, c3.y + c2.z, c3.x - c1.z} } else { Quat{c1.z + c3.x, c2.z + c3.y, c3.z - c1.x - c2.y + 1.0, c1.y - c2.x} })
q_between(v1 float3, v2 float3) Quat:
	m := vlerp(v1, v2, 0.5); tol := 100.0 * FLT_EPS
	if vlen2(m) > tol * tol: return qnrm(mkq(cross(v1, m), dot(v1, m)))
	qnrm(if fabs(v1.x) > 0.5 { Quat{v1.y, -v1.x, 0.0, 0.0} } else { Quat{0.0, v1.z, -v1.y, 0.0} })
struct SegDist { p1 float3, f1 f32, p2 float3, f2 f32 }
line_dist(p1 float3, d1 float3, p2 float3, d2 float3) SegDist:
	a11 := dot(d1, d1); a12 := -dot(d1, d2); a21 := dot(d2, d1); a22 := -dot(d2, d2); w := p1 - p2; b1 := -dot(d1, w); b2 := -dot(d2, w); d := a11 * a22 - a12 * a21
	if d * d < 1000.0 * FLT_MIN: s1 := dot(p2 - p1, d1) / dot(d1, d1); return SegDist{madd(p1, s1, d1), s1, madd(p2, 0.0, d2), 0.0}
	s1 := (a22 * b1 - a12 * b2) / d; s2 := (a11 * b2 - a21 * b1) / d; SegDist{madd(p1, s1, d1), s1, madd(p2, s2, d2), s2}
seg_dist(p1 float3, q1 float3, p2 float3, q2 float3) SegDist:
	d1 := q1 - p1; d2 := q2 - p2; r := p1 - p2; a := dot(d1, d1); b := dot(d1, d2); c := dot(d1, r); e := dot(d2, d2); f := dot(d2, r); t := 100.0 * FLT_EPS
	if a < t && e < t: return SegDist{p1, 0.0, p2, 0.0}
	if a < t: s2 := fclamp(f / e, 0.0, 1.0); return SegDist{p1, 0.0, madd(p2, s2, d2), s2}
	if e < t: s1 := fclamp(-c / a, 0.0, 1.0); return SegDist{madd(p1, s1, d1), s1, p2, 0.0}
	dn := a * e - b * b; s1 ~= if dn > 1000.0 * FLT_MIN { fclamp((b * f - c * e) / dn, 0.0, 1.0) } else { 0.0 }; s2 ~= (b * s1 + f) / e
	if s2 < 0.0: s1 = fclamp(-c / a, 0.0, 1.0); s2 = 0.0
	else if s2 > 1.0: s1 = fclamp((b - c) / a, 0.0, 1.0); s2 = 1.0
	SegDist{madd(p1, s1, d1), s1, madd(p2, s2, d2), s2}
within_segs(r SegDist) bool: 0.0 <= r.f1 && r.f1 <= 1.0 && 0.0 <= r.f2 && r.f2 <= 1.0
pt_seg(a float3, b float3, q float3) float3:
	ab := b - a; al := dot(ab, q - a)
	if al <= 0.0: return a
	d := dot(ab, ab); if al > d { b } else { madd(a, al / d, ab) }
F_NONE := 0; F_TRI := 1; F_HULL := 2; F_E1 := 3; F_E2 := 4; F_E3 := 5; F_V1 := 6; F_V2 := 7; F_V3 := 8
struct TriPt { p float3, f int }
tri_closest(a float3, b float3, c float3, q float3) TriPt:
	ab := b - a; ac := c - a; aq := q - a; d1 := dot(ab, aq); d2 := dot(ac, aq)
	if d1 <= 0.0 && d2 <= 0.0: return TriPt{a, F_V1}
	bq := q - b; d3 := dot(ab, bq); d4 := dot(ac, bq)
	if d3 > 0.0 && d4 <= d3: return TriPt{b, F_V2}
	vc := d1 * d4 - d3 * d2
	if vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0: return TriPt{madd(a, d1 / (d1 - d3), ab), F_E1}
	cq := q - c; d5 := dot(ab, cq); d6 := dot(ac, cq)
	if d6 >= 0.0 && d5 <= d6: return TriPt{c, F_V3}
	vb := d5 * d2 - d1 * d6
	if vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0: return TriPt{madd(a, d2 / (d2 - d6), ac), F_E3}
	va := d3 * d6 - d5 * d4
	if va <= 0.0 && d4 >= d3 && d5 >= d6: return TriPt{madd(b, (d4 - d3) / ((d4 - d3) + (d5 - d6)), c - b), F_E2}
	t1 := vb / (va + vb + vc); t2 := vc / (va + vb + vc); TriPt{madd(madd(a, t1, ab), t2, ac), F_TRI}
q_expmap(v float3) Quat:
	ang := vlen(v)
	if ang < 0.018581361: return mkq(sv(0.5 + ang * ang / 48.0, v), cos_sin(0.5 * ang).x)
	q_axis_angle(sv(1.0 / ang, v), ang)
integrate_rot(q1 Quat, dr float3) Quat: qd := qmul(mkq(sv(0.5, dr), 0.0), q1); qnrm(mkq(qv(q1) + qv(qd), qd.w + q1.w))
delta_quat_rot(q Quat, tg Quat) float3: s := if qdot(q, tg) < 0.0 { qneg(q) } else { q }; p := qmul(Quat{tg.x - s.x, tg.y - s.y, tg.z - s.z, tg.w - s.w}, qconj(s)); sv(2.0, qv(p))
dot2(a float2, b float2) f32: a.x * b.x + a.y * b.y
cross2(a float2, b float2) f32: a.x * b.y - a.y * b.x
struct M2 { cx float2, cy float2 }
mv2(m M2, a float2) float2: float2{m.cx.x * a.x + m.cy.x * a.y, m.cx.y * a.x + m.cy.y * a.y}
det2(m M2) f32: m.cx.x * m.cy.y - m.cx.y * m.cy.x
inv2(m M2) M2: d := det2(m); if fabs(d) > 1000.0 * FLT_MIN { i := 1.0 / d; M2{float2{i * m.cy.y, -i * m.cx.y}, float2{-i * m.cy.x, i * m.cx.x}} } else { M2{float2{0.0, 0.0}, float2{0.0, 0.0}} }
solve2(m M2, b float2) float2: d := det2(m); if d > 1000.0 * FLT_MIN { i := 1.0 / d; float2{i * m.cy.y * b.x - i * m.cy.x * b.y, -i * m.cx.y * b.x + i * m.cx.x * b.y} } else { float2{0.0, 0.0} }
struct Proxy { pts const float3[:], r f32 }
struct SCache { metric f32, count int, ia int[4], ib int[4] }
struct SV { wa float3, wb float3, w float3, a f32, ia int, ib int }
struct Simplex { v SV[4], count int }
struct DistOut { pa float3, pb float3, n float3, d f32, iters int, scount int }
struct CastOut { n float3, p float3, frac f32, iters int, tri int, child int, mat int, hit bool }
struct Sweep { lc float3, c1 float3, c2 float3, q1 Quat, q2 Quat }
struct TOIOut { state int, p float3, n float3, frac f32, d f32, diters int, piters int, riters int, fallback bool }
NOCAST := CastOut{V0, V0, 0.0, 0, 0, 0, 0, false}
pt_support(p const float3[:], ax float3) int:
	o := p[0]; mi ~= 0; mp ~= 0.0 as f32
	for i 1..p.len: pr := dot(ax, p[i] - o); if pr > mp { mi = i; mp = pr }
	mi
bc_edge(a float3, b float3) float3: ab := b - a; float3{dot(b, ab), -dot(a, ab), dot(ab, ab)}
bc_tri(a float3, b float3, c float3) float4: n := cross(b - a, c - a); float4{dot(cross(b, c), n), dot(cross(c, a), n), dot(cross(a, b), n), dot(n, n)}
bc_tet(a float3, b float3, c float3, d float3) float4, f32:
	dv := triple(b - a, c - a, d - a); s := if dv < 0.0 { -1.0 } else { 1.0 }
	return float4{s * triple(b, c, d), s * triple(a, d, c), s * triple(a, b, d), s * triple(a, c, b)}, s * dv
smetric(s Simplex&) f32:
	n := s.count; let v .= s.v
	if n == 2 { vdist(v[0].w, v[1].w) } else if n == 3 { vlen(cross(v[1].w - v[0].w, v[2].w - v[0].w)) / 2.0 } else if n == 4 { triple(v[1].w - v[0].w, v[2].w - v[0].w, v[3].w - v[0].w) / 6.0 } else { 0.0 }
s_one(s Simplex&, x SV) bool: s.count = 1; s.v[0] = x; s.v[0].a = 1.0; true
s_two(s Simplex&, x SV, y SV, w float3) bool:
	s.count = 2; s.v[0] = x; s.v[1] = y
	if w.z <= 0.0: return false
	s.v[0].a = w.x / w.z; s.v[1].a = w.y / w.z; true
s_three(s Simplex&, x SV, y SV, z SV, w float4) bool:
	s.count = 3; s.v[0] = x; s.v[1] = y; s.v[2] = z
	if w.w <= 0.0: return false
	s.v[0].a = w.x / w.w; s.v[1].a = w.y / w.w; s.v[2].a = w.z / w.w; true
sx2(s Simplex&) bool:
	a := s.v[0].w; b := s.v[1].w; ab := b - a; dv := dot(ab, ab); u := dot(b, ab); v := -dot(a, ab)
	if v <= 0.0: s.count = 1; s.v[0].a = 1.0; return true
	if u <= 0.0: return s_one(s, s.v[1])
	if dv <= 0.0: return false
	dn := 1.0 / dv; s.v[0].a = dn * u; s.v[1].a = dn * v; true
sx3(s Simplex&) bool:
	v1 := s.v[0]; v2 := s.v[1]; v3 := s.v[2]; ab := bc_edge(v1.w, v2.w); bc := bc_edge(v2.w, v3.w); ca := bc_edge(v3.w, v1.w)
	if ab.y <= 0.0 && ca.x <= 0.0: return s_one(s, v1)
	if bc.y <= 0.0 && ab.x <= 0.0: return s_one(s, v2)
	if ca.y <= 0.0 && bc.x <= 0.0: return s_one(s, v3)
	t := bc_tri(v1.w, v2.w, v3.w)
	if t.z <= 0.0 && ab.x > 0.0 && ab.y > 0.0: return s_two(s, v1, v2, ab)
	if t.x <= 0.0 && bc.x > 0.0 && bc.y > 0.0: return s_two(s, v2, v3, bc)
	if t.y <= 0.0 && ca.x > 0.0 && ca.y > 0.0: return s_two(s, v3, v1, ca)
	if t.w <= 0.0: return false
	s.v[0].a = t.x / t.w; s.v[1].a = t.y / t.w; s.v[2].a = t.z / t.w; true
sx4(s Simplex&) bool:
	va := s.v[0]; vb := s.v[1]; vc := s.v[2]; vd := s.v[3]
	ab := bc_edge(va.w, vb.w); ac := bc_edge(va.w, vc.w); ad := bc_edge(va.w, vd.w); bc := bc_edge(vb.w, vc.w); cd := bc_edge(vc.w, vd.w); db := bc_edge(vd.w, vb.w)
	if ab.y <= 0.0 && ac.y <= 0.0 && ad.y <= 0.0: return s_one(s, va)
	if ab.x <= 0.0 && db.x <= 0.0 && bc.y <= 0.0: return s_one(s, vb)
	if ac.x <= 0.0 && bc.x <= 0.0 && cd.y <= 0.0: return s_one(s, vc)
	if ad.x <= 0.0 && cd.x <= 0.0 && db.y <= 0.0: return s_one(s, vd)
	acb := bc_tri(va.w, vc.w, vb.w); abd := bc_tri(va.w, vb.w, vd.w); adc := bc_tri(va.w, vd.w, vc.w); bcd := bc_tri(vb.w, vc.w, vd.w)
	if abd.z <= 0.0 && acb.y <= 0.0 && ab.x > 0.0 && ab.y > 0.0: return s_two(s, va, vb, ab)
	if acb.z <= 0.0 && adc.y <= 0.0 && ac.x > 0.0 && ac.y > 0.0: return s_two(s, va, vc, ac)
	if adc.z <= 0.0 && abd.y <= 0.0 && ad.x > 0.0 && ad.y > 0.0: return s_two(s, va, vd, ad)
	if acb.x <= 0.0 && bcd.z <= 0.0 && bc.x > 0.0 && bc.y > 0.0: return s_two(s, vb, vc, bc)
	if adc.x <= 0.0 && bcd.x <= 0.0 && cd.x > 0.0 && cd.y > 0.0: return s_two(s, vc, vd, cd)
	if abd.x <= 0.0 && bcd.y <= 0.0 && db.x > 0.0 && db.y > 0.0: return s_two(s, vd, vb, db)
	w, dv := bc_tet(va.w, vb.w, vc.w, vd.w)
	if w.w < 0.0 && acb.x > 0.0 && acb.y > 0.0 && acb.z > 0.0: return s_three(s, va, vc, vb, acb)
	if w.z < 0.0 && abd.x > 0.0 && abd.y > 0.0 && abd.z > 0.0: return s_three(s, va, vb, vd, abd)
	if w.y < 0.0 && adc.x > 0.0 && adc.y > 0.0 && adc.z > 0.0: return s_three(s, va, vd, vc, adc)
	if w.x < 0.0 && bcd.x > 0.0 && bcd.y > 0.0 && bcd.z > 0.0: return s_three(s, vb, vc, vd, bcd)
	if dv <= 0.0: return false
	s.v[0].a = w.x / dv; s.v[1].a = w.y / dv; s.v[2].a = w.z / dv; s.v[3].a = w.w / dv; true
witness(s Simplex&, pa float3&, pb float3&):
	let v .= s.v
	if s.count == 1: pa = v[0].wa; pb = v[0].wb
	else if s.count == 2: pa = blend2(v[0].a, v[0].wa, v[1].a, v[1].wa); pb = blend2(v[0].a, v[0].wb, v[1].a, v[1].wb)
	else if s.count == 3: pa = blend3(v[0].a, v[0].wa, v[1].a, v[1].wa, v[2].a, v[2].wa); pb = blend3(v[0].a, v[0].wb, v[1].a, v[1].wb, v[2].a, v[2].wb)
	else if s.count == 4: sm := blend2(v[0].a, v[0].wa, v[1].a, v[1].wa) + blend2(v[2].a, v[2].wa, v[3].a, v[3].wa); pa = sm; pb = sm
mk_sv(wa float3, wb float3, ia int, ib int) SV: SV{wa, wb, wb - wa, 0.0, ia, ib}
shape_distance(pxa Proxy, pxb Proxy, xf Transform, radii bool, c SCache&) DistOut:
	m := qmat(xf.q); mtr := mt(m); s ~= Simplex{..}; s.count = c.count
	for i c.count: s.v[i] = mk_sv(pxa.pts[c.ia[i]], mv(m, pxb.pts[c.ib[i]]) + xf.p, c.ia[i], c.ib[i])
	if s.count > 0: m1 := c.metric; m2 := smetric(s); if 2.0 * m1 < m2 || m2 < 0.5 * m1 || m2 < FLT_EPS { s.count = 0 }
	if s.count == 0: s.count = 1; s.v[0] = mk_sv(pxa.pts[0], mv(m, pxb.pts[0]) + xf.p, 0, 0)
	bk ~= Simplex{..}; o ~= DistOut{..}; d2 ~= FLT_MAX; n ~= V0; it ~= 0
	while it < 32:
		ok := if s.count == 1 { s.v[0].a = 1.0; true } else if s.count == 2 { sx2(s) } else if s.count == 3 { sx3(s) } else if s.count == 4 { sx4(s) } else { false }
		if !ok: s = bk; break
		if s.count == 4: pa ~= V0; pb ~= V0; witness(s, pa, pb); return DistOut{pa, pb, V0, 0.0, it, 0}
		od := d2; let v .= s.v
		cp := if s.count == 1 { v[0].w } else if s.count == 2 { blend2(v[0].a, v[0].w, v[1].a, v[1].w) } else if s.count == 3 { blend3(v[0].a, v[0].w, v[1].a, v[1].w, v[2].a, v[2].w) } else { blend2(v[0].a, v[0].w, v[1].a, v[1].w) + blend2(v[2].a, v[2].w, v[3].a, v[3].w) }
		d2 = dot(cp, cp)
		if d2 >= od: s = bk; break
		sd := if s.count == 1 { -v[0].w } else if s.count == 2 { ab := v[1].w - v[0].w; cross(cross(ab, -v[0].w), ab) } else if s.count == 3 { nn := cross(v[1].w - v[0].w, v[2].w - v[0].w); if dot(nn, v[0].w) < 0.0 { nn } else { -nn } } else { V0 }
		if vlen2(sd) < 1000.0 * FLT_MIN: pa ~= V0; pb ~= V0; witness(s, pa, pb); return DistOut{pa, pb, V0, 0.0, it, 0}
		n = -sd; ia := pt_support(pxa.pts, -sd); sa := pxa.pts[ia]; ib := pt_support(pxb.pts, mv(mtr, sd)); sb := mv(m, pxb.pts[ib]) + xf.p
		bk = s; dup ~= false
		for i s.count: dup = dup || v[i].ia == ia && v[i].ib == ib
		if dup: break
		v[s.count] = mk_sv(sa, sb, ia, ib); s.count += 1; it += 1
	pa ~= V0; pb ~= V0; witness(s, pa, pb); o.pa = pa; o.pb = pb; o.iters = it; n = nrm(n)
	if !is_nrm(n): return o
	o.d = vdist(pa, pb); o.n = n
	if radii: o.d = fmax(0.0, o.d - pxa.r - pxb.r); o.pa = o.pa + sv(pxa.r, n); o.pb = o.pb - sv(pxb.r, n)
	c.metric = smetric(s); c.count = s.count
	for i s.count: c.ia[i] = s.v[i].ia; c.ib[i] = s.v[i].ib
	o
shape_cast_pair(pxa Proxy, pxb Proxy, xf Transform, tb float3, maxf f32, enc bool) CastOut:
	sl := slop(); tg ~= fmax(sl, pxa.r + pxb.r - sl); tol := 0.25 * sl; c ~= SCache{..}; al ~= 0.0 as f32; x ~= xf; o ~= NOCAST; o.tri = -1
	for it 20:
		o.iters += 1; d := shape_distance(pxa, pxb, x, false, c)
		if d.d < tg + tol:
			if it == 0:
				if enc && d.d > 2.0 * sl: tg = d.d - sl
				else: o.hit = true; o.p = vlerp(madd(d.pa, pxa.r, d.n), madd(d.pb, -pxb.r, d.n), 0.5); return o
			else:
				if d.d > 0.0 && !is_nrm(d.n): return o
				o.frac = al; o.p = madd(d.pa, pxa.r, d.n); o.n = d.n; o.hit = true; return o
		dn := dot(tb, d.n)
		if dn >= 0.0: return o
		al += (tg - d.d) / dn
		if al >= maxf: return o
		x.p = madd(xf.p, al, tb)
	o
sweep_xf(s Sweep, t f32) Transform: q := qnlerp(s.q1, s.q2, t); Transform{vlerp(s.c1, s.c2, t) - rot(q, s.lc), q}
sweep_final(s Sweep) Transform: Transform{s.c2 - rot(s.q2, s.lc), s.q2}
uniq(n int, v int[4]) int: if n == 1 { 1 } else if n == 2 { if v[0] != v[1] { 2 } else { 1 } } else if n == 3 { if v[0] != v[1] && v[0] != v[2] && v[1] != v[2] { 3 } else if v[0] == v[1] && v[0] == v[2] { 1 } else { 2 } } else { 0 }
fast_edges(xa Transform, ea float3, xb Transform, eb float3, a0 float3) bool: dot(cross(rot(xa.q, ea), rot(xb.q, eb)), a0) < 0.0
SEP_V := 1; SEP_E := 2; SEP_FA := 3; SEP_FB := 4
struct SepFn { pa Proxy, pb Proxy, sa Sweep, sb Sweep, w1 float3, w2 float3, ty int }
sep_edges(f SepFn&, va1 float3, ea0 float3, vb1 float3, eb0 float3, qa Quat, qb Quat, dp float3, tol2 f32, wn float3):
	ea := nrm(ea0); eb ~= nrm(eb0); ax ~= cross(rot(qa, ea), rot(qb, eb))
	if vlen2(ax) < tol2: f.ty = SEP_V; f.w1 = wn; return
	if dot(rot(qb, vb1) - rot(qa, va1) + dp, ax) < 0.0: ax = -ax; eb = -eb
	if fast_edges(sweep_final(f.sa), ea, sweep_final(f.sb), eb, ax): f.ty = SEP_V; f.w1 = nrm(ax)
	else: f.ty = SEP_E; f.w1 = ea; f.w2 = eb
mk_sep(c SCache, pa Proxy, sa Sweep, pb Proxy, sb Sweep, wn float3, t1 f32) SepFn:
	f ~= SepFn{pa, pb, sa, sb, V0, V0, 0}; ia ~= c.ia; ib ~= c.ib; ua := uniq(c.count, ia); ub := uniq(c.count, ib)
	xa := sweep_xf(sa, t1); xb := sweep_xf(sb, t1); qa := xa.q; qb := xb.q; dp := xb.p - xa.p
	if c.count == 1: f.ty = SEP_V; f.w1 = wn
	else if c.count == 2:
		if ua == 2 && ub == 2: sep_edges(f, pa.pts[ia[0]], pa.pts[ia[1]] - pa.pts[ia[0]], pb.pts[ib[0]], pb.pts[ib[1]] - pb.pts[ib[0]], qa, qb, dp, 0.05 * 0.05, wn)
		else: f.ty = SEP_V; f.w1 = wn
	else if c.count == 3:
		if ua == 3:
			v1 := pa.pts[ia[0]]; v2 := pa.pts[ia[1]]; v3 := pa.pts[ia[2]]; la ~= nrm(cross(v2 - v1, v3 - v1)); lp := sv(1.0 / 3.0, v1 + v2 + v3)
			if dot(rot(qb, pb.pts[ib[0]]) - rot(qa, lp) + dp, rot(qa, la)) < 0.0: la = -la
			f.ty = SEP_FA; f.w1 = la; f.w2 = lp
		else if ub == 3:
			v1 := pb.pts[ib[0]]; v2 := pb.pts[ib[1]]; v3 := pb.pts[ib[2]]; lb ~= nrm(cross(v2 - v1, v3 - v1)); lp := sv(1.0 / 3.0, v1 + v2 + v3)
			if dot(rot(qa, pa.pts[ia[0]]) - rot(qb, lp) - dp, rot(qb, lb)) < 0.0: lb = -lb
			f.ty = SEP_FB; f.w1 = lb; f.w2 = lp
		else:
			if ia[0] == ia[1]: ia[1] = ia[2]
			if ib[0] == ib[1]: ib[1] = ib[2]
			sep_edges(f, pa.pts[ia[0]], pa.pts[ia[1]] - pa.pts[ia[0]], pb.pts[ib[0]], pb.pts[ib[1]] - pb.pts[ib[0]], qa, qb, dp, 0.005 * 0.005, wn)
	f
min_sep(f SepFn&, ia int&, ib int&, t f32) f32:
	xa := sweep_xf(f.sa, t); xb := sweep_xf(f.sb, t)
	if f.ty == SEP_V || f.ty == SEP_E:
		ax := if f.ty == SEP_V { f.w1 } else { nrm(cross(rot(xa.q, f.w1), rot(xb.q, f.w2))) }
		ia = pt_support(f.pa.pts, irot(xa.q, ax)); ib = pt_support(f.pb.pts, if f.ty == SEP_V { irot(xb.q, -ax) } else { -irot(xb.q, ax) })
		return dot(rot(xb.q, f.pb.pts[ib]) - rot(xa.q, f.pa.pts[ia]) + (xb.p - xa.p), ax)
	if f.ty == SEP_FA:
		n := rot(xa.q, f.w1); ia = -1; ib = pt_support(f.pb.pts, -irot(xb.q, n)); return dot(xpt(xb, f.pb.pts[ib]) - xpt(xa, f.w2), n)
	if f.ty == SEP_FB:
		n := rot(xb.q, f.w1); ia = pt_support(f.pa.pts, -irot(xa.q, n)); ib = -1; return dot(xpt(xa, f.pa.pts[ia]) - xpt(xb, f.w2), n)
	0.0
eval_sep(f SepFn&, i1 int, i2 int, t f32) f32:
	x1 := sweep_xf(f.sa, t); x2 := sweep_xf(f.sb, t)
	if f.ty == SEP_V: return dot(xpt(x2, f.pb.pts[i2]) - xpt(x1, f.pa.pts[i1]), f.w1)
	if f.ty == SEP_E: return dot(xpt(x2, f.pb.pts[i2]) - xpt(x1, f.pa.pts[i1]), nrm(cross(rot(x1.q, f.w1), rot(x2.q, f.w2))))
	if f.ty == SEP_FA: return dot(xpt(x2, f.pb.pts[i2]) - xpt(x1, f.w2), rot(x1.q, f.w1))
	if f.ty == SEP_FB: return dot(xpt(x1, f.pa.pts[i1]) - xpt(x2, f.w2), rot(x2.q, f.w1))
	0.0
toi_fill(o TOIOut&, wpa float3, wpb float3, ra f32, rb f32, wn float3, org float3): o.p = vlerp(madd(wpa, ra, wn), madd(wpb, -rb, wn), 0.5) + org; o.n = wn
TOI_UNK := 0; TOI_FAIL := 1; TOI_OVER := 2; TOI_HIT := 3; TOI_SEP := 4
time_of_impact(pa Proxy, pb Proxy, sa0 Sweep, sb0 Sweep, maxf f32) TOIOut:
	o ~= TOIOut{..}; o.frac = -1.0; sa ~= sa0; sb ~= sb0; org := sa.c1; sa.c1 = V0; sa.c2 = sa.c2 - org; sb.c1 = sb.c1 - org; sb.c2 = sb.c2 - org
	mpb := pa.pts.len + pb.pts.len; sl := slop(); tg := fmax(sl, pa.r + pb.r - sl); tol := 0.25 * sl; t1 ~= 0.0 as f32; di ~= 0; c ~= SCache{..}
	loop:
		xa := sweep_xf(sa, t1); xb := sweep_xf(sb, t1); d := shape_distance(pa, pb, ximul(xa, xb), false, c); o.d = d.d
		wn := rot(xa.q, d.n); wpa := xpt(xa, d.pa); wpb := xpt(xa, d.pb); o.diters += 1; di += 1
		if d.d <= 0.0: o.state = TOI_OVER; o.frac = 0.0; toi_fill(o, wpa, wpb, pa.r, pb.r, wn, org); break
		if d.d <= tg + tol: o.state = TOI_HIT; toi_fill(o, wpa, wpb, pa.r, pb.r, wn, org); o.frac = t1; break
		if di == 25: o.state = TOI_FAIL; o.frac = t1; toi_fill(o, wpa, wpb, pa.r, pb.r, wn, org); break
		f ~= mk_sep(c, pa, sa, pb, sb, wn, t1); done ~= false; t2 ~= maxf; pbi ~= 0
		loop:
			ia ~= 0; ib ~= 0; s2 ~= min_sep(f, ia, ib, t2)
			if s2 - tg > tol: o.state = TOI_SEP; o.frac = maxf; done = true; break
			if s2 >= tg - tol: t1 = t2; break
			s1 ~= eval_sep(f, ia, ib, t1)
			if s1 < tg - tol: o.state = TOI_FAIL; o.frac = t1; done = true; break
			if s1 <= tg + tol: o.state = TOI_HIT; o.frac = t1; done = true; break
			rc ~= 0; a1 ~= t1; a2 ~= t2
			loop:
				t := if rc & 1 != 0 { a1 + (tg - s1) * (a2 - a1) / (s2 - s1) } else { 0.5 * (a1 + a2) }
				o.riters += 1; rc += 1; s := eval_sep(f, ia, ib, t)
				if fabs(s - tg) <= tol: t2 = t; break
				if s > tg { a1 = t; s1 = s } else { a2 = t; s2 = s }
				if rc == 50: break
			if rc == 49 && f.ty == SEP_E: rc = 0; t2 = maxf; x1 := sweep_xf(f.sa, t1); x2 := sweep_xf(f.sb, t1); f.ty = SEP_V; f.w1 = nrm(cross(rot(x1.q, f.w1), rot(x2.q, f.w2))); f.w2 = V0
			o.piters += 1; pbi += 1
			if pbi == mpb: break
		if done: toi_fill(o, wpa, wpb, pa.r, pb.r, wn, org); break
	o
ray_box(a AABB, p1 float3, p2 float3, mnf f32&, mxf f32&) bool:
	d := p2 - p1; rl := vlen(d)
	if rl < FLT_EPS:
		if p1.x >= a.lower.x && p1.x <= a.upper.x && p1.y >= a.lower.y && p1.y <= a.upper.y && p1.z >= a.lower.z && p1.z <= a.upper.z: mnf = 0.0; mxf = 0.0; return true
		return false
	rd := sv(1.0 / rl, d); tmn ~= 0.0 as f32; tmx ~= rl
	for k 3:
		rc := vget(rd, k); rs := vget(p1, k); bmn := vget(a.lower, k); bmx := vget(a.upper, k)
		if fabs(rc) < FLT_EPS:
			if rs < bmn || rs > bmx: return false
		else:
			t1 ~= (bmn - rs) / rc; t2 ~= (bmx - rs) / rc
			if t1 > t2: tt := t1; t1 = t2; t2 = tt
			tmn = fmax(tmn, t1); tmx = fmin(tmx, t2)
			if tmn > tmx: return false
	if tmx < 0.0: return false
	mnf = fclamp(tmn / rl, 0.0, 1.0); mxf = fclamp(tmx / rl, 0.0, 1.0); true
perimeter(a AABB) f32: wx := a.upper.x - a.lower.x; wy := a.upper.y - a.lower.y; wz := a.upper.z - a.lower.z; 2.0 * (wx * wz + wy * wx + wz * wy)
enlarge(a AABB&, b AABB) bool:
	ch ~= false
	if b.lower.x < a.lower.x: a.lower.x = b.lower.x; ch = true
	if b.lower.y < a.lower.y: a.lower.y = b.lower.y; ch = true
	if b.lower.z < a.lower.z: a.lower.z = b.lower.z; ch = true
	if a.upper.x < b.upper.x: a.upper.x = b.upper.x; ch = true
	if a.upper.y < b.upper.y: a.upper.y = b.upper.y; ch = true
	if a.upper.z < b.upper.z: a.upper.z = b.upper.z; ch = true
	ch
boxes_overlap(a AABB, b AABB) bool: !(b.lower.x > a.upper.x || b.lower.y > a.upper.y || b.lower.z > a.upper.z || a.lower.x > b.upper.x || a.lower.y > b.upper.y || a.lower.z > b.upper.z)
far_pt(b AABB, p float3) float3: float3{if p.x - b.lower.x > b.upper.x - p.x { b.lower.x } else { b.upper.x }, if p.y - b.lower.y > b.upper.y - p.y { b.lower.y } else { b.upper.y }, if p.z - b.lower.z > b.upper.z - p.z { b.lower.z } else { b.upper.z }}
struct L { p int = -1, n int = -1, o int = -1 }
struct QV { l int = 0, cf int = -1, pos float3 = V0, fin int = -1, reach bool = false }
struct QE { p int = -1, n int = -1, o int = -1, f int = -1, t int = -1, fin int = -1 }
struct QF { l int = 0, ch int = 0, e int = -1, mark int = 0, area f32 = 0.0, pl Plane = Plane{V0, 0.0}, cen float3 = V0, mcd f32 = 0.0, mc int = -1, fin int = -1, flip bool = false, nf int = -1 }
struct HF { f int, se int, e int, st bool }
struct QB { tol f32 = 0.0, minr f32 = 0.0, mino f32 = 0.0, ip float3 = V0, ln L[>..], vs QV[>..], es QE[>..], efree int = -1, fs QF[>..], ffree int = -1, hz int[>..], cone int[>..], mg int[>..], fv int = 0, fe int = 0, ff int = 0 }
struct HE { n int, t int, o int, f int }
struct HData { pts float3[>..], pl Plane[>..], ve int[>..], eg HE[>..], fe int[>..], aabb AABB = EMPTY_BOX, area f32 = 0.0, vol f32 = 0.0, ir f32 = 0.0, cen float3 = V0, ci Mat3 = M0, hash u64 = 0 }
QOL := 0; QVL := 1; QFL := 2
ql(b QB&, o int) int: b.ln.push(L{-1, -1, o}); b.ln.len - 1
l_init(b QB&, h int): b.ln[h].p = h; b.ln[h].n = h
l_has(b QB&, x int) bool: b.ln[x].p >= 0 && b.ln[x].n >= 0
l_ins(b QB&, x int, w int): p := b.ln[w].p; b.ln[x].p = p; b.ln[x].n = w; b.ln[p].n = x; b.ln[w].p = x
l_rem(b QB&, x int): p := b.ln[x].p; n := b.ln[x].n; b.ln[p].n = n; b.ln[n].p = p; b.ln[x].p = -1; b.ln[x].n = -1
l_push(b QB&, h int, x int): l_ins(b, x, b.ln[h].p)
new_v(b QB&, p float3) int: v := b.vs.len; b.vs.push(QV{ql(b, v), -1, p, -1, false}); v
new_e(b QB&) int:
	e ~= b.efree
	if e >= 0 { b.efree = b.es[e].n } else { e = b.es.len; b.es.push(QE{..}) }
	b.es[e].fin = -1; e
ret_e(b QB&, e int): b.es[e].n = b.efree; b.efree = e
new_f(b QB&, v1 int, v2 int, v3 int) int:
	f ~= b.ffree
	if f >= 0 { b.ffree = b.fs[f].nf } else { f = b.fs.len; b.fs.push(QF{..}); b.fs[f].l = ql(b, f); b.fs[f].ch = ql(b, -1) }
	b.ln[b.fs[f].l].p = -1; b.ln[b.fs[f].l].n = -1; b.fs[f].mc = -1; b.fs[f].mcd = 0.0; b.fs[f].fin = -1
	e1 := new_e(b); e2 := new_e(b); e3 := new_e(b); p1 := b.vs[v1].pos; p2 := b.vs[v2].pos; p3 := b.vs[v3].pos
	ln ~= 0.0 as f32; n := len_nrm(ln, cross(p2 - p1, p3 - p1)); pl := Plane{n, dot(n, p1)}
	b.fs[f].e = e1; b.fs[f].mark = 0; b.fs[f].area = 0.5 * ln; b.fs[f].cen = sv(1.0 / 3.0, p1 + (p2 + p3)); b.fs[f].pl = pl; b.fs[f].flip = plane_sep(pl, b.ip) > 0.0
	l_init(b, b.fs[f].ch); b.es[e1] = QE{e3, e2, v1, f, -1, -1}; b.es[e2] = QE{e1, e3, v2, f, -1, -1}; b.es[e3] = QE{e2, e1, v3, f, -1, -1}; f
ret_f(b QB&, f int):
	if l_has(b, b.fs[f].l): l_rem(b, b.fs[f].l)
	b.fs[f].e = -1; b.fs[f].nf = b.ffree; b.ffree = f
far_axes(tol f32, p const float3[:], i1 int&, i2 int&):
	i1 = -1; i2 = -1; mn ~= [0, 0, 0]; mx ~= [0, 0, 0]
	for i 1..p.len:
		for k 3:
			v := vget(p[i], k)
			if v < vget(p[mn[k]], k) { mn[k] = i } else if v > vget(p[mx[k]], k) { mx[k] = i }
	d := float3{p[mx[0]].x - p[mn[0]].x, p[mx[1]].y - p[mn[1]].y, p[mx[2]].z - p[mn[2]].z}; m := major_axis(d)
	if vget(d, m) > 2.0 * tol: i1 = mn[m]; i2 = mx[m]
far_line(i1 int, i2 int, tol f32, p const float3[:]) int:
	a := p[i1]; ab := p[i2] - a; il := 1.0 / dot(ab, ab); md ~= 4.0 * tol * tol; mi ~= -1
	for i p.len:
		if i != i1 && i != i2: c := cross(p[i] - a, ab); d := dot(c, c) * il; if d > md { md = d; mi = i }
	mi
far_plane(i1 int, i2 int, i3 int, tol f32, p const float3[:]) int:
	pl := plane_pts(p[i1], p[i2], p[i3]); md ~= 2.0 * tol; mi ~= -1
	for i p.len:
		if i != i1 && i != i2 && i != i3: d := fabs(plane_sep(pl, p[i])); if d > md { md = d; mi = i }
	mi
e_sep(b QB&, e int) f32: plane_sep(b.fs[b.es[e].f].pl, b.fs[b.es[b.es[e].t].f].cen)
vcount(b QB&, f int) int:
	c ~= 0; e ~= b.fs[f].e
	loop:
		c += 1; e = b.es[e].n
		if e == b.fs[f].e: break
	c
nth_e(b QB&, f int, i int) int:
	e ~= b.fs[f].e
	for k i: e = b.es[e].n
	e
link_faces(b QB&, f1 int, i1 int, f2 int, i2 int): a := nth_e(b, f1, i1); c := nth_e(b, f2, i2); b.es[a].t = c; b.es[c].t = a
newell(b QB&, f int):
	c ~= 0; cen ~= V0; n ~= V0; e ~= b.fs[f].e; org := b.vs[b.es[e].o].pos
	loop:
		v1 := b.vs[b.es[e].o].pos - org; v2 := b.vs[b.es[b.es[e].t].o].pos - org; c += 1; cen = cen + v1
		n.x += (v1.y - v2.y) * (v1.z + v2.z); n.y += (v1.z - v2.z) * (v1.x + v2.x); n.z += (v1.x - v2.x) * (v1.y + v2.y); e = b.es[e].n
		if e == b.fs[f].e: break
	cen = sv(1.0 / (c as f32), cen) + org; l := vlen(n); n = sv(1.0 / l, n); b.fs[f].cen = cen; b.fs[f].pl = plane_np(n, cen); b.fs[f].area = 0.5 * l
qtol(b QB&, p const float3[:]):
	lo ~= float3{FLT_MAX, FLT_MAX, FLT_MAX}; hi ~= -lo
	for v p: lo = vmin(lo, v); hi = vmax(hi, v)
	ma := vmax(vabs(lo), vabs(hi)); mc := fmax(ma.x, fmax(ma.y, ma.z)); md := fmin(1.732050808 * mc, ma.x + ma.y + ma.z)
	b.tol = (3.0 * md * 1.01 + mc) * FLT_EPS; b.minr = 4.0 * b.tol; b.mino = 2.0 * b.minr
conflict(b QB&, f int, v int, d f32): l_push(b, b.fs[f].ch, b.vs[v].l); b.vs[v].cf = f; if d > b.fs[f].mcd { b.fs[f].mcd = d; b.fs[f].mc = v }
init_hull(b QB&, p const float3[:]) bool:
	i1 ~= -1; i2 ~= -1; far_axes(b.tol, p, i1, i2)
	if i1 < 0 || i2 < 0: return false
	i3 ~= far_line(i1, i2, b.tol, p)
	if i3 < 0: return false
	i4 := far_plane(i1, i2, i3, b.tol, p)
	if i4 < 0: return false
	if triple(p[i1] - p[i4], p[i2] - p[i4], p[i3] - p[i4]) < 0.0: t := i2; i2 = i3; i3 = t
	b.ip = sv(0.25, V0 + p[i1] + p[i2] + p[i3] + p[i4]); v1 := new_v(b, p[i1]); l_push(b, QVL, b.vs[v1].l); v2 := new_v(b, p[i2]); l_push(b, QVL, b.vs[v2].l); v3 := new_v(b, p[i3]); l_push(b, QVL, b.vs[v3].l); v4 := new_v(b, p[i4]); l_push(b, QVL, b.vs[v4].l)
	f1 := new_f(b, v1, v2, v3); l_push(b, QFL, b.fs[f1].l); f2 := new_f(b, v4, v2, v1); l_push(b, QFL, b.fs[f2].l); f3 := new_f(b, v4, v3, v2); l_push(b, QFL, b.fs[f3].l); f4 := new_f(b, v4, v1, v3); l_push(b, QFL, b.fs[f4].l)
	link_faces(b, f1, 0, f2, 1); link_faces(b, f1, 1, f3, 1); link_faces(b, f1, 2, f4, 1); link_faces(b, f2, 0, f3, 2); link_faces(b, f3, 0, f4, 2); link_faces(b, f4, 0, f2, 2)
	for i p.len:
		if i != i1 && i != i2 && i != i3 && i != i4:
			md ~= b.mino; mf ~= -1; x ~= b.ln[QFL].n
			while x != QFL: f := b.ln[x].o; d := plane_sep(b.fs[f].pl, p[i]); if d > md { md = d; mf = f }; x = b.ln[x].n
			if mf >= 0: v := new_v(b, p[i]); conflict(b, mf, v, md)
	true
recache(b QB&, f int):
	mv ~= -1; md ~= b.mino; h := b.fs[f].ch; x ~= b.ln[h].n
	while x != h: v := b.ln[x].o; d := plane_sep(b.fs[f].pl, b.vs[v].pos); if d > md { md = d; mv = v }; x = b.ln[x].n
	b.fs[f].mc = mv; b.fs[f].mcd = md
next_conflict(b QB&) int:
	mv ~= -1; md ~= b.mino; x ~= b.ln[QFL].n
	while x != QFL: f := b.ln[x].o; if b.fs[f].mc >= 0 && b.fs[f].mcd > md { md = b.fs[f].mcd; mv = b.fs[f].mc }; x = b.ln[x].n
	mv
drain(b QB&, f int):
	h := b.fs[f].ch; x ~= b.ln[h].n
	while x != h: v := b.ln[x].o; x = b.ln[x].n; b.vs[v].cf = -1; l_rem(b, b.vs[v].l); l_push(b, QOL, b.vs[v].l)
enter_hz(b QB&, f int, en int) HF: b.fs[f].mark = 1; drain(b, f); if en >= 0 { HF{f, en, b.es[en].n, false} } else { HF{f, b.fs[f].e, b.fs[f].e, false} }
build_hz(b QB&, apex int, seed int):
	st HF[>..] ~= []; st.push(enter_hz(b, seed, -1))
	while st.len > 0:
		t := st.len - 1
		if st[t].st && st[t].e == st[t].se: st.pop(); continue
		st[t].st = true; e := st[t].e; tw := b.es[e].t; st[t].e = b.es[e].n; tf := b.es[tw].f
		if b.fs[tf].mark != 0: continue
		if plane_sep(b.fs[tf].pl, b.vs[apex].pos) > b.minr: st.push(enter_hz(b, tf, tw)); continue
		b.hz.push(e)
build_cone(b QB&, apex int):
	for i b.hz.len: e := b.hz[i]; tw := b.es[e].t; f := new_f(b, apex, b.es[e].o, b.es[tw].o); b.cone.push(f); a := nth_e(b, f, 1); b.es[a].t = tw; b.es[tw].t = a
	f1 ~= b.cone[b.cone.len - 1]
	for i b.cone.len: f2 := b.cone[i]; link_faces(b, f1, 2, f2, 0); f1 = f2
destroy_es(b QB&, beg int, end int):
	e ~= beg
	while e != end: nx := b.es[e].n; ret_e(b, e); e = nx
connect_es(b QB&, pv int, nx int):
	if b.es[b.es[pv].t].f != b.es[b.es[nx].t].f: b.es[pv].n = nx; b.es[nx].p = pv; return
	if b.fs[b.es[nx].f].e == nx: b.fs[b.es[nx].f].e = pv
	tw ~= -1
	if vcount(b, b.es[b.es[pv].t].f) == 3:
		d0 := b.es[pv].t; d1 := b.es[nx].t; d2 := b.es[d1].p; tw = b.es[d2].t; of := b.es[d0].f; b.fs[of].mark = 1; b.mg.push(of)
		b.es[pv].n = b.es[nx].n; b.es[b.es[pv].n].p = pv; b.es[pv].t = tw; b.es[tw].t = pv; l_rem(b, b.vs[b.es[nx].o].l); ret_e(b, d0); ret_e(b, d1); ret_e(b, d2)
	else:
		tw = b.es[nx].t
		if b.fs[b.es[tw].f].e == b.es[pv].t: b.fs[b.es[tw].f].e = tw
		b.es[tw].n = b.es[b.es[pv].t].n; b.es[b.es[tw].n].p = tw; ret_e(b, b.es[pv].t); b.es[pv].n = b.es[nx].n; b.es[b.es[pv].n].p = pv; b.es[pv].t = tw; b.es[tw].t = pv; l_rem(b, b.vs[b.es[nx].o].l)
	newell(b, b.es[tw].f); recache(b, b.es[tw].f)
absorb(b QB&, f int):
	for i b.mg.len:
		m := b.mg[i]; h := b.fs[m].ch; x ~= b.ln[h].n
		while x != h:
			v := b.ln[x].o; x = b.ln[x].n; l_rem(b, b.vs[v].l); d := plane_sep(b.fs[f].pl, b.vs[v].pos)
			if d > b.mino { conflict(b, f, v, d) } else { l_push(b, QOL, b.vs[v].l); b.vs[v].cf = -1 }
		ret_f(b, m)
connect_fs(b QB&, e int):
	f := b.es[e].f; tw := b.es[e].t; tf := b.es[tw].f; ep ~= b.es[e].p; en ~= b.es[e].n; tp ~= b.es[tw].p; tn ~= b.es[tw].n
	while b.es[b.es[ep].t].f == tf: ep = b.es[ep].p; tn = b.es[tn].n
	while b.es[b.es[en].t].f == tf: en = b.es[en].n; tp = b.es[tp].p
	b.fs[f].e = ep; b.mg.clear(); b.mg.push(tf); b.fs[tf].mark = 1; b.fs[tf].e = -1; a ~= tn
	while a != b.es[tp].n: b.es[a].f = f; a = b.es[a].n
	destroy_es(b, b.es[ep].n, en); destroy_es(b, b.es[tp].n, tn); connect_es(b, ep, tn); connect_es(b, tp, en); newell(b, f); recache(b, f); absorb(b, f)
merge_bad(b QB&, f int, cc bool) bool:
	e ~= b.fs[f].e
	loop:
		tw := b.es[e].t
		if if cc { e_sep(b, e) > b.minr || e_sep(b, tw) > b.minr } else { !(e_sep(b, e) < -b.minr) || !(e_sep(b, tw) < -b.minr) }: connect_fs(b, e); return true
		e = b.es[e].n
		if e == b.fs[f].e: break
	false
merge_fs(b QB&):
	for i b.cone.len:
		f := b.cone[i]
		if b.fs[f].mark == 0 && b.fs[f].flip:
			b.fs[f].flip = false; ba ~= 0.0 as f32; be ~= -1; e ~= b.fs[f].e
			loop:
				a := b.fs[b.es[b.es[e].t].f].area
				if a > ba { ba = a; be = e }
				e = b.es[e].n
				if e == b.fs[f].e: break
			connect_fs(b, be)
	for k 2:
		for i b.cone.len:
			f := b.cone[i]
			if b.fs[f].mark == 0:
				loop:
					if !merge_bad(b, f, k == 0): break
resolve_vs(b QB&):
	x ~= b.ln[QOL].n
	while x != QOL:
		v := b.ln[x].o; x = b.ln[x].n; l_rem(b, b.vs[v].l); md ~= b.mino; mf ~= -1
		for i b.cone.len: c := b.cone[i]; if b.fs[c].mark == 0 { d := plane_sep(b.fs[c].pl, b.vs[v].pos); if d > md { md = d; mf = c } }
		if mf >= 0: conflict(b, mf, v, md)
resolve_fs(b QB&):
	x ~= b.ln[QFL].n
	while x != QFL:
		f := b.ln[x].o; x = b.ln[x].n
		if b.fs[f].mark == 1 && l_has(b, b.fs[f].l):
			s := b.fs[f].e; e ~= s
			loop:
				nx := b.es[e].n; ret_e(b, e); e = nx
				if e == s: break
			ret_f(b, f)
	for i b.cone.len: c := b.cone[i]; if b.fs[c].mark != 1 { l_push(b, QFL, b.fs[c].l) }
add_vertex(b QB&, v int):
	f := b.vs[v].cf; b.vs[v].cf = -1; l_rem(b, b.vs[v].l); l_push(b, QVL, b.vs[v].l); b.hz.clear(); build_hz(b, v, f); b.cone.clear(); build_cone(b, v); merge_fs(b); resolve_vs(b); resolve_fs(b)
clean_hull(b QB&, org float3):
	fc ~= 0; hc ~= 0; x ~= b.ln[QFL].n
	while x != QFL:
		f := b.ln[x].o; e ~= b.fs[f].e
		loop:
			b.vs[b.es[e].o].reach = true; e = b.es[e].n; hc += 1
			if e == b.fs[f].e: break
		b.fs[f].pl.offset += dot(b.fs[f].pl.normal, org); b.fs[f].cen = b.fs[f].cen + org; fc += 1; x = b.ln[x].n
	vc ~= 0; x = b.ln[QVL].n
	while x != QVL: v := b.ln[x].o; x = b.ln[x].n; if !b.vs[v].reach { l_rem(b, b.vs[v].l) } else { b.vs[v].pos = b.vs[v].pos + org; vc += 1 }
	b.ip = b.ip + org; b.fv = vc; b.fe = hc; b.ff = fc
hull_bounds(h HData&):
	lo ~= h.pts[0]; hi ~= h.pts[0]
	for i 1..h.pts.len: lo = vmin(lo, h.pts[i]); hi = vmax(hi, h.pts[i])
	h.aabb = AABB{lo, hi}
hull_bulk(h HData&) bool:
	ar ~= 0.0 as f32; vol ~= 0.0 as f32; c ~= V0; o := h.pts[0]; xx ~= 0.0 as f32; xy ~= 0.0 as f32; yy ~= 0.0 as f32; xz ~= 0.0 as f32; zz ~= 0.0 as f32; yz ~= 0.0 as f32
	for fi h.fe.len:
		e1 := h.fe[fi]; e2 ~= h.eg[e1].n; e3 ~= h.eg[e2].n; v1 := h.pts[h.eg[e1].o] - o
		loop:
			v2 := h.pts[h.eg[e2].o] - o; v3 := h.pts[h.eg[e3].o] - o; ar += vlen(cross(v2 - v1, v3 - v1)); d := triple(v1, v2, v3); vol += d; v4 := v1 + (v2 + v3); c = c + sv(d, v4)
			xx += d * (v1.x * v1.x + v2.x * v2.x + v3.x * v3.x + v4.x * v4.x); yy += d * (v1.y * v1.y + v2.y * v2.y + v3.y * v3.y + v4.y * v4.y); zz += d * (v1.z * v1.z + v2.z * v2.z + v3.z * v3.z + v4.z * v4.z)
			xy += d * (v1.x * v1.y + v2.x * v2.y + v3.x * v3.y + v4.x * v4.y); xz += d * (v1.x * v1.z + v2.x * v2.z + v3.x * v3.z + v4.x * v4.z); yz += d * (v1.y * v1.z + v2.y * v2.z + v3.y * v3.z + v4.y * v4.z)
			e2 = e3; e3 = h.eg[e3].n
			if e1 == e3: break
	lc := if vol > 0.0 { sv(0.25 / vol, c) } else { V0 }; cen := lc + o; r ~= FLT_MAX
	for fi h.pl.len: r = fmin(r, -plane_sep(h.pl[fi], cen))
	m := vol / 6.0; h.cen = cen; h.ci = msub3(sm(1.0 / 120.0, Mat3{float3{yy + zz, -xy, -xz}, float3{-xy, xx + zz, -yz}, float3{-xz, -yz, xx + yy}}), steiner(m, lc)); h.vol = m; h.area = 0.5 * ar; h.ir = r
	m > 0.0 && vol > 0.0 && ar > 0.0 && r > 0.0
hmix(h u64, x u64) u64: (h ^ x) * 0x100000001B3
hull_hash(h HData&) u64:
	r ~= 0xCBF29CE484222325 as u64
	for p h.pts: r = hmix(hmix(hmix(r, binary::f32_bits(p.x) as u64), binary::f32_bits(p.y) as u64), binary::f32_bits(p.z) as u64)
	for e h.eg: r = hmix(r, (e.n | (e.t << 8) | (e.o << 16) | (e.f << 24)) as u64)
	for p h.pl: r = hmix(hmix(hmix(hmix(r, binary::f32_bits(p.normal.x) as u64), binary::f32_bits(p.normal.y) as u64), binary::f32_bits(p.normal.z) as u64), binary::f32_bits(p.offset) as u64)
	if r == 0 { 1 } else { r }
hull_eq(a HData&, b HData&) bool:
	if a.pts.len != b.pts.len || a.eg.len != b.eg.len || a.pl.len != b.pl.len || a.hash != b.hash: return false
	for i a.pts.len: if a.pts[i] != b.pts[i] { return false }
	for i a.eg.len: if a.eg[i].n != b.eg[i].n || a.eg[i].t != b.eg[i].t || a.eg[i].o != b.eg[i].o || a.eg[i].f != b.eg[i].f { return false }
	for i a.pl.len: if a.pl[i].normal != b.pl[i].normal || a.pl[i].offset != b.pl[i].offset { return false }
	true
create_hull(p const float3[:], maxv int) HData, bool:
	if p.len < 4: return HData{..}, false
	org := p[0]; b ~= QB{..}; ql(b, -1); ql(b, -1); ql(b, -1); l_init(b, QOL); l_init(b, QVL); l_init(b, QFL); sp float3[>..] ~= []
	for v p: sp.push(v - org)
	qtol(b, sp)
	if !init_hull(b, sp): return HData{..}, false
	bud ~= iclamp(iclamp(maxv, 4, 128) - 4, 0, 252); v ~= next_conflict(b)
	while v >= 0 && bud > 0: add_vertex(b, v); v = next_conflict(b); bud -= 1
	clean_hull(b, org)
	if b.fv - b.fe / 2 + b.ff != 2 || b.ff < 4 || b.fv > 128 || b.ff > 128 || b.fe > 256: return HData{..}, false
	tv int[>..] ~= []; tf int[>..] ~= []; te int[>..] ~= []; x ~= b.ln[QVL].n
	while x != QVL: b.vs[b.ln[x].o].fin = tv.len; tv.push(b.ln[x].o); x = b.ln[x].n
	x = b.ln[QFL].n
	while x != QFL:
		f := b.ln[x].o; b.fs[f].fin = tf.len; tf.push(f); e ~= b.fs[f].e
		loop:
			if b.es[e].fin < 0: b.es[e].fin = te.len; te.push(e); b.es[b.es[e].t].fin = te.len; te.push(b.es[e].t)
			e = b.es[e].n
			if e == b.fs[f].e: break
		x = b.ln[x].n
	h ~= HData{..}
	for v2 tv: h.ve.push(0); h.pts.push(b.vs[v2].pos)
	for i te.len: e := te[i]; h.eg.push(HE{b.es[b.es[e].n].fin, b.es[b.es[e].t].fin, b.vs[b.es[e].o].fin, b.fs[b.es[e].f].fin}); h.ve[b.vs[b.es[e].o].fin] = i
	for f tf: h.fe.push(b.es[b.fs[f].e].fin); h.pl.push(b.fs[f].pl)
	hull_bounds(h)
	if !hull_bulk(h): return HData{..}, false
	h.hash = hull_hash(h); return h, true
ring(n int, r1 f32, r2 f32, y1 f32, y2 f32) float3[>..]:
	p float3[>..] ~= []; a ~= 0.0 as f32; da := 2.0 * PI / (n as f32)
	for i n: cs := cos_sin(a); p.push(float3{r1 * cs.x, y1, r1 * cs.y}); p.push(float3{r2 * cs.x, y2, r2 * cs.y}); a += da
	p
cylinder_hull(h f32, r f32, yo f32, n int) HData, bool: p := ring(n, r, r, yo, yo + h); create_hull(p, p.len)
cone_hull(h f32, r1 f32, r2 f32, n int) HData, bool: p := ring(n, r1, r2, 0.0, h); create_hull(p, p.len)
rock_hull(r f32) HData, bool:
	ph := (1.0 + fsqrt(5.0)) / 2.0; cs ~= float2{1.0, 0.0}; dc := cos_sin(2.0 * PI / ph); p float3[>..] ~= []
	for i 10:
		z := 1.0 - (2.0 * (i as f32) + 1.0) / 10.0; rxy := fsqrt(1.0 - z * z); p.push(float3{r * rxy * cs.x, r * rxy * cs.y, r * z}); c0 := cs
		cs = float2{dc.x * c0.x - dc.y * c0.y, dc.y * c0.x + dc.x * c0.y}
	create_hull(p, 10)
clone_xform_hull(o HData&, xf Transform, sc float3) HData, bool:
	h ~= copy(o); s := safe_scale(sc)
	if s.x * s.y * s.z < 0.0:
		for fi h.fe.len:
			st := h.fe[fi]; ce ~= st; pe ~= -1
			loop:
				if h.eg[ce].n == st: pe = ce; break
				ce = h.eg[ce].n
				if ce == st: break
			ce = st
			loop:
				ni := h.eg[ce].n; h.eg[ce].n = pe
				if ce < h.eg[ce].t: tw := h.eg[ce].t; t := h.eg[ce].o; h.eg[ce].o = h.eg[tw].o; h.eg[tw].o = t
				pe = ce; ce = ni
				if ce == st: break
		for i h.ve.len: h.ve[i] = h.eg[h.ve[i]].t
	m := qmat(xf.q)
	for i h.pts.len: h.pts[i] = mv(m, s * h.pts[i]) + xf.p
	for fi h.fe.len:
		c ~= 0; cen ~= V0; n ~= V0; st := h.fe[fi]; ce ~= st; org := h.pts[h.eg[st].o]
		loop:
			v1 := h.pts[h.eg[ce].o] - org; v2 := h.pts[h.eg[h.eg[ce].t].o] - org; c += 1; cen = cen + v1
			n.x += (v1.y - v2.y) * (v1.z + v2.z); n.y += (v1.z - v2.z) * (v1.x + v2.x); n.z += (v1.x - v2.x) * (v1.y + v2.y); ce = h.eg[ce].n
			if ce == st: break
		cen = sv(1.0 / (c as f32), cen) + org; ar := vlen(n); n = sv(1.0 / ar, n); h.pl[fi] = plane_np(n, cen)
	hull_bounds(h)
	if !hull_bulk(h): return HData{..}, false
	h.hash = hull_hash(h); return h, true
hull_support(h HData&, d float3) int:
	bi ~= -1; bd ~= -FLT_MAX
	for i h.pts.len: x := dot(d, h.pts[i]); if x > bd { bi = i; bd = x }
	bi
hull_support_face(h HData&, d float3) int:
	bi ~= -1; bd ~= -FLT_MAX
	for i h.pl.len: x := dot(h.pl[i].normal, d); if x > bd { bd = x; bi = i }
	bi
hull_mass(h HData&, den f32) MassData: MassData{den * h.vol, h.cen, sm(den, h.ci)}
hull_proxy(h HData&) Proxy: Proxy{h.pts[..], 0.0}
overlap_hull(h HData&, xf Transform, px Proxy) bool: c ~= SCache{..}; shape_distance(hull_proxy(h), px, ximul(xf, XI), true, c).d < 0.1 * slop()
ray_hull(h HData&, org float3, tr float3, maxf f32) CastOut:
	o ~= NOCAST; lo ~= 0.0 as f32; up ~= maxf; bf ~= -1
	for fi h.pl.len:
		pl := h.pl[fi]; d := pl.offset - dot(pl.normal, org); dn := dot(pl.normal, tr)
		if dn == 0.0:
			if d < 0.0: return o
		else:
			fr := d / dn
			if dn < 0.0 { if fr > lo { bf = fi; lo = fr } } else { if fr < up { up = fr } }
			if up < lo: return o
	if bf >= 0: o.p = org + sv(lo, tr); o.n = h.pl[bf].normal; o.frac = lo; o.hit = true
	else: o.p = org; o.hit = true
	o
cast_hull(h HData&, px Proxy, tr float3, maxf f32, enc bool) CastOut: shape_cast_pair(hull_proxy(h), px, XI, tr, maxf, enc)
hull_extent(h HData&, org float3) float4:
	mx ~= V0
	for p h.pts: mx = vmax(mx, vabs(p - org))
	float4{h.ir, mx.x, mx.y, mx.z}
hull_proj_area(h HData&, d float3) f32:
	a ~= 0.0 as f32
	for fi h.fe.len:
		be := h.fe[fi]; p1 := h.pts[h.eg[be].o]; ei ~= h.eg[be].n; p2 ~= h.pts[h.eg[ei].o]; ei = h.eg[ei].n
		loop:
			p3 := h.pts[h.eg[ei].o]; a += fmax(dot(cross(p2 - p1, p3 - p1), d), 0.0); p2 = p3; ei = h.eg[ei].n
			if ei == be: break
	0.5 * a
BOX_EG := [HE{2, 1, 2, 0}, HE{17, 0, 1, 5}, HE{4, 3, 1, 0}, HE{20, 2, 5, 3}, HE{6, 5, 5, 0}, HE{23, 4, 6, 4}, HE{0, 7, 6, 0}, HE{18, 6, 2, 2}, HE{10, 9, 0, 1}, HE{21, 8, 3, 5}, HE{12, 11, 3, 1}, HE{16, 10, 7, 2}, HE{14, 13, 7, 1}, HE{19, 12, 4, 4}, HE{8, 15, 4, 1}, HE{22, 14, 0, 3}, HE{7, 17, 3, 2}, HE{9, 16, 2, 5}, HE{11, 19, 6, 2}, HE{5, 18, 7, 4}, HE{15, 21, 1, 3}, HE{1, 20, 0, 5}, HE{3, 23, 4, 3}, HE{13, 22, 5, 4}]
box_hull(hx f32, hy f32, hz f32, xf Transform) HData:
	mh := 0.2 * slop(); h := vmax(float3{mh, mh, mh}, float3{hx, hy, hz}); d ~= HData{..}
	d.aabb = box_xform(xf, AABB{-h, h}); d.area = 8.0 * (h.x * h.y + h.x * h.z + h.y * h.z); d.vol = 8.0 * h.x * h.y * h.z; d.ir = fmin(h.x, fmin(h.y, h.z)); d.cen = xf.p; d.ci = rot_inertia(xf.q, box_inertia(d.vol, -h, h))
	for k 6: ax := if k / 2 == 0 { float3{1.0, 0.0, 0.0} } else if k / 2 == 1 { float3{0.0, 1.0, 0.0} } else { float3{0.0, 0.0, 1.0} }; d.pl.push(plane_xform(xf, if k % 2 == 0 { plane_np(-ax, -h) } else { plane_np(ax, h) }))
	for c [float3{h.x, h.y, h.z}, float3{-h.x, h.y, h.z}, float3{-h.x, -h.y, h.z}, float3{h.x, -h.y, h.z}, float3{h.x, h.y, -h.z}, float3{-h.x, h.y, -h.z}, float3{-h.x, -h.y, -h.z}, float3{h.x, -h.y, -h.z}]: d.pts.push(xpt(xf, c))
	for e BOX_EG: d.eg.push(e)
	for v [8, 1, 0, 9, 13, 3, 5, 11]: d.ve.push(v)
	for f [0, 8, 16, 20, 19, 21]: d.fe.push(f)
	d.hash = hull_hash(d); d
scale_box(hw float3&, xf Transform&, ps float3, mnh f32):
	q ~= xf.q
	if ps.x < 0.0 || ps.y < 0.0 || ps.z < 0.0:
		m ~= qmat(q); m.cx = nrm(m.cx * ps); m.cy = nrm(m.cy * ps); m.cz = nrm(m.cz * ps)
		if ps.x < 0.0: m.cx = -m.cx
		if ps.y < 0.0: m.cy = -m.cy
		if ps.z < 0.0: m.cz = -m.cz
		q = q_from_mat(m)
	a := vabs(ps); h := hw; l1 := irot(q, a * rot(q, -h)); l2 := irot(q, a * rot(q, h))
	hw = vmax(sv(0.5, vmax(l1, l2) - vmin(l1, l2)), float3{mnh, mnh, mnh}); xf.p = ps * xf.p; xf.q = q
scaled_box_hull(hw float3, xf Transform, ps float3) HData: h ~= hw; x ~= xf; scale_box(h, x, ps, 4.0 * slop()); box_hull(h.x, h.y, h.z, x)
struct PlaneRes { pl Plane, p float3, tri int = 0, child int = 0, mat int = 0 }
NOPLANE := PlaneRes{Plane{V0, 0.0}, V0, 0, 0, 0}
sphere_mass(s Sphere, den f32) MassData: r := s.radius; m := 4.0 / 3.0 * PI * r * r * r * den; i := 0.4 * m * r * r; MassData{m, s.center, diag(i, i, i)}
sphere_box(s Sphere, xf Transform) AABB: c := xpt(xf, s.center); e := float3{s.radius, s.radius, s.radius}; AABB{c - e, c + e}
swept_sphere_box(s Sphere, x1 Transform, x2 Transform) AABB: r := float3{s.radius, s.radius, s.radius}; c1 := xpt(x1, s.center); c2 := xpt(x2, s.center); AABB{vmin(c1, c2) - r, vmax(c1, c2) + r}
overlap_proxy(a Proxy, xf Transform, px Proxy) bool: c ~= SCache{..}; shape_distance(a, px, ximul(xf, XI), true, c).d < 0.1 * slop()
overlap_sphere(s Sphere, xf Transform, px Proxy) bool: c := [s.center]; overlap_proxy(Proxy{c[..], s.radius}, xf, px)
ray_sphere(s Sphere, org float3, tr float3, maxf f32) CastOut:
	o ~= NOCAST; p := s.center; d0 := org - p; rr := s.radius * s.radius; ln ~= 0.0 as f32; d := len_nrm(ln, tr)
	if ln == 0.0:
		if vlen2(d0) < rr: o.p = org; o.hit = true
		return o
	t := -dot(d0, d); c := madd(d0, t, d); cc := dot(c, c)
	if cc > rr: return o
	fr := t - fsqrt(rr - cc)
	if fr < 0.0 || maxf * ln < fr:
		if vlen2(d0) < rr: o.p = org; o.hit = true
		return o
	o.frac = fmin(fr / ln, maxf); o.n = nrm(madd(d0, fr, d)); o.p = madd(p, s.radius, o.n); o.hit = true; o
ray_hollow_sphere(s Sphere, org float3, tr float3, maxf f32) CastOut:
	o ~= NOCAST; p := s.center; d0 := org - p; d := nrm(tr); t := -dot(d0, d); c := madd(d0, t, d); cc := dot(c, c); rr := s.radius * s.radius
	if cc > rr: return o
	h := fsqrt(rr - cc); fr ~= t - h
	if fr < 0.0: fr = t + h
	if fr < 0.0 || fr > maxf: return o
	o.frac = fr; o.n = nrm(madd(d0, fr, d)); o.p = madd(p, s.radius, o.n); o.hit = true; o
cast_sphere(s Sphere, px Proxy, tr float3, maxf f32, enc bool) CastOut: c := [s.center]; shape_cast_pair(Proxy{c[..], s.radius}, px, XI, tr, maxf, enc)
mover_plane(n0 float3, d0 f32, tr f32, mv Capsule, p float3, res PlaneRes&) int:
	n ~= n0; d ~= d0
	if d > tr: return 0
	if d < slop(): ml ~= 0.0 as f32; ax := len_nrm(ml, mv.center2 - mv.center1); n = if ml > slop() { perp(ax) } else { float3{0.0, 1.0, 0.0} }; d = 0.0
	res = PlaneRes{Plane{n, tr - d}, p, 0, 0, 0}; 1
mover_sphere(res PlaneRes&, s Sphere, mv Capsule) int: c := pt_seg(mv.center1, mv.center2, s.center); d ~= 0.0 as f32; n := len_nrm(d, c - s.center); mover_plane(n, d, mv.radius + s.radius, mv, s.center, res)
capsule_mass(s Capsule, den f32) MassData:
	c1 := s.center1; c2 := s.center2; r := s.radius; h := vdist(c1, c2); cm := PI * r * r * h * den; smass := 4.0 / 3.0 * PI * r * r * r * den
	i ~= madd3(cyl_inertia(cm, r, h), sphere_inertia(smass, r)); st := 0.125 * smass * (3.0 * r + 2.0 * h) * h; i.cx.x += st; i.cz.z += st
	rt := if h * h > 1000.0 * FLT_MIN { qmat(q_between(float3{0.0, 1.0, 0.0}, nrm(c2 - c1))) } else { M1 }
	MassData{smass + cm, sv(0.5, c1 + c2), mm(rt, mm(i, mt(rt)))}
capsule_box(s Capsule, xf Transform) AABB: a := xpt(xf, s.center1); b := xpt(xf, s.center2); e := float3{s.radius, s.radius, s.radius}; AABB{vmin(a, b) - e, vmax(a, b) + e}
swept_capsule_box(s Capsule, x1 Transform, x2 Transform) AABB: r := float3{s.radius, s.radius, s.radius}; a := xpt(x1, s.center1); b := xpt(x1, s.center2); c := xpt(x2, s.center1); d := xpt(x2, s.center2); AABB{vmin(vmin(a, b), vmin(c, d)) - r, vmax(vmax(a, b), vmax(c, d)) + r}
overlap_capsule(s Capsule, xf Transform, px Proxy) bool: c := [s.center1, s.center2]; overlap_proxy(Proxy{c[..], s.radius}, xf, px)
ray_capsule(s Capsule, org float3, tr float3, maxf f32) CastOut:
	c1 := s.center1; c2 := s.center2; r := s.radius; o ~= NOCAST; d := c2 - c1; tol := 0.01 * slop(); l2 := vlen2(d)
	if l2 < tol * tol: return ray_sphere(Sphere{sv(0.5, s.center1 + s.center2), r}, org, tr, maxf)
	s0 := org - c1; ln := fsqrt(l2); ax := sv(1.0 / ln, d); u := dot(s0, ax); sc := s0 - sv(u, ax); sc2 := vlen2(sc)
	if sc2 < r * r:
		cp := sv(fclamp(u, 0.0, ln), ax)
		if vlen2(s0 - cp) < r * r: o.hit = true; o.p = org; return o
		return ray_sphere(Sphere{c1 + cp, r}, org, tr, maxf)
	rl ~= 0.0 as f32; ra := len_nrm(rl, tr)
	if rl == 0.0: return o
	v := u + maxf * dot(tr, ax)
	if u < -r && v < -r || ln + r < u && ln + r < v: return o
	a12 := dot(ax, ra); det := 1.0 - a12 * a12; t ~= 0.0 as f32
	if det < FLT_EPS:
		pp := msub(ra, a12, ax); p2 := vlen2(pp); be := dot(sc, pp); ga := sc2 - r * r; ds := be * be - p2 * ga
		if be >= 0.0 || ds < 0.0: return o
		t = ga / (-be + fsqrt(ds))
	else:
		id := 1.0 / det; sa2 := dot(s0, ra); t1 := (u - a12 * sa2) * id; t2 := (a12 * u - sa2) * id; g := madd(s0, t2, ra) - sv(t1, ax); g2 := vlen2(g)
		if g2 > r * r: return o
		t = t2 - fsqrt((r * r - g2) * id)
	if t < 0.0 || maxf * rl < t: return o
	tc := u + t * a12
	if tc < 0.0: return ray_sphere(Sphere{c1, r}, org, tr, maxf)
	if ln < tc: return ray_sphere(Sphere{c2, r}, org, tr, maxf)
	p := madd(s0, t, ra); o.p = c1 + p; o.n = nrm(msub(p, tc, ax)); o.frac = fclamp(t / rl, 0.0, maxf); o.hit = true; o
cast_capsule(s Capsule, px Proxy, tr float3, maxf f32, enc bool) CastOut: c := [s.center1, s.center2]; shape_cast_pair(Proxy{c[..], s.radius}, px, XI, tr, maxf, enc)
mover_capsule(res PlaneRes&, s Capsule, mv Capsule) int: a := seg_dist(s.center1, s.center2, mv.center1, mv.center2); d ~= 0.0 as f32; n := len_nrm(d, a.p2 - a.p1); mover_plane(n, d, mv.radius + s.radius, mv, a.p1, res)
mover_hull(res PlaneRes&, h HData&, mv Capsule) int:
	c ~= SCache{..}; m := [mv.center1, mv.center2]; d := shape_distance(hull_proxy(h), Proxy{m[..], mv.radius}, XI, false, c)
	if d.d == 0.0 || d.d > mv.radius: return 0
	res = PlaneRes{Plane{d.n, mv.radius - d.d}, d.pa, 0, 0, 0}; 1
struct FP { o1 int = 0, i1 int = 0, o2 int = 0, i2 int = 0 }
struct CV { p float3 = V0, s f32 = 0.0, fp FP = FP{} }
struct MP { p float3 = V0, s f32 = 0.0, fp FP = FP{}, tri int = 0 }
struct LM { n float3 = V0, tn float3 = V0, pts MP[>..], count int = 0, tri int = 0, i1 int = 0, i2 int = 0, i3 int = 0, d2 f32 = 0.0, feat int = 0, tflags int = 0 }
struct SAT { s f32 = 0.0, ty int = 0, ia int = 0, ib int = 0, hit int = 0 }
struct SA { n float3 = V0, s f32 = 0.0, ia int = -1, ib int = -1, ty int = 0 }
struct AQ { fa SA, fb SA, ed SA, sep int }
AX_FA := 2; AX_FB := 3; AX_EDGE := 4; AX_MFA := 6; AX_MFB := 7; AX_MEDGE := 8
FP0 := FP{0, 0, 0, 0}
sq(x f32) f32: x * x
ninf() f32: binary::f32_from_bits(0xFF800000)
mk_fp(o1 int, i1 int, o2 int, i2 int) FP: FP{o1, i1 & 255, o2, i2 & 255}
flip_fp(p FP) FP: FP{1 - p.o2, p.i2, 1 - p.o1, p.i1}
fid(p FP) u32: ((p.o1 << 24) | (p.i1 << 16) | (p.o2 << 8) | p.i2) as u32
put(m LM&, i int, p MP):
	while m.pts.len <= i: m.pts.push(MP{})
	m.pts[i] = p
setp(m LM&, i int, p float3, s f32, fp FP):
	while m.pts.len <= i: m.pts.push(MP{})
	m.pts[i].p = p; m.pts[i].s = s; m.pts[i].fp = fp
clip_seg(sg CV[2]&, pl Plane) int:
	v1 := sg[0]; v2 := sg[1]; d1 := plane_sep(pl, v1.p); d2 := plane_sep(pl, v2.p); n ~= 0
	if d1 <= 0.0: sg[n] = v1; n += 1
	if d2 <= 0.0: sg[n] = v2; n += 1
	if d1 * d2 < 0.0: t := d1 / (d1 - d2); sg[n].p = sv(1.0 - t, v1.p) + sv(t, v2.p); sg[n].fp = if d1 > 0.0 { v1.fp } else { v2.fp }; n += 1
	n
clip_seg_face(sg CV[2]&, h HData&, rf int) int:
	e ~= h.fe[rf]
	loop:
		nx := h.eg[e].n; v1 := h.pts[h.eg[e].o]; v2 := h.pts[h.eg[nx].o]
		if clip_seg(sg, plane_np(cross(nrm(v2 - v1), h.pl[rf].normal), v1)) < 2: return 0
		e = nx
		if e == h.fe[rf]: break
	2
cap_seg(xf Transform, c Capsule) CV[2]: [CV{xpt(xf, c.center1), 0.0, mk_fp(0, 0, 0, 0)}, CV{xpt(xf, c.center2), 0.0, mk_fp(0, 1, 0, 1)}]
query_face_hull_capsule(h HData&, c Capsule, xf Transform) SA:
	mf ~= -1; mvi ~= -1; ms ~= -FLT_MAX; cp := [xpt(xf, c.center1), xpt(xf, c.center2)]
	for i h.pl.len: pl := h.pl[i]; vi := pt_support(cp[..], -pl.normal); s := plane_sep(pl, cp[vi]); if s > ms { mvi = vi; mf = i; ms = s }
	SA{h.pl[mf].normal, ms, mf & 255, mvi & 255, 0}
query_edge_hull_capsule(h HData&, c Capsule, xf Transform) SA:
	mn ~= V0; ms ~= -FLT_MAX; mia ~= -1; mib ~= -1; pa := xpt(xf, c.center1); qa := xpt(xf, c.center2); ea := qa - pa; t2 := sq(0.005)
	for k h.eg.len / 2:
		i := 2 * k; e := h.eg[i]; tw := h.eg[i + 1]; qb := h.pts[tw.o]; ub := h.pl[e.f].normal; vb := h.pl[tw.f].normal; cba := dot(ub, ea); dba := dot(vb, ea)
		if cba * dba < 0.0 && !(fmax(cba * cba, dba * dba) < t2 * vlen2(ea)):
			ax := nrm(vlerp(ub, vb, cba / (cba - dba))); s := dot(ax, qa - qb)
			if s > ms: mn = ax; ms = s; mia = 0; mib = i
	SA{mn, ms, mia, mib, 0}
reduce_pts(m LM&, cap int, pts MP[>..]&, cnt0 int):
	if cap < 4: return
	cnt ~= cnt0
	if cnt <= 4:
		for i cnt: put(m, i, pts[i])
		m.count = cnt; return
	n := m.n; sd := spec_dist(); tol2 := sd * sd; bias := 0.95 as f32; bi ~= -1; bs ~= -FLT_MAX; dir := arb_perp(n)
	for i cnt: if !(pts[i].s > sd) { sc := -pts[i].s + dot(dir, pts[i].p); if bias * sc > bs { bi = i; bs = sc } }
	if bi < 0: m.count = 0; return
	put(m, 0, pts[bi]); m.count = 1; pts[bi] = pts[cnt - 1]; cnt -= 1; a := m.pts[0].p; bs = 0.0; bi = -1
	for i cnt: d := pts[i].p - a; v := msub(d, dot(d, n), n); s := fmax(0.0, -pts[i].s); sc := vlen2(v) + 4.0 * s * s; if bias * sc > bs { bs = sc; bi = i }
	if bs < tol2: return
	put(m, 1, pts[bi]); m.count = 2; pts[bi] = pts[cnt - 1]; cnt -= 1; b := m.pts[1].p; bs = tol2; bi = -1; bsa ~= 0.0 as f32; ba := b - a
	for i cnt: sa := dot(n, cross(ba, pts[i].p - a)); sc := fabs(sa); if bias * sc >= bs { bs = sc; bi = i; bsa = sa }
	if bi < 0: return
	put(m, 2, pts[bi]); m.count = 3; pts[bi] = pts[cnt - 1]; cnt -= 1; c := m.pts[2].p; bs = tol2; bi = -1; sg := if bsa < 0.0 { -1.0 } else { 1.0 }
	for i cnt:
		p := pts[i].p; u1 := sg * dot(n, cross(p - a, ba)); u2 := sg * dot(n, cross(p - b, c - b)); u3 := sg * dot(n, cross(p - c, a - c)); sc := fmax(u1, fmax(u2, u3))
		if bias * sc > bs: bs = sc; bi = i
	if bi >= 0: put(m, m.count, pts[bi]); m.count += 1
collide_spheres(m LM&, cap int, a Sphere, b Sphere, xf Transform):
	if cap == 0: return
	c1 := a.center; c2 := xpt(xf, b.center); tr := a.radius + b.radius; off := c2 - c1; d2 := vlen2(off)
	if d2 > tr * tr: return
	d := fsqrt(d2); n := if d * d > 1000.0 * FLT_MIN { sv(1.0 / d, off) } else { float3{0.0, 1.0, 0.0} }
	m.n = n; m.count = 1; setp(m, 0, sv(0.5, msub(madd(c1, a.radius, n) + c2, b.radius, n)), d - tr, FP0)
collide_capsule_sphere(m LM&, cap int, a Capsule, b Sphere, xf Transform):
	m.count = 0
	if cap < 1: return
	c := xpt(xf, b.center); tr := b.radius + a.radius; cp := pt_seg(a.center1, a.center2, c); off := c - cp; d2 := vlen2(off)
	if d2 > tr * tr: return
	d := fsqrt(d2); n := if d * d > 1000.0 * FLT_MIN { sv(1.0 / d, off) } else { float3{0.0, 1.0, 0.0} }
	m.n = n; m.count = 1; setp(m, 0, sv(0.5, madd(msub(c, b.radius, n) + cp, a.radius, n)), d - tr, FP0)
collide_hull_sphere(m LM&, cap int, h HData&, b Sphere, xf Transform, cache SCache&):
	m.count = 0
	if cap == 0: return
	c := xpt(xf, b.center); ca := [c]; r := b.radius; d := shape_distance(hull_proxy(h), Proxy{ca[..], 0.0}, XI, false, cache)
	if d.d > r + spec_dist(): cache = SCache{..}; return
	n ~= V0; s ~= 0.0 as f32
	if d.d > 100.0 * FLT_EPS: n = nrm(d.pb - d.pa); s = d.d - r
	else:
		bi ~= -1; bd ~= -FLT_MAX
		for i h.pl.len: x := plane_sep(h.pl[i], c); if x > bd { bi = i; bd = x }
		n = h.pl[bi].normal; s = bd - r
	m.n = n; m.count = 1; setp(m, 0, vlerp(madd(c, 0.0 - dot(c - d.pa, n), n), msub(c, r, n), 0.5), s, FP0)
collide_capsules(m LM&, cap int, ca Capsule, cb Capsule, xf Transform):
	m.count = 0
	if cap < 2: return
	a1 := ca.center1; a2 := ca.center2; b1 := xpt(xf, cb.center1); b2 := xpt(xf, cb.center2); r := ca.radius + cb.radius; md := r + spec_dist()
	res := seg_dist(a1, a2, b1, b2); off := res.p2 - res.p1; dd := vlen2(off); mnd := 0.01 * slop()
	if dd > md * md || dd < mnd * mnd: return
	la ~= 0.0 as f32; ea := len_nrm(la, a2 - a1)
	if la < slop(): return
	lb ~= 0.0 as f32; eb := len_nrm(lb, b2 - b1)
	if lb < slop(): return
	if vlen2(cross(ea, eb)) < sq(0.05):
		vb ~= [CV{b1, 0.0, mk_fp(0, 0, 0, 0)}, CV{b2, 0.0, mk_fp(0, 1, 0, 1)}]; pc ~= clip_seg(vb, Plane{-ea, -dot(ea, ca.center1)})
		if pc == 2: pc = clip_seg(vb, Plane{ea, dot(ea, ca.center2)})
		if pc == 2:
			c1 := pt_seg(a1, a2, vb[0].p); c2 := pt_seg(a1, a2, vb[1].p); d1 := vdist(c1, vb[0].p); d2 := vdist(c2, vb[1].p)
			if d1 <= r && d2 <= r:
				if d1 < mnd || d2 < mnd: return
				n1 := sv(1.0 / d1, vb[0].p - c1); n2 := sv(1.0 / d2, vb[1].p - c2); n := nrm(n1 + n2)
				m.n = n; m.count = 2; setp(m, 0, sv(0.5, msub(madd(vb[0].p, ca.radius, n1) + c1, cb.radius, n)), d1 - r, vb[0].fp); setp(m, 1, sv(0.5, msub(madd(vb[1].p, ca.radius, n2) + c2, cb.radius, n)), d2 - r, vb[1].fp); return
	d ~= 0.0 as f32; n := len_nrm(d, off); m.n = n; m.count = 1; setp(m, 0, sv(0.5, msub(madd(res.p1, ca.radius, n) + res.p2, cb.radius, n)), d - r, FP0)
face_capsule_pts(m LM&, sg CV[2]&, rp Plane, r f32, lim f32) bool:
	d1 := plane_sep(rp, sg[0].p); d2 := plane_sep(rp, sg[1].p)
	if d1 <= lim || d2 <= lim: n := rp.normal; m.n = n; m.count = 2; setp(m, 0, msub(sg[0].p, 0.5 * (r + d1), n), d1 - r, sg[0].fp); setp(m, 1, msub(sg[1].p, 0.5 * (r + d2), n), d2 - r, sg[1].fp); return true
	false
build_face_capsule(m LM&, h HData&, cb Capsule, xf Transform, q SA) bool: sg ~= cap_seg(xf, cb); clip_seg_face(sg, h, q.ia) == 2 && face_capsule_pts(m, sg, h.pl[q.ia], cb.radius, spec_dist())
build_hull_capsule_edge(m LM&, cap int, h HData&, cb Capsule, xf Transform, q SA) bool:
	if cap < 1: return false
	pc := xpt(xf, cb.center1); e2 := h.eg[q.ib]; ph := h.pts[e2.o]; n := q.n; res := line_dist(ph, h.pts[h.eg[e2.t].o] - ph, pc, xpt(xf, cb.center2) - pc)
	if !within_segs(res): return false
	m.n = n; m.count = 1; setp(m, 0, sv(0.5, msub(res.p1, cb.radius, n) + res.p2), dot(n, res.p2 - res.p1) - cb.radius, mk_fp(0, q.ia, 1, q.ib)); true
collide_hull_capsule(m LM&, cap int, h HData&, cb Capsule, xf Transform, cache SCache&):
	m.count = 0
	if cap < 2: return
	cc := [cb.center1, cb.center2]; d := shape_distance(hull_proxy(h), Proxy{cc[..], 0.0}, xf, false, cache); sd := spec_dist()
	if d.d > cb.radius + sd: cache = SCache{..}; return
	if d.d > 100.0 * FLT_EPS:
		dl := d.n; rf := hull_support_face(h, dl); rp := h.pl[rf]
		if fabs(dot(rp.normal, dl)) > 0.998:
			vb ~= cap_seg(xf, cb)
			if clip_seg_face(vb, h, rf) == 2 && face_capsule_pts(m, vb, rp, cb.radius, cb.radius + sd): return
		m.n = dl; m.count = 1; setp(m, 0, sv(0.5, msub(d.pa, cb.radius, dl) + d.pb), d.d - cb.radius, FP0); return
	fq := query_face_hull_capsule(h, cb, xf)
	if fq.s > cb.radius: return
	eq := query_edge_hull_capsule(h, cb, xf)
	if eq.s > cb.radius: return
	fs ~= fq.s - cb.radius; build_face_capsule(m, h, cb, xf, fq)
	if m.count == 2: fs = fmin(m.pts[0].s, m.pts[1].s)
	if eq.ia < 0: return
	if m.count == 0 || eq.s - cb.radius > fs + slop(): build_hull_capsule_edge(m, cap, h, cb, xf, eq)
incident_face(h HData&, rn float3, vi int) int:
	mei ~= -1; mep ~= FLT_MAX; ei ~= h.ve[vi]; eo := h.pts[h.eg[ei].o]
	loop:
		tw := h.eg[h.eg[ei].t]; ep := fabs(dot(nrm(h.pts[tw.o] - eo), rn))
		if ep < mep: mei = ei; mep = ep
		ei = tw.n
		if ei == h.ve[vi]: break
	f1 := h.eg[mei].f; f2 := h.eg[h.eg[mei].t].f; if dot(h.pl[f1].normal, rn) < dot(h.pl[f2].normal, rn) { f1 } else { f2 }
build_polygon(out CV[>..]&, xf Transform, h HData&, inc int, rp Plane) int:
	e ~= h.fe[inc]; m := qmat(xf.q); out.clear()
	loop:
		nx := h.eg[e].n; p := mv(m, h.pts[h.eg[nx].o]) + xf.p; out.push(CV{p, plane_sep(rp, p), mk_fp(1, e, 1, nx)}); e = nx
		if e == h.fe[inc] || out.len >= 64: break
	out.len
clip_polygon(out CV[>..]&, pg CV[>..]&, cnt int, cp Plane, edge int, rp Plane) int:
	out.clear(); v1 ~= pg[cnt - 1]; d1 ~= plane_sep(cp, v1.p)
	for i cnt:
		v2 := pg[i]; d2 := plane_sep(cp, v2.p)
		if d1 <= 0.0 && d2 <= 0.0: out.push(v2)
		else if d1 <= 0.0 && d2 > 0.0: p := madd(v1.p, d1 / (d1 - d2), v2.p - v1.p); fp ~= v2.fp; fp.o2 = 0; fp.i2 = edge & 255; out.push(CV{p, plane_sep(rp, p), fp})
		else if d2 <= 0.0 && d1 > 0.0: p := madd(v1.p, d1 / (d1 - d2), v2.p - v1.p); fp ~= v1.fp; fp.o1 = 0; fp.i1 = edge & 255; out.push(CV{p, plane_sep(rp, p), fp}); out.push(v2)
		v1 = v2; d1 = d2
	out.len
build_face_a(m LM&, cap int, ha HData&, hb HData&, xf Transform, q SA, cache SAT&) bool:
	rf := q.ia; rp := ha.pl[rf]; inc := incident_face(hb, irot(xf.q, rp.normal), q.ib); b1 CV[>..] ~= []; b2 CV[>..] ~= []; pc ~= build_polygon(b1, xf, hb, inc, rp); e ~= ha.fe[rf]
	loop:
		nx := ha.eg[e].n; v1 := ha.pts[ha.eg[e].o]; v2 := ha.pts[ha.eg[nx].o]; pc = clip_polygon(b2, b1, pc, plane_np(cross(nrm(v2 - v1), rp.normal), v1), e, rp); b1 = b2
		if pc < 3: cache = SAT{..}; return false
		e = nx
		if e == ha.fe[rf]: break
	if pc > 64: pc = 64
	pts MP[>..] ~= []; ms ~= FLT_MAX; m.n = rp.normal
	for i pc: c := b1[i]; pts.push(MP{msub(c.p, 0.5 * c.s, rp.normal), c.s, c.fp, 0}); ms = fmin(ms, c.s)
	if ms >= spec_dist(): cache = SAT{..}; return false
	reduce_pts(m, cap, pts, pc); cache.s = ms; cache.ty = AX_FA; cache.ia = q.ia & 255; cache.ib = q.ib & 255; true
build_face_b(m LM&, cap int, ha HData&, hb HData&, xf Transform, q SA, cache SAT&) bool:
	if !build_face_a(m, cap, hb, ha, xinv(xf), SA{-q.n, q.s, q.ib, q.ia, AX_FA}, cache): cache = SAT{..}; return false
	r := qmat(xf.q); m.n = -mv(r, m.n)
	for i m.count: m.pts[i].p = mv(r, m.pts[i].p) + xf.p; m.pts[i].fp = flip_fp(m.pts[i].fp)
	cache.ty = AX_FB; cache.ia = q.ia & 255; cache.ib = q.ib & 255; true
build_edge(m LM&, ha HData&, hb HData&, xf Transform, q SA, cache SAT&) bool:
	ea := ha.eg[q.ia]; pa := ha.pts[ea.o]; eb := hb.eg[q.ib]; pb := xpt(xf, hb.pts[eb.o]); r := line_dist(pa, ha.pts[ha.eg[ea.t].o] - pa, pb, xpt(xf, hb.pts[hb.eg[eb.t].o]) - pb)
	if !within_segs(r): cache = SAT{..}; return false
	s := dot(q.n, r.p2 - r.p1); m.n = q.n; m.count = 1; setp(m, 0, sv(0.5, r.p1 + r.p2), s, mk_fp(0, q.ia, 1, q.ib)); cache.s = s; cache.ty = AX_EDGE; cache.ia = q.ia & 255; cache.ib = q.ib & 255; true
hvx(h HData&, i int) float3: if i < h.pts.len { h.pts[i] } else { h.pts[0] }
support_wide(n float3, h HData&, bias f32, vi int&) f32:
	mn ~= huge(); c := (h.pts.len + 3) & ~3
	for i c: p := hvx(h, i); a := binary::f32_from_bits((binary::f32_bits(bias - (n.z * p.z + (n.y * p.y + n.x * p.x))) & ~(127 as u32)) | i as u32); if !(mn < a) { mn = a }
	vi = (binary::f32_bits(mn) & 127) as int; p := hvx(h, vi); n.x * p.x + n.y * p.y + n.z * p.z
rdot(r Mat3, v float3) float3: float3{r.cx.x * v.x + (r.cy.x * v.y + r.cz.x * v.z), r.cx.y * v.x + (r.cy.y * v.y + r.cz.y * v.z), r.cx.z * v.x + (r.cy.z * v.y + r.cz.z * v.z)}
dot3w(a float3, b float3) f32: a.x * b.x + (a.y * b.y + a.z * b.z)
sep_axis(ha HData&, hb HData&, xf Transform, early bool) AQ:
	r := qmat(xf.q); ir := mt(r); sd := spec_dist(); q ~= AQ{SA{V0, ninf(), -1, -1, AX_FA}, SA{V0, ninf(), -1, -1, AX_FB}, SA{V0, ninf(), -1, -1, AX_EDGE}, 0}
	cb := box_center(hb.aabb); eb := box_ext(hb.aabb)
	for i ha.pl.len:
		pl := ha.pl[i]; dir := -mv(ir, pl.normal); vi ~= 0; sup := support_wide(dir, hb, dot(dir, cb) + 1.0625 * dot(vabs(dir), eb), vi); s := dot(pl.normal, xf.p) - pl.offset - sup
		if s > q.fa.s:
			q.fa = SA{pl.normal, s, i, vi, AX_FA}
			if s > sd && early: q.sep = AX_FA; return q
	ca := box_center(ha.aabb); ea := box_ext(ha.aabb)
	for i hb.pl.len:
		pl := hb.pl[i]; dir := -mv(r, pl.normal); vi ~= 0; sup := support_wide(dir, ha, dot(dir, ca) + 1.0625 * dot(vabs(dir), ea), vi); s := dot(dir, xf.p) - pl.offset - sup
		if s > q.fb.s:
			q.fb = SA{dir, s, vi, i, AX_FB}
			if s > sd && early: q.sep = AX_FB; return q
	nv float3[>..] ~= []; w float3[>..] ~= []
	for j hb.pl.len: nv.push(-rdot(r, hb.pl[j].normal))
	for j (hb.pts.len + 3) & ~3: w.push(-(rdot(r, hvx(hb, j)) + xf.p))
	t2 := sq(0.005); eps := -0.0001 as f32
	for jj hb.eg.len / 2:
		eb2 := hb.eg[2 * jj]; tb := hb.eg[2 * jj + 1]; c := nv[eb2.f]; d := nv[tb.f]; bv := w[eb2.o]; dc := w[tb.o] - w[eb2.o]
		for ii ha.eg.len / 2:
			e := ha.eg[2 * ii]; tw := ha.eg[2 * ii + 1]; an := ha.pl[e.f].normal; bn := ha.pl[tw.f].normal; v0 := ha.pts[e.o]; dd := ha.pts[tw.o] - v0
			cba := dot3w(c, dd); dba := dot3w(d, dd); adc := dot3w(an, dc); bdc := dot3w(bn, dc); x1 := cba * cba; x2 := dba * dba
			if cba * dba < eps && adc * bdc < eps && cba * bdc < eps && (if x1 > x2 { x1 } else { x2 }) > t2 * (dd.x * dd.x + dd.y * dd.y + dd.z * dd.z):
				t := (0.0 - cba) / (dba - cba); nn ~= float3{c.x + t * (d.x - c.x), c.y + t * (d.y - c.y), c.z + t * (d.z - c.z)}; iv := 1.0 / fsqrt(dot3w(nn, nn)); nn = float3{nn.x * iv, nn.y * iv, nn.z * iv}
				s := 0.0 - dot3w(v0 + bv, nn)
				if s > q.ed.s:
					q.ed = SA{nn, s, 2 * ii, 2 * jj, AX_EDGE}
					if s > sd && early: q.sep = AX_EDGE; return q
	q
collide_hulls(m LM&, cap int, ha HData&, hb HData&, xf Transform, cache SAT&):
	m.count = 0
	if cap < 4: return
	sd := spec_dist(); sl := slop(); cache.hit = 0; ty := cache.ty
	if ty == AX_FA:
		pl := ha.pl[cache.ia]; vi := hull_support(hb, -irot(xf.q, pl.normal))
		if plane_sep(pl, xpt(xf, hb.pts[vi])) >= sd: cache.hit = 1; return
		lc ~= SAT{..}
		if build_face_a(m, cap, ha, hb, xf, SA{pl.normal, 0.0, cache.ia, vi, AX_FA}, lc) && fabs(cache.s - lc.s) < sl: cache.hit = 1; return
	else if ty == AX_FB:
		pl := hb.pl[cache.ib]; vi := hull_support(ha, -rot(xf.q, pl.normal))
		if plane_sep(pl, xipt(xf, ha.pts[vi])) >= sd: cache.hit = 1; return
		lc ~= SAT{..}
		if build_face_b(m, cap, ha, hb, xf, SA{-pl.normal, 0.0, vi, cache.ib, AX_FB}, lc) && fabs(cache.s - lc.s) < sl: cache.hit = 1; return
	else if ty == AX_EDGE:
		e1 := ha.eg[cache.ia]; t1 := ha.eg[cache.ia + 1]; qa := ha.pts[t1.o]; ea := qa - ha.pts[e1.o]; ua := ha.pl[e1.f].normal; va := ha.pl[t1.f].normal
		e2 := hb.eg[cache.ib]; t2 := hb.eg[cache.ib + 1]; qb := xpt(xf, hb.pts[t2.o]); eb := qb - xpt(xf, hb.pts[e2.o]); ub := rot(xf.q, hb.pl[e2.f].normal); vb := rot(xf.q, hb.pl[t2.f].normal)
		cba := dot(ub, ea); dba := dot(vb, ea); adc := -dot(ua, eb); bdc := -dot(va, eb)
		if cba * dba < 0.0 && adc * bdc < 0.0 && cba * bdc > 0.0 && fmax(cba * cba, dba * dba) >= sq(0.005) * vlen2(ea):
			ax := nrm(vlerp(ub, vb, cba / (cba - dba)))
			if dot(ax, qa - qb) > sd: cache.hit = 1; return
			lc ~= SAT{..}
			if build_edge(m, ha, hb, xf, SA{-ax, 0.0, cache.ia, cache.ib, AX_EDGE}, lc) && fabs(cache.s - lc.s) < sl: cache.hit = 1; return
	else if ty == AX_MFA: build_face_a(m, cap, ha, hb, xf, sep_axis(ha, hb, xf, false).fa, cache); return
	else if ty == AX_MFB: build_face_b(m, cap, ha, hb, xf, sep_axis(ha, hb, xf, false).fb, cache); return
	else if ty == AX_MEDGE:
		eq := sep_axis(ha, hb, xf, false).ed
		if eq.ia >= 0: build_edge(m, ha, hb, xf, eq, cache)
		return
	m.count = 0; cache = SAT{..}; q := sep_axis(ha, hb, xf, true)
	if q.sep != 0: a := if q.sep == AX_FA { q.fa } else if q.sep == AX_FB { q.fb } else { q.ed }; cache.ty = q.sep; cache.s = a.s; cache.ia = a.ia & 255; cache.ib = a.ib & 255; return
	if q.fa.s > q.fb.s: build_face_a(m, cap, ha, hb, xf, q.fa, cache)
	else: build_face_b(m, cap, ha, hb, xf, q.fb, cache)
	if q.ed.ia < 0: return
	if m.count == 0 || q.ed.s > cache.s + sl:
		em ~= LM{..}; ec ~= SAT{..}; build_edge(em, ha, hb, xf, q.ed, ec)
		if em.count == 1: m = em; cache = ec
struct TD { v1 float3, v2 float3, v3 float3, e1 float3, e2 float3, e3 float3, pl Plane, flags int }
AX_BACK := 1
TRI_FEAT := [F_NONE, F_V1, F_V2, F_E1, F_V3, F_E3, F_E2, F_TRI]
tri_feature(c SCache&) int:
	m ~= 0
	for i c.count: m |= 1 << c.ia[i]
	TRI_FEAT[m]
cap_seg0(c Capsule) CV[2]: [CV{c.center1, 0.0, mk_fp(0, 0, 0, 0)}, CV{c.center2, 0.0, mk_fp(0, 1, 0, 1)}]
collide_tri_sphere(m LM&, cap int, t const float3[:], s Sphere):
	m.count = 0
	if cap == 0: return
	c := s.center; v1 := t[0]; v2 := t[1]; v3 := t[2]; pl := plane_pts(v1, v2, v3)
	if plane_sep(pl, c) < 0.0: return
	r := s.radius; cl := tri_closest(v1, v2, v3, c); d2 := vdist2(cl.p, c); md := r + spec_dist()
	if d2 > md * md: return
	d := fsqrt(d2); n := if d * d > 1000.0 * FLT_MIN { sv(1.0 / d, c - cl.p) } else { nrm(cross(v2 - v1, v3 - v1)) }
	m.n = n; m.count = 1; m.feat = cl.f; m.d2 = d2; setp(m, 0, sv(0.5, c - sv(r, n) + cl.p), d - r, FP0)
clip_seg_tri(sg CV[2]&, t const float3[:], pl Plane) bool:
	v1 ~= t[2]
	for i 3:
		v2 := t[i]; cp := plane_np(cross(nrm(v2 - v1), pl.normal), v1); p1 := sg[0]; p2 := sg[1]; d1 := plane_sep(cp, p1.p); d2 := plane_sep(cp, p2.p); n ~= 0
		if d1 <= 0.0: sg[n] = p1; n += 1
		if d2 <= 0.0: sg[n] = p2; n += 1
		if (d1 > 0.0) != (d2 > 0.0): sg[n].p = vlerp(p1.p, p2.p, d1 / (d1 - d2)); sg[n].fp = if d1 > 0.0 { p1.fp } else { p2.fp }; n += 1
		if n != 2: return false
		v1 = v2
	true
query_tri_capsule_edges(t const float3[:], pl Plane, c Capsule) SA:
	p1 := c.center1; ce := c.center2 - p1; mn ~= V0; ms ~= -FLT_MAX; mi1 ~= -1; mi2 ~= -1; tol := sq(0.005); ei ~= 2; a := dot(ce, pl.normal); v1 ~= t[2]
	for i 3:
		v2 := t[i]; sn := nrm(cross(v2 - v1, pl.normal)); b := dot(ce, sn)
		if !(a * a + b * b < tol * vlen2(ce)):
			ax := nrm(if a * b <= 0.0 { vlerp(sn, pl.normal, b / (b - a)) } else { vlerp(sn, -pl.normal, b / (a + b)) }); s := dot(ax, p1 - v1)
			if s > ms: mn = ax; ms = s; mi1 = ei; mi2 = 0
		v1 = v2; ei = i
	SA{mn, ms, mi1, mi2, 0}
tri_capsule_face_pts(m LM&, sg CV[2]&, pl Plane, r f32):
	d1 := plane_sep(pl, sg[0].p); d2 := plane_sep(pl, sg[1].p); n := pl.normal
	m.n = n; m.feat = F_TRI; m.count = 2; setp(m, 0, msub(sg[0].p, 0.5 * (d1 + r), n), d1 - r, sg[0].fp); setp(m, 1, msub(sg[1].p, 0.5 * (d2 + r), n), d2 - r, sg[1].fp)
build_tri_capsule_face(m LM&, t const float3[:], pl Plane, c Capsule):
	sg ~= cap_seg0(c)
	if !clip_seg_tri(sg, t, pl): return
	sd := spec_dist()
	if plane_sep(pl, sg[0].p) > sd + c.radius && plane_sep(pl, sg[1].p) > sd + c.radius: return
	tri_capsule_face_pts(m, sg, pl, c.radius)
build_tri_capsule_edge(m LM&, t const float3[:], pl Plane, c Capsule, q SA):
	p1 := c.center1; ce := c.center2 - p1; v1 := t[q.ia]; te := t[(q.ia + 1) % 3] - v1; sn := nrm(cross(te, pl.normal)); a := dot(ce, pl.normal); b := dot(ce, sn)
	if a * a + b * b < sq(0.005) * vlen2(ce): return
	n := q.n; r := line_dist(v1, te, p1, ce)
	if r.f1 < 0.0 || 1.0 < r.f1 || r.f2 < 0.0 || 1.0 < r.f2: return
	m.n = n; m.count = 1; m.feat = F_E1 + q.ia; setp(m, 0, vlerp(r.p1, msub(r.p2, c.radius, n), 0.5), dot(n, p1 - v1) - c.radius, mk_fp(0, q.ia, 1, q.ib))
collide_tri_capsule(m LM&, cap int, t const float3[:], c Capsule, cache SCache&):
	m.count = 0
	if cap < 2: return
	pl := plane_pts(t[0], t[1], t[2])
	if plane_sep(pl, vlerp(c.center1, c.center2, 0.5)) < 0.0: return
	cp := [c.center1, c.center2]; d := shape_distance(Proxy{t, 0.0}, Proxy{cp[..], 0.0}, XI, false, cache); r := c.radius
	if d.d > r + spec_dist(): return
	if d.d > 100.0 * FLT_EPS:
		dl := nrm(d.pb - d.pa)
		if fabs(dot(pl.normal, dl)) > 0.2:
			sg ~= cap_seg0(c)
			if clip_seg_tri(sg, t, pl): tri_capsule_face_pts(m, sg, pl, r); return
		m.n = dl; m.count = 1; m.feat = tri_feature(cache); setp(m, 0, vlerp(d.pa, msub(d.pb, r, dl), 0.5), d.d - r, FP0); return
	s1 := plane_sep(pl, c.center1); s2 := plane_sep(pl, c.center2); fqs := if s1 < s2 { s1 } else { s2 }
	if fqs > r: return
	eq := query_tri_capsule_edges(t, pl, c)
	if eq.s > r: return
	fs ~= fqs - r; build_tri_capsule_face(m, t, pl, c)
	if m.count == 2: fs = fmin(m.pts[0].s, m.pts[1].s)
	if eq.ia < 0: return
	if m.count == 0 || eq.s - r > fs + slop(): build_tri_capsule_edge(m, t, pl, c, eq)
tri_support(p float3[3], d float3) int:
	i ~= 0; ds ~= dot(p[0], d); x := dot(p[1], d)
	if x > ds: ds = x; i = 1
	if dot(p[2], d) > ds: return 2
	i
query_tri_face(td TD, h HData&) SA: vi := hull_support(h, -td.pl.normal); SA{td.pl.normal, plane_sep(td.pl, h.pts[vi]), 0, vi, AX_FA}
query_hull_face(td TD, h HData&) SA:
	tp := [td.v1, td.v2, td.v3]; mn ~= V0; ms ~= ninf(); mf ~= -1; mvi ~= -1
	for i h.pl.len: pl := h.pl[i]; vi := tri_support(tp, -pl.normal); s := plane_sep(pl, tp[vi]); if s > ms { mn = pl.normal; ms = s; mf = i; mvi = vi }
	SA{-mn, ms, mvi, mf, AX_FB}
query_tri_hull_edges(td TD, h HData&) SA:
	r ~= SA{V0, ninf(), -1, -1, AX_EDGE}; tp := [td.v1, td.v2, td.v3]; te := [td.e1, td.e2, td.e3]; tn := td.pl.normal; tol := sq(0.005)
	for k h.eg.len / 2:
		e := h.eg[2 * k]; tw := h.eg[2 * k + 1]; hp := h.pts[e.o]; he := h.pts[tw.o] - hp; n1 := h.pl[e.f].normal; n2 := h.pl[tw.f].normal
		for j 3:
			x := te[j]; cab := dot(n1, x); dab := dot(n2, x); bcd := dot(tn, he)
			if !(cab * dab >= 0.0 || cab * bcd <= 0.0) && !(fmax(cab * cab, dab * dab) < tol * vlen2(x)):
				ax := nrm(vlerp(n1, n2, cab / (cab - dab))); s := dot(ax, tp[j] - hp)
				if s > r.s: r.n = -ax; r.s = s; r.ia = j; r.ib = 2 * k
	r
collide_hull_face(m LM&, pcap int, td TD, h HData&, q SA, cache SAT&, spec bool) f32:
	m.count = 0; rp := h.pl[q.ib]; b1 CV[>..] ~= [CV{td.v1, plane_sep(rp, td.v1), mk_fp(1, 2, 1, 0)}, CV{td.v2, plane_sep(rp, td.v2), mk_fp(1, 0, 1, 1)}, CV{td.v3, plane_sep(rp, td.v3), mk_fp(1, 1, 1, 2)}]; b2 CV[>..] ~= []; pc ~= 3; e ~= h.fe[q.ib]
	loop:
		nx := h.eg[e].n; v1 := h.pts[h.eg[e].o]; v2 := h.pts[h.eg[nx].o]; pc = clip_polygon(b2, b1, pc, plane_np(cross(nrm(v2 - v1), rp.normal), v1), e, rp)
		if pc < 3: cache = SAT{..}; return q.s
		b1 = b2; e = nx
		if e == h.fe[q.ib]: break
	if pc > pcap: pc = pcap
	ms ~= FLT_MAX; fc ~= 0
	for i pc:
		c := b1[i]; ms = fmin(ms, c.s)
		if spec || !(c.s > 0.0): setp(m, fc, msub(c.p, c.s, rp.normal), c.s, flip_fp(c.fp)); fc += 1
	if ms > (if spec { spec_dist() } else { 0.0 }): m.count = 0; cache = SAT{..}; return ms
	m.count = fc; m.n = -rp.normal; m.feat = F_HULL; cache.s = ms; cache.ty = AX_FB; cache.ia = q.ia & 255; cache.ib = q.ib & 255; ms
collide_tri_face(m LM&, pcap int, td TD, h HData&, q SA, cache SAT&, spec bool) f32:
	rp := td.pl; inc := incident_face(h, rp.normal, q.ib); b1 CV[>..] ~= []; b2 CV[>..] ~= []; pc ~= 0; e ~= h.fe[inc]
	loop:
		nx := h.eg[e].n; hp := h.pts[h.eg[nx].o]; b1.push(CV{hp, plane_sep(rp, hp), mk_fp(1, e, 1, nx)}); pc += 1; e = nx
		if e == h.fe[inc] || pc >= 128: break
	tp := [td.v1, td.v2, td.v3]; te := [td.e1, td.e2, td.e3]
	for i 3: if pc > 0 { pc = clip_polygon(b2, b1, pc, plane_np(nrm(cross(te[i], rp.normal)), tp[i]), i, rp); b1 = b2 }
	if pc == 0: cache = SAT{..}; return FLT_MAX
	if pc > pcap: pc = pcap
	ms ~= FLT_MAX; fc ~= 0
	for i pc:
		c := b1[i]; ms = fmin(ms, c.s)
		if spec || !(c.s > 0.0): setp(m, fc, c.p, c.s, c.fp); fc += 1
	if ms >= (if spec { spec_dist() } else { 0.0 }): cache = SAT{..}; return ms
	m.count = fc; m.n = rp.normal; m.feat = F_TRI; cache.s = ms; cache.ty = AX_FA; cache.ia = q.ia & 255; cache.ib = q.ib & 255; ms
collide_tri_hull_edges(m LM&, cap int, tp float3, te float3, h HData&, q SA, cache SAT&):
	eb := h.eg[q.ib]; pb := h.pts[eb.o]; r := line_dist(tp, te, pb, h.pts[h.eg[eb.t].o] - pb)
	if cap == 0 || r.f1 < 0.0 || 1.0 < r.f1 || r.f2 < 0.0 || 1.0 < r.f2: cache = SAT{..}; return
	s := dot(q.n, pb - tp); setp(m, 0, sv(0.5, r.p1 + r.p2), s, mk_fp(0, q.ia, 1, q.ib)); cache.s = s; cache.ty = AX_EDGE; cache.ia = q.ia & 255; cache.ib = q.ib & 255; m.n = q.n; m.count = 1; m.feat = F_E1 + q.ia
collide_tri_hull(m LM&, cap int, v1 float3, v2 float3, v3 float3, tf int, h HData&, cache SAT&, spec bool):
	m.count = 0; m.feat = F_NONE
	if cap < 4: return
	pl := plane_pts(v1, v2, v3); sl := slop(); off := plane_sep(pl, h.cen)
	if cache.ty == AX_BACK:
		if fabs(cache.s - off) < sl: return
		cache.ty = 0
	if off < -sl: cache.ty = AX_BACK; cache.s = off; return
	tp := [v1, v2, v3]; te := [v2 - v1, v3 - v2, v1 - v3]; td := TD{v1, v2, v3, te[0], te[1], te[2], pl, tf}; sd := if spec { spec_dist() } else { 0.0 }; cache.hit = 1; ty := cache.ty
	if ty == AX_FA:
		vi := hull_support(h, -pl.normal); s := plane_sep(pl, h.pts[vi])
		if s > sd: return
		lc ~= cache; cs := collide_tri_face(m, cap, td, h, SA{pl.normal, s, cache.ia, vi, AX_FA}, lc, spec)
		if m.count > 0 && fabs(cache.s - cs) < sl: return
		m.count = 0; cache = SAT{..}
	else if ty == AX_FB:
		p := h.pl[cache.ib]; vi ~= 0; ds ~= -dot(v1, p.normal)
		for i 1..3: d := -dot(tp[i], p.normal); if d > ds { ds = d; vi = i }
		s := plane_sep(p, tp[vi])
		if s > sd: return
		if !(s < -2.0 * sl):
			lc ~= cache; cs := collide_hull_face(m, cap, td, h, SA{-p.normal, s, vi, cache.ib, AX_FB}, lc, spec)
			if m.count > 0 && fabs(cache.s - cs) < sl: return
		m.count = 0; cache = SAT{..}
	else if ty == AX_EDGE:
		ia := cache.ia; tpt := tp[ia]; x := te[ia]; ib := cache.ib; e2 := h.eg[ib]; t2 := h.eg[ib + 1]; hp := h.pts[e2.o]; he := h.pts[t2.o] - hp; n1 := h.pl[e2.f].normal; n2 := h.pl[t2.f].normal
		cab := dot(n1, x); dab := dot(n2, x); bcd := dot(pl.normal, he)
		if cab * dab < 0.0 && cab * bcd > 0.0 && fmax(cab * cab, dab * dab) >= sq(0.005) * vlen2(x):
			ax := nrm(vlerp(n1, n2, cab / (cab - dab))); s := dot(ax, tpt - hp)
			if s > sd: return
			if fabs(cache.s - s) < sl:
				lc ~= cache; collide_tri_hull_edges(m, cap, tpt, x, h, SA{-ax, s, ia, ib, AX_EDGE}, lc)
				if m.count > 0: return
		cache = SAT{..}
	else if ty == AX_MFA: collide_tri_face(m, cap, td, h, query_tri_face(td, h), cache, spec); return
	else if ty == AX_MFB: collide_hull_face(m, cap, td, h, query_hull_face(td, h), cache, spec); return
	else if ty == AX_MEDGE:
		q := query_tri_hull_edges(td, h)
		if q.ia >= 0: collide_tri_hull_edges(m, cap, tp[q.ia], te[q.ia], h, q, cache)
		return
	cache.hit = 0; fa := query_tri_face(td, h)
	if fa.s > sd: cache.s = fa.s; cache.ty = AX_FA; cache.ia = fa.ia & 255; cache.ib = fa.ib & 255; return
	fb := query_hull_face(td, h)
	if fb.s > sd: cache.s = fb.s; cache.ty = AX_FB; cache.ia = fb.ia & 255; cache.ib = fb.ib & 255; return
	eq := query_tri_hull_edges(td, h)
	if eq.s > sd: cache.s = eq.s; cache.ty = AX_EDGE; cache.ia = eq.ia & 255; cache.ib = eq.ib & 255; return
	cs := if fb.s >= fa.s && !(dot(fb.n, pl.normal) < -0.25) { collide_hull_face(m, cap, td, h, fb, cache, spec) } else { collide_tri_face(m, cap, td, h, fa, cache, spec) }
	if eq.ia >= 0 && (m.count == 0 && eq.s > fmax(fa.s, fb.s) || m.count == 1 && eq.s > cs + sl): m.count = 0; collide_tri_hull_edges(m, cap, tp[eq.ia], te[eq.ia], h, eq, cache)
	if m.count == 0:
		sc ~= SCache{..}; o := shape_distance(Proxy{tp[..], 0.0}, hull_proxy(h), XI, false, sc)
		if o.d > 0.0: m.count = 1; m.feat = tri_feature(sc); m.n = o.n; setp(m, 0, o.pb, o.d, FP0)
		cache = SAT{..}
struct MNode { lo float3, hi float3, ax int, ch int, tc int, to int }
struct MTri { i1 int, i2 int, i3 int }
struct MeshD { nodes MNode[>..], v float3[>..], t MTri[>..], mat byte[>..], fl byte[>..], bounds AABB = EMPTY_BOX, area f32 = 0.0, height int = 0, degen int = 0, mcount int = 1, hash u64 = 0 }
struct Prim { b AABB, c float3, ti int }
struct Split { l AABB, r AABB, ax int, ix int }
struct MEdge { v1 int, v2 int, t1 int, t2 int, n int, e1 int, e2 int }
struct MTriV { v1 float3, v2 float3, v3 float3, i1 int, i2 int, i3 int, flags int }
TWO_PI f32 := 6.283185307
ffloor(x f32) f32: t := (x as int) as f32; if t > x { t - 1.0 } else { t }
ckey(x int, y int, z int) u64:
	k ~= 0 as u64
	k ^= (x as! u64) + 0x9e3779b9 + (k << 6) + (k >> 2)
	k ^= (y as! u64) + 0x9e3779b9 + (k << 6) + (k >> 2)
	k ^= (z as! u64) + 0x9e3779b9 + (k << 6) + (k >> 2)
	k
find_dup(src const float3[:], i int, cs f32, tol f32, mp dictionary<u64, int>&, nv int[>..]&, nn int[>..]&) int:
	v := src[i]; bx := ffloor(v.x / cs) as int; by := ffloor(v.y / cs) as int; bz := ffloor(v.z / cs) as int
	for dx 3:
		for dy 3:
			for dz 3:
				h := dat(mp, ckey(bx + dx - 1, by + dy - 1, bz + dz - 1))
				if h >= 0:
					n ~= mp.slots[h].val
					while n >= 0:
						o := src[nv[n]]
						if fabs(v.x - o.x) <= tol && fabs(v.y - o.y) <= tol && fabs(v.z - o.z) <= tol: return nv[n]
						n = nn[n]
	k := ckey(bx, by, bz); h := dat(mp, k)
	if h >= 0 { nv.push(i); nn.push(mp.slots[h].val); mp.slots[h].val = nv.len - 1 } else { insert(mp, k, nv.len); nv.push(i); nn.push(-1) }
	-1
weld_verts(src const float3[:], ix const int[:], tol f32, dv float3[>..]&, di int[>..]&):
	mp ~= dictionary<u64, int>{..}; nv int[>..] ~= []; nn int[>..] ~= []; vm int[>..] ~= []
	for i src.len:
		d := find_dup(src, i, 2.0 * tol, tol, mp, nv, nn)
		if d < 0 { vm.push(dv.len); dv.push(src[i]) } else { vm.push(vm[d]) }
	for i ix: di.push(vm[i])
split_sah(p Prim[>..]&, lo int, n int) Split:
	s ~= Split{EMPTY_BOX, EMPTY_BOX, -1, -1}; b ~= AABB{p[lo].c, p[lo].c}; bb ~= -1; bc ~= FLT_MAX
	for i 1..n: b = box_add(b, p[lo + i].c)
	for ax 3:
		if vget(box_ext(b), ax) < slop(): continue
		bk AABB[>..] ~= [EMPTY_BOX; 8]; bn int[>..] ~= [0; 8]; f := 8.0 * (1.0 - FLT_EPS) / (vget(b.upper, ax) - vget(b.lower, ax))
		for i n: c := p[lo + i]; k := (f * (vget(c.c, ax) - vget(b.lower, ax))) as int; bn[k] += 1; bk[k] = box_union(bk[k], c.b)
		for i 7:
			lc ~= 0; lb ~= EMPTY_BOX; rc ~= 0; rb ~= EMPTY_BOX; j := i + 1
			for k j: lc += bn[k]; lb = box_union(lb, bk[k])
			for k j..8: rc += bn[k]; rb = box_union(rb, bk[k])
			if lc > 0 && rc > 0:
				cs := (lc as f32) * box_area(lb) + (rc as f32) * box_area(rb)
				if cs < bc: bb = i; bc = cs; s = Split{lb, rb, ax, lc}
	if bb >= 0:
		ax := s.ax; f := 8.0 * (1.0 - FLT_EPS) / (vget(b.upper, ax) - vget(b.lower, ax)); si ~= 0
		for i n: if (f * (vget(p[lo + i].c, ax) - vget(b.lower, ax))) as int <= bb { t := p[lo + i]; p[lo + i] = p[lo + si]; p[lo + si] = t; si += 1 }
	s
split_half(p Prim[>..]&, lo int, n int) Split:
	h := n / 2; l ~= EMPTY_BOX; r ~= EMPTY_BOX
	for i h: l = box_union(l, p[lo + i].b)
	for i h..n: r = box_union(r, p[lo + i].b)
	Split{l, r, major_axis(box_ext(box_union(l, r))), h}
split_median(p Prim[>..]&, lo int, n int) Split:
	a ~= p[lo].c; b ~= a
	for i 1..n: a = vmin(a, p[lo + i].c); b = vmax(b, p[lo + i].c)
	d := b - a; ax := if d.x >= d.y && d.x >= d.z { 0 } else if d.y >= d.z { 1 } else { 2 }; pv := vget(sv(0.5, a + b), ax); i1 ~= 0; i2 ~= n
	while i1 < i2:
		while i1 < i2 && vget(p[lo + i1].c, ax) < pv: i1 += 1
		while i1 < i2 && vget(p[lo + i2 - 1].c, ax) >= pv: i2 -= 1
		if i1 < i2: t := p[lo + i1]; p[lo + i1] = p[lo + i2 - 1]; p[lo + i2 - 1] = t; i1 += 1; i2 -= 1
	if i1 == 0 || i1 == n - 1: i1 = n / 2
	l ~= EMPTY_BOX; r ~= EMPTY_BOX
	for i i1: l = box_union(l, p[lo + i].b)
	for i i1..n: r = box_union(r, p[lo + i].b)
	Split{l, r, ax, i1}
leaf_of(nd MNode[>..]&, p Prim[>..]&, lo int, n int) int:
	bx ~= EMPTY_BOX
	for i n: bx = box_union(bx, p[lo + i].b)
	nd.push(MNode{bx.lower, bx.upper, 3, 0, n, lo}); nd.len - 1
recursive build_bvh(nd MNode[>..]&, p Prim[>..]&, lo int, n int, med bool, h int&) int:
	if n <= 4: h = 1; return leaf_of(nd, p, lo, n)
	s ~= if med { split_median(p, lo, n) } else { split_sah(p, lo, n) }
	if s.ax < 0:
		if n <= 8: return leaf_of(nd, p, lo, n)
		s = split_half(p, lo, n)
	ix := nd.len; nd.push(MNode{..}); hl ~= 0; hr ~= 0; build_bvh(nd, p, lo, s.ix, med, hl); ri := build_bvh(nd, p, lo + s.ix, n - s.ix, med, hr); h = max(hl, hr) + 1; bx := box_union(s.l, s.r)
	nd[ix] = MNode{bx.lower, bx.upper, s.ax, ri - ix, 0, 0}; ix
sort_tris(m MeshD&) bool:
	nt MTri[>..] ~= []; nm byte[>..] ~= []; off ~= 0; st int[>..] ~= [0]
	while st.len > 0:
		i := st.pop(); nd := m.nodes[i]
		if nd.ax != 3:
			if st.len >= 254: return false
			st.push(i + nd.ch); st.push(i + 1)
		else:
			for k nd.tc: nt.push(m.t[nd.to + k]); nm.push(m.mat[nd.to + k])
			m.nodes[i].to = off; off += nd.tc
	m.t = nt; m.mat = nm; true
ident_edges(m MeshD&):
	es MEdge[>..] ~= []; ns float3[>..] ~= []; mp ~= dictionary<u64, int>{..}
	for i m.t.len:
		t := m.t[i]; v1 := m.v[t.i1]; ns.push(nrm(cross(m.v[t.i2] - v1, m.v[t.i3] - v1)))
		es.push(MEdge{min(t.i1, t.i2), max(t.i1, t.i2), i, -1, 1, 0, 255}); es.push(MEdge{min(t.i2, t.i3), max(t.i2, t.i3), i, -1, 1, 1, 255}); es.push(MEdge{min(t.i3, t.i1), max(t.i3, t.i1), i, -1, 1, 2, 255})
	for i es.len:
		e := es[i]; k := ((e.v1 as! u64) << 32) | (e.v2 as! u64); h := dat(mp, k)
		if h < 0 { insert(mp, k, i) } else { o := mp.slots[h].val; if es[o].n == 1 { es[o].t2 = e.t1; es[o].e2 = e.e1 } es[o].n += 1 }
	for e es:
		if e.n == 2:
			t2 := m.t[e.t2]; t1 := m.t[e.t1]; op := if e.e2 == 0 { t2.i3 } else if e.e2 == 1 { t2.i1 } else { t2.i2 }
			vol := signed_vol(m.v[t1.i1], m.v[t1.i2], m.v[t1.i3], m.v[op]); ca := dot(ns[e.t1], ns[e.t2])
			if vol > 0.0 || ca > 0.9962: m.fl[e.t1] = m.fl[e.t1] | (1 << e.e1) as byte; m.fl[e.t2] = m.fl[e.t2] | (1 << e.e2) as byte
			if vol < 0.0 || ca > 0.9962: m.fl[e.t1] = m.fl[e.t1] | (16 << e.e1) as byte; m.fl[e.t2] = m.fl[e.t2] | (16 << e.e2) as byte
hv3(r u64, v float3) u64: hmix(hmix(hmix(r, binary::f32_bits(v.x) as u64), binary::f32_bits(v.y) as u64), binary::f32_bits(v.z) as u64)
mesh_hash(m MeshD&) u64:
	r ~= 0xCBF29CE484222325 as u64
	for n m.nodes: r = hmix(hmix(hmix(hmix(hv3(hv3(r, n.lo), n.hi), n.ax as! u64), n.ch as! u64), n.tc as! u64), n.to as! u64)
	for v m.v: r = hv3(r, v)
	for i m.t.len: t := m.t[i]; r = hmix(hmix(hmix(hmix(hmix(r, t.i1 as! u64), t.i2 as! u64), t.i3 as! u64), m.mat[i] as u64), m.fl[i] as u64)
	if r == 0 { 1 } else { r }
create_mesh(vs const float3[:], ix const int[:], mats const byte[:], weld bool, wtol f32, med bool, edges bool, cw bool) MeshD, bool:
	m ~= MeshD{[], [], [], [], []}; tc := ix.len / 3
	if vs.len < 3 || tc <= 0: return m, false
	v float3[>..] ~= []; id int[>..] ~= []
	if weld && wtol > 0.0 { weld_verts(vs, ix, wtol, v, id) } else { v.append(vs); for i 3 * tc { id.push(ix[i]) } }
	p Prim[>..] ~= []; dg ~= 0; ma := 0.01 * slop() * slop(); ar ~= 0.0 as f32; mc ~= 1; bd ~= EMPTY_BOX
	for i tc:
		a := id[3 * i]; b := id[3 * i + 1]; c := id[3 * i + 2]; v1 := v[a]; v2 := v[b]; v3 := v[c]; area := 0.5 * vlen(cross(v2 - v1, v3 - v1))
		if area < ma:
			if a != b && a != c && b != c: dg += 1
			continue
		ar += area; bx := AABB{vmin(v1, vmin(v2, v3)), vmax(v1, vmax(v2, v3))}; p.push(Prim{bx, box_center(bx), i}); bd = box_union(bd, bx)
		if mats.len > 0: mc = max(mc, mats[i] as int + 1)
	if !box_sane(bd): return m, false
	ht ~= 0; build_bvh(m.nodes, p, 0, p.len, med, ht); m.v = v; m.bounds = bd; m.area = ar; m.height = ht; m.degen = dg; m.mcount = mc
	for q p:
		k := 3 * q.ti; m.t.push(if cw { MTri{id[k], id[k + 2], id[k + 1]} } else { MTri{id[k], id[k + 1], id[k + 2]} }); m.fl.push(0 as byte); m.mat.push(if mats.len > 0 { mats[q.ti] } else { 0 as byte })
	if !sort_tris(m): return m, false
	if edges: ident_edges(m)
	m.hash = mesh_hash(m); return m, true
grid_idx(xc int, zc int) int[>..]:
	ix int[>..] ~= []
	for i xc:
		for j zc: a := j + (zc + 1) * i; c := a + 1 + (zc + 1); ix.push(a); ix.push(a + 1); ix.push(c); ix.push(c); ix.push(c - 1); ix.push(a)
	ix
grid_mesh(xc int, zc int, w f32, mc int, edges bool) MeshD, bool:
	vs float3[>..] ~= []; x ~= -0.5 * (w * xc as f32); ms byte[>..] ~= []
	for i xc + 1:
		z ~= -0.5 * (w * zc as f32)
		for j zc + 1: vs.push(float3{x, 0.0, z}); z += w
		x += w
	if mc > 0: for k xc * zc { ms.push((k % mc) as byte); ms.push((k % mc) as byte) }
	ix := grid_idx(xc, zc); create_mesh(vs[..], ix[..], ms[..], false, 0.0, true, edges, false)
wave_mesh(xc int, zc int, w f32, amp f32, rf f32, cf f32) MeshD, bool:
	vs float3[>..] ~= []; oz := 2.0 * PI * rf * w; ox := 2.0 * PI * cf * w; x ~= -0.5 * (w * xc as f32)
	for i xc + 1:
		rh := cos_sin(ox * i as f32).y; z ~= -0.5 * (w * zc as f32)
		for j zc + 1: vs.push(float3{x, amp * rh * cos_sin(oz * j as f32).y, z}); z += w
		x += w
	ix := grid_idx(xc, zc); create_mesh(vs[..], ix[..], [], false, 0.0, true, true, false)
torus_mesh(rr int, tr int, rad f32, th f32) MeshD, bool:
	vs float3[>..] ~= []; ix int[>..] ~= []
	for i rr:
		for j tr: u := (j as f32) / (tr as f32) * TWO_PI; v := (i as f32) / (rr as f32) * TWO_PI; cv := cos_sin(v); cu := cos_sin(u); vs.push(float3{(rad + th * cv.x) * cu.x, (rad + th * cv.x) * cu.y, th * cv.y})
	for i rr:
		i2 := (i + 1) % rr
		for j tr: j2 := (j + 1) % tr; a := i * tr + j; b := i * tr + j2; c := i2 * tr + j2; d := i2 * tr + j; ix.push(a); ix.push(b); ix.push(c); ix.push(c); ix.push(d); ix.push(a)
	create_mesh(vs[..], ix[..], [], false, 0.0, false, true, false)
BOX_IX := [0, 1, 3, 1, 2, 3, 0, 4, 1, 1, 4, 5, 0, 3, 7, 4, 0, 7, 4, 7, 5, 6, 5, 7, 1, 5, 2, 6, 2, 5, 3, 2, 7, 6, 7, 2]
HBOX_IX := [3, 1, 0, 3, 2, 1, 1, 4, 0, 5, 4, 1, 7, 3, 0, 7, 0, 4, 5, 7, 4, 7, 5, 6, 2, 5, 1, 5, 2, 6, 7, 2, 3, 2, 7, 6]
box_verts(c float3, t float3, b float3) float3[>..]: [float3{t.x, t.y, t.z} + c, float3{-t.x, t.y, t.z} + c, float3{-b.x, -b.y, b.z} + c, float3{b.x, -b.y, b.z} + c, float3{t.x, t.y, -t.z} + c, float3{-t.x, t.y, -t.z} + c, float3{-b.x, -b.y, -b.z} + c, float3{b.x, -b.y, -b.z} + c]
box_mesh(c float3, e float3, edges bool) MeshD, bool: vs := box_verts(c, e, e); create_mesh(vs[..], BOX_IX[..], [], false, 0.0, false, edges, false)
hollow_box_mesh(c float3, e float3) MeshD, bool: vs := box_verts(c, e, e); create_mesh(vs[..], HBOX_IX[..], [], false, 0.0, false, true, false)
platform_mesh(c float3, h f32, tw f32, bw f32) MeshD, bool: hb := 0.5 * bw; ht := 0.5 * tw; hy := 0.5 * h; vs := box_verts(c, float3{ht, hy, ht}, float3{hb, hy, hb}); create_mesh(vs[..], BOX_IX[..], [], false, 0.0, true, true, false)
le0(v float3) bool: v.x <= 0.0 && v.y <= 0.0 && v.z <= 0.0
gt0(v float3) bool: v.x > 0.0 || v.y > 0.0 || v.z > 0.0
vmul(a float3, b float3) float3: float3{a.x * b.x, a.y * b.y, a.z * b.z}
vinv(a float3) float3: float3{1.0 / a.x, 1.0 / a.y, 1.0 / a.z}
bovl(a float3, b float3, c float3, d float3) bool: le0(vmax(c - b, a - d))
bray(lo float3, hi float3, rs float3, rd float3) bool: c := sv(0.5, lo + hi); le0(vabs(cross(rd, rs - c)) - mcross(vabs(rd), hi - c))
btri(c float3, e float3, v1 float3, v2 float3, v3 float3) bool:
	a := v1 - c; b := v2 - c; d := v3 - c
	if gt0(vmax(vmin(a, vmin(b, d)) - e, V0 - (vmax(a, vmax(b, d)) + e))): return false
	e1 := b - a; e2 := d - b; e3 := a - d; n := cross(e1, e2)
	if fabs(dot(n, a)) - dot(vabs(n), e) > 0.0: return false
	if gt0(vabs(cross(e1, a + d)) - vabs(cross(e1, e3)) - sv(2.0, mcross(vabs(e1), e))): return false
	if gt0(vabs(cross(e2, a + b)) - vabs(cross(e2, e1)) - sv(2.0, mcross(vabs(e2), e))): return false
	!gt0(vabs(cross(e3, b + d)) - vabs(cross(e3, e2)) - sv(2.0, mcross(vabs(e3), e)))
ray_tri(rs float3, rd float3, v1 float3, v2 float3, v3 float3) f32:
	if dot(cross(v3 - v2, sv(0.5, v2 + v3) - rs), rd) < 0.0 || dot(cross(v1 - v3, sv(0.5, v3 + v1) - rs), rd) < 0.0 || dot(cross(v2 - v1, sv(0.5, v1 + v2) - rs), rd) < 0.0: return 1.0
	n := cross(v2 - v1, v3 - v1); dn := dot(n, rd)
	if !(dn < 0.0): return 1.0
	l := dot(n, v1 - rs) / dn
	if l <= 0.0: return 1.0
	if l < 1.0 { l } else { 1.0 }
scaled_tri(m MeshD&, sc float3, t MTri, ccw bool) float3[3]: [vmul(sc, m.v[t.i1]), vmul(sc, if ccw { m.v[t.i2] } else { m.v[t.i3] }), vmul(sc, if ccw { m.v[t.i3] } else { m.v[t.i2] })]
proxy_box(px Proxy) AABB:
	a ~= px.pts[0]; b ~= a
	for i 1..px.pts.len: a = vmin(a, px.pts[i]); b = vmax(b, px.pts[i])
	r := float3{px.r, px.r, px.r}; AABB{a - r, b + r}
local_pts(px Proxy, xf Transform) float3[>..]:
	iv := xinv(xf); r := qmat(iv.q); o float3[>..] ~= []
	for p px.pts: o.push(mv(r, p) + iv.p)
	o
inv_box(sc float3, lo float3, hi float3) AABB: is := vinv(sc); t1 := vmul(is, lo); t2 := vmul(is, hi); AABB{vmin(t1, t2), vmax(t1, t2)}
mesh_box(m MeshD&, xf Transform, sc float3) AABB: lo := vmul(sc, m.bounds.lower); hi := vmul(sc, m.bounds.upper); box_xform(xf, AABB{vmin(lo, hi), vmax(lo, hi)})
overlap_mesh(m MeshD&, sc float3, xf Transform, px Proxy) bool:
	lp := local_pts(px, xf); l := Proxy{lp[..], px.r}; ib := inv_box(sc, proxy_box(l).lower, proxy_box(l).upper); bc := sv(0.5, ib.lower + ib.upper); be := ib.upper - bc; st int[>..] ~= []; ni ~= 0
	loop:
		nd := m.nodes[ni]
		if bovl(nd.lo, nd.hi, ib.lower, ib.upper):
			if nd.ax != 3: st.push(ni + nd.ch); ni += 1; continue
			for k nd.tc:
				t := m.t[nd.to + k]; v1 := m.v[t.i1]; v2 := m.v[t.i2]; v3 := m.v[t.i3]
				if btri(bc, be, v1, v2, v3):
					tv := [vmul(sc, v1), vmul(sc, v2), vmul(sc, v3)]; c ~= SCache{..}
					if shape_distance(Proxy{tv[..], 0.0}, l, XI, true, c).d < 0.1 * slop(): return true
		if st.len == 0: break
		ni = st.pop()
	false
ray_mesh(m MeshD&, sc float3, org float3, tr float3, maxf f32) CastOut:
	o ~= NOCAST; o.frac = maxf; o.tri = -1; is := vinv(sc); ccw := sc.x * sc.y * sc.z > 0.0; irs := vmul(is, org); ird := vmul(is, tr); ire ~= irs + sv(maxf, ird); mn ~= vmin(irs, ire); mx ~= vmax(irs, ire); st int[>..] ~= []; ni ~= 0
	loop:
		nd := m.nodes[ni]
		if bovl(nd.lo, nd.hi, mn, mx) && bray(nd.lo, nd.hi, irs, ird):
			if nd.ax != 3:
				if vget(ird, nd.ax) > 0.0 { st.push(ni + nd.ch); ni += 1 } else { st.push(ni + 1); ni += nd.ch }
				continue
			for k nd.tc:
				ti := nd.to + k; v := scaled_tri(m, sc, m.t[ti], ccw); a := ray_tri(org, tr, v[0], v[1], v[2])
				if a < o.frac: o.n = nrm(cross(v[1] - v[0], v[2] - v[0])); o.p = org + sv(a, tr); o.frac = a; o.tri = ti; o.mat = m.mat[ti] as int; o.hit = true; ire = irs + sv(a, ird); mn = vmin(irs, ire); mx = vmax(irs, ire)
		if st.len == 0: break
		ni = st.pop()
	o
cast_mesh(m MeshD&, sc float3, px Proxy, tr float3, maxf f32, enc bool) CastOut:
	o ~= NOCAST; o.frac = maxf; o.tri = -1; sb := proxy_box(px); c := box_center(sb); ex := box_ext(sb); re ~= c + sv(maxf, tr); rmn ~= vmin(c, re); rmx ~= vmax(c, re)
	is := vinv(sc); ccw := sc.x * sc.y * sc.z > 0.0; irs := vmul(is, c); ird := vmul(is, tr); ire ~= irs + sv(maxf, ird); mn ~= vmin(irs, ire); mx ~= vmax(irs, ire); ise := vmul(vabs(is), ex); st int[>..] ~= []; ni ~= 0
	loop:
		nd := m.nodes[ni]; lo := nd.lo - ise; hi := nd.hi + ise
		if bovl(lo, hi, mn, mx) && bray(lo, hi, irs, ird):
			if nd.ax != 3:
				if vget(ird, nd.ax) > 0.0 { st.push(ni + nd.ch); ni += 1 } else { st.push(ni + 1); ni += nd.ch }
				continue
