hf_mat(f HField&, ti int) int: f.mat[ti >> 1] as int
hf_box(f HField&, xf Transform) AABB: box_xform(xf, f.aabb)
hf_cell(f HField&, r int, c int) bool: r >= 0 && r < f.rows - 1 && c >= 0 && c < f.cols - 1 && f.mat[r * (f.cols - 1) + c] as int != HF_HOLE
ray_hf(f HField&, org float3, tr float3, maxf f32) CastOut: p := [org]; cast_hf(f, Proxy{p[..], 0.0}, tr, maxf, false)
cast_hf(f HField&, px Proxy, tr float3, maxf f32, enc bool) CastOut:
	sb := proxy_box(px); sc := f.sc; ss := box_center(sb); sd := sv(maxf, tr); o ~= NOCAST; ex := box_ext(sb); mg := aabb_margin(); m3 := float3{mg, mg, mg}; mnf ~= 0.0 as f32; mxf ~= 0.0 as f32
	if !ray_box(AABB{f.aabb.lower - ex - m3, f.aabb.upper + ex + m3}, ss, ss + sd, mnf, mxf): return o
	cs ~= madd(ss, mnf, sd); cd := sv(mxf - mnf, sd); c0 := cs; c1 := cs + cd; sx := if tr.x >= 0.0 { 1.0 } else { -1.0 }; sz := if tr.z >= 0.0 { 1.0 } else { -1.0 }
	cs.x = if tr.x >= 0.0 { cs.x + ex.x } else { cs.x - ex.x }; cs.z = if tr.z >= 0.0 { cs.z + ex.z } else { cs.z - ex.z }; ce := cs + cd
	ca := ffloor(cs.x / sc.x) as int; cb := ffloor(ce.x / sc.x) as int; ra := ffloor(cs.z / sc.z) as int; rb := ffloor(ce.z / sc.z) as int; ad := vabs(cd)
	dax := if ca != cb { sc.x / ad.x } else { 0.0 }; nfx ~= if ca < cb { (sc.x * (ca + 1) as f32 - cs.x) / ad.x } else if cb < ca { (cs.x - sc.x * ca as f32) / ad.x } else { FLT_MAX }; dc := if ca < cb { 1 } else if cb < ca { -1 } else { 0 }
	daz := if ra != rb { sc.z / ad.z } else { 0.0 }; nfz ~= if ra < rb { (sc.z * (ra + 1) as f32 - cs.z) / ad.z } else if rb < ra { (cs.z - sc.z * ra as f32) / ad.z } else { FLT_MAX }; dr := if ra < rb { 1 } else if rb < ra { -1 } else { 0 }
	ch ~= ca; rh ~= ra; ct ~= ffloor((cs.x - 2.0 * sx * ex.x) / sc.x) as int; rt ~= ffloor((cs.z - 2.0 * sz * ex.z) / sc.z) as int; bf ~= maxf; gs := maxf * (mxf - mnf); go := maxf * mnf
	cbx := AABB{vmin(c0, c1) - ex, vmax(c0, c1) + ex}; ray := px.pts.len == 1 && px.r == 0.0
	loop:
		r1 := min(rt, rh); r2 := max(rt, rh) + 1; k1 := min(ct, ch); k2 := max(ct, ch) + 1
		for r r1..r2:
			for c k1..k2:
				if !hf_cell(f, r, c): continue
				k := hf_corners(f, r, c); p11 := k[0]; p12 := if f.cw { k[2] } else { k[1] }; p21 := if f.cw { k[1] } else { k[2] }; p22 := k[3]
				if !box_overlap(cbx, AABB{vmin(vmin(p11, p12), vmin(p21, p22)), vmax(vmax(p11, p12), vmax(p21, p22))}): continue
				q := r * (f.cols - 1) + c; mt := f.mat[q] as int; ts := [[p11, p21, p12], [p22, p12, p21]]; cs3 := [[p11, p21, p12], [p21, p22, p12]]
				for j 2:
					a := cs3[j][0]; b := cs3[j][1]; d := cs3[j][2]
