destroy_contact(w World&, cid int, wake bool):
	remove(w.bp.pairs, pair_key(w.contacts[cid].sa, w.contacts[cid].sb, w.contacts[cid].child)); w.contacts[cid].mans.clear()
	ea := w.contacts[cid].ed[0]; eb := w.contacts[cid].ed[1]; ba := ea.bid; bb := eb.bid; fl := w.contacts[cid].flags; touching := fl & CF_TOUCHING != 0
