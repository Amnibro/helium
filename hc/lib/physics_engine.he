		ti := w.contacts[cid].tcache[ix].tri; tr := mesh_tri_of(va, ti)
		v0 := mv(rm, tr.v1) + x.p; v1 := mv(rm, tr.v2) + x.p; v2 := mv(rm, tr.v3) + x.p; vs := [v0, v1, v2]
		m ~= LM{..}; m.tflags = tr.flags; m.feat = F_NONE; pc := cap - tot
		if vb.ty == SH_CAPSULE { collide_tri_capsule(m, pc, vs[..], vb.cap, w.contacts[cid].tcache[ix].sc) } else if vb.ty == SH_HULL { if fast && w.contacts[cid].tcache[ix].sat.ty == AX_EDGE { w.contacts[cid].tcache[ix].sat = SAT{} }; collide_tri_hull(m, pc, v0, v1, v2, tr.flags, vhull(w, vb), w.contacts[cid].tcache[ix].sat, spec); w.sat_calls += 1; w.sat_hits += w.contacts[cid].tcache[ix].sat.hit } else if vb.ty == SH_SPHERE { collide_tri_sphere(m, pc, vs[..], vb.sph) } else { return false }
		if m.count > 0:
			tot += m.count; m.tri = ti; m.tn = normal_pts(v0, v1, v2); m.i1 = tr.i1; m.i2 = tr.i2; m.i3 = tr.i3; mi := ms.len; ms.push(m)
			acc_it ~= m.feat == F_TRI
			if !acc_it && m.feat == F_HULL:
				if dot(m.tn, m.n) > 0.5 { acc_it = true } else { mn ~= m.pts[0].s; for i 1..m.count { mn = fmin(mn, m.pts[i].s) }; acc_it = mn < -2.0 * sl }
			if acc_it { add_key(fe, tr.i1, tr.i2); add_key(fe, tr.i2, tr.i3); add_key(fe, tr.i3, tr.i1); add_vert(fv, tr.i1); add_vert(fv, tr.i2); add_vert(fv, tr.i3); acc.push(mi) } else { tt.push(TT{m.d2, tent.len}); tent.push(mi) }
		ix += 1
