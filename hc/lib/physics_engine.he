	MTriV{a, vmul(sc, m.v[t.i2]), vmul(sc, m.v[t.i3]), t.i1, t.i2, t.i3, f}
mover_mesh(res PlaneRes[>..]&, cap int, m MeshD&, sc float3, mv Capsule) int:
	if cap == 0: return 0
