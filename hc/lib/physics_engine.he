		if ub: qa := qmul(s1.dq, j.fra.q); rq := qimul(qa, qmul(s2.dq, j.frb.q)); b = sv(j.cs.bias, -rot(qa, delta_quat_rot(rq, QI))); msc = j.cs.ms; isc = j.cs.is
		im := sv(-msc, mv(p.rm, (wb - wa) + b)) - sv(isc, p.ai); p.ai = p.ai + im; wa = wa - mv(ia, im); wb = wb + mv(ib, im)
	py := rot(s1.dq, p.py); pz := rot(s1.dq, p.pz)
	bx := if ub { j.cs.bias * dot(py, d) } else { 0.0 }; by := if ub { j.cs.bias * dot(pz, d) } else { 0.0 }; msc := if ub { j.cs.ms } else { 1.0 }; isc := if ub { j.cs.is } else { 0.0 }
	vr := ((vb + cross(wb, rb)) - va) - cross(wa, rd); say := cross(rd, py); sby := cross(rb, py); saz := cross(rd, pz); sbz := cross(rb, pz)
	kyy := ma + mb + dot(say, mv(ia, say)) + dot(sby, mv(ib, sby)); kyz := dot(say, mv(ia, saz)) + dot(sby, mv(ib, sbz)); kzz := ma + mb + dot(saz, mv(ia, saz)) + dot(sbz, mv(ib, sbz))
	oi := p.pi; sol := solve2(M2{float2{kyy, kyz}, float2{kyz, kzz}}, float2{dot(py, vr) + bx, dot(pz, vr) + by})
	dx := -msc * sol.x - isc * oi.x; dy := -msc * sol.y - isc * oi.y; p.pi = float2{oi.x + dx, oi.y + dy}; pp := blend2(dx, py, dy, pz)
	va = msub(va, ma, pp); wa = wa - mv(ia, blend2(dx, say, dy, saz)); vb = madd(vb, mb, pp); wb = wb + mv(ib, blend2(dx, sby, dy, sbz))
	jput(w, j.xa, s1.flags, va, wa); jput(w, j.xb, s2.flags, vb, wb)
struct JSph { li float3 = V0, si float3 = V0, mi float3 = V0, lti f32 = 0.0, uti f32 = 0.0, swi f32 = 0.0, hz f32 = 0.0, dr f32 = 0.0, mmt f32 = 0.0, mvel float3 = V0, lta f32 = 0.0, uta f32 = 0.0, cone f32 = 0.0, tq Quat = QI, sax float3 = V0, tj float3 = V0, rm Mat3 = M0, swm f32 = 0.0, twm f32 = 0.0, ss Soft = Soft{}, spring bool = false, motor bool = false, cl bool = false, tl bool = false }
struct JWheel { li float2 = float2{0.0, 0.0}, ai float2 = float2{0.0, 0.0}, spi f32 = 0.0, mst f32 = 0.0, sps f32 = 0.0, ssi f32 = 0.0, lsi f32 = 0.0, usi f32 = 0.0, lsl f32 = 0.0, usl f32 = 0.0, shz f32 = 0.0, sdr f32 = 0.0, sti f32 = 0.0, lsti f32 = 0.0, usti f32 = 0.0, lstl f32 = 0.0, ustl f32 = 0.0, tsa f32 = 0.0, mstt f32 = 0.0, sthz f32 = 0.0, stdr f32 = 0.0, spm f32 = 0.0, susm f32 = 0.0, stm f32 = 0.0, sus Soft = Soft{}, sts Soft = Soft{}, spin bool = false, sspring bool = false, slimit bool = false, steer bool = false, stlimit bool = false, stmotor bool = false }
prep_sph(w World&, j JointSim&):
	p := &j.sp; is := madd3(j.ia, j.ib); ca := rot(j.fra.q, AX_Z); ta := rot(j.frb.q, AX_Z)
	if p.cl: sa := nrm(cross(ca, ta)); k := dot(sa, mv(is, sa)); p.swm = if k > 0.0 { 1.0 / k } else { 0.0 }; p.sax = sa
	if p.tl:
		rq := qimul(j.fra.q, j.frb.q); t2 := fsqrt((rq.x * rq.x + rq.y * rq.y) / (rq.z * rq.z + rq.w * rq.w)); sa := nrm(cross(ca, ta))
		tj := madd(ca, t2, cross(sa, ca)); k := dot(tj, mv(is, tj)); p.twm = if k > 0.0 { 1.0 / k } else { 0.0 }; p.tj = tj
	p.rm = if !j.fixed { minv(is) } else { M0 }; p.ss = make_soft(p.hz, p.dr, w.ctx.h)
	if !w.ctx.warm: p.li = V0; p.mi = V0; p.si = V0; p.swi = 0.0; p.lti = 0.0; p.uti = 0.0
warm_sph(w World&, j JointSim&):
	p := &j.sp; s1 := jst(w, j.xa); s2 := jst(w, j.xb); ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p)
	ai := madd(msub(p.si + p.mi, p.swi, p.sax), p.lti - p.uti, p.tj)
	jput(w, j.xa, s1.flags, msub(s1.v, j.ma, p.li), s1.w - mv(j.ia, cross(ra, p.li) + ai)); jput(w, j.xb, s2.flags, madd(s2.v, j.mb, p.li), s2.w + mv(j.ib, cross(rb, p.li) + ai))
solve_sph(w World&, j JointSim&, ub bool):
	p := &j.sp; s1 := jst(w, j.xa); s2 := jst(w, j.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w; ma := j.ma; mb := j.mb; ia := j.ia; ib := j.ib
	qa := qmul(s1.dq, j.fra.q); qb := qmul(s2.dq, j.frb.q); rq := qimul(qa, qb)
	if p.spring && !j.fixed:
		b := sv(p.ss.bias, -rot(qa, delta_quat_rot(rq, p.tq))); im := msub(sv(-p.ss.ms, mv(p.rm, (wb - wa) + b)), p.ss.is, p.si); p.si = p.si + im
		wa = wa - mv(ia, im); wb = wb + mv(ib, im)
	if p.motor && !j.fixed:
		lm := -mv(p.rm, (wb - wa) - p.mvel); ni ~= p.mi + lm; ln := vlen(ni); mx := p.mmt * w.ctx.h
		if ln > mx: ni = sv(mx / ln, ni)
		d := ni - p.mi; p.mi = ni; wa = wa - mv(ia, d); wb = wb + mv(ib, d)
	if p.tl && !j.fixed:
		an := twist_angle_q(rq); tj := p.tj; k := lim_coef(an - p.lta, ub, j.cs, w.ctx.inv_h); oi := p.lti
		di := -k.y * p.twm * (dot(wb - wa, tj) + k.x) - k.z * oi; p.lti = fmax(oi + di, 0.0); d1 := p.lti - oi
		wa = msub(wa, d1, mv(ia, tj)); wb = madd(wb, d1, mv(ib, tj))
		k2 := lim_coef(p.uta - an, ub, j.cs, w.ctx.inv_h); oi2 := p.uti
		di2 := -k2.y * p.twm * (dot(wa - wb, tj) + k2.x) - k2.z * oi2; p.uti = fmax(oi2 + di2, 0.0); d2 := p.uti - oi2
		wa = madd(wa, d2, mv(ia, tj)); wb = msub(wb, d2, mv(ib, tj))
	if p.cl && !j.fixed:
		sa := p.sax; k := lim_coef(p.cone - swing_angle_q(rq), ub, j.cs, w.ctx.inv_h); oi := p.swi
		di := -k.y * p.swm * (dot(wa - wb, sa) + k.x) - k.z * oi; p.swi = fmax(oi + di, 0.0); d := p.swi - oi
		wa = madd(wa, d, mv(ia, sa)); wb = msub(wb, d, mv(ib, sa))
	ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p); cd := ((vb + cross(wb, rb)) - va) - cross(wa, ra)
	b := if ub { sv(j.cs.bias, ((s2.dp - s1.dp) + (rb - ra)) + j.dc) } else { V0 }; msc := if ub { j.cs.ms } else { 1.0 }; isc := if ub { j.cs.is } else { 0.0 }
	im := msub(sv(-msc, solve3(kmat(ma, mb, j.ia, j.ib, ra, rb), cd + b)), isc, p.li); p.li = p.li + im
	va = msub(va, ma, im); wa = wa - mv(ia, cross(ra, im)); vb = madd(vb, mb, im); wb = wb + mv(ib, cross(rb, im))
	jput(w, j.xa, s1.flags, va, wa); jput(w, j.xb, s2.flags, vb, wb)
steer_axis(a Mat3, b Mat3) float3:
	cs := dot(b.cz, a.cz); ss := -dot(b.cz, a.cy); dn := cs * cs + ss * ss; den := if dn > 0.0 { 1.0 / dn } else { 0.0 }
	sv(den, cross(b.cz, sv(-cs, a.cy) - sv(ss, a.cz)))
prep_wheel(w World&, j JointSim&):
	h := &j.wh; is := madd3(j.ia, j.ib); ra := j.fra.p; rb := j.frb.p; ma := qmat(j.fra.q); mb := qmat(j.frb.q)
	an := cross(ra, ma.cx); bn := cross(rb, ma.cx); k := j.ma + j.mb + dot(an, mv(j.ia, an)) + dot(bn, mv(j.ib, bn)); h.susm = if k > 0.0 { 1.0 / k } else { 0.0 }
	h.sus = make_soft(h.shz, h.sdr, w.ctx.h); h.sts = make_soft(h.sthz, h.stdr, w.ctx.h)
	k2 := dot(mb.cz, mv(is, mb.cz)); h.spm = if k2 > 0.0 { 1.0 / k2 } else { 0.0 }
	sa := steer_axis(ma, mb); k3 := dot(sa, mv(is, sa)); h.stm = if k3 > 0.0 { 1.0 / k3 } else { 0.0 }
	if !w.ctx.warm: h.li = float2{0.0, 0.0}; h.ai = float2{0.0, 0.0}; h.spi = 0.0; h.ssi = 0.0; h.lsi = 0.0; h.usi = 0.0; h.sti = 0.0; h.lsti = 0.0; h.usti = 0.0
warm_wheel(w World&, j JointSim&):
	h := &j.wh; s1 := jst(w, j.xa); s2 := jst(w, j.xb); ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p); d := ((s2.dp - s1.dp) + j.dc) + (rb - ra)
	qa := qmul(s1.dq, j.fra.q); qb0 := qmul(s2.dq, j.frb.q); qb := if qdot(qa, qb0) < 0.0 { qneg(qb0) } else { qb0 }; ma := qmat(qa); mb := qmat(qb); dr := d + ra
	si := h.ssi + h.lsi - h.usi; ly := h.li.x; lz := h.li.y
	li := blend3(si, ma.cx, ly, ma.cy, lz, ma.cz); aa := blend3(si, cross(dr, ma.cx), ly, cross(dr, ma.cy), lz, cross(dr, ma.cz)); ab := blend3(si, cross(rb, ma.cx), ly, cross(rb, ma.cy), lz, cross(rb, ma.cz))
	ai ~= sv(h.spi, ma.cz); spa := mb.cz
	if h.steer { ai = blend3(h.ai.x, cross(spa, ma.cx), h.spi, spa, h.sti + h.lsti - h.usti, steer_axis(ma, mb)) } else { rq := qimul(qa, qb); ai = ai + blend3(h.ai.x, half_axis(qa, rq, AX_X), h.ai.y, half_axis(qa, rq, AX_Y), h.spi, spa) }
	jput(w, j.xa, s1.flags, msub(s1.v, j.ma, li), s1.w - mv(j.ia, aa + ai)); jput(w, j.xb, s2.flags, madd(s2.v, j.mb, li), s2.w + mv(j.ib, ab + ai))
solve_wheel(w World&, j JointSim&, ub bool):
	h := &j.wh; s1 := jst(w, j.xa); s2 := jst(w, j.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w; m1 := j.ma; m2 := j.mb; ia := j.ia; ib := j.ib
	ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p); qa := qmul(s1.dq, j.fra.q); qb0 := qmul(s2.dq, j.frb.q); qb := if qdot(qa, qb0) < 0.0 { qneg(qb0) } else { qb0 }; rq := qimul(qa, qb)
	ma := qmat(qa); mb := qmat(qb); d := ((s2.dp - s1.dp) + j.dc) + (rb - ra); dr := d + ra
	sax := cross(dr, ma.cx); sbx := cross(rb, ma.cx); say := cross(dr, ma.cy); sby := cross(rb, ma.cy); saz := cross(dr, ma.cz); sbz := cross(rb, ma.cz)
	tr := dot(ma.cx, d); cs := dot(mb.cz, ma.cz); ss := -dot(mb.cz, ma.cy); st := steer_axis(ma, mb)
	if h.spin && !j.fixed:
		spa := mb.cz; im := -h.spm * (dot(wb - wa, spa) - h.sps); oi := h.spi; mx := w.ctx.h * h.mst; h.spi = fclamp(h.spi + im, -mx, mx); dd := h.spi - oi
		wa = wa - mv(ia, sv(dd, spa)); wb = wb + mv(ib, sv(dd, spa))
	if h.sspring:
		cd := dot(ma.cx, vb - va) + dot(sbx, wb) - dot(sax, wa); im := -h.sus.ms * h.susm * (cd + h.sus.bias * tr) - h.sus.is * h.ssi; h.ssi += im
		va = msub(va, m1, sv(im, ma.cx)); wa = wa - mv(ia, sv(im, sax)); vb = madd(vb, m2, sv(im, ma.cx)); wb = wb + mv(ib, sv(im, sbx))
	if h.steer && !j.fixed:
		sa := atan2f(ss, cs); oi := h.sti; im := -h.sts.ms * h.stm * (dot(st, wb - wa) + h.sts.bias * (sa - h.tsa)) - h.sts.is * oi; mx := w.ctx.h * h.mstt
		h.sti = fclamp(oi + im, -mx, mx); dd := h.sti - oi; wa = wa - mv(ia, sv(dd, st)); wb = wb + mv(ib, sv(dd, st))
		if h.stlimit:
			k := lim_coef(sa - h.lstl, ub, j.cs, w.ctx.inv_h); o1 := h.lsti; i1 := -k.y * h.stm * (dot(st, wb - wa) + k.x) - k.z * o1; h.lsti = fmax(o1 + i1, 0.0); d1 := h.lsti - o1
			wa = wa - mv(ia, sv(d1, st)); wb = wb + mv(ib, sv(d1, st))
			k2 := lim_coef(h.ustl - sa, ub, j.cs, w.ctx.inv_h); o2 := h.usti; i2 := -k2.y * h.stm * (dot(st, wa - wb) + k2.x) - k2.z * o2; h.usti = fmax(o2 + i2, 0.0); d2 := h.usti - o2
			wa = wa + mv(ia, sv(d2, st)); wb = wb - mv(ib, sv(d2, st))
	if h.slimit:
		k := lim_coef(tr - h.lsl, ub, j.cs, w.ctx.inv_h); cd := dot(ma.cx, vb - va) + dot(sbx, wb) - dot(sax, wa); i1 := -k.y * h.susm * (cd + k.x) - k.z * h.lsi; o1 := h.lsi
		h.lsi = fmax(o1 + i1, 0.0); d1 := h.lsi - o1
		va = msub(va, m1, sv(d1, ma.cx)); wa = wa - mv(ia, sv(d1, sax)); vb = madd(vb, m2, sv(d1, ma.cx)); wb = wb + mv(ib, sv(d1, sbx))
		k2 := lim_coef(h.usl - tr, ub, j.cs, w.ctx.inv_h); cd2 := dot(ma.cx, va - vb) + dot(sax, wa) - dot(sbx, wb); i2 := -k2.y * h.susm * (cd2 + k2.x) - k2.z * h.usi; o2 := h.usi
		h.usi = fmax(o2 + i2, 0.0); d2 := h.usi - o2
		va = madd(va, m1, sv(d2, ma.cx)); wa = wa + mv(ia, sv(d2, sax)); vb = msub(vb, m2, sv(d2, ma.cx)); wb = wb - mv(ib, sv(d2, sbx))
	if !j.fixed:
		if h.steer:
			b := if ub { j.cs.bias * dot(ma.cx, mb.cz) } else { 0.0 }; msc := if ub { j.cs.ms } else { 1.0 }; isc := if ub { j.cs.is } else { 0.0 }
			u := cross(mb.cz, ma.cx); k := dot(u, mv(madd3(ia, ib), u)); pm := if k > 0.0 { 1.0 / k } else { 0.0 }
			di := -msc * pm * (dot(wb - wa, u) + b) - isc * h.ai.x; h.ai.x += di; wa = msub(wa, di, mv(ia, u)); wb = madd(wb, di, mv(ib, u))
		else:
			bx := if ub { j.cs.bias * rq.x } else { 0.0 }; by := if ub { j.cs.bias * rq.y } else { 0.0 }; msc := if ub { j.cs.ms } else { 1.0 }; isc := if ub { j.cs.is } else { 0.0 }
			px := half_axis(qa, rq, AX_X); py := half_axis(qa, rq, AX_Y); is := madd3(ia, ib); kxx := dot(px, mv(is, px)); kyy := dot(py, mv(is, py)); kxy := dot(px, mv(is, py)); wr := wb - wa; oi := h.ai
			sol := solve2(M2{float2{kxx, kxy}, float2{kxy, kyy}}, float2{dot(wr, px) + bx, dot(wr, py) + by})
			dx := -msc * sol.x - isc * oi.x; dy := -msc * sol.y - isc * oi.y; h.ai = float2{oi.x + dx, oi.y + dy}; ai := blend2(dx, px, dy, py); wa = wa - mv(ia, ai); wb = wb + mv(ib, ai)
	py := ma.cy; pz := ma.cz; bx := if ub { j.cs.bias * dot(py, d) } else { 0.0 }; by := if ub { j.cs.bias * dot(pz, d) } else { 0.0 }; msc := if ub { j.cs.ms } else { 1.0 }; isc := if ub { j.cs.is } else { 0.0 }
	vr := ((vb + cross(wb, rb)) - va) - cross(wa, dr)
	kyy := m1 + m2 + dot(say, mv(ia, say)) + dot(sby, mv(ib, sby)); kyz := dot(say, mv(ia, saz)) + dot(sby, mv(ib, sbz)); kzz := m1 + m2 + dot(saz, mv(ia, saz)) + dot(sbz, mv(ib, sbz))
	oi := h.li; sol := solve2(M2{float2{kyy, kyz}, float2{kyz, kzz}}, float2{dot(py, vr) + bx, dot(pz, vr) + by})
	dx := -msc * sol.x - isc * oi.x; dy := -msc * sol.y - isc * oi.y; h.li = float2{oi.x + dx, oi.y + dy}; li := blend2(dx, py, dy, pz)
	va = msub(va, m1, li); wa = wa - mv(ia, blend2(dx, say, dy, saz)); vb = madd(vb, m2, li); wb = wb + mv(ib, blend2(dx, sby, dy, sbz))
	jput(w, j.xa, s1.flags, va, wa); jput(w, j.xb, s2.flags, vb, wb)
prepare_joint(w World&, j JointSim&):
	j.cs = make_soft(fmin(j.chz, 0.25 * w.ctx.inv_h), j.cdr, w.ctx.h)
	if j.ty == J_FILTER: return
	jbase(w, j); t := j.ty
	if t == J_PARALLEL { prep_par(w, j) } else if t == J_DISTANCE { prep_dist(w, j) } else if t == J_MOTOR { prep_motor(w, j) } else if t == J_PRISMATIC { prep_pris(w, j) } else if t == J_REVOLUTE { prep_rev(w, j) } else if t == J_SPHERICAL { prep_sph(w, j) } else if t == J_WELD { prep_weld(w, j) } else if t == J_WHEEL { prep_wheel(w, j) }
warm_joint(w World&, j JointSim&):
	t := j.ty
	if t == J_PARALLEL { warm_par(w, j) } else if t == J_DISTANCE { warm_dist(w, j) } else if t == J_MOTOR { warm_motor(w, j) } else if t == J_PRISMATIC { warm_pris(w, j) } else if t == J_REVOLUTE { warm_rev(w, j) } else if t == J_SPHERICAL { warm_sph(w, j) } else if t == J_WELD { warm_weld(w, j) } else if t == J_WHEEL { warm_wheel(w, j) }
solve_joint(w World&, j JointSim&, ub bool):
	t := j.ty
	if t == J_PARALLEL { solve_par(w, j) } else if t == J_DISTANCE { solve_dist(w, j, ub) } else if t == J_MOTOR { solve_motor(w, j) } else if t == J_PRISMATIC { solve_pris(w, j, ub) } else if t == J_REVOLUTE { solve_rev(w, j, ub) } else if t == J_SPHERICAL { solve_sph(w, j, ub) } else if t == J_WELD { solve_weld(w, j, ub) } else if t == J_WHEEL { solve_wheel(w, j, ub) }
struct GColor { bodies u64[>..], jsims JointSim[>..], convex int[>..], contacts CSpec[>..], cc CCon[>..], mc MCon[>..], wl Lane[>..] }
struct SSet { sims BSim[>..], states BState[>..], jsims JointSim[>..], cidx int[>..], isims int[>..], si int = -1 }
struct Cap5 { ss int = 0, ds int = 0, sb int = 0, db int = 0, c int = 0 }
struct MoveEv { xf Transform, bid int, gen int, ud u64, asleep bool }
struct ShapePair { sa int, ga int, sb int, gb int, cid int, cgen int }
struct HitEv { sa int, ga int, sb int, gb int, cid int, cgen int, p float3, n float3, speed f32, ma u64, mb u64 }
struct JointEv { jid int, gen int, ud u64 }
struct World { ctx Ctx = Ctx{}, bp BPhase, colors GColor[>..], bpool IdPool, bodies Body[>..], setpool IdPool, sets SSet[>..], jpool IdPool, joints Joint[>..], cpool IdPool, contacts Contact[>..], ipool IdPool, islands Island[>..], spool IdPool, shapes Shape[>..], ncpd int = 0, hulls HData[>..], hrc int[>..], sensors Sensor[>..], moves MoveEv[>..], sbegin ShapePair[>..], send0 ShapePair[>..], send1 ShapePair[>..], cbegin ShapePair[>..], cend0 ShapePair[>..], cend1 ShapePair[>..], endix int = 0, hits HitEv[>..], jevents JointEv[>..], step u64 = 0, split int = -1, gravity float3 = V0, hit_th f32 = 0.0, rest_th f32 = 0.0, max_speed f32 = 0.0, cspeed f32 = 0.0, chz f32 = 0.0, cdr f32 = 0.0, crecycle f32 = 0.0, fmix int = 0, rmix int = 0, gen int = 0, sat_calls int = 0, sat_hits int = 0, mcounts int[8], maxcap Cap5 = Cap5{}, workers int = 1, inv_h f32 = 0.0, inv_dt f32 = 0.0, wid int = 0, sleep bool = true, locked bool = false, warm bool = true, continuous bool = true, speculative bool = true, in_use bool = false, ud u64 = 0, recycled int = 0, ctx_bits u64[>..], jstate_bits u64[>..], hit_bits u64[>..], awake_isl u64[>..], split_sleep f32 = 0.0, split_cand int = -1, cont_hits Visitor[>..] }
mix(mode int, a f32, b f32, rest bool) f32:
	m := if mode == 0 { if rest { 3 } else { 1 } } else { mode }
	if m == 1 { fsqrt(a * b) } else if m == 2 { if a < b { a } else { b } } else if m == 3 { if a > b { a } else { b } } else if m == 4 { 0.5 * (a + b) } else { a * b }
new_world(g float3, rest_th f32, hit_th f32, cspeed f32, chz f32, cdr f32, max_speed f32, sleep bool, cont bool, workers int, cap Cap5) World:
	w ~= World{..}; w.in_use = true; w.bp = new_bp(max(16, cap.ss), max(16, cap.ds))
	for i GRAPH_COLORS: w.colors.push(GColor{..})
	for i OVERFLOW: bit_reset(w.colors[i].bodies, 16)
	for i 3: w.sets.push(SSet{..}); w.sets[i].si = id_alloc(w.setpool)
	w.split = -1; w.gravity = g; w.hit_th = hit_th; w.rest_th = rest_th; w.max_speed = max_speed; w.cspeed = cspeed; w.chz = chz; w.cdr = cdr; w.crecycle = 10.0 * slop()
	w.sleep = sleep; w.warm = true; w.continuous = cont; w.speculative = true; w.workers = if workers > 1 { min(workers, 32) } else { 1 }
	w
create_island(w World&, si int) int:
	id := id_alloc(w.ipool)
	if id == w.islands.len: w.islands.push(Island{..})
	s := &w.sets[si]; il := &w.islands[id]
	il.set = si; il.li = s.isims.len; il.id = id; il.bodies.clear(); il.contacts.clear(); il.joints.clear(); il.crc = 0
	s.isims.push(id); id
destroy_island(w World&, id int):
	if w.split == id: w.split = -1
	il := &w.islands[id]; s := &w.sets[il.set]; li := il.li; last := s.isims.len - 1; mv := s.isims[last]
	s.isims[li] = s.isims[last]; w.islands[mv].li = li; s.isims.pop()
	il.bodies.clear(); il.contacts.clear(); il.joints.clear(); il.crc = 0; il.li = -1; il.id = -1; il.set = -1
	id_free(w.ipool, id)
merge_islands(w World&, a int, b int) int:
	if a == b || b == -1: return a
	if a == -1: return b
	big ~= a; sm ~= b
	if w.islands[a].bodies.len < w.islands[b].bodies.len { big = b; sm = a }
	for i w.islands[sm].bodies.len: bid := w.islands[sm].bodies[i]; w.bodies[bid].isl = big; w.bodies[bid].islx = w.islands[big].bodies.len; w.islands[big].bodies.push(bid)
	for i w.islands[sm].contacts.len: l := w.islands[sm].contacts[i]; w.contacts[l.cid].isl = big; w.contacts[l.cid].islx = w.islands[big].contacts.len; w.islands[big].contacts.push(l)
	for i w.islands[sm].joints.len: l := w.islands[sm].joints[i]; w.joints[l.jid].isl = big; w.joints[l.jid].islx = w.islands[big].joints.len; w.islands[big].joints.push(l)
	w.islands[big].crc += w.islands[sm].crc; destroy_island(w, sm); big
link_contact(w World&, cid int):
	ba := w.contacts[cid].ed[0].bid; bb := w.contacts[cid].ed[1].bid
	if w.bodies[ba].set == SET_AWAKE && w.bodies[bb].set >= SET_SLEEP: wake_set(w, w.bodies[bb].set)
	if w.bodies[bb].set == SET_AWAKE && w.bodies[ba].set >= SET_SLEEP: wake_set(w, w.bodies[ba].set)
	f := merge_islands(w, w.bodies[ba].isl, w.bodies[bb].isl)
	w.contacts[cid].isl = f; w.contacts[cid].islx = w.islands[f].contacts.len; w.islands[f].contacts.push(CLink{cid, ba, bb})
unlink_contact(w World&, cid int):
	id := w.contacts[cid].isl; ri := w.contacts[cid].islx
	if rswap(w.islands[id].contacts, ri) >= 0: w.contacts[w.islands[id].contacts[ri].cid].islx = ri
	w.contacts[cid].isl = -1; w.contacts[cid].islx = -1; w.islands[id].crc += 1
link_joint(w World&, jid int):
	ba := w.joints[jid].ed[0].bid; bb := w.joints[jid].ed[1].bid
	if w.bodies[ba].set == SET_AWAKE && w.bodies[bb].set >= SET_SLEEP { wake_set(w, w.bodies[bb].set) } else if w.bodies[bb].set == SET_AWAKE && w.bodies[ba].set >= SET_SLEEP { wake_set(w, w.bodies[ba].set) }
	f := merge_islands(w, w.bodies[ba].isl, w.bodies[bb].isl)
	w.joints[jid].isl = f; w.joints[jid].islx = w.islands[f].joints.len; w.islands[f].joints.push(JLink{jid, ba, bb})
unlink_joint(w World&, jid int):
	id := w.joints[jid].isl
	if id == -1: return
	ri := w.joints[jid].islx
	if rswap(w.islands[id].joints, ri) >= 0: w.joints[w.islands[id].joints[ri].jid].islx = ri
	w.joints[jid].isl = -1; w.joints[jid].islx = -1; w.islands[id].crc += 1
uf_find(p int[>..]&, n0 int) int:
	n ~= n0
	while p[n] != n: g := p[p[n]]; p[n] = g; n = g
	n
uf_union(p int[>..]&, r int[>..]&, a int, b int, cc int[>..]&, jc int[>..]&):
	r1 := uf_find(p, a); r2 := uf_find(p, b)
	if r1 == r2: return
	if r[r1] < r[r2] { p[r1] = r2; cc[r2] += cc[r1]; jc[r2] += jc[r1] } else if r[r1] > r[r2] { p[r2] = r1; cc[r1] += cc[r2]; jc[r1] += jc[r2] } else { p[r2] = r1; r[r1] += 1; cc[r1] += cc[r2]; jc[r1] += jc[r2] }
split_island(w World&, base int):
	bb := copy(w.islands[base].bodies); bc := copy(w.islands[base].contacts); bj := copy(w.islands[base].joints); n := bb.len
	p int[>..] ~= []; r int[>..] ~= []; cc int[>..] ~= []; jc int[>..] ~= []
	for i n: p.push(i); r.push(0); cc.push(0); jc.push(0)
	for l bc:
		ia := w.bodies[l.ba].islx; ib := w.bodies[l.bb].islx
		if ia != -1 && ib != -1 { uf_union(p, r, ia, ib, cc, jc); cc[uf_find(p, ia)] += 1 } else { cc[uf_find(p, if ia != -1 { ia } else { ib })] += 1 }
	for l bj:
		ia := w.bodies[l.ba].islx; ib := w.bodies[l.bb].islx
		if ia != -1 && ib != -1 { uf_union(p, r, ia, ib, cc, jc); jc[uf_find(p, ia)] += 1 } else { jc[uf_find(p, if ia != -1 { ia } else { ib })] += 1 }
	k ~= 0
	for i n: p[i] = uf_find(p, i); if p[i] == i { k += 1 }
	if k == 1: w.islands[base].crc = 0; return
	w.islands[base].bodies.clear(); w.islands[base].contacts.clear(); w.islands[base].joints.clear()
	rm int[>..] ~= []; for i n { rm.push(-1) }
	ids int[>..] ~= []
	for i n: if rm[p[i]] == -1 { rm[p[i]] = ids.len; ids.push(0) }
	for i ids.len: ids[i] = create_island(w, SET_AWAKE)
	for i n: ni := ids[rm[uf_find(p, i)]]; w.bodies[bb[i]].isl = ni; w.bodies[bb[i]].islx = w.islands[ni].bodies.len; w.islands[ni].bodies.push(bb[i])
	for l bc: t := if w.bodies[l.ba].isl != -1 { w.bodies[l.ba].isl } else { w.bodies[l.bb].isl }; w.contacts[l.cid].isl = t; w.contacts[l.cid].islx = w.islands[t].contacts.len; w.islands[t].contacts.push(l)
	for l bj: t := if w.bodies[l.ba].isl != -1 { w.bodies[l.ba].isl } else { w.bodies[l.bb].isl }; w.joints[l.jid].isl = t; w.joints[l.jid].islx = w.islands[t].joints.len; w.islands[t].joints.push(l)
	destroy_island(w, base)
destroy_set(w World&, si int): s := &w.sets[si]; s.sims.clear(); s.states.clear(); s.cidx.clear(); s.jsims.clear(); s.isims.clear(); id_free(w.setpool, si); s.si = -1
wake_set(w World&, si int):
	for i w.sets[si].sims.len:
		bid := w.sets[si].sims[i].bid; b := &w.bodies[bid]
		b.set = SET_AWAKE; b.li = w.sets[SET_AWAKE].sims.len; b.stime = 0.0
		w.sets[SET_AWAKE].sims.push(w.sets[si].sims[i]); st ~= BState{}; st.flags = b.flags; w.sets[SET_AWAKE].states.push(st)
		key ~= b.hck
		while key != -1:
			cid := key >> 1; ei := key & 1; key = w.contacts[cid].ed[ei].next
			if w.contacts[cid].set != SET_DISABLED: continue
			li := w.contacts[cid].li; w.contacts[cid].set = SET_AWAKE; w.contacts[cid].li = w.sets[SET_AWAKE].cidx.len; w.sets[SET_AWAKE].cidx.push(cid)
			if rswap(w.sets[SET_DISABLED].cidx, li) >= 0: w.contacts[w.sets[SET_DISABLED].cidx[li]].li = li
	for i w.sets[si].cidx.len: cid := w.sets[si].cidx[i]; add_contact_graph(w, cid); w.contacts[cid].set = SET_AWAKE
	for i w.sets[si].jsims.len: jid := w.sets[si].jsims[i].jid; add_joint_graph(w, w.sets[si].jsims[i], jid); w.joints[jid].set = SET_AWAKE
	for i w.sets[si].isims.len: iid := w.sets[si].isims[i]; w.islands[iid].set = SET_AWAKE; w.islands[iid].li = w.sets[SET_AWAKE].isims.len; w.sets[SET_AWAKE].isims.push(iid)
	destroy_set(w, si)
try_sleep_island(w World&, iid int):
	if w.islands[iid].crc > 0 && w.islands[iid].bodies.len > 1: return
	ss := id_alloc(w.setpool)
	if ss == w.sets.len: w.sets.push(SSet{..})
	w.sets[ss] = SSet{..}; w.sets[ss].si = ss
	for i w.islands[iid].bodies.len:
		bid := w.islands[iid].bodies[i]
		if w.bodies[bid].bmi != -1: w.moves[w.bodies[bid].bmi].asleep = true; w.bodies[bid].bmi = -1
		ai := w.bodies[bid].li; sbi := w.sets[ss].sims.len; w.sets[ss].sims.push(w.sets[SET_AWAKE].sims[ai])
		if rswap(w.sets[SET_AWAKE].sims, ai) >= 0: w.bodies[w.sets[SET_AWAKE].sims[ai].bid].li = ai
		rswap(w.sets[SET_AWAKE].states, ai)
		w.bodies[bid].set = ss; w.bodies[bid].li = sbi
		key ~= w.bodies[bid].hck
		while key != -1:
			cid := key >> 1; ei := key & 1; key = w.contacts[cid].ed[ei].next
			if w.contacts[cid].set == SET_DISABLED || w.contacts[cid].color != -1: continue
			if w.bodies[w.contacts[cid].ed[ei ^ 1].bid].set == SET_AWAKE: continue
			li := w.contacts[cid].li; w.contacts[cid].set = SET_DISABLED; w.contacts[cid].li = w.sets[SET_DISABLED].cidx.len; w.sets[SET_DISABLED].cidx.push(cid)
			if rswap(w.sets[SET_AWAKE].cidx, li) >= 0: w.contacts[w.sets[SET_AWAKE].cidx[li]].li = li
	for i w.islands[iid].contacts.len:
		cid := w.islands[iid].contacts[i].cid; ci := w.contacts[cid].color; col := &w.colors[ci]
		if ci != OVERFLOW: bit_clear(col.bodies, w.contacts[cid].ed[0].bid); bit_clear(col.bodies, w.contacts[cid].ed[1].bid)
		sci := w.sets[ss].cidx.len; w.sets[ss].cidx.push(cid); li := w.contacts[cid].li
		if w.contacts[cid].flags & CF_MESH != 0 || ci == OVERFLOW { if rswap(col.contacts, li) >= 0 { w.contacts[col.contacts[li].cid].li = li } } else { if rswap(col.convex, li) >= 0 { w.contacts[col.convex[li]].li = li } }
		w.contacts[cid].set = ss; w.contacts[cid].color = -1; w.contacts[cid].li = sci
	for i w.islands[iid].joints.len:
		jid := w.islands[iid].joints[i].jid; ci := w.joints[jid].color; li := w.joints[jid].li; col := &w.colors[ci]
		if ci != OVERFLOW: bit_clear(col.bodies, w.joints[jid].ed[0].bid); bit_clear(col.bodies, w.joints[jid].ed[1].bid)
		sji := w.sets[ss].jsims.len; w.sets[ss].jsims.push(col.jsims[li])
		if rswap(col.jsims, li) >= 0: w.joints[col.jsims[li].jid].li = li
		w.joints[jid].set = ss; w.joints[jid].color = -1; w.joints[jid].li = sji
	ix := w.islands[iid].li; w.sets[ss].isims.push(iid)
	if rswap(w.sets[SET_AWAKE].isims, ix) >= 0: w.islands[w.sets[SET_AWAKE].isims[ix]].li = ix
	w.islands[iid].set = ss; w.islands[iid].li = 0
	if w.split == iid: w.split = -1
merge_sets(w World&, a0 int, b0 int):
	a ~= a0; b ~= b0
	if w.sets[a].sims.len < w.sets[b].sims.len: a = b0; b = a0
	for i w.sets[b].sims.len: bid := w.sets[b].sims[i].bid; w.bodies[bid].set = a; w.bodies[bid].li = w.sets[a].sims.len; w.sets[a].sims.push(w.sets[b].sims[i])
	for i w.sets[b].cidx.len: cid := w.sets[b].cidx[i]; w.contacts[cid].set = a; w.contacts[cid].li = w.sets[a].cidx.len; w.sets[a].cidx.push(cid)
	for i w.sets[b].jsims.len: jid := w.sets[b].jsims[i].jid; w.joints[jid].set = a; w.joints[jid].li = w.sets[a].jsims.len; w.sets[a].jsims.push(w.sets[b].jsims[i])
	for i w.sets[b].isims.len: iid := w.sets[b].isims[i]; w.islands[iid].set = a; w.islands[iid].li = w.sets[a].isims.len; w.sets[a].isims.push(iid)
	destroy_set(w, b)
transfer_body(w World&, ts int, ss int, bid int):
	if ts == ss: return
	si := w.bodies[bid].li; ti := w.sets[ts].sims.len; w.sets[ts].sims.push(w.sets[ss].sims[si]); w.sets[ts].sims[ti].flags &= ~(BF_FAST | BF_CAPPED | BF_HAD_TOI)
	if rswap(w.sets[ss].sims, si) >= 0: w.bodies[w.sets[ss].sims[si].bid].li = si
	if w.sets[ss].si == SET_AWAKE { rswap(w.sets[ss].states, si) } else if w.sets[ts].si == SET_AWAKE { st ~= BState{}; st.flags = w.bodies[bid].flags; w.sets[ts].states.push(st) }
	w.bodies[bid].set = w.sets[ts].si; w.bodies[bid].li = ti
transfer_joint(w World&, ts int, ss int, jid int):
	if ts == ss: return
	li := w.joints[jid].li; ci := w.joints[jid].color
	src := if w.sets[ss].si == SET_AWAKE { copy(w.colors[ci].jsims[li]) } else { copy(w.sets[ss].jsims[li]) }
	if w.sets[ts].si == SET_AWAKE { add_joint_graph(w, src, jid); w.joints[jid].set = SET_AWAKE } else { w.joints[jid].set = w.sets[ts].si; w.joints[jid].li = w.sets[ts].jsims.len; w.joints[jid].color = -1; w.sets[ts].jsims.push(src) }
	if w.sets[ss].si == SET_AWAKE { remove_joint_graph(w, w.joints[jid].ed[0].bid, w.joints[jid].ed[1].bid, ci, li) } else { if rswap(w.sets[ss].jsims, li) >= 0 { w.joints[w.sets[ss].jsims[li].jid].li = li } }
pick_color(w World&, ba int, bb int, ta int, tb int) int:
	if ta == BODY_DYNAMIC && tb == BODY_DYNAMIC:
		for i DYN_COLORS: if !bit_get(w.colors[i].bodies, ba) && !bit_get(w.colors[i].bodies, bb) { bit_grow_set(w.colors[i].bodies, ba); bit_grow_set(w.colors[i].bodies, bb); return i }
	else if ta == BODY_DYNAMIC:
		i ~= OVERFLOW - 1
		while i >= 1: if !bit_get(w.colors[i].bodies, ba) { bit_grow_set(w.colors[i].bodies, ba); return i }; i -= 1
	else if tb == BODY_DYNAMIC:
		i ~= OVERFLOW - 1
		while i >= 1: if !bit_get(w.colors[i].bodies, bb) { bit_grow_set(w.colors[i].bodies, bb); return i }; i -= 1
	OVERFLOW
add_contact_graph(w World&, cid int):
	ba := w.contacts[cid].ed[0].bid; bb := w.contacts[cid].ed[1].bid; ta := w.bodies[ba].ty; tb := w.bodies[bb].ty
	ci := pick_color(w, ba, bb, ta, tb); sc := w.contacts[cid].flags & CF_MESH != 0 || ci == OVERFLOW; c := &w.contacts[cid]
	c.color = ci; c.li = if sc { w.colors[ci].contacts.len } else { w.colors[ci].convex.len }
	if sc: w.colors[ci].contacts.push(CSpec{cid, 0, c.mans.len})
	else: w.colors[ci].convex.push(cid)
	c.bsa = if ta == BODY_STATIC { -1 } else { w.bodies[ba].li }; c.bsb = if tb == BODY_STATIC { -1 } else { w.bodies[bb].li }
remove_contact_graph(w World&, ba int, bb int, ci int, li int, mesh bool):
	col := &w.colors[ci]
	if ci != OVERFLOW: bit_clear(col.bodies, ba); bit_clear(col.bodies, bb)
	if mesh || ci == OVERFLOW { if rswap(col.contacts, li) >= 0 { w.contacts[col.contacts[li].cid].li = li } } else { if rswap(col.convex, li) >= 0 { w.contacts[col.convex[li]].li = li } }
add_joint_graph(w World&, js JointSim, jid int):
	ba := w.joints[jid].ed[0].bid; bb := w.joints[jid].ed[1].bid
	ci := pick_color(w, ba, bb, w.bodies[ba].ty, w.bodies[bb].ty)
	w.colors[ci].jsims.push(js); w.joints[jid].color = ci; w.joints[jid].li = w.colors[ci].jsims.len - 1
remove_joint_graph(w World&, ba int, bb int, ci int, li int):
	col := &w.colors[ci]
	if ci != OVERFLOW: bit_clear(col.bodies, ba); bit_clear(col.bodies, bb)
	if rswap(col.jsims, li) >= 0: w.joints[col.jsims[li].jid].li = li
struct View { ty int, cap Capsule, sph Sphere, h int, hc int, mats Mat[>..], flags int, id int, gen int, mesh int, mc int, msc float3, hf int }
var G_MESH MeshD[>..]
var G_HF HField[>..]
var G_CPD CompoundD[>..]
var G_HULL HData[>..]
contact_reg(a int, b int) int:
	p := [0x21, 0x29, 0x29, 0x29, 0x29, 0x20]
	if (p[a] >> b) & 1 != 0: return 1
