view_radius(w World&, v View&, q f32) f32: if v.ty == SH_SPHERE { v.sph.radius } else if v.ty == SH_CAPSULE { v.cap.radius } else if v.ty == SH_HULL { q * vhull(w, v).ir } else { 0.0 }
update_convex(w World&, cid int, va View&, xa Transform, vb View&, xb Transform, flip bool) bool:
	if !convex_manifold(w, cid, va, xa, vb, xb): return false
	c := &w.contacts[cid]
	if flip:
		m := &c.mans[0]; m.n = -m.n
