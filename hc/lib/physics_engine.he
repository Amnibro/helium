	if ea.prev != -1: w.contacts[ea.prev >> 1].ed[ea.prev & 1].next = ea.next
	if ea.next != -1: w.contacts[ea.next >> 1].ed[ea.next & 1].prev = ea.prev
	if w.bodies[ba].hck == cid << 1: w.bodies[ba].hck = ea.next
