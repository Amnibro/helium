update_contact(w World&, cid int, lca float3, xa Transform, lcb float3, xb Transform, fast bool) bool:
	sa := w.contacts[cid].sa; sb := w.contacts[cid].sb; va ~= view_of(w, sa); vb ~= view_of(w, sb); t ~= false
	if va.ty == SH_COMPOUND:
		cd := va.id; cpi := w.shapes[sa].cpd; ch := child_of(G_CPD[cpi], w.contacts[cid].child); cv ~= copy(va); cv.ty = ch.ty
		if ch.ty != SH_MESH: cv.mats.clear(); cv.mats.push(va.mats[ch.mi[0]])
		if ch.ty == SH_CAPSULE { cv.cap = ch.cap; t = if vb.ty == SH_HULL { update_convex(w, cid, vb, xb, cv, xa, true) } else { update_convex(w, cid, cv, xa, vb, xb, false) } } else if ch.ty == SH_HULL { cv.h = ch.h; cv.hc = cpi; t = update_convex(w, cid, cv, xmul(xa, ch.xf), vb, xb, false) } else if ch.ty == SH_MESH { cv.mesh = ch.m; cv.mc = cpi; cv.msc = ch.sc; t = mesh_manifolds(w, cid, cv, ch.mi, true, xmul(xa, ch.xf), vb, xb, fast); if t && (va.flags | vb.flags) & SF_HIT_EV != 0 { w.contacts[cid].flags |= CF_SIM_HIT } else { w.contacts[cid].flags &= ~CF_SIM_HIT } } else { cv.sph = ch.sph; t = if vb.ty == SH_CAPSULE || vb.ty == SH_HULL { update_convex(w, cid, vb, xb, cv, xa, true) } else { update_convex(w, cid, cv, xa, vb, xb, false) } }
		off := rot(xa.q, ch.xf.p)
		for i w.contacts[cid].mans.len: for j w.contacts[cid].mans[i].count { w.contacts[cid].mans[i].pts[j].aa = w.contacts[cid].mans[i].pts[j].aa + off }
	else if va.ty == SH_MESH || va.ty == SH_HEIGHT:
		t = mesh_manifolds(w, cid, va, [0, 0, 0, 0], false, xa, vb, xb, fast)
		if t && (va.flags | vb.flags) & SF_HIT_EV != 0 { w.contacts[cid].flags |= CF_SIM_HIT } else { w.contacts[cid].flags &= ~CF_SIM_HIT }
	else:
		t = update_convex(w, cid, va, xa, vb, xb, false)
	c := &w.contacts[cid]
	if t:
		ca := rot(xa.q, lca); cb := rot(xb.q, lcb)
		for i c.mans.len: for j c.mans[i].count { c.mans[i].pts[j].aa = c.mans[i].pts[j].aa - ca; c.mans[i].pts[j].ab = c.mans[i].pts[j].ab - cb }
		c.flags |= CF_SIM_TOUCHING
	else:
		c.flags &= ~CF_SIM_TOUCHING
	t
struct BDef { ty int = 0, p float3 = V0, q Quat = QI, v float3 = V0, w float3 = V0, ld f32 = 0.0, ad f32 = 0.0, gs f32 = 1.0, sth f32 = 0.05, safety f32 = 0.5, name byte[>..], ud u64 = 0, locks int = 0, sleep bool = true, awake bool = true, bullet bool = false, enabled bool = true, fast_rot bool = false, recycle bool = true }
struct SDef { name byte[>..], ud u64 = 0, mats Mat[>..], base Mat = Mat{}, den f32 = 1000.0, exs f32 = 1.0, filter Filter3 = Filter3{}, custom bool = false, sensor bool = false, sensor_ev bool = false, contact_ev bool = false, hit_ev bool = false, presolve bool = false, invoke bool = true, update_mass bool = true, speculative bool = true }
bsim(w World&, bid int) BSim&: w.sets[w.bodies[bid].set].sims[w.bodies[bid].li]
body_xf(w World&, bid int) Transform: bsim(w, bid).xf
has_state(w World&, bid int) bool: w.bodies[bid].set == SET_AWAKE
bstate(w World&, bid int) BState&: w.sets[SET_AWAKE].states[w.bodies[bid].li]
sync_flags(w World&, bid int):
	f := w.bodies[bid].flags & ~BF_TRANSIENT; bsim(w, bid).flags = f
	if has_state(w, bid): bstate(w, bid).flags = f
wake_body(w World&, bid int) bool:
	if w.bodies[bid].set >= SET_SLEEP: wake_set(w, w.bodies[bid].set); return true
	false
create_body(w World&, d BDef&) int:
	aw := (d.awake || !d.sleep) && d.enabled
	si ~= SET_AWAKE
	if !d.enabled { si = SET_DISABLED } else if d.ty == BODY_STATIC { si = SET_STATIC } else if !aw { si = id_alloc(w.setpool); if si == w.sets.len { w.sets.push(SSet{..}) }; w.sets[si].si = si }
	bid := id_alloc(w.bpool)
	s ~= BSim{..}; s.xf = Transform{d.p, d.q}; s.c = d.p; s.q0 = d.q; s.c0 = d.p; s.minx = huge(); s.ld = d.ld; s.ad = d.ad; s.gs = d.gs; s.bid = bid
	s.flags = d.locks | (if d.bullet { BF_BULLET } else { 0 }) | (if d.fast_rot { BF_FAST_ROT } else { 0 }) | (if d.ty == BODY_DYNAMIC { BF_DYNAMIC } else { 0 }) | (if d.sleep { BF_SLEEP } else { 0 }) | (if d.recycle { BF_RECYCLE } else { 0 })
	w.sets[si].sims.push(s)
	if si == SET_AWAKE: st ~= BState{..}; st.v = d.v; st.w = d.w; st.dq = QI; st.flags = s.flags; w.sets[si].states.push(st)
	if bid == w.bodies.len: w.bodies.push(Body{..})
	b := &w.bodies[bid]
	b.ud = d.ud; b.set = si; b.li = w.sets[si].sims.len - 1; b.gen += 1; b.hsh = -1; b.scount = 0; b.hchain = -1; b.hck = -1; b.ccount = 0; b.hjk = -1; b.jcount = 0; b.isl = -1; b.islx = -1; b.bmi = -1; b.id = bid
	b.sth = d.sth; b.stime = 0.0; b.svel = 0.0; b.safety = d.safety; b.mass = 0.0; b.inertia = M0; b.name.clear(); b.name.append(d.name[..]); b.ty = d.ty; b.flags = s.flags
	if si >= SET_AWAKE: il := create_island(w, si); w.islands[il].bodies.push(bid); w.bodies[bid].isl = il; w.bodies[bid].islx = 0
	bid
remove_body_island(w World&, bid int):
	il := w.bodies[bid].isl
	if il == -1: return
	li := w.bodies[bid].islx; n := w.islands[il].bodies.len; mv := w.islands[il].bodies[n - 1]
	w.islands[il].bodies[li] = mv; w.bodies[mv].islx = li; w.islands[il].bodies.pop()
	if w.islands[il].bodies.len == 0: destroy_island(w, il)
	w.bodies[bid].isl = -1; w.bodies[bid].islx = -1
destroy_body_contacts(w World&, bid int, wake bool):
	key ~= w.bodies[bid].hck
	while key != -1: cid := key >> 1; key = w.contacts[cid].ed[key & 1].next; destroy_contact(w, cid, wake)
destroy_body(w World&, bid int):
	key ~= w.bodies[bid].hjk
	while key != -1: jid := key >> 1; key = w.joints[jid].ed[key & 1].next; destroy_joint_internal(w, jid, true)
	destroy_body_contacts(w, bid, true)
	sid ~= w.bodies[bid].hsh
	while sid != -1:
		if w.shapes[sid].ty == SH_COMPOUND: w.ncpd -= 1
		if w.shapes[sid].sensor != -1: destroy_sensor(w, sid)
		destroy_shape_proxy(w, sid); destroy_shape_allocs(w, sid); id_free(w.spool, sid); w.shapes[sid].id = -1; sid = w.shapes[sid].next
	remove_body_island(w, bid)
	si := w.bodies[bid].set; li := w.bodies[bid].li
	if rswap(w.sets[si].sims, li) >= 0: w.bodies[w.sets[si].sims[li].bid].li = li
	if si == SET_AWAKE { rswap(w.sets[si].states, li) } else if w.sets[si].si >= SET_SLEEP && w.sets[si].sims.len == 0 { destroy_set(w, w.sets[si].si) }
	id_free(w.bpool, bid); w.bodies[bid].set = -1; w.bodies[bid].li = -1; w.bodies[bid].id = -1
shape_extent(w World&, s int, lc float3) float4:
	x := &w.shapes[s]
	if x.ty == SH_CAPSULE: r := x.cap.radius; e := vmax(vabs(x.cap.center1 - lc), vabs(x.cap.center2 - lc)) + float3{r, r, r}; return float4{r, e.x, e.y, e.z}
	if x.ty == SH_SPHERE: r := x.sph.radius; e := vabs(x.sph.center - lc) + float3{r, r, r}; return float4{r, e.x, e.y, e.z}
	if x.ty == SH_HULL: return hull_extent(w.hulls[x.hull], lc)
	if x.ty == SH_COMPOUND || x.ty == SH_MESH:
		b := if x.ty == SH_COMPOUND { compound_box(G_CPD[x.cpd], XI) } else { mesh_box(G_MESH[x.mesh], XI, x.msc) }
		r1 := vlen(b.lower - lc); r2 := vlen(b.upper - lc); e := vabs(far_pt(b, lc) - lc); return float4{fmin(r1, r2), e.x, e.y, e.z}
	float4{0.0, 0.0, 0.0, 0.0}
shape_mass(w World&, s int) MassData:
	x := &w.shapes[s]
	if x.ty == SH_CAPSULE { capsule_mass(x.cap, x.den) } else if x.ty == SH_HULL { hull_mass(w.hulls[x.hull], x.den) } else if x.ty == SH_SPHERE { sphere_mass(x.sph, x.den) } else { MassData{0.0, V0, M0} }
shape_box(w World&, s int, xf Transform) AABB:
	x := &w.shapes[s]
	if x.ty == SH_CAPSULE { capsule_box(x.cap, xf) } else if x.ty == SH_COMPOUND { compound_box(G_CPD[x.cpd], xf) } else if x.ty == SH_HEIGHT { hf_box(G_HF[x.hf], xf) } else if x.ty == SH_HULL { hull_box(w.hulls[x.hull], xf) } else if x.ty == SH_MESH { mesh_box(G_MESH[x.mesh], xf, x.msc) } else if x.ty == SH_SPHERE { sphere_box(x.sph, xf) } else { AABB{xf.p, xf.p} }
fat_box(w World&, s int, xf Transform, e f32) AABB: b := shape_box(w, s, xf); r := float3{e, e, e}; AABB{b.lower - r, b.upper + r}
swept_box(w World&, s int, sw Sweep, t f32) AABB:
	x1 := Transform{sw.c1 - rot(sw.q1, sw.lc), sw.q1}; x2 := sweep_xf(sw, t); x := &w.shapes[s]
	if x.ty == SH_CAPSULE { swept_capsule_box(x.cap, x1, x2) } else if x.ty == SH_HULL { box_union(hull_box(w.hulls[x.hull], x1), hull_box(w.hulls[x.hull], x2)) } else if x.ty == SH_SPHERE { swept_sphere_box(x.sph, x1, x2) } else { AABB{x1.p, x1.p} }
shape_centroid(w World&, s int) float3:
	x := &w.shapes[s]
	if x.ty == SH_CAPSULE { vlerp(x.cap.center1, x.cap.center2, 0.5) } else if x.ty == SH_COMPOUND { box_center(compound_box(G_CPD[x.cpd], XI)) } else if x.ty == SH_SPHERE { x.sph.center } else if x.ty == SH_HULL { w.hulls[x.hull].cen } else if x.ty == SH_MESH { box_center(mesh_box(G_MESH[x.mesh], XI, x.msc)) } else if x.ty == SH_HEIGHT { box_center(hf_box(G_HF[x.hf], XI)) } else { V0 }
shape_margin(w World&, s int) f32:
	x := &w.shapes[s]; mg ~= 0.0 as f32
	if x.ty == SH_SPHERE { mg = x.sph.radius } else if x.ty == SH_CAPSULE { mg = 0.5 * vdist(x.cap.center2, x.cap.center1) + x.cap.radius } else if x.ty == SH_HULL { h := &w.hulls[x.hull]; m2 ~= 0.0 as f32; for p h.pts { m2 = fmax(m2, vdist2(p, h.cen)) }; mg = fsqrt(m2) } else { return aabb_margin() }
	fmin(aabb_margin(), 0.125 * mg)
update_shape_boxes(w World&, s int, xf Transform, pt int):
	sd := spec_dist(); b := fat_box(w, s, xf, sd); w.shapes[s].aabb = b; m := if pt == BODY_STATIC { sd } else { w.shapes[s].margin }; r := float3{m, m, m}
	w.shapes[s].fat = AABB{b.lower - r, b.upper + r}
create_shape_proxy(w World&, s int, ty int, xf Transform, force bool): update_shape_boxes(w, s, xf, ty); w.shapes[s].pkey = bp_create(w.bp, ty, w.shapes[s].fat, w.shapes[s].filter.cat, s, force)
destroy_shape_proxy(w World&, s int): if w.shapes[s].pkey != -1 { bp_destroy(w.bp, w.shapes[s].pkey); w.shapes[s].pkey = -1 }
hull_db_add(w World&, h HData&) int:
	for i w.hulls.len: if w.hrc[i] > 0 && hull_eq(w.hulls[i], h) { w.hrc[i] += 1; return i }
	for i w.hulls.len: if w.hrc[i] == 0 { w.hulls[i] = copy(h); w.hrc[i] = 1; return i }
	w.hulls.push(copy(h)); w.hrc.push(1); w.hulls.len - 1
hull_db_remove(w World&, i int): w.hrc[i] -= 1; if w.hrc[i] == 0 { w.hulls[i] = HData{..} }
destroy_shape_allocs(w World&, s int): if w.shapes[s].ty == SH_HULL && w.shapes[s].hull >= 0 { hull_db_remove(w, w.shapes[s].hull); w.shapes[s].hull = -1 }
create_shape_internal(w World&, bid int, bxf Transform, d SDef&, ty int, sh Shape) int:
	sid := id_alloc(w.spool)
	if sid == w.shapes.len: w.shapes.push(Shape{..})
	g := w.shapes[sid].gen; w.shapes[sid] = copy(sh); x := &w.shapes[sid]
	x.gen = g + 1; x.id = sid; x.bid = bid; x.ty = ty; x.den = d.den; x.exs = d.exs; x.filter = d.filter; x.ud = d.ud
	x.flags = (if d.sensor_ev { SF_SENSOR_EV } else { 0 }) | (if d.contact_ev { SF_CONTACT_EV } else { 0 }) | (if d.custom { SF_CUSTOM } else { 0 }) | (if d.hit_ev { SF_HIT_EV } else { 0 }) | (if d.presolve { SF_PRESOLVE } else { 0 }) | (if d.speculative { SF_SPECULATIVE } else { 0 })
	x.pkey = -1; x.name.clear(); x.name.append(d.name[..])
	w.shapes[sid].lcen = shape_centroid(w, sid); w.shapes[sid].margin = shape_margin(w, sid); w.shapes[sid].aabb = AABB{V0, V0}; w.shapes[sid].fat = AABB{V0, V0}
	w.shapes[sid].mats.clear()
	if ty == SH_COMPOUND { w.ncpd += 1; w.shapes[sid].mats.append(G_CPD[w.shapes[sid].cpd].mats[..]) } else if d.mats.len > 1 { w.shapes[sid].mats.append(d.mats[..]) } else { w.shapes[sid].mats.push(if d.mats.len == 1 { d.mats[0] } else { d.base }) }
	if w.bodies[bid].set != SET_DISABLED: create_shape_proxy(w, sid, w.bodies[bid].ty, bxf, d.invoke && ty != SH_COMPOUND)
	h := w.bodies[bid].hsh
	if h != -1: w.shapes[h].prev = sid
	w.shapes[sid].prev = -1; w.shapes[sid].next = h; w.bodies[bid].hsh = sid; w.bodies[bid].scount += 1
	if d.sensor { w.shapes[sid].sensor = w.sensors.len; se ~= Sensor{..}; se.sid = sid; w.sensors.push(se) } else { w.shapes[sid].sensor = -1 }
	sid
create_shape(w World&, bid int, d SDef&, ty int, sh Shape) int:
	if w.bodies[bid].ty != BODY_STATIC && (ty == SH_COMPOUND || ty == SH_HEIGHT): return -1
	w.locked = true
	sid := create_shape_internal(w, bid, body_xf(w, bid), d, ty, sh)
	if d.update_mass { update_mass(w, bid) } else if w.bodies[bid].flags & BF_DIRTY_MASS == 0 { w.bodies[bid].flags |= BF_DIRTY_MASS; sync_flags(w, bid) }
	w.locked = false; sid
create_sphere_shape(w World&, bid int, d SDef&, s Sphere) int: sh ~= Shape{..}; sh.sph = s; create_shape(w, bid, d, SH_SPHERE, sh)
create_capsule_shape(w World&, bid int, d SDef&, c Capsule) int:
	sl := slop()
	if vdist2(c.center1, c.center2) <= sl * sl: return create_sphere_shape(w, bid, d, Sphere{vlerp(c.center1, c.center2, 0.5), c.radius})
	sh ~= Shape{..}; sh.cap = c; create_shape(w, bid, d, SH_CAPSULE, sh)
create_hull_shape(w World&, bid int, d SDef&, h HData&) int: sh ~= Shape{..}; sh.hull = hull_db_add(w, h); r := create_shape(w, bid, d, SH_HULL, sh); if r < 0 { hull_db_remove(w, sh.hull) }; r
create_mesh_shape(w World&, bid int, d SDef&, m int, sc float3) int: sh ~= Shape{..}; sh.mesh = m; sh.msc = safe_scale(sc); create_shape(w, bid, d, SH_MESH, sh)
create_hf_shape(w World&, bid int, d SDef&, f int) int: sh ~= Shape{..}; sh.hf = f; create_shape(w, bid, d, SH_HEIGHT, sh)
create_compound_shape(w World&, bid int, d SDef&, c int) int: sh ~= Shape{..}; sh.cpd = c; create_shape(w, bid, d, SH_COMPOUND, sh)
destroy_shape_internal(w World&, sid int, bid int, wake bool):
	if w.shapes[sid].ty == SH_COMPOUND: w.ncpd -= 1
	pv := w.shapes[sid].prev; nx := w.shapes[sid].next
	if pv != -1: w.shapes[pv].next = nx
	if nx != -1: w.shapes[nx].prev = pv
	if sid == w.bodies[bid].hsh: w.bodies[bid].hsh = nx
	w.bodies[bid].scount -= 1; destroy_shape_proxy(w, sid)
	key ~= w.bodies[bid].hck
	while key != -1: cid := key >> 1; key = w.contacts[cid].ed[key & 1].next; if w.contacts[cid].sa == sid || w.contacts[cid].sb == sid { destroy_contact(w, cid, wake) }
	if w.shapes[sid].sensor != -1:
		se := w.shapes[sid].sensor
		for v w.sensors[se].o2: ev := ShapePair{sid, w.shapes[sid].gen, v.sid, v.gen, 0, 0}; if w.endix == 0 { w.send0.push(ev) } else { w.send1.push(ev) }
		if rswap(w.sensors, se) >= 0: w.shapes[w.sensors[se].sid].sensor = se
	destroy_shape_allocs(w, sid); id_free(w.spool, sid); w.shapes[sid].id = -1
destroy_shape(w World&, sid int, upd bool): w.locked = true; bid := w.shapes[sid].bid; destroy_shape_internal(w, sid, bid, true); if upd { update_mass(w, bid) }; w.locked = false
body_extents(w World&, bid int, lc float3):
	s := &bsim(w, bid); s.minx = huge(); s.maxx = V0; sid ~= w.bodies[bid].hsh
	while sid != -1: e := shape_extent(w, sid, lc); s.minx = fmin(s.minx, e.x); s.maxx = vmax(s.maxx, float3{e.y, e.z, e.w}); sid = w.shapes[sid].next
invalidate_rel(w World&, bid int):
	key ~= w.bodies[bid].hck
	while key != -1: cid := key >> 1; w.contacts[cid].flags &= ~CF_REL_VALID; key = w.contacts[cid].ed[key & 1].next
update_mass(w World&, bid int):
	s := &bsim(w, bid); b := &w.bodies[bid]
	b.flags &= ~BF_DIRTY_MASS; sync_flags(w, bid)
	b.mass = 0.0; b.inertia = M0; s.im = 0.0; s.iil = M0; s.iiw = M0; s.lc = V0; s.minx = huge(); s.maxx = V0
	if b.hsh == -1: return
	if b.ty != BODY_DYNAMIC:
		s.c = s.xf.p; s.c0 = s.c
		if b.ty == BODY_KINEMATIC: body_extents(w, bid, V0)
		return
	ms MassData[>..] ~= []; lc ~= V0; sid ~= b.hsh
	while sid != -1:
		if w.shapes[sid].den == 0.0 { ms.push(MassData{0.0, V0, M0}) } else { md := shape_mass(w, sid); b.mass += md.mass; lc = madd(lc, md.mass, md.center); ms.push(md) }
		sid = w.shapes[sid].next
	if b.mass > 0.0: s.im = 1.0 / b.mass; lc = sv(s.im, lc)
	for md ms: if md.mass != 0.0 { b.inertia = madd3(b.inertia, madd3(md.inertia, steiner(md.mass, lc - md.center))) }
	if det3(b.inertia) > 0.0: s.iil = minv_t(b.inertia); r := qmat(s.xf.q); s.iiw = mm(mm(r, s.iil), mt(r))
	oc := s.c; s.lc = lc; s.c = xpt(s.xf, lc); s.c0 = s.c
	if has_state(w, bid): st := &bstate(w, bid); st.v = st.v + cross(st.w, s.c - oc)
	body_extents(w, bid, lc); invalidate_rel(w, bid)
	if s.flags & BF_FIXED_ROT == BF_FIXED_ROT: b.inertia = M0; s.iil = M0; s.iiw = M0
should_bodies_collide(w World&, ba int, bb int) bool:
	if w.bodies[ba].ty != BODY_DYNAMIC && w.bodies[bb].ty != BODY_DYNAMIC: return false
	if w.bodies[ba].jcount < w.bodies[bb].jcount { jk ~= w.bodies[ba].hjk; ot := bb; return joints_allow(w, jk, ot) }
	joints_allow(w, w.bodies[bb].hjk, ba)
joints_allow(w World&, jk0 int, other int) bool:
	jk ~= jk0
	while jk != -1:
		jid := jk >> 1; ei := jk & 1
		if w.joints[jid].ed[ei ^ 1].bid == other && !w.joints[jid].collide: return false
		jk = w.joints[jid].ed[ei].next
	true
should_shapes_collide(a Filter3, b Filter3) bool:
	if a.group == b.group && a.group != 0: return a.group > 0
	(a.mask & b.cat) != 0 && (a.cat & b.mask) != 0
struct MCP { ra float3 = V0, rb float3 = V0, bs f32 = 0.0, rv f32 = 0.0, ni f32 = 0.0, tni f32 = 0.0, nm f32 = 0.0, lev f32 = 0.0 }
struct MCon { pts MCP[4], count int = 0, n float3 = V0, t1 float3 = V0, t2 float3 = V0, ca float3 = V0, cb float3 = V0, twm f32 = 0.0, twi f32 = 0.0, tm M2 = M2{float2{0.0, 0.0}, float2{0.0, 0.0}}, fi float2 = float2{0.0, 0.0}, ri float3 = V0, tv1 f32 = 0.0, tv2 f32 = 0.0 }
struct CCon { cid int = -1, xa int = -1, xb int = -1, ma f32 = 0.0, mb f32 = 0.0, ia Mat3 = M0, ib Mat3 = M0, s Soft = Soft{}, rm Mat3 = M0, fr f32 = 0.0, rest f32 = 0.0, roll f32 = 0.0, ms int = 0, mcount int = 0 }
struct Sym { xx f32 = 0.0, xy f32 = 0.0, xz f32 = 0.0, yy f32 = 0.0, yz f32 = 0.0, zz f32 = 0.0 }
struct Lane { cid int = -1, xa int = 0, xb int = 0, pc int = 0, ma f32 = 0.0, mb f32 = 0.0, ia Sym = Sym{}, ib Sym = Sym{}, n float3 = V0, t1 float3 = V0, t2 float3 = V0, ca float3 = V0, cb float3 = V0, twm f32 = 0.0, twi f32 = 0.0, tm Sym = Sym{}, fi float2 = float2{0.0, 0.0}, rm Sym = Sym{}, ri float3 = V0, fr f32 = 0.0, roll f32 = 0.0, tv1 f32 = 0.0, tv2 f32 = 0.0, br f32 = 0.0, ms f32 = 0.0, is f32 = 0.0, rest f32 = 0.0, pts MCP[4] }
sym(m Mat3) Sym: Sym{m.cx.x, m.cx.y, m.cx.z, m.cy.y, m.cy.z, m.cz.z}
smv(m Sym, a float3) float3: float3{m.xx * a.x + (m.xy * a.y + m.xz * a.z), m.xy * a.x + (m.yy * a.y + m.yz * a.z), m.xz * a.x + (m.yz * a.y + m.zz * a.z)}
maxw(a f32, b f32) f32: if a > b { a } else { b }
minw(a f32, b f32) f32: if a < b { a } else { b }
negw(a f32) f32: binary::f32_from_bits(binary::f32_bits(a) ^ 0x80000000)
fweight(s f32) f32: fclamp(2.0 - s * (1.0 / spec_dist()), 1e-10, 1.0)
gst(w World&, i int) BState: if i == -1 { BState{} } else { w.sets[SET_AWAKE].states[i] }
prep_mesh_contacts(w World&, ci int):
	col := &w.colors[ci]; ws := if w.warm { 1.0 } else { 0.0 }; col.cc.clear(); col.mc.clear()
	for k col.contacts.len:
		cid := col.contacts[k].cid; c := &w.contacts[cid]; xa := c.bsa; xb := c.bsb
		s1 := gst(w, xa); s2 := gst(w, xb)
		ma := if xa == -1 { 0.0 } else { w.sets[SET_AWAKE].sims[xa].im }; ia := if xa == -1 { M0 } else { w.sets[SET_AWAKE].sims[xa].iiw }
		mb := if xb == -1 { 0.0 } else { w.sets[SET_AWAKE].sims[xb].im }; ib := if xb == -1 { M0 } else { w.sets[SET_AWAKE].sims[xb].iiw }
		va := s1.v; wa := s1.w; vb := s2.v; wb := s2.w
		cc ~= CCon{}; cc.cid = cid; cc.xa = xa; cc.xb = xb; cc.ma = ma; cc.mb = mb; cc.ia = ia; cc.ib = ib; cc.rm = minv(madd3(ia, ib))
		cc.s = if c.flags & CF_STATIC != 0 { w.ctx.ss } else { w.ctx.cs }; cc.fr = c.fr; cc.rest = c.rest; cc.roll = c.roll; cc.ms = col.mc.len; cc.mcount = c.mans.len
		for mi c.mans.len:
			m := &c.mans[mi]; n := m.n; t1 := perp(n); t2 := cross(t1, n); k2 ~= MCon{..}
			k2.count = m.count; k2.n = n; k2.t1 = t1; k2.t2 = t2; k2.tv1 = dot(c.tv, t1); k2.tv2 = dot(c.tv, t2); ca ~= V0; cb ~= V0; tw ~= 0.0 as f32
			for p m.count:
				mp := &m.pts[p]; cp := &k2.pts[p]; cp.ra = mp.aa; cp.rb = mp.ab; s := mp.s; cp.bs = s - dot(cp.rb - cp.ra, n); cp.ni = ws * mp.ni; cp.tni = 0.0
				rna := cross(cp.ra, n); rnb := cross(cp.rb, n); kn := ma + mb + dot(rna, mv(ia, rna)) + dot(rnb, mv(ib, rnb)); cp.nm = if kn > 0.0 { 1.0 / kn } else { 0.0 }
				cp.rv = dot(n, (vb + cross(wb, cp.rb)) - (va + cross(wa, cp.ra))); wt := fweight(s); ca = madd(ca, wt, cp.ra); cb = madd(cb, wt, cp.rb); tw += wt
			iw := 1.0 / tw; ca = sv(iw, ca); cb = sv(iw, cb); k2.ca = ca; k2.cb = cb
			for p m.count: k2.pts[p].lev = vdist(k2.pts[p].ra, ca)
			a1 := cross(ca, t1); a2 := cross(ca, t2); b1 := cross(cb, t1); b2 := cross(cb, t2)
			kxy := dot(a1, mv(ia, a2)) + dot(b1, mv(ib, b2))
			k2.tm = inv2(M2{float2{ma + mb + dot(a1, mv(ia, a1)) + dot(b1, mv(ib, b1)), kxy}, float2{kxy, ma + mb + dot(a2, mv(ia, a2)) + dot(b2, mv(ib, b2))}})
			k2.fi = float2{ws * dot(m.fi, t1), ws * dot(m.fi, t2)}
			kt := dot(n, mv(madd3(ia, ib), n)); k2.twm = if kt > 0.0 { 1.0 / kt } else { 0.0 }; k2.twi = ws * m.twist; k2.ri = sv(ws, m.ri)
			col.mc.push(k2)
		col.cc.push(cc)
warm_mesh_contacts(w World&, ci int):
	for k w.colors[ci].cc.len:
		cc := w.colors[ci].cc[k]; s1 := gst(w, cc.xa); s2 := gst(w, cc.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w
		for mi cc.mcount:
			m := &w.colors[ci].mc[cc.ms + mi]; n := m.n
			for p m.count: ra := m.pts[p].ra; rb := m.pts[p].rb; im := sv(m.pts[p].ni, n); wa = wa - mv(cc.ia, cross(ra, im)); va = msub(va, cc.ma, im); wb = wb + mv(cc.ib, cross(rb, im)); vb = madd(vb, cc.mb, im)
			im := sv(m.fi.x, m.t1) + sv(m.fi.y, m.t2); wa = wa - mv(cc.ia, cross(m.ca, im)); va = msub(va, cc.ma, im); wb = wb + mv(cc.ib, cross(m.cb, im)); vb = madd(vb, cc.mb, im)
			ti := sv(m.twi, m.n); wa = wa - mv(cc.ia, ti); wb = wb + mv(cc.ib, ti); wa = wa - mv(cc.ia, m.ri); wb = wb + mv(cc.ib, m.ri)
		jput(w, cc.xa, s1.flags, va, wa); jput(w, cc.xb, s2.flags, vb, wb)
solve_mesh_contacts(w World&, ci int, ub bool):
	ih := w.ctx.inv_h; csp := w.cspeed
	for k w.colors[ci].cc.len:
		cc := w.colors[ci].cc[k]; s1 := gst(w, cc.xa); s2 := gst(w, cc.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w; ma := cc.ma; mb := cc.mb; ia := cc.ia; ib := cc.ib
		dp := s2.dp - s1.dp; so := cc.s; fr := cc.fr; rr := cc.roll
		for mi cc.mcount:
			m := &w.colors[ci].mc[cc.ms + mi]; n := m.n; tn ~= 0.0 as f32; tl ~= 0.0 as f32
			for p m.count:
				cp := &m.pts[p]; ra := cp.ra; rb := cp.rb; s := dot(dp + (rot(s2.dq, rb) - rot(s1.dq, ra)), n) + cp.bs
				vbias ~= 0.0 as f32; msc ~= 1.0 as f32; isc ~= 0.0 as f32
				if s > 0.0 { vbias = s * ih } else if ub { vbias = fmax(so.ms * so.bias * s, -csp); msc = so.ms; isc = so.is }
				vn := dot((vb + cross(wb, rb)) - (va + cross(wa, ra)), n); di := -cp.nm * (msc * vn + vbias) - isc * cp.ni; ni := fmax(cp.ni + di, 0.0); d := ni - cp.ni
				cp.ni = ni; cp.tni += ni; tn += ni; tl += cp.lev * cp.ni; pp := sv(d, n)
				va = msub(va, ma, pp); wa = wa - mv(ia, cross(ra, pp)); vb = madd(vb, mb, pp); wb = wb + mv(ib, cross(rb, pp))
			if ub: continue
			ts := dot(m.n, wb - wa); mx := fr * tl; oi := m.twi; m.twi = fclamp(oi + -m.twm * ts, -mx, mx); dt := m.twi - oi
			wa = wa - mv(ia, sv(dt, m.n)); wb = wb + mv(ib, sv(dt, m.n))
			if rr > 0.0:
				o := m.ri; m.ri = o + -mv(cc.rm, wb - wa); mr := rr * tn; m2 := dot(m.ri, m.ri)
				if m2 > mr * mr + FLT_EPS: m.ri = sv(mr / fsqrt(m2), m.ri)
				d := m.ri - o; wa = wa - mv(ia, d); wb = wb + mv(ib, d)
			ra := m.ca; rb := m.cb; vr := (vb + cross(wb, rb)) - (va + cross(wa, ra)); tm := mv2(m.tm, float2{dot(vr, m.t1) - m.tv1, dot(vr, m.t2) - m.tv2})
			ni ~= float2{m.fi.x + -tm.x, m.fi.y + -tm.y}; mx2 := fr * tn; l2 := dot2(ni, ni)
			if l2 > mx2 * mx2: sc := mx2 / fsqrt(l2); ni.x *= sc; ni.y *= sc
			dx := ni.x - m.fi.x; dy := ni.y - m.fi.y; m.fi = ni; pp := blend2(dx, m.t1, dy, m.t2)
			va = msub(va, ma, pp); wa = wa - mv(ia, cross(ra, pp)); vb = madd(vb, mb, pp); wb = wb + mv(ib, cross(rb, pp))
		jput(w, cc.xa, s1.flags, va, wa); jput(w, cc.xb, s2.flags, vb, wb)
rest_mesh_contacts(w World&, ci int):
	th := w.rest_th
	for k w.colors[ci].cc.len:
		cc := w.colors[ci].cc[k]
		if cc.rest == 0.0: continue
		s1 := gst(w, cc.xa); s2 := gst(w, cc.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w
		for mi cc.mcount:
			m := &w.colors[ci].mc[cc.ms + mi]; n := m.n
			for p m.count:
				cp := &m.pts[p]
				if cp.rv > -th || cp.tni == 0.0: continue
				vn := dot((vb + cross(wb, cp.rb)) - (va + cross(wa, cp.ra)), n); im := -cp.nm * (vn + cc.rest * cp.rv); ni := fmax(cp.ni + im, 0.0); d := ni - cp.ni
				cp.ni = ni; cp.tni += d; pp := sv(d, n)
				va = msub(va, cc.ma, pp); wa = wa - mv(cc.ia, cross(cp.ra, pp)); vb = madd(vb, cc.mb, pp); wb = wb + mv(cc.ib, cross(cp.rb, pp))
		jput(w, cc.xa, s1.flags, va, wa); jput(w, cc.xb, s2.flags, vb, wb)
store_mesh_contacts(w World&, ci int):
	nh := -w.hit_th
	for k w.colors[ci].cc.len:
		cc := w.colors[ci].cc[k]; c := &w.contacts[cc.cid]; chk := c.flags & CF_SIM_HIT != 0; fl ~= false
		for mi cc.mcount:
			m := &c.mans[mi]; k2 := &w.colors[ci].mc[cc.ms + mi]; m.twist = k2.twi; m.fi = blend2(k2.fi.x, k2.t1, k2.fi.y, k2.t2); m.ri = k2.ri
			for p k2.count:
				mp := &m.pts[p]; mp.ni = k2.pts[p].ni; mp.tni = k2.pts[p].tni; mp.nv = k2.pts[p].rv
				if chk && !fl && mp.nv < nh && mp.tni > 0.0: bit_grow_set(w.hit_bits, c.id); fl = true
prep_wide(w World&, ci int):
	col := &w.colors[ci]; ws := if w.warm { 1.0 } else { 0.0 }; n0 := col.convex.len; g := if n0 > 0 { ((n0 - 1) >> 2) + 1 } else { 0 }; col.wl.clear()
	for i 4 * g:
		l ~= Lane{..}
		if i < n0:
			cid := col.convex[i]; c := &w.contacts[cid]; m := &c.mans[0]; xa := c.bsa; xb := c.bsb; s1 := gst(w, xa); s2 := gst(w, xb)
			ma := if xa == -1 { 0.0 } else { w.sets[SET_AWAKE].sims[xa].im }; ia := if xa == -1 { M0 } else { w.sets[SET_AWAKE].sims[xa].iiw }
			mb := if xb == -1 { 0.0 } else { w.sets[SET_AWAKE].sims[xb].im }; ib := if xb == -1 { M0 } else { w.sets[SET_AWAKE].sims[xb].iiw }
			va := s1.v; wa := s1.w; vb := s2.v; wb := s2.w
			l.cid = cid; l.xa = xa + 1; l.xb = xb + 1; l.ma = ma; l.mb = mb; l.ia = sym(ia); l.ib = sym(ib)
			so := if xa == -1 || xb == -1 { w.ctx.ss } else { w.ctx.cs }; n := m.n; t1 := perp(n); t2 := cross(t1, n)
			l.n = n; l.t1 = t1; l.t2 = t2; l.fr = c.fr; l.rest = c.rest; l.roll = c.roll; l.tv1 = dot(c.tv, t1); l.tv2 = dot(c.tv, t2); l.br = so.bias; l.ms = so.ms; l.is = so.is; l.pc = m.count
			ca ~= V0; cb ~= V0; tw ~= 0.0 as f32
			for p m.count:
				mp := &m.pts[p]; cp := &l.pts[p]; ra := mp.aa; rb := mp.ab; s := mp.s; wt := fweight(s); ca = madd(ca, wt, ra); cb = madd(cb, wt, rb); tw += wt
				cp.ra = ra; cp.rb = rb; cp.bs = s - dot(rb - ra, n); cp.ni = ws * mp.ni; cp.tni = 0.0
				rna := cross(ra, n); rnb := cross(rb, n); kn := ma + mb + dot(rna, mv(ia, rna)) + dot(rnb, mv(ib, rnb)); cp.nm = if kn > 0.0 { 1.0 / kn } else { 0.0 }
				cp.rv = dot(n, (vb + cross(wb, rb)) - (va + cross(wa, ra)))
			iw := 1.0 / tw; ca = sv(iw, ca); cb = sv(iw, cb); l.ca = ca; l.cb = cb
			for p m.count: l.pts[p].lev = vdist(m.pts[p].aa, ca)
			a1 := cross(ca, t1); a2 := cross(ca, t2); b1 := cross(cb, t1); b2 := cross(cb, t2); kxy := dot(a1, mv(ia, a2)) + dot(b1, mv(ib, b2))
			tm := inv2(M2{float2{ma + mb + dot(a1, mv(ia, a1)) + dot(b1, mv(ib, b1)), kxy}, float2{kxy, ma + mb + dot(a2, mv(ia, a2)) + dot(b2, mv(ib, b2))}})
			l.tm = Sym{tm.cx.x, tm.cx.y, 0.0, tm.cy.y, 0.0, 0.0}; l.fi = float2{ws * dot(m.fi, t1), ws * dot(m.fi, t2)}
			kt := dot(n, mv(madd3(ia, ib), n)); l.twm = if kt > 0.0 { 1.0 / kt } else { 0.0 }; l.twi = ws * m.twist
			l.rm = sym(minv(madd3(ia, ib))); l.ri = float3{ws * m.ri.x, ws * m.ri.y, ws * m.ri.z}
		col.wl.push(l)
wgst(w World&, i int) BState: if i == 0 { BState{} } else { w.sets[SET_AWAKE].states[i - 1] }
wput(w World&, i int, v float3, a float3): if i != 0 && w.sets[SET_AWAKE].states[i - 1].flags & BF_DYNAMIC != 0 { s := &w.sets[SET_AWAKE].states[i - 1]; s.v = v; s.w = a }
gmax(w World&, ci int, g int) int: l := &w.colors[ci].wl; max(max(l[4 * g].pc, l[4 * g + 1].pc), max(l[4 * g + 2].pc, l[4 * g + 3].pc))
warm_wide(w World&, ci int):
	for g w.colors[ci].wl.len >> 2:
		pc := gmax(w, ci, g)
		for ln 4:
			l := &w.colors[ci].wl[4 * g + ln]; s1 := wgst(w, l.xa); s2 := wgst(w, l.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w
			for j pc: cp := &l.pts[j]; im := sv(cp.ni, l.n); wa = wa - smv(l.ia, cross(cp.ra, im)); va = msub(va, l.ma, im); wb = wb + smv(l.ib, cross(cp.rb, im)); vb = madd(vb, l.mb, im)
			im := madd(sv(l.fi.x, l.t1), l.fi.y, l.t2); wa = wa - smv(l.ia, cross(l.ca, im)); va = msub(va, l.ma, im); wb = wb + smv(l.ib, cross(l.cb, im)); vb = madd(vb, l.mb, im)
			ti := sv(l.twi, l.n); wa = wa - smv(l.ia, ti); wb = wb + smv(l.ib, ti); wa = wa - smv(l.ia, l.ri); wb = wb + smv(l.ib, l.ri)
			wput(w, l.xa, va, wa); wput(w, l.xb, vb, wb)
solve_wide(w World&, ci int, ub bool):
	ih := w.ctx.inv_h; csp := negw(w.cspeed)
	for g w.colors[ci].wl.len >> 2:
		pc := gmax(w, ci, g); b := 4 * g; anyr := w.colors[ci].wl[b].roll != 0.0 || w.colors[ci].wl[b + 1].roll != 0.0 || w.colors[ci].wl[b + 2].roll != 0.0 || w.colors[ci].wl[b + 3].roll != 0.0
		for ln 4:
			l := &w.colors[ci].wl[b + ln]; s1 := wgst(w, l.xa); s2 := wgst(w, l.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w
			br := if ub { l.ms * l.br } else { 0.0 }; msc := if ub { l.ms } else { 1.0 }; isc := if ub { l.is } else { 0.0 }
			dp := s2.dp - s1.dp; tn ~= 0.0 as f32; tl ~= 0.0 as f32
			for j pc:
				cp := &l.pts[j]; ra := cp.ra; rb := cp.rb; s := dot(l.n, dp + (rot(s2.dq, rb) - rot(s1.dq, ra))) + cp.bs; mk := s > 0.0
				bias := if mk { s * ih } else { maxw(br * s, csp) }; pm := if mk { 1.0 } else { msc }; pi := if mk { 0.0 } else { isc }
				vn := dot((vb + cross(wb, rb)) - (va + cross(wa, ra)), l.n); ng := cp.nm * (pm * vn + bias) + pi * cp.ni; ni := maxw(cp.ni - ng, 0.0); d := ni - cp.ni
				cp.ni = ni; cp.tni = cp.tni + ni; tn = tn + ni; tl = tl + cp.lev * ni; pp := sv(d, l.n)
				wa = wa - smv(l.ia, cross(ra, pp)); va = msub(va, l.ma, pp); wb = wb + smv(l.ib, cross(rb, pp)); vb = madd(vb, l.mb, pp)
			if !ub:
				if anyr:
					o := l.ri; l.ri = o + smv(l.rm, wa - wb); mx := l.roll * tn; l2 := dot(l.ri, l.ri)
					sc ~= if l2 > FLT_EPS + mx * mx { mx / (fsqrt(l2) + FLT_EPS) } else { 1.0 }
					sc = if l.roll > 0.0 { sc } else { 0.0 }
					l.ri = sv(sc, l.ri); d := l.ri - o; wa = wa - smv(l.ia, d); wb = wb + smv(l.ib, d)
				ts := dot(l.n, wb - wa); ml := l.fr * tl; di := negw(l.twm * ts); oi := l.twi; l.twi = minw(maxw(negw(ml), oi + di), ml); dt := l.twi - oi; lt := sv(dt, l.n)
				wa = wa - smv(l.ia, lt); wb = wb + smv(l.ib, lt)
				ra := l.ca; rb := l.cb; vr := (vb + cross(wb, rb)) - (va + cross(wa, ra)); vx := dot(vr, l.t1) - l.tv1; vy := dot(vr, l.t2) - l.tv2
				nx := l.fi.x + negw(l.tm.xx * vx + l.tm.xy * vy); ny := l.fi.y + negw(l.tm.xy * vx + l.tm.yy * vy); mx := l.fr * tn; l2 := nx * nx + ny * ny
				sc := if l2 > mx * mx { mx / (fsqrt(l2) + FLT_EPS) } else { 1.0 }; fx := sc * nx; fy := sc * ny; dx := fx - l.fi.x; dy := fy - l.fi.y; l.fi = float2{fx, fy}
				pp := sv(dx, l.t1) + sv(dy, l.t2); wa = wa - smv(l.ia, cross(ra, pp)); va = msub(va, l.ma, pp); wb = wb + smv(l.ib, cross(rb, pp)); vb = madd(vb, l.mb, pp)
			wput(w, l.xa, va, wa); wput(w, l.xb, vb, wb)
rest_wide(w World&, ci int):
	th := w.rest_th
	for g w.colors[ci].wl.len >> 2:
		b := 4 * g
		if w.colors[ci].wl[b].rest == 0.0 && w.colors[ci].wl[b + 1].rest == 0.0 && w.colors[ci].wl[b + 2].rest == 0.0 && w.colors[ci].wl[b + 3].rest == 0.0: continue
		pc := gmax(w, ci, g)
		for ln 4:
			l := &w.colors[ci].wl[b + ln]; s1 := wgst(w, l.xa); s2 := wgst(w, l.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w; rz := l.rest == 0.0
			for j pc:
				cp := &l.pts[j]; mk := cp.rv + th > 0.0 || cp.tni == 0.0 || rz; ms := if mk { 0.0 } else { cp.nm }
				vn := dot((vb + cross(wb, cp.rb)) - (va + cross(wa, cp.ra)), l.n); ng := ms * (vn + l.rest * cp.rv); ni := maxw(cp.ni - ng, 0.0); d := ni - cp.ni
				cp.ni = ni; cp.tni = cp.tni + d; pp := sv(d, l.n)
				wa = wa - smv(l.ia, cross(cp.ra, pp)); va = msub(va, l.ma, pp); wb = wb + smv(l.ib, cross(cp.rb, pp)); vb = madd(vb, l.mb, pp)
			wput(w, l.xa, va, wa); wput(w, l.xb, vb, wb)
store_wide(w World&, ci int):
	nh := -w.hit_th
	for i w.colors[ci].convex.len:
		l := &w.colors[ci].wl[i]; c := &w.contacts[l.cid]; m := &c.mans[0]
		m.fi = float3{l.fi.x * l.t1.x + l.fi.y * l.t2.x, l.fi.x * l.t1.y + l.fi.y * l.t2.y, l.fi.x * l.t1.z + l.fi.y * l.t2.z}; m.twist = l.twi; m.ri = l.ri
		for p m.count: m.pts[p].ni = l.pts[p].ni; m.pts[p].tni = l.pts[p].tni; m.pts[p].nv = l.pts[p].rv
		if c.flags & CF_SIM_HIT != 0:
			for p m.count: if m.pts[p].nv < nh && m.pts[p].tni > 0.0 { bit_grow_set(w.hit_bits, c.id); break }
should_create(w World&, a int, b int) bool:
	x := &w.shapes[a]; y := &w.shapes[b]
	if x.bid == y.bid || x.sensor != -1 || y.sensor != -1 || !should_shapes_collide(x.filter, y.filter): return false
	should_bodies_collide(w, x.bid, y.bid)
emit_compound(w World&, ks u64[>..]&, cs int, os int):
	box := bp_box(w.bp, w.shapes[os].pkey); lb := box_xform(xinv(body_xf(w, w.shapes[cs].bid)), box); n0 := ks.len
	tree_query(G_CPD[w.shapes[cs].cpd].tree, lb, 0xFFFFFFFFFFFFFFFF, false) { id, ud => k := pair_key(cs, os, ud as! int); if !contains(w.bp.pairs, k) { ks.push(k) }; true }
	if ks.len > n0 && !should_create(w, cs, os): ks.resize(n0)
pair_cand(w World&, ks u64[>..]&, a0 int, b0 int, cc bool):
	a := min(a0, b0); b := max(a0, b0)
	if cc && w.shapes[a].ty == SH_COMPOUND { emit_compound(w, ks, a, b) } else if cc && w.shapes[b].ty == SH_COMPOUND { emit_compound(w, ks, b, a) } else { k := pair_key(a, b, 0); if !contains(w.bp.pairs, k) && should_create(w, a, b) { ks.push(k) } }
update_pairs(w World&):
	ks u64[>..] ~= []; cc := w.ncpd > 0
	nd := bp_find(w.bp, cc) { a, b, c => pair_cand(w, ks, a, b, c) }
	if !nd: return
	qsort_b3(ks[..]) { a, b => a < b }
	for i ks.len: if i == 0 || ks[i] != ks[i - 1] { create_contact(w, key_a(ks[i]), key_b(ks[i]), key_c(ks[i])) }
collide_one(w World&, cid int, bits u64[>..]&):
	sa := w.contacts[cid].sa; sb := w.contacts[cid].sb
	if !box_overlaps(w.shapes[sa].fat, w.shapes[sb].fat): w.contacts[cid].flags = (w.contacts[cid].flags | CF_DISJOINT) & ~CF_SIM_TOUCHING; bit_grow_set(bits, cid); return
	ba := w.shapes[sa].bid; bb := w.shapes[sb].bid; sta := w.bodies[ba].ty == BODY_STATIC; stb := w.bodies[bb].ty == BODY_STATIC; was := w.contacts[cid].flags & CF_SIM_TOUCHING != 0
	ma := bsim(w, ba); mb := bsim(w, bb); xa := ma.xf; xb := mb.xf; fast := (ma.flags | mb.flags) & BF_FAST != 0
	w.contacts[cid].bsa = if sta { -1 } else { w.bodies[ba].li }; w.contacts[cid].bsb = if stb { -1 } else { w.bodies[bb].li }
	rd := w.crecycle; rt := if was { rd } else { fmin(rd, spec_dist()) }; c := &w.contacts[cid]
	if !fast && rd > 0.0 && c.flags & CF_REL_VALID != 0 && c.flags & CF_RECYCLE != 0:
		aa := qdot(xa.q, c.cqa); ab := qdot(xb.q, c.cqb); ad := fmin(aa * aa, ab * ab); x := ximul(xa, xb); xc := c.crp
		me := vmax(if sta { V0 } else { ma.maxx }, if stb { V0 } else { mb.maxx }); d2 := vdist2(x.p, xc.p)
		if ad > 0.99240388 && d2 < rt * rt:
			sl := rt - fsqrt(d2); qr := qimul(xc.q, x.q); arc := mcross(vabs(qv(qr)), me)
			if 4.0 * vlen2(arc) < sl * sl:
				r1 := qmat(qmul(xa.q, qconj(c.cqa))); r2 := qmat(qmul(xb.q, qconj(c.cqb))); dc := mb.c - ma.c
				for mi c.mans.len: n := c.mans[mi].n; for p c.mans[mi].count { mp := &c.mans[mi].pts[p]; mp.s = mp.bs + dot(dc + (mv(r2, mp.ab) - mv(r1, mp.aa)), n); mp.persisted = true }
				w.recycled += 1; bk := min(c.mans.len, 7)
				if bk > 0: w.mcounts[bk - 1] += 1
				return
	c.cqa = xa.q; c.cqb = xb.q; c.crp = ximul(xa, xb); c.flags |= CF_REL_VALID
	t := update_contact(w, cid, ma.lc, xa, mb.lc, xb, fast); c2 := &w.contacts[cid]; bk := min(c2.mans.len, 7)
	if bk > 0: w.mcounts[bk - 1] += 1
	if t && was && c2.flags & CF_MESH != 0: w.colors[c2.color].contacts[c2.li].mcount = c2.mans.len
	if t && !was { c2.flags |= CF_STARTED; bit_grow_set(bits, cid) } else if !t && was { c2.flags |= CF_STOPPED; bit_grow_set(bits, cid) }
	for mi c2.mans.len: for p c2.mans[mi].count { c2.mans[mi].pts[p].bs = c2.mans[mi].pts[p].s }
add_nontouching(w World&, cid int): c := &w.contacts[cid]; c.color = -1; c.li = w.sets[SET_AWAKE].cidx.len; c.bsa = -1; c.bsb = -1; w.sets[SET_AWAKE].cidx.push(cid)
collide(w World&, dt f32):
	ids int[>..] ~= []
	for i GRAPH_COLORS: ids.append(w.colors[i].convex[..]); for s w.colors[i].contacts { ids.push(s.cid) }
	ids.append(w.sets[SET_AWAKE].cidx[..])
	if ids.len == 0: return
	bits u64[>..] ~= []; w.sat_calls = 0; w.sat_hits = 0; w.recycled = 0; for i 8 { w.mcounts[i] = 0 }
	for cid ids: collide_one(w, cid, bits)
	if dt <= 0.0: w.sat_calls = 0; w.sat_hits = 0
	for k bits.len:
		wd ~= bits[k]
		while wd != 0:
			cid := 64 * k + ctz64(wd); wd &= wd - 1; fl := w.contacts[cid].flags
			if fl & CF_DISJOINT != 0:
				destroy_contact(w, cid, false)
			else if fl & CF_STARTED != 0:
				if fl & CF_EVENTS != 0: w.cbegin.push(shape_pair(w, w.contacts[cid]))
				w.contacts[cid].flags = (fl & ~CF_STARTED) | CF_TOUCHING; link_contact(w, cid); ol := w.contacts[cid].li; add_contact_graph(w, cid)
				if rswap(w.sets[SET_AWAKE].cidx, ol) >= 0: w.contacts[w.sets[SET_AWAKE].cidx[ol]].li = ol
			else if fl & CF_STOPPED != 0:
				w.contacts[cid].flags = fl & ~(CF_STOPPED | CF_TOUCHING)
				if fl & CF_EVENTS != 0: ev := shape_pair(w, w.contacts[cid]); if w.endix == 0 { w.cend0.push(ev) } else { w.cend1.push(ev) }
				ci := w.contacts[cid].color; li := w.contacts[cid].li; unlink_contact(w, cid); add_nontouching(w, cid)
				remove_contact_graph(w, w.contacts[cid].ed[0].bid, w.contacts[cid].ed[1].bid, ci, li, fl & CF_MESH != 0)
ctz64(x u64) int: n ~= 0; y ~= x; while y & 1 == 0 { y >>= 1; n += 1 }; n
integrate_velocities(w World&):
	h := w.ctx.h; g := w.gravity
	for i w.sets[SET_AWAKE].sims.len:
		s := &w.sets[SET_AWAKE].sims[i]; st := &w.sets[SET_AWAKE].states[i]
		ld := 1.0 / (1.0 + h * s.ld); ad := 1.0 / (1.0 + h * s.ad); gs := if s.im > 0.0 { s.gs } else { 0.0 }
		v := madd(blend2(h * s.im, s.f, h * gs, g), ld, st.v); wv := madd(sv(h, mv(s.iiw, s.t)), ad, st.w)
		q := qmul(st.dq, s.xf.q); il := minv(s.iil); o1 := irot(q, wv)
		i00 := il.cx.x; i01 := il.cy.x; i02 := il.cz.x; i11 := il.cy.y; i12 := il.cz.y; i22 := il.cz.z
		w1 := o1.x; w2 := o1.y; w3 := o1.z; iw1 := i00 * w1 + i01 * w2 + i02 * w3; iw2 := i01 * w1 + i11 * w2 + i12 * w3; iw3 := i02 * w1 + i12 * w2 + i22 * w3; dw := o1 - o1
		b := float3{i00 * dw.x + i01 * dw.y + i02 * dw.z + h * (w2 * iw3 - w3 * iw2), i01 * dw.x + i11 * dw.y + i12 * dw.z + h * (w3 * iw1 - w1 * iw3), i02 * dw.x + i12 * dw.y + i22 * dw.z + h * (w1 * iw2 - w2 * iw1)}
		jm := Mat3{float3{i00 + h * (w2 * i02 - w3 * i01), i01 + h * (w3 * i00 - w1 * i02 - iw3), i02 + h * (w1 * i01 - w2 * i00 + iw2)}, float3{i01 + h * (w2 * i12 - w3 * i11 + iw3), i11 + h * (w3 * i01 - w1 * i12), i12 + h * (w1 * i11 - w2 * i01 - iw1)}, float3{i02 + h * (w2 * i22 - w3 * i12 - iw2), i12 + h * (w3 * i02 - w1 * i22 + iw1), i22 + h * (w1 * i12 - w2 * i02)}}
		st.v = v; st.w = rot(q, o1 - solve3(jm, b))
integrate_positions(w World&):
	h := w.ctx.h; mls := w.ctx.max_v; mas := 0.25 * PI * w.ctx.inv_dt; ml2 := mls * mls; ma2 := mas * mas
	for i w.sets[SET_AWAKE].states.len:
		st := &w.sets[SET_AWAKE].states[i]; f := st.flags
		v ~= float3{if f & BF_LOCK_LX != 0 { 0.0 } else { st.v.x }, if f & BF_LOCK_LY != 0 { 0.0 } else { st.v.y }, if f & BF_LOCK_LZ != 0 { 0.0 } else { st.v.z }}
		a ~= float3{if f & BF_LOCK_AX != 0 { 0.0 } else { st.w.x }, if f & BF_LOCK_AY != 0 { 0.0 } else { st.w.y }, if f & BF_LOCK_AZ != 0 { 0.0 } else { st.w.z }}
		if dot(v, v) > ml2: v = sv(mls / vlen(v), v); st.flags |= BF_CAPPED
		if dot(a, a) > ma2 && st.flags & BF_FAST_ROT == 0: a = sv(mas / vlen(a), a); st.flags |= BF_CAPPED
		st.v = v; st.w = a; st.dp = madd(st.dp, h, v); st.dq = integrate_rot(st.dq, sv(h, a))
struct CCtx { fs int, fb int, sw Sweep, base float3, frac f32, sh Visitor[>..], sf f32[>..], di int, pi int, ri int }
shape_pts(w World&, s int) float3[>..]:
	x := &w.shapes[s]
	if x.ty == SH_CAPSULE: return [x.cap.center1, x.cap.center2]
	if x.ty == SH_SPHERE: return [x.sph.center]
	if x.ty == SH_HULL: return copy(w.hulls[x.hull].pts)
	[]
shape_rad(w World&, s int) f32: x := &w.shapes[s]; if x.ty == SH_CAPSULE { x.cap.radius } else if x.ty == SH_SPHERE { x.sph.radius } else { 0.0 }
rel_sweep(s BSim&, base float3) Sweep: Sweep{s.lc, s.c0 - base, s.c - base, s.q0, s.xf.q}
sweep_x1(s Sweep) Transform: Transform{s.c1 - rot(s.q1, s.lc), s.q1}
sweep_x2(s Sweep) Transform: Transform{s.c2 - rot(s.q2, s.lc), s.q2}
TOI0 := TOIOut{TOI_UNK, V0, V0, 0.0, 0.0, 0, 0, 0, false}
mesh_toi(tv MTriV, pb Proxy, sa Sweep, sb Sweep, mf f32&, out TOIOut&, c1 float3, c2 float3, lcb float3, fr f32, sensor bool):
	n := nrm(cross(tv.v2 - tv.v1, tv.v3 - tv.v1)); o1 := dot(n, c1 - tv.v1); o2 := dot(n, c2 - tv.v1)
	if o1 < 0.0: return
	if !sensor && o1 - o2 < fr && o2 > fr: return
	tri := [tv.v1, tv.v2, tv.v3]; o := time_of_impact(Proxy{tri[..], 0.0}, pb, sa, sb, mf)
	if 0.0 < o.frac && o.frac < mf { out = o; mf = o.frac } else if 0.0 == o.frac { lc := [lcb]; o2b := time_of_impact(Proxy{tri[..], 0.0}, Proxy{lc[..], fr + slop()}, sa, sb, mf); if 0.0 < o2b.frac && o2b.frac < mf { out = o2b; mf = o2b.frac; out.fallback = true } }
shape_toi(w World&, sa int, sb int, swa Sweep, swb Sweep, mf0 f32) TOIOut:
	ta := w.shapes[sa].ty; pts := shape_pts(w, sb); pb := Proxy{pts[..], shape_rad(w, sb)}; lcb := w.shapes[sb].lcen; out ~= TOI0; mf ~= mf0
	if ta == SH_COMPOUND:
		cd := &G_CPD[w.shapes[sa].cpd]; cx := Transform{swa.c1, swa.q1}; e := shape_extent(w, sb, lcb); fr := fmax(0.75 * e.x, spec_dist())
		lb := box_xform(xinv(cx), swept_box(w, sb, swb, mf))
		tree_query(cd.tree, lb, 0xFFFFFFFFFFFFFFFF, false) { id, ud =>
			ch := child_of(cd, ud as! int); csw := child_sweep(cx, ch.xf); o ~= TOI0;
			if ch.ty == SH_CAPSULE { c := [ch.cap.center1, ch.cap.center2]; o = time_of_impact(Proxy{c[..], ch.cap.radius}, pb, csw, swb, mf) } else if ch.ty == SH_HULL { o = time_of_impact(hull_proxy(cd.hs[ch.h]), pb, csw, swb, mf) } else if ch.ty == SH_SPHERE { c := [ch.sph.center]; o = time_of_impact(Proxy{c[..], ch.sph.radius}, pb, csw, swb, mf) } else {
				mw := xmul(cx, ch.xf); m1 := xipt(mw, xpt(sweep_x1(swb), lcb)); m2 := xipt(mw, xpt(sweep_x2(swb), lcb)); mo ~= TOI0; mmf ~= mf;
				for ti query_mesh(cd.ms[ch.m], ch.sc, box_xform(xinv(ch.xf), lb)) { mesh_toi(mesh_tri(cd.ms[ch.m], ch.sc, ti), pb, csw, swb, mmf, mo, m1, m2, lcb, fr, false) };
				o = mo
			};
			if 0.0 < o.frac && o.frac < mf { out = o; mf = o.frac };
			true
		}
		return out
	if ta == SH_HEIGHT || ta == SH_MESH:
		xa := sweep_x1(swa); m1 := xipt(xa, xpt(sweep_x1(swb), lcb)); m2 := xipt(xa, xpt(sweep_x2(swb), lcb)); e := shape_extent(w, sb, lcb); fr := fmax(0.5 * e.x, slop())
		lb := box_xform(xinv(xa), swept_box(w, sb, swb, mf)); sn := w.shapes[sa].sensor != -1
		if ta == SH_MESH { m := &G_MESH[w.shapes[sa].mesh]; for ti query_mesh(m, w.shapes[sa].msc, lb) { mesh_toi(mesh_tri(m, w.shapes[sa].msc, ti), pb, swa, swb, mf, out, m1, m2, lcb, fr, sn) } } else { f := &G_HF[w.shapes[sa].hf]; for ti query_hf(f, lb) { mesh_toi(hf_tri(f, ti), pb, swa, swb, mf, out, m1, m2, lcb, fr, sn) } }
		return out
	pa := shape_pts(w, sa); time_of_impact(Proxy{pa[..], shape_rad(w, sa)}, pb, swa, swb, mf)
cont_visit(w World&, cc CCtx&, sid int):
	fs := cc.fs
	if sid == fs || w.shapes[sid].bid == w.shapes[fs].bid: return
	sn := w.shapes[sid].sensor != -1
	if sn && (w.shapes[sid].flags & SF_SENSOR_EV == 0 || w.shapes[fs].flags & SF_SENSOR_EV == 0): return
	if !should_shapes_collide(w.shapes[fs].filter, w.shapes[sid].filter): return
	bid := w.shapes[sid].bid
	if bsim(w, bid).flags & BF_BULLET != 0 || !should_bodies_collide(w, w.shapes[fs].bid, bid): return
	o := shape_toi(w, sid, fs, rel_sweep(bsim(w, bid), cc.base), cc.sw, cc.frac)
	if sn:
		if o.frac <= cc.frac && cc.sh.len < 8: cc.sh.push(Visitor{sid, fs}); cc.sf.push(o.frac)
	else if 0.0 < o.frac && o.frac < cc.frac:
		w.sets[SET_AWAKE].sims[cc.fb].flags |= BF_HAD_TOI; cc.frac = o.frac; cc.di = max(cc.di, o.diters); cc.pi = max(cc.pi, o.piters); cc.ri = max(cc.ri, o.riters)
enlarge_fat(w World&, s int, si int, bullet bool):
	x := &w.shapes[s]
	if !box_contains(x.fat, x.aabb):
		m := x.margin; r := float3{m, m, m}; x.fat = AABB{x.aabb.lower - r, x.aabb.upper + r}; w.sets[SET_AWAKE].sims[si].flags |= BF_ENLARGE
		if !bullet: tree_mark_moved(w.bp.tr[x.pkey & 3], x.pkey >> 2, x.fat)
solve_continuous(w World&, si int):
	fsim := w.sets[SET_AWAKE].sims[si]; base := fsim.c0; sw := rel_sweep(fsim, base); x1 := sweep_x1(sw); x2 := sweep_x2(sw); bid := fsim.bid
	cc ~= CCtx{-1, si, sw, base, 1.0, [], [], 0, 0, 0}; bl := fsim.flags & BF_BULLET != 0; sid ~= w.bodies[bid].hsh
	while sid != -1:
		fs := sid; sid = w.shapes[fs].next; cc.fs = fs
		b1 := w.shapes[fs].aabb; b2l := shape_box(w, fs, x2); b2 := AABB{base + b2l.lower, base + b2l.upper}; w.shapes[fs].aabb = b2
		if w.shapes[fs].ty == SH_MESH || w.shapes[fs].ty == SH_HEIGHT || w.shapes[fs].sensor != -1: continue
		sb := box_union(b1, b2)
		tree_query(w.bp.tr[0], sb, 0xFFFFFFFFFFFFFFFF, false) { id, ud => cont_visit(w, cc, ud as! int); true }
		if bl: for t 1..3 { tree_query(w.bp.tr[t], sb, 0xFFFFFFFFFFFFFFFF, false) { id, ud => cont_visit(w, cc, ud as! int); true } }
	s := &w.sets[SET_AWAKE].sims[si]
	if cc.frac < 1.0:
		q := qnlerp(sw.q1, sw.q2, cc.frac); c := vlerp(sw.c1, sw.c2, cc.frac); org := c - rot(q, sw.lc); xf := Transform{base + org, q}; cen := base + c
		s.xf = xf; s.c = cen; s.q0 = q; s.c0 = cen; w.moves[si].xf = xf; k ~= w.bodies[bid].hsh
		while k != -1: w.shapes[k].aabb = fat_box(w, k, xf, spec_dist()); enlarge_fat(w, k, si, bl); k = w.shapes[k].next
	else:
		s.q0 = s.xf.q; s.c0 = s.c; k ~= w.bodies[bid].hsh
		while k != -1: enlarge_fat(w, k, si, bl); k = w.shapes[k].next
	for i cc.sh.len: if cc.sf[i] < cc.frac { w.cont_hits.push(cc.sh[i]) }
finalize_bodies(w World&, bullets int[>..]&):
	dt := w.ctx.dt; idt := w.ctx.inv_dt; sd := spec_dist()
	for si w.sets[SET_AWAKE].sims.len:
		st := &w.sets[SET_AWAKE].states[si]; s := &w.sets[SET_AWAKE].sims[si]; v := st.v; wv := st.w
		lo := irot(s.xf.q, wv); ldr := irot(s.xf.q, qv(st.dq))
		s.c = s.c + st.dp; s.xf.q = qnrm(qmul(st.dq, s.xf.q))
		mvel := vlen(v) + vlen(mcross(vabs(lo), s.maxx)); mdp := vlen(st.dp) + 2.0 * vlen(mcross(vabs(ldr), s.maxx)); svel := fmax(mvel, 0.5 * idt * mdp)
		st.dp = V0; st.dq = QI; s.xf.p = s.c + -rot(s.xf.q, s.lc)
		bid := s.bid; b := &w.bodies[bid]; b.bmi = si; b.svel = svel
		w.moves[si] = MoveEv{s.xf, bid, b.gen, b.ud, false}; s.f = V0; s.t = V0
		b.flags = (b.flags & ~BF_TRANSIENT) | (s.flags & (BF_CAPPED | BF_HAD_TOI)) | (st.flags & (BF_CAPPED | BF_HAD_TOI)); s.flags &= ~BF_TRANSIENT; st.flags &= ~BF_TRANSIENT
		if !w.sleep || b.flags & BF_SLEEP == 0 || svel > b.sth:
			b.stime = 0.0; mm2 := fmax(mdp, mvel * dt)
			if b.ty == BODY_DYNAMIC && w.continuous && mm2 > b.safety * s.minx { s.flags |= BF_FAST; if s.flags & BF_BULLET != 0 { bullets.push(si) } else { solve_continuous(w, si) } } else { s.c0 = s.c; s.q0 = s.xf.q }
		else:
			s.c0 = s.c; s.q0 = s.xf.q; b.stime += dt
		s2 := &w.sets[SET_AWAKE].sims[si]; r := qmat(s2.xf.q); s2.iiw = mm(mm(r, s2.iil), mt(r))
		b2 := &w.bodies[bid]; il := &w.islands[b2.isl]
		if b2.stime < 0.5 { bit_set(w.awake_isl, il.li) } else if il.crc > 0 { if b2.stime > w.split_sleep || (b2.stime == w.split_sleep && b2.isl > w.split_cand) { w.split_cand = b2.isl; w.split_sleep = b2.stime } }
		if s2.flags & BF_FAST == 0:
			xf := s2.xf; k ~= b2.hsh
			while k != -1:
				x := &w.shapes[k]; x.aabb = fat_box(w, k, xf, sd)
				if !box_contains(x.fat, x.aabb): m := x.margin; rr := float3{m, m, m}; x.fat = AABB{x.aabb.lower - rr, x.aabb.upper + rr}; tree_mark_moved(w.bp.tr[x.pkey & 3], x.pkey >> 2, x.fat)
				k = x.next
active_colors(w World&) int[>..]:
	o int[>..] ~= []
	for i OVERFLOW: if w.colors[i].convex.len + w.colors[i].contacts.len + w.colors[i].jsims.len > 0 { o.push(i) }
	o
joint_reaction(w World&, j JointSim&, ih f32) float2:
	r ~= float2{0.0, 0.0}; t := j.ty
	if t == J_SPHERICAL:
		xa := body_xf(w, j.ba); xb := body_xf(w, j.bb); ca := rot(qmul(xa.q, j.lfa.q), AX_Z); tw := rot(qmul(xb.q, j.lfb.q), AX_Z); sa := nrm(cross(ca, tw))
		r = float2{vlen(j.sp.li), vlen(madd(madd(j.sp.si + j.sp.mi, j.sp.lti - j.sp.uti, tw), j.sp.swi, sa))}
	else if t == J_WHEEL: ax := j.wh.ssi + j.wh.lsi - j.wh.usi; r = float2{fsqrt(j.wh.li.x * j.wh.li.x + j.wh.li.y * j.wh.li.y + ax * ax), fabs(j.wh.spi)}
	else: r = if t == J_PARALLEL { float2{0.0, vlen(float3{j.pa.pi.x, j.pa.pi.y, 0.0})} } else if t == J_DISTANCE { float2{fabs(j.d.imp + j.d.limp - j.d.uimp + j.d.mimp), 0.0} } else if t == J_MOTOR { float2{vlen(j.mo.lvi + j.mo.lsi), vlen(j.mo.avi + j.mo.asi)} } else if t == J_PRISMATIC { float2{vlen(float3{j.pr.mi + j.pr.loi - j.pr.upi, j.pr.pi.x, j.pr.pi.y}), vlen(j.pr.ai)} } else if t == J_REVOLUTE { float2{vlen(j.rv.li), vlen(float3{j.rv.pi.x, j.rv.pi.y, j.rv.mi + j.rv.loi - j.rv.upi})} } else if t == J_WELD { float2{vlen(j.we.li), vlen(j.we.ai)} } else { r }
	float2{r.x * ih, r.y * ih}
solve_color_joints(w World&, ci int, ub bool):
	for i w.colors[ci].jsims.len:
		solve_joint(w, w.colors[ci].jsims[i], ub); j := &w.colors[ci].jsims[i]
		if ub && (j.fth < FLT_MAX || j.tth < FLT_MAX) && !bit_get(w.jstate_bits, j.jid):
			r := joint_reaction(w, j, w.ctx.inv_h)
			if r.x >= j.fth || r.y >= j.tth: bit_grow_set(w.jstate_bits, j.jid)
color_pass(w World&, ac int[>..]&, k int, ub bool):
	for ci ac:
		if k == 0 { for i w.colors[ci].jsims.len { warm_joint(w, w.colors[ci].jsims[i]) }; warm_wide(w, ci); warm_mesh_contacts(w, ci) } else if k == 1 { solve_color_joints(w, ci, ub); solve_wide(w, ci, ub); solve_mesh_contacts(w, ci, ub) } else { rest_wide(w, ci); rest_mesh_contacts(w, ci) }
solve(w World&):
	w.step += 1; n := w.sets[SET_AWAKE].sims.len
	if n == 0: return
	bullets int[>..] ~= []; ac := active_colors(w)
	while w.moves.len < n: w.moves.push(MoveEv{XI, -1, 0, 0, false})
	w.moves.resize(n)
	if w.split != -1: split_island(w, w.split)
	bit_reset(w.jstate_bits, w.joints.len); bit_reset(w.hit_bits, w.contacts.len)
	for ci ac: for i w.colors[ci].jsims.len { prepare_joint(w, w.colors[ci].jsims[i]) }
	for ci ac: prep_wide(w, ci)
	for ci ac: prep_mesh_contacts(w, ci)
	for i w.colors[OVERFLOW].jsims.len: prepare_joint(w, w.colors[OVERFLOW].jsims[i])
	prep_mesh_contacts(w, OVERFLOW)
	for st w.ctx.sub:
		integrate_velocities(w)
		for i w.colors[OVERFLOW].jsims.len: warm_joint(w, w.colors[OVERFLOW].jsims[i])
		warm_mesh_contacts(w, OVERFLOW); color_pass(w, ac, 0, true)
		solve_color_joints(w, OVERFLOW, true); solve_mesh_contacts(w, OVERFLOW, true); color_pass(w, ac, 1, true)
		integrate_positions(w)
		solve_color_joints(w, OVERFLOW, false); solve_mesh_contacts(w, OVERFLOW, false); color_pass(w, ac, 1, false)
	rest_mesh_contacts(w, OVERFLOW); color_pass(w, ac, 2, false)
	store_mesh_contacts(w, OVERFLOW)
	for ci ac: store_wide(w, ci)
	for ci ac: store_mesh_contacts(w, ci)
	w.split = -1; bit_reset(w.awake_isl, w.sets[SET_AWAKE].isims.len); w.split_cand = -1; w.split_sleep = 0.0; w.cont_hits.clear()
	finalize_bodies(w, bullets)
	for k w.jstate_bits.len:
		wd ~= w.jstate_bits[k]
		while wd != 0: jid := 64 * k + ctz64(wd); wd &= wd - 1; w.jevents.push(JointEv{jid, w.joints[jid].gen, w.joints[jid].ud})
	hit_events(w)
	tree_refit(w.bp.tr[1]); tree_refit(w.bp.tr[2])
	for si bullets: solve_continuous(w, si)
	for si bullets:
		s := &w.sets[SET_AWAKE].sims[si]
		if s.flags & BF_ENLARGE == 0: continue
		s.flags &= ~BF_ENLARGE; k ~= w.bodies[s.bid].hsh
		while k != -1: x := &w.shapes[k]; p := x.pkey >> 2; if !box_contains(bp_box(w.bp, x.pkey), x.fat) { tree_enlarge(w.bp.tr[2], p, x.fat) }; k = x.next
	for h w.cont_hits: w.sensors[w.shapes[h.sid].sensor].hits.push(Visitor{h.gen, w.shapes[h.gen].gen})
	if w.sleep:
		if w.split_cand != -1: w.split = w.split_cand
		i ~= w.sets[SET_AWAKE].isims.len - 1
		while i >= 0: if !bit_get(w.awake_isl, i) { try_sleep_island(w, w.sets[SET_AWAKE].isims[i]) }; i -= 1
hit_events(w World&):
	th := w.hit_th
	for k w.hit_bits.len:
		wd ~= w.hit_bits[k]
		while wd != 0:
			cid := 64 * k + ctz64(wd); wd &= wd - 1; c := &w.contacts[cid]; sa := &w.shapes[c.sa]; sb := &w.shapes[c.sb]
			mc := vlerp(bsim(w, sa.bid).c, bsim(w, sb.bid).c, 0.5); sp ~= th; pt ~= V0; nn ~= V0; tri ~= 0; fd ~= false
			for mi c.mans.len: for p c.mans[mi].count { mp := &c.mans[mi].pts[p]; a := -mp.nv; if a > sp && mp.tni > 0.0 { sp = a; pt = mc + vlerp(mp.aa, mp.ab, 0.5); nn = c.mans[mi].n; tri = mp.tri; fd = true } }
			if fd: w.hits.push(HitEv{sa.id, sa.gen, sb.id, sb.gen, cid, c.gen, pt, nn, sp, mat_uid(w, c.sa, c.child, tri), mat_uid(w, c.sb, 0, tri)})
mat_uid(w World&, s int, child int, tri int) u64:
	x := &w.shapes[s]
	if x.ty == SH_MESH: return x.mats[iclamp(G_MESH[x.mesh].mat[tri] as int, 0, x.mats.len - 1)].uid
	if x.ty == SH_HEIGHT: return x.mats[iclamp(G_HF[x.hf].mat[tri >> 1] as int, 0, x.mats.len - 1)].uid
	if x.ty == SH_COMPOUND: ch := child_of(G_CPD[x.cpd], child); return x.mats[if ch.ty == SH_MESH { ch.mi[min(G_CPD[x.cpd].ms[ch.m].mat[tri] as int, 3)] } else { ch.mi[0] }].uid
	x.mats[0].uid
sensor_visit(w World&, se int, sid int, xf Transform, oid int):
	if oid == sid: return
	o := &w.shapes[oid]; t := o.ty
	if !(t == SH_CAPSULE || t == SH_HULL || t == SH_SPHERE) || o.flags & SF_SENSOR_EV == 0 || o.bid == w.shapes[sid].bid || !should_shapes_collide(w.shapes[sid].filter, o.filter): return
	rel := ximul(xf, body_xf(w, o.bid)); pts := shape_pts(w, oid); lp float3[>..] ~= []
	for p pts: lp.push(xpt(rel, p))
	px := Proxy{lp[..], shape_rad(w, oid)}; x := &w.shapes[sid]; st := x.ty
	ov := if st == SH_CAPSULE { overlap_capsule(x.cap, XI, px) } else if st == SH_COMPOUND { overlap_compound(G_CPD[x.cpd], XI, px) } else if st == SH_HEIGHT { overlap_hf(G_HF[x.hf], XI, px) } else if st == SH_HULL { overlap_hull(w.hulls[x.hull], XI, px) } else if st == SH_MESH { overlap_mesh(G_MESH[x.mesh], x.msc, XI, px) } else if st == SH_SPHERE { overlap_sphere(x.sph, XI, px) } else { false }
	if ov: w.sensors[se].o2.push(Visitor{oid, o.gen})
overlap_sensors(w World&):
	if w.sensors.len == 0: return
	ev bool[>..] ~= []
	for se w.sensors.len:
		sid := w.sensors[se].sid; t := copy(w.sensors[se].o1); w.sensors[se].o1 = copy(w.sensors[se].o2); w.sensors[se].o2 = t; w.sensors[se].o2.clear()
		w.sensors[se].o2.append(w.sensors[se].hits[..]); w.sensors[se].hits.clear(); bid := w.shapes[sid].bid
		if w.bodies[bid].set == SET_DISABLED || w.shapes[sid].flags & SF_SENSOR_EV == 0: ev.push(w.sensors[se].o1.len != 0); continue
		xf := body_xf(w, bid); qb := w.shapes[sid].aabb; mk := w.shapes[sid].filter.mask
		for tt 3: tree_query(w.bp.tr[tt], qb, mk, false) { id, ud => sensor_visit(w, se, sid, xf, ud as! int); true }
		o2 := &w.sensors[se].o2; sort(o2[..]) { a, b => a.sid < b.sid }; u ~= 0
		for i o2.len: if u == 0 || o2[i].sid != o2[u - 1].sid { o2[u] = o2[i]; u += 1 }
		o2.resize(u); o1 := &w.sensors[se].o1; d ~= o1.len != o2.len
		if !d: for i o1.len { if o1[i].sid != o2[i].sid || o1[i].gen != o2[i].gen { d = true; break } }
		ev.push(d)
	for se w.sensors.len:
		if !ev[se]: continue
		sid := w.sensors[se].sid; sg := w.shapes[sid].gen; r1 := &w.sensors[se].o1; r2 := &w.sensors[se].o2; i ~= 0; j ~= 0
		while i < r1.len || j < r2.len:
			if i < r1.len && j < r2.len && r1[i].sid == r2[j].sid:
				if r1[i].gen < r2[j].gen { send(w, ShapePair{sid, sg, r1[i].sid, r1[i].gen, 0, 0}); i += 1 } else if r1[i].gen > r2[j].gen { w.sbegin.push(ShapePair{sid, sg, r2[j].sid, r2[j].gen, 0, 0}); j += 1 } else { i += 1; j += 1 }
			else if j >= r2.len || (i < r1.len && r1[i].sid < r2[j].sid):
				send(w, ShapePair{sid, sg, r1[i].sid, r1[i].gen, 0, 0}); i += 1
			else:
				w.sbegin.push(ShapePair{sid, sg, r2[j].sid, r2[j].gen, 0, 0}); j += 1
send(w World&, e ShapePair): if w.endix == 0 { w.send0.push(e) } else { w.send1.push(e) }
world_step(w World&, dt f32, sub int):
	w.locked = true; w.moves.clear(); w.sbegin.clear(); w.cbegin.clear(); w.hits.clear(); w.jevents.clear()
	c := &w.maxcap; c.ss = max(c.ss, w.bp.tr[0].pcount); c.ds = max(c.ds, w.bp.tr[2].pcount); sbc := w.sets[SET_STATIC].sims.len; c.sb = max(c.sb, sbc); c.db = max(c.db, id_count(w.bpool) - sbc); c.c = max(c.c, id_count(w.cpool))
	update_pairs(w)
	x := &w.ctx; x.dt = dt; x.sub = max(1, sub)
	if dt > 0.0 { x.inv_dt = 1.0 / dt; x.h = dt / x.sub as f32; x.inv_h = x.sub as f32 * x.inv_dt } else { x.inv_dt = 0.0; x.h = 0.0; x.inv_h = 0.0 }
	w.inv_h = x.inv_h; w.inv_dt = x.inv_dt; hz := fmin(w.chz, 0.125 * x.inv_h)
	x.cs = make_soft(hz, w.cdr, x.h); x.ss = make_soft(2.0 * hz, 0.5 * w.cdr, x.h); x.rest_th = w.rest_th; x.max_v = w.max_speed; x.warm = w.warm
	collide(w, dt)
	if dt > 0.0: solve(w)
	overlap_sensors(w)
	w.endix = 1 - w.endix
	if w.endix == 0 { w.send0.clear(); w.cend0.clear() } else { w.send1.clear(); w.cend1.clear() }
	w.locked = false
destroy_sensor(w World&, sid int):
	se := w.shapes[sid].sensor; sg := w.shapes[sid].gen
	for r w.sensors[se].o2: send(w, ShapePair{sid, sg, r.sid, r.gen, 0, 0})
	if rswap(w.sensors, se) >= 0: w.shapes[w.sensors[se].sid].sensor = se
struct JDef { ba int = -1, bb int = -1, lfa Transform = XI, lfb Transform = XI, fth f32 = FLT_MAX, tth f32 = FLT_MAX, chz f32 = 60.0, cdr f32 = 2.0, dscale f32 = 1.0, ud u64 = 0, collide bool = false }
destroy_contacts_between(w World&, ba int, bb int):
	a := ba; b := bb; k ~= if w.bodies[a].ccount < w.bodies[b].ccount { w.bodies[a].hck } else { w.bodies[b].hck }; o := if w.bodies[a].ccount < w.bodies[b].ccount { b } else { a }
	while k != -1:
		cid := k >> 1; e := k & 1; k = w.contacts[cid].ed[e].next
		if w.contacts[cid].ed[e ^ 1].bid == o: destroy_contact(w, cid, false)
link_jedge(w World&, jid int, e int, bid int):
	j := &w.joints[jid]; key := (jid << 1) | e; h := w.bodies[bid].hjk; j.ed[e] = CEdge{bid, -1, h}
	if h != -1: w.joints[h >> 1].ed[h & 1].prev = key
	w.bodies[bid].hjk = key; w.bodies[bid].jcount += 1
create_joint(w World&, d JDef&, js0 JointSim) int:
	ba := d.ba; bb := d.bb
	if !d.collide: destroy_contacts_between(w, ba, bb)
	mx := max(w.bodies[ba].set, w.bodies[bb].set); jid := id_alloc(w.jpool)
	if jid == w.joints.len: w.joints.push(Joint{..})
	g := w.joints[jid].gen + 1; w.joints[jid] = Joint{..}; j := &w.joints[jid]
	j.jid = jid; j.ud = d.ud; j.gen = g; j.dscale = d.dscale; j.ty = js0.ty; j.collide = d.collide
	link_jedge(w, jid, 0, ba); link_jedge(w, jid, 1, bb)
	js ~= js0; js.jid = jid; js.ba = ba; js.bb = bb; js.lfa = d.lfa; js.lfb = d.lfb; js.chz = d.chz; js.cdr = d.cdr; js.cs = Soft{0.0, 1.0, 0.0}; js.fth = d.fth; js.tth = d.tth
	sa := w.bodies[ba].set; sb := w.bodies[bb].set
	if sa == SET_DISABLED || sb == SET_DISABLED || (w.bodies[ba].ty != BODY_DYNAMIC && w.bodies[bb].ty != BODY_DYNAMIC):
		si := if sa == SET_DISABLED || sb == SET_DISABLED { SET_DISABLED } else { SET_STATIC }; w.joints[jid].set = si; w.joints[jid].li = w.sets[si].jsims.len; w.sets[si].jsims.push(js)
	else if sa == SET_AWAKE || sb == SET_AWAKE:
		if mx >= SET_SLEEP: wake_set(w, mx)
		w.joints[jid].set = SET_AWAKE; add_joint_graph(w, js, jid)
	else:
		w.joints[jid].set = mx; w.joints[jid].li = w.sets[mx].jsims.len; w.sets[mx].jsims.push(js)
		if sa != sb && sa >= SET_SLEEP && sb >= SET_SLEEP: merge_sets(w, sa, sb)
	if w.joints[jid].set > SET_DISABLED: link_joint(w, jid)
	jid
unlink_jedge(w World&, jid int, e int):
	ed := w.joints[jid].ed[e]; bid := ed.bid
	if ed.prev != -1: w.joints[ed.prev >> 1].ed[ed.prev & 1].next = ed.next
	if ed.next != -1: w.joints[ed.next >> 1].ed[ed.next & 1].prev = ed.prev
	if w.bodies[bid].hjk == (jid << 1) | e: w.bodies[bid].hjk = ed.next
	w.bodies[bid].jcount -= 1
destroy_joint_internal(w World&, jid int, wake bool):
	ba := w.joints[jid].ed[0].bid; bb := w.joints[jid].ed[1].bid
	unlink_jedge(w, jid, 0); unlink_jedge(w, jid, 1)
	if w.joints[jid].isl != -1: unlink_joint(w, jid)
	si := w.joints[jid].set; li := w.joints[jid].li
	if si == SET_AWAKE { remove_joint_graph(w, ba, bb, w.joints[jid].color, li) } else if rswap(w.sets[si].jsims, li) >= 0 { w.joints[w.sets[si].jsims[li].jid].li = li }
	j := &w.joints[jid]; j.set = -1; j.li = -1; j.color = -1; j.jid = -1; id_free(w.jpool, jid)
	if wake: wake_body(w, ba); wake_body(w, bb)
dist_joint(len f32, hz f32, dr f32, spring bool, limit bool, minl f32, maxl f32, motor bool, mmf f32, ms f32) JointSim:
	j ~= JointSim{..}; j.ty = J_DISTANCE; j.d = JDist{..}; j.d.len = fmax(len, slop()); j.d.hz = hz; j.d.dr = dr; j.d.lsf = -FLT_MAX; j.d.usf = FLT_MAX; j.d.minl = fmax(minl, slop()); j.d.maxl = fmax(minl, maxl); j.d.mmf = mmf; j.d.ms = ms; j.d.spring = spring; j.d.limit = limit; j.d.motor = motor; j
rev_joint(hz f32, dr f32, spring bool, ta f32, limit bool, la f32, ua f32, motor bool, mmt f32, ms f32) JointSim:
	j ~= JointSim{..}; j.ty = J_REVOLUTE; j.rv = JRev{..}; j.rv.hz = hz; j.rv.dr = dr; j.rv.ta = fclamp(ta, -PI, PI); lo := fmin(la, ua); hi := fmax(la, ua)
	j.rv.la = fclamp(lo, -0.99 * PI, 0.99 * PI); j.rv.ua = fclamp(hi, -0.99 * PI, 0.99 * PI); j.rv.mmt = mmt; j.rv.ms = ms; j.rv.spring = spring; j.rv.limit = limit; j.rv.motor = motor; j
sph_joint(hz f32, dr f32, spring bool, tq Quat, cl bool, cone f32, tl bool, lta f32, uta f32, motor bool, mmt f32, mvel float3) JointSim:
	j ~= JointSim{..}; j.ty = J_SPHERICAL; j.sp = JSph{..}; j.sp.hz = hz; j.sp.dr = dr; j.sp.tq = tq; j.sp.cone = fclamp(cone, 0.0, 0.5 * PI); lo := fmin(lta, uta); hi := fmax(lta, uta)
	j.sp.lta = fclamp(lo, -0.99 * PI, 0.99 * PI); j.sp.uta = fclamp(hi, -0.99 * PI, 0.99 * PI); j.sp.mmt = mmt; j.sp.mvel = mvel; j.sp.spring = spring; j.sp.cl = cl; j.sp.tl = tl; j.sp.motor = motor; j
awake_state(w World&, bid int) bool: w.bodies[bid].set == SET_AWAKE
set_body_xf(w World&, bid int, p float3, q Quat):
	s := &bsim(w, bid); s.xf = Transform{p, q}; s.c = xpt(s.xf, s.lc); r := qmat(q); s.iiw = mm(mm(r, s.iil), mt(r)); s.q0 = q; s.c0 = s.c; xf := s.xf; k ~= w.bodies[bid].hsh
	while k != -1:
		x := &w.shapes[k]; x.aabb = fat_box(w, k, xf, spec_dist())
		if !box_contains(x.fat, x.aabb): m := x.margin; r2 := float3{m, m, m}; x.fat = AABB{x.aabb.lower - r2, x.aabb.upper + r2}; if x.pkey != -1 { bp_move(w.bp, x.pkey, x.fat) }
		k = x.next
lin_vel(w World&, bid int) float3: if awake_state(w, bid) { bstate(w, bid).v } else { V0 }
ang_vel(w World&, bid int) float3: if awake_state(w, bid) { bstate(w, bid).w } else { V0 }
set_lin_vel(w World&, bid int, v float3):
	if w.bodies[bid].ty == BODY_STATIC: return
	if vlen2(v) > 0.0: wake_body(w, bid)
	if awake_state(w, bid): bstate(w, bid).v = v
set_ang_vel(w World&, bid int, a float3):
	if w.bodies[bid].ty == BODY_STATIC: return
	f := w.bodies[bid].flags; v := float3{if f & BF_LOCK_AX != 0 { 0.0 } else { a.x }, if f & BF_LOCK_AY != 0 { 0.0 } else { a.y }, if f & BF_LOCK_AZ != 0 { 0.0 } else { a.z }}
	if vlen2(v) != 0.0: wake_body(w, bid)
	if awake_state(w, bid): bstate(w, bid).w = v
set_target_xf(w World&, bid int, t Transform, ts f32, wake bool):
	b := &w.bodies[bid]
	if b.set == SET_DISABLED || b.ty == BODY_STATIC || ts <= 0.0 || (b.set != SET_AWAKE && !wake): return
	s := &bsim(w, bid); it := 1.0 / ts; lv := sv(it, xpt(t, s.lc) - s.c); q1 := s.xf.q; q2 := if qdot(q1, t.q) < 0.0 { qneg(t.q) } else { t.q }
	om := qmul(mkq(qv(q2) - qv(q1), q2.w - q1.w), qconj(q1)); av := sv(2.0 * it, qv(om))
	if w.bodies[bid].set != SET_AWAKE:
		if vlen(lv) + vlen(av * s.maxx) < w.bodies[bid].sth: return
		wake_body(w, bid)
	st := &bstate(w, bid); st.v = lv; st.w = av
local_point_vel(w World&, bid int, lp float3) float3: if !awake_state(w, bid) { return V0 }; s := &bsim(w, bid); st := &bstate(w, bid); st.v + cross(st.w, rot(s.xf.q, lp - s.lc))
world_point_vel(w World&, bid int, wp float3) float3: if !awake_state(w, bid) { return V0 }; s := &bsim(w, bid); st := &bstate(w, bid); st.v + cross(st.w, wp - s.c)
wake_if(w World&, bid int, wake bool): if wake && w.bodies[bid].set >= SET_SLEEP { wake_body(w, bid) }
apply_force(w World&, bid int, f float3, p float3, wake bool):
	wake_if(w, bid, wake)
	if awake_state(w, bid): s := &bsim(w, bid); s.f = s.f + f; s.t = s.t + cross(p - s.c, f)
apply_force_center(w World&, bid int, f float3, wake bool):
	wake_if(w, bid, wake)
	if awake_state(w, bid): s := &bsim(w, bid); s.f = s.f + f
apply_torque(w World&, bid int, t float3, wake bool):
	wake_if(w, bid, wake)
	if awake_state(w, bid): s := &bsim(w, bid); s.t = s.t + t
cap_lin(w World&, st BState&): ms := w.max_speed; if vlen2(st.v) > ms * ms { st.v = sv(ms, nrm(st.v)) }
apply_impulse(w World&, bid int, im float3, p float3, wake bool):
	wake_if(w, bid, wake)
	if awake_state(w, bid): s := &bsim(w, bid); st := &bstate(w, bid); st.v = madd(st.v, s.im, im); cap_lin(w, st); st.w = st.w + mv(s.iiw, cross(p - s.c, im))
apply_impulse_center(w World&, bid int, im float3, wake bool):
	wake_if(w, bid, wake)
	if awake_state(w, bid): s := &bsim(w, bid); st := &bstate(w, bid); st.v = madd(st.v, s.im, im); cap_lin(w, st)
apply_ang_impulse(w World&, bid int, im float3, wake bool):
	wake_if(w, bid, wake)
	if awake_state(w, bid): s := &bsim(w, bid); st := &bstate(w, bid); st.w = st.w + rot(s.xf.q, mv(s.iil, irot(s.xf.q, im)))
jlist(w World&, bid int) int[>..]:
	o int[>..] ~= []; k ~= w.bodies[bid].hjk
	while k != -1: o.push(k); k = w.joints[k >> 1].ed[k & 1].next
	o
slist(w World&, bid int) int[>..]:
	o int[>..] ~= []; k ~= w.bodies[bid].hsh
	while k != -1: o.push(k); k = w.shapes[k].next
	o
set_type_flag(w World&, bid int, ty int): w.bodies[bid].ty = ty; w.bodies[bid].flags = if ty == BODY_DYNAMIC { w.bodies[bid].flags | BF_DYNAMIC } else { w.bodies[bid].flags & ~BF_DYNAMIC }
island_for_body(w World&, bid int, si int): il := create_island(w, si); w.islands[il].bodies.push(bid); w.bodies[bid].isl = il; w.bodies[bid].islx = 0
set_body_type(w World&, bid int, ty int):
	ot := w.bodies[bid].ty
	if ot == ty: return
	if ty != BODY_STATIC: for k slist(w, bid) { if w.shapes[k].ty == SH_COMPOUND || w.shapes[k].ty == SH_HEIGHT { return } }
	if w.bodies[bid].set == SET_DISABLED: set_type_flag(w, bid, ty); sync_flags(w, bid); update_mass(w, bid); return
	destroy_body_contacts(w, bid, false); wake_body(w, bid)
	for k jlist(w, bid):
		jid := k >> 1
		if w.joints[jid].set == SET_DISABLED: continue
		wake_body(w, w.joints[jid].ed[0].bid); wake_body(w, w.joints[jid].ed[1].bid); unlink_joint(w, jid); transfer_joint(w, SET_STATIC, w.joints[jid].set, jid)
	set_type_flag(w, bid, ty); transfer_body(w, if ty == BODY_STATIC { SET_STATIC } else { SET_AWAKE }, w.bodies[bid].set, bid)
	if ot == BODY_STATIC { island_for_body(w, bid, SET_AWAKE) } else if ty == BODY_STATIC { remove_body_island(w, bid) }
	for k jlist(w, bid):
		jid := k >> 1
		if w.joints[jid].set == SET_DISABLED: continue
		if w.bodies[w.joints[jid].ed[0].bid].ty == BODY_DYNAMIC || w.bodies[w.joints[jid].ed[1].bid].ty == BODY_DYNAMIC: transfer_joint(w, SET_AWAKE, SET_STATIC, jid)
	xf := body_xf(w, bid)
	for k slist(w, bid): destroy_shape_proxy(w, k); create_shape_proxy(w, k, ty, xf, true)
	for k jlist(w, bid):
		jid := k >> 1; o := w.joints[jid].ed[(k & 1) ^ 1].bid
		if w.bodies[o].set == SET_DISABLED || (w.bodies[bid].ty != BODY_DYNAMIC && w.bodies[o].ty != BODY_DYNAMIC): continue
		link_joint(w, jid)
	sync_flags(w, bid); update_mass(w, bid)
disable_body(w World&, bid int):
	if w.bodies[bid].set == SET_DISABLED: return
	destroy_body_contacts(w, bid, true)
	for k jlist(w, bid): jid := k >> 1; if w.joints[jid].set != SET_DISABLED { unlink_joint(w, jid); transfer_joint(w, SET_DISABLED, w.joints[jid].set, jid) }
	for k slist(w, bid): destroy_shape_proxy(w, k)
	remove_body_island(w, bid); transfer_body(w, SET_DISABLED, w.bodies[bid].set, bid)
enable_body(w World&, bid int):
	if w.bodies[bid].set != SET_DISABLED: return
	si := if w.bodies[bid].ty == BODY_STATIC { SET_STATIC } else { SET_AWAKE }; transfer_body(w, si, SET_DISABLED, bid); xf := body_xf(w, bid)
	for k slist(w, bid): create_shape_proxy(w, k, w.bodies[bid].ty, xf, true)
	if si != SET_STATIC: island_for_body(w, bid, si)
	for k jlist(w, bid):
		jid := k >> 1; sa := w.bodies[w.joints[jid].ed[0].bid].set; sb := w.bodies[w.joints[jid].ed[1].bid].set
		if sa == SET_DISABLED || sb == SET_DISABLED: continue
		js := if sa == SET_STATIC && sb == SET_STATIC { SET_STATIC } else if sa == SET_STATIC { sb } else { sa }; transfer_joint(w, js, SET_DISABLED, jid)
		if js != SET_STATIC: link_joint(w, jid)
set_locks(w World&, bid int, nl int):
	b := &w.bodies[bid]
	if b.flags & BF_ALL_LOCKS == nl: return
	f1 := b.flags & BF_FIXED_ROT == BF_FIXED_ROT; f2 := nl & BF_FIXED_ROT == BF_FIXED_ROT; b.flags = (b.flags & ~BF_ALL_LOCKS) | nl; sync_flags(w, bid)
	if awake_state(w, bid): st := &bstate(w, bid); st.v = float3{if nl & BF_LOCK_LX != 0 { 0.0 } else { st.v.x }, if nl & BF_LOCK_LY != 0 { 0.0 } else { st.v.y }, if nl & BF_LOCK_LZ != 0 { 0.0 } else { st.v.z }}; st.w = float3{if nl & BF_LOCK_AX != 0 { 0.0 } else { st.w.x }, if nl & BF_LOCK_AY != 0 { 0.0 } else { st.w.y }, if nl & BF_LOCK_AZ != 0 { 0.0 } else { st.w.z }}
	if f1 != f2: update_mass(w, bid)
set_body_flag(w World&, bid int, fl int, on bool):
	nf := if on { fl } else { 0 }
	if w.bodies[bid].flags & fl == nf: return
	w.bodies[bid].flags = (w.bodies[bid].flags & ~fl) | nf; sync_flags(w, bid)
enable_hit_events(w World&, bid int, on bool): for k slist(w, bid) { w.shapes[k].flags = if on { w.shapes[k].flags | SF_HIT_EV } else { w.shapes[k].flags & ~SF_HIT_EV } }
set_mass_data(w World&, bid int, md MassData):
	b := &w.bodies[bid]; s := &bsim(w, bid); b.flags &= ~BF_DIRTY_MASS; sync_flags(w, bid); b.mass = md.mass; b.inertia = md.inertia; s.lc = md.center
	oc := s.c; s.c = xpt(s.xf, md.center); s.c0 = s.c; s.im = if b.mass > 0.0 { 1.0 / b.mass } else { 0.0 }
	if awake_state(w, bid): st := &bstate(w, bid); st.v = st.v + cross(st.w, s.c - oc)
	if det3(b.inertia) > 0.0 { s.iil = minv_t(b.inertia); r := qmat(s.xf.q); s.iiw = mm(mm(r, s.iil), mt(r)) } else { s.iil = M0; s.iiw = M0 }
	if s.flags & BF_FIXED_ROT == BF_FIXED_ROT: b.inertia = M0; s.iil = M0; s.iiw = M0
	body_extents(w, bid, md.center); invalidate_rel(w, bid)
set_awake(w World&, bid int, awake bool):
	if awake && w.bodies[bid].set >= SET_SLEEP: wake_body(w, bid)
	else if !awake && w.bodies[bid].set == SET_AWAKE:
		il := w.bodies[bid].isl
		if w.islands[il].crc > 0: split_island(w, il)
		try_sleep_island(w, w.bodies[bid].isl)
enable_sleep(w World&, bid int, on bool):
	if (w.bodies[bid].flags & BF_SLEEP == BF_SLEEP) == on: return
	w.bodies[bid].flags = if on { w.bodies[bid].flags | BF_SLEEP } else { w.bodies[bid].flags & ~BF_SLEEP }; sync_flags(w, bid)
	if !on: wake_body(w, bid)
shape_proj_area(w World&, s int, d float3) f32:
	x := &w.shapes[s]
	if x.ty == SH_CAPSULE: r := x.cap.radius; return PI * r * r + 2.0 * r * vlen(cross(x.cap.center2 - x.cap.center1, d))
	if x.ty == SH_HULL: return hull_proj_area(w.hulls[x.hull], d)
	if x.ty == SH_SPHERE { PI * x.sph.radius * x.sph.radius } else { 0.0 }
explode_one(w World&, s int, pos float3, rad f32, fall f32, ipa f32):
	sx := &w.shapes[s]
	if sx.exs == 0.0: return
	bid := sx.bid; xf := body_xf(w, bid); lp := xipt(xf, pos); pa := shape_pts(w, s); pb := [lp]; c ~= SCache{..}
	o := shape_distance(Proxy{pa[..], shape_rad(w, s)}, Proxy{pb[..], 0.0}, XI, true, c)
	if o.d > rad + fall: return
	wake_body(w, bid)
	if w.bodies[bid].set != SET_AWAKE: return
	cp := if o.d == 0.0 { shape_centroid(w, s) } else { o.pa }; dd ~= cp - lp
	dd = if vlen2(dd) > 100.0 * FLT_EPS * FLT_EPS { nrm(dd) } else { AX_X }
	sc := if o.d > rad && fall > 0.0 { fclamp((rad + fall - o.d) / fall, 0.0, 1.0) } else { 1.0 }
	im := sv(ipa * shape_proj_area(w, s, dd) * sc * w.shapes[s].exs, rot(xf.q, dd)); st := &bstate(w, bid); bs := &bsim(w, bid)
	st.v = madd(st.v, bs.im, im); st.w = st.w + mv(bs.iiw, cross(rot(xf.q, cp - bs.lc), im))
explode(w World&, pos float3, rad f32, fall f32, ipa f32, mask u64):
	w.locked = true; e := rad + fall
	tree_query(w.bp.tr[BODY_DYNAMIC], AABB{pos - float3{e, e, e}, pos + float3{e, e, e}}, mask, false) { px, ud => explode_one(w, ud as! int, pos, rad, fall, ipa); true }
	w.locked = false
reset_proxy(w World&, s int, wake bool, dp bool):
	bid := w.shapes[s].bid; k ~= w.bodies[bid].hck
	while k != -1:
		cid := k >> 1; nk := w.contacts[cid].ed[k & 1].next
		if w.contacts[cid].sa == s || w.contacts[cid].sb == s: destroy_contact(w, cid, wake)
		k = nk
	xf := body_xf(w, bid); pk := w.shapes[s].pkey
	if pk == -1: update_shape_boxes(w, s, xf, w.bodies[bid].ty); return
	update_shape_boxes(w, s, xf, pk & 3)
	if dp { bp_destroy(w.bp, pk); w.shapes[s].pkey = bp_create(w.bp, pk & 3, w.shapes[s].fat, w.shapes[s].filter.cat, s, true) } else { bp_move(w.bp, pk, w.shapes[s].fat) }
ray_shape(w World&, s int, xf Transform, org float3, tr float3, maxf f32) CastOut:
	x := &w.shapes[s]; lo := xipt(xf, org); lt := irot(xf.q, tr); t := x.ty
	o ~= if t == SH_CAPSULE { ray_capsule(x.cap, lo, lt, maxf) } else if t == SH_COMPOUND { ray_compound(G_CPD[x.cpd], lo, lt, maxf) } else if t == SH_SPHERE { ray_sphere(x.sph, lo, lt, maxf) } else if t == SH_HULL { ray_hull(w.hulls[x.hull], lo, lt, maxf) } else if t == SH_MESH { ray_mesh(G_MESH[x.mesh], x.msc, lo, lt, maxf) } else { ray_hf(G_HF[x.hf], lo, lt, maxf) }
	o.p = xpt(xf, o.p); o.n = rot(xf.q, o.n); o
apply_wind(w World&, s int, wind float3, drag f32, lift f32, maxs f32, wake bool):
	t := w.shapes[s].ty; bid := w.shapes[s].bid; b := &w.bodies[bid]
	if t != SH_SPHERE && t != SH_CAPSULE && t != SH_HULL || b.ty != BODY_DYNAMIC || b.set == SET_DISABLED || b.set >= SET_SLEEP && !wake: return
	if b.set != SET_AWAKE: wake_body(w, bid)
	st := bstate(w, bid); sm := &bsim(w, bid); q := sm.xf.q; lu := LUPM; air := 1.225 / (lu * lu * lu); f ~= V0; tq ~= V0
	if t == SH_SPHERE || t == SH_CAPSULE:
		lv := rot(q, w.shapes[s].lcen - sm.lc); sp ~= 0.0 as f32; dr := len_nrm(sp, msub(wind, drag, st.v + cross(st.w, lv))); sp = min(sp, maxs)
		if t == SH_SPHERE:
			r := w.shapes[s].sph.radius; f = sv(0.5 * air * (PI * r * r) * sp * sp, dr); tq = cross(lv, f)
		else:
			c := w.shapes[s].cap; d := rot(q, c.center2 - c.center1); r := c.radius; pa := PI * r * r + 2.0 * r * vlen(cross(d, dr)); e := nrm(d)
			nn := sv(dot(dr, e), e) - dr; ld := cross(cross(nn, dr), dr); f = sv(0.5 * air * pa * sp * sp, madd(dr, lift, ld)); tq = cross(madd(lv, r, nn), f)
	else:
		h := &w.hulls[w.shapes[s].hull]; m := qmat(q)
		for fi h.fe.len:
			e1 := h.fe[fi]; e2 ~= h.eg[e1].n; e3 ~= h.eg[e2].n; p1 := h.pts[h.eg[e1].o]; p2 ~= h.pts[h.eg[e2].o]; v1 := mv(m, p1); v2 ~= mv(m, p2); nn := mv(m, h.pl[fi].normal)
			loop:
				p3 := h.pts[h.eg[e3].o]; v3 := mv(m, p3); lc := sv(0.333333, p1 + (p2 + p3)); lv := mv(m, lc - sm.lc); sp ~= 0.0 as f32
				dr := len_nrm(sp, msub(wind, drag, st.v + cross(st.w, lv)))
				if dot(nn, dr) < -FLT_EPS:
					pa := -0.5 * dot(cross(v2 - v1, v3 - v1), dr); ld := cross(cross(nn, dr), dr); sp = min(sp, maxs); df := sv(0.5 * air * pa * sp * sp, madd(dr, lift, ld)); f = f + df; tq = tq + cross(lv, df)
				e2 = e3; e3 = h.eg[e3].n; v2 = v3; p2 = p3
				if e1 == e3: break
	sm.f = sm.f + f; sm.t = sm.t + tq
qok(f Filter3, cat u64, mask u64) bool: f.cat & mask != 0 && f.mask & cat != 0
cast_shape_at(w World&, s int, xf Transform, px Proxy, tr float3, maxf f32, enc bool) CastOut:
	x := &w.shapes[s]; lp float3[>..] ~= []; for p px.pts[..min(px.pts.len, 128)] { lp.push(xipt(xf, p)) } l := Proxy{lp[..], px.r}; lt := irot(xf.q, tr); t := x.ty
	o ~= if t == SH_CAPSULE { cast_capsule(x.cap, l, lt, maxf, enc) } else if t == SH_COMPOUND { cast_compound(G_CPD[x.cpd], l, lt, maxf, enc) } else if t == SH_HEIGHT { cast_hf(G_HF[x.hf], l, lt, maxf, enc) } else if t == SH_HULL { cast_hull(w.hulls[x.hull], l, lt, maxf, enc) } else if t == SH_MESH { cast_mesh(G_MESH[x.mesh], x.msc, l, lt, maxf, enc) } else { cast_sphere(x.sph, l, lt, maxf, enc) }
	o.p = xpt(xf, o.p); o.n = rot(xf.q, o.n); o
overlap_shape_at(w World&, s int, xf Transform, px Proxy) bool:
	x := &w.shapes[s]; t := x.ty
	if t == SH_CAPSULE { overlap_capsule(x.cap, xf, px) } else if t == SH_COMPOUND { overlap_compound(G_CPD[x.cpd], xf, px) } else if t == SH_HEIGHT { overlap_hf(G_HF[x.hf], xf, px) } else if t == SH_HULL { overlap_hull(w.hulls[x.hull], xf, px) } else if t == SH_MESH { overlap_mesh(G_MESH[x.mesh], x.msc, xf, px) } else { overlap_sphere(x.sph, xf, px) }
collide_mover_shape(w World&, s int, xf Transform, m Capsule, cap int) PlaneRes[>..]:
	r PlaneRes[>..] ~= []
	if cap == 0: return r
	x := &w.shapes[s]; lm := Capsule{xipt(xf, m.center1), xipt(xf, m.center2), m.radius}; t := x.ty; one ~= PlaneRes{Plane{V0, 0.0}, V0, 0, 0, 0}; n ~= 0
	if t == SH_CAPSULE || t == SH_SPHERE || t == SH_HULL { n = if t == SH_CAPSULE { mover_capsule(one, x.cap, lm) } else if t == SH_SPHERE { mover_sphere(one, x.sph, lm) } else { mover_hull(one, w.hulls[x.hull], lm) }; if n > 0 { r.push(one) } } else { n = if t == SH_COMPOUND { mover_compound(r, cap, G_CPD[x.cpd], lm) } else if t == SH_MESH { mover_mesh(r, cap, G_MESH[x.mesh], x.msc, lm) } else { mover_hf(r, cap, G_HF[x.hf], lm) } }
	r.resize(n, one); mc := x.mats.len
	for k n: r[k].pl.normal = rot(xf.q, r[k].pl.normal); r[k].p = xpt(xf, r[k].p); r[k].mat = iclamp(r[k].mat, 0, mc - 1)
	r
jsim(w World&, jid int) JointSim&:
	j := &w.joints[jid]
	if j.set == SET_AWAKE: return w.colors[j.color].jsims[j.li]
	return w.sets[j.set].jsims[j.li]
bvel(w World&, b int) float3: if w.bodies[b].set == SET_AWAKE { bstate(w, b).v } else { V0 }
bang(w World&, b int) float3: if w.bodies[b].set == SET_AWAKE { bstate(w, b).w } else { V0 }
jrel(w World&, j JointSim&) Quat: qa := qmul(body_xf(w, j.ba).q, j.lfa.q); q ~= qmul(body_xf(w, j.bb).q, j.lfb.q); if qdot(qa, q) < 0.0 { q = qneg(q) } qimul(qa, q)
jdp(w World&, j JointSim&) float3: xpt(body_xf(w, j.bb), j.lfb.p) - xpt(body_xf(w, j.ba), j.lfa.p)
jforce(w World&, jid int) float3:
	j := &jsim(w, jid); t := j.ty; ih := w.inv_h; xa := body_xf(w, j.ba)
	if t == J_DISTANCE: return sv((j.d.imp + j.d.limp - j.d.uimp + j.d.mimp) * ih, nrm(jdp(w, j)))
	if t == J_MOTOR: return sv(ih, j.mo.lvi + j.mo.lsi)
	if t == J_PRISMATIC: return rot(xa.q, rot(j.lfa.q, sv(ih, float3{j.pr.pi.x, j.pr.pi.y, j.pr.mi + j.pr.loi + j.pr.upi + j.pr.si})))
	if t == J_WHEEL: return rot(xa.q, rot(j.lfa.q, sv(ih, float3{j.wh.li.x, j.wh.li.y, j.wh.lsl + j.wh.usi + j.wh.ssi})))
	if t == J_REVOLUTE { sv(ih, j.rv.li) } else if t == J_SPHERICAL { sv(ih, j.sp.li) } else if t == J_WELD { sv(ih, j.we.li) } else { V0 }
jtorque(w World&, jid int) float3:
	j := &jsim(w, jid); t := j.ty; ih := w.inv_h; xa := body_xf(w, j.ba)
	if t == J_PARALLEL: rq := qimul(j.fra.q, j.frb.q); return sv(ih, blend2(j.pa.pi.x, half_axis(j.fra.q, rq, AX_X), j.pa.pi.y, half_axis(j.fra.q, rq, AX_Y)))
	if t == J_MOTOR: return sv(ih, j.mo.avi + j.mo.asi)
	if t == J_PRISMATIC: return rot(xa.q, rot(j.lfa.q, sv(ih, j.pr.ai)))
	if t == J_REVOLUTE: r := &j.rv; rq := qimul(j.fra.q, j.frb.q); ax := r.si + r.mi + r.loi - r.upi; a := madd(blend2(r.pi.x, half_axis(j.fra.q, rq, AX_X), r.pi.y, half_axis(j.fra.q, rq, AX_Y)), ax, r.az); return sv(ih, madd(a, ax, rot(xa.q, rot(j.lfa.q, AX_Z))))
	if t == J_SPHERICAL: s := &j.sp; tw := rot(qmul(body_xf(w, j.bb).q, j.lfb.q), AX_Z); sw := nrm(cross(rot(qmul(xa.q, j.lfa.q), AX_Z), tw)); return sv(ih, madd(madd(s.si + s.mi, s.lti - s.uti, tw), s.swi, sw))
	if t == J_WELD: return sv(ih, j.we.ai)
	if t == J_WHEEL: return sv(ih * j.wh.spi, qmat(qmul(xa.q, j.lfa.q)).cz)
	V0
limsep(tr f32, on bool, lo f32, hi f32) f32: if !on { 0.0 } else if tr < lo { lo - tr } else if hi < tr { tr - hi } else { 0.0 }
jlinsep(w World&, jid int) f32:
	j := &jsim(w, jid); t := j.ty; dp := jdp(w, j); ax := rot(body_xf(w, j.ba).q, AX_X); ps := fabs(dot(perp(ax), dp)); tr := dot(ax, dp); l := vlen(dp)
	if t == J_DISTANCE: return if j.d.spring { if j.d.limit { limsep(l, true, j.d.minl, j.d.maxl) } else { 0.0 } } else { fabs(l - j.d.len) }
	if t == J_PRISMATIC: ls := limsep(tr, j.pr.limit, j.pr.lt, j.pr.ut); return sqrt(ps * ps + ls * ls)
	if t == J_WHEEL: ls := limsep(tr, j.wh.slimit, j.wh.lsl, j.wh.usl); return sqrt(ps * ps + ls * ls)
	if t == J_REVOLUTE || t == J_SPHERICAL || (t == J_WELD && j.we.lhz == 0.0) { l } else { 0.0 }
jangsep(w World&, jid int) f32:
	j := &jsim(w, jid); t := j.ty; rq ~= qimul(body_xf(w, j.ba).q, body_xf(w, j.bb).q)
	if t == J_PRISMATIC: return q_angle(rq)
	if t == J_REVOLUTE: a := twist_angle_q(rq); if j.rv.limit && (a < j.rv.la || j.rv.ua < a) { return q_angle(rq) }
	if t == J_PARALLEL || t == J_REVOLUTE: rq.z = 0.0; return q_angle(rq)
	if t == J_SPHERICAL: s := &j.sp; return (if s.cl { fmax(0.0, swing_angle_q(rq) - s.cone) } else { 0.0 }) + (if s.tl { fmax(0.0, s.lta - twist_angle_q(rq)) + fmax(0.0, twist_angle_q(rq) - s.uta) } else { 0.0 })
	if t == J_WELD && j.we.ahz == 0.0 { q_angle(rq) } else { 0.0 }
pris_translation(w World&, jid int) f32: j := &jsim(w, jid); xa := body_xf(w, j.ba); xb := body_xf(w, j.bb); dot(xb.p - xa.p + rot(xb.q, j.lfb.p) - rot(xa.q, j.lfa.p), rot(xa.q, rot(j.lfa.q, AX_X)))
pris_speed(w World&, jid int) f32:
	j := &jsim(w, jid); sa := &bsim(w, j.ba); sb := &bsim(w, j.bb); ax := rot(sa.xf.q, rot(j.lfa.q, AX_X)); ra := rot(sa.xf.q, j.lfa.p - sa.lc); rb := rot(sb.xf.q, j.lfb.p - sb.lc); wa := bang(w, j.ba)
	dot(sb.c - sa.c + rb - ra, cross(wa, ax)) + dot(ax, bvel(w, j.bb) + cross(bang(w, j.bb), rb) - bvel(w, j.ba) - cross(wa, ra))
wheel_spin_speed(w World&, jid int) f32: j := &jsim(w, jid); dot(bang(w, j.bb) - bang(w, j.ba), rot(qmul(bsim(w, j.bb).xf.q, j.lfb.q), AX_Z))
wheel_steer_angle(w World&, jid int) f32: j := &jsim(w, jid); ma := qmat(qmul(bsim(w, j.ba).xf.q, j.lfa.q)); mb := qmat(qmul(bsim(w, j.bb).xf.q, j.lfb.q)); atan2f(-dot(mb.cz, ma.cy), dot(mb.cz, ma.cz))
set_collide(w World&, jid int, on bool):
	j := &w.joints[jid]
	if j.collide == on: return
	j.collide = on; ba := j.ed[0].bid; bb := j.ed[1].bid
	if !on: destroy_contacts_between(w, ba, bb); return
	for s slist(w, if w.bodies[ba].scount < w.bodies[bb].scount { ba } else { bb }): k := w.shapes[s].pkey; if k != -1 { tree_mark_serial(w.bp.tr[k & 3], k >> 2) }
