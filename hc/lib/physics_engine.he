struct TT { d2 f32, ix int }
struct Clu { mn float3, tn float3, pts MP[>..], cap int }
mesh_manifolds(w World&, cid int, va View&, mmap int[4], has_map bool, xa Transform, vb View&, xb Transform, fast bool) bool:
	refresh_cache(w, cid, va, xa, w.shapes[vb.id].aabb)
