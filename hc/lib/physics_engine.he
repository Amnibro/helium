			if r > 0 && f.mat[(r - 1) * (cx - 1) + c] as int != HF_HOLE: j11 := (r - 1) * cx + c; j21 := r * cx + c; v0 := hf_corner(sc, c + 1, d[j21 + 1], r); v1 := hf_corner(sc, c + 1, d[j11 + 1], r - 1); v2 := hf_corner(sc, c, d[j21], r); f1 = hf_edge(f1, p1, v1, hf_tri_n(sc, v0, v1, v2), 4)
			if r + 1 < cz - 1 && f.mat[(r + 1) * (cx - 1) + c] as int != HF_HOLE: j11 := (r + 1) * cx + c; j21 := (r + 2) * cx + c; v0 := hf_corner(sc, c, d[j11], r + 1); v1 := hf_corner(sc, c, d[j21], r + 2); v2 := hf_corner(sc, c + 1, d[j11 + 1], r + 1); f2 = hf_edge(f2, p2, v1, hf_tri_n(sc, v0, v1, v2), 4)
			if c - 1 >= 0 && f.mat[r * (cx - 1) + c - 1] as int != HF_HOLE: j11 := r * cx + c - 1; j21 := (r + 1) * cx + c - 1; v0 := hf_corner(sc, c, d[j21 + 1], r + 1); v1 := hf_corner(sc, c, d[j11 + 1], r); v2 := hf_corner(sc, c - 1, d[j21], r + 1); f1 = hf_edge(f1, p1, v2, hf_tri_n(sc, v0, v1, v2), 1)
			if c + 1 < cx - 1 && f.mat[r * (cx - 1) + c + 1] as int != HF_HOLE: j11 := r * cx + c + 1; j21 := (r + 1) * cx + c + 1; v0 := hf_corner(sc, c + 1, d[j11], r); v1 := hf_corner(sc, c + 1, d[j21], r + 1); v2 := hf_corner(sc, c + 2, d[j11 + 1], r); f2 = hf_edge(f2, p2, v2, hf_tri_n(sc, v0, v1, v2), 1)
