mover_hf(res PlaneRes[>..]&, cap int, f HField&, mv Capsule) int:
	mp := [mv.center1, mv.center2]; ca ~= SCache{..}; r := mv.radius; ctr := vlerp(mv.center1, mv.center2, 0.5); rr := float3{r, r, r}; lo := vmin(mv.center1, mv.center2) - rr; hi := vmax(mv.center1, mv.center2) + rr; bc := sv(0.5, lo + hi); be := hi - bc; g := hf_range(f, lo, hi); pc ~= 0
	g1 := g[1] + 1; g3 := g[3] + 1
	for row g[0]..g1:
		for c g[2]..g3:
			if !hf_cell(f, row, c): continue
			k := hf_corners(f, row, c); p11 := k[0]; p12 := if f.cw { k[2] } else { k[1] }; p21 := if f.cw { k[1] } else { k[2] }; p22 := k[3]; q := row * (f.cols - 1) + c; ts := [[p11, p21, p12], [p22, p12, p21]]; bs := [[p11, p21, p12], [p21, p22, p12]]
			for j 2:
				if btri(bc, be, bs[j][0], bs[j][1], bs[j][2]) && signed_vol(ts[j][0], ts[j][1], ts[j][2], ctr) >= 0.0:
					ca.count = 0; d := shape_distance(Proxy{ts[j][..], 0.0}, Proxy{mp[..], 0.0}, XI, false, ca)
					if d.d != 0.0 && d.d <= r:
						res.push(PlaneRes{Plane{d.n, r - d.d}, d.pa, 2 * q + j, 0, f.mat[q] as int}); pc += 1
						if pc == cap: return pc
