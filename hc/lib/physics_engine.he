id_alloc(p IdPool&) int:
	if p.free.len > 0: return p.free.pop()
	p.next += 1; p.next - 1
id_free(p IdPool&, id int): if id == p.next { p.next -= 1 } else { p.free.push(id) }
id_count(p IdPool&) int: p.next - p.free.len
bit_get(b u64[>..]&, i int) bool: k := i >> 6; k < b.len && (b[k] >> (i & 63) as u64) & 1 != 0
bit_set(b u64[>..]&, i int): b[i >> 6] |= (1 as u64) << (i & 63) as u64
bit_grow_set(b u64[>..]&, i int):
	k := i >> 6
	while b.len <= k: b.push(0)
	b[k] |= (1 as u64) << (i & 63) as u64
bit_clear(b u64[>..]&, i int): k := i >> 6; if k < b.len: b[k] &= ~((1 as u64) << (i & 63) as u64)
bit_reset(b u64[>..]&, n int): b.clear(); for k (n + 63) >> 6: b.push(0)
rswap<T>(a T[>..]&, i int) int:
	l := a.len - 1
	if i == l { a.pop(); return -1 }
	a[i] = a[l]; a.pop(); l
make_soft(hz f32, z f32, h f32) Soft:
	if hz == 0.0: return Soft{}
	om := 2.0 * PI * hz; a1 := 2.0 * z + h * om; a2 := h * om * a1; a3 := 1.0 / (1.0 + a2)
	Soft{om / a1, a2 * a3, a3}
qs3<T, F>(v T[:], a int, b int, c int):
	if F(v[b], v[a]):
		if F(v[c], v[b]) { swap(v[a], v[c]) } else { swap(v[a], v[b]); if F(v[c], v[b]) { swap(v[b], v[c]) } }
	else if F(v[c], v[b]): swap(v[b], v[c]); if F(v[b], v[a]) { swap(v[a], v[b]) }
qsort_b3<T, F>(v T[:]):
	n := v.len
	if n <= 1: return
	l ~= 0; r ~= n - 1; st int[>..] ~= []
	loop:
		if r - l + 1 >= 16:
			m := l + ((r - l) >> 1); qs3(v, l + 1, m, r) { a, b => F(a, b) }; swap(v[l], v[m])
			i ~= l + 1; j ~= r
			loop:
				i += 1
				while F(v[i], v[l]): i += 1
				j -= 1
				while F(v[l], v[j]): j -= 1
				if i >= j: break
				swap(v[i], v[j])
			i = j + 1; swap(v[l], v[j]); j -= 1
			l1 ~= 0; r1 ~= 0; l2 ~= 0; r2 ~= 0
			if j - l >= r - i { l1 = l; r1 = j; l2 = i; r2 = r } else { l1 = i; r1 = r; l2 = l; r2 = j }
			if l2 == r2 { l = l1; r = r1 } else { st.push(l1); st.push(r1); l = l2; r = r2 }
		else:
			for i (l + 1)..(r + 1): j ~= i; while j > l && F(v[j], v[j - 1]) { swap(v[j], v[j - 1]); j -= 1 }
			if st.len == 0: break
			r = st.pop(); l = st.pop()
