query_mesh(m MeshD&, sc float3, b AABB) int[>..]:
	ib := inv_box(sc, b.lower, b.upper); bc := sv(0.5, ib.lower + ib.upper); be := ib.upper - bc; st int[>..] ~= []; ni ~= 0; o int[>..] ~= []
