	ib := inv_box(sc, vmin(mv.center1, mv.center2) - rr, vmax(mv.center1, mv.center2) + rr); bc := sv(0.5, ib.lower + ib.upper); be := ib.upper - bc; st int[>..] ~= []; ni ~= 0; pc ~= 0
