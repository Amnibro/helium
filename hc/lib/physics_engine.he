struct BSim { xf Transform = XI, c float3 = V0, q0 Quat = QI, c0 float3 = V0, lc float3 = V0, f float3 = V0, t float3 = V0, im f32 = 0.0, iil Mat3 = M0, iiw Mat3 = M0, minx f32 = 0.0, maxx float3 = V0, ld f32 = 0.0, ad f32 = 0.0, gs f32 = 0.0, bid int = -1, flags int = 0 }
