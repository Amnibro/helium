		for c g[2]..g3:
			if !hf_cell(f, r, c): continue
			k := hf_corners(f, r, c)
			if box_overlap(b, AABB{vmin(vmin(k[0], k[1]), vmin(k[2], k[3])), vmax(vmax(k[0], k[1]), vmax(k[2], k[3]))}): q := 2 * (r * (f.cols - 1) + c); o.push(q); o.push(q + 1)
