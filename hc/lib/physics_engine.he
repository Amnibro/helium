hf_holes(rows int, cols int, holes bool) byte[>..]:
	m byte[>..] ~= []
	for k (rows - 1) * (cols - 1): m.push(if holes && k > 0 && k % 16 == 0 { HF_HOLE as byte } else { 0 as byte })
	m
grid_hf(rows int, cols int, sc float3, holes bool) HField: h f32[>..] ~= [0.0; rows * cols]; m := hf_holes(rows, cols, holes); create_hf(h[..], m[..], sc, cols, rows, -256.0, 256.0, false)
wave_hf(rows int, cols int, sc float3, rf f32, cf f32, holes bool) HField:
	h f32[>..] ~= []; oz := 2.0 * PI * rf; ox := 2.0 * PI * cf
