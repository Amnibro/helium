view_of(w World&, s int) View: x := &w.shapes[s]; View{x.ty, x.cap, x.sph, x.hull, -1, copy(x.mats), x.flags, x.id, x.gen, x.mesh, -1, x.msc, x.hf}
vmesh(v View&) MeshD&:
	if v.mc >= 0: return G_CPD[v.mc].ms[v.mesh]
	G_MESH[v.mesh]
vhull(w World&, v View&) HData&:
	if v.hc >= 0: return G_CPD[v.hc].hs[v.h]
	w.hulls[v.h]
create_contact(w World&, sa int, sb int, child int):
	r := contact_reg(w.shapes[sa].ty, w.shapes[sb].ty)
	if r == 0: return
	if r == 2: create_contact(w, sb, sa, child); return
	ba := w.shapes[sa].bid; bb := w.shapes[sb].bid
	si := if w.bodies[ba].set == SET_AWAKE || w.bodies[bb].set == SET_AWAKE { SET_AWAKE } else { SET_DISABLED }
	cid := id_alloc(w.cpool)
	if cid == w.contacts.len: w.contacts.push(Contact{..})
