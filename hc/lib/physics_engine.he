	c.ed[1] = CEdge{bb, -1, w.bodies[bb].hck}; kb := (cid << 1) | 1; h2 := w.bodies[bb].hck
	if h2 != -1: w.contacts[h2 >> 1].ed[h2 & 1].prev = kb
