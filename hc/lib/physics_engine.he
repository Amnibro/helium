struct Body { ud u64 = 0, set int = -1, li int = -1, hck int = -1, ccount int = 0, hsh int = -1, scount int = 0, hchain int = -1, hjk int = -1, jcount int = 0, isl int = -1, islx int = -1, sth f32 = 0.0, stime f32 = 0.0, svel f32 = 0.0, safety f32 = 0.0, mass f32 = 0.0, inertia Mat3 = M0, bmi int = -1, id int = -1, flags int = 0, name byte[>..], ty int = 0, gen int = 0 }
