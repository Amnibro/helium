	m := &c.mans[0]; m.count = lm.count; r := qmat(xa.q); m.n = mv(r, lm.n)
	for i lm.count: s := lm.pts[i]; t := &m.pts[i]; t.aa = mv(r, s.p); t.ab = t.aa + (xa.p - xb.p); t.s = s.s; t.fid = fid(s.fp); t.tri = -1; t.nv = 0.0
