		for t tt:
			m := &ms[tent[t.ix]]
			e1 := add_key(fe, m.i1, m.i2); e2 := add_key(fe, m.i2, m.i3); e3 := add_key(fe, m.i3, m.i1); a1 := add_vert(fv, m.i1); a2 := add_vert(fv, m.i2); a3 := add_vert(fv, m.i3); f := m.feat
			ok := if f == F_E1 { e1 } else if f == F_E2 { e2 } else if f == F_E3 { e3 } else if f == F_V1 { a1 } else if f == F_V2 { a2 } else if f == F_V3 { a3 } else { false }
