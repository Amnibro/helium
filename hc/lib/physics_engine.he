						if al < bf: o.p = madd(ss, al, tr); o.n = nrm(cross(b - a, d - a)); o.frac = al; o.tri = 2 * q + j; o.mat = mt; o.hit = true; bf = al
					else if signed_vol(a, b, d, ss) >= 0.0:
						tv := [V0, b - a, d - a]; pr := shape_cast_pair(Proxy{tv[..], 0.0}, px, Transform{-a, QI}, tr, bf, enc)
						if pr.hit: bf = pr.frac; o = pr; o.p = pr.p + a; o.tri = 2 * q + j; o.mat = mt
		ifx := if nfx == FLT_MAX { FLT_MAX } else { go + nfx * gs }; ifz := if nfz == FLT_MAX { FLT_MAX } else { go + nfz * gs }
		if ifx > bf && ifz > bf: break
		if nfx <= nfz:
			if ch == cb: break
			ch += dc; ct = ch; rt = if ex.z == 0.0 { rh } else { ffloor((cs.z + nfx * cd.z - 2.0 * sz * ex.z) / sc.z) as int }; nfx += dax
		else:
			if rh == rb: break
