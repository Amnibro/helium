			if !hf_cell(f, r, c): continue
			k := hf_corners(f, r, c); ts := [[k[0], k[2], k[1]], [k[3], k[1], k[2]]]; bs := [[k[0], k[2], k[1]], [k[2], k[3], k[1]]]
			for j 2:
