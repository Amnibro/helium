struct HField { h int[>..], mat byte[>..], fl byte[>..], aabb AABB = EMPTY_BOX, minh f32 = 0.0, maxh f32 = 0.0, hs f32 = 0.0, sc float3 = V0, cols int = 0, rows int = 0, cw bool = false, hash u64 = 0 }
HF_HOLE := 255
hf_corner(sc float3, x int, h f32, z int) float3: vmul(sc, float3{x as f32, h, z as f32})
hf_tri_n(sc float3, a float3, b float3, c float3) float3: nrm(cross(b - a, c - a))
hf_edge(fl int, pl Plane, p float3, n float3, bit int) int:
	s := plane_sep(pl, p); ca := dot(pl.normal, n); r ~= fl
