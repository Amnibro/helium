create_hf(hs const f32[:], mats const byte[:], sc float3, cx int, cz int, gmin f32, gmax f32, cw bool) HField:
	f ~= HField{[], [], []}; f.sc = sc; f.cols = cx; f.rows = cz; f.cw = cw; f.minh = gmin; f.maxh = gmax; f.hs = fmax(gmax - gmin, slop()) / 65535.0; lo ~= gmax; up ~= gmin; ih := 1.0 / f.hs; nc := (cx - 1) * (cz - 1); d f32[>..] ~= []
