	rb := if tb == SH_SPHERE { w.shapes[sb].sph.radius } else if tb == SH_CAPSULE { w.shapes[sb].cap.radius } else { 0.0 }
	c.roll = fmax(w.shapes[sa].mats[0].roll, w.shapes[sb].mats[0].roll) * fmax(ra, rb)
