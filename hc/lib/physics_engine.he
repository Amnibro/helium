jst(w World&, i int) BState: if i == -1 { BState{} } else { w.sets[SET_AWAKE].states[i] }
jput(w World&, i int, f int, v float3, a float3): if f & BF_DYNAMIC != 0 { s := &w.sets[SET_AWAKE].states[i]; s.v = v; s.w = a }
jputw(w World&, i int, f int, a float3): if f & BF_DYNAMIC != 0 { w.sets[SET_AWAKE].states[i].w = a }
jbase(w World&, j JointSim&):
	sa := &bsim(w, j.ba); sb := &bsim(w, j.bb)
	j.ma = sa.im; j.mb = sb.im; j.ia = sa.iiw; j.ib = sb.iiw; j.fixed = det3(madd3(j.ia, j.ib)) < 1000.0 * FLT_MIN
	j.xa = if w.bodies[j.ba].set == SET_AWAKE { w.bodies[j.ba].li } else { -1 }; j.xb = if w.bodies[j.bb].set == SET_AWAKE { w.bodies[j.bb].li } else { -1 }
	j.fra = Transform{rot(sa.xf.q, j.lfa.p - sa.lc), qmul(sa.xf.q, j.lfa.q)}; j.frb = Transform{rot(sb.xf.q, j.lfb.p - sb.lc), qmul(sb.xf.q, j.lfb.q)}; j.dc = sb.c - sa.c
kmat(ma f32, mb f32, ia Mat3, ib Mat3, ra float3, rb float3) Mat3:
	sa := skew(ra); sb := skew(rb); k ~= mneg(madd3(mm(sa, mm(ia, sa)), mm(sb, mm(ib, sb))))
	k.cx.x += ma + mb; k.cy.y += ma + mb; k.cz.z += ma + mb; k
half_axis(q Quat, r Quat, a float3) float3: sv(0.5, rot(q, sv(r.w, a) + cross(qv(r), a)))
lim_coef(c f32, ub bool, cs Soft, inv_h f32) float3:
	if c > 0.0: return float3{c * inv_h, 1.0, 0.0}
	if ub: return float3{cs.bias * c, cs.ms, cs.is}
	float3{0.0, 1.0, 0.0}
prep_dist(w World&, j JointSim&):
	d := &j.d; ra := j.fra.p; rb := j.frb.p; ax := nrm(rb - ra + j.dc); ca := cross(ra, ax); cb := cross(rb, ax)
	k := j.ma + j.mb + dot(ca, mv(j.ia, ca)) + dot(cb, mv(j.ib, cb)); d.am = if k > 0.0 { 1.0 / k } else { 0.0 }
	d.ds = make_soft(d.hz, d.dr, w.ctx.h)
	if !w.ctx.warm: d.imp = 0.0; d.limp = 0.0; d.uimp = 0.0; d.mimp = 0.0
warm_dist(w World&, j JointSim&):
	d := &j.d; s1 := jst(w, j.xa); s2 := jst(w, j.xb); ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p)
	ax := nrm(j.dc + ((s2.dp - s1.dp) + (rb - ra))); p := sv(d.imp + d.limp - d.uimp + d.mimp, ax)
	jput(w, j.xa, s1.flags, msub(s1.v, j.ma, p), s1.w - mv(j.ia, cross(ra, p))); jput(w, j.xb, s2.flags, madd(s2.v, j.mb, p), s2.w + mv(j.ib, cross(rb, p)))
solve_dist(w World&, j JointSim&, ub bool):
	d := &j.d; s1 := jst(w, j.xa); s2 := jst(w, j.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w; ma := j.ma; mb := j.mb; ia := j.ia; ib := j.ib
	ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p); sep := j.dc + ((s2.dp - s1.dp) + (rb - ra)); ln := vlen(sep); ax := nrm(sep)
	if d.spring && (d.minl < d.maxl || !d.limit):
		if d.hz > 0.0:
			cd := dot(ax, (vb - va) + (cross(wb, rb) - cross(wa, ra))); b := d.ds.bias * (ln - d.len); m := d.ds.ms * d.am; oi := d.imp
			im := -m * (cd + b) - d.ds.is * oi; h := w.ctx.h; d.imp = fclamp(d.imp + im, d.lsf * h, d.usf * h); p := sv(d.imp - oi, ax)
			va = msub(va, ma, p); wa = wa - mv(ia, cross(ra, p)); vb = madd(vb, mb, p); wb = wb + mv(ib, cross(rb, p))
		if d.limit:
			cd := dot(ax, (vb - va) + (cross(wb, rb) - cross(wa, ra))); k := lim_coef(ln - d.minl, ub, j.cs, w.ctx.inv_h)
			im := -k.y * d.am * (cd + k.x) - k.z * d.limp; ni := fmax(0.0, d.limp + im); p := sv(ni - d.limp, ax); d.limp = ni
			va = msub(va, ma, p); wa = wa - mv(ia, cross(ra, p)); vb = madd(vb, mb, p); wb = wb + mv(ib, cross(rb, p))
			cd2 := dot(ax, (va - vb) + (cross(wa, ra) - cross(wb, rb))); k2 := lim_coef(d.maxl - ln, ub, j.cs, w.ctx.inv_h)
			im2 := -k2.y * d.am * (cd2 + k2.x) - k2.z * d.uimp; ni2 := fmax(0.0, d.uimp + im2); p2 := sv(-(ni2 - d.uimp), ax); d.uimp = ni2
			va = msub(va, ma, p2); wa = wa - mv(ia, cross(ra, p2)); vb = madd(vb, mb, p2); wb = wb + mv(ib, cross(rb, p2))
		if d.motor:
			cd := dot(ax, (vb - va) + (cross(wb, rb) - cross(wa, ra))); im := d.am * (d.ms - cd); oi := d.mimp; mx := w.ctx.h * d.mmf
			d.mimp = fclamp(d.mimp + im, -mx, mx); p := sv(d.mimp - oi, ax)
			va = msub(va, ma, p); wa = wa - mv(ia, cross(ra, p)); vb = madd(vb, mb, p); wb = wb + mv(ib, cross(rb, p))
	else:
		cd := dot(ax, (vb - va) + (cross(wb, rb) - cross(wa, ra))); c := ln - d.len
		k := if ub { float3{j.cs.bias * c, j.cs.ms, j.cs.is} } else { float3{0.0, 1.0, 0.0} }
		im := -k.y * d.am * (cd + k.x) - k.z * d.imp; d.imp += im; p := sv(im, ax)
		va = msub(va, ma, p); wa = wa - mv(ia, cross(ra, p)); vb = madd(vb, mb, p); wb = wb + mv(ib, cross(rb, p))
	jput(w, j.xa, s1.flags, va, wa); jput(w, j.xb, s2.flags, vb, wb)
prep_motor(w World&, j JointSim&):
	m := &j.mo; m.ls = make_soft(m.lhz, m.ldr, w.ctx.h); m.asp = make_soft(m.ahz, m.adr, w.ctx.h); m.amass = minv(madd3(j.ia, j.ib))
	if !w.ctx.warm: m.lvi = V0; m.avi = V0; m.lsi = V0; m.asi = V0
warm_motor(w World&, j JointSim&):
	m := &j.mo; s1 := jst(w, j.xa); s2 := jst(w, j.xb); ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p); li := m.lvi + m.lsi; ai := m.avi + m.asi
	if j.xa != -1: s := &w.sets[SET_AWAKE].states[j.xa]; s.v = msub(s1.v, j.ma, li); s.w = s1.w - mv(j.ia, cross(ra, li) + ai)
	if j.xb != -1: s := &w.sets[SET_AWAKE].states[j.xb]; s.v = madd(s2.v, j.mb, li); s.w = s2.w + mv(j.ib, cross(rb, li) + ai)
cap_imp(i float3, mx f32) float3: if vlen2(i) > mx * mx { sv(mx, nrm(i)) } else { i }
solve_motor(w World&, j JointSim&):
	m := &j.mo; s1 := jst(w, j.xa); s2 := jst(w, j.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w; ma := j.ma; mb := j.mb; ia := j.ia; ib := j.ib
	qa := qmul(s1.dq, j.fra.q); qb0 := qmul(s2.dq, j.frb.q); qb := if qdot(qa, qb0) < 0.0 { qneg(qb0) } else { qb0 }; rq := qimul(qa, qb)
	if m.mst > 0.0 && m.ahz > 0.0:
		b := sv(m.asp.bias, -rot(qa, delta_quat_rot(rq, QI))); oi := m.asi; im := msub(sv(-m.asp.ms, mv(m.amass, (wb - wa) + b)), m.asp.is, oi)
		m.asi = cap_imp(oi + im, w.ctx.h * m.mst); d := m.asi - oi; wa = wa - mv(ia, d); wb = wb + mv(ib, d)
	if m.mvt > 0.0:
		im := -mv(m.amass, (wb - wa) - m.av); oi := m.avi; m.avi = cap_imp(oi + im, w.ctx.h * m.mvt); d := m.avi - oi; wa = wa - mv(ia, d); wb = wb + mv(ib, d)
	ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p)
	if m.msf > 0.0 && m.lhz > 0.0:
		c := ((s2.dp - s1.dp) + (rb - ra)) + j.dc; b := sv(m.ls.bias, c); cd := (vb + cross(wb, rb)) - (va + cross(wa, ra))
		sol := solve3(kmat(ma, mb, j.ia, j.ib, ra, rb), cd + b); oi := m.lsi; im := msub(sv(-m.ls.ms, sol), m.ls.is, oi)
		m.lsi = cap_imp(m.lsi + im, w.ctx.h * m.msf); d := m.lsi - oi
		va = msub(va, ma, d); wa = wa - mv(ia, cross(ra, d)); vb = madd(vb, mb, d); wb = wb + mv(ib, cross(rb, d))
	if m.mvf > 0.0:
		cd := ((vb + cross(wb, rb)) - (va + cross(wa, ra))) - m.lv; im := -solve3(kmat(ma, mb, j.ia, j.ib, ra, rb), cd); oi := m.lvi
		m.lvi = cap_imp(m.lvi + im, w.ctx.h * m.mvf); d := m.lvi - oi
		va = msub(va, ma, d); wa = wa - mv(ia, cross(ra, d)); vb = madd(vb, mb, d); wb = wb + mv(ib, cross(rb, d))
	jput(w, j.xa, s1.flags, va, wa); jput(w, j.xb, s2.flags, vb, wb)
prep_par(w World&, j JointSim&):
	p := &j.pa; rq := qimul(j.fra.q, j.frb.q); p.px = half_axis(j.fra.q, rq, AX_X); p.py = half_axis(j.fra.q, rq, AX_Y); p.s = make_soft(p.hz, p.dr, w.ctx.h)
	if !w.ctx.warm: p.pi = float2{0.0, 0.0}
warm_par(w World&, j JointSim&):
	p := &j.pa; s1 := jst(w, j.xa); s2 := jst(w, j.xb); ai := blend2(p.pi.x, p.px, p.pi.y, p.py)
	jputw(w, j.xa, s1.flags, s1.w - mv(j.ia, ai)); jputw(w, j.xb, s2.flags, s2.w + mv(j.ib, ai))
solve_par(w World&, j JointSim&):
	p := &j.pa; s1 := jst(w, j.xa); s2 := jst(w, j.xb); wa ~= s1.w; wb ~= s2.w; ia := j.ia; ib := j.ib
	qa := qmul(s1.dq, j.fra.q); qb0 := qmul(s2.dq, j.frb.q); qb := if qdot(qa, qb0) < 0.0 { qneg(qb0) } else { qb0 }; rq := qimul(qa, qb)
	if !j.fixed && p.mt > 0.0:
		bx := p.s.bias * rq.x; by := p.s.bias * rq.y; px := half_axis(qa, rq, AX_X); py := half_axis(qa, rq, AX_Y); p.px = px; p.py = py; is := madd3(ia, ib)
		kxx := dot(px, mv(is, px)); kyy := dot(py, mv(is, py)); kxy := dot(px, mv(is, py)); wr := wb - wa; mx := w.ctx.h * p.mt; oi := p.pi
		sol := solve2(M2{float2{kxx, kxy}, float2{kxy, kyy}}, float2{dot(wr, px) + bx, dot(wr, py) + by})
		dx := -p.s.ms * sol.x - p.s.is * oi.x; dy := -p.s.ms * sol.y - p.s.is * oi.y; p.pi = float2{oi.x + dx, oi.y + dy}
		l2 := p.pi.x * p.pi.x + p.pi.y * p.pi.y
		if l2 > mx * mx: s := mx / fsqrt(l2); p.pi = float2{s * p.pi.x, s * p.pi.y}
		ai := blend2(p.pi.x - oi.x, px, p.pi.y - oi.y, py); wa = wa - mv(ia, ai); wb = wb + mv(ib, ai)
	jputw(w, j.xa, s1.flags, wa); jputw(w, j.xb, s2.flags, wb)
prep_weld(w World&, j JointSim&):
	e := &j.we; e.amass = minv(madd3(j.ia, j.ib))
	e.ls = if e.lhz == 0.0 { j.cs } else { make_soft(e.lhz, e.ldr, w.ctx.h) }; e.asp = if e.ahz == 0.0 { j.cs } else { make_soft(e.ahz, e.adr, w.ctx.h) }
	if !w.ctx.warm: e.li = V0; e.ai = V0
warm_weld(w World&, j JointSim&):
	e := &j.we; s1 := jst(w, j.xa); s2 := jst(w, j.xb); ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p)
	jput(w, j.xa, s1.flags, msub(s1.v, j.ma, e.li), s1.w - mv(j.ia, cross(ra, e.li) + e.ai)); jput(w, j.xb, s2.flags, madd(s2.v, j.mb, e.li), s2.w + mv(j.ib, cross(rb, e.li) + e.ai))
solve_weld(w World&, j JointSim&, ub bool):
	e := &j.we; s1 := jst(w, j.xa); s2 := jst(w, j.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w; ma := j.ma; mb := j.mb; ia := j.ia; ib := j.ib
	qa := qmul(s1.dq, j.fra.q); qb0 := qmul(s2.dq, j.frb.q); qb := if qdot(qa, qb0) < 0.0 { qneg(qb0) } else { qb0 }; rq := qimul(qa, qb)
	if !j.fixed:
		k := if ub || e.ahz > 0.0 { float3{1.0, e.asp.ms, e.asp.is} } else { float3{0.0, 1.0, 0.0} }
		b := if ub || e.ahz > 0.0 { sv(e.asp.bias, -rot(qa, delta_quat_rot(rq, QI))) } else { V0 }
		im := msub(sv(-k.y, mv(e.amass, (wb - wa) + b)), k.z, e.ai); e.ai = e.ai + im; wa = wa - mv(ia, im); wb = wb + mv(ib, im)
	ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p); cd := (vb + cross(wb, rb)) - (va + cross(wa, ra)); on := ub || e.lhz > 0.0
	b := if on { sv(e.ls.bias, ((s2.dp - s1.dp) + (rb - ra)) + j.dc) } else { V0 }; msc := if on { e.ls.ms } else { 1.0 }; isc := if on { e.ls.is } else { 0.0 }
	im := msub(sv(-msc, solve3(kmat(ma, mb, j.ia, j.ib, ra, rb), cd + b)), isc, e.li); e.li = e.li + im
	va = msub(va, ma, im); wa = wa - mv(ia, cross(ra, im)); vb = madd(vb, mb, im); wb = wb + mv(ib, cross(rb, im))
	jput(w, j.xa, s1.flags, va, wa); jput(w, j.xb, s2.flags, vb, wb)
prep_rev(w World&, j JointSim&):
	r := &j.rv; az := rot(j.fra.q, AX_Z); k := dot(az, mv(madd3(j.ia, j.ib), az)); r.am = if k > 0.0 { 1.0 / k } else { 0.0 }; r.az = az
	rq := qimul(j.fra.q, j.frb.q); r.px = half_axis(j.fra.q, rq, AX_X); r.py = half_axis(j.fra.q, rq, AX_Y); r.ss = make_soft(r.hz, r.dr, w.ctx.h)
	if !w.ctx.warm: r.li = V0; r.pi = float2{0.0, 0.0}; r.mi = 0.0; r.si = 0.0; r.loi = 0.0; r.upi = 0.0
warm_rev(w World&, j JointSim&):
	r := &j.rv; s1 := jst(w, j.xa); s2 := jst(w, j.xb); ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p)
	ai := madd(sv(r.pi.x, r.px) + sv(r.pi.y, r.py), r.si + r.mi + r.loi - r.upi, r.az)
	jput(w, j.xa, s1.flags, msub(s1.v, j.ma, r.li), s1.w - mv(j.ia, cross(ra, r.li) + ai)); jput(w, j.xb, s2.flags, madd(s2.v, j.mb, r.li), s2.w + mv(j.ib, cross(rb, r.li) + ai))
solve_rev(w World&, j JointSim&, ub bool):
	r := &j.rv; s1 := jst(w, j.xa); s2 := jst(w, j.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w; ma := j.ma; mb := j.mb; ia := j.ia; ib := j.ib
	qa := qmul(s1.dq, j.fra.q); qb0 := qmul(s2.dq, j.frb.q); qb := if qdot(qa, qb0) < 0.0 { qneg(qb0) } else { qb0 }; rq := qimul(qa, qb)
	if r.spring && !j.fixed:
		c := twist_angle_q(rq) - r.ta; cd := dot(wb - wa, r.az); di := -r.ss.ms * r.am * (cd + r.ss.bias * c) - r.ss.is * r.si; r.si += di
		wa = msub(wa, di, mv(ia, r.az)); wb = madd(wb, di, mv(ib, r.az))
	if r.motor && !j.fixed:
		cd := dot(wb - wa, r.az) - r.ms; mx := r.mmt * w.ctx.h; ni := fclamp(r.mi + -r.am * cd, -mx, mx); di := ni - r.mi; r.mi = ni
		wa = msub(wa, di, mv(ia, r.az)); wb = madd(wb, di, mv(ib, r.az))
	if r.limit && !j.fixed:
		an := twist_angle_q(rq); ax := r.az; k := lim_coef(an - r.la, ub, j.cs, w.ctx.inv_h); oi := r.loi
		di := -k.y * r.am * (dot(wb - wa, ax) + k.x) - k.z * oi; r.loi = fmax(oi + di, 0.0); d1 := r.loi - oi
		wa = msub(wa, d1, mv(ia, ax)); wb = madd(wb, d1, mv(ib, ax))
		k2 := lim_coef(r.ua - an, ub, j.cs, w.ctx.inv_h); oi2 := r.upi
		di2 := -k2.y * r.am * (dot(wa - wb, ax) + k2.x) - k2.z * oi2; r.upi = fmax(oi2 + di2, 0.0); d2 := r.upi - oi2
		wa = madd(wa, d2, mv(ia, ax)); wb = msub(wb, d2, mv(ib, ax))
	if !j.fixed:
		bx := if ub { j.cs.bias * rq.x } else { 0.0 }; by := if ub { j.cs.bias * rq.y } else { 0.0 }; msc := if ub { j.cs.ms } else { 1.0 }; isc := if ub { j.cs.is } else { 0.0 }
		px := half_axis(qa, rq, AX_X); py := half_axis(qa, rq, AX_Y); r.px = px; r.py = py; is := madd3(ia, ib)
		kxx := dot(px, mv(is, px)); kyy := dot(py, mv(is, py)); kxy := dot(px, mv(is, py)); wr := wb - wa; oi := r.pi
		sol := solve2(M2{float2{kxx, kxy}, float2{kxy, kyy}}, float2{dot(wr, px) + bx, dot(wr, py) + by})
		dx := -msc * sol.x - isc * oi.x; dy := -msc * sol.y - isc * oi.y; r.pi = float2{r.pi.x + dx, r.pi.y + dy}
		ai := sv(dx, px) + sv(dy, py); wa = wa - mv(ia, ai); wb = wb + mv(ib, ai)
	ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p); cd := ((vb + cross(wb, rb)) - va) - cross(wa, ra)
	b := if ub { sv(j.cs.bias, ((s2.dp - s1.dp) + (rb - ra)) + j.dc) } else { V0 }; msc := if ub { j.cs.ms } else { 1.0 }; isc := if ub { j.cs.is } else { 0.0 }
	im := sv(-msc, solve3(kmat(ma, mb, j.ia, j.ib, ra, rb), cd + b)) - sv(isc, r.li); r.li = r.li + im
	va = msub(va, ma, im); wa = wa - mv(ia, cross(ra, im)); vb = madd(vb, mb, im); wb = wb + mv(ib, cross(rb, im))
	jput(w, j.xa, s1.flags, va, wa); jput(w, j.xb, s2.flags, vb, wb)
prep_pris(w World&, j JointSim&):
	p := &j.pr; p.rm = minv(madd3(j.ia, j.ib)); m := qmat(j.fra.q); p.ax = m.cx; p.py = m.cy; p.pz = m.cz; p.ss = make_soft(p.hz, p.dr, w.ctx.h)
	if !w.ctx.warm: p.pi = float2{0.0, 0.0}; p.ai = V0; p.mi = 0.0; p.si = 0.0; p.loi = 0.0; p.upi = 0.0
warm_pris(w World&, j JointSim&):
	p := &j.pr; s1 := jst(w, j.xa); s2 := jst(w, j.xb); ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p)
	d := ((s2.dp - s1.dp) + j.dc) + (rb - ra); ax := rot(s1.dq, p.ax); py := rot(s1.dq, p.py); pz := rot(s1.dq, p.pz); rd := ra + d
	ai := p.si + p.mi + p.loi - p.upi; x := p.pi.x; y := p.pi.y
	pp := blend3(ai, ax, x, py, y, pz); la := blend3(ai, cross(rd, ax), x, cross(rd, py), y, cross(rd, pz)) + p.ai; lb := blend3(ai, cross(rb, ax), x, cross(rb, py), y, cross(rb, pz)) + p.ai
	jput(w, j.xa, s1.flags, msub(s1.v, j.ma, pp), s1.w - mv(j.ia, la)); jput(w, j.xb, s2.flags, madd(s2.v, j.mb, pp), s2.w + mv(j.ib, lb))
solve_pris(w World&, j JointSim&, ub bool):
	p := &j.pr; s1 := jst(w, j.xa); s2 := jst(w, j.xb); va ~= s1.v; wa ~= s1.w; vb ~= s2.v; wb ~= s2.w; ma := j.ma; mb := j.mb; ia := j.ia; ib := j.ib
	ra := rot(s1.dq, j.fra.p); rb := rot(s2.dq, j.frb.p); d := ((s2.dp - s1.dp) + j.dc) + (rb - ra); ax := rot(s1.dq, p.ax); rd := ra + d
	sax := cross(rd, ax); sbx := cross(rb, ax); tr := dot(d, ax); ka := ma + mb + dot(sax, mv(ia, sax)) + dot(sbx, mv(ib, sbx)); am := if ka > 0.0 { 1.0 / ka } else { 0.0 }
	if p.spring && !j.fixed:
		cd := dot(((vb + cross(wb, rb)) - va) - cross(wa, rd), ax); di := -p.ss.ms * am * (cd + p.ss.bias * (tr - p.tt)) - p.ss.is * p.si; p.si += di
		va = msub(va, ma, sv(di, ax)); wa = wa - mv(ia, sv(di, sax)); vb = madd(vb, mb, sv(di, ax)); wb = wb + mv(ib, sv(di, sbx))
	if p.motor && !j.fixed:
		cd := dot(((vb + cross(wb, rb)) - va) - cross(wa, rd), ax) - p.ms; mx := p.mmf * w.ctx.h; ni := fclamp(p.mi + -am * cd, -mx, mx); di := ni - p.mi; p.mi = ni
		va = msub(va, ma, sv(di, ax)); wa = wa - mv(ia, sv(di, sax)); vb = madd(vb, mb, sv(di, ax)); wb = wb + mv(ib, sv(di, sbx))
	if p.limit && !j.fixed:
		spd := 0.25 * (p.ut - p.lt); c1 := tr - p.lt
		if c1 < spd:
			k := lim_coef(c1, ub, j.cs, w.ctx.inv_h); cd := dot(((vb + cross(wb, rb)) - va) - cross(wa, rd), ax); oi := p.loi
			di := -k.y * am * (cd + k.x) - k.z * oi; p.loi = fmax(oi + di, 0.0); dd := p.loi - oi
			va = msub(va, ma, sv(dd, ax)); wa = wa - mv(ia, sv(dd, sax)); vb = madd(vb, mb, sv(dd, ax)); wb = wb + mv(ib, sv(dd, sbx))
		else:
			p.loi = 0.0
		c2 := p.ut - tr
		if c2 < spd:
			k := lim_coef(c2, ub, j.cs, w.ctx.inv_h); cd := -dot(((vb + cross(wb, rb)) - va) - cross(wa, rd), ax); oi := p.upi
			di := -k.y * am * (cd + k.x) - k.z * oi; p.upi = fmax(oi + di, 0.0); nd := oi - p.upi
			va = msub(va, ma, sv(nd, ax)); wa = wa - mv(ia, sv(nd, sax)); vb = madd(vb, mb, sv(nd, ax)); wb = wb + mv(ib, sv(nd, sbx))
		else:
			p.upi = 0.0
	if !j.fixed:
