add_key(ks u64[>..]&, a int, b int) bool:
	k := ((min(a, b) as! u64) << 32) | (max(a, b) as! u64)
	for x ks: if x == k { return false }
	if ks.len < 64: ks.push(k)
	true
find_key(ks u64[>..]&, a int, b int) bool:
	k := ((min(a, b) as! u64) << 32) | (max(a, b) as! u64)
	for x ks: if x == k { return true }
	false
add_vert(vs int[>..]&, a int) bool:
	for x vs: if x == a { return false }
	if vs.len < 64: vs.push(a)
	true
struct P2 { p float2, s f32, oi int }
better_cull(sc f32, s f32, bs f32, bsep f32, st f32, ss f32) bool:
	if sc > bs + st: return true
	if sc < bs - st: return false
	s < bsep - ss
cross2f(a float2, b float2) f32: a.x * b.y - a.y * b.x
cull_points(pt P2[>..]&) int:
	n ~= pt.len
	if n <= 1: return n
	sl := slop(); tol := 0.25 * sl; ts := tol * tol; fp P2[>..] ~= []
	bs ~= 0.0 as f32; bsep ~= FLT_MAX; b1 ~= -1; b2 ~= -1
	for i n:
		for j (i + 1)..n:
			d := pt[i].p - pt[j].p; sc := d.x * d.x + d.y * d.y; s := pt[i].s + pt[j].s
			if better_cull(sc, s, bs, bsep, ts, sl): b1 = i; b2 = j; bs = sc; bsep = s
	if bs < ts:
		di ~= 0
		for i 1..n: if pt[i].s < pt[di].s { di = i }
		if di != 0: pt[0] = pt[di]
		return 1
	fp.push(pt[b1]); fp.push(pt[b2]); pt[b2] = pt[n - 1]; pt[b1] = pt[n - 2]; n -= 2
	if n == 0: pt[0] = fp[0]; pt[1] = fp[1]; return 2
	a := fp[0].p; b ~= fp[1].p; ba ~= b - a; bs = 0.0; bsep = FLT_MAX; bi ~= -1; bsa ~= 0.0 as f32
	for i n:
		sa := cross2f(ba, pt[i].p - a); sc := fabs(sa)
		if better_cull(sc, pt[i].s, bs, bsep, ts, sl): bsa = sa; bs = sc; bsep = pt[i].s; bi = i
	if bi == -1: pt[0] = fp[0]; pt[1] = fp[1]; return 2
	fp.push(pt[bi])
	if n == 1: pt[0] = fp[0]; pt[1] = fp[1]; pt[2] = fp[2]; return 3
	pt[bi] = pt[n - 1]; n -= 1; c ~= fp[2].p
	if bsa < 0.0: t := b; b = c; c = t; ba = b - a
	cb := c - b; ac := a - c; bs = 0.0; bsep = FLT_MAX; bi = -1
