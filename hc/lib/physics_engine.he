	c.tv = rot(xa.q, a.tv) - rot(xb.q, b.tv)
	if (va.flags | vb.flags) & SF_HIT_EV != 0 { c.flags |= CF_SIM_HIT } else { c.flags &= ~CF_SIM_HIT }
