	var x f32 = binary::f32_from_bits(ux as u32);
	var y f32 = binary::f32_from_bits(uy as u32);
	if uy == (0xff << 23) { return y; }
	if ux >= (0xff << 23) || uy == 0 || ux - uy >= (25 << 23) { return y + x; }
