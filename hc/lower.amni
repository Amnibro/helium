var MSTK i32[>..<];
recursive fn lrefp(c int) int { let t = at(c); if t >= 0 && TY[t].k == TY_SLICE { let p, q = lsl(c); return p; } lrefv(c) }
recursive fn lrefv(n int) int { let fk = TY[fin(n)].k as int; let st = atc(n); let sk = if st >= 0 { TY[st].k as int } else { -1 }; if ND[n].k as int == N_UN && ND[n].op as int == T_AND { laddr(ND[n].a as int) } else { if sk == TY_REF && fk != TY_REF && fk != TY_NULL && is_lplace(n) { laddr(n) } else { if sk == TY_REF || sk == TY_NULL || fk == TY_NULL { lx(n) } else { laddr(n) } } } }
fn atc(n int) int { if ND[n].k as int == N_CALL && rk(n) == R_FN { let r = FI_[rv(n)].ret as int; if r >= 0 { return r; } } at(n) }
fn newmark() int { MUSE.push(0); MSLOT.push(-1); MUSE.len - 1 }
fn mark_use(m int) { if MUSE[m] == 0 { MUSE[m] = 1; MSLOT[m] = slot(8, 8) as i32; } if DSN < 0 { DSN = gslot(lookup(intern("RT_DS"), -1, D_GLOBAL)) + 8; } }
fn dsuse() { if MSTK.len > 0 { mark_use(MSTK[MSTK.len - 1] as int); } }
fn vwc(t int) int { let w = vw(t) as int; if w == 8 { 3 } else { if w == 4 { 6 } else { if w == 2 { 5 } else { 4 } } } }
fn vdat(p int, t int) int, int { let w = vw(t) as int; let lim = vlim(t); if w == 0 { return bin(B_ADD, 3, p, rtcall("rt_vhd", [p as i32, imm(0) as i32, imm(lim) as i32]), -1), rtcall("rt_uget", [p as i32]); } return addi(p, w * (lim + 1)), ldw(p, lim * w, vwc(t)); }
fn vmk(n int, cap int, t int) int { dsuse(); rtcall("rt_vmk", [n as i32, cap as i32, imm(vw(t) as int) as i32, imm(vlim(t)) as i32, imm(tsz(TY[t].a as int)) as i32]) }
fn vsame(a int, b int) bool { is_vimg(a) && is_vimg(b) && vw(a) == vw(b) && vlim(a) == vlim(b) }
recursive fn vptr_of(n int) int { let ft = fin(n); if TY[at(n)].k == TY_REF && (ft < 0 || TY[ft].k == TY_REF || ND[n].k as int == N_CALL) { ldw(lx1(n), 0, 3) } else { lx1(n) } }
recursive fn lvimg(n int, t int) int {
	let k = ND[n].k as int; let e = TY[t].a as int; let es = tsz(e); let x = ND[n];
	if is_seq(t) {
		if k == N_ARR { if x.c >= 0 { dsuse(); return rtcall("rt_vmk", [imm(0) as i32, lx(x.c as int) as i32, imm(vw(t) as int) as i32, imm(vlim(t)) as i32, imm(0) as i32]); } return lsqimg(n, e, vw(t) as int, vlim(t)); }
		if k != N_STR && vsame(deref(at(n)), t) { return vptr_of(n); }
