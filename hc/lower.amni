		else { qi++; if is_scal(pt) || TY[pt].k == TY_REF { stw(sa, 0, q, if TY[pt].k == TY_REF { 3 } else { wof(pt) }); } else { ir(I_COPY, 3, sa, q, imm(tsz(pt)), 0); own_drop(sa, pt); } } }
