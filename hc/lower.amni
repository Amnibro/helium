}
fn sdie(m const byte[:]) { let mp = nv(); ir(I_RADDR, 8, mp, -1, -1, rodata(m)); let lp = nv(); ir(I_RADDR, 8, lp, -1, -1, rodata("store")); rtcall("rt_abort", [mp as i32, imm(m.len) as i32, lp as i32, imm(5) as i32]); }
fn sguard(ok int, m const byte[:]) { let l = nlbl(); ir(I_BNZ, 3, -1, ok, -1, l); sdie(m); ir(I_LBL, 3, -1, -1, -1, l); }
fn rel_store(q int, p int, t int) {
	let opt = (TY[t].fl & RF_OPT) != 0; let sz = tsz(t); let d = nv();
	if relpool(t) >= 0 { ir(I_MOV, 3, d, imm(0), -1, 0); let l = nlbl(); ir(I_BZ, 3, -1, p, -1, l); ir(I_MOV, 3, d, bin(B_ADD, 3, bin(B_SUB, 3, p, rpool_base(t), -1), imm(1), -1), -1, 0); ir(I_LBL, 3, -1, -1, -1, l); if sz < 8 { sguard(lcmp(bin(B_SHR, 3, d, imm(sz * 8), -1), imm(0), CC_E), "pool-relative reference offset out of range"); } stw(q, 0, d, rw(t)); return; }
	ir(I_MOV, 3, d, imm(0), -1, 0); let l = nlbl(); ir(I_BZ, 3, -1, p, -1, l); ir(I_MOV, 3, d, bin(B_SUB, 3, p, q, -1), -1, 0);
