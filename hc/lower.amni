		if m == 2 { let p = ldw(a, 0, 3); rtcall("rt_qapv", [bf as i32, p as i32, lvsz(p, t) as i32]); return; }
		let c = ldw(bf, 0, 3); stw(a, 0, addi(c, 8), 3); stw(bf, 0, bin(B_ADD, 3, addi(c, 8), ldw(c, 0, 3), -1), 3); return;
	}
	if is_res(t) {
