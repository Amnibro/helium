		let p, c = lsl_at(a, t); rtps("[", false);
		let kv = nv(); ir(I_MOV, 3, kv, imm(0), -1, 0); let l0 = nlbl(); let l1 = nlbl(); let ls = nlbl(); ir(I_LBL, 3, -1, -1, -1, l0); let cc = nv(); ir(I_CMP, 3, cc, kv, c, CC_L); ir(I_BZ, 3, -1, cc, -1, l1);
		ir(I_BZ, 3, -1, kv, -1, ls); rtps(", ", false); ir(I_LBL, 3, -1, -1, -1, ls);
