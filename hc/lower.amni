	if TY[dt].k == TY_ENUM && TY[st].k == TY_VARIANT { let ei = TY[dt].a as int; let vi = TY[st].c as int; lzero(d, tsz(dt)); stw(d, 0, imm(vi), wof(dt)); if vsi(ei, vi) >= 0 { ir(I_COPY, 3, addi(d, epoff(ei)), sa, imm(tsz(st)), 0); } return; }
