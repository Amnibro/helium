import ir;
import opt;
import gen;
import flt;
var LSLOT i32[>..<];
var NFI i32[>..<];
var WORK i32[>..<];
var LBRK i32[>..<]; var LCNT i32[>..<];
var LERR byte[>..];
var SOFF i64[>..<]; var SSZ i64[>..<]; var SAL i64[>..<];
var GOFF i32[>..<];
var RETV int; var RETL int; var CUR int;
fn lerr(n int, m const byte[:]) { if LERR.len > 0 { return; } let x = TK[if n >= 0 { max(ND[n].t as int, 0) } else { 0 }]; LERR.append(nm(FILES[x.f].name)); format(LERR, ":", x.line, ": error: native backend: ", m); }
fn locs(n int) int { let x = TK[max(ND[n].t as int, 0)]; var b byte[>..] = []; b.append(nm(FILES[x.f].name)); format(b, ":", x.line); loc_id(b[..]) }
recursive fn tsz(t int) int {
	let k = TY[t].k as int;
	if k == TY_INT { return 1 << ((TY[t].s as int) & 3); }
	if k == TY_BOOL { return 1; }
	if k == TY_FLT { return TY[t].s as int; }
	if k == TY_REF || k == TY_FNV || k == TY_NULL { return if TY[t].c >= 0 { 1 << ((TY[t].c as int) & 3) } else { 8 }; }
	if k == TY_SLICE || k == TY_STRLIT { return 16; }
	if k == TY_STRUCT { slay(TY[t].a as int); return SSZ[TY[t].a] as int; }
	if k == TY_ARR { let e = TY[t].a as int; if is_fix(t) { return tsz(e) * (TY[t].b as int); } if is_lim(t) { return al(8 + tsz(e) * (TY[t].b as int), 8); } if is_res(t) { return 48; } return 8; }
	if k == TY_ILIT { return 8; } if k == TY_FLIT { return 8; }
	if k == TY_MULTI { let n = TY[t].n as int; return al(moff(t, n - 1) + tsz(mel(t, n - 1)), tal(t)); }
	if k == TY_ENUM { let ei = TY[t].a as int; if etag_only(ei) { return ENI[ei].tagsz as int; } var mx = 0; for i in ENI[ei].vnum { let si = vsi(ei, i); if si >= 0 { mx = max(mx, tsz(t_struct(si))); } } return al(epoff(ei) + mx, tal(t)); }
	if k == TY_VARIANT { let si = vsi(TY[t].a as int, TY[t].c as int); return if si >= 0 { tsz(t_struct(si)) } else { 0 }; }
	8
}
fn ssi(d int) int { let k = TY[d].k as int; if k == TY_STRUCT { TY[d].a as int } else { if k == TY_VARIANT { vsi(TY[d].a as int, TY[d].c as int) } else { -1 } } }
fn vsi(ei int, i int) int { let v = ENV[(ENI[ei].v0 as int) + i]; if v.si >= 0 && !STI[v.si].zero { v.si as int } else { -1 } }
fn etag_only(ei int) bool { ei_layout(ei); for i in ENI[ei].vnum { if vsi(ei, i) >= 0 { return false; } } true }
recursive fn epal(ei int) int { var a = ENI[ei].tagsz as int; for i in ENI[ei].vnum { let si = vsi(ei, i); if si >= 0 { a = max(a, tal(t_struct(si))); } } a }
recursive fn epoff(ei int) int { al(ENI[ei].tagsz as int, epal(ei)) }
fn mel(t int, i int) int { TYL[(TY[t].l as int) + i] as int }
recursive fn moff(t int, i int) int { var o = 0; for j in i + 1 { o = al(o, tal(mel(t, j))); if j == i { return o; } o += tsz(mel(t, j)); } o }
recursive fn tal(t int) int {
	let k = TY[t].k as int;
	if k == TY_STRUCT { slay(TY[t].a as int); return SAL[TY[t].a] as int; }
	if k == TY_ARR && is_fix(t) { return tal(TY[t].a as int); }
	if k == TY_ARR || k == TY_SLICE || k == TY_STRLIT { return 8; }
	if k == TY_MULTI { var a = 1; for j in TY[t].n { a = max(a, tal(mel(t, j))); } return a; }
	if k == TY_ENUM { let ei = TY[t].a as int; ei_layout(ei); if etag_only(ei) { return ENI[ei].tagsz as int; } return epal(ei); }
	if k == TY_VARIANT { let si = vsi(TY[t].a as int, TY[t].c as int); return if si >= 0 { tal(t_struct(si)) } else { 1 }; }
	min(tsz(t), 8)
}
recursive fn slay(si int) {
	while SSZ.len < STI.len { SSZ.push(-1); SAL.push(1); }
	while SOFF.len < SFI.len { SOFF.push(0); }
	if SSZ[si] >= 0 { return; }
	var o = 0; var a = 1;
	for j in STI[si].fnum { let fi = (STI[si].f0 as int) + j; let ft = SFI[fi].ty as int; if ft < 0 { continue; } let fa = tal(ft); o = al(o, fa); SOFF[fi] = o; o += tsz(ft); a = max(a, fa); }
	SSZ[si] = al(o, a); SAL[si] = a;
}
fn foff(si int, j int) int { slay(si); SOFF[(STI[si].f0 as int) + j] as int }
fn wof(t int) int { let k = TY[t].k as int; if k == TY_ENUM { return if ENI[TY[t].a].tagsz == 1 { 4 } else { 5 }; } if k == TY_INT { return TY[t].s as int; } if k == TY_FLT { return if TY[t].s == 4 { 10 } else { 11 }; } if k == TY_FLIT { return 11; } if k == TY_BOOL { return 4; } if k == TY_ILIT { return 3; } 3 }
fn is_scal(t int) bool { let k = TY[t].k as int; k == TY_INT || k == TY_BOOL || k == TY_FLT || k == TY_FLIT || k == TY_REF || k == TY_ILIT || k == TY_NULL || k == TY_FNV || k == TY_ENUM && etag_only(TY[t].a as int) || k == TY_VARIANT && vsi(TY[t].a as int, TY[t].c as int) < 0 || k == TY_ARR && is_vimg(t) }
fn is_pair(t int) bool { let k = TY[t].k as int; k == TY_SLICE || k == TY_STRLIT }
fn nf_of(i int) int { while NFI.len < FI_.len { NFI.push(-1); } if NFI[i] < 0 { NFI[i] = NFS.len as i32; NFS.push(NFn { 0, 0, 0, 0, i as i32 }); FOFF.push(0); WORK.push(i as i32); } NFI[i] as int }
fn lslot(v int) int { while LSLOT.len < LVS.len { LSLOT.push(-1); } if LSLOT[v] < 0 { let t = LVS[v].ty as int; LSLOT[v] = slot(tsz(t), tal(t)) as i32; } LSLOT[v] as int }
fn gslot(d int) int { while GOFF.len < GLT.len { GOFF.push(-1); } if GOFF[d] < 0 { let t = GLT[d] as int; BSS = al(BSS, tal(t)); GOFF[d] = BSS as i32; BSS += tsz(t); } GOFF[d] as int }
var CAPSL i32[>..<];
var CURI = -1; var LRF = -1; var LRVO i32[>..<];
fn bss(sz int, a int) int { BSS = al(BSS, max(a, 1)); let o = BSS; BSS += max(sz, 1); o }
fn lrflag() int { if LRF < 0 { LRF = bss(8, 8); } let d = nv(); ir(I_GADDR, 8, d, -1, -1, LRF); d }
fn lrval(f int) int { while LRVO.len < FI_.len { LRVO.push(-1); } let rt = FI_[f].ret as int; if LRVO[f] < 0 { LRVO[f] = bss(if rt >= 0 && rt != T_VOID { tsz(rt) } else { 8 }, if rt >= 0 && rt != T_VOID { tal(rt) } else { 8 }) as i32; } let d = nv(); ir(I_GADDR, 8, d, -1, -1, LRVO[f] as int); d }
fn lrcheck() {
	let fl = ldw(lrflag(), 0, 3); let lok = nlbl(); ir(I_BZ, 3, -1, fl, -1, lok);
	if CURI >= 0 && FI_[CURI].tg { let lno = nlbl(); ir(I_BZ, 3, -1, lcmp(fl, imm(CURI + 1), CC_E), -1, lno); stw(lrflag(), 0, imm(0), 3); let rt = FI_[CURI].ret as int; let va = lrval(CURI);
		if rt >= 0 && rt != T_VOID { if is_agg(rt) { ir(I_COPY, 3, RETV, va, imm(tsz(rt)), 0); } else { if is_pair(rt) { ir(I_MOV, 3, RETV, ldw(va, 0, 3), -1, 0); ir(I_MOV, 3, RETV2, ldw(va, 8, 3), -1, 0); } else { ir(I_MOV, 3, RETV, ldw(va, 0, wof(rt)), -1, 0); } } }
		drop_to(0); ir(I_JMP, 3, -1, -1, -1, RETL); ir(I_LBL, 3, -1, -1, -1, lno); }
	drop_to(0); ir(I_JMP, 3, -1, -1, -1, RETL); ir(I_LBL, 3, -1, -1, -1, lok);
}
fn lvaddr(v int) int { let d = nv(); if LVS[v].cfn as int != CUR { while CAPSL.len < LVS.len { CAPSL.push(-1); } if CAPSL[v] < 0 { lerr(-1, "captured variable without a capture slot"); return d; } ir(I_SLOT, 8, d, -1, -1, CAPSL[v] as int); return ldw(d, 0, 3); } ir(I_SLOT, 8, d, -1, -1, lslot(v)); d }
fn gctab(d int) {
	let g = DC[d].node as int; let x = ND[g]; let t = GLT[d] as int;
	if (x.fl & V_VAR) != 0 || x.b < 0 || TY[t].k != TY_ARR || !is_fix(t) { return; }
	let e = TY[t].a as int; let iv = kid(x.b as int, 0); let z = tsz(e); let nel = TY[t].b as int;
	if ND[iv].k as int != N_ARR || ND[iv].n as int != nel || !is_scal(e) || is_vimg(e) || TY[e].k == TY_REF { return; }
	var by byte[>..] = [];
	for j in nel { let q = kid(iv, j); var v = 0;
		if isf(e) { if ND[q].k as int != N_FLT { return; } let b = flt_bits(tok_text(ND[q].t as int)); v = (if wof(e) == 10 { d2f_bits(b) } else { b }) as! int; }
		else { if ND[q].k as int == N_TRUE { v = 1; } else { if ND[q].k as int != N_FALSE { let c, ok = kint(q); if !ok { return; } v = c; } } }
		for k in z { by.push(((v >> (8 * k)) & 255) as! byte); } }
	GCS.push(gslot(d) as i32); GCN.push(by.len as i32); GCP.push(GCB.len as i32); for c in by { GCB.push(c); }
}
fn gconst(d int, st int) int, bool {
	let g = DC[d].node as int; let x = ND[g]; let t = GLT[d] as int;
	if (x.fl & V_VAR) != 0 || x.b < 0 || !is_scal(t) || is_vimg(t) || TY[t].k == TY_REF { return 0, false; }
	let iv = kid(x.b as int, 0); let ik = ND[iv].k as int;
	if isf(t) { if ik != N_FLT || !isf(st) || wof(st) != wof(t) { return 0, false; } let b = flt_bits(tok_text(ND[iv].t as int)); return (if wof(t) == 10 { d2f_bits(b) } else { b }) as! int, true; }
	if isf(st) { return 0, false; }
	if ik == N_TRUE { return 1, true; } if ik == N_FALSE { return 0, true; }
	if !klit(iv) || !all_int(iv) { return 0, false; }
	let v, ok = ceval(iv, ns_of(g)); return v as int, ok;
}
fn vaddr(n int) int {
	let d = nv(); let r = rk(n);
	if r == R_LOCAL { return lvaddr(rv(n)); }
	if r == R_GLOBAL { ir(I_GADDR, 8, d, -1, -1, gslot(rv(n)) - (DA.len - DA.len)); return d; }
	var m byte[>..] = []; format(m, "unsupported variable ", r); lerr(n, m[..]); d
}
fn ldw(a int, off int, w int) int { let d = nv(); ir(I_LD, w, d, a, -1, off); d }
fn stw(a int, off int, v int, w int) { ir(I_ST, w, -1, a, v, off); }
fn bin(o int, w int, a int, b int, l int) int { let d = nv(); irl(I_BIN, w, d, a, b, o, l); d }
fn addi(a int, v int) int { if v == 0 { a } else { bin(B_ADD, 3, a, imm(v), -1) } }
recursive fn laddr(n int) int {
	let x = ND[n]; let k = x.k as int;
	if rel_of(n) >= 0 { return rel_load(rel_slot(n), rel_of(n)); }
	if k == N_ID { let t = if rk(n) == R_LOCAL { LVS[rv(n)].ty as int } else { if rk(n) == R_GLOBAL { GLT[rv(n)] as int } else { at(n) } }; if TY[t].k == TY_REF && TY[t].c < 0 { return ldw(vaddr(n), 0, 3); } return vaddr(n); }
	if k == N_DOT && rk(n) == R_FIELD {
		let bt = at(x.a as int); let d = deref(bt); let b = if TY[bt].k == TY_REF { lptr(x.a as int) } else { laddr(x.a as int) };
		if ssi(d) < 0 { lerr(n, "field of a non-struct"); return b; }
		let fa = addi(b, foff(ssi(d), rv(n))); let ft = at(n); if TY[ft].k == TY_REF && TY[ft].c < 0 { return ldw(fa, 0, 3); } return fa;
	}
	if k == N_IDX { return lidx(n); }
	if k == N_UN && x.op as int == T_MUL { return lx(x.a as int); }
	let t = fin(n);
	if TY[t].k == TY_REF { return lx(n); }
	let s = slot(tsz(t), tal(t)); let d = nv(); ir(I_SLOT, 8, d, -1, -1, s); lstore(d, n, t); tmp_drop(d, t); d
}
recursive fn lidx(n int) int {
	let x = ND[n]; let a = x.a as int; let bt = at(a); let d = deref(bt); let e = TY[d].a as int; let es = tsz(e);
	let i = lx(x.b as int); var base = -1; var len = -1;
	if is_fix(d) { base = laddr(a); len = imm(TY[d].b as int); }
	else { if TY[d].k == TY_SLICE || TY[d].k == TY_STRLIT || is_vimg(d) { let p, q = lsl(a); base = p; len = q; }
	else { if is_lim(d) { let b = laddr(a); len = ldw(b, 0, 3); base = addi(b, 8); }
	else { if is_res(d) { let b = laddr(a); base = ldw(b, 0, 3); len = ldw(b, 8, 3); }
	else { lerr(n, "indexing this array kind"); return i; } } } }
	irl(I_BCHK, 3, -1, i, len, 0, locs(n));
	bin(B_ADD, 3, base, bin(B_MUL, 3, i, imm(es), -1), -1)
}
fn boob(ok int, i int, len int, n int) { let l = nlbl(); ir(I_BNZ, 3, -1, ok, -1, l); let s0 = ARGL.len; ARGL.push(i as i32); ARGL.push(len as i32); let lc = locs(n); let r1 = nv(); ir(I_RADDR, 8, r1, -1, -1, LOCS[2 * lc] as int); ARGL.push(r1 as i32); ARGL.push(imm(LOCS[2 * lc + 1] as int) as i32); ir(I_CALL, 3, -1, s0, 4, rt_fn("rt_oob")); ir(I_LBL, 3, -1, -1, -1, l); }
fn rt_fn(name const byte[:]) int { let d = lookup(intern(name), -1, D_FN); if d < 0 { return -1; } for f, i in FI_ { if f.node == DC[d].node && f.st == 2 { return nf_of(i); } } -1 }
recursive fn lsl(n int) int, int {
	let t = at(n); if t >= 0 && is_seq(deref(t)) { lerr(n, "arrays of variable-size elements natively"); return imm(0), imm(0); } let c = cv(n); let k = ND[n].k as int;
	if k == N_STR || TY[t].k == TY_STRLIT { let s = tok_str_lit(n); let p = nv(); ir(I_RADDR, 8, p, -1, -1, rodata(s[..])); return p, imm(s.len); }
	let ft = if c >= 0 { c } else { t };
	let d = deref(t);
	if k == N_SLICE { return lslice(n); }
	if is_vimg(d) && k != N_STR && k != N_ARR { return vdat(vptr_of(n), d); }
	if k == N_CALL { let d = lcall(n); let ct = atc(n); if TY[ct].k == TY_MULTI { return ldw(d, 0, 3), ldw(d, 8, 3); } if is_agg(ct) { return lsl_at(d, deref(ct)); } return d, PAIR2; }
	if k == N_IF || k == N_BLOCK || k == N_EBLOCK || k == N_LOOP || k == N_MATCH { let a = nv(); ir(I_SLOT, 8, a, -1, -1, slot(16, 8)); lsink(n, a, if TY[t].k == TY_STRLIT { TT_STR } else { t }); return ldw(a, 0, 3), ldw(a, 8, 3); }
	if k == N_ARR { let ct = fin(n); let at0 = if TY[ct].k == TY_ARR { ct } else { if TY[t].k == TY_ARR { t } else { -1 } }; if at0 >= 0 { let ft = if is_fix(at0) || is_lim(at0) || is_res(at0) { at0 } else { t_arr(TY[at0].a as int, A_FIXED, ND[n].n as i64, -1) }; let q = nv(); ir(I_SLOT, 8, q, -1, -1, slot(tsz(ft), tal(ft))); lstore(q, n, ft); tmp_drop(q, ft); return lsl_at(q, ft); } }
	if !is_lplace(n) && TY[t].k != TY_REF && k != N_AS { var m byte[>..] = []; format(m, "slice from expression kind ", k, " resolved ", rk(n)); lerr(n, m[..]); return imm(0), imm(0); }
	if TY[d].k == TY_SLICE { let a = laddr(n); return ldw(a, 0, 3), ldw(a, 8, 3); }
	if is_fix(d) { return laddr(n), imm(TY[d].b as int); }
	if is_lim(d) { let a = laddr(n); return addi(a, 8), ldw(a, 0, 3); }
	if is_res(d) { let a = laddr(n); return ldw(a, 0, 3), ldw(a, 8, 3); }
	var m byte[>..] = []; format(m, "unsupported slice source ", k, " type kind ", TY[d].k); lerr(n, m[..]); return imm(0), imm(0);
}
recursive fn lslice(n int) int, int {
	let x = ND[n]; let a = x.a as int; let p, len = lsl(a); let es = tsz(TY[deref(at(a))].a as int);
	let lo = if x.b >= 0 { lx(x.b as int) } else { imm(0) }; let hi = if x.c >= 0 { lx(x.c as int) } else { len };
	let o1 = nv(); ir(I_CMP, 3, o1, lo, hi, CC_BE); let o2 = nv(); ir(I_CMP, 3, o2, hi, len, CC_BE); let ok = bin(B_AND, 3, o1, o2, -1); boob(ok, hi, len, n);
	return bin(B_ADD, 3, p, bin(B_MUL, 3, lo, imm(es), -1), -1), bin(B_SUB, 3, hi, lo, -1);
}
fn tok_str_lit(n int) byte[>..] { var b byte[>..] = []; b.append(tok_str(ND[n].t as int)); b }
recursive fn lstore(addr int, n int, t int) {
	if is_seq(t) { lerr(n, "arrays of variable-size elements natively"); return; }
	if is_vimg(t) { stw(addr, 0, lvimg(n, t), 3); return; }
	if is_rel(t) { rel_store(addr, lrefv(n), t); return; }
	if is_scal(t) { stw(addr, 0, lx(n), wof(t)); return; }
	if is_pair(t) { let p, q = lsl(n); stw(addr, 0, p, 3); stw(addr, 8, q, 3); return; }
	let k = ND[n].k as int;
	let st0 = deref(atc(n)); let sk = TY[st0].k as int;
	if TY[t].k == TY_ARR && st0 != t && (sk == TY_SLICE || sk == TY_STRLIT || sk == TY_ARR) && k != N_ARR && k != N_STR { lconv_arr(addr, n, t); return; }
	if is_lplace(n) || TY[at(n)].k == TY_REF { ir(I_COPY, 3, addr, laddr(n), imm(tsz(t)), 0); return; }
	if k == N_SLIT { lslit(addr, n, t); return; }
	if k == N_ARR { larr(addr, n, t); return; }
	if k == N_UN && ND[n].op as int == T_AND { ir(I_COPY, 3, addr, laddr(ND[n].a as int), imm(tsz(t)), 0); return; }
	if k == N_STR && TY[t].k == TY_ARR { if is_fix(t) { let sl = tok_str_lit(n); lzero(addr, tsz(t)); let p = nv(); ir(I_RADDR, 8, p, -1, -1, rodata(sl[..])); ir(I_COPY, 3, addr, p, imm(min(sl.len, tsz(t))), 0); } else { lconv_arr(addr, n, t); } return; }
	if k == N_CALL && TY[at(n)].k == TY_MULTI && TY[t].k != TY_MULTI { ir(I_COPY, 3, addr, lcall_to(n, -1), imm(tsz(t)), 0); return; }
	if k == N_CALL { lcall_to(n, addr); return; }
	if TY[t].k == TY_ENUM && sk == TY_VARIANT { let ei = TY[t].a as int; let vi = TY[st0].c as int; lzero(addr, tsz(t)); stw(addr, 0, imm(vi), wof(t)); if vsi(ei, vi) >= 0 { lstore(addi(addr, epoff(ei)), n, st0); } return; }
	if k == N_DOT && rk(n) == R_VARIANT { lzero(addr, tsz(t)); if TY[t].k == TY_ENUM { stw(addr, 0, imm(rv(n)), wof(t)); } return; }
	if k == N_IF || k == N_BLOCK || k == N_EBLOCK || k == N_LOOP || k == N_MATCH { lsink(n, addr, t); return; }
	var m byte[>..] = []; format(m, "constructing a value (kind ", k, ", resolved ", rk(n), ", type kind ", TY[t].k, ")"); lerr(n, m[..]);
}
recursive fn is_lplace(n int) bool { let k = ND[n].k as int; if k == N_ID { let r = rk(n); return r == R_LOCAL || r == R_GLOBAL; } if k == N_DOT { return rk(n) == R_FIELD; } k == N_IDX || k == N_UN && ND[n].op as int == T_MUL }
var SINKA i32[>..<]; var SINKT i32[>..<];
recursive fn lsink(n int, addr int, t int) { SINKA.push(addr as i32); SINKT.push(t as i32); lbranch(n, -2); SINKA.pop(); SINKT.pop(); }
fn sinkv(n int) { lstore(SINKA[SINKA.len - 1] as int, n, SINKT[SINKT.len - 1] as int); lmove_src(n); }
recursive fn lres_len(n int, b int, va int, ca int, cw int, eb int, cap int, nn int, e int, total int) {
	let es = tsz(e); let cur = ldw(ca, 0, cw);
	if b == B_POPN { lguard(n, bin(B_AND, 3, lcmp(nn, imm(0), CC_GE), lcmp(nn, cur, CC_LE), -1), "pop_n past the length"); stw(ca, 0, bin(B_SUB, 3, cur, nn, -1), cw); return; }
