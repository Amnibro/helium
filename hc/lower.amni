	if k == N_RET && x.n > 1 { let rt = FI_[CUR].ret as int; for i in x.n { let c = kid(n, i); lstore(addi(RETV, moff(rt, i)), c, mel(rt, i)); lmove_src(c); } drop_to(0); ir(I_JMP, 3, -1, -1, -1, RETL); return; }
