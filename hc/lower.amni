		else { let p = if m == 1 { ldw(a, 0, 3) } else { let c = ldw(bf, 0, 3); stw(bf, 0, bin(B_ADD, 3, addi(c, 8), ldw(c, 0, 3), -1), 3); addi(c, 8) }; let n = ldw(a, 8, 3); if sqv { rtcall("rt_sqfrom", [a as i32, p as i32, n as i32, ldw(a, 16, 3) as i32]); } else { rtcall("rt_rfrom", [a as i32, p as i32, n as i32, imm(es) as i32]); } }
		if !sqv && pneeds(e) { let b = ldw(a, 0, 3); let i, lt, le = lloop(ldw(a, 8, 3)); lwalk(m, bin(B_ADD, 3, b, bin(B_MUL, 3, i, imm(es), -1), -1), bf, e); lloop_end(i, lt, le); }
		return;
	}
	let k = TY[t].k as int;
	if k == TY_STRUCT || k == TY_VARIANT { let si = ssi(t); if si >= 0 { for j in STI[si].fnum { let ft = SFI[(STI[si].f0 as int) + j].ty as int; if ft >= 0 { lwalk(m, addi(a, foff(si, j)), bf, ft); } } } return; }
	if k == TY_ARR && is_fix(t) { let e = TY[t].a as int; for i in TY[t].b as int { lwalk(m, addi(a, i * tsz(e)), bf, e); } return; }
	if k == TY_ENUM { let ei = TY[t].a as int; let tg = ldw(a, 0, wof(t)); for i in ENI[ei].vnum { let si = vsi(ei, i); if si >= 0 && wneed(m, t_struct(si)) { let l = nlbl(); ir(I_BZ, 3, -1, lcmp(tg, imm(i), CC_E), -1, l); lwalk(m, addi(a, epoff(ei)), bf, t_struct(si)); ir(I_LBL, 3, -1, -1, -1, l); } } }
}
fn lvsz(p int, e int) int { rtcall("rt_vsz", [p as i32, imm(vw(e) as int) as i32, imm(vlim(e)) as i32, imm(tsz(TY[e].a as int)) as i32]) }
recursive fn lunflat(d int, p int, e int) int {
	if is_seq(e) { lerr(-1, "nested arrays of variable-size elements natively"); return imm(0); }
	if is_vimg(e) { if d >= 0 { stw(d, 0, p, 3); } return lvsz(p, e); }
	if is_vst(e) { let si = TY[e].a as int; var o = p; for j in STI[si].fnum { let f = SFI[(STI[si].f0 as int) + j]; if f.ty < 0 { o = addi(o, max(f.padn as int, 0)); continue; } o = bin(B_ADD, 3, o, lunflat(if d >= 0 { addi(d, foff(si, j)) } else { -1 }, o, f.ty as int), -1); } return bin(B_SUB, 3, o, p, -1); }
	if d >= 0 { ir(I_COPY, 3, d, p, imm(tsz(e)), 0); } imm(tsz(e))
}
recursive fn lflat(o int, s int, e int) int {
	if is_seq(e) { lerr(-1, "nested arrays of variable-size elements natively"); return imm(0); }
	if is_vimg(e) { let q = ldw(s, 0, 3); let z = lvsz(q, e); if o >= 0 { ir(I_COPY, 3, o, q, z, 0); } return z; }
	if is_vst(e) { let si = TY[e].a as int; var c = imm(0); for j in STI[si].fnum { let f = SFI[(STI[si].f0 as int) + j]; let oc = if o >= 0 { bin(B_ADD, 3, o, c, -1) } else { -1 }; if f.ty < 0 { let pn = max(f.padn as int, 0); if o >= 0 && pn > 0 { lzero(oc, pn); } c = addi(c, pn); continue; } c = bin(B_ADD, 3, c, lflat(oc, addi(s, foff(si, j)), f.ty as int), -1); } return c; }
	if o >= 0 { ir(I_COPY, 3, o, s, imm(tsz(e)), 0); } imm(tsz(e))
}
fn alit(t int, n int) int { if t >= 0 && TY[t].k == TY_ARRLIT && ND[n].k as int == N_ARR && ND[n].n > 0 { t_slice(deref(fin(kid(n, 0))), false) } else { t } }
fn sq(t int) bool { is_seq(t) && !is_fix(t) }
fn lsqof(a int, cnt int, e int) int { let es = tsz(e); var z = imm(0); for i in cnt { z = bin(B_ADD, 3, z, lflat(-1, addi(a, i * es), e), -1); } dsuse(); let o = rtcall("rt_dsput", [z as i32]); var c = o; for i in cnt { c = bin(B_ADD, 3, c, lflat(c, addi(a, i * es), e), -1); } o }
fn lsqbytes(p int, cnt int, e int) int { let q = nv(); ir(I_MOV, 3, q, p, -1, 0); let kv, lt, le = lloop(cnt); ir(I_MOV, 3, q, bin(B_ADD, 3, q, lunflat(-1, q, e), -1), -1, 0); lloop_end(kv, lt, le); bin(B_SUB, 3, q, p, -1) }
recursive fn lsqpush(va int, c int, e int) int { let s = ltmp(c, e); let z = lflat(-1, s, e); let o = rtcall("rt_sqput", [va as i32, z as i32]); lflat(o, s, e); o }
recursive fn lsqfill(va int, n int, e int) { let x = ND[n]; if x.a < 0 { for i in x.n { lsqpush(va, kid(n, i), e); } return; } let s = ltmp(x.a as int, e); let c = lx(x.b as int); let z = lflat(-1, s, e); let kv, lt, le = lloop(c); lflat(rtcall("rt_sqput", [va as i32, z as i32]), s, e); lloop_end(kv, lt, le); }
recursive fn lsqimg(n int, e int, w int, lim int) int {
	let x = ND[n]; dsuse();
	if x.a >= 0 { let s = ltmp(x.a as int, e); let c = lx(x.b as int); let h = rtcall("rt_vmk", [c as i32, c as i32, imm(w) as i32, imm(lim) as i32, imm(0) as i32]); let z = lflat(-1, s, e); let o = rtcall("rt_dsput", [bin(B_MUL, 3, z, c, -1) as i32]); let kv, lt, le = lloop(c); lflat(bin(B_ADD, 3, o, bin(B_MUL, 3, kv, z, -1), -1), s, e); lloop_end(kv, lt, le); return h; }
	let h = rtcall("rt_vmk", [imm(x.n as int) as i32, imm(x.n as int) as i32, imm(w) as i32, imm(lim) as i32, imm(0) as i32]);
