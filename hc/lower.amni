}
fn drop_to(h int) { var i = DROPS.len; while i > h { i -= 2; ldrop(DROPS[i] as int, DROPS[i + 1] as int); } }
fn own_drop(a int, t int) { if needs_drop(t) { DROPS.push(a as i32); DROPS.push(t as i32); } }
