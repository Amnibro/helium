recursive fn lslice(n int) int, int {
	let x = ND[n]; let a = x.a as int; if is_seq(deref(at(a))) && (x.b >= 0 || x.c >= 0) { lerr(n, "a range of an array of variable-size elements natively"); } let p, len = lsl(a); let es = tsz(TY[deref(at(a))].a as int);
