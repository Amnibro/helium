recursive fn klit(n int) bool { let x = ND[n]; let k = x.k as int; if k == N_INT { return true; } if k == N_ID { if rk(n) != R_GLOBAL { return false; } let cv, ok = gconst(rv(n), at(n)); return ok || const_of(rv(n)) >= 0; } if k == N_UN || k == N_AS { return x.a > n && klit(x.a as int); } if k == N_BIN { return x.a > n && x.b > n && klit(x.a as int) && klit(x.b as int); } false }
