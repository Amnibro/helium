}
recursive fn is_lplace(n int) bool { let k = ND[n].k as int; if k == N_ID { let r = rk(n); return r == R_LOCAL || r == R_GLOBAL; } if k == N_DOT { return rk(n) == R_FIELD; } k == N_IDX || k == N_UN && ND[n].op as int == T_MUL }
var SINKA i32[>..<]; var SINKT i32[>..<];
recursive fn lsink(n int, addr int, t int) { SINKA.push(addr as i32); SINKT.push(t as i32); lbranch(n, -2); SINKA.pop(); SINKT.pop(); }
fn sinkv(n int) { let st = SINKT[SINKT.len - 1] as int; lstore(SINKA[SINKA.len - 1] as int, n, st); if TY[st].k != TY_REF { lmove_src(n); } }
recursive fn lres_len(n int, b int, va int, ca int, cw int, eb int, cap int, nn int, e int, total int) {
	let es = tsz(e); let cur = ldw(ca, 0, cw);
