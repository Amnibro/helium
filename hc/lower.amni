recursive fn ldefv(fa int, d int, ft int) { let v, u, ok = cval(d); if ok && (TY[ft].k == TY_INT || TY[ft].k == TY_VARINT) { stw(fa, 0, imm(cwrap(v, if TY[ft].k == TY_INT { TY[ft].s as int } else { -1 })), wof(ft)); return; } let sa = AOWN; AOWN = GLOBI; lstore(fa, d, ft); AOWN = sa; }
recursive fn ndef(t int) bool { has_def(t) || hvimg(t) }
let EMPTYV byte[16] = [0; 16];
recursive fn ldefault(a int, t int) {
	if is_vimg(t) { let p = nv(); ir(I_RADDR, 8, p, -1, -1, rodata(EMPTYV[..])); stw(a, 0, p, 3); return; }
	if TY[t].k == TY_STRUCT { let si = TY[t].a as int; for j in STI[si].fnum { let f = SFI[(STI[si].f0 as int) + j]; let ft = f.ty as int; if ft < 0 { continue; } let fa = addi(a, foff(si, j)); if f.def >= 0 { ldefv(fa, f.def as int, ft); } else { if ndef(ft) { ldefault(fa, ft); } } } return; }
