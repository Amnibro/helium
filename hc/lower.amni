	if TY[t].k == TY_ENUM && sk == TY_VARIANT { let ei = TY[t].a as int; let vi = TY[st0].c as int; lzero(addr, tsz(t)); stw(addr, 0, imm(vi), wof(t)); if vsi(ei, vi) >= 0 { if TY[at(n)].k == TY_REF && !is_lplace(n) { ir(I_COPY, 3, addi(addr, epoff(ei)), if ND[n].k as int == N_CALL { lcall(n) } else { lptr(n) }, imm(tsz(st0)), 0); } else { lstore(addi(addr, epoff(ei)), n, st0); } } return; }
	if is_lplace(n) || TY[at(n)].k == TY_REF { ir(I_COPY, 3, addr, if is_lplace(n) { laddr(n) } else { if ND[n].k as int == N_CALL { lcall(n) } else { lptr(n) } }, imm(tsz(t)), 0); return; }
	if k == N_SLIT { lslit(addr, n, t); return; }
	if k == N_ARR { larr(addr, n, t); return; }
	if k == N_UN && ND[n].op as int == T_AND { ir(I_COPY, 3, addr, laddr(ND[n].a as int), imm(tsz(t)), 0); return; }
	if k == N_STR && TY[t].k == TY_ARR { if is_fix(t) { let sl = tok_str_lit(n); lzero(addr, tsz(t)); let p = nv(); ir(I_RADDR, 8, p, -1, -1, rodata(sl[..])); ir(I_COPY, 3, addr, p, imm(min(sl.len, tsz(t))), 0); } else { lconv_arr(addr, n, t); } return; }
	if k == N_CALL && TY[at(n)].k == TY_MULTI && TY[t].k != TY_MULTI { ir(I_COPY, 3, addr, lcall_to(n, -1), imm(tsz(t)), 0); return; }
	if k == N_CALL && TY[t].k == TY_MULTI && TY[atc(n)].k == TY_MULTI && atc(n) != t { let mt = atc(n); let tp = lcall_to(n, -1); for j in TY[t].n { let ea = addi(tp, moff(mt, j)); let et = mel(t, j); let st = mel(mt, j); if TY[st].k == TY_REF && TY[et].k != TY_REF { lconva(addi(addr, moff(t, j)), ldw(ea, 0, 3), deref(st), et); } else { lconva(addi(addr, moff(t, j)), ea, st, et); } } return; }
	if k == N_CALL { lcall_to(n, addr); return; }
	if k == N_DOT && rk(n) == R_VARIANT { lzero(addr, tsz(t)); if TY[t].k == TY_ENUM { stw(addr, 0, imm(rv(n)), wof(t)); } return; }
