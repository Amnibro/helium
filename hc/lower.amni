		ir(I_LBL, 3, -1, -1, -1, lend); }
	else { if k == TY_STRUCT { let si = x.a as int; rtps(ty_name(t)[..], false); rtps(" { ", false); var first = true; for j in STI[si].fnum { let f = SFI[(STI[si].f0 as int) + j]; if f.ty < 0 { continue; } if !first { rtps(", ", false); } first = false; lfmt_a(addi(a, foff(si, j)), f.ty as int); } rtps(" }", false); }
