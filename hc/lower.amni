}
fn limh(va int, d int) int, int, int, int { if is_vimg(d) { let p = ldw(va, 0, 3); let w = vw(d) as int; return addi(p, w), vwc(d), addi(p, 2 * w), ldw(p, 0, vwc(d)); } return va, lcw(d), addi(va, lco(d)), imm(TY[d].b as int); }
fn rw(t int) int { let z = tsz(t); if z == 1 { 0 } else { if z == 2 { 1 } else { if z == 4 { 2 } else { 3 } } } }
fn rpool_base(t int) int { let g = TY[t].b as int; let a = nv(); ir(I_GADDR, 8, a, -1, -1, gslot(g)); ldw(a, 0, 3) }
fn rel_load(q int, t int) int {
	let opt = (TY[t].fl & RF_OPT) != 0; let pool = relpool(t) >= 0;
	let d = ldw(q, 0, if pool { rw(t) | 4 } else { rw(t) }); let r = nv();
	ir(I_MOV, 3, r, if pool { bin(B_SUB, 3, bin(B_ADD, 3, rpool_base(t), d, -1), imm(1), -1) } else { bin(B_ADD, 3, q, d, -1) }, -1, 0);
	if opt || pool { let l = nlbl(); ir(I_BNZ, 3, -1, d, -1, l); ir(I_MOV, 3, r, imm(0), -1, 0); ir(I_LBL, 3, -1, -1, -1, l); }
