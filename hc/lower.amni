		let v0 = rv(n); let init = kid(x.b as int, 0); let mt = at(init);
		if mt >= 0 && TY[mt].k == TY_MULTI { let tp = nv(); ir(I_SLOT, 8, tp, -1, -1, slot(tsz(mt), tal(mt))); lstore(tp, init, mt); for i in x.n { let t = LVS[v0 + i].ty as int; let a = nv(); ir(I_SLOT, 8, a, -1, -1, lslot(v0 + i)); ir(I_COPY, 3, a, addi(tp, moff(mt, i)), imm(tsz(t)), 0); own_drop(a, t); } return; }
