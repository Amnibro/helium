	}
	if k == N_ARR {
		if x.c >= 0 { return vmk(imm(0), lx(x.c as int), t); }
		if x.a >= 0 { let c = lx(x.b as int); let p = vmk(c, c, t); let fv = ltmp(x.a as int, e); let base, q = vdat(p, t); lfill(base, c, e, fv); return p; }
		let p = vmk(imm(x.n as int), imm(x.n as int), t); let base, q = vdat(p, t); for i in x.n { lstore(addi(base, i * es), kid(n, i), e); } return p;
	}
	if k != N_STR && vsame(deref(at(n)), t) { return vptr_of(n); }
	let sp, sn = lsl(n); lvfrom(sp, sn, t)
}
fn lvfrom(sp int, sn int, t int) int { let e = TY[t].a as int; if is_seq(t) { let z = lsqbytes(sp, sn, e); dsuse(); return rtcall("rt_vfromz", [sp as i32, sn as i32, z as i32, imm(vw(t) as int) as i32, imm(vlim(t)) as i32]); } dsuse(); rtcall("rt_vfrom", [sp as i32, sn as i32, imm(vw(t) as int) as i32, imm(vlim(t)) as i32, imm(tsz(e)) as i32]) }
fn wneed(m int, t int) bool { if m == 0 { hvimg(t) } else { pneeds(t) } }
recursive fn lwalk(m int, a int, bf int, t int) {
