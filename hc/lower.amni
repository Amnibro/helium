fn rtcall(name const byte[:], args i32[:]) int { let s0 = ARGL.len; ARGL.append(args); let d = nv(); ir(I_CALL, 3, d, s0, args.len, rt_fn(name)); d }
fn locsl(n int) int, int { let lc = locs(n); let r = nv(); ir(I_RADDR, 8, r, -1, -1, LOCS[2 * lc] as int); return r, imm(LOCS[2 * lc + 1] as int); }
