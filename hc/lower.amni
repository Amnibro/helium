	}
	if is_scal(dt) && is_scal(st) && !isf(dt) && !isf(st) { stw(d, 0, ldw(sa, 0, wof(st)), wof(dt)); return; }
	if isf(dt) && (isf(st) || TY[st].k == TY_INT) { stw(d, 0, fconv(ldw(sa, 0, wof(st)), st, dt), wof(dt)); return; }
