		if ND[b].k as int == N_LIST { for i in na { let t = deref(at(kid(a, i))); let q = nv(); ir(I_SLOT, 8, q, -1, -1, slot(tsz(t), tal(t))); lstore(q, kid(b, i), t); tv.push(q as i32); } }
		else { let mt = at(b); let q = nv(); ir(I_SLOT, 8, q, -1, -1, slot(tsz(mt), tal(mt))); lstore(q, b, mt); for i in na { tv.push(addi(q, moff(mt, i)) as i32); } }
		for i in na { let c = kid(a, i); let t = deref(at(c)); let da = laddr(c); if needs_drop(t) { ldrop(da, t); } ir(I_COPY, 3, da, tv[i] as int, imm(tsz(t)), 0); }
