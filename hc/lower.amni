	var ci = 0; while ci < cq.len { let so = slot(8, 8); CAPSL[cq[ci + 1]] = so as i32; let sa = nv(); ir(I_SLOT, 8, sa, -1, -1, so); stw(sa, 0, cq[ci] as int, 3); ci += 2; }
