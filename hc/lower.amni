	else { var m byte[>..] = []; m.append("printing "); ty_name_into(t, m); m.append(" natively"); lerr(-1, m[..]); } } } }
	ir(I_LBL, 3, -1, -1, -1, RETL); ir(I_RET, 3, -1, -1, -1, 0);
