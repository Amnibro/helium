		if !is_res(t) { lerr(n, "arrays of variable-size elements natively"); return; }
		if k == N_ARR { lzero(addr, 48); lsqfill(addr, n, e); return; }
		if st0 != t && (TY[st0].k == TY_SLICE || TY[st0].k == TY_ARR) { let sp, sn = lsl(n); rtcall("rt_sqfrom", [addr as i32, sp as i32, sn as i32, lsqbytes(sp, sn, e) as i32]); return; }
	}
	if is_rel(t) { rel_store(addr, lrefv(n), t); return; }
	if TY[t].k == TY_REF && TY[t].c < 0 { stw(addr, 0, lrefv(n), 3); return; }
	if is_scal(t) { let ft = fin(n); if ft >= 0 && TY[ft].k == TY_REF && TY[ft].c < 0 && (TY[ft].fl & RF_OPT) == 0 && TY[t].k != TY_REF { stw(addr, 0, ldw(lx(n), 0, wof(t)), wof(t)); return; } stw(addr, 0, lx(n), wof(t)); return; }
	if is_pair(t) { let p, q = lsl(n); stw(addr, 0, p, 3); stw(addr, 8, q, 3); return; }
	let k = ND[n].k as int;
