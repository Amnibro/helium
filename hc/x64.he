RAX := 0; RCX := 1; RDX := 2; RBX := 3; RSP := 4; RBP := 5; RSI := 6; RDI := 7; R8 := 8; R9 := 9; R10 := 10; R11 := 11
ARGR := [7, 6, 2, 1, 8, 9]
CC_O := 0; CC_B := 2; CC_AE := 3; CC_E := 4; CC_NE := 5; CC_BE := 6; CC_A := 7; CC_L := 12; CC_GE := 13; CC_LE := 14; CC_G := 15
struct Fix { at i32, to i32, k u8 }
var XC byte[>..<]
var XFIX Fix[>..<]
xb(b int): XC.push(b as! byte);
x32(v int):
	for i 4: xb(v >> i * 8 & 255)
x64v(v int):
	for i 8: xb(v >> i * 8 & 255)
xrex(w bool, r int, x0 int, b int):
	x := if SIBM { SIBI } else { x0 }; v := 0x40 | (if w && !X32 { 8 } else { 0 }) | r >> 3 << 2 | x >> 3 << 1 | b >> 3; if v != 0x40: xb(v);
xrexb(r int, b int): xb(0x40 | r >> 3 << 2 | (if SIBM { SIBI >> 3 << 1 } else { 0 }) | b >> 3);
X32 ~= false; UFS ~= false; FRF ~= false; RIPM ~= false; RIPK ~= 0; RIPT ~= 0; TLSM ~= false; FSM ~= false; FSD ~= 0; SIBM ~= false; SIBI ~= 0; SIBS ~= 0; ABSM ~= false; ABST ~= 0; ABSK ~= 7; NOAB ~= false
xmem(r int, base int, d int):
	ev := EVD; EVD = false; if SIBM && ABSM { SIBM = false; ABSM = false; xb((r & 7) << 3 | 4); xb(SIBS << 6 | (SIBI & 7) << 3 | 5); XFIX.push(Fix{XC.len, ABST, ABSK}); x32(0); return } if SIBM { SIBM = false; if base == RBP { UFS = true } lo := base & 7; md := if d == 0 && lo != 5 { 0 } else { if d >= -128 && d < 128 && !ev { 0x40 } else { 0x80 } }; xb(md | (r & 7) << 3 | 4); xb(SIBS << 6 | (SIBI & 7) << 3 | lo); if md == 0x40 { xb(d & 255) } if md == 0x80 { x32(d) } return } if FSM { FSM = false; xb((r & 7) << 3 | 4); xb(0x25); x32(FSD); return } if RIPM { RIPM = false; xb((r & 7) << 3 | 5); XFIX.push(Fix{XC.len, RIPT, RIPK}); x32(0); return } if base == RBP { UFS = true } lo := base & 7; if d == 0 && lo != 5 { xb((r & 7) << 3 | lo); } else { if d >= -128 && d < 128 && !ev { xb(0x40 | (r & 7) << 3 | lo); } else { xb(0x80 | (r & 7) << 3 | lo); } } if lo == 4 { xb(0x24) } if d != 0 || lo == 5:
		if d >= -128 && d < 128 && !ev: xb(d & 255); else: x32(d);
xrr(op int, r int, rm int): xrex(true, r, 0, rm); xb(op); xb(0xC0 | (r & 7) << 3 | rm & 7);
mov_ri(r int, v int):
	if v >= 0 && v < 1 << 31: xrex(false, 0, 0, r); xb(0xB8 + (r & 7)); x32(v);
	else:
		if v >= -(1 << 31) && v < 0: xrex(true, 0, 0, r); xb(0xC7); xb(0xC0 | r & 7); x32(v); else: xrex(true, 0, 0, r); xb(0xB8 + (r & 7)); x64v(v);
mov_rr(d int, s int):
	if d != s: xrr(0x89, s, d);
ld(r int, base int, d int, w int, sx bool): LDS = XC.len; LDF = XFIX.len; LDR = r; LDW = w; ld0(r, base, d, w, sx); LDE = XC.len
ld0(r int, base int, d int, w int, sx bool): if w == 8 { xrex(true, r, 0, base); xb(0x8B); } else { if w == 4 { if sx { xrex(true, r, 0, base); xb(0x63); } else { xrex(false, r, 0, base); xb(0x8B); } } else { xrex(true, r, 0, base); xb(0x0F); xb(if w == 1 { if sx { 0xBE } else { 0xB6 } } else { if sx { 0xBF } else { 0xB7 } }); } } xmem(r, base, d);
st(r int, base int, d int, w int): if w == 2 { xb(0x66) } if w == 1 { xrexb(r, base); xb(0x88); xmem(r, base, d) } else { mop(0x89, r, base, d, w == 8) }
mop(o int, r int, base int, d int, q bool): xrex(q, r, 0, base); xb(o); xmem(r, base, d)
mri(ext int, base int, d int, v int, q bool = true): xrex(q, 0, 0, base); if v >= -128 && v < 128 { xb(0x83); xmem(ext, base, d); xb(v & 255) } else { xb(0x81); xmem(ext, base, d); x32(v) }
lea(r int, base int, d int): xrex(true, r, 0, base); xb(0x8D); xmem(r, base, d);
fs0(r int): xb(0x65); xrex(true, r, 0, 0); xb(0x8B); xb((r & 7) << 3 | 4); xb(0x25); x32(0);
lea_g(r int, off int):
	if TLSM:
		fs0(r); if off != 0: lea(r, r, off);
	else: lea_rip(r, 3, off);
lea_rip(r int, k int, to int): xrex(true, r, 0, 0); xb(0x8D); xb((r & 7) << 3 | 5); XFIX.push(Fix{XC.len, to, k}); x32(0);
alu(op int, d int, s int): xrr(op, s, d);
imul(d int, s int): xrex(true, d, 0, s); xb(0x0F); xb(0xAF); xb(0xC0 | (d & 7) << 3 | s & 7);
grp3(ext int, r int): xrex(true, 0, 0, r); xb(0xF7); xb(0xC0 | ext << 3 | r & 7);
shcl(ext int, r int): xrex(true, 0, 0, r); xb(0xD3); xb(0xC0 | ext << 3 | r & 7);
cqo(): xb(0x48); xb(0x99);
setcc(cc int, r int): xrexb(0, r); xb(0x0F); xb(0x90 + cc); xb(0xC0 | r & 7); xrex(true, r, 0, r); xb(0x0F); xb(0xB6); xb(0xC0 | (r & 7) << 3 | r & 7);
test_rr(a int, b int): xrr(0x85, b, a);
lg2(v int) int: k ~= 0; while (1 << k) < v { k++ } k
cmov(cc int, d int, s int): xrex(true, d, 0, s); xb(0x0F); xb(0x40 + cc); xb(0xC0 | (d & 7) << 3 | s & 7)
jmp_l(to int): xb(0xE9); XFIX.push(Fix{XC.len, to, 0}); x32(0);
jcc_l(cc int, to int): xb(0x0F); xb(0x80 + cc); XFIX.push(Fix{XC.len, to, 0}); x32(0);
call_f(f int): xb(0xE8); XFIX.push(Fix{XC.len, f, 1}); x32(0);
call_r(r int): xrex(false, 0, 0, r); xb(0xFF); xb(0xD0 | r & 7);
push_r(r int): xrex(false, 0, 0, r); xb(0x50 + (r & 7));
pop_r(r int): xrex(false, 0, 0, r); xb(0x58 + (r & 7));
sub_rsp(v int): xb(0x48); xb(0x81); xb(0xEC); x32(v);
add_rsp(v int): xb(0x48); xb(0x81); xb(0xC4); x32(v);
ret(): xb(0xC3);
leave(): xb(0xC9);
syscall(): xb(0x0F); xb(0x05);
ud2(): xb(0x0F); xb(0x0B);
VEXM ~= false; VEXL ~= 1; VXBAD ~= false; V3 ~= false; V4 ~= false; EVX ~= false; EVD ~= false
evx(pfx int, op int, mp int, r int, vv int, rm int, mem bool, dsp int): pp := if pfx == 0x66 { 1 } else { if pfx == 0xF3 { 2 } else { if pfx == 0xF2 { 3 } else { 0 } } }; xb(0x62); xb((if r & 8 == 0 { 0x80 } else { 0 }) | (if mem || rm & 16 == 0 { 0x40 } else { 0 }) | (if rm & 8 == 0 { 0x20 } else { 0 }) | (if r & 16 == 0 { 0x10 } else { 0 }) | mp); xb(0x80 | (15 - (vv & 15)) << 3 | 4 | pp); xb(0x40 | (if vv & 16 == 0 { 8 } else { 0 })); xb(op); if mem { xb(0x80 | (r & 7) << 3 | rm & 7); if rm & 7 == 4 { xb(0x24) } x32(dsp) } else { xb(0xC0 | (r & 7) << 3 | rm & 7) }
vexok(op int) bool:
	op == 0x10 || op == 0x11 || op == 0x28 || op == 0x29 || op == 0x6F || op == 0x7F || op >= 0x51 && op <= 0x5F && op != 0x5A && op != 0x5B || op >= 0x71 && op <= 0x76 || op >= 0x64 && op <= 0x66 || op >= 0xD1 && op <= 0xD5 || op >= 0xDA && op <= 0xE5 || op >= 0xE8 && op <= 0xEF || op >= 0xF1 && op <= 0xFE && op != 0xF7 || op == 0xC2
vexmv(op int) bool:
	op == 0x10 || op == 0x11 || op == 0x28 || op == 0x29 || op == 0x6F || op == 0x7F || op == 0x51 || op == 0x52
bmx(pfx int, d int, s int, c int, o int): l := VEXL; VEXL = 0; vexp(pfx, !X32, d, s, c, 2); VEXL = l; xb(o); xb(0xC0 | (d & 7) << 3 | s & 7)
vexp(pfx int, w bool, r int, b int, vv int, m int):
	x := if SIBM { SIBI } else { 0 }; pp := if pfx == 0x66 { 1 } else { if pfx == 0xF3 { 2 } else { if pfx == 0xF2 { 3 } else { 0 } } }
	if EVX && VEXL == 1: xb(0x62); xb((if r < 8 { 0x80 } else { 0 }) | (if x < 8 { 0x40 } else { 0 }) | (if b < 8 { 0x20 } else { 0 }) | 0x10 | m); xb(0x84 | (15 - vv) << 3 | pp); xb(0x48); EVD = true; return
	xb(0xC4); xb((if r < 8 { 0x80 } else { 0 }) | (if x < 8 { 0x40 } else { 0 }) | (if b < 8 { 0x20 } else { 0 }) | m); xb((if w { 0x80 } else { 0 }) | (15 - vv) << 3 | VEXL << 2 | (if pfx == 0x66 { 1 } else { if pfx == 0xF3 { 2 } else { if pfx == 0xF2 { 3 } else { 0 } } }))
sse(pfx int, w bool, op int, r int, rm int): if VEXM { if !vexok(op) { VXBAD = true } vexp(pfx, w, r, rm, if vexmv(op) { 0 } else { if op >= 0x71 && op <= 0x73 { rm } else { r } }, 1); xb(op); xb(0xC0 | (r & 7) << 3 | rm & 7); return } if pfx != 0 { xb(pfx) } xrex(w, r, 0, rm); xb(0x0F); xb(op); xb(0xC0 | (r & 7) << 3 | rm & 7);
alu_ri(ext int, r int, v int):
	xrex(true, 0, 0, r); if v >= -128 && v < 128: xb(0x83); xb(0xC0 | ext << 3 | r & 7); xb(v & 255); else: xb(0x81); xb(0xC0 | ext << 3 | r & 7); x32(v);
imul_ri(d int, s int, v int): xrex(true, d, 0, s); xb(0x69); xb(0xC0 | (d & 7) << 3 | s & 7); x32(v);
sh_ri(ext int, r int, v int): xrex(true, 0, 0, r); xb(0xC1); xb(0xC0 | ext << 3 | r & 7); xb(v & 63);
ssem(pfx int, w bool, op int, r int, base int, d int): if VEXM { if !vexok(op) { VXBAD = true } vexp(pfx, w, r, base, if vexmv(op) { 0 } else { r }, 1); xb(op); xmem(r, base, d); return } if pfx != 0 { xb(pfx) } xrex(w, r, 0, base); xb(0x0F); xb(op); xmem(r, base, d);
put32(at int, v int):
	for i 4: XC[at + i] = (v >> i * 8 & 255) as! byte
