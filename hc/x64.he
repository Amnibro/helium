RAX := 0; RCX := 1; RDX := 2; RBX := 3; RSP := 4; RBP := 5; RSI := 6; RDI := 7; R8 := 8; R9 := 9; R10 := 10; R11 := 11
ARGR := [7, 6, 2, 1, 8, 9]
CC_O := 0; CC_B := 2; CC_AE := 3; CC_E := 4; CC_NE := 5; CC_BE := 6; CC_A := 7; CC_L := 12; CC_GE := 13; CC_LE := 14; CC_G := 15
struct Fix { at i32, to i32, k u8 }
var XC byte[>..<]
var XFIX Fix[>..<]
xb(b int): XC.push(b as! byte);
x32(v int):
	for i 4: xb(v >> i * 8 & 255)
x64v(v int):
	for i 8: xb(v >> i * 8 & 255)
xrex(w bool, r int, x0 int, b int):
	x := if SIBM { SIBI } else { x0 }; v := 0x40 | (if w { 8 } else { 0 }) | r >> 3 << 2 | x >> 3 << 1 | b >> 3; if v != 0x40: xb(v);
xrexb(r int, b int): xb(0x40 | r >> 3 << 2 | (if SIBM { SIBI >> 3 << 1 } else { 0 }) | b >> 3);
RIPM ~= false; RIPK ~= 0; RIPT ~= 0; TLSM ~= false; FSM ~= false; FSD ~= 0; SIBM ~= false; SIBI ~= 0; SIBS ~= 0
xmem(r int, base int, d int):
	if SIBM { SIBM = false; lo := base & 7; md := if d == 0 && lo != 5 { 0 } else { if d >= -128 && d < 128 { 0x40 } else { 0x80 } }; xb(md | (r & 7) << 3 | 4); xb(SIBS << 6 | (SIBI & 7) << 3 | lo); if md == 0x40 { xb(d & 255); }; if md == 0x80 { x32(d); }; return; }; if FSM { FSM = false; xb((r & 7) << 3 | 4); xb(0x25); x32(FSD); return; }; if RIPM { RIPM = false; xb((r & 7) << 3 | 5); XFIX.push(Fix{XC.len as i32, RIPT as i32, RIPK as u8}); x32(0); return; }; lo := base & 7; if d == 0 && lo != 5 { xb((r & 7) << 3 | lo); } else { if d >= -128 && d < 128 { xb(0x40 | (r & 7) << 3 | lo); } else { xb(0x80 | (r & 7) << 3 | lo); } }; if lo == 4 { xb(0x24); }; if d != 0 || lo == 5:
		if d >= -128 && d < 128: xb(d & 255); else: x32(d);
xrr(op int, r int, rm int): xrex(true, r, 0, rm); xb(op); xb(0xC0 | (r & 7) << 3 | rm & 7);
mov_ri(r int, v int):
	if v >= 0 && v < 1 << 31: xrex(false, 0, 0, r); xb(0xB8 + (r & 7)); x32(v);
	else:
		if v >= -(1 << 31) && v < 0: xrex(true, 0, 0, r); xb(0xC7); xb(0xC0 | r & 7); x32(v); else: xrex(true, 0, 0, r); xb(0xB8 + (r & 7)); x64v(v);
mov_rr(d int, s int):
	if d != s: xrr(0x89, s, d);
ld(r int, base int, d int, w int, sx bool): if w == 8 { xrex(true, r, 0, base); xb(0x8B); } else { if w == 4 { if sx { xrex(true, r, 0, base); xb(0x63); } else { xrex(false, r, 0, base); xb(0x8B); } } else { xrex(true, r, 0, base); xb(0x0F); xb(if w == 1 { if sx { 0xBE } else { 0xB6 } } else { if sx { 0xBF } else { 0xB7 } }); } }; xmem(r, base, d);
st(r int, base int, d int, w int): if w == 2 { xb(0x66); }; if w == 1 { xrexb(r, base); } else { xrex(w == 8, r, 0, base); }; xb(if w == 1 { 0x88 } else { 0x89 }); xmem(r, base, d);
lea(r int, base int, d int): xrex(true, r, 0, base); xb(0x8D); xmem(r, base, d);
fs0(r int): xb(0x65); xrex(true, r, 0, 0); xb(0x8B); xb((r & 7) << 3 | 4); xb(0x25); x32(0);
lea_g(r int, off int):
	if TLSM:
		fs0(r); if off != 0: lea(r, r, off);
	else: lea_rip(r, 3, off);
lea_rip(r int, k int, to int): xrex(true, r, 0, 0); xb(0x8D); xb((r & 7) << 3 | 5); XFIX.push(Fix{XC.len as i32, to as i32, k as u8}); x32(0);
alu(op int, d int, s int): xrr(op, s, d);
imul(d int, s int): xrex(true, d, 0, s); xb(0x0F); xb(0xAF); xb(0xC0 | (d & 7) << 3 | s & 7);
grp3(ext int, r int): xrex(true, 0, 0, r); xb(0xF7); xb(0xC0 | ext << 3 | r & 7);
shcl(ext int, r int): xrex(true, 0, 0, r); xb(0xD3); xb(0xC0 | ext << 3 | r & 7);
cqo(): xb(0x48); xb(0x99);
setcc(cc int, r int): xrexb(0, r); xb(0x0F); xb(0x90 + cc); xb(0xC0 | r & 7); xrex(true, r, 0, r); xb(0x0F); xb(0xB6); xb(0xC0 | (r & 7) << 3 | r & 7);
test_rr(a int, b int): xrr(0x85, b, a);
jmp_l(to int): xb(0xE9); XFIX.push(Fix{XC.len as i32, to as i32, 0}); x32(0);
jcc_l(cc int, to int): xb(0x0F); xb(0x80 + cc); XFIX.push(Fix{XC.len as i32, to as i32, 0}); x32(0);
call_f(f int): xb(0xE8); XFIX.push(Fix{XC.len as i32, f as i32, 1}); x32(0);
call_r(r int): xrex(false, 0, 0, r); xb(0xFF); xb(0xD0 | r & 7);
push_r(r int): xrex(false, 0, 0, r); xb(0x50 + (r & 7));
pop_r(r int): xrex(false, 0, 0, r); xb(0x58 + (r & 7));
sub_rsp(v int): xb(0x48); xb(0x81); xb(0xEC); x32(v);
add_rsp(v int): xb(0x48); xb(0x81); xb(0xC4); x32(v);
ret(): xb(0xC3);
leave(): xb(0xC9);
syscall(): xb(0x0F); xb(0x05);
ud2(): xb(0x0F); xb(0x0B);
sse(pfx int, w bool, op int, r int, rm int): if pfx != 0 { xb(pfx); }; xrex(w, r, 0, rm); xb(0x0F); xb(op); xb(0xC0 | (r & 7) << 3 | rm & 7);
alu_ri(ext int, r int, v int):
	xrex(true, 0, 0, r); if v >= -128 && v < 128: xb(0x83); xb(0xC0 | ext << 3 | r & 7); xb(v & 255); else: xb(0x81); xb(0xC0 | ext << 3 | r & 7); x32(v);
imul_ri(d int, s int, v int): xrex(true, d, 0, s); xb(0x69); xb(0xC0 | (d & 7) << 3 | s & 7); x32(v);
sh_ri(ext int, r int, v int): xrex(true, 0, 0, r); xb(0xC1); xb(0xC0 | ext << 3 | r & 7); xb(v & 63);
ssem(pfx int, w bool, op int, r int, base int, d int): if pfx != 0 { xb(pfx); }; xrex(w, r, 0, base); xb(0x0F); xb(op); xmem(r, base, d);
put32(at int, v int):
	for i 4: XC[at + i] = (v >> i * 8 & 255) as! byte
