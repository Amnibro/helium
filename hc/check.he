deref_place(t int) int:
	if TY[t].k == TY_REF && TY[t].c < 0:
		TY[t].a as int
	else:
		t
recursive ck_id(n int, want int) int:
	name := ND[n].s as int
	v := find_lv(name)
	if v >= 0 && LVS[v].fl & LV_CFB != 0: b := LVS[v].node as int; set_r(n, R_CFB, b); c := CFBS[b]; if c.k == 2 { cerr(n, "a field accessor is written in a member access or an initializer label"); return set_t(n, T_ERRT); }; t := cf_ty(b); if want >= 0 && is_pending(t) && (TY[want].k == TY_INT || TY[want].k == TY_FLT) { set_t(n, t); conv(n, want); return want; }; return set_t(n, t)
