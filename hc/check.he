		if (ka == TY_STRUCT || ka == TY_ARR || ka == TY_ENUM || ka == TY_VARIANT || ka == TY_SLICE) && da == db: set_x(n, 3); return set_t(n, T_BOOL)
		if ka == TY_ENUM && kb == TY_VARIANT || ka == TY_VARIANT && kb == TY_ENUM: set_x(n, 3); return set_t(n, T_BOOL)
		if ka == TY_ARRLIT || kb == TY_ARRLIT: if ka == TY_ARRLIT { conv(a, db); } else { conv(b, da); }; set_x(n, 3); return set_t(n, T_BOOL)
		if (ka == TY_ARR || ka == TY_SLICE) && (kb == TY_ARR || kb == TY_SLICE) && TY[da].a == TY[db].a: st := t_slice(TY[da].a as int, false); conv(a, st); conv(b, st); set_x(n, 3); return set_t(n, T_BOOL)
