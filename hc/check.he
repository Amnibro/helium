use decl
R_NONE := 0; R_LOCAL := 1; R_GLOBAL := 2; R_FN := 3; R_BUILTIN := 4; R_FIELD := 5; R_CONST := 6; R_VARIANT := 7; R_MEMBER := 8; R_CTOR := 9; R_BLOCK := 10; R_UFCS := 11; R_VCTOR := 12; R_FCONST := 13; R_CASE := 14; R_CFB := 15
LV_LIT := 128; LPN := -7; LV_VAR := 1; LV_CONST := 2; LV_PARAM := 4; LV_REF := 8; LV_FOR := 16; LV_BLKP := 32; LV_FLET := 64; LV_CFB := 256
IS_DONE := 2
struct FnI { node i32, lo i32, hi i32, ab i32, par i32, cfn i32, g0 i32, gn i32, ret i32, p0 i32, pn i32, st u8, lr bool, blk i32, bown i32, name i32, fl u16, rinf bool, tg bool, nc bool, dy bool }
struct LV { name i32, ty i32, fl u16, cfn i32, own i32, node i32, cnt i32 }
struct Cap { inst i32, lv i32 }
struct CEdge { caller i32, callee i32 }
var FI_ FnI[>..]
var LVS LV[>..]
var SCOPE i32[>..<]
var NAR i32[>..<]
var CAPS Cap[>..]
var CEDGES CEdge[>..]
var GBS Gb[>..]
var AT i32[>..]; var AC i32[>..]; var AK u8[>..]; var AV i32[>..]; var AX i32[>..]; var AD u8[>..]
CI int ~= -1
AOWN int ~= -1
CFN int ~= -1
GLOBI int ~= -1
var CERR byte[>..]
var NERR int
RETWANT int ~= -1
var LOOPD int
var ARGW i32[>..<]
var ORDER i32[>..]
cerrl(f int, line int, m const byte[:]): NERR++; if CERR.len > 0 { return; }; CERR.append(nm(FILES[f].name)); format(CERR, ":", line, ": error: ", m);
cerr(n int, m const byte[:]): NERR++; if CERR.len > 0 { return; }; x := TK[ND[max(n, 0)].t]; CERR.append(nm(FILES[x.f].name)); format(CERR, ":", x.line, ": error: ", m);
new_inst(node int, lo int, hi int, par int) int:
	i := FI_.len
	FI_.push(FnI{node: node as i32, lo: lo as i32, hi: hi as i32, ab: AT.len as i32, par: par as i32, cfn: i as i32, g0: GBS.len as i32, gn: 0, ret: -1, p0: 0, pn: 0, st: 0, blk: -1, bown: -1, name: if node >= 0 { ND[node].s } else { -1 }, ..})
	n := hi - lo
	AT.resize(AT.len + n, -1); AC.resize(AC.len + n, -1); AK.resize(AK.len + n, 0); AV.resize(AV.len + n, -1); AX.resize(AX.len + n, -1); AD.resize(AD.len + n, 0)
	i
aix(n int) int:
	i ~= AOWN
	while i >= 0: f := FI_[i]; if n >= (f.lo as int) && n < f.hi as int { return f.ab as int + n - f.lo as int; }; i = f.par as int
	g := FI_[GLOBI]
	g.ab as int + n
at(n int) int:
	AT[aix(n)] as int
dead(n int) bool:
	n >= 0 && AD[aix(n)] == 1
var LRK i32[>..<]
lrkey(i int) int:
	nd := FI_[i].node; r := FI_[i].ret; k ~= 0; while k < LRK.len { if LRK[k] == nd && LRK[k + 1] == r { return k / 2; }; k += 2; }; LRK.push(nd); LRK.push(r); LRK.len / 2 - 1
lrtg(i int) bool:
	if FI_[i].tg { return true; }; for f FI_ { if f.tg && f.node == FI_[i].node && f.ret == FI_[i].ret { return true; } }; false
set_t(n int, t int) int:
	AT[aix(n)] = t as i32; t
set_r(n int, k int, v int): i := aix(n); AK[i] = k as u8; AV[i] = v as i32
rk(n int) int:
	AK[aix(n)] as int
rv(n int) int:
	AV[aix(n)] as int
set_x(n int, v int): AX[aix(n)] = v as i32
ax(n int) int:
	AX[aix(n)] as int
set_cv(n int, t int): AC[aix(n)] = t as i32
cv(n int) int:
	AC[aix(n)] as int
tn(t int) byte[>..]:
	ty_name(t)
add_lv(name int, t int, fl int, node int) int:
	LVS.push(LV{name as i32, t as i32, fl as u16, CFN as i32, AOWN as i32, node as i32, 0})
	SCOPE.push((LVS.len - 1) as i32)
	LVS.len - 1
visible_in(own int, cur int) bool:
	i ~= cur; while i >= 0 { if i == own { return true; }; i = FI_[i].par as int; }; false
visible(own int) bool:
	visible_in(own, AOWN)
find_lv(name int) int:
	i ~= SCOPE.len - 1
	while i >= 0: v := SCOPE[i] as int; if LVS[v].name as int == name && visible(LVS[v].own as int) { return v; }; i--
	-1
add_cap_one(cf int, v int) bool:
	if cf < 0 || cf == LVS[v].cfn as int: return false
	for x CAPS:
		if x.inst as int == cf && x.lv as int == v: return false
	CAPS.push(Cap{cf as i32, v as i32})
	true
note_cap(v int):
	own := LVS[v].own as int
	a ~= AOWN
	while a >= 0 && a != own:
		add_cap_one(FI_[a].cfn as int, v)
		a = FI_[a].par as int
var DYT i32[>..<]
dyt_add(i int, t int): k ~= 0; while k < DYT.len { if DYT[k] as int == i && DYT[k + 1] as int == t { return; }; k += 2; }; DYT.push(i as i32); DYT.push(t as i32); FI_[i].dy = true
note_edge(callee int):
	if CFN < 0 || callee < 0 || CFN == callee: return
	if FI_[callee].dy:
		k ~= 0; n0 := DYT.len; while k < n0: if DYT[k] as int == callee && DYT[k + 1] as int != CFN && !is_lex_anc(DYT[k + 1] as int, CFN) { dyt_add(CFN, DYT[k + 1] as int); }; k += 2
	for e CEDGES:
		if e.caller as int == CFN && e.callee as int == callee: return
	CEDGES.push(CEdge{CFN as i32, callee as i32});
recursive narrow_push(c int):
	if c < 0: return
	x := ND[c]; k := x.k as int
	if k == N_ID && rk(c) == R_LOCAL:
		v := rv(c)
		t := LVS[v].ty as int
		if TY[t].k == TY_REF && TY[t].fl & RF_OPT != 0:
			NAR.push(v as i32); NAR.push(t as i32)
			LVS[v].ty = t_ref(TY[t].a as int, 0) as i32
		return
	if k == N_BIN && x.op as int == T_ANDAND:
		narrow_push(x.a as int)
		narrow_push(x.b as int);
narrow_pop(m int):
	while NAR.len > m:
		old_t := NAR.pop()
		v := NAR.pop() as int
		LVS[v].ty = old_t
is_pending(t int) bool:
	k := TY[t].k as int; k == TY_ILIT || k == TY_FLIT || k == TY_STRLIT || k == TY_ARRLIT || k == TY_NULL
int_fits(v i64, uns bool, t int) bool:
	if TY[t].k != TY_INT: return false
	if uns: return !is_signed(t) && ibits(t) == 64
	if v < 0: return is_signed(t) && v >= int_min(t)
	(v as u64) <= int_max_u(t)
widens(f int, t int) bool:
	if f == t: return true
	a := TY[f]; b := TY[t]
	if a.k == TY_INT && b.k == TY_INT: fs := is_signed(f); ts := is_signed(t); if fs == ts { return ibits(t) > ibits(f); }; return !fs && ts && ibits(t) > ibits(f)
	if a.k == TY_INT && b.k == TY_FLT: return true
	if a.k == TY_FLT && b.k == TY_FLT: return b.s > a.s
	if a.k == TY_INT && b.k == TY_VARINT: return !(ibits(f) == 64 && !is_signed(f))
	if a.k == TY_VARINT && b.k == TY_INT: return t == T_I64
	false
is_lp(n int) bool:
	ND[n].k as int == N_ID && rk(n) == R_LOCAL && LVS[rv(n)].fl & (LV_LIT | LV_VAR) == LV_LIT
recursive lp_tail(n int) bool:
	k := ND[n].k as int; if k == N_BLOCK || k == N_EBLOCK { return ND[n].a >= 0 && lp_tail(ND[n].a as int); }; is_lp(n)
pend_local(r int) bool:
	if ND[r].k as int != N_ID || rk(r) != R_LOCAL { return false; }; t := deref(LVS[rv(r)].ty as int); TY[t].k == TY_ARR && TY[t].a as int == T_ERRT
complete(r int, e int): t := deref(LVS[rv(r)].ty as int); nt0 := t_arr(e, TY[t].s as int, TY[t].b, TY[t].c as int); LVS[rv(r)].ty = nt0 as i32; set_t(r, nt0);
big_u(n int) bool:
	v, u, ok := cval(n); ok && u && v < 0
cinit(n int) int:
	kid(ND[DC[CONSTD[rv(n)]].node].b as int, 0)
recursive bn_ad(n int) bool:
	x := ND[n]; k := x.k as int
	if k == N_UN && x.op as int == T_BITNOT: v, u, ok := cval(x.a as int); return ok && v >= 0
	if k == N_ID && rk(n) == R_CONST: iv := cinit(n); if ND[iv].k as int != N_UN || ND[iv].op as int != T_BITNOT { return false; }; v, ok := ceval(ND[iv].a as int, ns_of(DC[CONSTD[rv(n)]].node as int)); return ok && v >= 0
	false
recursive cval(n int) i64, bool, bool:
	if n < 0: return 0, false, false
	x := ND[n]; k := x.k as int
	if k == N_INT: return TK[x.t].v, TK[x.t].uns, true
	if k == N_UN: v, u, ok := cval(x.a as int); if !ok { return 0, false, false; }; if x.op as int == T_MINUS { if v == -9223372036854775807 - 1 && ND[x.a].k as int != N_INT { return 0, false, false; }; return -v, false, true; }; if x.op as int == T_BITNOT { return ~v, false, true; }; return 0, false, false
	if k == N_ID && rk(n) == R_CONST: iv := cinit(n); return CONSTV[rv(n)], ND[iv].k as int == N_INT && TK[ND[iv].t].uns, true
	if k == N_ID && rk(n) == R_CFB: c := CFBS[rv(n)]; if c.k != 0 { return 0, false, false; }; sa := AOWN; AOWN = c.b as int; v, u, ok := cval(c.a as int); AOWN = sa; return v, u, ok
	if k == N_BIN:
		a, ua, oa := cval(x.a as int); b, ub, ob := cval(x.b as int)
		if !oa || !ob: return 0, false, false
		o := x.op as int
		if o == T_PLUS { return a + b, false, true; }; if o == T_MINUS { return a - b, false, true; }; if o == T_MUL: return a * b, false, true
		if o == T_DIV: if b == 0 { return 0, false, false; }; return a / b, false, true
		if o == T_MOD: if b == 0 { return 0, false, false; }; return (a % b + b) % b, false, true
		if o == T_SHL { return a << b, false, true; }; if o == T_SHR: return a >> b, false, true
		if o == T_AND { return a & b, false, true; }; if o == T_OR { return a | b, false, true; }; if o == T_XOR: return a ^ b, false, true
	if k == N_IF || k == N_BLOCK: return 0, false, false
	return 0, false, false
var CONSTV i64[>..]
var CONSTD i32[>..]
recursive conv_tail(n int, t int):
	x := ND[n]; k := x.k as int
	if k == N_BLOCK || k == N_EBLOCK: if x.a >= 0 && !ends(x.a as int) { conv(x.a as int, t); }; return
	if k == N_IF: if !ends(x.b as int) { conv(x.b as int, t); }; if x.c >= 0 && !ends(x.c as int) { conv(x.c as int, t); }; return
	if k == N_MATCH: ai := flat0(n); sa := AOWN; for i ai.len / 2 { AOWN = ai[2 * i + 1] as int; b := ND[ai[2 * i]].b as int; if b >= 0 && !ends(b) { conv(b, t); } }; AOWN = sa
recursive errleaf(t int) bool:
	if t == T_ERRT { return true; }; x := TY[t]; if x.k == TY_STRUCT { for i STI[x.a].fnum { ft := SFI[STI[x.a].f0 as int + i].ty as int; if ft >= 0 && errleaf(ft) { return true; } } }; x.k == TY_ARR && x.s == (A_FIXED as u8) && errleaf(x.a as int)
recursive conv(n int, t int) bool:
	if t < 0 || n < 0 || errleaf(t): return true
	f := at(n)
	if f < 0: return true
	if f == t: return true
	fk := TY[f].k as int
	tkd := TY[t].k as int
	if tkd == TY_ERR || fk == TY_ERR: return true
	if fk == TY_VOID && ends(n): return true
	nk := ND[n].k as int
	if (nk == N_BLOCK || nk == N_EBLOCK || nk == N_IF || nk == N_MATCH) && fk != TY_VOID && (fk == TY_VARIANT && tkd == TY_ENUM && TY[f].a == TY[t].a || conv_ok(if fk == TY_REF && TY[f].c < 0 { TY[f].a as int } else { f }, t, n) && (tkd == TY_SLICE || fk == TY_REF) || (nk == N_BLOCK || nk == N_EBLOCK) && lp_tail(n)): conv_tail(n, t); set_t(n, t); return true
	if tkd == TY_BOOL && fk == TY_REF && TY[f].fl & RF_OPT != 0: set_cv(n, T_BOOL); return true
	if tkd == TY_REF && TY[t].c < 0 && fk != TY_NULL && fk != TY_REF:
		if tclass(t) >= 0: ok := conv(n, TY[t].a as int); if ok && cv(n) < 0 { set_cv(n, t); }; return ok
	if fk == TY_REF && TY[f].c < 0 && tkd != TY_REF:
		if conv_ok(TY[f].a as int, t, n): set_cv(n, t); return true
	if is_lp(n) && (fk == TY_INT || fk == TY_FLT) && (tkd == TY_INT || tkd == TY_FLT) && !(fk == TY_FLT && tkd == TY_INT): set_cv(n, t); return true
	if fk == TY_ILIT:
		v, u, ok := cval(n)
		if tkd == TY_INT: if ok && !int_fits(v, u, t) && !(bn_ad(n) && !is_signed(t)) { m byte[>..] ~= []; format(m, "constant ", v, " does not fit in ", tn(t)); cerr(n, m); return false; }; commit(n, t); return true
		if tkd == TY_FLT || tkd == TY_VARINT: commit(n, t); return true
	if fk == TY_FLIT && tkd == TY_FLT: commit(n, t); return true
	if fk == TY_STRLIT && (is_byte_arr(t) || tkd == TY_REF && is_byte_arr(TY[t].a as int)): commit(n, if tkd == TY_REF { TY[t].a as int } else { t }); return true
	if fk == TY_ARRLIT && (tkd == TY_ARR || tkd == TY_SLICE): commit(n, t); return true
	if fk == TY_NULL && tkd == TY_REF && TY[t].fl & RF_OPT != 0: commit(n, t); return true
	if conv_ok(f, t, n): set_cv(n, t); return true
	m byte[>..] ~= []; format(m, "cannot convert ", tn(f), " to ", tn(t)); cerr(n, m)
	false
conv_ok(f int, t int, n int) bool:
	if f == t: return true
	a := TY[f]; b := TY[t]
	if widens(f, t): return true
	if b.k == TY_BOOL && a.k == TY_REF && a.fl & RF_OPT != 0: return true
	if b.k == TY_SLICE && (a.k == TY_ARR || a.k == TY_SLICE) && a.a == b.a: return true
	if b.k == TY_SLICE && a.k == TY_STRLIT && b.a as int == T_U8: return true
	if b.k == TY_REF && a.k == TY_REF && (b.fl & RF_OPT != 0 || a.fl & RF_OPT == 0):
		if a.a == b.a: return true
		if TY[b.a].k == TY_ENUM && TY[a.a].k == TY_VARIANT && TY[a.a].a == TY[b.a].a: return true
		if TY[b.a].k == TY_ENUM && TY[a.a].k == TY_ENUM && TY[a.a].a == TY[b.a].a: return true
	if b.k == TY_REF && b.a as int == f: return true
	if b.k == TY_ENUM && a.k == TY_VARIANT && a.a == b.a: return true
	if b.k == TY_ENUM && a.k == TY_ENUM && a.a == b.a: return true
	if b.k == TY_ARR && a.k == TY_ARR && a.a == b.a: return true
	if b.k == TY_ARR && a.k == TY_SLICE && a.a == b.a: return true
	false
is_construct(n int) bool:
	k := ND[n].k as int; k == N_CALL || k == N_ARR || k == N_STR
recursive commit(n int, t int):
	if n < 0: return
	x := ND[n]; k := x.k as int
	f := at(n)
	if f >= 0 && !is_pending(f): if f != t && conv_ok(f, t, n) { set_cv(n, t); }; return
	set_t(n, t)
	if k == N_UN: commit(x.a as int, t); return
	if k == N_BIN:
		o := x.op as int
		if o == T_SHL || o == T_SHR: commit(x.a as int, t); return
		if binprec(o) >= 5: commit(x.a as int, t); commit(x.b as int, t)
		return
	if k == N_IF: commit(x.b as int, t); if x.c >= 0 { commit(x.c as int, t); }; return
	if k == N_BLOCK: if x.a >= 0 { commit(x.a as int, t); }; return
	if k == N_EBLOCK: commit(x.a as int, t); return
	if k == N_MATCH: ai := flat0(n); sa := AOWN; for i ai.len / 2 { AOWN = ai[2 * i + 1] as int; commit(ND[ai[2 * i]].b as int, t); }; AOWN = sa; return
	if k == N_ARR:
		e := if TY[t].k == TY_ARR || TY[t].k == TY_SLICE { TY[t].a as int } else { T_ERRT }
		if x.a >= 0: conv(x.a as int, e); conv(x.b as int, T_I64)
		for i x.n: conv(kid(n, i), e)
		if TY[t].k == TY_SLICE: cnt, u0, ok := cval(x.b as int); set_t(n, t_arr(e, A_FIXED, if x.a >= 0 { cnt } else { x.n as i64 }, -1)); set_cv(n, t)
		return
recursive default_t(n int) int:
	t := at(n)
	if t < 0: return T_VOID
	k := TY[t].k as int
	if k == TY_ILIT: v, u, ok := cval(n); d := if ok && u { T_U64 } else { T_I64 }; commit(n, d); return d
	if k == TY_FLIT: commit(n, T_F64); return T_F64
	if k == TY_STRLIT: set_t(n, TT_STR); return TT_STR
	nk := ND[n].k as int
	if k == TY_ARRLIT && (nk == N_IF || nk == N_MATCH || nk == N_BLOCK || nk == N_EBLOCK): tl := if nk == N_IF { ND[n].b as int } else { if nk == N_MATCH { ND[kid(n, 0)].b as int } else { ND[n].a as int } }; d := default_t(tl); conv_tail(n, d); set_t(n, d); return d
	if k == TY_ARRLIT:
		x := ND[n]
		e ~= -1
		if x.a >= 0: e = default_t(x.a as int); cnt, u0, ok := cval(x.b as int); conv(x.b as int, T_I64); a := t_arr(e, A_FIXED, cnt, -1); set_t(n, a); return a
		for i x.n:
			c := kid(n, i); ct := at(c); if !is_pending(ct): e = if e >= 0 && e != ct && (TY[e].k == TY_VARIANT || TY[e].k == TY_ENUM) && (TY[ct].k == TY_VARIANT || TY[ct].k == TY_ENUM) && TY[e].a == TY[ct].a { t_enum(TY[e].a as int, TY[e].fl & 1 != 0 && TY[e].k == TY_ENUM) } else { ct }
		if e < 0 && x.n > 0: e = default_t(kid(n, 0))
		if e < 0: cerr(n, "an empty [] has no element type here"); return T_ERRT
		for i x.n: conv(kid(n, i), e)
		a := t_arr(e, A_FIXED, x.n as i64, -1)
		set_t(n, a)
		return a
	t
recursive cvx(n int, t int): k := ND[n].k as int; if k == N_BLOCK || k == N_EBLOCK || k == N_IF || k == N_MATCH { conv_tail(n, t); set_t(n, t); return; }; set_cv(n, t);
unify(n int, a int, b int) int:
	ta := at(a); tb := at(b)
	if ta < 0 || tb < 0: return T_ERRT
	da := deref(ta); db := deref(tb)
	ka := TY[da].k as int; kb := TY[db].k as int
	if ka == TY_ERR || kb == TY_ERR: return T_ERRT
	if ka == TY_ILIT && kb == TY_ILIT: return T_ILIT
	if (ka == TY_ILIT || ka == TY_FLIT) && kb == TY_FLIT: return T_FLIT
	if ka == TY_FLIT && kb == TY_ILIT: return T_FLIT
	if ka == TY_STRLIT && kb == TY_STRLIT: set_t(a, TT_STR); set_t(b, TT_STR); return TT_STR
	if ka == TY_STRLIT && kb == TY_ARR && TY[db].a as int == T_U8 || kb == TY_STRLIT && ka == TY_ARR && TY[da].a as int == T_U8: st := t_slice(T_U8, false); conv(a, st); conv(b, st); return st
	if ka == TY_STRLIT || ka == TY_ARRLIT || ka == TY_NULL: conv(a, db); return db
	if kb == TY_STRLIT || kb == TY_ARRLIT || kb == TY_NULL: conv(b, da); return da
	if ka == TY_ILIT: conv(a, db); if tb != db { conv(b, db); }; return db
	if kb == TY_ILIT: conv(b, da); if ta != da { conv(a, da); }; return da
	if is_lp(a) && !is_lp(b) && (kb == TY_INT || kb == TY_FLT) && !(ka == TY_FLT && kb == TY_INT): conv(a, db); return db
	if is_lp(b) && !is_lp(a) && (ka == TY_INT || ka == TY_FLT) && !(kb == TY_FLT && ka == TY_INT): conv(b, da); return da
	if ka == TY_FLIT:
		if kb == TY_FLT { conv(a, db); return db; }; if kb == TY_INT: return T_FLIT
	if kb == TY_FLIT:
		if ka == TY_FLT { conv(b, da); return da; }; if ka == TY_INT: return T_FLIT
	if da == db: if ta != da { cvx(a, da); }; if tb != db { cvx(b, db); }; return da
	if widens(da, db) && !(ka == TY_FLT && kb == TY_INT): cvx(a, db); if tb != db { cvx(b, db); }; return db
	if widens(db, da) && !(kb == TY_FLT && ka == TY_INT): cvx(b, da); if ta != da { cvx(a, da); }; return da
	if ka == TY_INT && kb == TY_FLT: cvx(a, db); return db
