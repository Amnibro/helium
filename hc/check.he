var HRELC i8[>..]
recursive srel(si int) bool:
	for i STI[si].fnum { ft := SFI[STI[si].f0 as int + i].ty as int; if ft >= 0 && (TY[ft].k == TY_REF && TY[ft].c >= 0 || has_rel(ft)) { return true; } }; false
recursive has_rel(t int) bool:
