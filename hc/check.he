	if k == N_BLOCK: if AD[aix(n)] == 2 { return true; }; if ND[n].a >= 0 { return ends(ND[n].a as int); }; if ND[n].n > 0 { return ends(kid(n, ND[n].n as int - 1)); }; return false
	if k == N_MATCH: ai := flat0(n); if ai.len == 0 { return false; }; sa := AOWN; for i ai.len / 2 { AOWN = ai[2 * i + 1] as int; b := ND[ai[2 * i]].b as int; if b < 0 || !ends(b) { AOWN = sa; return false; } }; AOWN = sa; return true
