	m byte[>..] ~= []; format(m, "no field ", nm(name), " in ", tn(d)); cerr(n, m)
	set_t(n, T_ERRT)
rtype_name_enum(de int) int:
	node := DC[de].node as int; none i32[..1] ~= []; t_enum(inst_enum(node, none[..]), false)
recursive ck_idx(n int, want int) int:
	x := ND[n]
