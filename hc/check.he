fin_t(n int) int:
	c := cv(n); if c >= 0:
		c
	else:
		at(n)
recursive own_root(n int) bool:
	k := ND[n].k as int; if k == N_ID:
		v := AV[aix(n)] as int; rk(n) == R_LOCAL && LVS[v].cfn as int == CFN && TY[LVS[v].ty as int].k != TY_REF
	else:
		if (k == N_DOT || k == N_IDX) && TY[at(ND[n].a as int)].k != TY_REF && TY[deref(at(ND[n].a as int))].k != TY_SLICE:
			own_root(ND[n].a as int)
		else:
			false
ref_res(n int, t int) int:
	if ND[n].k as int == N_UN && ND[n].op as int == T_AND:
		if TY[t].k == TY_REF:
			t
		else:
			t_ref(t, 0)
	else:
		if TY[t].k != TY_REF && TY[t].k != TY_SLICE && !is_fixed(t) && names_store(n) && !own_root(n):
			t_ref(t, 0)
		else:
			t
recursive names_store(n int) bool:
	x := ND[n]; k := x.k as int
	if k == N_ID: r := rk(n); return r == R_LOCAL || r == R_GLOBAL
	if k == N_DOT: return rk(n) == R_FIELD && (names_store(x.a as int) || TY[at(x.a as int)].k == TY_REF)
	if k == N_IDX: bt := at(x.a as int); return TY[deref(bt)].k == TY_SLICE || names_store(x.a as int) || TY[bt].k == TY_REF
	false
recursive ck_vdecl(n int):
	x := ND[n]
	fl := x.fl as int
	ns := ns_of(n)
	byref := fl & V_BYREF != 0
	dt ~= if x.a >= 0 { rtype(x.a as int, ns) } else { -1 }; if x.a >= 0 && ND[x.a].k as int == N_TNAME && ND[x.a].n == 0 && gb_find(ND[x.a].s as int) >= 0: dt = decode_rel(dt)
	lf ~= (if fl & V_VAR != 0 { LV_VAR } else { 0 }) | (if fl & V_CONST != 0 { LV_CONST } else { 0 }) | (if byref { LV_REF } else { 0 })
	if x.n > 1:
		if x.b < 0: cerr(n, "several names need a call's results"); return
		init := kid(x.b as int, 0)
		t := ck(init, -1)
		if TY[t].k != TY_MULTI: if ND[x.b].n as int == x.n as int { for i 1..x.n { iv := kid(x.b as int, i); ck(iv, dt); if dt >= 0 { conv(iv, dt); } else { default_t(iv); } }; if dt >= 0 { conv(init, dt); } else { default_t(init); }; for i x.n { iv := kid(x.b as int, i); v := add_lv(LS[x.l as int + i] as int, if dt >= 0 { dt } else { fin_t(iv) }, lf, n); if i == 0 { set_r(n, R_LOCAL, v); } }; set_x(n, 1); return; }; cerr(n, "several names need a call with as many results"); return
		if TY[t].n != x.n: cerr(n, "result count does not match the names")
		for i x.n:
			et0 := if i < TY[t].n as int { TYL[TY[t].l as int + i] as int } else { T_ERRT }; et := if !byref && TY[et0].k == TY_REF && TY[et0].c < 0 && TY[et0].fl & RF_OPT == 0 && (is_fixed(TY[et0].a as int) || TY[TY[et0].a].k == TY_VARINT) && !has_rel(TY[et0].a as int) { TY[et0].a as int } else { et0 }; v := add_lv(LS[x.l as int + i] as int, et, lf, n); if i == 0: set_r(n, R_LOCAL, v)
		return
	t ~= dt
	if x.b >= 0:
		init := kid(x.b as int, 0)
		if dt < 0 && ND[init].k == N_ARR && ND[init].n == 0 && ND[init].a < 0 && ND[init].c < 0:
			t = t_arr(T_ERRT, A_GROW, -1, -1)
			set_t(init, t)
		else:
			it := ck(init, decode_rel(dt))
			if dt >= 0:
				if byref:
					if !(TY[dt].k == TY_REF): conv(init, dt)
				else: conv(init, decode_rel(dt))
			else:
				if TY[it].k == TY_FLIT && lf & (LV_VAR | LV_REF) == 0: lf = lf | LV_FLET
				t = default_t(init)
				if TY[t].k == TY_MULTI: t = TYL[TY[t].l] as int
				if TY[t].k == TY_VARIANT && ND[init].k == N_DOT && lf & LV_VAR != 0: t = t_enum(TY[t].a as int, false); set_cv(init, t)
				if byref || ND[init].k == N_UN && ND[init].op as int == T_AND:
					if TY[t].k != TY_REF: t = t_ref(t, 0)
				else:
					if TY[t].k == TY_REF && TY[t].c < 0 && TY[t].fl & RF_OPT == 0 && (is_fixed(TY[t].a as int) || TY[TY[t].a].k == TY_VARINT) && !has_rel(TY[t].a as int): t = TY[t].a as int; set_cv(init, t)
					else:
						if TY[t].k != TY_REF && TY[t].k != TY_SLICE && TY[t].k != TY_VARINT && !is_fixed(t) && names_store(init): t = t_ref(t, 0)
	else:
		if t < 0: cerr(n, "a declaration needs a type or an initializer"); t = T_ERRT else: ck_defs(t)
	if byref && TY[t].k != TY_REF: t = t_ref(t, 0)
	v := add_lv(LS[x.l] as int, t, lf, n)
	set_r(n, R_LOCAL, v);
recursive ck_assign(n int):
	x := ND[n]
	o := x.op as int
	if o == T_COMMA:
		t := ck(x.b as int, -1)
		tl := x.a as int
		for i ND[tl].n: tg := kid(tl, i); tt := ck(tg, -1)
		return
	if o == T_DOTASSIGN:
		tt := ck(x.a as int, -1)
		rt := ck(x.b as int, tt)
		if is_pending(rt):
			if TY[rt].k == TY_NULL && TY[tt].k == TY_REF: set_t(x.b as int, t_ref(TY[tt].a as int, RF_OPT))
			else: default_t(x.b as int)
		if ND[x.a].k == N_ID && rk(x.a as int) == R_LOCAL:
			v := rv(x.a as int)
			if (is_opt(at(x.b as int)) || TY[at(x.b as int)].k == TY_NULL) && decode_rel(LVS[v].ty as int) == LVS[v].ty as int:
				LVS[v].ty = t_ref(TY[LVS[v].ty].a as int, RF_OPT) as i32
		return
	tt := ck(x.a as int, -1)
	d := deref(tt)
	if o == T_ASSIGN:
		if pend_local(x.a as int): rt := ck(x.b as int, -1); dr := deref(rt); if TY[dr].k == TY_ARR || TY[dr].k == TY_SLICE { complete(x.a as int, TY[dr].a as int); }; conv(x.b as int, deref(at(x.a as int))); return
		if TY[tt].k == TY_REF && is_opt(tt):
			rt := ck(x.b as int, tt)
			if TY[rt].k == TY_NULL: commit(x.b as int, tt); return
			if TY[rt].k == TY_REF: conv(x.b as int, tt); return
		ck(x.b as int, d); conv(x.b as int, d)
		return
	lk := leaf_kind(d)
	rt := ck(x.b as int, if lk >= 4 && (o == T_MULEQ || o == T_DIVEQ) || o == T_SHLEQ || o == T_SHREQ { -1 } else { d })
	if lk >= 4 && (o == T_MULEQ || o == T_DIVEQ) && deref(rt) != d: conv(x.b as int, leaf_type(d)); return
	if o == T_SHLEQ || o == T_SHREQ: if is_pending(rt) { conv(x.b as int, T_I64); }; return
	conv(x.b as int, d);
