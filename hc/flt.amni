fn bn_bits(a int[>..]&) int { var i = a.len - 1; while i >= 0 && a[i] == 0 { i--; } if i < 0 { return 0; } var v = a[i]; var b = 0; while v > 0 { v = v >> 1; b++; } 32 * i + b }
fn bn_mul(a int[>..]&, m int, c0 int) { var c = c0; for i in a.len { let v = a[i] * m + c; a[i] = v & 0xFFFFFFFF; c = v >> 32; } if c > 0 { a.push(c); } }
fn bn_shl(a int[>..]&, s int) { let w = s / 32; var b = s % 32; while b > 0 { let c = min(b, 16); bn_mul(a, 1 << c, 0); b -= c; } if w > 0 { var z int[>..] = []; for i in w { z.push(0); } z.append(a[..]); a.clear(); a.append(z[..]); } }
fn bn_cmp(a int[>..]&, b int[>..]&) int { let n = max(a.len, b.len); var i = n - 1; while i >= 0 { let x = if i < a.len { a[i] } else { 0 }; let y = if i < b.len { b[i] } else { 0 }; if x != y { return if x < y { -1 } else { 1 }; } i--; } 0 }
fn bn_sub(a int[>..]&, b int[>..]&) { var br = 0; for i in a.len { let v = a[i] - (if i < b.len { b[i] } else { 0 }) - br; br = if v < 0 { 1 } else { 0 }; a[i] = v & 0xFFFFFFFF; } }
fn hexv1(c byte) int { if c >= '0' && c <= '9' { (c - '0') as int } else { if c >= 'a' && c <= 'f' { (c - 'a') as int + 10 } else { (c - 'A') as int + 10 } } }
fn flt_bits(s const byte[:]) u64 {
	var nn int[>..] = [0]; var e10 = 0; var e2 = 0; var i = 0;
	let hx = s.len > 1 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X');
	if hx { i = 2; var fr = false; while i < s.len && s[i] != 'p' && s[i] != 'P' { if s[i] == '.' { fr = true; } else { bn_mul(nn, 16, hexv1(s[i])); if fr { e2 -= 4; } } i++; } }
	else { var fr = false; while i < s.len && s[i] != 'e' && s[i] != 'E' { if s[i] == '.' { fr = true; } else { bn_mul(nn, 10, (s[i] - '0') as int); if fr { e10--; } } i++; } }
	if i < s.len { i++; var sg = 1; if s[i] == '-' { sg = -1; i++; } else { if s[i] == '+' { i++; } } var ev = 0; while i < s.len { ev = min(ev * 10 + (s[i] - '0') as int, 100000); i++; } if hx { e2 += sg * ev; } else { e10 += sg * ev; } }
	if bn_bits(nn) == 0 { return 0; }
	if e10 > 400 { return 0x7FF0000000000000; } if e10 < -800 { return 0; }
	var dd int[>..] = [1];
	if e10 >= 0 { for k in e10 { bn_mul(nn, 10, 0); } } else { for k in -e10 { bn_mul(dd, 10, 0); } }
	if e2 >= 0 { bn_shl(nn, e2); } else { bn_shl(dd, -e2); }
	var s2 = 55 - (bn_bits(nn) - bn_bits(dd));
	if s2 >= 0 { bn_shl(nn, s2); } else { bn_shl(dd, -s2); }
	var q u64 = 0;
	var k = 56;
	while k >= 0 { var t int[>..] = []; t.append(dd[..]); bn_shl(t, k); if bn_cmp(nn, t) >= 0 { bn_sub(nn, t); q = q | ((1 as u64) << (k as u64)); } k--; }
	var sticky = bn_bits(nn) > 0;
	while q >= (1 as u64) << 55 { sticky = sticky || (q & 1) != 0; q = q >> 1; s2--; }
	var e = 54 - s2;
	let sh = if e >= -1022 { 2 } else { 2 + (-1022 - e) };
	if sh > 60 { return 0; }
	var m = q >> (sh as u64); let rem = q & (((1 as u64) << (sh as u64)) - 1); let half = (1 as u64) << ((sh - 1) as u64);
	if rem > half || rem == half && (sticky || (m & 1) != 0) { m++; }
	if e < -1022 { return m; }
	if m == (1 as u64) << 53 { m = m >> 1; e++; }
	if e > 1023 { return 0x7FF0000000000000; }
	(((e + 1023) as u64) << 52) | (m & 0xFFFFFFFFFFFFF)
}
fn d2f_bits(b u64) u64 {
	let sg = (b >> 32) & 0x80000000; let ex = ((b >> 52) & 0x7FF) as int; let mt = b & 0xFFFFFFFFFFFFF;
	if ex == 0x7FF { return sg | (if mt == 0 { 0x7F800000 } else { 0x7FC00000 | (mt >> 29) }); }
	if ex == 0 { return sg; }
	let m53 = mt | ((1 as u64) << 52); var e = ex - 1023;
	if e > 127 { return sg | 0x7F800000; }
	let sh = if e >= -126 { 29 } else { 29 + (-126 - e) };
	if sh > 60 { return sg; }
	var m = m53 >> (sh as u64); let rem = m53 & (((1 as u64) << (sh as u64)) - 1); let half = (1 as u64) << ((sh - 1) as u64);
	if rem > half || rem == half && (m & 1) != 0 { m++; }
	if e < -126 { return sg | m; }
	if m == (1 as u64) << 24 { m = m >> 1; e++; }
	if e > 127 { return sg | 0x7F800000; }
	sg | (((e + 127) as u64) << 23) | (m & 0x7FFFFF)
}
