import os;
let T_EOF = 0; let T_IDENT = 1; let T_INT = 2; let T_FLT = 3; let T_STR = 4;
let T_LP = 5; let T_RP = 6; let T_LB = 7; let T_RB = 8; let T_LC = 9; let T_RC = 10; let T_COMMA = 11; let T_SEMI = 12; let T_COLON = 13; let T_QUEST = 14; let T_CC = 15;
let T_DOT = 16; let T_DOTDOT = 17; let T_DOTASSIGN = 18; let T_DOTEQ = 19; let T_DOTNEQ = 20;
let T_PLUS = 21; let T_MINUS = 22; let T_MUL = 23; let T_DIV = 24; let T_MOD = 25;
let T_PLUSEQ = 26; let T_MINUSEQ = 27; let T_MULEQ = 28; let T_DIVEQ = 29; let T_MODEQ = 30; let T_ANDEQ = 31; let T_OREQ = 32; let T_XOREQ = 33;
let T_INC = 34; let T_DEC = 35; let T_ASSIGN = 36; let T_EQ = 37; let T_NEQ = 38; let T_LT = 39; let T_GT = 40; let T_LTEQ = 41; let T_GTEQ = 42;
let T_SHL = 43; let T_SHR = 44; let T_SHLEQ = 45; let T_SHREQ = 46; let T_NOT = 47; let T_BITNOT = 48; let T_AND = 49; let T_OR = 50; let T_XOR = 51;
let T_ANDAND = 52; let T_OROR = 53; let T_ARROW = 54; let T_FAT = 55;
let T_KW = 56;
let KWS = ["import", "namespace", "struct", "enum", "type", "fn", "thread_fn", "export", "simd", "recursive", "let", "var", "extern", "const", "pad", "reusable", "if", "else", "while", "for", "in", "loop", "block", "guard", "match", "return", "break", "continue", "as", "true", "false", "null", "self", "bool", "varint", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "int", "uint", "byte", "real"];
let K_IMPORT = 56; let K_NAMESPACE = 57; let K_STRUCT = 58; let K_ENUM = 59; let K_TYPE = 60; let K_FN = 61; let K_THREADFN = 62; let K_EXPORT = 63; let K_SIMD = 64; let K_RECURSIVE = 65;
let K_LET = 66; let K_VAR = 67; let K_EXTERN = 68; let K_CONST = 69; let K_PAD = 70; let K_REUSABLE = 71; let K_IF = 72; let K_ELSE = 73; let K_WHILE = 74; let K_FOR = 75; let K_IN = 76;
let K_LOOP = 77; let K_BLOCK = 78; let K_GUARD = 79; let K_MATCH = 80; let K_RETURN = 81; let K_BREAK = 82; let K_CONTINUE = 83; let K_AS = 84; let K_TRUE = 85; let K_FALSE = 86; let K_NULL = 87; let K_SELF = 88;
let K_BOOL = 89; let K_VARINT = 90; let K_I8 = 91; let K_I16 = 92; let K_I32 = 93; let K_I64 = 94; let K_U8 = 95; let K_U16 = 96; let K_U32 = 97; let K_U64 = 98; let K_F32 = 99; let K_F64 = 100;
let K_INT = 101; let K_UINT = 102; let K_BYTE = 103; let K_REAL = 104;
let NKW = 49;
struct Tok { k u8, ml bool, uns bool, lay bool, f u16, line i32, s i32, n i32, w i32, v i64 }
struct File { s i32, n i32, name i32, amni bool, he bool }
struct Name { s i32, n i32 }
var SRC byte[>..];
var NAMES byte[>..];
var STRS byte[>..];
var NM Name[>..];
var NH i32[>..];
var FILES File[>..];
var TK Tok[>..];
var LERR byte[>..];
fn nm(id int) const byte[:] { let x = NM[id]; NAMES[(x.s as int)..((x.s + x.n) as int)] }
fn hash(s const byte[:]) u64 { var h u64 = 1469598103934665603; for c in s { h = (h ^ (c as u64)) * 1099511628211; } h }
fn intern(s const byte[:]) int {
	if NH.len == 0 { NH.resize(1 << 16, -1); }
	if NM.len * 2 >= NH.len {
		let n = NH.len * 2;
		NH.clear(); NH.resize(n, -1);
		for x, i in NM { var j = ((hash(NAMES[(x.s as int)..((x.s + x.n) as int)]) as int) & (n - 1)); while NH[j] >= 0 { j = (j + 1) & (n - 1); } NH[j] = i as i32; }
	}
	let m = NH.len - 1;
	var j = (hash(s) as int) & m;
	while NH[j] >= 0 { if nm(NH[j]) == s { return NH[j]; } j = (j + 1) & m; }
	let id = NM.len;
	NM.push(Name { NAMES.len as i32, s.len as i32 });
	NAMES.append(s);
	NH[j] = id as i32;
	id
}
fn lex_init() { if NM.len == 0 { for k in KWS { intern(k); } } }
fn idc(c byte) bool { (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (c >= '0' && c <= '9') }
fn dig(c byte) bool { c >= '0' && c <= '9' }
fn hexd(c byte) bool { dig(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') }
fn hexv(c byte) int { if c <= '9' { (c - '0') as int } else { ((c | 0x20) - 'a') as int + 10 } }
fn lerr(f int, line int, m const byte[:]) bool { if LERR.len == 0 { LERR.append(nm(FILES[f].name)); format(LERR, ":", line, ": error: ", m); } false }
fn esc(p int&, f int, line int) int {
	let c = SRC[p]; p++;
	if c != '\\' { return c as int; }
	let e = SRC[p]; p++;
	if e == 'n' { return 10; } if e == 't' { return 9; } if e == 'r' { return 13; } if e == '0' { return 0; }
	if e == '\\' || e == '"' || e == '\'' { return e as int; }
	if e == 'x' && hexd(SRC[p]) && hexd(SRC[p + 1]) { let v = hexv(SRC[p]) * 16 + hexv(SRC[p + 1]); p += 2; return v; }
	lerr(f, line, "unknown escape sequence");
	-1
}
fn lay_else(p0 int) bool { var p = p0; var d = 0; loop { let c = SRC[p]; if c == 0 || c == '\n' || c == '#' { return false; } if c == '"' || c == '\'' { p++; while SRC[p] != c && SRC[p] != 0 && SRC[p] != '\n' { if SRC[p] == '\\' { p++; } p++; } } if c == '(' || c == '[' { d++; } if c == ')' || c == ']' { d--; } if d == 0 && c == '{' { return false; } if d == 0 && c == ':' && SRC[p + 1] != ':' { return true; } if d == 0 && c == ':' { p++; } p++; } false }
fn lex_file(path const byte[:]) bool {
	lex_init();
	var body byte[>..] = [];
	if !read_file(path, body) { LERR.append("cannot read "); LERR.append(path); return false; }
	let f = FILES.len;
	let base = SRC.len;
	let skip = if body.len >= 3 && body[0] == 0xEF && body[1] == 0xBB && body[2] == 0xBF { 3 } else { 0 };
	SRC.append(body[skip..]); SRC.push(0); SRC.push(0); SRC.push(0); SRC.push(0);
	FILES.push(File { base as i32, (body.len - skip) as i32, intern(path) as i32, path.len > 5 && path[^5..] == ".amni" || path.len > 3 && path[^3..] == ".he", path.len > 3 && path[^3..] == ".he" });
	let amni = FILES[f].amni; let he = FILES[f].he; let t0 = TK.len;
	var dep = 0; var ind i32[>..] = [0]; var inl = 0; var ss = TK.len; var nl = false; var col = 0;
	var p = base;
	var line = 1;
	fn put(k int, s int, e int) { TK.push(Tok { k: k as u8, f: f as u16, line: line as i32, s: s as i32, n: (e - s) as i32, .. }); let kk = k; if kk == T_SEMI || kk == T_LC || kk == T_RC || kk == T_FAT { ss = TK.len; } }
	fn lay(k int, s int) { put(k, s, s); TK[TK.len - 1].lay = true; }
	fn ins(k int, s int) { TK.push(TK[TK.len - 1]); var i = TK.len - 2; while i > ss { TK[i] = TK[i - 1]; i--; } TK[ss] = Tok { k: k as u8, f: f as u16, line: line as i32, s: s as i32, n: 0, lay: true, .. }; }
	loop {
		var c = SRC[p];
		while c == ' ' || c == '\t' || c == '\r' || c == '\n' { if c == '\n' { line++; nl = true; col = 0; } else { col++; } p++; c = SRC[p]; }
		if c == '/' && SRC[p + 1] == '/' && !he { while SRC[p] != '\n' && SRC[p] != 0 { p++; } continue; }
		if c == '#' && he { while SRC[p] != '\n' && SRC[p] != 0 { p++; } continue; }
		if he && dep == 0 && (nl || c == 0) && TK.len > t0 {
			nl = false;
			while inl > 0 { lay(T_RC, p); inl--; }
			let lt = TK.len - 1; let top = ind[ind.len - 1] as int;
			let isel = c == 'e' && SRC[p + 1] == 'l' && SRC[p + 2] == 's' && SRC[p + 3] == 'e' && !idc(SRC[p + 4]);
			if TK[lt].k as int == T_COLON && TK[lt].lay { if c == 0 || col <= top { return lerr(f, line, "expected an indented block after ':'"); } TK[lt].k = T_LC as u8; ind.push(col as i32); ss = TK.len; }
			else {
				let cl = if c == 0 { 0 } else { col };
				if cl > top { return lerr(f, line, "unexpected indentation"); }
				while cl < (ind[ind.len - 1] as int) { lay(T_RC, p); ind.pop(); }
				if cl != (ind[ind.len - 1] as int) { return lerr(f, line, "this line's indentation matches no enclosing block"); }
				let lk = TK[TK.len - 1].k as int;
				if !isel && lk != T_SEMI && lk != T_LC { lay(T_SEMI, p); }
			}
		}
		nl = false;
		if c == '/' && SRC[p + 1] == '*' {
			p += 2; var nest = 1;
			while nest > 0 { let d = SRC[p]; if d == 0 { return lerr(f, line, "unterminated /* comment"); } if d == '\n' { line++; } if d == '*' && SRC[p + 1] == '/' { nest--; p++; } else { if d == '/' && SRC[p + 1] == '*' { nest++; p++; } } p++; }
			continue;
		}
		let s = p;
		let n1 = SRC[p + 1]; let n2 = SRC[p + 2];
		if c == 0 { put(T_EOF, s, s); return true; }
		if dig(c) {
			if c == '0' && (n1 == 'x' || n1 == 'X') {
				p += 2; let ds = p; while hexd(SRC[p]) { p++; }
				var hf = false;
				if SRC[p] == '.' && hexd(SRC[p + 1]) { hf = true; p++; while hexd(SRC[p]) { p++; } }
				if SRC[p] == 'p' || SRC[p] == 'P' { hf = true; p++; if SRC[p] == '+' || SRC[p] == '-' { p++; } while dig(SRC[p]) { p++; } }
				if hf { put(T_FLT, s, p); continue; }
				if p - ds > 16 { return lerr(f, line, "hex literal too large for 64 bits"); }
				var v u64 = 0; for q in ds..p { v = (v << 4) | (hexv(SRC[q]) as u64); }
				put(T_INT, s, p); TK[TK.len - 1].v = v as! i64; TK[TK.len - 1].uns = v > 9223372036854775807; continue;
			}
			while dig(SRC[p]) { p++; }
			var fl = false;
			if SRC[p] == '.' && dig(SRC[p + 1]) { fl = true; p++; while dig(SRC[p]) { p++; } }
			if (SRC[p] == 'e' || SRC[p] == 'E') && (dig(SRC[p + 1]) || ((SRC[p + 1] == '+' || SRC[p + 1] == '-') && dig(SRC[p + 2]))) { fl = true; p += 2; while dig(SRC[p]) { p++; } }
			if fl { put(T_FLT, s, p); continue; }
			var v u64 = 0;
			for q in s..p { let d = (SRC[q] - '0') as u64; if v > (18446744073709551615 - d) / 10 { return lerr(f, line, "integer literal too large for 64 bits"); } v = v * 10 + d; }
			put(T_INT, s, p); TK[TK.len - 1].v = v as! i64; TK[TK.len - 1].uns = v > 9223372036854775807; continue;
		}
		if idc(c) {
			while idc(SRC[p]) { p++; }
			let id = intern(SRC[s..p]);
			var k = if id < NKW { T_KW + id } else { T_IDENT };
			if !amni && k >= K_INT { k = T_IDENT; }
			if he && dep == 0 && k == K_ELSE && inl > 0 && lay_else(p) { lay(T_RC, s); inl--; }
			if he && dep == 0 && ind.len == 1 && TK.len == ss && p - s == 3 && SRC[s..p] == "use" && SRC[p] == ' ' { k = K_IMPORT; }
			put(k, s, p); TK[TK.len - 1].v = id;
			continue;
		}
		if c == '\'' {
			p++; let v = esc(p, f, line);
			if v < 0 { return false; }
			if SRC[p] != '\'' { return lerr(f, line, "expected closing ' of character literal"); }
			p++; put(T_INT, s, p); TK[TK.len - 1].v = v; continue;
		}
		if c == '"' {
			let ss = STRS.len;
			var ml = false;
			if n1 == '"' && n2 == '"' {
				p += 3;
				var q = p; while SRC[q] == ' ' || SRC[q] == '\t' || SRC[q] == '\r' { q++; }
				if SRC[q] != '\n' {
					while !(SRC[p] == '"' && SRC[p + 1] == '"' && SRC[p + 2] == '"') { if SRC[p] == 0 || SRC[p] == '\n' { return lerr(f, line, "unterminated \"\"\" string"); } STRS.push(SRC[p]); p++; }
					p += 3;
				} else {
					ml = true;
					let first = q + 1;
					var close = first;
					while !(SRC[close] == '"' && SRC[close + 1] == '"' && SRC[close + 2] == '"') { if SRC[close] == 0 { return lerr(f, line, "unterminated \"\"\" string"); } close++; }
					var cs = close; while cs > first && SRC[cs - 1] != '\n' { cs--; }
					let mg = close - cs;
					for q2 in cs..close { if SRC[q2] != ' ' && SRC[q2] != '\t' { return lerr(f, line, "only indentation may come before the closing \"\"\" of a multi-line string"); } }
					var l = first;
					while l < cs {
						var e = l; while SRC[e] != '\n' { e++; }
						var te = e; if te > l && SRC[te - 1] == '\r' { te--; }
						if l != first { STRS.push('\n'); }
						var ok = te - l >= mg; if ok { for k in mg { if SRC[l + k] != SRC[cs + k] { ok = false; } } }
						if ok { STRS.append(SRC[l + mg..te]); } else { for k in l..te { if SRC[k] != ' ' && SRC[k] != '\t' { return lerr(f, line, "a line of a multi-line string must start with the indentation of its closing \"\"\""); } } }
						l = e + 1;
					}
					for k in p..close + 3 { if SRC[k] == '\n' { line++; } }
					p = close + 3;
				}
			} else {
				p++;
				while SRC[p] != '"' { if SRC[p] == '\n' || SRC[p] == 0 { return lerr(f, line, "unterminated string literal"); } let v = esc(p, f, line); if v < 0 { return false; } STRS.push(v as! byte); }
				p++;
			}
			put(T_STR, s, p); TK[TK.len - 1].v = ss; TK[TK.len - 1].w = (STRS.len - ss) as i32; TK[TK.len - 1].ml = ml;
			continue;
		}
		p++;
		var k = -1;
		if he && (c == ':' && n1 == '=' || c == '~' && n1 == '=') { ins(if c == ':' { K_LET } else { K_VAR }, s); p++; put(T_ASSIGN, s, p); continue; }
		if he && dep == 0 && c == ':' && n1 != ':' { var q = p; while SRC[q] == ' ' || SRC[q] == '\t' || SRC[q] == '\r' { q++; } if SRC[q] == '\n' || SRC[q] == 0 || SRC[q] == '#' { put(T_COLON, s, p); TK[TK.len - 1].lay = true; } else { lay(T_LC, s); inl++; } continue; }
		if c == '(' || c == '[' || c == '{' { dep++; } if (c == ')' || c == ']' || c == '}') && dep > 0 { dep--; }
		if c == '(' { k = T_LP; } else { if c == ')' { k = T_RP; } else { if c == '[' { k = T_LB; } else { if c == ']' { k = T_RB; } else { if c == '{' { k = T_LC; } else { if c == '}' { k = T_RC; } else { if c == ',' { k = T_COMMA; } else { if c == ';' { k = T_SEMI; } else { if c == '?' { k = T_QUEST; } else { if c == '~' { k = T_BITNOT; } } } } } } } } } }
		if c == ':' { if n1 == ':' { p++; k = T_CC; } else { k = T_COLON; } }
		if c == '.' { if n1 == '.' { p++; k = T_DOTDOT; } else { if n1 == '=' && n2 == '=' { p += 2; k = T_DOTEQ; } else { if n1 == '!' && n2 == '=' { p += 2; k = T_DOTNEQ; } else { if n1 == '=' { p++; k = T_DOTASSIGN; } else { k = T_DOT; } } } } }
		if c == '+' { if n1 == '+' { p++; k = T_INC; } else { if n1 == '=' { p++; k = T_PLUSEQ; } else { k = T_PLUS; } } }
		if c == '-' { if n1 == '-' { p++; k = T_DEC; } else { if n1 == '=' { p++; k = T_MINUSEQ; } else { if n1 == '>' { p++; k = T_ARROW; } else { k = T_MINUS; } } } }
		if c == '*' { if n1 == '=' { p++; k = T_MULEQ; } else { k = T_MUL; } }
		if c == '/' { if n1 == '=' { p++; k = T_DIVEQ; } else { k = T_DIV; } }
		if c == '%' { if n1 == '=' { p++; k = T_MODEQ; } else { k = T_MOD; } }
		if c == '=' { if n1 == '=' { p++; k = T_EQ; } else { if n1 == '>' { p++; k = T_FAT; } else { k = T_ASSIGN; } } }
		if c == '!' { if n1 == '=' { p++; k = T_NEQ; } else { k = T_NOT; } }
		if c == '<' { if n1 == '=' { p++; k = T_LTEQ; } else { if n1 == '<' && n2 == '=' { p += 2; k = T_SHLEQ; } else { if n1 == '<' { p++; k = T_SHL; } else { k = T_LT; } } } }
		if c == '>' { if n1 == '=' { p++; k = T_GTEQ; } else { if n1 == '>' && n2 == '=' { p += 2; k = T_SHREQ; } else { if n1 == '>' { p++; k = T_SHR; } else { k = T_GT; } } } }
		if c == '&' { if n1 == '&' { p++; k = T_ANDAND; } else { if n1 == '=' { p++; k = T_ANDEQ; } else { k = T_AND; } } }
		if c == '|' { if n1 == '|' { p++; k = T_OROR; } else { if n1 == '=' { p++; k = T_OREQ; } else { k = T_OR; } } }
		if c == '^' { if n1 == '=' { p++; k = T_XOREQ; } else { k = T_XOR; } }
		if k < 0 { return lerr(f, line, "illegal character"); }
		put(k, s, p);
	}
	true
}
fn tok_text(t int) const byte[:] { let x = TK[t]; SRC[(x.s as int)..((x.s + x.n) as int)] }
fn tok_str(t int) const byte[:] { let x = TK[t]; STRS[(x.v as int)..((x.v as int) + (x.w as int))] }
