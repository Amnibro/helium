use calls
var O byte[>..<]
var TF byte[>..<]; var TD byte[>..<]; var PR byte[>..<]; var GL byte[>..<]; var GI byte[>..<]; var HF byte[>..<]
var CN byte[>..]; var CNO i32[>..]; var CNL i32[>..]; var CST u8[>..]
var HFN u8[>..]; var HEQ u8[>..]
var TDS byte[>..<]
var SCR byte[>..<]
var TMPN int
GCF int ~= -1
var LSTK i32[>..<]; var LRES i32[>..<]
var GERR byte[>..]
INTC := ["int8_t", "int16_t", "int32_t", "int64_t", "uint8_t", "uint16_t", "uint32_t", "uint64_t"]
ow(s const byte[:]): O.append(s);
oi(v i64): format(O, v);
gerr(n int, m const byte[:]): if GERR.len > 0 { return } x := TK[ND[max(n, 0)].t]; GERR.append(nm(FILES[x.f].name)); format(GERR, ":", x.line, ": error: ", m);
cn_grow():
	while CNO.len < TY.len: CNO.push(-1); CNL.push(0); CST.push(0); HFN.push(0); HEQ.push(0)
fwd(s0 int): TF.append("typedef struct "); TF.append(CN[s0..]); TF.push(' '); TF.append(CN[s0..]); TF.append(";\n");
is_res(t int) bool:
	TY[t].k == TY_ARR && (TY[t].s as int == A_GROW || TY[t].s as int == A_GS)
is_lim(t int) bool:
	TY[t].k == TY_ARR && TY[t].s as int == A_LIM && TY[t].b >= 0
is_vimg(t int) bool:
	t >= 0 && TY[t].k == TY_ARR && (TY[t].s as int == A_VAR || TY[t].s as int == A_LIM && TY[t].b < 0)
vlim(t int) int:
	if TY[t].s as int == A_LIM:
		1
	else:
		0
vw(t int) i64:
	if TY[t].c == 8:
		0
	else:
		isz(TY[t].c)
vargs(t int): format(O, ", ", vw(t), ", ", vlim(t));
vok(n int, t int) bool:
	if !is_fixed(TY[t].a) && !is_vval(TY[t].a) { gerr(n, "arrays of these variable-size elements are not supported by the self-hosted compiler yet"); return false } if is_seq(t) && vlim(t) == 1 { gerr(n, "limited arrays need fixed-size elements"); return false } true
is_seq(t int) bool:
	(TY[t].k == TY_ARR || TY[t].k == TY_SLICE) && is_vval(TY[t].a)
DSU ~= 0
var HRG byte[>..]
var HRS byte[>..]
var HRL byte[>..]
var TW byte[>..]
var TWD i8[>..]
var QTY i32[>..]
qid(t int) int:
	for q, i QTY { if q == t { return i } } QTY.push(t); QTY.len - 1
RELM ~= false
var RELQ i32[>..]
var EFW i8[>..]
var EBD i8[>..]
var VSTC i8[>..]
recursive is_vst(t int) bool:
	if t < 0 || TY[t].k != TY_STRUCT { return false } while VSTC.len < TY.len { VSTC.push(0) } if VSTC[t] != 0 { return VSTC[t] == 1 } si_layout(TY[t].a); r ~= false; if STI[TY[t].a].cls as int == CL_VAR && ND[STI[TY[t].a].node].k as int == N_STRUCT { f0 := STI[TY[t].a].f0; for i STI[TY[t].a].fnum { ft := SFI[f0 + i].ty; if ft >= 0 && (is_vimg(ft) || is_vst(ft)) { r = true } } } VSTC[t] = if r { 1 } else { 2 }; r
is_vval(t int) bool:
	is_vimg(t) || is_vst(t)
var PKD i8[>..]
var VZD i8[>..]
var VOD i8[>..]
pk_need(t int): while PKD.len < TY.len { PKD.push(0) } if PKD[t] != 0 { return } PKD[t] = 1; cbody(t); TD.append("typedef struct { "); TD.append(cn(t)); format(TD, " v; } PK", t, ";\n");
recursive vz_into(b byte[..512]&, t int, p const byte[:]):
	if is_vimg(t) && is_seq(t): gen_vzs(t); format(b, "vzs", t, "(", p, ")"); return
	if is_vimg(t): format(b, "hr_vszf(", p, ", ", vw(t), ", ", vlim(t), ", sizeof("); b.append(cn(TY[t].a)); b.append("))"); return
	if is_vst(t): gen_vz(t); format(b, "vz", t, "(", p, ")"); return
	format(b, "(int64_t)sizeof("); b.append(cn(t)); b.append(")");
recursive gen_vz(t int):
	while VZD.len < TY.len: VZD.push(0)
	if VZD[t] != 0: return
	VZD[t] = 1
	si := TY[t].a; f0 := STI[si].f0
	for i STI[si].fnum:
		ft := SFI[f0 + i].ty; if ft >= 0: cbody(ft); vpre_e(ft)
	sig byte[..128] ~= []; format(sig, "static int64_t vz", t, "(const uint8_t *p)")
	PR.append(sig[..]); PR.append(";\n")
	HF.append(sig[..]); hh(" { const uint8_t *q = p; ")
	for i STI[si].fnum: f := SFI[f0 + i]; if f.ty < 0 { format(HF, "q += ", max(f.padn, 0), "; "); continue } e byte[..512] ~= []; vz_into(e, f.ty, "q"); format(HF, "q += ", e[..], "; ")
	hh("return q - p; }\n");
var VZS i8[>..]
recursive gen_vzs(t int):
	while VZS.len < TY.len: VZS.push(0)
	if VZS[t] != 0: return
	VZS[t] = 1
	e := TY[t].a
	cbody(e); if is_vst(e) { gen_vz(e) } if is_vimg(e) && is_seq(e): gen_vzs(e)
	sig byte[..128] ~= []; format(sig, "static int64_t vzs", t, "(const uint8_t *p)")
	PR.append(sig[..]); PR.append(";\n")
	ez byte[..512] ~= []; vz_into(ez, e, "q")
	HF.append(sig[..]); format(HF, " { int64_t n = hr_vget(p, ", vw(t), "); const uint8_t *q = p + hr_vhd(p, ", vw(t), ", 0); for (int64_t i = 0; i < n; i++) q += ", ez[..], "; return q - p; }\n");
vpre_e(e int):
	if is_vst(e) { gen_vz(e) } if is_vimg(e) && is_seq(e): gen_vzs(e);
recursive gen_vo(si int):
	while VOD.len < STI.len: VOD.push(0)
	if VOD[si] != 0: return
	VOD[si] = 1
	f0 := STI[si].f0
	for i STI[si].fnum:
		ft := SFI[f0 + i].ty; if ft >= 0: cbody(ft); vpre_e(ft)
	for i STI[si].fnum:
		if SFI[f0 + i].ty < 0 || SFI[f0 + i].off >= 0: continue
		sig byte[..128] ~= []; format(sig, "static uint8_t *vo", si, "_", i, "(uint8_t *p)")
		PR.append(sig[..]); PR.append(";\n")
		HF.append(sig[..]); hh(" { uint8_t *q = p; ")
		for j i: f := SFI[f0 + j]; if f.ty < 0 { format(HF, "q += ", max(f.padn, 0), "; "); continue } e byte[..512] ~= []; vz_into(e, f.ty, "q"); format(HF, "q += ", e[..], "; ")
		hh("return q; }\n")
vpre(t int):
	if (TY[t].k == TY_ARR || TY[t].k == TY_SLICE) && is_seq(t) { vpre_e(TY[t].a); return } if !is_vst(t) { return } si := TY[t].a; gen_vo(si); for i STI[si].fnum:
		ft := SFI[STI[si].f0 as int + i].ty; if ft >= 0 && !is_vval(ft): pk_need(ft)
recursive vfa_into(b byte[..512]&, si int, i int, base const byte[:]): f := SFI[STI[si].f0 + i]; if f.off >= 0 { format(b, "((uint8_t*)(", base, ") + ", f.off, ")"); return } gen_vo(si); format(b, "vo", si, "_", i, "(", base, ")");
recursive vfx_into(b byte[..512]&, si int, i int, base const byte[:]): ft := SFI[STI[si].f0 + i].ty; a byte[..512] ~= []; vfa_into(a, si, i, base); if is_vval(ft) { b.append(a[..]); return } pk_need(ft); format(b, "(((PK", ft, "*)(", a[..], "))->v)");
var SCR2 byte[>..]
is_fix(t int) bool:
	TY[t].k == TY_ARR && TY[t].s as int == A_FIXED
recursive cn(t int) const byte[:]:
	cn_grow()
	if CNO[t] < 0: cn_make(t)
	o := CNO[t]
	CN[o..o + CNL[t]]
recursive cn_make(t int):
	x := TY[t]; k := x.k as int
	if k == TY_REF && x.c < 0 && is_vval(x.a as int): s0 := CN.len; CN.append("uint8_t*"); CNO[t] = s0 as i32; CNL[t] = (CN.len - s0) as i32; return
	if k == TY_REF && x.c < 0: e := cn(x.a as int); s0 := CN.len; CN.append(e); CN.push('*'); CNO[t] = s0 as i32; CNL[t] = (CN.len - s0) as i32; return
	if k == TY_VARIANT:
		v := ENV[ENI[x.a].v0 as int + x.c as int]; if v.si >= 0: e := cn(t_struct(v.si as int)); s0 := CN.len; CN.append(e); CNO[t] = s0 as i32; CNL[t] = (CN.len - s0) as i32; return
	s0 := CN.len
	if k == TY_INT: CN.append(INTC[x.s & 7])
	else:
		if k == TY_REF: CN.append(INTC[x.c & 3])
		else:
			if k == TY_BOOL: CN.append("bool")
			else:
				if k == TY_FLT: CN.append(if x.s == 4 { "float" } else { "double" })
				else:
					if k == TY_VOID: CN.append("void")
					else:
						if k == TY_STRUCT && is_vst(t): CN.append("uint8_t*")
						else:
							if k == TY_STRUCT: format(CN, "S", x.a); fwd(s0)
							else:
								if k == TY_ENUM:
									format(CN, "E", x.a); while EFW.len <= x.a as int { EFW.push(0) } if EFW[x.a] == 0: EFW[x.a] = 1; fwd(s0)
								else:
									if k == TY_VARIANT: CN.append("hr_unit")
									else:
										if k == TY_ARR:
											a := x.s as int; if a == A_GROW || a == A_GS: CN.append("hrv")
											else:
												if a == A_FIXED: format(CN, "A", t); fwd(s0)
												else:
													if a == A_LIM && x.b >= 0: format(CN, "L", t); fwd(s0) else: CN.append("uint8_t*")
										else:
											if k == TY_SLICE || k == TY_STRLIT || k == TY_ARRLIT: CN.append("hsl")
											else:
												if k == TY_MULTI: format(CN, "M", t); fwd(s0)
												else:
													if k == TY_ILIT || k == TY_VARINT: CN.append("int64_t")
													else:
														if k == TY_FLIT: CN.append("double")
														else: CN.append("void*")
	CNO[t] = s0 as i32; CNL[t] = (CN.len - s0) as i32
fname_into(b byte[>..<]&, name int): for c nm(name) { b.push(if c == ':' { '_' } else { c }) } b.push('_');
recursive cbody(t int):
	cn_grow()
	x := TY[t]; k := x.k as int
	if k == TY_REF || CST[t] != 0: cn(t); return
	CST[t] = 1
	cn(t)
	if k == TY_VARIANT: v := ENV[ENI[x.a].v0 as int + x.c as int]; if v.si >= 0 { cbody(t_struct(v.si as int)) } return
	if k == TY_STRUCT:
		si := x.a as int; si_layout(si)
		f0 := STI[si].f0 as int; fnum := STI[si].fnum as int
		for i fnum:
			ft i32 := SFI[f0 + i].ty; if ft >= 0: cbody(ft as int)
		if is_vst(t): return
		TD.append("struct "); TD.append(cn(t)); TD.append(" { ")
		any ~= false
		for i fnum:
			f := SFI[f0 + i]
			if f.ty < 0: if f.padn > 0 { format(TD, "uint8_t _p", i, "[", f.padn, "]; "); any = true } continue
			TD.append(cn(f.ty as int)); TD.push(' '); fname_into(TD, f.name as int); TD.append("; "); any = true
		if !any: TD.append("uint8_t _e; ")
		TD.append("};\n")
		return
	if k == TY_ENUM:
		ei := x.a as int; ei_layout(ei)
		while EBD.len <= ei: EBD.push(0)
		if EBD[ei] != 0: return
		EBD[ei] = 1
		v0 := ENI[ei].v0 as int
		pay ~= false
		for i ENI[ei].vnum:
			v := ENV[v0 + i]; if v.si >= 0 && !STI[v.si].zero: cbody(t_struct(v.si as int)); pay = true
		TD.append("struct "); TD.append(cn(t)); TD.append(if ENI[ei].tagsz == 1 { " { uint8_t tag; " } else { " { uint16_t tag; " })
		if pay: TD.append("union { "); for i ENI[ei].vnum { v := ENV[v0 + i]; if v.si >= 0 && !STI[v.si].zero { TD.append(cn(t_struct(v.si as int))); format(TD, " v", i, "; ") } } TD.append("} u; ")
		TD.append("};\n")
		return
	if k == TY_ARR:
		a := x.s as int
		if a == A_FIXED || a == A_LIM && x.b >= 0:
			cbody(x.a as int)
			TD.append("struct "); TD.append(cn(t)); TD.append(" { ")
			if a == A_LIM: TD.append(INTC[lim_lenstore(x.b) & 7]); TD.append(" n; ")
			TD.append(cn(x.a as int)); format(TD, " e[", max(x.b, 1), "]; };\n")
		return
	if k == TY_MULTI:
		for i x.n: cbody(TYL[x.l as int + i] as int)
		TD.append("struct "); TD.append(cn(t)); TD.append(" { ")
		for i x.n: TD.append(cn(TYL[x.l as int + i] as int)); format(TD, " r", i, "; ")
		TD.append("};\n");
ct(t int): cbody(t); ow(cn(t));
esz(t int): ow("sizeof("); ct(t); ow(")");
wloc(n int): x := TK[ND[max(n, 0)].t]; ow("\""); for c nm(FILES[x.f].name) { if c == '"' || c == '\\' { O.push('\\') } O.push(c) } format(O, ":", x.line, "\"");
tmp(t int, clean bool) int:
	cbody(t)
	TMPN++
	TDS.append(cn(t)); format(TDS, " _t", TMPN)
	if clean: TDS.append(" __attribute__((cleanup(hr_rdrop)))")
	TDS.append(" = {0}; ")
	TMPN
nt() int:
	TMPN++; TMPN
ot(k int): format(O, "_t", k);
lv_name(v int): for c nm(LVS[v].name) { O.push(if c == '$' || c == ':' { '_' } else { c }) } format(O, "_", v);
lv_isptr(v int) bool:
	LVS[v].fl & LV_REF != 0 && TY[LVS[v].ty].k != TY_REF && !is_vval(LVS[v].ty)
lv_expr(v int):
	p := lv_isptr(v)
	if LVS[v].cfn != GCF: ow(if p { "(**c" } else { "(*c" }); format(O, v, ")"); return
	if p: ow("(*"); lv_name(v); ow(")"); return
	lv_name(v);
lv_addr(v int): if LVS[v].cfn != GCF { format(O, "c", v); return } ow("&"); lv_name(v);
fin(n int) int:
	c := cv(n); if c >= 0:
		c
	else:
		t := at(n); if t < 0:
			T_VOID
		else:
			t
recursive is_place(n int) bool:
	x := ND[n]; k := x.k
	if k == N_ID: r := rk(n); return r == R_LOCAL || r == R_GLOBAL
	if k == N_DOT: if rk(n) == R_FIELD && is_vst(deref(at(x.a))) { return !is_vval(at(n)) } return rk(n) == R_FIELD && rel_field(n) < 0 && (is_place(x.a) || TY[at(x.a)].k == TY_REF)
	if k == N_IDX: bt := at(x.a); return TY[deref(bt)].k == TY_SLICE || is_place(x.a) || TY[bt].k == TY_REF
	if k == N_UN && x.op as int == T_AND: return is_place(x.a)
	if k == N_CALL && rk(n) == R_BUILTIN && rv(n) == B_PUSH: return true
	false
owned(n int) bool:
	is_res(fin(n)) && !is_place(n)
cstr_lit(s const byte[:]):
	O.push('"')
	for c s:
		if c == '"' || c == '\\': O.push('\\'); O.push(c)
		else:
			if c >= 32 && c < 127 && c != '?': O.push(c) else: O.push('\\'); O.push('0' + (c >> 6 & 7)); O.push('0' + (c >> 3 & 7)); O.push('0' + (c & 7))
	O.push('"');
oint(v i64, uns bool, t int):
	k := TY[t].k
	if k == TY_FLT: ow("(("); ct(t); ow(")"); if uns { format(O, v as! u64, "ULL"); } else { if v == -9223372036854775807 - 1 { ow("(-9223372036854775807LL - 1)"); } else { format(O, v, "LL"); } } ow(")"); return
	if k == TY_BOOL: ow(if v != 0 { "true" } else { "false" }); return
	ow("(("); ct(if k == TY_INT { t } else { T_I64 }); ow(")")
	if uns: format(O, v as! u64, "ULL)"); return
	if v == -9223372036854775807 - 1: ow("(-9223372036854775807LL-1))"); return
	format(O, v, "LL)");
recursive gx(n int):
	if ND[n].k as int == N_ID && rk(n) == R_CFB && CFBS[rv(n)].k == 0: c := CFBS[rv(n)]; ft := fin(n); sa := AOWN; AOWN = c.b; e := c.a; o := cv(e); set_cv(e, ft); gx(e); set_cv(e, o); AOWN = sa; return
	c := cv(n); t := at(n)
	if c < 0 || c == t: gx1(n); return
	gcv(n, t, c);
recursive gx1(n int):
	if is_res(at(n)) && !is_place(n): k := tmp(at(n), true); ow("(*hr_tmp(&"); ot(k); ow(", "); gx0(n); ow("))"); return
	gx0(n);
recursive gxo(n int):
	c := cv(n); t := at(n)
	if c >= 0 && c != t: if is_res(c) { gcv(n, t, c); return } gx(n); return
	if is_res(t) && is_place(n): ow("hr_rdup("); gx0(n); ow(", "); esz(TY[t].a); ow(")"); return
	gx0(n);
recursive gaddr(n int):
	if is_vval(deref(at(n))): gx0(n); return
	if is_place(n): ow("(&("); gx0(n); ow("))"); return
	t := at(n)
	nk := ND[n].k
	if (nk == N_IF || nk == N_MATCH || nk == N_EBLOCK || nk == N_LOOP || nk == N_BLOCK) && t != T_VOID && t >= 0 && TY[t].k != TY_REF && !is_res(t): r := nt(); ARES.push(r); ow("({ "); ct(t); ow(" *_r"); oi(r); ow("; "); if nk == N_IF { gif(n, r); } else { if nk == N_MATCH { gmatch(n, r); } else { if nk == N_EBLOCK { geblock(n, r); } else { if nk == N_LOOP { gloop(n, r); } else { gblk(n, r, false); } } } } ARES.pop(); ow(" _r"); oi(r); ow("; })"); return
	c := cv(n)
	if c >= 0 && TY[c].k == TY_REF && TY[t].k != TY_REF:
		pt := TY[c].a
		k := tmp(pt, is_res(pt))
		ow("("); ot(k); ow(" = ("); if pt == t { if is_res(t) { gx0(n); } else { gx1(n); } } else { gcv(n, t, pt); } ow("), &"); ot(k); ow(")")
		return
	k := tmp(t, is_res(t))
	ow("("); ot(k); ow(" = ("); gxo(n); ow("), &"); ot(k); ow(")");
recursive gsl(n int, f int):
	d := deref(f)
	k := TY[d].k
	if TY[f].k == TY_REF && TY[f].c < 0:
		p := nt()
		ow("({ "); ct(f); ow(" _t"); oi(p); ow(" = "); gx0(n); ow("; ")
		if k == TY_SLICE: ow("*_t"); oi(p)
		else:
			if is_vimg(d): ow("hr_vsl(_t"); oi(p); vargs(d); ow(")")
			else:
				if is_res(d): ow("hr_sl(*_t"); oi(p); ow(")")
				else:
					if is_fix(d): ow("(hsl){ (uint8_t*)_t"); oi(p); format(O, "->e, ", TY[d].b, " }")
					else: ow("(hsl){ (uint8_t*)_t"); oi(p); ow("->e, _t"); oi(p); ow("->n }")
		ow("; })")
		return
	if k == TY_SLICE || k == TY_STRLIT: gx0(n); return
	if is_vimg(d): if !vok(n, d) { return } ow("hr_vsl("); gx0(n); vargs(d); ow(")"); return
	if is_res(d): ow("hr_sl("); if is_place(n) { gx0(n); } else { tk0 := tmp(d, true); ow("*hr_tmp(&"); ot(tk0); ow(", "); gx0(n); ow(")"); } ow(")"); return
	p := nt()
	ow("({ "); ct(d); ow(" *_t"); oi(p); ow(" = ")
	if is_place(n): ow("&("); gx0(n); ow(")") else: tk0 := tmp(d, false); ow("("); ot(tk0); ow(" = "); gx0(n); ow(", &"); ot(tk0); ow(")")
	ow("; ")
	if is_fix(d): ow("(hsl){ (uint8_t*)_t"); oi(p); format(O, "->e, ", TY[d].b, " }")
	else: ow("(hsl){ (uint8_t*)_t"); oi(p); ow("->e, _t"); oi(p); ow("->n }")
	ow("; })");
recursive gas(n int):
	c := cv(n); t := at(n)
	if c >= 0 && c != t && TY[c].k == TY_SLICE: gsl(n, t); return
	if c >= 0 && c != t: p := nt(); ow("({ "); ct(c); ow(" _t"); oi(p); ow(" = "); gx(n); ow("; "); if is_res(c) { ow("hr_sl(_t"); oi(p); ow(")"); } else { if is_fix(c) { ow("(hsl){ (uint8_t*)_t"); oi(p); format(O, ".e, ", TY[c].b, " }"); } else { if TY[c].k == TY_SLICE { ow("_t"); oi(p); } else { ow("(hsl){ (uint8_t*)_t"); oi(p); ow(".e, _t"); oi(p); ow(".n }"); } } } ow("; })"); return
