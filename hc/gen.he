embed_read(n int, a0 int, emb byte[>..]&) const byte[:]:
	a ~= a0
	if ND[a].k as int == N_ID && rk(a) == R_GLOBAL: g := DC[rv(a)].node; if ND[g].b >= 0 { a = kid(ND[g].b, 0) }
