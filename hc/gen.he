	f := nm(FILES[TK[ND[n].t].f].name); p byte[..4096] ~= []; sl ~= -1; for c, i f { if c == '/' { sl = i } }
	if sl >= 0: p.append(f[..sl + 1])
	p.append(tok_str(ND[a].t))
	if read_file(p[..], emb) { "" } else { "embed_file cannot read its file" }
gembed(n int, a int):
	emb byte[>..] ~= []; e := embed_read(n, a, emb)
	if e.len > 0: gerr(n, e); return
	ow("hr_str("); cstr_lit(emb[..]); format(O, ", ", emb.len, ")");
