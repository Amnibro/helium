		else: if pt != deref(e) && !(TY[pt].k == TY_VARIANT && TY[deref(e)].k == TY_VARIANT && TY[pt].a == TY[deref(e)].a && TY[pt].c == TY[deref(e)].c) { gerr(n, "from_bytes cannot verify a relative reference into a field of an element (§12)") } hh("if (tg < 0 || tg >= n || tg % esz) return false; ")
