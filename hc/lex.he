		format(gen, "fn ", name, "(", sig, ") ", ret, " {\n\tif !", n, "_live { ", n, "_load(); }\n\t", wid, "let lut__k = ", key, ";\n\tvar lut__b = ", n, "_t[lut__k >> ", tb, "];\n\tif lut__b < 0 { lut__b = (", n, "_v.len >> ", tb, ") as i32; ", n, "_t[lut__k >> ", tb, "] = lut__b; let lut__vl = ", n, "_v.len + ", tsz, "; let lut__sl = ", n, "_s.len + ", words, "; ", n, "_v.resize(lut__vl, default<", ret, ">()); ", n, "_s.resize(lut__sl, 0); }\n")
		format(gen, "\tlet lut__j = ((lut__b as int) << ", tb, ") | (lut__k & ", tsz - 1, ");\n\tif (", n, "_s[lut__j >> 6] >> (lut__j & 63)) & 1 == 0 { ", n, "_v[lut__j] = ", n, "(", args, "); ", n, "_s[lut__j >> 6] |= 1 << (lut__j & 63); ", n, "_dirty = true; }\n\t", n, "_v[lut__j]\n}\n")
		format(sv, n, "_save(); "); pos = e
	if gen.len == 0: return true
	if root:
