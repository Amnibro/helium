		if mi >= 0: t byte[>..] ~= []; t.append(out[..mi]); t.append("fn main__lut("); t.append(out[mi + 8..]); out.clear(); out.append(t[..]); format(gen, "fn main() { main__lut(); ", sv, "}\n")
	out.append(if gpu { "\nimport os;\nimport lutgpu;\n" } else { "\nimport os;\n" }); out.append(gen[..]); true
