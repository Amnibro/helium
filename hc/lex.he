				format(fill, "\t", n, "_probe.resize(64, default<", ret, ">());\n\tlet lut__p0 = clock_ns();\n\tfor q in 64 { let lut__e = q * ", nn / 64, "; ", n, "_probe[q] = ", n, "(", pa, "); }\n\tvar lut__g byte[>..] = [];\n\tif lutgpu::fill(", n, "_spv, lut__g, ", nn, ", (clock_ns() - lut__p0) * ", nn / 64, ") {\n\t\tfor q in ", tiles, " { ", n, "_t.push(q as i32); }\n\t\t", n, "_v.resize(", nn, ", default<", ret, ">());\n\t\t", n, "_s.resize(", tiles * words, ", 0);\n")
				format(fill, "\t\tfor e in ", nn, " {\n\t\t\tif lut__g[", nn * 8, " + e * 4] == 0 {\n\t\t\t\tvar lut__x uint = 0;\n\t\t\t\tfor q in 8 { let lut__gb uint = lut__g[e * 8 + q]; lut__x |= lut__gb << (q * 8); }\n\t\t\t\t", n, "_v[e] = ", cv, ";\n\t\t\t\t", n, "_s[e >> 6] |= 1 << (e & 63);\n\t\t\t}\n\t\t}\n\t\t", n, "_dirty = true;\n\t\treturn;\n\t}\n")
		format(gen, "var ", n, "_t i32[>..];\nvar ", n, "_v ", ret, "[>..];\nvar ", n, "_s u64[>..];\nvar ", n, "_live = false;\nvar ", n, "_dirty = false;\n")
		format(gen, "fn ", n, "_path() byte[>..] { var p byte[>..] = []; if !env(\"HOME\", p) { p.append(\".\"); } format(p, \"/.goose\"); make_dir(p); format(p, \"/lut\"); make_dir(p); format(p, \"/", name, "-", hex, ".lut\"); p }\n")
		format(gen, "fn ", n, "_load() {\n\t", n, "_live = true;\n\tvar img byte[>..] = [];\n\tif read_file(", n, "_path(), img) {\n\t\tlet a, an = parse_uleb(img);\n\t\tlet b, bn = parse_uleb(img[an + a..]);\n\t\tlet t, tok = from_bytes<i32[>..]>(img[..an + a]);\n\t\tlet v, vok = from_bytes<", ret, "[>..]>(img[an + a..an + a + bn + b]);\n\t\tlet s, sok = from_bytes<u64[>..]>(img[an + a + bn + b..]);\n\t\tif tok && vok && sok && t.len == ", tiles, " { ", n, "_t.append(t); ", n, "_v.append(v); ", n, "_s.append(s); return; }\n\t}\n", fill, "\t", n, "_t.resize(", tiles, ", -1);\n}\n")
