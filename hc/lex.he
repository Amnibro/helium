				format(gen, "let ", n, "_spv byte[", w.len * 4, "] = ["); for x, i w { for q 4 { if i + q > 0 { gen.append(", ") } format(gen, (x >> (q * 8) as u32) & 255) } } gen.append("];\n"); format(gen, "var ", n, "_probe ", ret, "[>..];\n"); gpu = true
