use os
T_EOF := 0; T_IDENT := 1; T_INT := 2; T_FLT := 3; T_STR := 4
T_LP := 5; T_RP := 6; T_LB := 7; T_RB := 8; T_LC := 9; T_RC := 10; T_COMMA := 11; T_SEMI := 12; T_COLON := 13; T_QUEST := 14; T_CC := 15
T_DOT := 16; T_DOTDOT := 17; T_DOTASSIGN := 18; T_DOTEQ := 19; T_DOTNEQ := 20
T_PLUS := 21; T_MINUS := 22; T_MUL := 23; T_DIV := 24; T_MOD := 25
T_PLUSEQ := 26; T_MINUSEQ := 27; T_MULEQ := 28; T_DIVEQ := 29; T_MODEQ := 30; T_ANDEQ := 31; T_OREQ := 32; T_XOREQ := 33
T_INC := 34; T_DEC := 35; T_ASSIGN := 36; T_EQ := 37; T_NEQ := 38; T_LT := 39; T_GT := 40; T_LTEQ := 41; T_GTEQ := 42
T_SHL := 43; T_SHR := 44; T_SHLEQ := 45; T_SHREQ := 46; T_NOT := 47; T_BITNOT := 48; T_AND := 49; T_OR := 50; T_XOR := 51
T_ANDAND := 52; T_OROR := 53; T_ARROW := 54; T_FAT := 55
T_KW := 56
KWS := ["import", "namespace", "struct", "enum", "type", "fn", "thread_fn", "export", "simd", "recursive", "let", "var", "extern", "const", "pad", "reusable", "if", "else", "while", "for", "in", "loop", "block", "guard", "match", "return", "break", "continue", "as", "true", "false", "null", "self", "bool", "varint", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "int", "uint", "byte", "real"]
K_IMPORT := 56; K_NAMESPACE := 57; K_STRUCT := 58; K_ENUM := 59; K_TYPE := 60; K_FN := 61; K_THREADFN := 62; K_EXPORT := 63; K_SIMD := 64; K_RECURSIVE := 65
K_LET := 66; K_VAR := 67; K_EXTERN := 68; K_CONST := 69; K_PAD := 70; K_REUSABLE := 71; K_IF := 72; K_ELSE := 73; K_WHILE := 74; K_FOR := 75; K_IN := 76
K_LOOP := 77; K_BLOCK := 78; K_GUARD := 79; K_MATCH := 80; K_RETURN := 81; K_BREAK := 82; K_CONTINUE := 83; K_AS := 84; K_TRUE := 85; K_FALSE := 86; K_NULL := 87; K_SELF := 88
K_BOOL := 89; K_VARINT := 90; K_I8 := 91; K_I16 := 92; K_I32 := 93; K_I64 := 94; K_U8 := 95; K_U16 := 96; K_U32 := 97; K_U64 := 98; K_F32 := 99; K_F64 := 100
K_INT := 101; K_UINT := 102; K_BYTE := 103; K_REAL := 104
NKW := 49
struct Tok { k u8, ml bool, uns bool, lay bool, f u16, line i32, s i32, n i32, w i32, v i64 }
struct File { s i32, n i32, name i32, amni bool, he bool }
struct Name { s i32, n i32 }
var SRC byte[>..]
var NAMES byte[>..]
var STRS byte[>..]
var NM Name[>..]
var NH i32[>..]
var FILES File[>..]
var TK Tok[>..]
var LERR byte[>..]
nm(id int) const byte[:]:
	x := NM[id]; NAMES[(x.s as int)..x.s + x.n]
hash(s const byte[:]) u64:
	h u64 ~= 1469598103934665603; for c s { h = (h ^ c) * 1099511628211 } h
intern(s const byte[:]) int:
	if NH.len == 0: NH.resize(1 << 16, -1)
	if NM.len * 2 >= NH.len:
		n := NH.len * 2
		NH.clear(); NH.resize(n, -1)
		for x, i NM: j ~= (hash(NAMES[(x.s as int)..x.s + x.n]) as int) & n - 1; while NH[j] >= 0 { j = j + 1 & n - 1 } NH[j] = i
	m := NH.len - 1
	j ~= (hash(s) as int) & m
	while NH[j] >= 0: if nm(NH[j]) == s { return NH[j] } j = j + 1 & m
	id := NM.len
	NM.push(Name{NAMES.len, s.len})
	NAMES.append(s)
	NH[j] = id
	id
lex_init():
	if NM.len == 0:
		for k KWS: intern(k)
idc(c byte) bool:
	c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_' || c >= '0' && c <= '9'
dig(c byte) bool:
	c >= '0' && c <= '9'
hexd(c byte) bool:
	dig(c) || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F'
hexv(c byte) int:
	if c <= '9':
		(c - '0') as int
	else:
		((c | 0x20) - 'a') as int + 10
lerr(f int, line int, m const byte[:]) bool:
	if LERR.len == 0 { LERR.append(nm(FILES[f].name)); format(LERR, ":", line, ": error: ", m) } false
esc(p int&, f int, line int) int:
	c u8 := SRC[p]; p++
	if c != '\\': return c
	e u8 := SRC[p]; p++
	if e == 'n' { return 10 } if e == 't' { return 9 } if e == 'r' { return 13 } if e == '0': return 0
	if e == '\\' || e == '"' || e == '\'': return e
	if e == 'x' && hexd(SRC[p]) && hexd(SRC[p + 1]): v := hexv(SRC[p]) * 16 + hexv(SRC[p + 1]); p += 2; return v
	lerr(f, line, "unknown escape sequence")
	-1
lay_else(p0 int) bool:
	p ~= p0; d ~= 0; loop { c u8 := SRC[p]; if c == 0 || c == '\n' || c == '#' { return false } if c == '"' || c == '\'' { p++; while SRC[p] != c && SRC[p] != 0 && SRC[p] != '\n' { if SRC[p] == '\\' { p++ } p++ } } if c == '(' || c == '[' { d++ } if c == ')' || c == ']' { d-- } if d == 0 && c == '{' { return false } if d == 0 && c == ':' && SRC[p + 1] != ':' { return true } if d == 0 && c == ':' { p++ } p++ } false
lex_file(path const byte[:]) bool:
	lex_init()
	body byte[>..] ~= []
	if !read_file(path, body): LERR.append("cannot read "); LERR.append(path); return false
	f := FILES.len
	base := SRC.len
	skip := if body.len >= 3 && body[0] == 0xEF && body[1] == 0xBB && body[2] == 0xBF { 3 } else { 0 }
	SRC.append(body[skip..]); SRC.push(0); SRC.push(0); SRC.push(0); SRC.push(0)
	FILES.push(File{base, body.len - skip, intern(path), path.len > 5 && path[^5..] == ".amni" || path.len > 3 && path[^3..] == ".he", path.len > 3 && path[^3..] == ".he"})
	amni := FILES[f].amni; he := FILES[f].he; t0 := TK.len
	dep ~= 0; ind i32[>..] ~= [0]; inl ~= 0; ss ~= TK.len; nl ~= false; col ~= 0
	p ~= base
	line ~= 1
	put(k int, s int, e int):
		TK.push(Tok{k: k, f: f, line: line, s: s, n: e - s, ..}); kk := k; if kk == T_SEMI || kk == T_LC || kk == T_RC || kk == T_FAT: ss = TK.len
	lay(k int, s int): put(k, s, s); TK[TK.len - 1].lay = true; if TK.len > 1: TK[TK.len - 1].line = TK[TK.len - 2].line
	ins(k int, s int): TK.push(TK[TK.len - 1]); i ~= TK.len - 2; while i > ss { TK[i] = TK[i - 1]; i-- } TK[ss] = Tok{k: k, f: f, line: line, s: s, n: 0, lay: true, ..}
	loop:
		c u8 ~= SRC[p]
		while c == ' ' || c == '\t' || c == '\r' || c == '\n': if c == '\n' { line++; nl = true; col = 0 } else { col++ } p++; c = SRC[p]
		if c == '/' && SRC[p + 1] == '/' && !he: while SRC[p] != '\n' && SRC[p] != 0 { p++ } continue
		if c == '#' && he: while SRC[p] != '\n' && SRC[p] != 0 { p++ } continue
		if he && dep == 0 && (nl || c == 0) && TK.len > t0:
			nl = false
			while inl > 0: lay(T_RC, p); inl--
			lt := TK.len - 1; top := ind[ind.len - 1]
			isel := c == 'e' && SRC[p + 1] == 'l' && SRC[p + 2] == 's' && SRC[p + 3] == 'e' && !idc(SRC[p + 4])
			if TK[lt].k as int == T_COLON && TK[lt].lay: if c == 0 || col <= top { return lerr(f, line, "expected an indented block after ':'") } TK[lt].k = T_LC as u8; ind.push(col); ss = TK.len
			else:
				cl := if c == 0 { 0 } else { col }
				if cl > top: return lerr(f, line, "unexpected indentation")
				while cl < ind[ind.len - 1]: lay(T_RC, p); ind.pop()
				if cl != ind[ind.len - 1]: return lerr(f, line, "this line's indentation matches no enclosing block")
				lk := TK[TK.len - 1].k
				if !isel && lk != T_SEMI && lk != T_LC: lay(T_SEMI, p)
		nl = false
		if c == '/' && SRC[p + 1] == '*':
			p += 2; nest ~= 1
			while nest > 0: d u8 := SRC[p]; if d == 0 { return lerr(f, line, "unterminated /* comment") } if d == '\n' { line++ } if d == '*' && SRC[p + 1] == '/' { nest--; p++ } else { if d == '/' && SRC[p + 1] == '*' { nest++; p++ } } p++
			continue
		s := p
		n1 u8 := SRC[p + 1]; n2 u8 := SRC[p + 2]
		if c == 0: put(T_EOF, s, s); return true
		if dig(c):
			if c == '0' && (n1 == 'x' || n1 == 'X'):
				p += 2; ds := p; while hexd(SRC[p]): p++
				hf ~= false
				if SRC[p] == '.' && hexd(SRC[p + 1]):
					hf = true; p++; while hexd(SRC[p]): p++
				if SRC[p] == 'p' || SRC[p] == 'P':
					hf = true; p++; if SRC[p] == '+' || SRC[p] == '-' { p++ } while dig(SRC[p]): p++
				if hf: put(T_FLT, s, p); continue
				if p - ds > 16: return lerr(f, line, "hex literal too large for 64 bits")
				v u64 ~= 0; for q ds..p: v = v << 4 | hexv(SRC[q]) as u64
				put(T_INT, s, p); TK[TK.len - 1].v = v as! i64; TK[TK.len - 1].uns = v > 9223372036854775807; continue
			while dig(SRC[p]): p++
			fl ~= false
			if SRC[p] == '.' && dig(SRC[p + 1]):
				fl = true; p++; while dig(SRC[p]): p++
			if (SRC[p] == 'e' || SRC[p] == 'E') && (dig(SRC[p + 1]) || (SRC[p + 1] == '+' || SRC[p + 1] == '-') && dig(SRC[p + 2])):
				fl = true; p += 2; while dig(SRC[p]): p++
			if fl: put(T_FLT, s, p); continue
			v u64 ~= 0
			for q s..p: d := (SRC[q] - '0') as u64; if v > (18446744073709551615 - d) / 10 { return lerr(f, line, "integer literal too large for 64 bits") } v = v * 10 + d
			put(T_INT, s, p); TK[TK.len - 1].v = v as! i64; TK[TK.len - 1].uns = v > 9223372036854775807; continue
		if idc(c):
			while idc(SRC[p]): p++
			id := intern(SRC[s..p])
			k ~= if id < NKW { T_KW + id } else { T_IDENT }
			if !amni && k >= K_INT: k = T_IDENT
			if he && dep == 0 && k == K_ELSE && inl > 0 && lay_else(p): lay(T_RC, s); inl--
			if he && dep == 0 && ind.len == 1 && TK.len == ss && p - s == 3 && SRC[s..p] == "use" && SRC[p] == ' ': k = K_IMPORT
			put(k, s, p); TK[TK.len - 1].v = id
			continue
		if c == '\'':
			p++; v := esc(p, f, line)
			if v < 0: return false
			if SRC[p] != '\'': return lerr(f, line, "expected closing ' of character literal")
			p++; put(T_INT, s, p); TK[TK.len - 1].v = v; continue
		if c == '"':
			ss := STRS.len
			ml ~= false
			if n1 == '"' && n2 == '"':
				p += 3
				q ~= p; while SRC[q] == ' ' || SRC[q] == '\t' || SRC[q] == '\r': q++
				if SRC[q] != '\n':
					while !(SRC[p] == '"' && SRC[p + 1] == '"' && SRC[p + 2] == '"'): if SRC[p] == 0 || SRC[p] == '\n' { return lerr(f, line, "unterminated \"\"\" string") } STRS.push(SRC[p]); p++
					p += 3
				else:
					ml = true
					first := q + 1
					close ~= first
					while !(SRC[close] == '"' && SRC[close + 1] == '"' && SRC[close + 2] == '"'): if SRC[close] == 0 { return lerr(f, line, "unterminated \"\"\" string") } close++
					cs ~= close; while cs > first && SRC[cs - 1] != '\n': cs--
					mg := close - cs
					for q2 cs..close:
						if SRC[q2] != ' ' && SRC[q2] != '\t': return lerr(f, line, "only indentation may come before the closing \"\"\" of a multi-line string")
					l ~= first
					while l < cs:
						e ~= l; while SRC[e] != '\n': e++
						te ~= e; if te > l && SRC[te - 1] == '\r': te--
						if l != first: STRS.push('\n')
						ok ~= te - l >= mg; if ok:
							for k mg:
								if SRC[l + k] != SRC[cs + k]: ok = false
						if ok: STRS.append(SRC[l + mg..te])
						else:
							for k l..te:
								if SRC[k] != ' ' && SRC[k] != '\t': return lerr(f, line, "a line of a multi-line string must start with the indentation of its closing \"\"\"")
						l = e + 1
					for k p..close + 3:
						if SRC[k] == '\n': line++
					p = close + 3
			else:
				p++
				while SRC[p] != '"': if SRC[p] == '\n' || SRC[p] == 0 { return lerr(f, line, "unterminated string literal") } v := esc(p, f, line); if v < 0 { return false } STRS.push(v as! byte)
				p++
			put(T_STR, s, p); TK[TK.len - 1].v = ss; TK[TK.len - 1].w = STRS.len - ss; TK[TK.len - 1].ml = ml
			continue
		p++
		k ~= -1
		if he && (c == ':' && n1 == '=' || c == '~' && n1 == '='): ins(if c == ':' { K_LET } else { K_VAR }, s); p++; put(T_ASSIGN, s, p); continue
		if he && dep == 0 && c == ':' && n1 != ':': q ~= p; while SRC[q] == ' ' || SRC[q] == '\t' || SRC[q] == '\r' { q++ } if SRC[q] == '\n' || SRC[q] == 0 || SRC[q] == '#' { put(T_COLON, s, p); TK[TK.len - 1].lay = true } else { lay(T_LC, s); inl++ } continue
		if c == '(' || c == '[' || c == '{' { dep++ } if (c == ')' || c == ']' || c == '}') && dep > 0: dep--
		if c == '(': k = T_LP
		else:
			if c == ')': k = T_RP
			else:
				if c == '[': k = T_LB
				else:
					if c == ']': k = T_RB
					else:
						if c == '{': k = T_LC
						else:
							if c == '}': k = T_RC
							else:
								if c == ',': k = T_COMMA
								else:
									if c == ';': k = T_SEMI
									else:
										if c == '?': k = T_QUEST
										else:
											if c == '~': k = T_BITNOT
		if c == ':':
			if n1 == ':': p++; k = T_CC else: k = T_COLON
		if c == '.':
			if n1 == '.': p++; k = T_DOTDOT
			else:
				if n1 == '=' && n2 == '=': p += 2; k = T_DOTEQ
				else:
					if n1 == '!' && n2 == '=': p += 2; k = T_DOTNEQ
					else:
						if n1 == '=': p++; k = T_DOTASSIGN else: k = T_DOT
		if c == '+':
			if n1 == '+': p++; k = T_INC
			else:
				if n1 == '=': p++; k = T_PLUSEQ else: k = T_PLUS
		if c == '-':
			if n1 == '-': p++; k = T_DEC
			else:
				if n1 == '=': p++; k = T_MINUSEQ
				else:
					if n1 == '>': p++; k = T_ARROW else: k = T_MINUS
		if c == '*':
			if n1 == '=': p++; k = T_MULEQ else: k = T_MUL
		if c == '/':
			if n1 == '=': p++; k = T_DIVEQ else: k = T_DIV
		if c == '%':
			if n1 == '=': p++; k = T_MODEQ else: k = T_MOD
		if c == '=':
			if n1 == '=': p++; k = T_EQ
			else:
				if n1 == '>': p++; k = T_FAT else: k = T_ASSIGN
		if c == '!':
			if n1 == '=': p++; k = T_NEQ else: k = T_NOT
		if c == '<':
			if n1 == '=': p++; k = T_LTEQ
			else:
				if n1 == '<' && n2 == '=': p += 2; k = T_SHLEQ
				else:
					if n1 == '<': p++; k = T_SHL else: k = T_LT
		if c == '>':
			if n1 == '=': p++; k = T_GTEQ
			else:
				if n1 == '>' && n2 == '=': p += 2; k = T_SHREQ
				else:
					if n1 == '>': p++; k = T_SHR else: k = T_GT
		if c == '&':
			if n1 == '&': p++; k = T_ANDAND
			else:
				if n1 == '=': p++; k = T_ANDEQ else: k = T_AND
		if c == '|':
			if n1 == '|': p++; k = T_OROR
			else:
				if n1 == '=': p++; k = T_OREQ else: k = T_OR
		if c == '^':
			if n1 == '=': p++; k = T_XOREQ else: k = T_XOR
		if k < 0: return lerr(f, line, "illegal character")
		put(k, s, p)
	true
tok_text(t int) const byte[:]:
	x := TK[t]; SRC[(x.s as int)..x.s + x.n]
tok_str(t int) const byte[:]:
	x := TK[t]; STRS[(x.v as int)..x.v as int + x.w]
