		return
	if op == I_NOP:
		if (c & 255) != 79 || MVLT[x.l as int] == 0 { return } s := (x.l as int) - MVB0; ka := MVK[a]; kb := MVK[b]; if ka == -1 || kb == -1 { return }
		MVIK[s] = ka; MVIO[s] = MVO[a]; MVIE[s] = (c >> 8) - 1; ce := if kb == 1 { mvcl(MVO[b], MVO[b]) } else { -1 }
