			if d >= 0 { mvaz(); MVAK = 0; if p77 { s := (IR[k - 1].l as int) - MVB0; mvjt(s); MVIK[s] = k0; MVIO[s] = MVO[v0]; MVIE[s] = if pf == 1 && b >= 3 && mvim(ARGL[a + 2] as int) { MVIV } else { -1 } } mvst(d) }
