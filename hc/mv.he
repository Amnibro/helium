		if f >= 0 { ce := if ka == 1 { mvcl(MVO[a], MVO[a] + c) } else { -1 }; if ce >= 0 { mvrdc(ce, f) } else { mvrdo(f) } } else if ka != -1 { MVAK = 0; MVAD = MVA[a] | MVD[a] }
		if p77 { s := (IR[k - 1].l as int) - MVB0; mvjn(0, 0); mvjt(s); MVIK[s] = ka; MVIO[s] = MVO[a]; MVIE[s] = ((IR[k - 1].c as int) >> 8) - 1 }
