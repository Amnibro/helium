# Every checkout sees the same bytes on Windows, Linux and macOS. Two things
# in this repo depend on that: the test and sample runners compare program
# output with blessed files in expected/, and hc/seed/hc.c is generated C whose
# bytes the bootstrap compares.
* text=auto eol=lf

# Checks that a """ string's line breaks come out as \n from a CRLF file.
test/syntax/raw_strings_crlf.amni -text

hc/seed/** linguist-generated
bench/** linguist-vendored
