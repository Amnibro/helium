import std;
import os;
import math;
fn neg(x real) real { -x }
fn negf(x f32) f32 { -x }
fn tou(x real) u32 { let t = if x < 0.0 { -floor(-x) } else { floor(x) }; let m = t - floor(t / 4294967296.0) * 4294967296.0; m as u32 }
fn main() {
	let a = args();
	var s = 0.0;
	var h u64 = 0;
	for i in 200 { let x = (i as real - 100.0) * 12345.678; s += neg(x) * 0.5 + negf(x as f32) as real; h = h * 31 + tou(x) as u64 + (x as i32) as! u64 + (-x) as int as! u64; }
	var o byte[>..] = [];
	format(o, s, " ", h, " ", neg(0.0), " ", negf(-0.0), " ", tou(-1.0e20), " ", (1.0e19 * (a.len as real)) as int, "\n");
	print(o);
}
