import std;
import json;
fn main() {
	var out byte[>..] = [];
	for x in [0.0, -0.0, 1.0, -1.5, 0.1, -0.001, 123456.789, -1e21, 1e-7, 5e-324, 1.7976931348623157e308, 100.0, -2.5e10, 0.30000000000000004, 9007199254740993.0, -123.456, 1e16, 12345678901234567.0, 3.0e-5] {
		json::format_number(out, x); out.push(' ');
	}
	print(str(out));
}
