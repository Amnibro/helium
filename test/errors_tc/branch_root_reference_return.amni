// error: the block's value is a reference rooted at t, which does not outlive it
// The branch's local is gone before the function returns the reference.
fn first(xs int[>..]&) int& {
	if xs.len > 0 { xs[0] } else { var t int[>..] = [4]; t[0] }
}
fn main() {
	var xs int[>..] = [1, 2, 3];
	print(first(xs));
}
