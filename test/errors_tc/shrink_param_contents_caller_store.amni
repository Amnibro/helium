// error: cannot call emit: it shrinks out while words is still used, and words may refer into out
// mid stores a view of out into what words views, then hands both to
// emit, which clears one and reads the other (§5.1).
fn emit(out byte[>..]&, words (const byte[:])[:]) {
	out.clear();
	out.append("ZZZZZZZZ");
	print(words[0]);
}
fn mid(out byte[>..]&, words (const byte[:])[:]) {
	words[0] = out[..];
	emit(out, words);
}
fn main() {
	var buf byte[>..] = [];
	buf.append("abc");
	var names (const byte[:])[>..] = [];
	names.push("x");
	mid(buf, names[..]);
}
