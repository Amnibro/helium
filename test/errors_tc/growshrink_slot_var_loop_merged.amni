// error: cannot clear related while s
// error: is still used: it may refer into related
// s is a view read out of a field or a view of other when the loop starts,
// but the next iteration sees what the rebind at the end of the body left:
// a value whose root is y, as deep as s's, and which may be a view of
// related (§5.2).
struct Entry { text byte[:] }
var related byte[>..<] = [];
fn main() {
	related.push(9);
	var chars byte[>..] = [];
	var y byte[2] = [3, 4];
	var other byte[>..<] = [];
	var entries Entry[>..] = [];
	chars.append("ab");
	entries.push(Entry { text: chars[..] });
	let c = y[0] > 0;
	var s = if c { entries[0].text } else { other[..] };
	for i in 2 {
		related.clear();
		print(s);
		related.push(5);
		s = if c { related[..] } else { y[..] };
	}
}
