// error: cannot assign through this path (const, or a read-only instantiation, §9.5)
// Case results merge at every position of a multi-value call: the slice is
// writable only if every case returns a writable one.
enum Choice { A { n int }, B { n int } }
fn pick(c Choice.A, s byte[:]) int, byte[:] { return 1, s; }
fn pick(c Choice.B, s byte[:]) int, byte[:] { return 2, "abc"; }
fn main() {
	var buf byte[3] = "xyz";
	let c Choice = Choice.B { n: 2 };
	let k, v = pick(c, buf[..]);
	v[0] = 'Q';
	print(k, v);
}
