// error: storing a reference rooted at x, which does not outlive the destination
// A struct holding a reference to a loop-body local, pushed into an array
// declared outside the loop (§9.2).
struct S { r int&, k int }
fn main() {
	var outer S[>..] = [];
	for i in 3 {
		var x = i;
		let s = S { r: x, k: i };
		outer.push(s);
	}
	print(outer.len);
}
