// error: recursive call changes the enclosing specialization of a long-distance return
// step reuses mid inside g<i32> before walk's `return ... from g` gives mid
// its g<i64> target, so the innermost g on that call path is the wrong one.
fn h() int {
	let v int = 1;
	print("outer g returned ", g(v, 2));
	return 0;
}
fn maybe_h(n int) { if n > 100 { return -1 from h; } }
fn g<T>(x T, n int) T { step(x, n); return x; }
fn step(x int, n int) { walk(n); }
fn step(x i32, n int) { maybe_h(n); mid(n); }
recursive fn walk(n int) {
	if n == 2 { mid(n); return; }
	if n == 1 {
		let z i32 = 7;
		let inner = g(z, 0);
		print("inner g returned ", inner);
		return;
	}
	return 42 from g;
}
recursive fn mid(n int) { walk(n - 1); }
fn main() { print(h()); }
