// error: cannot call g: it may shrink ys while s is still used, and s may refer into ys
// The loop iterates s in place, and this call passes ys to both of g's
// parameters: h.a, read back out of a copy of an element of hs, may be ys
// (§9.5), so the pop frees an element the loop
// reads next (§5.1, §6.5).
struct H { a int[>..]& }
fn g(xs int[>..]&, s int[:]) {
	for x in s {
		xs.pop();
		xs.push(77);
		print(x);
	}
}
fn main() {
	var ys int[>..] = [1, 2, 3];
	var zs int[>..] = [4];
	let hs = [H { a: ys }, H { a: zs }];
	let h = hs[0];
	g(h.a, ys[..]);
}
