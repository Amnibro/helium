// error: cannot call drop, which shrinks xs: xs[0], evaluated earlier in the statement
// error: may still refer into xs
fn read(r int&, unused int) { print(r); }
fn outer(xs int[>..<]&) {
	fn drop() int { xs.pop(); return 0; }
	drop();
	read(xs[0], drop());
}
fn main() {
	var xs int[>..<] = [1, 2];
	outer(xs);
}
