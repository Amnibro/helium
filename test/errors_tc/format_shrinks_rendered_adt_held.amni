// error: cannot call show: it shrinks G while h is still used, and h may refer into G (§5.2)
// A function rendering what its parameter refers to passes the pair on as
// one about what the caller's storage holds, and this caller's holds G
// (§3.7, §4.4, §5.2).
struct A { v int }
struct Q { x int, y int }
enum R {
	Big { a A, q Q&, items int[>..<] },
	Small { w int, h int, k int },
}
struct H { n int, r R..& }
var q1 = Q { x: 1, y: 2 };
var G R.. = R.Small { w: 0, h: 0, k: 0 };
fn format(out byte[>..]&, a A) {
	G = R.Small { w: 4096, h: 100000, k: 3 };
	format(out, a.v);
}
fn show(h H&) { print(h); }
fn main() {
	G = R.Big { a: A { v: 5 }, q: q1, items: [1, 2] };
	var hh = H { n: 1, r: G };
	show(hh);
}
