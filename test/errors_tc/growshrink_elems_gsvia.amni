// error: storing a reference into x, which holds a grow-shrink array
// k is checked first for bag.n, which bag's grow-shrink array of Pts cannot
// hold. r may point into bag or into an element of others, so the array
// its class may point into is not its root's own, and may hold an i64:
// given r, k is checked again, and may not store x (§5.2).
struct Pt { x real }
struct Other { w int }
struct Bag { n int, items Pt[>..<] }
fn k(x int&, loc (int&)[>..]&) { loc.push(x); }
fn main() {
	var bag = Bag { n: 5, items: [Pt { x: 1.0 }] };
	var others Other[>..<] = [Other { w: 7 }];
	var loc (int&)[>..] = [];
	k(bag.n, loc);
	let c = bag.n < 3;
	let r int& = if c { bag.n } else { others[0].w };
	k(r, loc);
	others.pop();
	others.push(Other { w: 99 });
	print(loc[1]);
}
