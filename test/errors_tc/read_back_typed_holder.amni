// error: storing a reference rooted at c, which does not outlive the destination (§9.2)
// A reference to a struct holding an i64 by value, stored beside them, may
// be where an i64 reference read back out of the holder points (§9.5).
struct Cell { v int }
struct P { cell Cell&, items (int&)[>..] }
struct S { refs (int&)[>..] }
fn prep(s S&, pool int[>..]&) {
	var c = Cell { v: 1 };
	var p = P { cell: c, items: [] };
	p.items.push(pool[0]);
	s.refs.append(p.items);
}
fn main() {
	var pool int[>..] = [1];
	var s = S { refs: [] };
	prep(s, pool);
	print(s.refs.len);
}
