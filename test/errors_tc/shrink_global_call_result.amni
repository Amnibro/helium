// error: cannot clear bs: global G may hold a reference into it
// A function's result that is its argument.
struct B { name byte[..8] }
struct H { s const byte[:] }
var bs B[>..] = [];
var cs B[>..] = [];
var G = H { s: "" };
fn reload() { bs.clear(); }
fn id(s const byte[:]) const byte[:] { return s; }
fn later() { G.s = id(bs[0].name[..]); }
fn main() {
	bs.push(B { name: "a" });
	cs.push(B { name: "c" });
	reload();
	bs.push(B { name: "a" });
	later();
	reload();
	bs.push(B { name: "zz" });
	print(G.s);
}
