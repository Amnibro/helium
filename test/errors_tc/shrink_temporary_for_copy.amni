// error: cannot pop arr while h is still used: a reference into it was stored there
// A for binding copies each holder out of a call's result, and with it what
// the call put in it. The loop holds nothing of a resizable result, whose
// elements never move: the binding is what refers into arr.
struct H { r int& }
fn wrap(a int[>..]&) H[>..] { [H { r: a[0] }] }
fn main() {
	var arr int[>..] = [1, 2, 3];
	for h in wrap(arr) {
		arr.pop(); arr.pop(); arr.pop();
		arr.push(42);
		print(h.r);
	}
}
