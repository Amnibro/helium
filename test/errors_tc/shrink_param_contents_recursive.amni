// error: cannot call walk: it shrinks a while w is still used, and w may refer into a
// Each level hands w on as v, and the deepest clears a: the level handed
// tt as v reads its element, a view of a, after it (§5.1).
recursive fn walk(a byte[>..]&, v (const byte[:])[:], w (const byte[:])[:], n int) {
	if n == 0 {
		a.clear();
		a.append("ZZZZZZZZ");
		return;
	}
	walk(a, w, v, n - 1);
	print(v[0]);
}
fn main() {
	var a byte[>..] = [];
	a.append("abc");
	var ss (const byte[:])[>..] = [];
	ss.push("q");
	var tt (const byte[:])[>..] = [];
	tt.push(a[..]);
	walk(a, ss[..], tt[..], 2);
}
