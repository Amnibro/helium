// error: cannot clear out while h is still used: a reference into it was stored there
// put stores a view of out into the elements hs views before emit copies h
// out of them (§5.1).
struct H { s const byte[:] }
fn put(hs H[:], s const byte[:]) { hs[0] = H { s: s }; }
fn emit(out byte[>..]&, hs H[:]) {
	put(hs, out[..]);
	let h = hs[0];
	out.clear();
	out.append("ZZZZZZZZ");
	print(h.s);
}
fn main() {
	var buf byte[>..] = [];
	buf.append("abc");
	var hs H[>..] = [];
	hs.push(H { s: "x" });
	emit(buf, hs[..]);
}
