// error: cannot call prepare, which shrinks cfg while view is still used
// A callee replacing the array its struct parameter refers to replaces the
// global the caller's struct refers to (§5.1).
var cfg byte[>..] = ['c', 'f', 'g'];
struct S { text byte[>..]&, refs (int&)[>..] }
fn prepare(s S&) { s.text = ['x']; }
fn main() {
	let view const byte[:] = cfg[..];
	var s = S { text: cfg, refs: [] };
	prepare(s);
	print(view);
}
