// error: returning a reference rooted in local, which dies with this function
// A dispatched result is rooted as deeply as the deepest case's result.
enum Choice { A { n int }, B { n int } }
fn view(c Choice.A, s const byte[:]) const byte[:] { return "abc"; }
fn view(c Choice.B, s const byte[:]) const byte[:] { return s; }
fn leak(c Choice) const byte[:] {
	var local byte[>..] = [];
	for i in 8 { local.push('a' + i as byte); }
	return view(c, local[..]);
}
fn main() {
	let c Choice = Choice.B { n: 2 };
	print(leak(c));
}
