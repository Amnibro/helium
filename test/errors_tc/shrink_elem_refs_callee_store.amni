// error: cannot clear a while v is still used: the slices it views may point into it
// put stores a view of a into the elements it is given, ss's, which v
// views (§5.1).
fn put(w (byte[:])[:], a byte[>..]&) {
	w[0] = a[..];
}
fn main() {
	var a byte[>..] = [];
	a.append("abc");
	var x byte[>..] = [];
	x.append("x");
	var ss (byte[:])[>..] = [];
	ss.push(x[..]);
	put(ss[..], a);
	let v = ss[..];
	a.clear();
	a.append("ZZZZZZZZ");
	print(v[0]);
}
