// error: cannot call f: it may shrink ys while b is still used, and b may refer into ys
// f passes g its own two parameters' classes, so they are two arrays in g
// wherever they are in f, and f is given h.a, read back out of a copy of an
// element of hs, which may be ys (§9.5), beside ys itself (§5.1).
struct H { a int[>..]& }
fn g(xs int[>..]&, r int&) { xs.pop(); xs.push(77); print(r); }
fn f(a int[>..]&, b int[>..]&) { g(a, b[2]); }
fn main() {
	var ys int[>..] = [1, 2, 3];
	var zs int[>..] = [4];
	let hs = [H { a: ys }, H { a: zs }];
	let h = hs[0];
	f(h.a, ys);
}
