// error: call process stores a reference rooted at storage into what its parameter c leads to, which may be outer, which storage does not outlive (§9.2)
// The same with the store made by a callee (§9.2).
struct Context { storage byte[>..]&, inputs (const byte[:])[>..]& }
fn key(storage byte[>..]&) const byte[:] {
	let b = storage.len;
	storage.push(65);
	return storage[b..];
}
fn put(inputs (const byte[:])[>..]&, s const byte[:]) { inputs.push(s); }
fn process(c Context&) { put(c.inputs, key(c.storage)); }
fn main() {
	var outer (const byte[:])[>..] = ["outer"];
	{
		var storage byte[>..] = [];
		var c = Context { storage: storage, inputs: outer };
		process(c);
	}
	print(outer[1]);
}
