// error: cannot call run, which shrinks pool while s is still used
struct S { pool int[>..]&, refs (int&)[>..] }
// A call between emptying the holder and shrinking the pool may fill the
// holder again (§5.1).
fn keep(s S&) { s.refs.push(s.pool[0]); }
fn run(s S&) {
	s.refs = [];
	keep(s);
	s.pool = [];
}
fn main() {
	var pool int[>..] = [1];
	var s = S { pool: pool, refs: [] };
	run(s);
	print(s.refs.len);
}
