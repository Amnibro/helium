// error: cannot call h: it shrinks G while s is still used, and s may refer into G
// An argument is still in use while the arguments after it run (§5.2).
var G int[>..<] = [1, 2, 3];
fn clear_g() int {
	G.clear();
	G.push(9);
	return 0;
}
fn show(s int[:], n int) { print(s); }
fn h(s int[:]) { show(s, clear_g()); }
fn main() { h(G[..]); }
