// error: cannot clear out while h is still used: a reference into it was stored there
// emit itself stored a view of out where it reads the view h keeps from
// (§5.1).
struct H { s const byte[:] }
fn emit(out byte[>..]&, words (const byte[:])[:]) {
	words[0] = out[..];
	var h = H { s: "" };
	h.s = words[0];
	out.clear();
	out.append("ZZZZZZZZ");
	print(h.s);
}
fn main() {
	var buf byte[>..] = [];
	buf.append("abc");
	var names (const byte[:])[>..] = [];
	names.push("x");
	emit(buf, names[..]);
}
