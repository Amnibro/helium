// error: cannot call mk, which grows y: the run appended to x is still under construction
// h.r may be a or b after its rebinding, so f may grow the array it is
// appending to (§1.3, §9.5).
struct Holder { r int[>..]& }
fn mk(y int[>..]&) int[>..] { for i in 100 { y.push(9); } return [1, 2]; }
fn f(x int[>..]&, y int[>..]&) { x.append(mk(y)); }
fn main() {
	var a int[>..] = [1];
	var b int[>..] = [];
	var h = Holder { r: a };
	if a.len > 0 { h.r .= b; }
	f(b, h.r);
	print(a.len, b.len);
}
