// error: a long-distance return may only carry references to globals or static data
// A long-distance return of a holder may not carry references into the
// frames it unwinds.
struct Holder { value int& }
fn inner() int {
	var local int[>..] = [];
	local.push(42);
	return Holder { value: local[0] } from outer;
}
fn outer() Holder {
	inner();
	abort("unreachable");
}
fn main() {
	let h = outer();
	print(h.value);
}
