// error: cannot pop pp.y while s
// A pop through a reference that the parameter's pointee holds frees an
// array the argument's root only bounds (§5.2, §9.2): the error names the
// array s views.
struct P { y int[>..<]& }
fn f(pp P&, s int[:]) {
	pp.y.pop();
	pp.y.push(9);
	print(s);
}
fn main() {
	var a int[>..<] = [1, 2, 3];
	var p = P { a };
	f(p, a[..]);
}
