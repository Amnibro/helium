// error: cannot clear items while n is still used: it may hold a reference or slice into it; it was read out of h and may point into buf or items
// The nested add stores a view of items into h beside the view of buf it
// held (§5.1, §9.5).
var items byte[>..];
fn main() {
	items.append("abcd");
	var buf byte[..8] = "xy";
	var h const byte[:][>..] = [buf[..]];
	fn add() { h.push(items[0..2]); }
	add();
	let n = h[1];
	items.clear();
	items.append("ZZZZ");
	print(n);
}
