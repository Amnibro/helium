// error: cannot call f: it shrinks buf while p is still used, and p may refer into buf
// g clears f's out and reads f's holder parameter: g's pair passes through
// f to main (§5.1).
struct P { words (const byte[:])[:] }
fn f(out byte[>..]&, p P) {
	fn g() {
		out.clear();
		out.append("ZZZZZZZZ");
		print(p.words[0]);
	}
	g();
}
fn main() {
	var buf byte[>..] = [];
	buf.append("abc");
	var names (const byte[:])[>..] = [];
	names.push(buf[..]);
	f(buf, P { words: names[..] });
}
