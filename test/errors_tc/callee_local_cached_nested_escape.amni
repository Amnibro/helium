// error: storing a reference rooted at text, which does not outlive the destination
import std;
struct Holder {text const byte[:]}
fn main() {
	var data byte[>..]=[];data.append("kept");var holder=Holder {text:""};
	fn store(text const byte[:]) {var local=Holder {text:text};holder.text=local.text;}
	store(data[..]);
	fn deep() {store(str(7));}
	deep();print(holder.text);
}
