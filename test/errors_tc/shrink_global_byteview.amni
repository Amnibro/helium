// error: cannot clear bs: global G may hold a reference into it
// A byte view of the array's elements.
struct B { name byte[..8] }
struct H { s const byte[:] }
var bs B[>..] = [];
var cs B[>..] = [];
var G = H { s: "" };
fn reload() { bs.clear(); }
fn later() { G.s = bytes_of(bs); }
fn main() {
	bs.push(B { name: "a" });
	cs.push(B { name: "c" });
	reload();
	bs.push(B { name: "a" });
	later();
	reload();
	bs.push(B { name: "zz" });
	print(G.s.len);
}
