// error: cannot call replace, which shrinks rows: rows[0][..], evaluated earlier in the statement
// error: may still refer into rows
fn main() {
	var rows int[2][>..<] = [[1, 2]];
	var other int[2] = [1, 2];
	fn replace() int[:] {
		rows.pop();
		rows.push([7, 8]);
		return other[..];
	}
	print(rows[0] == replace());
}
