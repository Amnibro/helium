// error: cannot clear out while words is still used: the slices it views may point into it
// f itself stores a view of out into the elements words views (§5.1).
fn f(out byte[>..]&, words (const byte[:])[:]) {
	words[0] = out[..];
	out.clear();
	out.append("ZZZZZZZZ");
	print(words[0]);
}
fn main() {
	var buf byte[>..] = [];
	buf.append("abc");
	var names (const byte[:])[>..] = [];
	names.push("x");
	f(buf, names[..]);
}
