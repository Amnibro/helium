// The checker goes on past an error to the next root
//: the globals' initializers, main,
// the thread entry points, the functions nothing reached, and the exports,
// in that order. An error ends its root: main's second error, after the
// call of helper, goes unreported, as does unreached_a's, whose call of
// helper would reuse the specialization main's error cut short.
let g int = "not a number";

fn helper(x int) int {
	let bad bool = x;
	x
}

fn fine(x int) int { x * 2 }

fn unreached_a() int {
	let y = helper(1);
	let z int = true;
	y + z
}

fn unreached_b() int {
	let y = fine(1);
	y.nope
}

fn unreached_c() int {
	let s int = "str";
	s
}

thread_fn worker(n: int) {
	print(n + true);
}

export fn exported(a int) int {
	a + "x"
}

fn main() {
	let a = fine(2);
	let b = helper(a);
	let c bool = a;
	print(a + b + g);
}
