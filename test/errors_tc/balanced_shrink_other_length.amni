// error: cannot call helper, which shrinks s while v
// error: is still used: it may refer into s
// A mark is the length of the array it resizes (§5.2), not of another one.
fn helper(s int[>..<]&, t int[>..<]&) {
	let mark = t.len;
	s.push(4);
	s.resize(mark);
}
fn main() {
	var s int[>..<] = [9, 8];
	var t int[>..<] = [];
	let v = s[..];
	helper(s, t);
	print(v[1]);
}
