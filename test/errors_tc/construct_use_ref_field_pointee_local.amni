// error: cannot use d.own in the value assigned to d.r
// The same on a local whose reference field was bound to its own tail (§4.4).
fn twice(xs const byte[:]) byte[>..<] {
	var r byte[>..<] = [];
	r.append(xs);
	r.append(xs);
	return r;
}
struct D { n int, r byte[>..<]&, own byte[>..<] }
fn main() {
	var x byte[>..<] = [];
	var d = D { n: 0, r: x, own: [1, 2, 3] };
	d.r .= d.own;
	d.r = twice(d.own);
	print(d.own);
}
