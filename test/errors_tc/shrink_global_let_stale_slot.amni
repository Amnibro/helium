// error: cannot clear bs: global P may hold a reference into it, stored at
// aim writes a view of bs's element into pick's s through a reference to
// its slot, which assigns s (§3.8): P, bound for good to pick's result,
// views bs (§5.1).
struct B { name byte[..8] }
var arr byte[4] = [1, 2, 3, 4];
var bs B[>..] = [B { name: "a" }];
fn aim(r byte[:]&, v byte[:]) { r = v; }
fn pick() const byte[:] {
	var s byte[:] = arr[..];
	aim(s, bs[0].name[..]);
	return s;
}
let P const byte[:] = pick();
fn main() {
	bs.clear();
	bs.push(B { name: "zz" });
	print(P);
}
