// error: storing a read-only slice of type u8[:] (read-only in this instantiation) in a slot of type u8[:]
// A slice loaded through a reference to a slice variable holding a read-only
// slice is read-only (§9.5): in the callee, for this instantiation. The
// parameter is that variable: an un-annotated copy of it would be typed const.
var buf byte[>..] = [];
fn take(p byte[:]&, q byte[:]&) { q = p; }
fn text(s byte[:]) {
	var y = buf[..];
	take(s, y);
}
fn main() {
	buf.append("xyz");
	text("abc");
}
