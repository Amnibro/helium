// error: cannot call f: it shrinks buf while words is still used, and words may refer into buf
// The block f hands each clears out, and each reads words after running
// it (§5.1).
fn each<F>(out byte[>..]&, words (const byte[:])[:]) {
	F();
	print(words[0]);
}
fn f(out byte[>..]&, words (const byte[:])[:]) {
	each(out, words) {
		out.clear();
		out.append("ZZZZZZZZ");
	};
}
fn main() {
	var buf byte[>..] = [];
	buf.append("abc");
	var names (const byte[:])[>..] = [];
	names.push(buf[..]);
	f(buf, names[..]);
}
