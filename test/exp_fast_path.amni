import std;
import os;
import math;
import binary;
fn main() {
	var s uint = 0x9E3779B97F4A7C15 + args().len as uint;
	var o byte[>..] = [];
	for blk in 6 {
		var h uint = 1469598103934665603;
		for i in 20000 {
			s ^= s << 13; s ^= s >> 7; s ^= s << 17;
			let u = (s >> 11) as! i64 as real * 1.1102230246251565e-16;
			let m = blk % 6;
			let x = if m == 0 { u * 1417.0 - 708.0 } else if m == 1 { (u - 0.5) * 2.0e-5 } else if m == 2 { floor(u * 260000.0 - 130000.0) * 0.005415212348111709 + (u - 0.5) * 1e-12 } else if m == 3 { binary::f64_from_bits(s) } else if m == 4 { (u - 0.5) * 40.0 } else { (u - 0.5) * 1.0e-300 };
			h = (h ^ binary::f64_bits(exp(x))) * 1099511628211;
		}
		format(o, blk, " ", h, "\n");
	}
	print(o);
}
