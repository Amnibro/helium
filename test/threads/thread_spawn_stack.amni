// A function that only spawns still assembles the argument packet on a data
// stack of its own, not on its caller's.
thread_fn worker(a: int) { print(a); }
fn spawn_one(a int) {
	thread_wait(thread_spawn(worker, a));
}
fn main() {
	var s byte[>..] = [];
	s.push('x');
	spawn_one(5);
	s.push('y');
	print(s);
}
