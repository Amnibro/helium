struct Copies { first int[], second int }
fn use(xs int[], n int) { print(xs, " ", n); }
fn copies(xs int[>..<]&) int[], int { return copy(xs), xs.pop(); }
fn main() {
	var xs int[>..<] = [41, 42];
	use(copy(xs), xs.pop());
	print(Copies { copy(xs), xs.pop() });
	xs.push(43);
	let a, n = copies(xs);
	print(a, " ", n);
}
