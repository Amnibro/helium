struct Holder { bytes const byte[:] }
fn bytes(a int[>..]&) const byte[:] {
	let h = Holder { a.bytes_of() };
	return h.bytes;
}
fn main() {
	var a int[>..] = [42];
	let b = bytes(a);
	print(b.len);
	a.clear();
	a.push(7);
	let h = Holder { a.bytes_of() };
	let c = h;
	print(c.bytes.len);
	a.clear();
	var s int[>..<] = [1, 2];
	let v = if a.len == 0 { s.bytes_of() } else { s.bytes_of() };
	print(v.len);
	s.clear();
	print(a.len, " ", s.len);
}
