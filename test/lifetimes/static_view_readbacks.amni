// Views of static data stay static data through call results and through
// the arrays that hold only them, so a shrink of a global array whose
// elements could hold the bytes leaves them alone (§5.1).
import std;

struct Item { pos i32, id byte }
var items Item[>..];
var label const byte[:] = "";
var labels (const byte[:])[>..];

fn reset() {
	items.clear();
	items.push(Item { pos: 1, id: 2 });
}

fn rebuild_and_use(name byte[:]) {
	reset();
	print(name);
}

fn why(x int) const byte[:] {
	if x > 0 { return "pos"; }
	return "neg";
}

fn none() const byte[:] { "" }

fn names() const byte[:][>..] {
	var out const byte[:][>..] = [];
	out.push("ab");
	out.push(why(-1));
	return out;
}

fn main() {
	items.push(Item { pos: 0, id: 1 });
	let w = words("save test.sav");
	rebuild_and_use(w[1]);
	let m = why(3);
	reset();
	print(m);
	let parts = split("a,b", ',');
	let p = parts[1];
	reset();
	print(p);
	var h const byte[:][>..] = ["x"];
	h.push(why(0));
	let n = h[1];
	reset();
	print(n);
	let ns = names();
	let q = ns[1];
	reset();
	print(q);
	let e = none();
	reset();
	print(e.len);
	label = why(1);
	labels.push(why(2));
	reset();
	print(label);
	print(labels[0]);
	print(items.len);
}
