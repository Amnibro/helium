// A view read back out of a by-value parameter -- directly, out of a local
// copy, out of a matched payload or a `for` binder, or out of a local array
// filled from a parameter's elements -- is bounded by the parameter's class,
// so it is returned to callers whose storage outlives it; one of a pointee
// no literal supplies is not rooted at the callee's local copy either (§9.5).
struct W { s const byte[:] }
struct N { xs int[:] }
enum E { Txt { s const byte[:] }, Nothing { k int } }

fn get(w W) const byte[:] { w.s }
fn getcopy(w W) const byte[:] { let w2 = w; w2.s }
fn getn(n N) int[:] { let n2 = n; n2.xs }
fn txt(e E) const byte[:] { match e { Txt t => t.s, Nothing n => "-" } }
fn firstof(ws W[:]) const byte[:] {
	for w in ws { if w.s.len > 3 { return w.s; } }
	ws[0].s
}
fn first(words const byte[:][:]) const byte[:] {
	var parts const byte[:][>..] = [];
	parts.push(words[0]);
	parts[0]
}

fn main() {
	var y byte[>..] = [];
	for i in 5 { y.push('a' + i as byte); }
	let w = W { s: y[..] };
	var a int[>..] = [7, 8];
	var ws const byte[:][>..] = [];
	ws.push(y[1..]);
	var hs W[>..] = [];
	hs.push(W { s: y[3..] });
	hs.push(w);
	let s = get(w);
	let c = getcopy(w);
	let n = N { xs: a[..] };
	let xs = getn(n);
	xs[0] = 9;
	print(s, " ", c, " ", a[0], " ", firstof(hs), " ", first(ws));
	print(txt(E.Txt { s: y[2..] }), " ", txt(E.Nothing { k: 1 }), " ", get(W { s: "lit" }));
}
