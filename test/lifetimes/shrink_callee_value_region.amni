// A callee first checked inside a function value's body, in the middle of
// the caller's expression, shrinks its own local freely: nothing of that
// expression can refer into it.
fn scratch() int {
	var buf int[>..] = [1, 2];
	buf.clear();
	return buf.len;
}
fn run<F>() int { return F(); }
fn main() {
	let v = run() { scratch() };
	let w = scratch();
	print(v, " ", w);
}
