# first .he program
use std
struct Point { x int, y int }
square(n int) int: n * n
grade(s int) byte[]:
	if s >= 90: return "A"
	if s >= 80:
		return "B"
	else: return "C"
main():
	total ~= 0
	for i 10: total += square(i)
	p := Point{3, 4}
	print(total, " ", p.x + p.y, " ", grade(95), grade(85), grade(10))
	xs int[>..] ~= [1, 2, 3]
	xs.push(4)
	for x xs:
		if x % 2 == 0: print("even ", x)
		else: print("odd ", x)
	match xs.len:
		4 => print("four")
		_ => print("other")
