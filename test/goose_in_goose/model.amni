// Clean-room compiler model. No compiler sources in src/ are used.
// All long-lived storage is append-only. Indices keep nodes freely mutable
// and let one node occur in several lists without intrusive sibling links.
struct Source {
	path const byte[:],
	text const byte[:],
	first int = 0,
	limit int = 0,
	visited int = 0,
}

struct Token {
	kind int,
	text const byte[:],
	file int,
	offset int,
	line int,
	column int,
	integer uint = 0,
}

// Tags are named constants so debugging a node never requires a payload
// reference into a mutable fixed-mode ADT.
const N_NAME = 1;
const N_INT = 2;
const N_FLOAT = 3;
const N_STRING = 4;
const N_BOOL = 5;
const N_NULL = 6;
const N_UNARY = 7;
const N_BINARY = 8;
const N_CALL = 9;
const N_MEMBER = 10;
const N_INDEX = 11;
const N_SLICE = 12;
const N_CAST = 13;
const N_ARRAY = 14;
const N_FILL = 15;
const N_LIMITED = 16;
const N_CONSTRUCT = 17;
const N_INIT = 18;
const N_BLOCK = 19;
const N_IF = 20;
const N_WHILE = 21;
const N_FOR = 22;
const N_LOOP = 23;
const N_EARLY = 24;
const N_RETURN = 25;
const N_BREAK = 26;
const N_CONTINUE = 27;
const N_MATCH = 29;
const N_ARM = 30;
const N_BIND = 31;
const N_ASSIGN = 32;
const N_FUNCTION = 33;
const N_PARAM = 34;
const N_STRUCT = 35;
const N_ENUM = 36;
const N_VARIANT = 37;
const N_FIELD = 38;
const N_ALIAS = 39;
const N_IMPORT = 40;
const N_TYPE = 41;
const N_TYPE_ARRAY = 42;
const N_TYPE_REF = 43;
const N_TYPE_SLICE = 44;
const N_TYPE_OPTIONAL = 45;
const N_TYPE_MODE = 46;
const N_TYPE_MEMBER = 47;
const N_GENERIC = 48;
const N_FUNVAL = 49;
const N_EXPR_STMT = 50;
const N_RANGE = 51;
const N_PAD = 52;
const N_SELF = 53;

struct Node {
	tag int,
	token int,
	a int = -1,
	b int = -1,
	c int = -1,
	first int = -1,
	last int = -1,
	flags int = 0,
	ty int = -1,
	symbol int = -1,
	ns int = -1,
	target int = -1,
	root int = -1,
	place int = -1,
	readonly bool = false,
	growshrink bool = false,
	inexact bool = false,
	known bool = false,
	bits uint = 0,
	held int = -1,
	fields int = -1,
	standalone bool = false,
}
struct Edge { value int, next int = -1 }


fn node(ctx Compiler&, tag int, token int) int {
	let id = ctx.nodes.len;
	ctx.nodes.push(Node { tag: tag, token: token, ns: ctx.current_namespace });
	return id;
}
fn child(ctx Compiler&, parent int, value int) {
	let e = ctx.edges.len;
	ctx.edges.push(Edge { value: value });
	if ctx.nodes[parent].last >= 0 { ctx.edges[ctx.nodes[parent].last].next = e; }
	else { ctx.nodes[parent].first = e; }
	ctx.nodes[parent].last = e;
}
fn own_text(ctx Compiler&, s const byte[:]) const byte[:] {
	let begin = ctx.text_storage.len;
	ctx.text_storage.append(s);
	return ctx.text_storage[begin..];
}
fn diagnostic(ctx Compiler&, file int, line int, column int, message const byte[:]) {
	write_stderr(str(ctx.sources[file].path, ":", line, ":", column, ": error: ", message, "\n"));
	exit(1);
}
fn error_at(ctx Compiler&, t int, message const byte[:]) {
	diagnostic(ctx, ctx.tokens[t].file, ctx.tokens[t].line, ctx.tokens[t].column, message);
}
