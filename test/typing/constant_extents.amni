// Compile-time extents use the same widths and signedness as runtime arithmetic.
let MAX byte = 255;
let ONE byte = 1;
let WORD uint = 18446744073709551615;
struct Data { value int[WORD >> 63] }

fn main() {
	let high int[18446744073709551615 >> 63] = [7];
	let quotient int[18446744073709551615 / 9223372036854775808] = [8];
	let wrapped int[MAX + 1] = [];
	let shifted int[ONE << 8] = [9];
	let inverted int[~MAX] = [];
	let remainder int[-9223372036854775808 % -1] = [];
	let data = Data { [10] };
	print(high, quotient, wrapped.len, shifted, inverted.len, remainder.len, data);
}
