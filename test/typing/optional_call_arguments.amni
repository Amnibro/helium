// A callee's rebinds take effect after the call's arguments are evaluated,
// for ordinary and case-function calls alike.
enum Choice { A, B }
var n = 41;
var g int? = null;
fn use(c Choice.A, b int) { g .= null; print(b); }
fn use(c Choice.B, b int) { print(b); }
fn plain(b int) { g .= null; print(b); }
fn main() {
	g .= n;
	var c Choice = Choice.A {};
	use(c, g + 1);
	g .= n;
	plain(g + 1);
}
