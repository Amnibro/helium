// A valued break constructs into the type its construct is expected to have,
// as the construct's tail value does.
fn main() {
	var xs int[>..<] = [1, 2];
	xs = block { break [7, 8, 9]; };
	print(xs);
	var zs int[>..] = [1];
	zs = loop { break [4, 5]; };
	zs.push(6);
	print(zs);
	var a int[>..] = block { break []; };
	a.push(3);
	print(a);
	let small byte = block { if zs.len > 0 { break 7; } 9 };
	print(small);
}
