// A back edge is given only what the returns checked or predicted before it
// guarantee. Where neither pins its result down, the returns checked after it
// may differ in writability or exactness.

// Overloading id keeps the prediction from resolving pick's returns.
fn id(x int&) int& { return x; }
fn id(x byte&) byte& { return x; }
recursive fn pick(r int&, d int) int& {
	if d > 0 { let v = pick(r, d - 1); print(v); }
	if d > 1 { return id(r); }
	let c const int& = r;
	return c;
}

// A holder result's first return stands in for its prediction, and the back
// edge comes before it: an exact holder, then one read back out of the
// container.
struct H { value int&, k int }
recursive fn walk(hs H[>..]&, d int) H {
	if d > 0 { let x = walk(hs, d - 1); print(x.k); }
	if d > 1 { return H { value: hs[0].k, k: 1 }; }
	return hs[1];
}

fn main() {
	var n = 1;
	let x = pick(n, 3);
	print(x);
	var g = 7;
	var hs H[>..] = [];
	hs.push(H { value: g, k: 10 });
	hs.push(H { value: g, k: 20 });
	let h = walk(hs, 3);
	print(h.value);
	print(h.k);
}
