// Long-distance returns through recursion cycles that another function
// reaches with a cached call before the `return ... from` is checked.

// other reuses mid, which reaches g's target through its back edge into walk.
fn g(n int) int {
	walk(n);
	print("g normal exit");
	return 1;
}
recursive fn walk(n int) {
	if n < 0 { return; }
	if n > 1 {
		mid(n);
		return;
	}
	if n == 1 {
		other(n);
		print("walk after other");
		return;
	}
	return 42 from g;
}
recursive fn mid(n int) {
	walk(n - 1);
	print("mid after walk");
}
recursive fn other(n int) {
	mid(n);
	print("other after mid");
}

// Recursive descent: unary reuses factor before fail's return is checked.
fn parse(n int) int {
	expr(n);
	return 0;
}
recursive fn expr(n int) {
	if n == 3 { return; }
	if n >= 0 {
		term(n);
		unary(n);
		return;
	}
	fail();
}
recursive fn term(n int) { if n > 5 { factor(n); } }
recursive fn factor(n int) { expr(n - 1); }
recursive fn unary(n int) { factor(n); }
fn fail() { return -1 from parse; }

fn main() {
	print(g(2));
	print(g(-1));
	print(parse(2));
	print(parse(7));
}
