import std;
import os;
import binary;
import libm;
fn hx(t const byte[:]) u32 { var v u32 = 0; for c in t { v = v << 4 | (if c >= 'a' { c - 'a' + 10 } else { c - '0' }) as u32; } v }
fn fb(u u32) f32 { binary::f32_from_bits(u) }
fn bf(f f32) u32 { binary::f32_bits(f) }
fn main() {
	var txt byte[>..] = [];
	read_stdin(txt);
	let ks = "atsc Sh";
	var tot int[>..] = [0, 0, 0, 0, 0, 0, 0];
	var ok int[>..] = [0, 0, 0, 0, 0, 0, 0];
	var shown = 0;
	var out byte[>..] = [];
	for l in split(txt[..], '\n') {
		if l.len < 10 { continue; }
		let w = split(l, ' ');
		let x = fb(hx(w[1]));
		let y = fb(hx(w[2]));
		let k = w[0][0];
		var r1 f32 = 0.0;
		var r2 f32 = 0.0;
		if k == 'a' { r1 = libm::atan2f(y, x); } else if k == 't' { r1 = libm::atanf(x); } else if k == 's' { r1 = libm::sinf(x); } else if k == 'c' { r1 = libm::cosf(x); } else if k == 'S' { r1, r2 = libm::sincosf(x); } else { r1 = libm::hypotf(x, y); }
		var ki = 0;
		for i in ks.len { if ks[i] == k { ki = i; } }
		tot[ki] += 1;
		let good = bf(r1) == hx(w[3]) && bf(r2) == hx(w[4]);
		if good { ok[ki] += 1; } else if shown < 12 { shown++; format(out, "MISS ", l, " got "); out.append(hex(bf(r1) as int)[..]); out.push(32); out.append(hex(bf(r2) as int)[..]); out.push('\n'); }
	}
	var all = 0;
	var n = 0;
	for i in ks.len { if ks[i] != ' ' { format(out, ks[i..i + 1], ":", ok[i], "/", tot[i], " "); all += ok[i]; n += tot[i]; } }
	format(out, "| libm ", all, "/", n, "\n");
	write_stdout(out[..]);
}
