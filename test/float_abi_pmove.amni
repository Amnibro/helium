import std;
import os;
import binary;
fn rot(a real, b real, c real, d real, e real, f real, g real, h real, n int) real { if n == 0 { a + 2.0 * b + 3.0 * c + 4.0 * d + 5.0 * e + 6.0 * f + 7.0 * g + 8.0 * h } else { rot(b, c, d, e, f, g, h, a * 1.0001, n - 1) } }
fn swp(a real, b real, c real, d real, n int) real { if n == 0 { a - b * 2.0 + c * 3.0 - d * 4.0 } else { swp(b, a, d, c + 0.5, n - 1) } }
fn nine(k int, a real, b real, c real, d real, e real, f real, g real, h real, i real, m int) real { (k as real) * a + b - c * d + e / (f + 3.0) + g * h - i + (m as real) }
fn f4(a f32, b f32, c f32, d f32, e f32) f32 { a * b + c - d * e }
fn mixr(x real, y real) real { let p = nine(1, x, y, x * y, y - x, x + 1.0, y + 2.0, x * 0.5, y * 0.25, x - y, 7); let q = nine(2, y, x, p, x, y, p, x, y, p, 3); p * 0.5 + q * 0.25 + swp(x, y, p, q, 5) }
fn main() {
	let z = args().len as real;
	var acc = 0.0;
	var h u64 = 0;
	for i in 400 {
		let x = i as real * 0.11 - z; let y = x * 0.7 + 1.0;
		acc += rot(x, y, x * 2.0, y * 3.0, 1.0, 2.0, x - y, y - x, i % 17) + mixr(x, y);
		h = h * 1000003 + binary::f64_bits(acc) + binary::f32_bits(f4(x as f32, y as f32, 0.5, x as f32, 1.5)) as u64;
	}
	var o byte[>..] = [];
	format(o, h, " ", acc, "\n");
	print(o);
}
