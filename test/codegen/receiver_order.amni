// A member operation's receiver is evaluated before its arguments, even when
// they rebind the reference naming it or one it is reached through.
struct Holder { id int, lim int[..4] }
struct Bag { tag int, items int[>..] }
struct Text { id int, buf byte[>..] }
// No i64 outside its items, so a reference to one rooted at a Row is an item.
struct Row { tag byte, items int[>..] }
fn format(out byte[>..]&, h Holder) { format(out, "H", h.id); }
var fa int[4] = [1, 2, 3, 4];
var fb int[4] = [5, 6, 7, 8];
var ba = Row { tag: 1, items: [10, 20, 30, 40] };
var bb = Row { tag: 2, items: [50] };
fn main() {
	var a int[>..] = [1];
	var b int[>..] = [2];
	var r .= a;
	fn change() int[>..] { r .= b; return [8, 9]; }
	r.append(change());
	print(a, " ", b);
	var c int[>..] = [1];
	var d int[>..] = [2];
	var q .= c;
	fn change_push() int { q .= d; return 9; }
	q.push(change_push());
	print(c, " ", d);
	var e byte[>..] = [];
	var f byte[>..] = [];
	var t .= e;
	fn change_format() int { t .= f; return 9; }
	t.format(change_format());
	print(e.len, " ", f.len);
	var g int[>..<] = [1];
	var h int[>..<] = [2];
	var u .= g;
	fn change_resize() int { u .= h; return 3; }
	u.resize(change_resize(), 0);
	print(g, " ", h);
	var w .= fa;
	fn elem() int& { w .= fb; return fa[2]; }
	print(w.index_of(elem()));
	var h1 = Holder { id: 1, lim: [1] };
	var h2 = Holder { id: 2, lim: [2, 3, 4] };
	var hr .= h1;
	fn change_field() int { hr .= h2; return 9; }
	hr.lim.push(change_field());
	print(h1.lim, " ", h2.lim);
	var m1 int[..4][2] = [[1], [2]];
	var m2 int[..4][2] = [[5, 6, 7], [8]];
	var mr .= m1;
	fn change_element() int { mr .= m2; return 9; }
	mr[0].push(change_element());
	print(m1[0], " ", m2[0]);
	var bag_a = Bag { tag: 1, items: [1] };
	var bag_b = Bag { tag: 2, items: [2] };
	var br .= bag_a;
	fn change_tail() int[>..] { br .= bag_b; return [8, 9]; }
	br.items.append(change_tail());
	bag_a.items.push(5);
	bag_b.items.push(6);
	print(bag_a.items, " ", bag_b.items);
	var gr .= ba;
	fn tail_elem() int& { gr .= bb; return ba.items[3]; }
	print(gr.items.index_of(tail_elem()));
	var text_a = Text { id: 1, buf: [] };
	var text_b = Text { id: 2, buf: [] };
	var tr .= text_a;
	fn change_text() Holder { tr .= text_b; return Holder { id: 7, lim: [1] }; }
	tr.buf.format(change_text());
	print(text_a.buf, " ", text_b.buf.len);
}
