// runtime-debug: copy(x) passed where a slice is expected is a fresh copy of
// x (§4.1, §4.2), sliced whole (§3.10). The callee's view keeps the value x
// had when the argument was evaluated, whatever happens to x after: the
// callee writing it, a later argument writing it, or x, an element, popped
// and its slot pushed over. Through each call form, from fixed, limited,
// variable and resizable arrays.
struct Holder { arr int[3] }
enum Shape { Circle { r int }, Point { k int } }

var g int[3] = [1, 2, 3];
var h = Holder { arr: [4, 5, 6] };
var lim int[..4] = [7, 8];
var text byte[] = "abc";
var word byte[>..] = "hey";
var rows int[3][>..<] = [[1, 2, 3], [4, 5, 6]];
var letter byte[>..] = "a";
var spelled byte[>..] = "";

// Each writes its argument's source, then reads the argument.
fn head(s const int[:]) int { g[0] = 0; s[0] }
fn second<T>(s const T[:]) T { g[1] = 0; s[1] }
fn third(c Shape.Circle, s const int[:]) int { g[2] = 0; s[2] + c.r }
fn third(p Shape.Point, s const int[:]) int { g[2] = 0; s[2] * p.k }
fn apply<F>(n int) int { F(copy(g)) + n }
fn pointee(r int[3]&) int { head(copy(r)) }
fn field(s const int[:]) int { h.arr[0] = 0; s[0] }
fn limited(s const int[:]) int { lim[0] = 0; s[0] }
fn variable(s const byte[:]) const byte[:] { text[0] = '-'; s }
fn resizable(s const byte[:]) const byte[:] { word[0] = '-'; word.push('!'); s }
fn popped(s const int[:]) int { rows.pop(); rows.push([0, 0, 0]); s[0] }
fn plus(s const int[:], n int) int { s[0] + n }
fn clobber() int { g[0] = 100; 0 }

// Allocates over whatever a released temporary left behind; returns 0.
fn churn() int {
	var fill byte[>..] = "????????????????????????????????";
	fill.len - 32
}

// At -O1 and above the self-call's base case is inlined in its place, with
// the argument bound in front of it. The copy the next level reads is made
// in scratch owned outside the cycle, since no temporary may be live at a
// call into it (§7.8), and released after the call.
recursive fn spell(s const byte[:], n int, scratch byte[>..<]&) {
	if n == 0 { return; }
	letter[0] = letter[0] + 1;
	let k = churn();
	spelled.push(s[0] + k as byte);
	let mark = scratch.len;
	scratch.append(letter);
	spell(scratch[mark..], n - 1, scratch);
	scratch.resize(mark);
}

fn main() {
	print(head(copy(g)), " ", g[0]);
	g = [1, 2, 3];
	print(copy(g).head(), " ", g[0]);
	g = [1, 2, 3];
	print(second(copy(g)), " ", g[1]);
	g = [1, 2, 3];
	let c Shape = Shape.Circle { r: 10 };
	print(third(c, copy(g)), " ", g[2]);
	g = [1, 2, 3];
	print(apply(0, head), " ", g[0]);
	g = [1, 2, 3];
	print(pointee(g), " ", g[0]);
	g = [1, 2, 3];
	// The later argument runs after the copy is taken: the plain argument
	// sees what it wrote, the copy does not.
	print(plus(copy(g), clobber()), " ", g[0]);
	g = [1, 2, 3];
	print(plus(g, clobber()), " ", g[0]);
	print(field(copy(h.arr)), " ", h.arr[0]);
	print(limited(copy(lim)), " ", lim[0]);
	print(variable(copy(text)), " ", text);
	print(resizable(copy(word)), " ", word);
	print(popped(copy(rows[1])), " ", rows[1][0]);
	var scratch byte[>..<] = [];
	spell(copy(letter), 3, scratch);
	print(spelled, " ", letter);
}
