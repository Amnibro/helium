// runtime-debug: a call's array result passed straight to a slice parameter
// (§3.10) is a temporary of the caller's statement, sliced whole -- also when
// both calls are inlined, where the result has to be built outside the body
// producing it to outlive that body and the slice's uses. Each consumer grows
// a scratch array before it reads its slice, over the storage an argument
// released too early would have left behind. Resizable results of u8, i32,
// struct and variable-size elements, nested, in loops, in every shape a
// callee can return them in and from recursive calls; then fixed, limited
// and variable arrays and references to arrays.
struct Pt { x i32, y i32 }

fn scratch() byte[>..] {
	var s byte[>..] = [];
	for i in 64 { s.push(0xEE); }
	return s;
}

fn bytes(n int) byte[>..] {
	var a byte[>..] = [];
	for i in n { a.push((i + 1) as byte); }
	return a;
}
fn ints(n int) i32[>..] {
	var a i32[>..] = [];
	for i in n { a.push((i * 10 + 1) as i32); }
	return a;
}
fn points(n int) Pt[>..] {
	var a Pt[>..] = [];
	for i in n { a.push(Pt { x: i as i32, y: (i * i) as i32 }); }
	return a;
}
fn words() byte[][>..] {
	var a byte[][>..] = [];
	a.push("helium");
	a.push("gander");
	return a;
}
fn literal() byte[>..] { return [7, 8, 9]; }
fn branch(n int) byte[>..] { if n > 1 { [1, 2] } else { [3] } }
fn early(n int) byte[>..] {
	var a byte[>..] = [];
	if n == 0 { return a; }
	for i in n { a.push(i as byte); }
	return a;
}
fn doubled(data const byte[:]) byte[>..] {
	var out byte[>..] = [];
	for x in data { out.push(x); out.push(x); }
	return out;
}
fn fixed(x byte) byte[3] {
	var a byte[3] = [1, 2, 3];
	a[0] = x;
	return a;
}
fn limited(n int) byte[..8] {
	var a byte[..8] = [];
	for i in n { a.push((i + 1) as byte); }
	return a;
}
fn variable(n int) byte[] {
	var a byte[>..] = [];
	for i in n { a.push((i + 1) as byte); }
	return a;
}
fn pick_fixed(a byte[3]&) byte[3]& { a }
fn pick_grown(a byte[>..]&) byte[>..]& { a }

// The elements' sum and the count, read after the scratch array exists.
fn sum(data const byte[:]) int {
	let s = scratch();
	var t = 0;
	for x in data { t += x; }
	t * 100 + data.len
}
fn sum_ints(data const i32[:]) int {
	let s = scratch();
	var t = 0;
	for x in data { t += x; }
	t * 100 + data.len
}
fn sum_points(ps const Pt[:]) int {
	let s = scratch();
	var t = 0;
	for p in ps { t += p.x * 10 + p.y; }
	t * 100 + ps.len
}
fn letters(ws const byte[][:]) int {
	let s = scratch();
	var t = 0;
	for w in ws { t = t * 10 + w.len; }
	t
}
fn pair(a const byte[:], b const byte[:]) int {
	let s = scratch();
	sum(a) * 10000 + sum(b)
}
fn ident(data const byte[:]) const byte[:] { data }

// Arguments bound inside a body that is itself inlined into a loop.
fn shapes(n int) int {
	var t = 0;
	for i in n { t += sum(branch(i)) + sum(early(i)); }
	t
}

// Self-calls with a base case the optimizer could copy to the call site.
recursive fn depth_fixed(n int) byte[3] {
	if n == 0 { return [1, 2, 3]; }
	var r byte[3] = [0, 0, 0];
	r[0] = (sum(depth_fixed(n - 1)) % 251) as byte;
	return r;
}
// A resizable result of a self-call would need a temporary of its own,
// held across the call (§7.8): the levels build in a buffer owned outside
// the cycle instead, each reducing what the level below left.
recursive fn depth_grown(out byte[>..<]&, n int) {
	if n == 0 { out.append([4, 5]); return; }
	let mark = out.len;
	depth_grown(out, n - 1);
	let reduced = (sum(out[mark..]) % 251) as byte;
	out.resize(mark);
	out.push(reduced);
}

fn main() {
	print(sum(bytes(3)));                   // 603
	print(sum_ints(ints(4)));               // 6404
	print(sum_points(points(3)));           // 3503
	print(letters(words()));                // 56
	print(sum(literal()));                  // 2403
	print(sum(doubled(bytes(3))));          // 1206
	print(sum(doubled(doubled(bytes(2))))); // 1208
	print(pair(bytes(2), bytes(3)));        // 3020603
	print(ident(bytes(5)).len);             // 5
	print(ident(bytes(4))[3]);              // 4

	var total = 0;
	for i in 4 { total += pair(bytes(i), doubled(bytes(i))); }
	print(total);                           // 10062012
	var j = 0;
	var ti = 0;
	while j < 3 {
		ti += sum_ints(ints(j + 1));
		j++;
	}
	print(ti);                              // 4606
	print(shapes(4));                       // 1612
	print(sum(depth_fixed(3)));             // 2803
	var grown byte[>..<] = [];
	depth_grown(grown, 3);
	print(sum(grown));                      // 16501

	print(sum(fixed(10)));                  // 1503
	print(sum(limited(3)));                 // 603
	print(sum(variable(4)));                // 1004
	var f byte[3] = [4, 5, 6];
	var g byte[>..] = [7, 8];
	print(sum(pick_fixed(f)));              // 1503
	print(sum(pick_grown(g)));              // 1502
}
