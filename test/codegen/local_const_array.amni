import std;
import os;
fn sum(a const real[:]) real { var s = 0.0; for v in a { s += v; } s }
fn pick(i int) real {
	const T real[4] = [1.5, -2.25, 0.0, -0.0];
	const K int[3] = [7, -9, 1 << 40];
	fn F(j int) real { T[j & 3] * 2.0 }
	T[i & 3] + K[i % 3] as real + F(i + 1) + sum(T[..])
}
fn main() {
	let n = args().len;
	var o byte[>..] = [];
	var acc = 0.0;
	for i in 20 { acc += pick(i * n); }
	let M real[3] = [3.0, -1.0, 0.5];
	let W = [1.5, 2.5];
	W[0] = 5.0;
	M[2] = W[0] + W[1];
	var m = M;
	m[1] = 9.0;
	format(o, acc, " ", M[1], " ", m[1], " ", 1.0 / pick(3 + n), "\n");
	print(o);
}
