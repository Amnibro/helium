// Two fat-reference parameters with distinct root classes can still name one
// stack, reached through a caller's parameter or through a captured local.
// Two locals a recursion or a wrapper passes on stay two stacks, but a class
// passed on beside a global may be that global, two classes of a wrapper
// whose argument was only inexactly rooted may be one stack, and a class a
// function value captured may be the class of the function running it.
struct Bag { tag int, items int[>..] }
struct Outer { id int, bag Bag }
var global Outer = Outer { id: 1, bag: Bag { tag: 2, items: [] } };
recursive fn fill2(xs int[>..]&, b Bag&, n int) {
	if n > 0 { fill2(xs, b, n - 1); return; }
	xs.push(10);
	b.items.push(20);
	xs.push(30);
}
recursive fn caller(b Bag&, n int) {
	if n > 0 { caller(b, n - 1); return; }
	fill2(global.bag.items, b, 1);
}
var g1 int[>..] = [];
var g2 int[>..] = [];
var g3 int[>..] = [];
recursive fn twice(xs int[>..]&, ys int[>..]&, n int) {
	fn again(m int) { twice(xs, g1, m); }
	if n > 0 { again(n - 1); return; }
	xs.push(1);
	ys.push(2);
	xs.push(3);
}
recursive fn build(xs int[>..]&, ys int[>..]&, n int) {
	if n > 0 { build(xs, ys, n - 1); }
	xs.push(n);
	ys.push(n * 2);
	xs.push(n + 100);
}
fn wrap(xs int[>..]&, ys int[>..]&) { build(xs, ys, 1); }
recursive fn fill3(xs int[>..]&, ys int[>..]&, n int) {
	if n > 0 { fill3(xs, ys, n - 1); return; }
	xs.push(1);
	ys.push(2);
	xs.push(3);
}
fn pass3(xs int[>..]&, ys int[>..]&) { fill3(xs, ys, 1); }
recursive fn fill4(xs int[>..]&, ys int[>..]&, n int) {
	if n > 0 { fill4(xs, ys, n - 1); return; }
	xs.push(1);
	ys.push(2);
	xs.push(3);
}
fn pass4(xs int[>..]&, ys int[>..]&) { fill4(xs, ys, 1); }
recursive fn grow(xs int[>..]&, ys int[>..]&, n int) {
	if n > 0 { grow(xs, ys, n - 1); return; }
	for i in 3 { xs.push(i); ys.push(i * 10); }
}
fn times<F>(n int) { for i in n { F(i); } }
fn grow_each(xs int[>..]&, ys int[>..]&) { times(2) { i => grow(xs, ys, i) } }
recursive fn fill5(xs int[>..]&, ys int[>..]&, n int) {
	if n > 0 { fill5(xs, ys, n - 1); return; }
	xs.push(1);
	ys.push(2);
	xs.push(3);
}
fn apply1<F>(zs int[>..]&) { F(zs); }
fn beside(xs int[>..]&) { apply1(xs) { u => fill5(xs, u, 1) } }
fn main() {
	caller(global.bag, 1);
	print(global.bag.items);
	var o Outer = Outer { id: 1, bag: Bag { tag: 2, items: [] } };
	fn inner(b Bag&) { fill2(o.bag.items, b, 1); }
	inner(o.bag);
	print(o.bag.items);
	var a int[>..] = [];
	var c int[>..] = [];
	build(a, c, 2);
	print(a, " ", c);
	twice(g3, g1, 1);
	twice(g1, g2, 1);
	print(g1, " ", g2, " ", g3);
	var p int[>..] = [];
	var q int[>..] = [];
	wrap(p, q);
	print(p, " ", q);
	var d int[>..] = [];
	var e int[>..] = [];
	let pick = d.len > 0;
	let de int[>..]& = if pick { d } else { e };
	pass3(de, e);
	print(d, " ", e);
	var u int[>..] = [];
	var w int[>..] = [];
	pass4(u, w);
	let longer = u.len > 5;
	let uw int[>..]& = if longer { u } else { w };
	pass4(uw, w);
	print(u, " ", w);
	var s int[>..] = [];
	var t int[>..] = [];
	grow_each(s, t);
	print(s, " ", t);
	var x int[>..] = [];
	beside(x);
	print(x);
}
