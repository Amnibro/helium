var calls = 0;
fn limited(n int) int[..] {
	calls++;
	var result int[..] = [..n + 5];
	for i in n { result.push(10 + i); }
	return result;
}
fn variable(n int) int[] { calls++; return [n, n + 1]; }
fn grow(n int) int[>..] { calls++; return [n, n + 1]; }
fn main() {
	var out int[>..] = [-1];
	for k in 0..3 {
		out.append(if k == 0 { limited(0) } else { limited(k) });
		out.push(-2);
	}
	out.append(if calls == 3 { variable(20) } else { variable(30) });
	out.append(if calls == 4 { grow(40) } else { grow(50) });
	out.push(-3);
	print(out, " ", calls);
}
