// runtime-debug: field evaluation and construction follow declaration order.
// Out-of-order fields are only accepted when reordering cannot cross an effect,
// runtime check, or nonlocal exit (calls count as effects); those cases are
// written in declaration order here and rejected cases live in test/errors_tc/init_order*.
import std;
struct Pair { a int, b int }
struct Triple { a int, b int, c int }
struct Defaults { a int, b int = 7, c int }
struct Floats { a f32, b f32 }
struct Unsigned { a uint, b uint }
enum Message { Text { head byte[], flags int = 0, tail byte[] } }
var order = 0;
fn next() int { order++; order }
fn identity(x int) int { return x; }
fn pure(x int) int { let y = identity(x); if y > 0 { y } else { 0 } }
fn count(bytes const byte[:]) int { bytes.len }
fn word() byte[] { return "hello"; }
fn main() {
	var x = 4;
	let p = Pair { a: x, b: pure(x) };
	assert(p.a == 4 && p.b == 4);
	let t = Triple { c: p.b, a: p.a, b: if x > 0 { 2 } else { 3 } };
	assert(t.a == 4 && t.b == 2 && t.c == 4);
	let d = Defaults { c: x, a: x };
	assert(d.b == 7);
	let f = Floats { b: 2.0 * 3.0, a: 1.0 };
	assert(f.a == 1.0 && f.b == 6.0);
	let u uint = 18446744073709551615;
	let bits = Unsigned { b: u + 1, a: u << 1 };
	assert(bits.a == 18446744073709551614 && bits.b == 0);
	let m = Message.Text { head: word(), tail: "world" };
	print(m);
	let counted = Pair { b: count([1, 2]), a: x };
	assert(counted.b == 2);
	// Reordering pure expressions does not reject an effect elsewhere.
	let ordered = Triple { a: next(), c: x, b: x };
	let same = Pair { a: next(), b: next() };
	assert(ordered.a == 1 && same.a == 2 && same.b == 3);
	print("named fields: declaration-order construction passed");
}
