// runtime-debug: a call's result of one array or slice kind, checked as
// another where it lands, constructs the slot's kind (§4.2): fixed,
// static-capacity limited and runtime-capacity limited arrays, slices,
// variable, grow-only and grow-shrink arrays, of bytes, integers, structs and
// variable-size elements, building variable arrays of other length storages,
// resizable arrays and runtime-capacity limited arrays -- as arguments,
// bindings, an assignment, fields, elements, results, a long-distance
// return's value, globals and an `if`'s value. The calls are to functions,
// builtins and a tag dispatch. At -O2 most functions that only return a
// value unwrap to it, those with several returns stay inlined blocks, and
// the two-result ones and the dispatch stay calls.
struct P { x int, y byte }
struct R { tag byte[], v byte[], w byte[u16], z byte[varint], c byte[..], after int }
struct B { n int, data byte[>..] }
enum Sh { Sq { a int }, Ci { r int } }

var h byte[>..] = [];

// One return each.
fn fix() byte[3] { return [7, 8, 9]; }
fn fixi() int[3] { return [300, 400, 500]; }
fn fixp() P[2] { return [P { x: 1, y: 2 }, P { x: 3, y: 4 }]; }
fn lim() byte[..8] { return "lim"; }
fn limi() int[..4] { return [11, 22]; }
fn sli() byte[:] { return h[..]; }
fn capr() byte[..] { return "caps"; }
fn var1() byte[] { return "varia"; }
fn vlit() byte[] { return [1, 2, 3, 4, 5, 6]; }
fn grow() byte[>..] { return "growing"; }
fn glit() byte[>..] { return [5, 6]; }
fn clip(s byte[:]) byte[..8] { return s; }
fn wrap() byte[] { return fix(); }
fn wrapl() byte[] { return clip(h[1..]); }

// Several returns each.
fn fixb(k int) byte[3] {
	if k > 1 { return [1, 2, 3]; }
	let a byte[3] = [4, 5, 6];
	return a;
}
fn limb(k int) byte[..8] {
	if k > 1 { return "long!"; }
	return h[..2];
}
fn slib(k int) byte[:] {
	if k > 1 { return h[1..]; }
	return h[..];
}
fn capb(k int) byte[..] {
	var l byte[..] = [..6];
	l.push(97);
	if k > 1 { l.push(98); }
	return l;
}
fn capl(k int) byte[..] {
	if k > 1 { return [..3]; }
	return "cc";
}
fn varb(k int) byte[] {
	if k > 1 { return [9, 8, 7]; }
	return "xy";
}
fn growb(k int) byte[>..] {
	var r byte[>..] = [];
	r.push(10);
	if k > 1 { r.push(20); }
	return r;
}
fn gsh() byte[>..<] {
	var r byte[>..<] = [];
	r.push(4);
	r.push(5);
	return r;
}
fn words() byte[][] { return ["ab", "cde"]; }
fn wordsb(k int) byte[][] {
	if k > 1 { return ["x"]; }
	var a byte[][>..] = [];
	a.push("pq");
	a.push("rst");
	return a;
}

// A value returned to a function further up.
fn inner(k int) int {
	if k > 0 { return fix() from outer; }
	return 5;
}
fn outer(k int) byte[] {
	let n = inner(k);
	return [n as byte];
}

// Two results each: an ordinary value context takes the first.
fn fix2() byte[3], int { return [21, 22, 23], 1; }
fn lim2() byte[..8], int { return "l2", 2; }
fn sli2() byte[:], int { return h[2..], 3; }
fn cap2() byte[..], int { return "cap2", 4; }
fn var2() byte[], int { return "v2", 5; }

fn name(s Sh.Sq) byte[3] { return [83, 81, s.a as byte]; }
fn name(s Sh.Ci) byte[3] { return [67, 73, s.r as byte]; }

// Results of another kind than the calls in their returns.
fn asvar() byte[] { return lim(); }
fn asgrow() byte[>..] { return fix(); }
fn ascap() byte[..] { return sli(); }
fn aswide() byte[u16] { return capr(); }

// Each slot's length and element sum, read as the slot's kind; a variable's
// or a field's through a slice of it.
fn tv(x byte[]) int {
	var s = 0;
	for e in x { s += e; }
	return x.len * 10000 + s;
}
fn tw(x byte[u16]) int {
	var s = 0;
	for e in x { s += e; }
	return x.len * 10000 + s;
}
fn tr(x byte[>..]) int {
	var s = 0;
	for e in x { s += e; }
	return x.len * 10000 + s;
}
fn tl(x byte[..]) int {
	var s = 0;
	for e in x { s += e; }
	return x.len * 10000 + s;
}
fn ti(x int[]) int {
	var s = 0;
	for e in x { s += e; }
	return x.len * 10000 + s;
}
fn sv(x byte[:]) int {
	var s = 0;
	for e in x { s += e; }
	return x.len * 10000 + s;
}
fn tn(x byte[][u16]) int {
	var t = 0;
	for w in x { t = t * 10 + w.len; }
	return x.len * 10000 + t;
}
fn tnr(x byte[][>..]) int {
	var t = 0;
	for w in x { t = t * 10 + w.len; }
	return x.len * 10000 + t;
}
fn tp(x P[]) int {
	var s = 0;
	for e in x { s += e.x * 10 + e.y; }
	return x.len * 10000 + s;
}

var gv byte[] = fix();
var gr byte[>..] = lim();
var gl byte[..] = var1();

fn main() {
	h.append("sliced");
	print(tv(fix()), " ", tv(lim()), " ", tv(sli()), " ", tv(capr()), " ", tv(grow()));
	print(tw(fix()), " ", tw(lim()), " ", tw(sli()), " ", tw(capr()), " ", tw(var1()));
	print(tr(fix()), " ", tr(lim()), " ", tr(sli()), " ", tr(capr()), " ", tr(vlit()));
	print(tl(fix()), " ", tl(lim()), " ", tl(sli()), " ", tl(var1()), " ", tl(vlit()), " ",
		  tl(grow()), " ", tl(glit()));
	print(ti(fixi()), " ", ti(limi()), " ", tp(fixp()));
	print(tv(clip(h[..])), " ", tv(wrap()), " ", tv(wrapl()), " ", tv(glit()));
	for k in 3 {
		print(tv(fixb(k)), " ", tv(limb(k)), " ", tv(slib(k)), " ", tv(capb(k)), " ",
			  tv(capl(k)), " ", tw(varb(k)), " ", tl(varb(k)), " ", tl(growb(k)));
		print(tr(fixb(k)), " ", tr(limb(k)), " ", tl(slib(k)), " ", tr(capb(k)), " ",
			  tl(capl(k)), " ", tw(growb(k)));
	}
	print(tv(fix2()), " ", tr(lim2()), " ", tl(sli2()), " ", tw(cap2()), " ", tl(var2()));

	let a byte[] = fix();
	let b byte[>..] = lim();
	var c byte[>..] = sli();
	let d byte[..] = var1();
	let e byte[u16] = capr();
	print(sv(a), " ", sv(b), " ", sv(c), " ", sv(d), " ", sv(e));
	c = fixb(2);
	print(sv(c));
	c = capb(2);
	print(sv(c));

	let r = R { tag: "t", v: fix(), w: lim(), z: sli(), c: var1(), after: 77 };
	print(sv(r.tag), " ", sv(r.v), " ", sv(r.w), " ", sv(r.z), " ", sv(r.c), " ", r.after);
	let q = R { tag: "tt", v: capb(1), w: fixb(1), z: capr(), c: fix(), after: 78 };
	print(sv(q.tag), " ", sv(q.v), " ", sv(q.w), " ", sv(q.z), " ", sv(q.c), " ", q.after);
	let bb = B { n: 3, data: lim() };
	print(bb.n, " ", sv(bb.data));

	var els byte[][>..] = [];
	els.push(fix());
	els.push(lim());
	els.push(capr());
	els.push(slib(1));
	for x in els { print(sv(x)); }
	let lit byte[][] = [capr(), fix(), sli()];
	for x in lit { print(sv(x)); }

	print(tv(asvar()), " ", tr(asgrow()), " ", tl(ascap()), " ", tw(aswide()));
	print(sv(gv), " ", sv(gr), " ", sv(gl));

	for k in 3 {
		let y byte[] = if k == 0 { fix() } else if k == 1 { lim() } else { capr() };
		let z byte[>..] = if k == 0 { sli() } else if k == 1 { capb(k) } else { fixb(k) };
		print(sv(y), " ", sv(z));
	}

	var popped byte[3][>..] = [];
	popped.push([1, 2, 3]);
	popped.push([4, 5, 6]);
	let dv byte[] = default<byte[3]>();
	print(sv(dv), " ", tl(popped.pop()), " ", tv(popped.pop()));
	print(tl(str(42)), " ", tl(to_bytes(h)), " ", tw(str(7)));
	let img = to_bytes(h);
	print(tl(from_bytes<byte[]>(img[..])), " ", tw(from_bytes<byte[]>(img[..])));
	print(tl(gsh()), " ", tr(gsh()), " ", tv(gsh()), " ", tv(outer(1)), " ", tv(outer(0)));
	print(tn(words()), " ", tnr(words()));
	for k in 3 { print(tn(wordsb(k)), " ", tnr(wordsb(k))); }
	var shapes Sh[>..] = [];
	shapes.push(Sh.Sq { a: 1 });
	shapes.push(Sh.Ci { r: 2 });
	for s in shapes { print(tv(name(s)), " ", tl(name(s))); }
}
