// Named results and other values bound for their destination: a return of a
// copy from a function value's body, run inside a callee, and a long-distance
// return land over the named result built there (build, grow); a local
// returned in two result positions is built at neither.
fn each<F>(n int) { for i in n { F(i); } }
fn build(n int) byte[] {
	var s byte[>..] = [];
	s.push('a');
	each(n) { i =>
		s.push('b');
		if i == 1 { return copy(s); }
	}
	s.push('z');
	return s;
}
fn leave() { return [7, 8, 9] from grow; }
fn grow(n int) int[>..] {
	var out int[>..] = [1, 2];
	out.push(3);
	if n > 0 { leave(); }
	return out;
}
fn two() byte[>..], byte[>..] {
	var s byte[>..] = [];
	s.push('a');
	s.push('b');
	return s, s;
}
fn two_arr() byte[], byte[] {
	var s byte[>..] = [];
	s.push('c');
	s.push('d');
	return s, s;
}
fn main() {
	print(build(5), " ", build(0));
	var g = grow(1);
	g.push(4);
	print(g, " ", grow(0));
	let a, b = two();
	print(a, " ", b);
	let c, d = two_arr();
	print(c, " ", d);
}
