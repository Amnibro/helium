import std;
struct Pair { x int, y int }
struct Bag { tag int, items int[>..<] }
fn pair(a int, b int) { print(a, " ", b); }
extern fn fmod(a real, b real) real;
fn main() {
	var x = 1;
	fn setx() int { x = 10; 2 }
	print(x + setx());
	x = 1;
	let px .= x;
	print(px + setx());
	x = 1;
	pair(x, setx());
	x = 1;
	var f = 1.0;
	fn setf() real { f = 10.0; 2.0 }
	print(fmod(f, setf()) == 1.0);
	var y = 2;
	var r .= x;
	fn change() int& { r .= y; return y; }
	print(r .== change());
	r .= x;
	fn changewrite() int { r .= y; 9 }
	r = changewrite();
	print(x, " ", y);
	x = 1;
	x += setx();
	print(x);
	var a int[3] = [10, 20, 30];
	var i = 0;
	fn next() int { i = 1; 9 }
	a[i] = next();
	print(a);
	i = 0;
	fn upper() int { i = 1; 2 }
	let s = a[i..upper()];
	print(s.len);
	var b int[3] = [40, 50, 60];
	var ar .= a;
	fn index() int { ar .= b; 0 }
	print(ar[index()]);
	ar .= a;
	fn end() int { ar .= b; 2 }
	let old = ar[0..end()];
	print(old[0]);
	var limited_a int[..] = [1, 2];
	var limited_b int[..] = [3, 4];
	var limited_ref .= limited_a;
	fn change_limited() int[..] { limited_ref .= limited_b; return [7, 8]; }
	limited_ref = change_limited();
	print(limited_a, " ", limited_b);
	var grow_a int[>..<] = [1, 2];
	var grow_b int[>..<] = [3, 4];
	var grow_ref .= grow_a;
	fn change_grow() int[>..<] { grow_ref .= grow_b; return [7, 8, 9]; }
	grow_ref = change_grow();
	grow_a.push(5);
	grow_b.push(6);
	print(grow_a, " ", grow_b);
	var bag_a = Bag { tag: 1, items: [1, 2] };
	var bag_b = Bag { tag: 2, items: [3, 4] };
	var bag_ref .= bag_a;
	fn change_bag() Bag { bag_ref .= bag_b; return Bag { tag: 9, items: [7, 8, 9] }; }
	bag_ref = change_bag();
	bag_a.items.push(5);
	bag_b.items.push(6);
	print(bag_a.tag, bag_a.items, " ", bag_b.tag, bag_b.items);
	// A field that no index or rebinding can move is stored to as it is
	// spelled, after the right side, which here writes it too; compound
	// assignment still reads the old value first.
	var p = Pair { x: 1, y: 2 };
	fn bump() int { p.x = 50; p.y = 60; 3 }
	p.x = bump();
	print(p.x, " ", p.y);
	p.y += bump();
	print(p.x, " ", p.y);
	let pr .= p;
	pr.x = bump();
	print(p.x, " ", p.y);
}
