// runtime-debug: a call into a recursive cycle is made with no data stack of
// the calling activation in use (§7.8), so every activation starts its
// stacks at the same index and the program's stack count is static. The
// shapes that are allowed: a non-fixed result returned whole, through
// branches and a block's tail, a function value's body included, or by a
// return inside a function value; text delivered through a buffer passed in
// by reference, built in place; fixed-size values and temporaries anywhere,
// a large fixed one included; a non-fixed temporary in a statement of its
// own before the call; scratch passed in from outside and viewed across the
// calls with mark and resize; format into a buffer passed by reference, a
// recursive overload included.

struct Big { blocks byte[8192], seed int }
struct Item { value int, next Item? }
recursive fn format(out byte[>..]&, i Item&) {
	format(out, i.value);
	let n .= i.next;
	if n { format(out, ",", n); }
}

fn size(s const byte[:]) int { s.len }
fn digit(n int) byte { return ('0' + n) as byte; }

// Returned whole: the back edge's result is built in the caller's
// destination, as the branches of an if and a block's tail are.
recursive fn chain(n int) byte[>..] {
	if n == 0 { return "end"; }
	if n % 2 == 0 { return chain(n - 1); }
	return { let k = n; if k > 10 { "big" } else { chain(n - 1) } };
}

// A function value's body runs inside the function calling it: a call into
// the cycle there whose result is the body's value is built where the call
// of the function value puts it, here in the caller's destination of
// through, which returns it whole; a plain return inside one returns from
// nest, built in the destination of nest's caller.
fn through<F>(n int) byte[>..] { F(n) }
fn probe<F>(n int) int { return F(n); }
recursive fn nest(n int) byte[>..] {
	if n <= 1 { return str("base", n); }
	if n % 2 == 0 { return through(n) { m => if m > 3 { nest(m - 1) } else { nest(m - 3) } }; }
	let k = probe(n) { m => if m > 3 { return nest(m - 1); } m * 10 };
	return str(k);
}

// Text built in place into the buffer passed in from outside the cycle,
// each level appending its own part around the level below.
recursive fn build(out byte[>..]&, n int) {
	if n == 0 { out.append("."); return; }
	out.push(digit(n));
	build(out, n - 1);
	out.push(digit(n));
}

// Non-fixed temporaries in statements of their own before the call, fixed
// temporaries at the call (a slice of a fixed literal, a large fixed value
// by value and as a local), and a format into the caller's buffer around it.
recursive fn mixed(out byte[>..]&, s const int[:], n int, big Big) int {
	if n == 0 { return s[0] + big.seed; }
	let width = size(str("level", n));
	format(out, "[", n);
	var mine = big;
	mine.seed += n;
	let below = mixed(out, [n, n + 1], n - 1, mine);
	let text = str(below);
	format(out, text, "]");
	return width + below + mine.seed - big.seed;
}

// Scratch owned outside the cycle: each level pushes its part, views it
// across the call back into the cycle, and shrinks back on the way out.
recursive fn walk(scratch int[>..<]&, depth int) int {
	let mark = scratch.len;
	scratch.push(depth);
	let mine = scratch[mark..];
	var total = 0;
	if depth < 3 { total = walk(scratch, depth + 1); }
	total += mine[0];
	scratch.resize(mark);
	return total;
}

// A recursive format overload renders through the buffer it is given; the
// local buffer's scope ends before the call back into the cycle.
recursive fn count(items Item&, n int) int {
	if n == 0 { return 0; }
	var len = 0;
	{
		var buf byte[>..] = [];
		format(buf, items);
		len = buf.len;
	}
	return len + count(items, n - 1);
}

fn main() {
	print(chain(5), " ", chain(4));
	print(nest(7), " ", nest(2));
	var out byte[>..] = [];
	build(out, 3);
	print(out);
	var text byte[>..] = [];
	let big = Big { seed: 7, .. };
	print(mixed(text, [1, 2], 3, big), " ", text);
	var scratch int[>..<] = [];
	print(walk(scratch, 0), " ", scratch.len);
	var c = Item { value: 3, next: null };
	var b = Item { value: 2, next: c };
	let a = Item { value: 1, next: b };
	print(count(a, 2));
}
