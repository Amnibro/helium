// Unsigned division and remainder by even constants, whose fast form
// shifts the dividend before the multiply by the reciprocal.
import std;
import os;
fn main() {
	let n = args().len as uint;
	var h uint = 0;
	var x uint = 0x9E3779B97F4A7C15 * n;
	for i in 20000 {
		x = x * 6364136223846793005 + 1442695040888963407;
		let y = if i % 3 == 0 { x >> (i % 64) as uint } else { x };
		h = h * 31 + y / 6 + (y % 6) * 7;
		h = h * 31 + y / 10 + (y % 10) * 7;
		h = h * 31 + y / 12 + (y % 12) * 7;
		h = h * 31 + y / 20 + (y % 20) * 7;
		h = h * 31 + y / 24 + (y % 24) * 7;
		h = h * 31 + y / 28 + (y % 28) * 7;
		h = h * 31 + y / 40 + (y % 40) * 7;
		h = h * 31 + y / 50 + (y % 50) * 7;
		h = h * 31 + y / 52 + (y % 52) * 7;
		h = h * 31 + y / 56 + (y % 56) * 7;
		h = h * 31 + y / 60 + (y % 60) * 7;
		h = h * 31 + y / 96 + (y % 96) * 7;
		h = h * 31 + y / 100 + (y % 100) * 7;
		h = h * 31 + y / 104 + (y % 104) * 7;
		h = h * 31 + y / 112 + (y % 112) * 7;
		h = h * 31 + y / 120 + (y % 120) * 7;
		h = h * 31 + y / 200 + (y % 200) * 7;
		h = h * 31 + y / 224 + (y % 224) * 7;
		h = h * 31 + y / 400 + (y % 400) * 7;
		h = h * 31 + y / 640 + (y % 640) * 7;
		h = h * 31 + y / 1000 + (y % 1000) * 7;
		h = h * 31 + y / 1022 + (y % 1022) * 7;
		h = h * 31 + y / 1024000 + (y % 1024000) * 7;
		h = h * 31 + y / 10000 + (y % 10000) * 7;
		h = h * 31 + y / 100000000 + (y % 100000000) * 7;
		h = h * 31 + y / 1000000000000 + (y % 1000000000000) * 7;
		h = h * 31 + y / 14 + (y % 14) * 7;
		h = h * 31 + y / 22 + (y % 22) * 7;
		h = h * 31 + y / 26 + (y % 26) * 7;
		h = h * 31 + y / 44 + (y % 44) * 7;
		h = h * 31 + y / 7168 + (y % 7168) * 7;
		h = h * 31 + y / 3145728 + (y % 3145728) * 7;
		h = h * 31 + y / 5497558138880 + (y % 5497558138880) * 7;
		h = h * 31 + y / 1000000000000000000 + (y % 1000000000000000000) * 7;
		h = h * 31 + y / 600000000000000000 + (y % 600000000000000000) * 7;
	}
	var o byte[>..] = [];
	format(o, h, "\n");
	print(o);
}
