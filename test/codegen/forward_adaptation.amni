// A multi-value call forwarded by a return (§7.1), to the function's own
// caller or to a function further out (`return f() from g`, §7.9), whose
// results the checker fits to the returning function's result types one by
// one: integers to wider integers and to floats, f32 to f64, a variant to
// its ADT in either mode (a fixed-size, a variable-size and a resizable
// variant), an ADT to its other mode, a reference to its pointee or to an
// optional, a reference to an array to a slice, and an array or a slice to
// an array of another kind or length storage; in the result C returns and in
// out-parameters, from a function and from case functions dispatched on a
// tag. A variant that is not fixed-size builds its variable-mode ADT behind
// the tag, and a return taken in the forwarded call's argument after that
// tag is written delivers its own value. The functions in between are
// recursive, so -O2 inlines none of them into its target, and every
// long-distance return stays one.
struct P { a int, b int }
enum E { A { n int }, B { s int } }
enum Msg { Ping, Text { body byte[] } }
enum Value { V { items int[>..] }, W { n int }, X { s byte[] } }
enum Pick { First { k int }, Second { k int } }

var gp = P { 1, 2 };
var gx = 5;
var garr byte[4] = [97, 98, 99, 100];
var gs byte[4] = [104, 105, 106, 107];

fn halves() i32, i32 { return -5, -6; }
fn small() byte, i16 { return 200, -300; }
fn ints() int, i32 { return 1 << 40, -7; }
fn flts() f32, f32 { return 1.5, 2.25; }
fn refs() P&, int& { return gp, gx; }
fn view() byte[4]&, int& { return garr, gx; }
fn variant() E.B, int { return E.B { s: 3 }, 4; }
fn late() int, E.A { return 5, E.A { n: 6 }; }
fn fixedadt() E, int { return E.B { s: 7 }, 8; }
fn varadt() E.., int { return E.A { n: 9 }, 10; }
fn text(n int) Msg.Text, int { return Msg.Text { body: "hey" }, n; }
fn items(n int) Value.V, int { return Value.V { items: [1, 2, n] }, n; }
fn plain() Value.W, int { return Value.W { n: 12 }, 13; }
fn named() Value.X, int { return Value.X { s: "xs" }, 14; }
fn chars() int, byte[] { return 1, "abc"; }
fn wide() byte[u16], int { return "hij", 2; }
fn grow() byte[>..], int { var s byte[>..] = []; s.append("defg"); return s, 3; }
fn part() byte[:], int { return gs[1..3], 4; }
fn lim() byte[..], int { var l byte[..] = [..6]; l.append("lm"); return l, 5; }
fn three() int[3], int { return [7, 8, 9], 6; }
fn more() int[>..], int { var s int[>..] = [4, 5]; return s, 7; }
fn caps() int[3], byte[>..] { var s byte[>..] = []; s.append("xyz"); return [1, 2, 3], s; }
fn pick(c Pick.First) i32, i32 { return c.k as i32, -1; }
fn pick(c Pick.Second) i32, i32 { return -2, c.k as i32; }

// Each `to_` function returns its target's results from below it; k picks
// the call.
recursive fn to_wide(k int, n int) {
	if n > 0 { to_wide(k, n - 1); }
	if k == 0 { return halves() from widened; }
	return small() from widened;
}
fn widened(k int) int, int { to_wide(k, 1); return 0, 0; }
recursive fn to_float(k int, n int) {
	if n > 0 { to_float(k, n - 1); }
	if k == 0 { return ints() from floats; }
	return flts() from floats;
}
fn floats(k int) real, real { to_float(k, 1); return 0, 0; }
recursive fn to_pointee(n int) { if n > 0 { to_pointee(n - 1); } return refs() from pointees; }
fn pointees() P, int { to_pointee(1); return P { 0, 0 }, 0; }
recursive fn to_view(n int) { if n > 0 { to_view(n - 1); } return view() from views; }
fn views() byte[:], int? { to_view(1); return garr[0..0], null; }
recursive fn to_fixed(k int, n int) {
	if n > 0 { to_fixed(k, n - 1); }
	if k == 0 { return variant() from fixed; }
	return varadt() from fixed;
}
fn fixed(k int) E, int { to_fixed(k, 1); return E.A { n: 0 }, 0; }
recursive fn to_later(n int) { if n > 0 { to_later(n - 1); } return late() from later; }
fn later() int, E { to_later(1); return 0, E.A { n: 0 }; }
recursive fn to_varmode(k int, n int) {
	if n > 0 { to_varmode(k, n - 1); }
	if k == 0 { return variant() from varmode; }
	return fixedadt() from varmode;
}
fn varmode(k int) E.., int { to_varmode(k, 1); return E.A { n: 0 }, 0; }
recursive fn to_texts(n int) { if n > 0 { to_texts(n - 1); } return text(11) from texts; }
fn texts() Msg.., int { to_texts(1); return Msg.Ping, 0; }
recursive fn to_values(k int, n int) {
	if n > 0 { to_values(k, n - 1); }
	if k == 0 { return items(3) from values; }
	if k == 1 { return plain() from values; }
	return named() from values;
}
fn values(k int) Value.., int { to_values(k, 1); return Value.W { n: 0 }, 0; }
recursive fn to_prefixed(n int) { if n > 0 { to_prefixed(n - 1); } return chars() from prefixed; }
fn prefixed() int, byte[varint] { to_prefixed(1); return 0, ""; }
recursive fn to_flat(k int, n int) {
	if n > 0 { to_flat(k, n - 1); }
	if k == 0 { return wide() from flat; }
	if k == 1 { return grow() from flat; }
	if k == 2 { return part() from flat; }
	return lim() from flat;
}
fn flat(k int) byte[], int { to_flat(k, 1); return "", 0; }
recursive fn to_growing(k int, n int) {
	if n > 0 { to_growing(k, n - 1); }
	if k == 0 { return wide() from growing; }
	return part() from growing;
}
fn growing(k int) byte[>..], int { to_growing(k, 1); return [], 0; }
recursive fn to_shrinking(k int, n int) {
	if n > 0 { to_shrinking(k, n - 1); }
	if k == 0 { return three() from shrinking; }
	return more() from shrinking;
}
fn shrinking(k int) int[>..<], int { to_shrinking(k, 1); return [], 0; }
recursive fn to_limited(n int) { if n > 0 { to_limited(n - 1); } return caps() from limited; }
fn limited() int[..4], byte[..8] { to_limited(1); return [], ""; }
recursive fn to_picked(c Pick, n int) {
	if n > 0 { to_picked(c, n - 1); }
	return pick(c) from picked;
}
fn picked(c Pick) int, real { to_picked(c, 1); return 0, 0; }

// Forwarded to the function's own caller.
fn own_texts() Msg.., int { return text(21); }
fn own_values() Value.., int { return items(4); }

// A return taken in the argument, after the tag is at the destination.
fn early(k int) Msg.., int {
	return text({ if k > 5 { return Msg.Text { body: "early" }, 1; } k });
}
fn early_items(k int) Value.., int {
	return items({ if k > 5 { return Value.V { items: [9, 9] }, 1; } k });
}
recursive fn to_far(k int, n int) {
	if n > 0 { to_far(k, n - 1); }
	return text({ if k > 5 { return Msg.Text { body: "far" }, 2 from far; } k }) from far;
}
fn far(k int) Msg.., int { to_far(k, 1); return Msg.Ping, 0; }

fn main() {
	for k in 2 {
		let a, b = widened(k);
		let c, d = floats(k);
		print(a, " ", b, " ", c, " ", d);           // -5 -6 1099511627776 -7, 200 -300 1.5 2.25
	}
	let p, x = pointees();
	let s, o = views();
	gp.a = 10;
	gx = 6;
	print(p, " ", x, " ", s, " ", o);               // P { 1, 2 } 5 abcd 6
	for k in 2 {
		let e, n = fixed(k);
		let v, m = varmode(k);
		print(e, " ", n, " ", v, " ", m);           // B { 3 } 4 B { 3 } 4, A { 9 } 10 B { 7 } 8
	}
	let i, l = later();
	let t, j = texts();
	print(i, " ", l, " ", t, " ", j);               // 5 A { 6 } Text { "hey" } 11
	for k in 3 {
		let w, q = values(k);
		print(w, " ", q);                           // V { [1, 2, 3] } 3, W { 12 } 13, X { "xs" } 14
	}
	let h, u = prefixed();
	print(h, " ", u, " ", u.len);                   // 1 abc 3
	for k in 4 {
		let f, z = flat(k);
		print(f, " ", z);                           // hij 2, defg 3, ij 4, lm 5
	}
	for k in 2 {
		var g, y = growing(k);
		g.push('!');
		var r, c = shrinking(k);
		r.push(0);
		print(g, " ", y, " ", r, " ", c);           // hij! 2 [7, 8, 9, 0] 6, ij! 4 [4, 5, 0] 7
	}
	let li, lu = limited();
	print(li, " ", lu);                             // [1, 2, 3] xyz
	let first Pick = Pick.First { k: 30 };
	let second Pick = Pick.Second { k: 40 };
	let p1, f1 = picked(first);
	let p2, f2 = picked(second);
	print(p1, " ", f1, " ", p2, " ", f2);           // 30 -1.0 -2 40.0

	let ot, on = own_texts();
	let ov, om = own_values();
	print(ot, " ", on, " ", ov, " ", om);           // Text { "hey" } 21 V { [1, 2, 4] } 4
	for k in [3, 7] {
		let a, b = early(k);
		let c, d = early_items(k);
		let e, f = far(k);
		print(a, " ", b, " ", c, " ", d, " ", e, " ", f);
		// Text { "hey" } 3 V { [1, 2, 3] } 3 Text { "hey" } 3
		// Text { "early" } 1 V { [9, 9] } 1 Text { "far" } 2
	}
}
