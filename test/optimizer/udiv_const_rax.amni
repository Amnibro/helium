import std;
fn mix(x uint) uint { return x * 6364136223846793005 + 1442695040888963407; }
fn main() {
	var x uint = 88172645463325252;
	var h uint = 0;
	for i in 20000 {
		x = mix(x);
		let a = x >> (i % 64) as uint;
		var q uint = a / 10;
		q = q + a / 100 + a / 1000 + a / 7 + a / 100000000 + a / 3 + a / 641 + a / 10000000000000000000;
		let r = a % 10 + a % 100000000 + a % 7;
		h = h * 31 + q + r;
	}
	print(h);
}
