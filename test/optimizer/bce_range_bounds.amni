import std;
struct T { p byte[512], q byte[512], g int[40] }
fn walk(t const T&, x i32, y i32, s int) int {
	let a = (x & 255) as int;
	let b = (y & 255) as int;
	var i1 = 0; var j1 = 0;
	if s % 3 == 0 { i1 = 1; } else if s % 3 == 1 { j1 = 1; } else { i1 = 1; j1 = 1; }
	let pe .= t.p;
	let pq .= t.q;
	var r = pq[a + i1 + pe[b + j1 + pe[a + 1]]] as int;
	r += t.g[((pe[b] as int) & 7) * 5 + 4];
	r += pq[(a >> 1) + 255] as int;
	r
}
fn main() {
	var t = T { p: [0; 512], q: [0; 512], g: [0; 40] };
	for k in 512 { t.p[k] = ((k * 151 + 7) & 255) as byte; t.q[k] = ((k * 37 + 11) % 251) as byte; }
	for k in 40 { t.g[k] = k * k; }
	var h = 0;
	for i in 600 { h = h * 31 + walk(t, (i * 7919) as i32, (i * 104729 - 5) as i32, i); h &= 0xffffff; }
	var o byte[>..] = [];
	format(o, h, "\n");
	print(o);
}
