// A result computed into a temporary and then copied into a variable that
// lives across loop iterations (small arrays kept in registers, swapped
// pairs, a variable that is also an operand of the computation) may be
// computed into that variable directly.
import std;
import os;
fn main() {
	let n = args().len;
	var d real[4] = [1.0; 4];
	var e int[4] = [3; 4];
	var a = 0.5 * n as real;
	var b = 1.25;
	var k = 7;
	for s in 2000 {
		d[0] = a - b;
		d[1] = b - a * 0.5;
		d[2] = d[0] * d[1] + 1.0;
		d[3] = d[3] - d[2] * 0.001;
		let t = a;
		a = b * 0.999 + 0.01;
		b = t + d[3] * 0.0001;
		e[s & 3] = e[(s + 1) & 3] * 3 + k;
		k = (k * 5 + e[0]) & 0xffff;
	}
	var o byte[>..] = [];
	format(o, a, " ", b, " ", d[0], " ", d[3], " ", e[0] + e[1] + e[2] + e[3], " ", k, "\n");
	print(o);
}
