import std;
import os;
fn pick(x real, k int) real { if x < 0.0 { let y = x * 2.0; y + 1.0 } else { let y = x * 2.0; y + 1.0 } }
fn main() {
	let n = args().len;
	var o byte[>..] = [];
	var c = 0;
	for i in 12 {
		let x = (i as real - 5.5) * n as real;
		var a = 0;
		if i % 3 == 0 { a = i * 7; c += 1; } else { a = i * 7; c += 1; }
		var b = 0;
		if i % 2 == 0 { b = i + 1; } else { b = i - 1; }
		format(o, pick(x, i), " ", a, " ", b, " ", c, "\n");
	}
	print(o);
}
