// Values that pass through stack slots: multi-value returns of inlined
// functions, small arrays rewritten in part, slots whose address escapes to a
// callee, and stores on one side of a branch.
import std;
import os;
struct P { a int, b real, c int }
fn ts(a real, b real) real, real { let s = a + b; let v = s - a; return s, a - (s - v) + (b - v); }
fn sum3(a real, b real, c real) real { let h, l = ts(a, b); let h2, l2 = ts(h, c); let h3, l3 = ts(h2, l + l2); h3 + l3 }
fn bump(xs real[2]&) { xs[1] = xs[1] * 3.0 + 1.0; }
fn mix(n int, x real) real {
	var t real[2] = [x, x * 2.0];
	t[0] = t[1] + 1.0;
	let a = t[0];
	t[1] = a * 0.5;
	var u real[2] = [x, -x];
	if n % 2 == 0 { u[0] = 7.0; }
	let b = u[0] + u[1];
	var w real[2] = [x, x];
	bump(w);
	var p = P { a: n, b: x, c: n * 2 };
	p.a = p.c + 1;
	p.b = p.b + p.a as real;
	let q = p;
	a + t[1] + b + w[0] + w[1] + q.b + (q.a + q.c) as real
}
fn main() {
	let n = args().len;
	var acc = 0.0;
	var o byte[>..] = [];
	for i in 40 { acc += sum3(i as real * 0.1, 1e16 * n as real, -1e16) + mix(i + n, i as real * 0.25); }
	format(o, acc, "\n");
	print(o);
}
