// Inner loops whose bounds checks are proved once before the loop: the
// checked loop must still run whenever the proof fails.
import std;
fn sieve(n int) int {
	var flags u32[>..] = [];
	flags.resize((n + 31) >> 5, 0);
	var count = 0;
	for i in 2..n {
		if (flags[i >> 5] >> i) & 1 == 0 {
			count++;
			var j = i << 1;
			while j < n {
				flags[j >> 5] |= (1 as u32) << j;
				j += i;
			}
		}
	}
	return count;
}
fn strided(a int[:], from int, to int, step int) int {
	var s = 0;
	var j = from;
	while j < to {
		s += a[j] * (j + 1);
		j += step;
	}
	return s;
}
fn shifted(a int[:], from int, to int, step int, k int) int {
	var s = 0;
	var last = -1;
	var j = from;
	while j < to {
		let w = a[j >> 3];
		last = w + j;
		s = s * 31 + last;
		j += step;
	}
	return s + last;
}
fn early(a int[:], to int, stop int) int {
	var s = 0;
	var j = 0;
	while j < to {
		if a[j] == stop { break; }
		s += a[j];
		j += 1;
	}
	return s;
}
fn main() {
	print(sieve(100000), " ", sieve(64), " ", sieve(33), " ", sieve(3));
	var a int[>..] = [];
	for i in 1000 { a.push(i * 7 % 13 - 6); }
	print(strided(a, 0, 1000, 1), " ", strided(a, 3, 1000, 7), " ", strided(a, 5, 900, 1000), " ", strided(a, 10, 5, 1), " ", strided(a, 0, 0, 1), " ", strided(a, 990, 1000, 3));
	print(shifted(a, 0, 8000, 1, 3), " ", shifted(a, 17, 7999, 77, 3), " ", shifted(a, 0, 0, 1, 3));
	print(early(a, 1000000, 6), " ", early(a, 1000, 1000), " ", early(a, 3, 6));
}
