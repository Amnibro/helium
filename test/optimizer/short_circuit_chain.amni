// Chains of && and || over cheap comparisons. Short chains may become one
// branch on the combined bits; long ones stay as separate branches. Either
// way every combination of operands must give the source's answer.
import std;
import os;
fn c2(a int, b int) bool { a > 3 || b == 0 }
fn c3(a int, b int, c int) bool { a > 3 || b == 0 || (c & 1) != 0 }
fn c6(a int, b int, c int) bool { a > 0x7ff || a == 0x7ff && b != 0 || c > 0x7ff || c == 0x7ff && b == 0 || a < -5 || c < -9 }
fn a4(a int, b int, c int) bool { a >= 0 && b >= 0 && c >= 0 && a + b + c < 2000 }
fn main() {
	let n = args().len;
	var k2 = 0; var k3 = 0; var k6 = 0; var ka = 0;
	for i in 4096 {
		let a = (i * 2654435761 * n) % 4100 - 10;
		let b = (i >> 3) % 3;
		let c = (i * 40503) % 4100 - 12;
		if c2(a, b) { k2 += 1; }
		if c3(a, b, c) { k3 += 1; }
		if c6(a, b, c) { k6 += 1; }
		if a4(a, b, c) { ka += 1; }
	}
	var o byte[>..] = [];
	format(o, k2, " ", k3, " ", k6, " ", ka, "\n");
	print(o);
}
