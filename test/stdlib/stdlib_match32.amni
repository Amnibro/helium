import std;
fn member(s ByteSet&, c byte) bool { s.members[c] }
fn main() {
	var t byte[>..] = [];
	var x = 12345;
	for i in 400 {
		x = (x * 1103515245 + 12345) % 2147483648;
		t.push("acgtNSYB>\n|<aaZz~ \x80\xC3\xFF"[(x >> 16) % 21]);
	}
	let ws = [0x616161, 0x616361, 0x746761, 0x3E0A7C, 0x3C3C3C, 0x1616161, 0x2616361, 0x13E3E3E, 0x2C3C3C3];
	var bad = 0;
	for w in ws {
		for i in 0..360 {
			var r = 0;
			let n = if w >> 24 & 1 != 0 { 1 } else if w >> 25 & 1 != 0 { 2 } else { 3 };
			for k in 32 {
				let c = t[i + k] as int;
				var hit = false;
				for q in n { hit = hit || c == (w >> (8 * q)) & 255; }
				r |= if hit { 1 << k } else { 0 };
			}
			bad += if match32(t, i, w) != r { 1 } else { 0 };
		}
	}
	let sets = [byte_set("NSYt"), byte_set("abcdefghijklmnopqrstuvwxyz"), byte_set(">\n"), byte_set("|"), byte_set("Z~ <"), byte_set("aB")];
	var h = 0;
	for &a in sets {
		for i in 0..360 {
			var r = 0;
			for k in 32 { r |= if member(a, t[i + k]) { 1 << k } else { 0 }; }
			bad += if match_set32(t, i, a) != r { 1 } else { 0 };
		}
		for &b in sets {
			for i in 0..390 {
				h = (h * 31 + byte_set_pair(t[i..], a, 1, b) + 7 * find_any(t[i..], a)) % 1000000007;
			}
		}
	}
	print(bad, " ", h);
}
