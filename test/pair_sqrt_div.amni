import std;
import os;
import math;
fn show(tag const byte[:], v real) {
	var line byte[>..] = [];
	line.append(tag);
	line.push(' ');
	format_flt(line, v, 17);
	print(line);
}
fn two(a real, b real) real {
	let d1 = a * a + 1.5;
	let d2 = b * b + 2.25;
	let q1 = 0.01 / (d1 * sqrt(d1));
	let q2 = 0.01 / (d2 * sqrt(d2));
	return q1 * 3.0 + q2;
}
fn dep(a real) real {
	let d1 = a * a + 1.5;
	let q1 = 0.01 / (d1 * sqrt(d1));
	let d2 = q1 * 7.0 + 0.5;
	let q2 = 0.01 / (d2 * sqrt(d2));
	return q1 - q2;
}
fn diffc(a real, b real) real {
	let d1 = a * a + 1.5;
	let d2 = b * b + 2.25;
	let q1 = 0.01 / (d1 * sqrt(d1));
	let q2 = 0.02 / (d2 * sqrt(d2));
	return q1 + q2 * 5.0;
}
fn three(a real, b real, c real) real {
	let d1 = a + 3.0;
	let d2 = b + 4.0;
	let d3 = c + 5.0;
	let q1 = 2.5 / (d1 * sqrt(d1));
	let q2 = 2.5 / (sqrt(d2) * d2);
	let q3 = 2.5 / (d3 * sqrt(d3));
	return q1 + q2 * 10.0 + q3 * 100.0;
}
fn reuse(a real, b real) real {
	let d1 = a * a + 1.5;
	let s1 = sqrt(d1);
	let q1 = 0.01 / (d1 * s1);
	let d2 = b * b + 2.25;
	let q2 = 0.01 / (d2 * sqrt(d2));
	return q1 + q2 + s1;
}
fn loopy(n int) real {
	var x = 1.25;
	var y = 2.5;
	var vx = 0.0;
	var vy = 0.0;
	for s in n {
		let d1 = x * x + 0.75;
		let m1 = 0.03 / (d1 * sqrt(d1));
		vx -= x * m1;
		x += vx * 0.1;
		let d2 = y * y + x * 0.5 + 0.75;
		let m2 = 0.03 / (d2 * sqrt(d2));
		vy -= y * m2;
		y += vy * 0.1;
		let d3 = x * y + 4.0;
		let m3 = 0.03 / (d3 * sqrt(d3));
		let d4 = y * y + 4.0;
		let m4 = 0.03 / (d4 * sqrt(d4));
		vx += m3 - m4;
		vy += m4 * 0.5 + m3;
	}
	return x * 1000.0 + y + vx + vy;
}
fn arr(n int) real {
	var p real[4] = [1.0, 2.0, 3.0, 4.5];
	var acc = 0.0;
	for s in n {
		for i in 3 {
			let d = p[i] * p[i] + p[i + 1] + 0.125;
			let m = 0.5 / (d * sqrt(d));
			p[i] += m * 0.01;
			p[i + 1] -= m * 0.02;
			acc += m;
		}
	}
	return acc + p[0] + p[1] * 10.0 + p[2] * 100.0 + p[3] * 1000.0;
}
fn main() {
	show("two", two(1.1, 2.3));
	show("two2", two(-4.7, 0.0));
	show("dep", dep(0.9));
	show("diffc", diffc(1.1, 2.3));
	show("three", three(0.5, 1.5, 2.5));
	show("reuse", reuse(1.7, 3.1));
	show("loopy", loopy(1000));
	show("arr", arr(500));
}
