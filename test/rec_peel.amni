// recursion peeling (lpl) and no-heap-write calls (HCC): base cases inlined at self-call sites must keep stores, side effects and argument order (HC_NOLPL=1 / HC_NOHCC=1 turn them off)
var A i32[>..];
var B i64[>..];
var g int;
var top i32;
recursive fn fib(n int) int { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }
recursive fn ack(m int, n int) int { if m == 0 { n + 1 } else if n == 0 { ack(m - 1, 1) } else { ack(m - 1, ack(m, n - 1)) } }
recursive fn bld(d int) i32 { let i = top; top += 1; if d > 0 { let l = bld(d - 1); let r = bld(d - 1); A[i] = l + r; } else { A[i] = -1; } i }
recursive fn sidefx(n int) int { g += n; if n <= 0 { g } else { sidefx(n - 1) + 1 } }
recursive fn st(n int, k int) int { B[n % 64] = (n * k) as i64; if n == 0 { 7 } else { st(n - 1, k + 1) + B[(n + 3) % 64] as int } }
recursive fn neg(n int) int { if n > 3 { neg(n - 1) - neg(n - 3) } else { 0 - n } }
recursive fn three(a int, b int, c int) int { if a <= 0 { b * 3 + c } else { three(a - 1, c, b + a) + three(a - 2, b, c) } }
recursive fn sum(n i32) i64 { if n == 0 { 0 } else { n as i64 + sum(n - 1) } }
fn main() {
	A.resize(1 << 16, 0); B.resize(64, 0);
	print(fib(27)); print(ack(2, 9)); print(bld(12), " ", A[0], " ", A[100], " ", top);
	print(sidefx(30), " ", g); print(st(40, 3)); print(neg(25)); print(three(14, 1, 2)); print(sum(5000));
	var t = 0; for k in 20 { t += fib(k) * three(k % 7, k, 1); } print(t);
}
