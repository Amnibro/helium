import std;
import os;
fn main() {
	let n = args().len as real;
	var o byte[>..] = [];
	let v = [0.0, -0.0, 1.5, -1.5, 9.2e18, -9.2e18, 9.3e18, -9.3e18, -9223372036854775808.0, 1e300, -1e300, 0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0, 4294967296.7, -2147483648.9];
	for x in v { let y = x * n; format(o, y as int, " ", (y * 0.5) as i32, " ", y as f32 as int, "\n"); }
	print(o);
}
