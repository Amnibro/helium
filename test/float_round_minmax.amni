import std;
import os;
import math;
fn main() {
	let n = args().len as real;
	var o byte[>..] = [];
	let v = [0.0, -0.0, 1.5, -1.5, 2.5, -2.5, 0.49999999999999994, -7.7, 1e300, 0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0, 3.0, -1e-310];
	for x in v { let y = x * n; let f = y as f32; format(o, floor(y), " ", ceil(y), " ", trunc(y), " ", -y, " ", abs(y), " ", min(y, 1.25), " ", max(y, -y), " ", floor(f), " ", -f, " ", min(f, 0.5), " ", max(1.5, y), "\n"); }
	print(o);
}
