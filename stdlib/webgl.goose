namespace gl;
let POINTS: i32 = 0;
let LINES: i32 = 1;
let LINE_STRIP: i32 = 3;
let TRIANGLES: i32 = 4;
let TRIANGLE_STRIP: i32 = 5;
let DEPTH_BUFFER_BIT: i32 = 0x100;
let COLOR_BUFFER_BIT: i32 = 0x4000;
let ZERO: i32 = 0;
let ONE: i32 = 1;
let SRC_ALPHA: i32 = 0x302;
let ONE_MINUS_SRC_ALPHA: i32 = 0x303;
let DST_ALPHA: i32 = 0x304;
let LESS: i32 = 0x201;
let LEQUAL: i32 = 0x203;
let ALWAYS: i32 = 0x207;
let BLEND: i32 = 0xBE2;
let DEPTH_TEST: i32 = 0xB71;
let CULL_FACE: i32 = 0xB44;
let ARRAY_BUFFER: i32 = 0x8892;
let ELEMENT_ARRAY_BUFFER: i32 = 0x8893;
let STATIC_DRAW: i32 = 0x88E4;
let DYNAMIC_DRAW: i32 = 0x88E8;
let STREAM_DRAW: i32 = 0x88E0;
let BYTE: i32 = 0x1400;
let UNSIGNED_BYTE: i32 = 0x1401;
let UNSIGNED_SHORT: i32 = 0x1403;
let UNSIGNED_INT: i32 = 0x1405;
let FLOAT: i32 = 0x1406;
let FRAGMENT_SHADER: i32 = 0x8B30;
let VERTEX_SHADER: i32 = 0x8B31;
let TEXTURE_2D: i32 = 0xDE1;
let TEXTURE0: i32 = 0x84C0;
let TEXTURE_MAG_FILTER: i32 = 0x2800;
let TEXTURE_MIN_FILTER: i32 = 0x2801;
let TEXTURE_WRAP_S: i32 = 0x2802;
let TEXTURE_WRAP_T: i32 = 0x2803;
let NEAREST: i32 = 0x2600;
let LINEAR: i32 = 0x2601;
let LINEAR_MIPMAP_LINEAR: i32 = 0x2703;
let CLAMP_TO_EDGE: i32 = 0x812F;
let REPEAT: i32 = 0x2901;
extern fn init(canvas: i32, antialias: bool, alpha: bool) -> bool = "he_gl_init";
extern fn viewport(x: i32, y: i32, w: i32, h: i32) = "he_gl_viewport";
extern fn clear_color(r: f64, g: f64, b: f64, a: f64) = "he_gl_clear_color";
extern fn clear(mask: i32) = "he_gl_clear";
extern fn enable(cap: i32) = "he_gl_enable";
extern fn disable(cap: i32) = "he_gl_disable";
extern fn blend_func(s: i32, d: i32) = "he_gl_blend_func";
extern fn blend_func_sep(sc: i32, dc: i32, sa: i32, da: i32) = "he_gl_blend_func_sep";
extern fn depth_mask(on: bool) = "he_gl_depth_mask";
extern fn depth_func(f: i32) = "he_gl_depth_func";
extern fn create_shader(kind: i32) -> i32 = "he_gl_create_shader";
extern fn shader_source(sh: i32, src: const u8[:]) = "he_gl_shader_source";
extern fn compile_shader(sh: i32) -> bool = "he_gl_compile_shader";
extern fn shader_log(sh: i32, out: u8[>..]&) = "he_gl_shader_log";
extern fn create_program() -> i32 = "he_gl_create_program";
extern fn attach_shader(p: i32, sh: i32) = "he_gl_attach_shader";
extern fn bind_attrib(p: i32, idx: i32, name: const u8[:]) = "he_gl_bind_attrib";
extern fn link_program(p: i32) -> bool = "he_gl_link_program";
extern fn program_log(p: i32, out: u8[>..]&) = "he_gl_program_log";
extern fn use_program(p: i32) = "he_gl_use_program";
extern fn uniform_loc(p: i32, name: const u8[:]) -> i32 = "he_gl_uniform_loc";
extern fn uniform1f(loc: i32, x: f64) = "he_gl_uniform1f";
extern fn uniform2f(loc: i32, x: f64, y: f64) = "he_gl_uniform2f";
extern fn uniform3f(loc: i32, x: f64, y: f64, z: f64) = "he_gl_uniform3f";
extern fn uniform4f(loc: i32, x: f64, y: f64, z: f64, w: f64) = "he_gl_uniform4f";
extern fn uniform1i(loc: i32, v: i32) = "he_gl_uniform1i";
extern fn uniform_mat4(loc: i32, m: const f32[:]) = "he_gl_uniform_mat4";
extern fn create_buffer() -> i32 = "he_gl_create_buffer";
extern fn bind_buffer(target: i32, b: i32) = "he_gl_bind_buffer";
extern fn buffer_data(target: i32, data: const u8[:], usage: i32) = "he_gl_buffer_data";
extern fn buffer_alloc(target: i32, bytes: i32, usage: i32) = "he_gl_buffer_alloc";
extern fn buffer_sub(target: i32, offset: i32, data: const u8[:]) = "he_gl_buffer_sub";
extern fn create_vao() -> i32 = "he_gl_create_vao";
extern fn bind_vao(v: i32) = "he_gl_bind_vao";
extern fn attrib_ptr(idx: i32, size: i32, kind: i32, norm: bool, stride: i32, offset: i32) = "he_gl_attrib_ptr";
extern fn enable_attrib(idx: i32) = "he_gl_enable_attrib";
extern fn disable_attrib(idx: i32) = "he_gl_disable_attrib";
extern fn attrib_divisor(idx: i32, d: i32) = "he_gl_attrib_divisor";
extern fn draw_arrays(mode: i32, first: i32, count: i32) = "he_gl_draw_arrays";
extern fn draw_elements(mode: i32, count: i32, kind: i32, offset: i32) = "he_gl_draw_elements";
extern fn draw_arrays_instanced(mode: i32, first: i32, count: i32, n: i32) = "he_gl_draw_arrays_instanced";
extern fn create_texture() -> i32 = "he_gl_create_texture";
extern fn bind_texture(target: i32, t: i32) = "he_gl_bind_texture";
extern fn active_texture(unit: i32) = "he_gl_active_texture";
extern fn tex_rgba(w: i32, h: i32, data: const u8[:]) = "he_gl_tex_rgba";
extern fn tex_param(target: i32, name: i32, v: i32) = "he_gl_tex_param";
extern fn generate_mipmap(target: i32) = "he_gl_generate_mipmap";
extern fn delete(h: i32) = "he_gl_delete";
extern fn drawing_w() -> i32 = "he_gl_drawing_w";
extern fn drawing_h() -> i32 = "he_gl_drawing_h";
