// Step-reduced, not the problem's algorithm: the generator's numbers are
// made in another order (see below), the output byte for byte that of 2.amni.
// The output of 1.amni and 2.amni, from the same generator, in fewer steps. The
// generator's quotient by IM, for a seed s below IM, is (3877 s + 29573) /
// IM rounded down, which a multiply by a fixed-point 3877 / IM, an add and
// a shift give exactly (checked for every seed), while 3877 s + 29573 is
// made beside it: the chain from one seed to the next is then two multiplies
// rather than three. And each letter comes from a table of the letter for
// every random number, filled from the cumulative probabilities once, rather
// than from comparing the number with each of them.

import std;
import os;
import math;

let LINE = 60;
let FLUSH = 1 << 20;
let IM = 139968;

let ALU = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA";

// The benchmark's naive linear congruential generator.
inline fn next_random(s uint) uint {
	let q = (s * 475868433 + 3629831612) >> 34;
	return s * 3877 + 29573 - q * IM;
}

fn flush_if_full(out byte[>..]&) {
	if out.len >= FLUSH {
		write_stdout(out);
		out.clear();
	}
}

fn repeat_fasta(out byte[>..]&, seq byte[:], count int) {
	// The sequence followed by a line's worth of its start, so that every
	// line is one slice of it.
	var padded byte[>..] = [];
	padded.append(seq);
	padded.append(seq[..LINE]);
	var off = 0;
	var left = count;
	while left > 0 {
		let len = min(LINE, left);
		out.append(padded[off..off + len]);
		out.push('\n');
		off += len;
		if off >= seq.len { off -= seq.len; }
		left -= len;
		flush_if_full(out);
	}
}

// The generator is s -> (3877 s + 29573) mod IM, so n steps of it are one
// step of the same form, s -> (A s + C) mod IM. A line's 60 numbers are then
// 60 chains that each step a whole line at a time, with nothing linking one
// column's multiplies to the next column's, in place of one chain of 60
// steps: the same numbers, in the same order, worked on side by side.
fn jump(n int) uint, uint {
	var A uint = 1;
	var C uint = 0;
	for i in n {
		A = A * 3877 % IM;
		C = (C * 3877 + 29573) % IM;
	}
	return A, C;
}
// Appends count nucleotides of the distribution, returning the generator's
// state to go on from.
fn random_fasta(out byte[>..]&, seed uint, probs real[:], chars byte[:], count int) uint {
	// The letter of r is that of the first cumulative probability above
	// r / IM, as 1.amni finds it.
	var table byte[>..] = [];
	table.resize(IM, 0);
	var cum = 0.0;
	var r = 0;
	for p, i in probs {
		cum += p;
		let t = min(ceil(cum * IM) as int, IM);
		while r < t {
			table[r] = chars[i];
			r++;
		}
	}
	// Column j holds the number of line k's column j, starting from line 0's.
	var col uint[60] = [0; 60];
	var s = seed;
	for j in LINE {
		s = next_random(s);
		col[j] = s;
	}
	let A, C = jump(LINE);
	var last = seed;
	var left = count;
	while left > 0 {
		let len = min(LINE, left);
		let start = out.len;
		out.resize(start + len + 1, '\n');
		let line = out[start..start + len];
		for j in len {
			line[j] = table[col[j] as! int];
		}
		last = col[len - 1];
		for j in LINE {
			col[j] = (A * col[j] + C) % IM;
		}
		left -= len;
		flush_if_full(out);
	}
	return last;
}
fn main() {
	let a = args();
	var n = 1000;
	if a.len > 1 { let v, ok = parse_int(a[1]); if ok { n = v; } }
	var out byte[>..] = [];
	out.append(">ONE Homo sapiens alu\n");
	repeat_fasta(out, ALU, 2 * n);
	var seed uint = 42;
	out.append(">TWO IUB ambiguity codes\n");
	seed = random_fasta(out, seed, [0.27, 0.12, 0.12, 0.27, 0.02, 0.02, 0.02, 0.02,
									0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02],
						"acgtBDHKMNRSVWY", 3 * n);
	out.append(">THREE Homo sapiens frequency\n");
	seed = random_fasta(out, seed, [0.3029549426680, 0.1979883004921, 0.1975473066391, 0.3015094502008],
						"acgt", 5 * n);
	write_stdout(out);
}
