// The work split of 1-m.amni, with the generator and the letter tables of
// 2.amni: one worker makes the repeated sequence, another the two random
// ones, in 256 KB blocks that the main thread writes out as they arrive.

import std;
import os;
import math;

let LINE = 60;
let BLOCK = 1 << 18;
let IM = 139968;

let ALU = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA";

// The benchmark's naive linear congruential generator.
inline fn next_random(s uint) uint {
	let q = (s * 475868433 + 3629831612) >> 34;
	return s * 3877 + 29573 - q * IM;
}

// A block of output; the last of each part is marked.
struct Fixed { last bool, data byte[] }
struct Random { last bool, data byte[] }

fn send_fixed(out byte[>..]&) { qput(Fixed { last: false, data: copy(out) }); }
fn send_random(out byte[>..]&) { qput(Random { last: false, data: copy(out) }); }

// Send is one of the two above.
fn flush_if_full<Send>(out byte[>..]&) {
	if out.len >= BLOCK {
		Send(out);
		out.clear();
	}
}

fn repeat_fasta<Send>(out byte[>..]&, seq byte[:], count int) {
	// The sequence followed by a line's worth of its start, so that every
	// line is one slice of it.
	var padded byte[>..] = [];
	padded.append(seq);
	padded.append(seq[..LINE]);
	var off = 0;
	var left = count;
	while left > 0 {
		let len = min(LINE, left);
		out.append(padded[off..off + len]);
		out.push('\n');
		off += len;
		if off >= seq.len { off -= seq.len; }
		left -= len;
		flush_if_full(out, Send);
	}
}

// Appends count nucleotides of the distribution, returning the generator's
// state to go on from.
fn random_fasta<Send>(out byte[>..]&, seed uint, probs real[:], chars byte[:], count int) uint {
	// The letter of r is that of the first cumulative probability above
	// r / IM, as 1.amni finds it.
	var table byte[>..] = [];
	table.resize(IM, 0);
	var cum = 0.0;
	var r = 0;
	for p, i in probs {
		cum += p;
		let t = min(ceil(cum * IM) as int, IM);
		while r < t {
			table[r] = chars[i];
			r++;
		}
	}
	var s = seed;
	var left = count;
	while left > 0 {
		let len = min(LINE, left);
		let start = out.len;
		out.resize(start + len + 1, '\n');
		for &c in out[start..start + len] {
			s = next_random(s);
			c = table[s as! int];
		}
		left -= len;
		flush_if_full(out, Send);
	}
	return s;
}

thread_fn fixed_part(n: int) {
	var out byte[>..] = [];
	out.append(">ONE Homo sapiens alu\n");
	repeat_fasta(out, ALU, 2 * n, send_fixed);
	qput(Fixed { last: true, data: copy(out) });
}

thread_fn random_part(n: int) {
	var out byte[>..] = [];
	var seed uint = 42;
	out.append(">TWO IUB ambiguity codes\n");
	seed = random_fasta(out, seed, [0.27, 0.12, 0.12, 0.27, 0.02, 0.02, 0.02, 0.02,
									0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02],
						"acgtBDHKMNRSVWY", 3 * n, send_random);
	out.append(">THREE Homo sapiens frequency\n");
	seed = random_fasta(out, seed, [0.3029549426680, 0.1979883004921, 0.1975473066391, 0.3015094502008],
						"acgt", 5 * n, send_random);
	qput(Random { last: true, data: copy(out) });
}

fn main() {
	let a = args();
	var n = 1000;
	if a.len > 1 { let v, ok = parse_int(a[1]); if ok { n = v; } }
	let fixed = thread_spawn(fixed_part, n);
	let random = thread_spawn(random_part, n);
	loop {
		let b = qget<Fixed>();
		write_stdout(b.data);
		if b.last { break; }
	}
	loop {
		let b = qget<Random>();
		write_stdout(b.data);
		if b.last { break; }
	}
	thread_wait(fixed);
	thread_wait(random);
}
