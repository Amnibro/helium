import std;
import os;

// Step-reduced, not the problem's algorithm: the same counts with less work.
// The naive sieve has every prime mark all its multiples; this one keeps
// only the odd numbers (a bit each), and only primes up to the square root of
// n mark, from their square on, since every smaller multiple, and every
// multiple of a larger prime, has a smaller prime factor that marked it
// already. 2.amni is the problem's algorithm. The three sieves run at once,
// one thread each, as in 2-m.amni.

fn nsieve(n int) int {
	if n <= 2 { return 0; }
	let odds = n >> 1;                  // bit k stands for 2k + 1
	var flags u32[>..] = [];
	flags.resize((odds + 31) >> 5, 0);
	var k = 1;
	while (2 * k + 1) * (2 * k + 1) < n {
		if (flags[k >> 5] >> k) & 1 == 0 {
			let p = 2 * k + 1;
			var j = (p * p) >> 1;
			while j < odds {
				flags[j >> 5] |= (1 as u32) << j;
				j += p;
			}
		}
		k++;
	}
	var count = 1;
	for w, i in flags {
		let bits = if (i + 1) * 32 <= odds { w } else { w | ~(((1 as u32) << (odds - i * 32)) - 1) };
		count += 32 - popcount(bits);
	}
	return count - 1;
}

struct Count { n int, count int }

thread_fn sieve(n: int) {
	qput(Count { n: n, count: nsieve(n) });
}

fn main() {
	let a = args();
	var n = 4;
	if a.len > 1 { let v, ok = parse_int(a[1]); if ok { n = v; } }
	var ids int[>..] = [];
	for i in 3 { ids.push(thread_spawn(sieve, 10000 << (n - i))); }
	var counts int[3] = [0; 3];
	for k in 3 {
		let c = qget<Count>();
		for i in 3 { if c.n == 10000 << (n - i) { counts[i] = c.count; } }
	}
	for id in ids { thread_wait(id); }
	for i in 3 {
		var line byte[>..] = [];
		line.append("Primes up to ");
		format_int(line, 10000 << (n - i), 10, 8, ' ');
		line.push(' ');
		format_int(line, counts[i], 10, 8, ' ');
		print(line);
	}
}
