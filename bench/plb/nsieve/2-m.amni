import std;
import os;

// 2.amni's three sieves at once, one thread each: they share nothing, so the
// run takes as long as the largest. Each is 2.amni's sieve unchanged (bits of
// u32 words, a set bit marking a composite, every prime marking all its
// multiples); the counts come back in any order and are printed in 2.amni's.

struct Count { n int, count int }

fn nsieve(n int) int {
	var flags u32[>..] = [];
	flags.resize((n + 31) >> 5, 0);
	var count = 0;
	for i in 2..n {
		if (flags[i >> 5] >> i) & 1 == 0 {
			count++;
			var j = i << 1;
			while j < n {
				flags[j >> 5] |= (1 as u32) << j;
				j += i;
			}
		}
	}
	return count;
}

thread_fn sieve(n: int) {
	qput(Count { n: n, count: nsieve(n) });
}

fn main() {
	let a = args();
	var n = 4;
	if a.len > 1 { let v, ok = parse_int(a[1]); if ok { n = v; } }
	var ids int[>..] = [];
	for i in 3 { ids.push(thread_spawn(sieve, 10000 << (n - i))); }
	var counts int[3] = [0; 3];
	for k in 3 {
		let c = qget<Count>();
		for i in 3 { if c.n == 10000 << (n - i) { counts[i] = c.count; } }
	}
	for id in ids { thread_wait(id); }
	for i in 3 {
		var line byte[>..] = [];
		line.append("Primes up to ");
		format_int(line, 10000 << (n - i), 10, 8, ' ');
		line.push(' ');
		format_int(line, counts[i], 10, 8, ' ');
		print(line);
	}
}
