// The third sequence is read into memory once and coded two bits a
// nucleotide (A 0, C 1, T 2, G 3: bits 1 and 2 of the letter, either case),
// in place over the file's own bytes. Each k-nucleotide is then the last k
// codes packed into an integer, counted in a hash table of this program's
// own, as C's program has: open addressing and linear probing over a
// power-of-two array of u64 slots, each holding a key and its count, which
// starts with room for every key there can be, up to 2^20 slots, and
// doubles at half load. Half rather than the usual three quarters, as most
// lookups then end at the first slot they try, which spares a mispredicted
// branch on most of the others. A k of at most 6 has few enough keys to
// count each in a counter of its own, indexed by the key, and its counts go
// into such a table after. (2.amni counts with the library's dictionary
// instead.)

import std;
import os;

// A slot holds 0 when it is unused, else the key, a set bit and the count in
// the low COUNT_BITS bits: one compare of the bits above the count tests the
// key, and the count increments in place.
let COUNT_BITS = 27;
let COUNT_MASK uint = (1 << COUNT_BITS) - 1;

fn home(key uint) int { (key ^ (key >> 7)) as! int }

fn code_of(c byte) byte { (c >> 1) & 3 }

// The codes of the sequence after the line starting with ">THREE", written
// over the start of text.
fn read_three(text byte[:]) byte[:] {
	let header = byte_set(">");
	var at = 0;
	loop {
		let k = find_any(text[at..], header);
		assert(k >= 0);
		at += k;
		if starts_with(text[at..], ">THREE") { break; }
		at += 1;
	}
	at += find(text[at..], "\n") + 1;
	var end = find_any(text[at..], header);
	end = if end < 0 { text.len } else { at + end };
	// Every byte is stored, and the next one overwrites a newline's.
	var n = 0;
	for c in text[at..end] {
		text[n] = code_of(c);
		n += if c != '\n' { 1 } else { 0 };
	}
	return text[..n];
}

// Doubles the table, putting every entry in again.
fn grow(slots uint[>..]&) {
	var old uint[>..] = [];
	old.append(slots);
	slots.clear();
	slots.resize(old.len * 2, 0);
	let mask = slots.len - 1;
	for v in old {
		guard v != 0;
		var i = home(v >> (COUNT_BITS + 1)) & mask;
		while slots[i] != 0 { i = (i + 1) & mask; }
		slots[i] = v;
	}
}

// As count, for a k small enough that every key has a counter of its own,
// indexed by the key; the counts then go into a table as count makes it.
fn count_small(seq byte[:], k int) uint[>..] {
	var counts uint[>..] = [];
	counts.resize(1 << (2 * k), 0);
	let key_mask uint = (1 << (2 * k)) - 1;
	var codes uint = 0;
	for c in seq[..k - 1] { codes = (codes << 2) | c; }
	for c in seq[k - 1..] {
		codes = (codes << 2) | c;
		counts[(codes & key_mask) as! int] += 1;
	}
	var slots uint[>..] = [];
	slots.resize(2 * counts.len, 0);
	let mask = slots.len - 1;
	for n, key in counts {
		guard n != 0;
		var i = home(key as uint) & mask;
		while slots[i] != 0 { i = (i + 1) & mask; }
		slots[i] = (((key as uint) << 1 | 1) << COUNT_BITS) | n;
	}
	return slots;
}

// The table of the k-nucleotides of seq.
fn count(seq byte[:], k int) uint[>..] {
	if k <= 6 { return count_small(seq, k); }
	// Room for every distinct key there can be at most half full, up to
	// 2^20 slots: the big tables start near their final size.
	var cap = 16;
	while cap < 2 * min(seq.len, 1 << min(2 * k, 19)) { cap *= 2; }
	var slots uint[>..] = [];
	slots.resize(cap, 0);
	var used = 0;
	let key_mask uint = (1 << (2 * k)) - 1;
	// The codes so far, the last k of them the key: shifting the earlier
	// ones out of the word rather than masking them off keeps the masking
	// out of the chain from one position to the next.
	var codes uint = 0;
	for c in seq[..k - 1] { codes = (codes << 2) | c; }
	for c in seq[k - 1..] {
		codes = (codes << 2) | c;
		let key = codes & key_mask;
		let tag = (key << 1) | 1;
		let mask = slots.len - 1;
		var i = home(key);
		loop {
			let s = i & mask;
			let v = slots[s];
			if v >> COUNT_BITS == tag { slots[s] = v + 1; break; }
			if v == 0 {
				slots[s] = (tag << COUNT_BITS) | 1;
				used++;
				if used * 2 > slots.len { grow(slots); }
				break;
			}
			i++;
		}
	}
	return slots;
}

fn decode(out byte[>..]&, key uint, k int) {
	for i in k {
		out.push("ACTG"[((key >> (2 * (k - 1 - i))) & 3) as! int]);
	}
}

struct Entry { key uint, count int }

fn frequencies(out byte[>..]&, seq byte[:], k int) {
	let slots = count(seq, k);
	var entries Entry[>..] = [];
	var total = 0;
	for v in slots {
		guard v != 0;
		let n = (v & COUNT_MASK) as! int;
		entries.push(Entry { v >> (COUNT_BITS + 1), n });
		total += n;
	}
	sort(entries) { a, b => a.count > b.count || (a.count == b.count && a.key > b.key) };
	for e in entries {
		decode(out, e.key, k);
		out.push(' ');
		format_flt(out, (e.count as f32 * 100.0) / total, 3);
		out.push('\n');
	}
	out.push('\n');
}

fn occurrences(out byte[>..]&, seq byte[:], name byte[:]) {
	let slots = count(seq, name.len);
	var key uint = 0;
	for c in name { key = (key << 2) | code_of(c); }
	let tag = (key << 1) | 1;
	var n uint = 0;
	let mask = slots.len - 1;
	var i = home(key) & mask;
	while slots[i] != 0 {
		if slots[i] >> COUNT_BITS == tag { n = slots[i] & COUNT_MASK; break; }
		i = (i + 1) & mask;
	}
	format(out, n, "\t", name, "\n");
}

fn main() {
	let a = args();
	assert(a.len > 1);
	var text byte[>..] = [];
	if !read_file(a[1], text) { abort("cannot read the input"); }
	let seq = read_three(text);
	var out byte[>..] = [];
	frequencies(out, seq, 1);
	frequencies(out, seq, 2);
	for name in ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"] {
		occurrences(out, seq, name);
	}
	write_stdout(out);
}
