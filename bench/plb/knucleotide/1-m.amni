// The single-threaded program's counting (see 1.amni), with the k counted
// by four worker threads: they take jobs from a queue, the largest first,
// and send back the text of their part of the output. Each worker gets a
// copy of the coded sequence as it starts, packed four codes a byte to keep
// the copies small, which the main thread packs straight from the file's
// text, eight bytes at a time.

import std;
import os;

// A slot holds 0 when it is unused, else the key, a set bit and the count in
// the low COUNT_BITS bits: one compare of the bits above the count tests the
// key, and the count increments in place.
let COUNT_BITS = 27;
let COUNT_MASK uint = (1 << COUNT_BITS) - 1;
let CHUNK = 1 << 14;

fn home(key uint) int { (key ^ (key >> 7)) as! int }

fn code_of(c byte) byte { (c >> 1) & 3 }

// Where the sequence after the line starting with ">THREE" starts and ends
// in text.
fn three(text byte[:]) int, int {
	let header = byte_set(">");
	var at = 0;
	loop {
		let k = find_any(text[at..], header);
		assert(k >= 0);
		at += k;
		if starts_with(text[at..], ">THREE") { break; }
		at += 1;
	}
	at += find(text[at..], "\n") + 1;
	let end = find_any(text[at..], header);
	return at, if end < 0 { text.len } else { at + end };
}

// The input's sequence after the line starting with ">THREE", coded and
// packed four codes a byte, the first in the top bits, and its length. The
// text goes when this returns, so only the packed codes stay. Eight bytes
// without a newline, read as one word, pack into two bytes at once while
// the codes so far are a whole number of bytes: the code of each byte is
// its bits 1 and 2, and the shifts gather each four codes into a byte.
fn load(path byte[:]) byte[>..], int {
	var text byte[>..] = [];
	if !read_file(path, text) { abort("cannot read the input"); }
	let at, end = three(text);
	var packed byte[>..] = [];
	packed.resize((end - at + 3) / 4 + 1, 0);
	var n = 0;
	var i = at;
	while i < end {
		if i + 8 <= end && n & 3 == 0 {
			let d = text[i..i + 8];
			let w = (d[0] as uint) | (d[1] as uint) << 8 | (d[2] as uint) << 16 | (d[3] as uint) << 24 | (d[4] as uint) << 32 | (d[5] as uint) << 40 | (d[6] as uint) << 48 | (d[7] as uint) << 56;
			let x = w ^ 0x0A0A0A0A0A0A0A0A;
			if ((x - 0x0101010101010101) & ~x & 0x8080808080808080) == 0 {
				let c = (w >> 1) & 0x0303030303030303;
				let p = ((c << 2) | (c >> 8)) & 0x000F000F000F000F;
				let q = ((p << 4) | (p >> 16)) & 0x000000FF000000FF;
				packed[n >> 2] = q as! byte;
				packed[(n >> 2) + 1] = (q >> 32) as! byte;
				n += 8;
				i += 8;
				continue;
			}
		}
		let c = text[i];
		if c != '\n' {
			packed[n >> 2] |= code_of(c) << (6 - 2 * (n & 3));
			n++;
		}
		i++;
	}
	packed.resize((n + 3) / 4);
	return packed, n;
}

// Doubles the table, putting every entry in again.
fn grow(slots uint[>..]&) {
	var old uint[>..] = [];
	old.append(slots);
	slots.clear();
	slots.resize(old.len * 2, 0);
	let mask = slots.len - 1;
	for v in old {
		guard v != 0;
		var i = home(v >> (COUNT_BITS + 1)) & mask;
		while slots[i] != 0 { i = (i + 1) & mask; }
		slots[i] = v;
	}
}

// The table of counts, a k-nucleotide's count at its key, put into a table
// as count makes it.
fn table_of(counts uint[:]) uint[>..] {
	var slots uint[>..] = [];
	slots.resize(2 * counts.len, 0);
	let mask = slots.len - 1;
	for n, key in counts {
		guard n != 0;
		var i = home(key as uint) & mask;
		while slots[i] != 0 { i = (i + 1) & mask; }
		slots[i] = (((key as uint) << 1 | 1) << COUNT_BITS) | n;
	}
	return slots;
}

// The table of the k-nucleotides of the n codes packed, which are unpacked
// a chunk at a time into a buffer that stays in the cache. A k of at most 6
// has few enough keys to count each in a counter of its own, indexed by the
// key, with no table to search.
fn count(packed byte[:], n int, k int) uint[>..] {
	let small = k <= 6;
	var counts uint[>..] = [];
	counts.resize(if small { 1 << (2 * k) } else { 0 }, 0);
	// Room for every distinct key there can be at most half full, up to
	// 2^20 slots: the big tables start near their final size.
	var cap = 16;
	while !small && cap < 2 * min(n, 1 << min(2 * k, 19)) { cap *= 2; }
	var slots uint[>..] = [];
	slots.resize(cap, 0);
	var used = 0;
	var chunk byte[>..] = [];
	chunk.resize(CHUNK, 0);
	let key_mask uint = (1 << (2 * k)) - 1;
	// The codes so far, the last k of them the key (see 1.amni).
	var codes uint = 0;
	var pos = 0;
	while pos < n {
		let m = min(CHUNK, n - pos);
		for b, i in packed[pos >> 2..(pos + m + 3) >> 2] {
			let d = chunk[4 * i..4 * i + 4];
			d[0] = b >> 6;
			d[1] = (b >> 4) & 3;
			d[2] = (b >> 2) & 3;
			d[3] = b & 3;
		}
		var from = 0;
		if pos == 0 {
			for c in chunk[..k - 1] { codes = (codes << 2) | c; }
			from = k - 1;
		}
		if small {
			for c in chunk[from..m] {
				codes = (codes << 2) | c;
				counts[(codes & key_mask) as! int] += 1;
			}
			pos += m;
			continue;
		}
		for c in chunk[from..m] {
			codes = (codes << 2) | c;
			let key = codes & key_mask;
			let tag = (key << 1) | 1;
			let mask = slots.len - 1;
			var i = home(key);
			loop {
				let s = i & mask;
				let v = slots[s];
				if v >> COUNT_BITS == tag { slots[s] = v + 1; break; }
				if v == 0 {
					slots[s] = (tag << COUNT_BITS) | 1;
					used++;
					if used * 2 > slots.len { grow(slots); }
					break;
				}
				i++;
			}
		}
		pos += m;
	}
	return if small { table_of(counts[..]) } else { slots };
}

fn decode(out byte[>..]&, key uint, k int) {
	for i in k {
		out.push("ACTG"[((key >> (2 * (k - 1 - i))) & 3) as! int]);
	}
}

struct Entry { key uint, count int }

fn frequencies(out byte[>..]&, packed byte[:], n int, k int) {
	let slots = count(packed, n, k);
	var entries Entry[>..] = [];
	var total = 0;
	for v in slots {
		guard v != 0;
		let n = (v & COUNT_MASK) as! int;
		entries.push(Entry { v >> (COUNT_BITS + 1), n });
		total += n;
	}
	sort(entries) { a, b => a.count > b.count || (a.count == b.count && a.key > b.key) };
	for e in entries {
		decode(out, e.key, k);
		out.push(' ');
		format_flt(out, (e.count as f32 * 100.0) / total, 3);
		out.push('\n');
	}
	out.push('\n');
}

fn occurrences(out byte[>..]&, packed byte[:], n int, name byte[:]) {
	let slots = count(packed, n, name.len);
	var key uint = 0;
	for c in name { key = (key << 2) | code_of(c); }
	let tag = (key << 1) | 1;
	var n uint = 0;
	let mask = slots.len - 1;
	var i = home(key) & mask;
	while slots[i] != 0 {
		if slots[i] >> COUNT_BITS == tag { n = slots[i] & COUNT_MASK; break; }
		i = (i + 1) & mask;
	}
	format(out, n, "\t", name, "\n");
}

// A part of the output: the frequencies of the k-nucleotides where name is
// empty, else the count of name; k == 0 tells a worker to stop.
struct Job { part int, k int, name byte[..18] }
struct Report { part int, text byte[] }

thread_fn worker(packed: byte[], n: int) {
	loop {
		let job = qget<Job>();
		guard job.k > 0 else { break; }
		var out byte[>..] = [];
		if job.name.len == 0 {
			frequencies(out, packed, n, job.k);
		} else {
			occurrences(out, packed, n, job.name);
		}
		qput(Report { part: job.part, text: copy(out) });
	}
}

fn main() {
	let a = args();
	assert(a.len > 1);
	let packed, n = load(a[1]);
	let names = ["GGT", "GGTA", "GGTATT", "GGTATTTTAATT", "GGTATTTTAATTTATAGT"];
	let parts = 2 + names.len;
	for i in names.len {
		let name = names[names.len - 1 - i];
		qput(Job { part: parts - 1 - i, k: name.len, name: name });
	}
	qput(Job { part: 1, k: 2, name: "" });
	qput(Job { part: 0, k: 1, name: "" });
	// One worker for each big table and two for the five small ones.
	let workers = clamp(hardware_threads(), 1, 4);
	for i in workers { qput(Job { part: 0, k: 0, name: "" }); }
	var ids int[>..] = [];
	for i in workers { ids.push(thread_spawn(worker, packed[..], n)); }
	// The parts arrive in any order; at[p] is where part p's text went.
	var reports byte[>..] = [];
	var at int[>..] = [];
	at.resize(parts, 0);
	var len int[>..] = [];
	len.resize(parts, 0);
	for i in parts {
		let r = qget<Report>();
		at[r.part] = reports.len;
		len[r.part] = r.text.len;
		reports.append(r.text);
	}
	for id in ids { thread_wait(id); }
	var out byte[>..] = [];
	for p in parts { out.append(reports[at[p]..at[p] + len[p]]); }
	write_stdout(out);
}
