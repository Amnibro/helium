def main():
    n = 12
    blocked = lambda r, c: (r * 7 + c * 3) % 11 == 5
    dp = [[0] * n for _ in range(n)]
    for r in range(n):
        for c in range(n):
            if blocked(r, c):
                dp[r][c] = 0
            elif r == 0 and c == 0:
                dp[r][c] = 1
            else:
                up = dp[r - 1][c] if r > 0 else 0
                left = dp[r][c - 1] if c > 0 else 0
                dp[r][c] = up + left
    print(dp[n - 1][n - 1])

main()
