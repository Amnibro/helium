fn main() {
    const N: usize = 12;
    let mut dp = [[0u64; N]; N];
    for r in 0..N {
        for c in 0..N {
            if (r * 7 + c * 3) % 11 == 5 {
                dp[r][c] = 0;
                continue;
            }
            if r == 0 && c == 0 {
                dp[r][c] = 1;
                continue;
            }
            let mut v = 0;
            if r > 0 {
                v += dp[r - 1][c];
            }
            if c > 0 {
                v += dp[r][c - 1];
            }
            dp[r][c] = v;
        }
    }
    println!("{}", dp[N - 1][N - 1]);
}
