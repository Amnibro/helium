fn main() {
    let mut x: u64 = 7;
    let mut tails: Vec<u64> = Vec::new();
    for _ in 0..2000 {
        x = (x * 1103515245 + 12345) % 2147483648;
        let v = x % 1000;
        let pos = tails.partition_point(|&t| t < v);
        if pos == tails.len() {
            tails.push(v);
        } else {
            tails[pos] = v;
        }
    }
    println!("{}", tails.len());
}
