use std::collections::BTreeMap;

fn parse_cents(s: &str) -> i64 {
    let mut parts = s.split('.');
    let whole: i64 = parts.next().unwrap_or("0").parse().unwrap_or(0);
    let frac = parts.next().unwrap_or("");
    let mut f = String::from(frac);
    while f.len() < 2 {
        f.push('0');
    }
    let f: i64 = f[..2].parse().unwrap_or(0);
    whole * 100 + f
}

fn main() {
    let data = "o1,alice,widget,3,2.50;o2,bob,gadget,1,10.00;o3,alice,gadget,2,10.00;o4,cara,widget,10,2.50;o5,bob,doohickey,4,7.25;o6,cara,gadget,1,10.00";
    let mut totals: BTreeMap<String, i64> = BTreeMap::new();
    for rec in data.split(';') {
        let f: Vec<&str> = rec.split(',').collect();
        if f.len() < 5 {
            continue;
        }
        let q: i64 = f[3].trim().parse().unwrap_or(0);
        let p = parse_cents(f[4].trim());
        *totals.entry(f[1].to_string()).or_insert(0) += q * p;
    }
    let mut v: Vec<(String, i64)> = totals.into_iter().collect();
    v.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
    for (n, t) in v {
        println!("{} {}.{:02}", n, t / 100, t % 100);
    }
}
