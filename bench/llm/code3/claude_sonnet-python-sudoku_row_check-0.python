def main():
    n = 4
    grid = [[0] * n for _ in range(n)]
    grid[0] = [1, 2, 3, 4]
    count = 0
    first = None

    def solve(pos):
        nonlocal count, first
        if pos == n * n:
            count += 1
            if first is None:
                first = [row[:] for row in grid]
            return
        r, c = divmod(pos, n)
        if r == 0:
            solve(pos + 1)
            return
        for v in range(1, n + 1):
            if any(grid[r][j] == v for j in range(c)):
                continue
            if any(grid[i][c] == v for i in range(r)):
                continue
            grid[r][c] = v
            solve(pos + 1)
            grid[r][c] = 0

    solve(0)
    print(count)
    for row in first:
        print(" ".join(map(str, row)))


main()
