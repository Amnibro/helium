def count(s, words):
    n = len(s)
    dp = [0] * (n + 1)
    dp[0] = 1
    for i in range(1, n + 1):
        for w in words:
            l = len(w)
            if l <= i and s[i - l:i] == w:
                dp[i] += dp[i - l]
    return dp[n]

words = ["apple", "pen", "applepen", "pine", "pineapple", "cats", "dog", "sand", "and", "cat"]
for s in ["pineapplepenapple", "catsandog", "catsanddog", "applepenpine"]:
    print(s, count(s, words))
