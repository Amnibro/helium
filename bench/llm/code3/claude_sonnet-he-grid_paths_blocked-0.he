N = 12
dp: list[list[int]] = [[0] * N for _ in range(N)]
for r in range(N):
    for c in range(N):
        if (r * 7 + c * 3) % 11 == 5:
            dp[r][c] = 0
        elif r == 0 and c == 0:
            dp[r][c] = 1
        else:
            v = 0
            if r > 0:
                v += dp[r - 1][c]
            if c > 0:
                v += dp[r][c - 1]
            dp[r][c] = v
print(dp[N - 1][N - 1])
