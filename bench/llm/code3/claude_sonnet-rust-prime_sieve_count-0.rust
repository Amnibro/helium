fn main() {
    const N: usize = 20_000_000;
    let mut sieve = vec![true; N];
    sieve[0] = false;
    sieve[1] = false;
    let mut i = 2;
    while i * i < N {
        if sieve[i] {
            let mut j = i * i;
            while j < N {
                sieve[j] = false;
                j += i;
            }
        }
        i += 1;
    }
    let count = sieve.iter().filter(|&&b| b).count();
    println!("{}", count);
}
