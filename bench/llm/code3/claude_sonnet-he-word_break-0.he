words: set[str] = {"apple", "pen", "applepen", "pine", "pineapple", "cats", "dog", "sand", "and", "cat"}

def count_ways(s: str) -> int:
    n = len(s)
    dp: list[int] = [0] * (n + 1)
    dp[0] = 1
    for i in range(1, n + 1):
        total = 0
        for j in range(i):
            if dp[j] > 0 and s[j:i] in words:
                total += dp[j]
        dp[i] = total
    return dp[n]

for w in ["pineapplepenapple", "catsandog", "catsanddog", "applepenpine"]:
    print(f"{w} {count_ways(w)}")
