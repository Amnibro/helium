from math import sqrt

limit = 3000
lim2 = limit * limit
count = 0
for a in range(1, limit + 1):
    for b in range(a + 1, limit + 1):
        s = a * a + b * b
        if s > lim2:
            break
        c = int(sqrt(s))
        while c * c > s:
            c -= 1
        while (c + 1) * (c + 1) <= s:
            c += 1
        if c * c == s:
            count += 1
print(count)
