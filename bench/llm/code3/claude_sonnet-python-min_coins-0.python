def main():
    coins = [1, 7, 10, 22]
    targets = [14, 30, 59, 100, 999]
    m = max(targets)
    INF = float("inf")
    dp = [0] + [INF] * m
    for a in range(1, m + 1):
        for c in coins:
            if c <= a and dp[a - c] + 1 < dp[a]:
                dp[a] = dp[a - c] + 1
    print(" ".join(str(dp[t]) for t in targets))

main()
