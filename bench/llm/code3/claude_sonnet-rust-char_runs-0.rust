fn main() {
    let s = "aaabccddddeffffffg";
    let mut best_c = ' ';
    let mut best_n = 0;
    let mut cur_c = ' ';
    let mut cur_n = 0;
    for c in s.chars() {
        if c == cur_c {
            cur_n += 1;
        } else {
            cur_c = c;
            cur_n = 1;
        }
        if cur_n > best_n {
            best_n = cur_n;
            best_c = cur_c;
        }
    }
    println!("{} {}", best_c, best_n);
}
