fn gcd(mut a: u64, mut b: u64) -> u64 {
    while b != 0 {
        let t = a % b;
        a = b;
        b = t;
    }
    a
}

fn lcm(a: u64, b: u64) -> u64 {
    if a == 0 || b == 0 {
        0
    } else {
        a / gcd(a, b) * b
    }
}

fn main() {
    println!("{} {}", gcd(1071, 462), lcm(21, 6));
    println!("{}", gcd(123456789, 987654321));
}
