struct E { a int, b int, w int }

fn main() {
	let edges E[12] = [
		E { 0, 1, 7 }, E { 0, 2, 9 }, E { 0, 5, 14 }, E { 1, 2, 10 },
		E { 1, 3, 15 }, E { 2, 3, 11 }, E { 2, 5, 2 }, E { 3, 4, 6 },
		E { 4, 5, 9 }, E { 5, 4, 3 }, E { 4, 6, 1 }, E { 3, 6, 20 },
	];
	let INF = 1000000000;
	var dist int[7] = [1000000000; 7];
	dist[0] = 0;
	var changed = true;
	while changed {
		changed = false;
		for e in edges {
			if dist[e.a] < INF && dist[e.a] + e.w < dist[e.b] {
				dist[e.b] = dist[e.a] + e.w;
				changed = true;
			}
		}
	}
	var s byte[>..] = [];
	for i in 7 {
		if i > 0 { s.push(' '); }
		format(s, dist[i]);
	}
	print(s);
}
