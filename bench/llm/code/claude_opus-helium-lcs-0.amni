fn lcs(a const byte[:], b const byte[:]) int {
	let n = a.len;
	let m = b.len;
	let w = m + 1;
	var dp int[>..] = [];
	dp.resize((n + 1) * w, 0);
	for i in 1..n + 1 {
		for j in 1..m + 1 {
			if a[i - 1] == b[j - 1] {
				dp[i * w + j] = dp[(i - 1) * w + (j - 1)] + 1;
			} else {
				dp[i * w + j] = max(dp[(i - 1) * w + j], dp[i * w + (j - 1)]);
			}
		}
	}
	dp[n * w + m]
}

fn main() {
	print(lcs("ACCGGTCGAGTGCGCGGAAGCCGGCCGAA", "GTCGTTCGGAATGCCGTTGCTCTGTAAA"));
}
