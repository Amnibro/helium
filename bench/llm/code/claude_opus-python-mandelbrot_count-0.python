def main():
    n = 600
    max_iter = 200
    count = 0
    for i in range(n):
        x = -2.0 + 3.0 * i / n
        for j in range(n):
            y = -1.5 + 3.0 * j / n
            zr = 0.0
            zi = 0.0
            inside = True
            for _ in range(max_iter):
                zr2 = zr * zr
                zi2 = zi * zi
                new_zi = 2.0 * zr * zi + y
                zr = zr2 - zi2 + x
                zi = new_zi
                if zr * zr + zi * zi > 4.0:
                    inside = False
                    break
            if inside:
                count += 1
    print(count)


if __name__ == "__main__":
    main()
