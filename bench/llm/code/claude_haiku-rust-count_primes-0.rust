fn main() {
    const N: usize = 20_000_000;

    let mut is_prime = vec![true; N];
    is_prime[0] = false;
    is_prime[1] = false;

    let mut i = 2usize;
    while i * i < N {
        if is_prime[i] {
            let mut j = i * i;
            while j < N {
                is_prime[j] = false;
                j += i;
            }
        }
        i += 1;
    }

    let count = is_prime.iter().filter(|&&p| p).count();
    println!("{}", count);
}
