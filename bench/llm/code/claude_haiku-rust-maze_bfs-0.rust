use std::collections::VecDeque;

fn main() {
    let rows = [
        "S.#.......",
        ".##.####.#",
        "....#....#",
        "#.#.#.##.#",
        "..#...#..#",
        ".####.#.##",
        "......#...",
        ".######.#.",
        "........#E",
    ];

    let grid: Vec<Vec<u8>> = rows.iter().map(|r| r.as_bytes().to_vec()).collect();
    let h = grid.len();
    let w = grid[0].len();

    let mut start = (0usize, 0usize);
    let mut end = (0usize, 0usize);
    for (r, row) in grid.iter().enumerate() {
        for (c, &ch) in row.iter().enumerate() {
            if ch == b'S' {
                start = (r, c);
            } else if ch == b'E' {
                end = (r, c);
            }
        }
    }

    let mut dist = vec![vec![-1i32; w]; h];
    let mut queue = VecDeque::new();
    dist[start.0][start.1] = 0;
    queue.push_back(start);

    let dirs: [(i32, i32); 4] = [(-1, 0), (1, 0), (0, -1), (0, 1)];

    while let Some((r, c)) = queue.pop_front() {
        if (r, c) == end {
            break;
        }
        for &(dr, dc) in &dirs {
            let nr = r as i32 + dr;
            let nc = c as i32 + dc;
            if nr < 0 || nc < 0 || nr >= h as i32 || nc >= w as i32 {
                continue;
            }
            let (nr, nc) = (nr as usize, nc as usize);
            if grid[nr][nc] == b'#' || dist[nr][nc] != -1 {
                continue;
            }
            dist[nr][nc] = dist[r][c] + 1;
            queue.push_back((nr, nc));
        }
    }

    println!("{}", dist[end.0][end.1]);
}
