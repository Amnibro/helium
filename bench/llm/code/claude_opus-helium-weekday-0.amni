fn day_name(n int) const byte[:] {
	match n {
		0 => "Sunday",
		1 => "Monday",
		2 => "Tuesday",
		3 => "Wednesday",
		4 => "Thursday",
		5 => "Friday",
		_ => "Saturday",
	}
}

fn weekday(year int, month int, day int) int {
	let t int[12] = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
	var y = year;
	if month < 3 { y -= 1; }
	(y + y / 4 - y / 100 + y / 400 + t[month - 1] + day) % 7
}

fn main() {
	print(day_name(weekday(2026, 10, 29)));
	print(day_name(weekday(2000, 1, 1)));
	print(day_name(weekday(1969, 7, 20)));
}
