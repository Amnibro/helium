fn main() {
	var count = 0;
	for j in 600 {
		let y = -1.5 + 3.0 * (j as real) / 600.0;
		for i in 600 {
			let x = -2.0 + 3.0 * (i as real) / 600.0;
			var zr = 0.0;
			var zi = 0.0;
			var inside = true;
			var k = 0;
			while k < 200 {
				let nr = zr * zr - zi * zi + x;
				let ni = 2.0 * zr * zi + y;
				zr = nr;
				zi = ni;
				if zr * zr + zi * zi > 4.0 { inside = false; break; }
				k++;
			}
			if inside { count++; }
		}
	}
	print(count);
}
