fn main() {
	let from int[8] = [5, 5, 4, 4, 2, 3, 7, 6];
	let to int[8] = [2, 0, 0, 1, 3, 1, 6, 3];
	var indeg int[8] = [0; 8];
	for i in 8 { indeg[to[i]] += 1; }
	var done bool[8] = [false; 8];
	var out byte[>..] = [];
	for step in 8 {
		var pick = -1;
		for t in 8 {
			if pick < 0 && !done[t] && indeg[t] == 0 { pick = t; }
		}
		done[pick] = true;
		for i in 8 {
			if from[i] == pick { indeg[to[i]] -= 1; }
		}
		if step > 0 { out.push(' '); }
		format(out, pick);
	}
	print(out);
}
