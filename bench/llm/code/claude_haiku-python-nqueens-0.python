def count_queens(n):
    full = (1 << n) - 1

    def solve(row, cols, diag1, diag2):
        if row == n:
            return 1
        count = 0
        avail = full & ~(cols | diag1 | diag2)
        while avail:
            bit = avail & -avail
            avail ^= bit
            count += solve(row + 1,
                           cols | bit,
                           ((diag1 | bit) << 1) & full,
                           (diag2 | bit) >> 1)
        return count

    return solve(0, 0, 0, 0)


print(count_queens(10))
