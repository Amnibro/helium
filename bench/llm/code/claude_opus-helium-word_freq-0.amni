struct WC { w byte[..16], c int }

fn less_str(a const byte[:], b const byte[:]) bool {
	let n = min(a.len, b.len);
	for i in n {
		if a[i] != b[i] { return a[i] < b[i]; }
	}
	return a.len < b.len;
}

fn main() {
	let text = "It was the best of times, it was the worst of times, it was the age of wisdom, it was the age of foolishness, it was the epoch of belief, it was the epoch of incredulity, it was the season of Light, it was the season of Darkness.";
	var list WC[>..] = [];
	var cur byte[..16] = [];
	fn flush() {
		if cur.len > 0 {
			var found = false;
			for &e in list {
				if e.w == cur { e.c += 1; found = true; break; }
			}
			if !found { list.push(WC { w: cur, c: 1 }); }
			cur.clear();
		}
	}
	for ch in text {
		var c byte = ch;
		if c >= 'A' && c <= 'Z' { c = c + 32; }
		if c >= 'a' && c <= 'z' {
			cur.push(c);
		} else {
			flush();
		}
	}
	flush();
	sort(list) { a, b => if a.c != b.c { a.c > b.c } else { less_str(a.w, b.w) } };
	let n = min(5, list.len);
	for i in n {
		print(list[i].w, " ", list[i].c);
	}
}
