fn main() {
    let edges: [(usize, usize, u64); 12] = [
        (0, 1, 7),
        (0, 2, 9),
        (0, 5, 14),
        (1, 2, 10),
        (1, 3, 15),
        (2, 3, 11),
        (2, 5, 2),
        (3, 4, 6),
        (4, 5, 9),
        (5, 4, 3),
        (4, 6, 1),
        (3, 6, 20),
    ];
    let n = 7;
    let inf = u64::MAX / 2;
    let mut dist = vec![inf; n];
    dist[0] = 0;
    for _ in 0..n {
        for &(u, v, w) in edges.iter() {
            if dist[u] < inf && dist[u] + w < dist[v] {
                dist[v] = dist[u] + w;
            }
        }
    }
    let out: Vec<String> = dist.iter().map(|d| d.to_string()).collect();
    println!("{}", out.join(" "));
}
