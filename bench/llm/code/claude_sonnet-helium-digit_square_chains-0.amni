fn next_sq(n int) int {
	var x = n;
	var s = 0;
	while x > 0 {
		let d = x % 10;
		s += d * d;
		x /= 10;
	}
	s
}

fn main() {
	var flag int[568] = [0; 568];
	for s in 1..568 {
		var x = s;
		while x != 1 && x != 89 {
			x = next_sq(x);
		}
		if x == 89 { flag[s] = 1; }
	}
	var cnt int[568] = [0; 568];
	cnt[0] = 1;
	for k in 7 {
		var nw int[568] = [0; 568];
		for s in 568 {
			if cnt[s] > 0 {
				for d in 10 {
					let t = s + d * d;
					if t < 568 { nw[t] += cnt[s]; }
				}
			}
		}
		cnt = nw;
	}
	var total = 0;
	for s in 1..568 {
		if flag[s] == 1 { total += cnt[s]; }
	}
	print(total);
}
