use std::collections::HashSet;

fn main() {
    let s = "abracadabraabracadabra";
    let bytes = s.as_bytes();
    let mut set: HashSet<&[u8]> = HashSet::new();
    if bytes.len() >= 3 {
        for i in 0..=bytes.len() - 3 {
            set.insert(&bytes[i..i + 3]);
        }
    }
    println!("{}", set.len());
}
