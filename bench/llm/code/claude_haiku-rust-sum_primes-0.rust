fn main() {
    const N: usize = 100_000;
    let mut is_prime = vec![true; N];
    is_prime[0] = false;
    is_prime[1] = false;

    let mut i = 2;
    while i * i < N {
        if is_prime[i] {
            let mut j = i * i;
            while j < N {
                is_prime[j] = false;
                j += i;
            }
        }
        i += 1;
    }

    let sum: u64 = (0..N)
        .filter(|&k| is_prime[k])
        .map(|k| k as u64)
        .sum();

    println!("{}", sum);
}
