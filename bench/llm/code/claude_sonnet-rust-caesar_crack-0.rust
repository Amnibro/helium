fn main() {
    let text = "Wkh vhfuhw phhwlqj lv dw qrrq";
    for shift in 0..26u8 {
        let dec: String = text
            .chars()
            .map(|c| {
                if c.is_ascii_lowercase() {
                    (((c as u8 - b'a' + 26 - shift) % 26) + b'a') as char
                } else if c.is_ascii_uppercase() {
                    (((c as u8 - b'A' + 26 - shift) % 26) + b'A') as char
                } else {
                    c
                }
            })
            .collect();
        if dec.to_lowercase().contains("secret") {
            println!("{}", dec);
            return;
        }
    }
}
