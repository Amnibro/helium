fn main() {
    let coins = [1usize, 2, 5, 10, 20, 50, 100, 200];
    let target = 200usize;
    let mut ways = vec![0u64; target + 1];
    ways[0] = 1;
    for &c in coins.iter() {
        for i in c..=target {
            ways[i] += ways[i - c];
        }
    }
    println!("{}", ways[target]);
}
