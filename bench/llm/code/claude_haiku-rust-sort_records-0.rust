fn main() {
    let mut records: Vec<(&str, u32)> = vec![
        ("mia", 34),
        ("leo", 27),
        ("ava", 34),
        ("zoe", 19),
        ("eli", 27),
        ("ian", 41),
    ];

    records.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(b.0)));

    for (name, age) in &records {
        println!("{},{}", name, age);
    }
}
