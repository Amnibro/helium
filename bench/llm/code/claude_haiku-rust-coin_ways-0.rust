fn main() {
    let target: usize = 200;
    let coins: [usize; 8] = [1, 2, 5, 10, 20, 50, 100, 200];
    let mut ways = vec![0u64; target + 1];
    ways[0] = 1;
    for &coin in &coins {
        for amount in coin..=target {
            ways[amount] += ways[amount - coin];
        }
    }
    println!("{}", ways[target]);
}
