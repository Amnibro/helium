fn weekday(y int, m int, d int) int {
	let t int[12] = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
	var yy = y;
	if m < 3 { yy -= 1; }
	return (yy + yy / 4 - yy / 100 + yy / 400 + t[m - 1] + d) % 7;
}

fn day_name(w int) const byte[:] {
	match w {
		0 => "Sunday",
		1 => "Monday",
		2 => "Tuesday",
		3 => "Wednesday",
		4 => "Thursday",
		5 => "Friday",
		_ => "Saturday",
	}
}

fn main() {
	print(day_name(weekday(2026, 10, 29)));
	print(day_name(weekday(2000, 1, 1)));
	print(day_name(weekday(1969, 7, 20)));
}
