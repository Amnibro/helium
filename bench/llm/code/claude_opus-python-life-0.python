def step(grid):
    n = len(grid)
    m = len(grid[0])
    new = [[False] * m for _ in range(n)]
    for r in range(n):
        for c in range(m):
            count = 0
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr == 0 and dc == 0:
                        continue
                    rr, cc = r + dr, c + dc
                    if 0 <= rr < n and 0 <= cc < m and grid[rr][cc]:
                        count += 1
            if grid[r][c]:
                new[r][c] = count in (2, 3)
            else:
                new[r][c] = count == 3
    return new


def main():
    size = 8
    grid = [[False] * size for _ in range(size)]
    for r, c in [(0, 1), (1, 2), (2, 0), (2, 1), (2, 2)]:
        grid[r][c] = True
    for _ in range(4):
        grid = step(grid)
    for row in grid:
        print("".join("#" if cell else "." for cell in row))


if __name__ == "__main__":
    main()
