use std::cmp::Reverse;
use std::collections::BinaryHeap;

fn main() {
    let edges: [(usize, usize, u64); 12] = [
        (0, 1, 7),
        (0, 2, 9),
        (0, 5, 14),
        (1, 2, 10),
        (1, 3, 15),
        (2, 3, 11),
        (2, 5, 2),
        (3, 4, 6),
        (4, 5, 9),
        (5, 4, 3),
        (4, 6, 1),
        (3, 6, 20),
    ];

    const N: usize = 7;
    let mut adj: Vec<Vec<(usize, u64)>> = vec![Vec::new(); N];
    for &(from, to, w) in &edges {
        adj[from].push((to, w));
    }

    let mut dist = vec![u64::MAX; N];
    let mut heap = BinaryHeap::new();
    dist[0] = 0;
    heap.push(Reverse((0u64, 0usize)));

    while let Some(Reverse((d, u))) = heap.pop() {
        if d > dist[u] {
            continue;
        }
        for &(v, w) in &adj[u] {
            let nd = d + w;
            if nd < dist[v] {
                dist[v] = nd;
                heap.push(Reverse((nd, v)));
            }
        }
    }

    let line: Vec<String> = dist.iter().map(|d| d.to_string()).collect();
    println!("{}", line.join(" "));
}
