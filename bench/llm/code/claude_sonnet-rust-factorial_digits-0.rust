fn main() {
    // Big number stored as little-endian base-10 digits
    let mut digits: Vec<u32> = vec![1];
    for n in 2..=100u32 {
        let mut carry = 0u32;
        for d in digits.iter_mut() {
            let v = *d * n + carry;
            *d = v % 10;
            carry = v / 10;
        }
        while carry > 0 {
            digits.push(carry % 10);
            carry /= 10;
        }
    }
    let sum: u32 = digits.iter().sum();
    println!("{}", sum);
}
