fn main() {
    const N: usize = 8;
    let mut grid = [[false; N]; N];
    for &(r, c) in &[(0usize, 1usize), (1, 2), (2, 0), (2, 1), (2, 2)] {
        grid[r][c] = true;
    }

    for _ in 0..4 {
        let mut next = [[false; N]; N];
        for r in 0..N {
            for c in 0..N {
                let mut count = 0;
                for dr in -1i32..=1 {
                    for dc in -1i32..=1 {
                        if dr == 0 && dc == 0 {
                            continue;
                        }
                        let nr = r as i32 + dr;
                        let nc = c as i32 + dc;
                        if nr >= 0 && nr < N as i32 && nc >= 0 && nc < N as i32 {
                            if grid[nr as usize][nc as usize] {
                                count += 1;
                            }
                        }
                    }
                }
                next[r][c] = matches!((grid[r][c], count), (true, 2) | (true, 3) | (false, 3));
            }
        }
        grid = next;
    }

    let mut out = String::new();
    for r in 0..N {
        for c in 0..N {
            out.push(if grid[r][c] { '#' } else { '.' });
        }
        out.push('\n');
    }
    print!("{}", out);
}
