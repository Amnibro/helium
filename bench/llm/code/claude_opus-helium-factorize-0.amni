fn main() {
	var n int = 600851475143;
	var out byte[>..] = [];
	var d int = 2;
	var first = true;
	while d * d <= n {
		while n % d == 0 {
			if !first { out.push(' '); }
			format(out, d);
			first = false;
			n /= d;
		}
		d++;
	}
	if n > 1 {
		if !first { out.push(' '); }
		format(out, n);
	}
	print(out);
}
