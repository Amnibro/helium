fn main() {
    const LIMIT: usize = 1_000_000;
    let mut cache: Vec<u32> = vec![0; LIMIT];
    let mut best_n: usize = 1;
    let mut best_steps: u32 = 0;
    let mut stack: Vec<u64> = Vec::with_capacity(1024);

    for start in 2..LIMIT {
        let mut n = start as u64;
        stack.clear();
        while n != 1 && (n >= LIMIT as u64 || cache[n as usize] == 0) {
            stack.push(n);
            n = if n & 1 == 0 { n >> 1 } else { 3 * n + 1 };
        }
        let mut steps = if n == 1 { 0 } else { cache[n as usize] };
        while let Some(m) = stack.pop() {
            steps += 1;
            if m < LIMIT as u64 {
                cache[m as usize] = steps;
            }
        }
        let s = cache[start];
        if s > best_steps {
            best_steps = s;
            best_n = start;
        }
    }

    println!("{} {}", best_n, best_steps);
}
