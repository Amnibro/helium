def step(grid, n):
    new = [[0] * n for _ in range(n)]
    for r in range(n):
        for c in range(n):
            count = 0
            for dr in (-1, 0, 1):
                for dc in (-1, 0, 1):
                    if dr == 0 and dc == 0:
                        continue
                    rr, cc = r + dr, c + dc
                    if 0 <= rr < n and 0 <= cc < n:
                        count += grid[rr][cc]
            if grid[r][c]:
                new[r][c] = 1 if count in (2, 3) else 0
            else:
                new[r][c] = 1 if count == 3 else 0
    return new


def main():
    n = 8
    grid = [[0] * n for _ in range(n)]
    for r, c in [(0, 1), (1, 2), (2, 0), (2, 1), (2, 2)]:
        grid[r][c] = 1

    for _ in range(4):
        grid = step(grid, n)

    for row in grid:
        print("".join("#" if cell else "." for cell in row))


if __name__ == "__main__":
    main()
