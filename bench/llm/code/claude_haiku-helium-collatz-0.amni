fn steps(n int) int {
	var x = n;
	var c = 0;
	while x != 1 {
		if x % 2 == 0 {
			x /= 2;
		} else {
			x = 3 * x + 1;
		}
		c++;
	}
	c
}

fn main() {
	var best = 1;
	var best_steps = 0;
	for n in 1..1000000 {
		let s = steps(n);
		if s > best_steps {
			best_steps = s;
			best = n;
		}
	}
	print(best, " ", best_steps);
}
