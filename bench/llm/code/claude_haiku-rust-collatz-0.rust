fn main() {
    let mut best_start: u64 = 1;
    let mut best_steps: u32 = 0;

    for start in 1..=999_999u64 {
        let mut n = start;
        let mut steps: u32 = 0;
        while n != 1 {
            n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 };
            steps += 1;
        }
        if steps > best_steps {
            best_steps = steps;
            best_start = start;
        }
    }

    println!("{} {}", best_start, best_steps);
}
