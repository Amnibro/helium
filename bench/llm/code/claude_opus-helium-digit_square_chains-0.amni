fn sumsq(n int) int {
	var x = n;
	var s = 0;
	while x > 0 {
		let d = x % 10;
		s += d * d;
		x /= 10;
	}
	s
}

fn ends89(n int) bool {
	var x = n;
	while x != 1 && x != 89 {
		x = sumsq(x);
	}
	x == 89
}

fn main() {
	var cnt int[568] = [0; 568];
	cnt[0] = 1;
	for r in 7 {
		var nx int[568] = [0; 568];
		for s in 568 {
			if cnt[s] > 0 {
				for d in 10 {
					let t = s + d * d;
					if t < 568 {
						nx[t] += cnt[s];
					}
				}
			}
		}
		cnt = nx;
	}
	var total = 0;
	for s in 1..568 {
		if cnt[s] > 0 && ends89(s) {
			total += cnt[s];
		}
	}
	print(total);
}
