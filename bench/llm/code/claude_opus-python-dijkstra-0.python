import heapq

def main():
    n = 7
    edges = [(0,1,7),(0,2,9),(0,5,14),(1,2,10),(1,3,15),(2,3,11),
             (2,5,2),(3,4,6),(4,5,9),(5,4,3),(4,6,1),(3,6,20)]
    adj = [[] for _ in range(n)]
    for u, v, w in edges:
        adj[u].append((v, w))
    INF = float('inf')
    dist = [INF] * n
    dist[0] = 0
    pq = [(0, 0)]
    while pq:
        d, u = heapq.heappop(pq)
        if d > dist[u]:
            continue
        for v, w in adj[u]:
            nd = d + w
            if nd < dist[v]:
                dist[v] = nd
                heapq.heappush(pq, (nd, v))
    print(" ".join(str(d) if d != INF else "INF" for d in dist))

main()
