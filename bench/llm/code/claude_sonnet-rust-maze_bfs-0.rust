use std::collections::VecDeque;

fn main() {
    let rows = [
        "S.#.......",
        ".##.####.#",
        "....#....#",
        "#.#.#.##.#",
        "..#...#..#",
        ".####.#.##",
        "......#...",
        ".######.#.",
        "........#E",
    ];
    let g: Vec<Vec<u8>> = rows.iter().map(|r| r.bytes().collect()).collect();
    let h = g.len();
    let w = g[0].len();
    let mut start = (0, 0);
    let mut end = (0, 0);
    for i in 0..h {
        for j in 0..w {
            if g[i][j] == b'S' {
                start = (i, j);
            }
            if g[i][j] == b'E' {
                end = (i, j);
            }
        }
    }
    let mut dist = vec![vec![-1i32; w]; h];
    dist[start.0][start.1] = 0;
    let mut q = VecDeque::new();
    q.push_back(start);
    while let Some((r, c)) = q.pop_front() {
        let d = dist[r][c];
        let dirs: [(i32, i32); 4] = [(1, 0), (-1, 0), (0, 1), (0, -1)];
        for (dr, dc) in dirs.iter() {
            let nr = r as i32 + dr;
            let nc = c as i32 + dc;
            if nr < 0 || nc < 0 || nr >= h as i32 || nc >= w as i32 {
                continue;
            }
            let (nr, nc) = (nr as usize, nc as usize);
            if g[nr][nc] == b'#' || dist[nr][nc] != -1 {
                continue;
            }
            dist[nr][nc] = d + 1;
            q.push_back((nr, nc));
        }
    }
    println!("{}", dist[end.0][end.1]);
}
