fn main() {
    const N: usize = 100000;
    let mut sieve = vec![true; N];
    sieve[0] = false;
    sieve[1] = false;
    let mut i = 2;
    while i * i < N {
        if sieve[i] {
            let mut j = i * i;
            while j < N {
                sieve[j] = false;
                j += i;
            }
        }
        i += 1;
    }
    let sum: u64 = sieve
        .iter()
        .enumerate()
        .filter(|(_, &p)| p)
        .map(|(i, _)| i as u64)
        .sum();
    println!("{}", sum);
}
