fn main() {
	let N = 100000;
	var sieve bool[100000] = [true; 100000];
	sieve[0] = false;
	sieve[1] = false;
	var i = 2;
	while i * i < N {
		if sieve[i] {
			var j = i * i;
			while j < N {
				sieve[j] = false;
				j += i;
			}
		}
		i++;
	}
	var total = 0;
	for k in N {
		if sieve[k] { total += k; }
	}
	print(total);
}
