def max_knapsack_value(weights, values, capacity):
    dp = [0] * (capacity + 1)
    for w, v in zip(weights, values):
        for c in range(capacity, w - 1, -1):
            dp[c] = max(dp[c], dp[c - w] + v)
    return dp[capacity]


def main():
    weights = [12, 7, 11, 8, 9, 6, 15, 4, 10, 13]
    values = [24, 13, 23, 15, 16, 12, 30, 7, 19, 25]
    capacity = 50
    print(max_knapsack_value(weights, values, capacity))


if __name__ == "__main__":
    main()
