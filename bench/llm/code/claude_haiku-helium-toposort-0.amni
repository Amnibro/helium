fn main() {
	let ea = [5, 5, 4, 4, 2, 3, 7, 6];
	let eb = [2, 0, 0, 1, 3, 1, 6, 3];
	var indeg int[8] = [0; 8];
	var done bool[8] = [false; 8];
	for e in 8 { indeg[eb[e]] += 1; }
	var out byte[>..] = [];
	for step in 8 {
		var pick = -1;
		for t in 8 {
			if done[t] == false && indeg[t] == 0 { pick = t; break; }
		}
		done[pick] = true;
		if step > 0 { out.push(' '); }
		format(out, pick);
		for e in 8 {
			if ea[e] == pick { indeg[eb[e]] -= 1; }
		}
	}
	print(out);
}
