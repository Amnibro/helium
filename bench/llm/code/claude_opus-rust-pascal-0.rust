fn main() {
    let mut row: Vec<u64> = vec![1];
    let mut out = String::new();
    for _ in 0..10 {
        let line: Vec<String> = row.iter().map(|n| n.to_string()).collect();
        out.push_str(&line.join(" "));
        out.push('\n');
        let mut next = vec![1u64; row.len() + 1];
        for i in 1..row.len() {
            next[i] = row[i - 1] + row[i];
        }
        row = next;
    }
    print!("{}", out);
}
