import heapq

edges = [
    (0, 1, 7), (0, 2, 9), (0, 5, 14), (1, 2, 10), (1, 3, 15),
    (2, 3, 11), (2, 5, 2), (3, 4, 6), (4, 5, 9), (5, 4, 3),
    (4, 6, 1), (3, 6, 20),
]

N = 7
adj = [[] for _ in range(N)]
for u, v, w in edges:
    adj[u].append((v, w))

INF = float("inf")
dist = [INF] * N
dist[0] = 0
heap = [(0, 0)]

while heap:
    d, u = heapq.heappop(heap)
    if d > dist[u]:
        continue
    for v, w in adj[u]:
        nd = d + w
        if nd < dist[v]:
            dist[v] = nd
            heapq.heappush(heap, (nd, v))

print(" ".join(str(d) for d in dist))
