fn main() {
	let ea int[8] = [5, 5, 4, 4, 2, 3, 7, 6];
	let eb int[8] = [2, 0, 0, 1, 3, 1, 6, 3];
	var indeg int[8] = [0; 8];
	for i in 8 { indeg[eb[i]] += 1; }
	var done bool[8] = [false; 8];
	var out byte[>..] = [];
	for step in 8 {
		var pick = -1;
		for v in 8 {
			if pick < 0 && !done[v] && indeg[v] == 0 { pick = v; }
		}
		if pick < 0 { break; }
		done[pick] = true;
		for i in 8 {
			if ea[i] == pick { indeg[eb[i]] -= 1; }
		}
		if out.len > 0 { out.push(' '); }
		format(out, pick);
	}
	print(out);
}
