fn main() {
    let n = 600;
    let mut count = 0u32;
    for i in 0..n {
        let x = -2.0 + 3.0 * (i as f64) / 600.0;
        for j in 0..n {
            let y = -1.5 + 3.0 * (j as f64) / 600.0;
            let (mut zr, mut zi) = (0.0f64, 0.0f64);
            let mut inside = true;
            for _ in 0..200 {
                let nr = zr * zr - zi * zi + x;
                zi = 2.0 * zr * zi + y;
                zr = nr;
                if zr * zr + zi * zi > 4.0 {
                    inside = false;
                    break;
                }
            }
            if inside {
                count += 1;
            }
        }
    }
    println!("{}", count);
}
