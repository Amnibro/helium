fn solve(n: u32, row: u32, cols: u32, d1: u32, d2: u32) -> u64 {
    if row == n {
        return 1;
    }
    let full = (1u32 << n) - 1;
    let mut avail = full & !(cols | d1 | d2);
    let mut count = 0u64;
    while avail != 0 {
        let bit = avail & avail.wrapping_neg();
        avail ^= bit;
        count += solve(
            n,
            row + 1,
            cols | bit,
            ((d1 | bit) << 1) & full,
            (d2 | bit) >> 1,
        );
    }
    count
}

fn main() {
    println!("{}", solve(10, 0, 0, 0, 0));
}
