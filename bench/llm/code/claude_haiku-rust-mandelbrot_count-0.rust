fn main() {
    const N: usize = 600;
    const MAX_ITER: usize = 200;

    let mut count: u64 = 0;

    for i in 0..N {
        let x = -2.0 + 3.0 * (i as f64) / 600.0;
        for j in 0..N {
            let y = -1.5 + 3.0 * (j as f64) / 600.0;

            let (cr, ci) = (x, y);
            let (mut zr, mut zi) = (0.0f64, 0.0f64);
            let mut inside = true;

            for _ in 0..MAX_ITER {
                let zr2 = zr * zr - zi * zi + cr;
                let zi2 = 2.0 * zr * zi + ci;
                zr = zr2;
                zi = zi2;
                if zr * zr + zi * zi > 4.0 {
                    inside = false;
                    break;
                }
            }

            if inside {
                count += 1;
            }
        }
    }

    println!("{}", count);
}
