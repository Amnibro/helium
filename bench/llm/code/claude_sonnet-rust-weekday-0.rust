fn day_of_week(y: i32, m: i32, d: i32) -> usize {
    // Sakamoto's algorithm: 0 = Sunday
    let t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
    let y = if m < 3 { y - 1 } else { y };
    ((y + y / 4 - y / 100 + y / 400 + t[(m - 1) as usize] + d) % 7) as usize
}

fn main() {
    let names = [
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
    ];
    let dates = [(2026, 10, 29), (2000, 1, 1), (1969, 7, 20)];
    for (y, m, d) in dates.iter() {
        println!("{}", names[day_of_week(*y, *m, *d)]);
    }
}
