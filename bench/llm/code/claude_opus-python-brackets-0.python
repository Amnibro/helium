def balanced(s):
    pairs = {')': '(', ']': '[', '}': '{'}
    stack = []
    for ch in s:
        if ch in '([{':
            stack.append(ch)
        elif ch in pairs:
            if not stack or stack[-1] != pairs[ch]:
                return False
            stack.pop()
    return not stack


def main():
    tests = ['([]{})', '([)]', '((()', '{[()()]}', '', '}{']
    for t in tests:
        print("YES" if balanced(t) else "NO")


if __name__ == "__main__":
    main()
