def main():
    n = 10000000
    total = 0.0
    # Pair consecutive terms: 1/(4k+1) - 1/(4k+3) = 2/((4k+1)(4k+3))
    pairs = n // 2
    for k in range(pairs):
        a = 4 * k + 1
        total += 2.0 / (a * (a + 2))
    if n % 2:
        total += 1.0 / (2 * (n - 1) + 1)
    print("%.6f" % (4.0 * total))


main()
