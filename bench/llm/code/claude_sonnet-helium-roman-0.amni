fn sym(i int) const byte[:] {
	match i {
		0 => "M",
		1 => "CM",
		2 => "D",
		3 => "CD",
		4 => "C",
		5 => "XC",
		6 => "L",
		7 => "XL",
		8 => "X",
		9 => "IX",
		10 => "V",
		11 => "IV",
		_ => "I",
	}
}

fn val(i int) int {
	match i {
		0 => 1000,
		1 => 900,
		2 => 500,
		3 => 400,
		4 => 100,
		5 => 90,
		6 => 50,
		7 => 40,
		8 => 10,
		9 => 9,
		10 => 5,
		11 => 4,
		_ => 1,
	}
}

fn show(n int) {
	var out byte[>..] = [];
	var x = n;
	for i in 13 {
		while x >= val(i) {
			out.append(sym(i));
			x -= val(i);
		}
	}
	print(out);
}

fn main() {
	show(1994);
	show(2024);
	show(3999);
	show(4);
}
