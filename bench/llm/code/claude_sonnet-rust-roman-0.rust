fn to_roman(mut n: u32) -> String {
    let table: [(u32, &str); 13] = [
        (1000, "M"),
        (900, "CM"),
        (500, "D"),
        (400, "CD"),
        (100, "C"),
        (90, "XC"),
        (50, "L"),
        (40, "XL"),
        (10, "X"),
        (9, "IX"),
        (5, "V"),
        (4, "IV"),
        (1, "I"),
    ];
    let mut s = String::new();
    for &(v, r) in table.iter() {
        while n >= v {
            s.push_str(r);
            n -= v;
        }
    }
    s
}

fn main() {
    for n in [1994u32, 2024, 3999, 4] {
        println!("{}", to_roman(n));
    }
}
