def lcs_length(a, b):
    m, n = len(a), len(b)
    prev = [0] * (n + 1)
    for i in range(1, m + 1):
        cur = [0] * (n + 1)
        ai = a[i - 1]
        for j in range(1, n + 1):
            if ai == b[j - 1]:
                cur[j] = prev[j - 1] + 1
            else:
                cur[j] = max(prev[j], cur[j - 1])
        prev = cur
    return prev[n]


def main():
    s1 = 'ACCGGTCGAGTGCGCGGAAGCCGGCCGAA'
    s2 = 'GTCGTTCGGAATGCCGTTGCTCTGTAAA'
    print(lcs_length(s1, s2))


if __name__ == "__main__":
    main()
