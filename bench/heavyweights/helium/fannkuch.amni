import os;

fn main() {
	let a = args();
	var n = 7;
	if a.len > 1 { let v, ok = parse_int(a[1]); if ok { n = v; } }
	var perm int[32] = [0; 32];
	var perm1 int[32] = [0; 32];
	var count int[32] = [0; 32];
	var max_flips = 0;
	var checksum = 0;
	var perm_count = 0;
	var r = n;
	for i in n { perm1[i] = i; }
	loop {
		while r != 1 { count[r - 1] = r; r -= 1; }
		for i in n { perm[i] = perm1[i]; }
		var flips = 0;
		var k = perm[0];
		while k != 0 {
			let k2 = (k + 1) >> 1;
			for i in k2 { let t = perm[i]; perm[i] = perm[k - i]; perm[k - i] = t; }
			flips += 1;
			k = perm[0];
		}
		if flips > max_flips { max_flips = flips; }
		checksum += if perm_count % 2 == 0 { flips } else { -flips };
		var done = false;
		loop {
			if r == n { done = true; break; }
			let p0 = perm1[0];
			for i in r { perm1[i] = perm1[i + 1]; }
			perm1[r] = p0;
			count[r] -= 1;
			if count[r] > 0 { break; }
			r += 1;
		}
		if done { break; }
		perm_count += 1;
	}
	print(checksum);
	print("Pfannkuchen(", n, ") = ", max_flips);
}
