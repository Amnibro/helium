// fannkuch: pancake flips over all permutations (permutation index order), checksum and max flips.
import os;
fn arg_n(d int) int { if arg_count() < 2 { return d; } var s byte[>..] = []; arg(1, s); let n, ok = parse_int(s[..]); if ok { n } else { d } }
fn main() {
	let n = arg_n(7);
	var perm int[16] = [0; 16]; var perm1 int[16] = [0; 16]; var count int[16] = [0; 16];
	for i in n { perm1[i] = i; }
	var r = n; var maxf = 0; var pc = 0; var checksum = 0;
	loop {
		while r != 1 { count[r - 1] = r; r--; }
		for i in n { perm[i] = perm1[i]; }
		var flips = 0; var k = perm[0];
		while k != 0 {
			var i = 0; var j = k;
			while i < j { let t = perm[i]; perm[i] = perm[j]; perm[j] = t; i++; j--; }
			flips++;
			k = perm[0];
		}
		if flips > maxf { maxf = flips; }
		checksum += if pc % 2 == 0 { flips } else { -flips };
		var done = false;
		loop {
			if r == n { done = true; break; }
			let p0 = perm1[0];
			for i in r { perm1[i] = perm1[i + 1]; }
			perm1[r] = p0;
			count[r]--;
			if count[r] > 0 { break; }
			r++;
		}
		if done { break; }
		pc++;
	}
	print(checksum);
	print("Pfannkuchen(", n, ") = ", maxf);
}
