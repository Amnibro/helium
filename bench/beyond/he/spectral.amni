// spectral: power method on A(i,j) = 1/((i+j)(i+j+1)/2+i+1), 10 rounds of v = AtA u.
import os;
import math;
fn arg_n(d int) int { if arg_count() < 2 { return d; } var s byte[>..] = []; arg(1, s); let n, ok = parse_int(s[..]); if ok { n } else { d } }
fn a(i int, j int) real { 1.0 / ((i + j) * (i + j + 1) / 2 + i + 1) as real }
fn mul_av(v real[:], out real[:]) {
	let n = v.len;
	for i in n { var s = 0.0; for j in n { s += a(i, j) * v[j]; } out[i] = s; }
}
fn mul_atv(v real[:], out real[:]) {
	let n = v.len;
	for i in n { var s = 0.0; for j in n { s += a(j, i) * v[j]; } out[i] = s; }
}
fn mul_atav(v real[:], out real[:], tmp real[:]) { mul_av(v, tmp); mul_atv(tmp, out); }
fn main() {
	let n = arg_n(100);
	var u real[>..] = []; u.resize(n, 1.0);
	var v real[>..] = []; v.resize(n, 0.0);
	var t real[>..] = []; t.resize(n, 0.0);
	for k in 10 { mul_atav(u, v, t); mul_atav(v, u, t); }
	var vbv = 0.0; var vv = 0.0;
	for i in n { vbv += u[i] * v[i]; vv += v[i] * v[i]; }
	var o byte[>..] = [];
	format_flt(o, sqrt(vbv / vv), 9);
	print(o);
}
