// mandelbrot: n x n grid over [-1.5,0.5]x[-1,1], 50 iterations, escape |z|^2 > 4.
// Prints the number of points inside and a hash of the row-packed bitmap.
import os;
fn arg_n(d int) int { if arg_count() < 2 { return d; } var s byte[>..] = []; arg(1, s); let n, ok = parse_int(s[..]); if ok { n } else { d } }
fn main() {
	let n = arg_n(200);
	var inside = 0;
	var h u32 = 2166136261;
	for y in n {
		let ci = 2.0 * y as real / n as real - 1.0;
		var bits u32 = 0; var nb = 0;
		for x in n {
			let cr = 2.0 * x as real / n as real - 1.5;
			var zr = 0.0; var zi = 0.0;
			var inn u32 = 1;
			for i in 50 {
				let tr = zr * zr - zi * zi + cr;
				let ti = 2.0 * zr * zi + ci;
				zr = tr; zi = ti;
				if zr * zr + zi * zi > 4.0 { inn = 0; break; }
			}
			bits = (bits << 1) | inn; nb++;
			inside += inn as int;
			if nb == 8 { h = (h ^ bits) * 16777619; bits = 0; nb = 0; }
		}
		if nb > 0 { h = (h ^ (bits << (8 - nb) as! u32)) * 16777619; }
	}
	print(inside, " ", h);
}
