import dictionary;

fn show(xs int[:]) {
	var o byte[>..] = [];
	o.append("results: ");
	for x, i in xs {
		if i > 0 { o.append(","); }
		format(o, x);
	}
	print(o);
}

fn apply_memo<F>(xs int[>..]&) {
	var memo = dictionary<int, int> {};
	var hits = 0;
	for &x in xs {
		let c = memo.get(x);
		if c {
			hits++;
			x = c;
		} else {
			let y = F(x);
			memo.insert(x, y);
			x = y;
		}
	}
	print("subfunction ran on ", xs.len, " results, ", hits, " memo hits");
}

fn small_divisors(n int) int {
	let x = abs(n);
	var c = 0;
	for d in 1..min(x, 10) + 1 { if x % d == 0 { c++; } }
	c
}

fn main() {
	var xs int[>..] = [6, 12, 18];
	apply_memo(xs) { small_divisors(it) };
	var unique int[>..] = [];
	for x in xs { if !contains(unique, x) { unique.push(x); } }
	let n = unique.len;
	for i in n { unique.push(unique[i]); }
	show(unique);
}
