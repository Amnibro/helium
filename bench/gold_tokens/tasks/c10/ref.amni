fn show(xs int[:]) {
	var o byte[>..] = [];
	o.append("results: ");
	for x, i in xs {
		if i > 0 { o.append(","); }
		format(o, x);
	}
	print(o);
}

fn main() {
	let xs = [10, 25, 18, 40, 32];
	var gaps int[>..] = [];
	for i in xs.len - 1 { gaps.push(xs[i + 1] - xs[i]); }
	let ranks = gaps.map() { x => 1 + count(gaps) { it < x } };
	show(ranks);
}
