// Gold runtime prelude: shared state threaded through every Gold step.
// Every step template is `fn NAME(g Gold&, v Val) Val`.
import math;

struct Val { i int, r real, ok bool, s byte[..200] }
struct Gold { errors int, steps int, hits int, misses int, n int, res int[512], cn int, ck int[256], cv int[256], err byte[..120] }

fn gold_new() Gold { Gold { errors: 0, steps: 0, hits: 0, misses: 0, n: 0, res: [0; 512], cn: 0, ck: [0; 256], cv: [0; 256], err: "" } }
fn gold_val() Val { Val { i: 0, r: 0.0, ok: true, s: "" } }
fn gold_text(v Val&, t const byte[:]) { v.s.clear(); for b in t { if v.s.len < 200 { v.s.push(b); } } }
fn gold_push(g Gold&, x int) { if g.n < 512 { g.res[g.n] = x; g.n++; } else { gold_fail(g, "results full"); } }
fn gold_clear(g Gold&) { g.n = 0; }
fn gold_fail(g Gold&, msg const byte[:]) { g.errors++; g.err.clear(); for b in msg { if g.err.len < 120 { g.err.push(b); } } }
fn gold_cache_get(g Gold&, k int) int, bool {
	for i in g.cn { if g.ck[i] == k { g.hits++; return g.cv[i], true; } }
	g.misses++;
	return 0, false;
}
fn gold_cache_put(g Gold&, k int, x int) {
	for i in g.cn { if g.ck[i] == k { g.cv[i] = x; return; } }
	if g.cn < 256 { g.ck[g.cn] = k; g.cv[g.cn] = x; g.cn++; }
}
fn gold_report(g Gold&, v Val) {
	var o byte[>..] = [];
	format(o, "=> i=", v.i, " r=", v.r, " ok=", v.ok, " s=\"", v.s, "\" errors=", g.errors, " n=", g.n, " res=[");
	for k in g.n { if k > 0 { o.append(","); } format(o, g.res[k]); }
	format(o, "] cache=", g.cn, " hits=", g.hits);
	print(o);
}

// Core functions (fn kind: int -> int). Tests bind slots to these by bare name.
fn core_double(n int) int { n * 2 }
fn core_halve(n int) int { n / 2 }
fn core_inc(n int) int { n + 1 }
fn core_dec(n int) int { n - 1 }
fn core_square(n int) int { n * n }
fn core_triple(n int) int { n * 3 }
fn core_cube(n int) int { n * n * n }
fn core_negate(n int) int { -n }
fn core_abs_val(n int) int { if n < 0 { -n } else { n } }
fn core_collatz(n int) int { if n % 2 == 0 { n / 2 } else { 3 * n + 1 } }
fn core_digit_sum(n int) int { var x = core_abs_val(n); var s = 0; while x > 0 { s += x % 10; x /= 10; } s }
fn core_reverse_digits(n int) int { var x = core_abs_val(n); var r = 0; while x > 0 { r = r * 10 + x % 10; x /= 10; } r }

// Core predicates (pred kind: int -> bool).
fn core_is_one(n int) bool { n == 1 }
fn core_is_zero(n int) bool { n == 0 }
fn core_is_even(n int) bool { n % 2 == 0 }
fn core_is_odd(n int) bool { n % 2 != 0 }
fn core_is_negative(n int) bool { n < 0 }
fn core_over_100(n int) bool { n > 100 }
fn core_under_10(n int) bool { n < 10 }
fn core_is_prime(n int) bool { if n < 2 { return false; } var d = 2; while d * d <= n { if n % d == 0 { return false; } d++; } true }
fn core_is_square(n int) bool { if n < 0 { return false; } var r = 0; while r * r < n { r++; } r * r == n }
fn core_is_palindrome(n int) bool { core_reverse_digits(n) == core_abs_val(n) }

// ===== Gold bindings =====

// ===== Gold steps =====
// step 0: measure all word lengths in text   [lib/gen/shard-0001.gold af4e371d23bc7ad8]
fn gold_s0(g Gold&, v Val) Val {
	var out = v;
	let w = words(v.s);
	for word in w {
		gold_push(g, word.len);
	}
	g.steps += w.len;
	out.i = w.len;
	out.s.clear();
	format(out.s, "measured all ", w.len, " word lengths");
	out
}
// step 1: remove last occurrence of maximum value   [lib/gen/shard-0001.gold 0a171471ad768efc]
fn gold_s1(g Gold&, v Val) Val {
	var out = v;
	if g.n == 0 {
		gold_fail(g, "cannot drop from empty list");
		out.ok = false;
		out.s.clear();
		format(out.s, "error: empty list");
		return out;
	}
	var max_val = g.res[0];
	for k in 1..g.n {
		if g.res[k] > max_val { max_val = g.res[k]; }
	}
	var last_idx = -1;
	for k in g.n {
		if g.res[k] == max_val { last_idx = k; }
	}
	for k in last_idx..(g.n - 1) {
		g.res[k] = g.res[k + 1];
	}
	g.n--;
	g.steps += g.n;
	out.i = max_val;
	out.s.clear();
	format(out.s, "dropped last maximum ", max_val);
	out
}
// step 2: return results   [lib/core.gold 22627c5de82f0988]
fn gold_s2(g Gold&, v Val) Val {
	var out = v;
	var line byte[>..] = [];
	var total = 0;
	for k in g.n {
		if k > 0 { line.append(","); }
		format(line, g.res[k]);
		total += g.res[k];
	}
	print("results: ", line);
	out.i = total;
	out.r = if g.n > 0 { total as real / g.n as real } else { 0.0 };
	out.s.clear();
	format(out.s, "returned ", g.n);
	out
}

fn main() {
	var g = gold_new();
	var v = gold_val();
	gold_text(v, "parse the config file then retry");
	v = gold_s0(g, v);
	v = gold_s1(g, v);
	v = gold_s2(g, v);
	gold_report(g, v);
}
