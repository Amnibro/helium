import dictionary;

fn show(xs int[:]) {
	var o byte[>..] = [];
	o.append("results: ");
	for x, i in xs {
		if i > 0 { o.append(","); }
		format(o, x);
	}
	print(o);
}

fn apply_memo<F>(xs int[>..]&) {
	var memo = dictionary<int, int> {};
	var hits = 0;
	for &x in xs {
		let c = memo.get(x);
		if c {
			hits++;
			x = c;
		} else {
			let y = F(x);
			memo.insert(x, y);
			x = y;
		}
	}
	print("subfunction ran on ", xs.len, " results, ", hits, " memo hits");
}

fn square_digit_sum(n int) int {
	var x = abs(n);
	var s = 0;
	while x > 0 { let d = x % 10; s += d * d; x /= 10; }
	s
}

fn main() {
	var xs int[>..] = [12, 34, 56, 78];
	apply_memo(xs) { square_digit_sum(it) };
	var kept int[>..] = [];
	for x, i in xs { if i % 2 == 0 { kept.push(x); } }
	print("no errors in ", kept.len, " results");
	print("cached ", kept.len, " results");
	show(kept);
}
