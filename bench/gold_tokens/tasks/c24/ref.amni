import dictionary;

fn show(xs int[:]) {
	var o byte[>..] = [];
	o.append("results: ");
	for x, i in xs {
		if i > 0 { o.append(","); }
		format(o, x);
	}
	print(o);
}

fn apply_memo<F>(xs int[>..]&) {
	var memo = dictionary<int, int> {};
	var hits = 0;
	for &x in xs {
		let c = memo.get(x);
		if c {
			hits++;
			x = c;
		} else {
			let y = F(x);
			memo.insert(x, y);
			x = y;
		}
	}
	print("subfunction ran on ", xs.len, " results, ", hits, " memo hits");
}

fn doubling_sum(n int) int {
	var cur = max(n, 1);
	var total = 0;
	while cur <= 50 { total += cur; cur *= 2; }
	total
}

fn main() {
	var xs int[>..] = [3, 5, 7];
	apply_memo(xs) { doubling_sum(it) };
	print("cached ", xs.len, " results");
	show(xs);
}
