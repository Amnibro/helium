fn show(xs int[:]) {
	var o byte[>..] = [];
	o.append("results: ");
	for x, i in xs {
		if i > 0 { o.append(","); }
		format(o, x);
	}
	print(o);
}

fn gaps_within(xs int[:], limit int) bool {
	for i in 1..xs.len { if abs(xs[i] - xs[i - 1]) > limit { return false; } }
	true
}

fn main() {
	let xs = [10, 14, 19, 31, 33];
	if gaps_within(xs, 10) {
		print("no errors in ", xs.len, " results");
	} else {
		print("error: gap exceeds limit (1 total)");
	}
	show(xs);
}
