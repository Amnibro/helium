import dictionary;

fn show(xs int[:]) {
	var o byte[>..] = [];
	o.append("results: ");
	for x, i in xs {
		if i > 0 { o.append(","); }
		format(o, x);
	}
	print(o);
}

fn apply_memo<F>(xs int[>..]&) {
	var memo = dictionary<int, int> {};
	var hits = 0;
	for &x in xs {
		let c = memo.get(x);
		if c {
			hits++;
			x = c;
		} else {
			let y = F(x);
			memo.insert(x, y);
			x = y;
		}
	}
	print("subfunction ran on ", xs.len, " results, ", hits, " memo hits");
}

fn last_even_digits_sum(n int) int {
	var x = abs(n);
	var total = 0;
	var found = 0;
	while x > 0 && found < 2 {
		let d = x % 10;
		if d % 2 == 0 { total += d; found++; }
		x /= 10;
	}
	total
}

fn main() {
	var xs int[>..] = [2468, 1357, 8642, 2048, 9876];
	apply_memo(xs) { last_even_digits_sum(it) };
	if xs.len >= 2 {
		for i in xs.len - 1 { xs[i] = (xs[i + 1] - xs[i]) * 3; }
		xs.pop();
	}
	show(xs);
}
