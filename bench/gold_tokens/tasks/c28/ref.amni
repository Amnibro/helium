import dictionary;

fn show(xs int[:]) {
	var o byte[>..] = [];
	o.append("results: ");
	for x, i in xs {
		if i > 0 { o.append(","); }
		format(o, x);
	}
	print(o);
}

fn apply_memo<F>(xs int[>..]&) {
	var memo = dictionary<int, int> {};
	var hits = 0;
	for &x in xs {
		let c = memo.get(x);
		if c {
			hits++;
			x = c;
		} else {
			let y = F(x);
			memo.insert(x, y);
			x = y;
		}
	}
	print("subfunction ran on ", xs.len, " results, ", hits, " memo hits");
}

fn digit_records(n int) int {
	var digits int[>..] = [];
	var x = abs(n);
	while x > 0 { digits.push(x % 10); x /= 10; }
	var best = -1;
	var c = 0;
	each_rev(digits) { if it > best { best = it; c++; } };
	c
}

fn main() {
	var xs int[>..] = [142, 365, 876];
	apply_memo(xs) { digit_records(it) };
	let value = xs.len;
	var i = xs.len;
	while i > 0 && xs[i - 1] > value { i--; }
	insert_at(xs, i, value);
	show(xs);
}
