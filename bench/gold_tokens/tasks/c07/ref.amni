import dictionary;

fn show(xs int[:]) {
	var o byte[>..] = [];
	o.append("results: ");
	for x, i in xs {
		if i > 0 { o.append(","); }
		format(o, x);
	}
	print(o);
}

fn apply_memo<F>(xs int[>..]&) {
	var memo = dictionary<int, int> {};
	var hits = 0;
	for &x in xs {
		let c = memo.get(x);
		if c {
			hits++;
			x = c;
		} else {
			let y = F(x);
			memo.insert(x, y);
			x = y;
		}
	}
	print("subfunction ran on ", xs.len, " results, ", hits, " memo hits");
}

fn collatz_steps(n int) int {
	var x = max(n, 1);
	var steps = 0;
	while x != 1 && steps < 200 {
		x = if x % 2 == 0 { x / 2 } else { 3 * x + 1 };
		steps++;
	}
	steps
}

fn main() {
	var xs int[>..] = [3, 5, 6, 7];
	apply_memo(xs) { collatz_steps(it) };
	print("no errors in ", xs.len, " results");
	show(xs);
}
