fn show(xs int[:]) {
	var o byte[>..] = [];
	o.append("results: ");
	for x, i in xs {
		if i > 0 { o.append(","); }
		format(o, x);
	}
	print(o);
}

fn collatz(n int) int { if n % 2 == 0 { n / 2 } else { 3 * n + 1 } }

fn main() {
	var seq int[>..] = [7];
	while last(seq) != 1 { seq.push(collatz(last(seq))); }
	while seq.len > 0 && last(seq) == 1 { seq.pop(); }
	print("no errors in ", seq.len, " results");
	show(seq);
}
