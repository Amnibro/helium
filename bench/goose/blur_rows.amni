// The blur of blur.goose written over row slices: three source rows and
// one destination row are sliced once per row, their lengths asserted to
// be W, and the inner loop indexes those. Every index is then a loop
// counter plus a constant against a length the analysis knows, so the
// bounds checks disappear from the hot loop and the backend sees the same
// loop C++ does. Both forms are checkfree; any timing gap between them is
// backend code generation, not remaining bounds checks.

import rng;

let W = 2048;                            // BENCH_N
let PASSES = 16;

checkfree fn blur(src byte[>..]&, dst byte[>..]&) {
	for y in 1..W - 1 {
		let lo = (y - 1) * W;
		let a = src[lo..lo + W];
		let b = src[lo + W..lo + 2 * W];
		let c = src[lo + 2 * W..lo + 3 * W];
		let d = dst[lo + W..lo + 2 * W];
		assert(a.len == W && b.len == W && c.len == W && d.len == W);
		for x in 1..W - 1 {
			let s = a[x - 1] + a[x] as u16 * 2 + a[x + 1]
				  + b[x - 1] as u16 * 2 + b[x] as u16 * 4 + b[x + 1] as u16 * 2
				  + c[x - 1] + c[x] as u16 * 2 + c[x + 1];
			d[x] = (s >> 4) as! byte;
		}
	}
}

fn main() {
	var a byte[>..] = [];
	var b byte[>..] = [];
	var r uint = 12345;
	for i in W * W {
		r = xs_next(r);
		a.push(xs_mod(r, 256) as! byte);
		b.push(0);
	}
	for p in PASSES / 2 {
		blur(a, b);
		blur(b, a);
	}
	var total = 0;
	for v in a { total += v; }
	print(W);
	print(total);
}
